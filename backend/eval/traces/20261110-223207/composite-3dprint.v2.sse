data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:16:06.020519", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Year': [2024, 2025, 2035],\n    'Aero_3DP': [24, 28.8, 178.3]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\ncomp = {\n    'Aircraft': ['F-22', '歼-20', 'F-35', 'B-2', '波音787', 'A350'],\n    'Usage': [25, 20, 35, 50, 50, 52]\n}\ndf2 = pd.DataFrame(comp)\ndf2['Usage'] = pd.to_numeric(df2['Usage'], errors='coerce')\ndf2 = df2.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\naxes[0].plot(df['Year'], df['Aero_3DP'], linewidth=2.5, marker='o', markersize=8, color='#6366f1')\naxes[0].fill_between(df['Year'], df['Aero_3DP'], alpha=0.15, color='#6366f1')\naxes[0].set_title('航空航天3D打印市场规模', fontsize=16, fontweight='bold', pad=15)\naxes[0].set_xlabel('年份', fontsize=14)\naxes[0].set_ylabel('规模（亿美元）', fontsize=14)\naxes[0].tick_params(labelsize=12)\naxes[0].grid(True, linestyle='--', alpha=0.3)\nbars = axes[1].bar(df2['Aircraft'], df2['Usage'], color='#06b6d4')\naxes[1].set_title('各机型复合材料用量占比', fontsize=16, fontweight='bold', pad=15)\naxes[1].set_ylabel('占比（%）', fontsize=14)\naxes[1].tick_params(labelsize=12)\nfor b in bars:\n    axes[1].text(b.get_x() + b.get_width()/2, b.get_height()+1, f'{b.get_height():.0f}%', ha='center', fontsize=11)\naxes[1].grid(True, linestyle='--', alpha=0.3, axis='y')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "选取航空航天3D打印市场规模（2024/2025/2035）反映增长趋势，选取F-22、歼-20、F-35、B-2、波音787、A350的复合材料用量占比反映应用深度。通过双子图对比市场扩张与材料替代进展，完成数据清洗、类型转换与专业可视化。"}}

