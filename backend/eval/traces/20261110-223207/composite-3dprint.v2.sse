data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:13:40.360043", "content": {"results": [{"id": "fact_a65205cc", "title": "光威复材产品条线显示：T300H为航空用主力碳纤维，2008年产业化项目投产并已批量供应十余年；CCF700G为航空用高端碳纤维，2022年通过装机评审并开始生...", "source": "小牛行研（引用公司公告/西南证券整理）", "url": "", "snippet": "光威复材产品条线显示：T300H为航空用主力碳纤维，2008年产业化项目投产并已批量供应十余年；CCF700G为航空用高端碳纤维，2022年通过装机评审并开始生产供货；T800H为新一代航空用碳纤维，2022年一条龙项目通过并开始批量应用，待千吨线等同性验证通过后放量；40J/M55J/M60J/M65J用于航天卫星结构件。", "date": "", "isSupplementary": false}, {"id": "fact_170c32a3", "title": "小牛行研报告图表标题显示“美国新一代战机复材占比相对更高”，并列出“中外典型无人机型号复材占比”，但搜索结果未给出具体数值。", "source": "小牛行研", "url": "", "snippet": "小牛行研报告图表标题显示“美国新一代战机复材占比相对更高”，并列出“中外典型无人机型号复材占比”，但搜索结果未给出具体数值。", "date": "", "isSupplementary": false}, {"id": "fact_15397ddb", "title": "仿真秀文章称，日本东丽T800系列碳纤维是唯一被美国联邦航空管理局批准用于波音777关键飞行部件的碳纤维；空客A380上碳纤维等复合材料用量达到飞机结构用量的2...", "source": "仿真秀", "url": "", "snippet": "仿真秀文章称，日本东丽T800系列碳纤维是唯一被美国联邦航空管理局批准用于波音777关键飞行部件的碳纤维；空客A380上碳纤维等复合材料用量达到飞机结构用量的25%，波音787和空客A350的碳纤维复合材料使用量占比达到50%以上。", "date": "", "isSupplementary": false}, {"id": "fact_329edfc6", "title": "仿真秀文章称，军事领域自上世纪70年代起美国就在战略导弹和作战飞机中使用碳纤维增强树脂材料；用碳纤维复合材料替换金属可提升隐身性能并降低结构重量、提高推重比。", "source": "仿真秀", "url": "", "snippet": "仿真秀文章称，军事领域自上世纪70年代起美国就在战略导弹和作战飞机中使用碳纤维增强树脂材料；用碳纤维复合材料替换金属可提升隐身性能并降低结构重量、提高推重比。", "date": "", "isSupplementary": false}, {"id": "fact_b8d6e16c", "title": "东丽旧版资料PDF列出T620S（面向叶片开发）、T1000G、T800S、T800H等产品，T620S可用24K和48K丝束，并展示GL认证的T620SC-2...", "source": "原创力文档（Toray资料，版权2010 Toray Industries）", "url": "", "snippet": "东丽旧版资料PDF列出T620S（面向叶片开发）、T1000G、T800S、T800H等产品，T620S可用24K和48K丝束，并展示GL认证的T620SC-24K-50C、T620SC-24K-60E。", "date": "", "isSupplementary": false}, {"id": "fact_2deb9e34", "title": "抖音视频称东丽官方回复T1200仍在研发阶段，用于航空领域，体育领域最早也要2026年以后。", "source": "抖音", "url": "", "snippet": "抖音视频称东丽官方回复T1200仍在研发阶段，用于航空领域，体育领域最早也要2026年以后。", "date": "", "isSupplementary": false}, {"id": "fact_982c1839", "title": "1688商品页展示“航空发动机用T800级碳纤维增强聚酰亚胺复合材料”，标注技术定制、耐温-80至2500度、耐盐雾耐酸碱，但为商业商品页，未提供军工认证或装机...", "source": "1688", "url": "", "snippet": "1688商品页展示“航空发动机用T800级碳纤维增强聚酰亚胺复合材料”，标注技术定制、耐温-80至2500度、耐盐雾耐酸碱，但为商业商品页，未提供军工认证或装机信息。", "date": "", "isSupplementary": false}, {"id": "fact_c0a1f8f8", "title": "小牛行研行业研究数据称，F-35碳纤维复合材料用量达到36%，F-22为24%；并称早期战机碳纤维复材用量仅约1%。", "source": "小牛行研", "url": "", "snippet": "小牛行研行业研究数据称，F-35碳纤维复合材料用量达到36%，F-22为24%；并称早期战机碳纤维复材用量仅约1%。", "date": "", "isSupplementary": false}, {"id": "fact_fe7b01b6", "title": "小牛行研另一份行业研究数据称，F-15E的CFRP比例为2%、铝合金比例为49%；F-22铝合金含量降至16%、CFRP比例达24%。", "source": "小牛行研", "url": "", "snippet": "小牛行研另一份行业研究数据称，F-15E的CFRP比例为2%、铝合金比例为49%；F-22铝合金含量降至16%、CFRP比例达24%。", "date": "", "isSupplementary": false}, {"id": "fact_6c1b71ac", "title": "智上新材料文章称，F/A-18E/F的CFRP比例提高到19%，铝合金比例降至31%；F-22的CFRP比例为24%、铝合金含量为16%。", "source": "智上新材料", "url": "", "snippet": "智上新材料文章称，F/A-18E/F的CFRP比例提高到19%，铝合金比例降至31%；F-22的CFRP比例为24%、铝合金含量为16%。", "date": "", "isSupplementary": false}, {"id": "fact_69dd3b01", "title": "小牛行研称C-17复材占比约8%，并称中国固定翼军机复材占比仍有较大提升空间。", "source": "小牛行研", "url": "", "snippet": "小牛行研称C-17复材占比约8%，并称中国固定翼军机复材占比仍有较大提升空间。", "date": "", "isSupplementary": false}, {"id": "fact_d0b881cb", "title": "东方财富网股吧帖子称歼-20碳纤维使用量约为27%，歼-35碳纤维使用量占比约为30%（原文不完整）；该帖为论坛个人观点，未给出官方出处。", "source": "东方财富网股吧", "url": "", "snippet": "东方财富网股吧帖子称歼-20碳纤维使用量约为27%，歼-35碳纤维使用量占比约为30%（原文不完整）；该帖为论坛个人观点，未给出官方出处。", "date": "", "isSupplementary": false}, {"id": "fact_865d31de", "title": "ScienceDirect论文对CFRP参考复合材料进行micro-XCT表征，测得孔隙率4.37%v，组分为66%w碳纤维和34%w基体；该数据为材料表征结果...", "source": "ScienceDirect", "url": "", "snippet": "ScienceDirect论文对CFRP参考复合材料进行micro-XCT表征，测得孔隙率4.37%v，组分为66%w碳纤维和34%w基体；该数据为材料表征结果，不是战机整机复材用量。", "date": "", "isSupplementary": false}, {"id": "fact_7739c456", "title": "dronefromchina文章称碳纤维含碳量超过90%，具有高比强度、高比模量等性能，广泛用于军民领域；未给出具体战机型号的复材用量。", "source": "www.dronefromchina.com", "url": "", "snippet": "dronefromchina文章称碳纤维含碳量超过90%，具有高比强度、高比模量等性能，广泛用于军民领域；未给出具体战机型号的复材用量。", "date": "", "isSupplementary": false}, {"id": "fact_01269e16", "title": "2014年3月，日本东丽工业有限公司宣布，继T800S和T1000G之后研制成功T1100G新型碳纤维及其高性能树脂预浸料，称其填补了高强高模碳纤维的空白。", "source": "道客巴巴《2014年十大国防材料技术》", "url": "", "snippet": "2014年3月，日本东丽工业有限公司宣布，继T800S和T1000G之后研制成功T1100G新型碳纤维及其高性能树脂预浸料，称其填补了高强高模碳纤维的空白。", "date": "", "isSupplementary": false}, {"id": "fact_560bd74e", "title": "道客巴巴文档称东丽T1100G同时实现高强度和高模量，抗拉强度达到6.6吉帕。", "source": "道客巴巴《2014年十大国防材料技术》", "url": "", "snippet": "道客巴巴文档称东丽T1100G同时实现高强度和高模量，抗拉强度达到6.6吉帕。", "date": "", "isSupplementary": false}, {"id": "fact_1e88959c", "title": "中国知网《合成纤维工业》2014年04期摘要称，东丽T800S和T1000G碳纤维产品已经在航空航天等多个领域得到广泛应用，但高端市场仍期待更高品质碳纤维。", "source": "中国知网《东丽推出高强高模Torayca新品T1100G》摘要", "url": "", "snippet": "中国知网《合成纤维工业》2014年04期摘要称，东丽T800S和T1000G碳纤维产品已经在航空航天等多个领域得到广泛应用，但高端市场仍期待更高品质碳纤维。", "date": "", "isSupplementary": false}, {"id": "fact_6382ce43", "title": "中国知网摘要称，东丽通过精细控制碳化技术，在纳米层级内控制纤维结构，并开发基体树脂技术以提高预浸料抗拉强度和抗冲击性，该技术被纳入T1100G碳纤维中。", "source": "中国知网《东丽推出高强高模Torayca新品T1100G》摘要", "url": "", "snippet": "中国知网摘要称，东丽通过精细控制碳化技术，在纳米层级内控制纤维结构，并开发基体树脂技术以提高预浸料抗拉强度和抗冲击性，该技术被纳入T1100G碳纤维中。", "date": "", "isSupplementary": false}, {"id": "fact_a20b2952", "title": "1688/阿里巴巴商品页出现东丽T400、T800、T1000碳纤维粉/丝销售信息，部分商品描述标注“航空航天军工能源电池正负极专用”，但属于商家营销描述，未提...", "source": "1688/阿里巴巴商品页", "url": "", "snippet": "1688/阿里巴巴商品页出现东丽T400、T800、T1000碳纤维粉/丝销售信息，部分商品描述标注“航空航天军工能源电池正负极专用”，但属于商家营销描述，未提供东丽官方认证、军机型号应用或采购证明。", "date": "", "isSupplementary": false}, {"id": "fact_3cdac367", "title": "本次搜索结果未包含东丽官网TORAYCA技术数据表、军机复合材料认证证书、主机厂合格供应商目录或国防采购公告，因此无法据此验证T1100G/T800S在军机上的...", "source": "本次搜索结果整体", "url": "", "snippet": "本次搜索结果未包含东丽官网TORAYCA技术数据表、军机复合材料认证证书、主机厂合格供应商目录或国防采购公告，因此无法据此验证T1100G/T800S在军机上的认证状态和具体应用。", "date": "", "isSupplementary": false}]}}

