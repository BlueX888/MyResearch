data: {"type": "knowledge_graph", "agent": "DataAnalyst", "timestamp": "2026-11-10T23:15:57.849026", "content": {"graph": {"nodes": [{"id": "aero3dp", "name": "航空航天3D打印", "type": "core", "importance": 10, "size": 50}, {"id": "composite", "name": "复合材料", "type": "core", "importance": 10, "size": 50}, {"id": "fighter", "name": "军用战机制造", "type": "core", "importance": 9, "size": 47}, {"id": "metal3dp", "name": "金属3D打印", "type": "tech", "importance": 9, "size": 47}, {"id": "ded", "name": "激光定向能量沉积", "type": "tech", "importance": 8, "size": 44}, {"id": "lpbf", "name": "铺粉式金属3D打印", "type": "tech", "importance": 8, "size": 44}, {"id": "afp", "name": "自动铺丝机", "type": "tech", "importance": 7, "size": 41}, {"id": "atl", "name": "自动铺带机", "type": "tech", "importance": 7, "size": 41}, {"id": "hanlaser", "name": "大族激光", "type": "company", "importance": 7, "size": 41}, {"id": "sdu", "name": "山东大学航空构件制造技术及装备研究中心", "type": "company", "importance": 7, "size": 41}, {"id": "boeing", "name": "波音", "type": "company", "importance": 7, "size": 41}, {"id": "airbus", "name": "空客", "type": "company", "importance": 7, "size": 41}, {"id": "b787", "name": "波音787", "type": "product", "importance": 6, "size": 38}, {"id": "a350", "name": "空客A350", "type": "product", "importance": 6, "size": 38}, {"id": "policy", "name": "政策扶持", "type": "policy", "importance": 5, "size": 35}], "edges": [{"source": "aero3dp", "target": "fighter", "relation": "应用于"}, {"source": "composite", "target": "fighter", "relation": "应用于"}, {"source": "composite", "target": "fighter", "relation": "提升隐身"}, {"source": "metal3dp", "target": "aero3dp", "relation": "属于"}, {"source": "ded", "target": "metal3dp", "relation": "属于"}, {"source": "lpbf", "target": "metal3dp", "relation": "属于"}, {"source": "hanlaser", "target": "lpbf", "relation": "研发"}, {"source": "sdu", "target": "lpbf", "relation": "研发"}, {"source": "afp", "target": "composite", "relation": "铺放"}, {"source": "atl", "target": "composite", "relation": "成型"}, {"source": "atl", "target": "aero3dp", "relation": "基于"}, {"source": "boeing", "target": "b787", "relation": "生产"}, {"source": "airbus", "target": "a350", "relation": "生产"}, {"source": "b787", "target": "composite", "relation": "使用"}, {"source": "a350", "target": "composite", "relation": "使用"}, {"source": "policy", "target": "aero3dp", "relation": "促进"}, {"source": "policy", "target": "composite", "relation": "促进"}]}, "stats": {"entities_count": 15, "relations_count": 17}}}

data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T23:15:57.849300", "content": {"charts": [{"id": "chart_001", "title": "全球航空航天3D打印市场规模", "subtitle": "2024-2035年市场规模（亿美元，2035年为预测值）", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "tooltip": {"trigger": "axis", "formatter": "{b}年<br/>{c} 亿美元"}, "xAxis": {"type": "category", "data": ["2024", "2025", "2035"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "亿美元", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"type": "line", "data": [24, 28.8, 178.3], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#1677ff"}}]}}, {"id": "chart_002", "title": "军机复合材料用量占比对比", "subtitle": "中国军机与国外先进机型（%）", "type": "bar", "echarts_option": {"grid": {"left": "30%", "right": "10%", "top": "5%", "bottom": "5%"}, "tooltip": {"trigger": "axis", "axisPointer": {"type": "shadow"}, "formatter": "{b}<br/>{c}%"}, "xAxis": {"type": "value", "max": 60, "axisLine": {"show": false}, "axisTick": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666", "formatter": "{value}%"}}, "yAxis": {"type": "category", "data": ["中国军机（初始）", "中国军机（当前）", "中国军机（目标）", "国外军机（下限）", "国外军机（上限）", "波音787", "空客A350"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 12}}, "series": [{"type": "bar", "data": [{"value": 1, "itemStyle": {"color": "#1677ff"}}, {"value": 20, "itemStyle": {"color": "#1677ff"}}, {"value": 29, "itemStyle": {"color": "#52c41a"}}, {"value": 25, "itemStyle": {"color": "#722ed1"}}, {"value": 50, "itemStyle": {"color": "#722ed1"}}, {"value": 50, "itemStyle": {"color": "#fa8c16"}}, {"value": 52, "itemStyle": {"color": "#fa8c16"}}], "barWidth": 14, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#666"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}, {"id": "chart_003", "title": "航空航天3D打印材料市场份额", "subtitle": "2024年材料结构占比", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}<br/>{c}%"}, "legend": {"bottom": "5%", "textStyle": {"color": "#666"}}, "series": [{"type": "pie", "radius": ["40%", "65%"], "center": ["50%", "45%"], "avoidLabelOverlap": true, "itemStyle": {"borderRadius": 4, "borderColor": "#fff", "borderWidth": 2}, "label": {"show": true, "formatter": "{b}\n{d}%", "color": "#333"}, "labelLine": {"length": 10, "length2": 10}, "data": [{"name": "金属材料", "value": 89.09, "itemStyle": {"color": "#1677ff"}}, {"name": "聚合物基与陶瓷基", "value": 10.91, "itemStyle": {"color": "#52c41a"}}]}]}}, {"id": "chart_004", "title": "铂力特客户集中度", "subtitle": "前五大客户及航空航天客户销售占比（%）", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "30%", "right": "15%", "top": "5%", "bottom": "5%"}, "tooltip": {"trigger": "axis", "axisPointer": {"type": "shadow"}, "formatter": "{b}<br/>{c}%"}, "xAxis": {"type": "value", "show": false, "max": 100}, "yAxis": {"type": "category", "data": ["前五名客户销售金额占比", "前三家航空航天客户销售占比"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 68.35, "itemStyle": {"color": "#1677ff"}}, {"value": 53.76, "itemStyle": {"color": "#722ed1"}}], "barWidth": 16, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#666"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}]}}

