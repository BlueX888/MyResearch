data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T23:07:21.127417", "content": {"graph": {"nodes": [{"id": "node_0", "name": "Market Research Future (MRFR)", "type": "company", "discovered_at": "2026-11-10T23:07:21.127269"}, {"id": "node_1", "name": "QYResearch", "type": "company", "discovered_at": "2026-11-10T23:07:21.127279"}, {"id": "node_2", "name": "华经产业研究院", "type": "company", "discovered_at": "2026-11-10T23:07:21.127287"}, {"id": "node_3", "name": "报告大厅", "type": "company", "discovered_at": "2026-11-10T23:07:21.127295"}, {"id": "node_4", "name": "金属增材制造（钛合金/镍基超合金/铝合金粉末）", "type": "technology", "discovered_at": "2026-11-10T23:07:21.127302"}, {"id": "node_5", "name": "聚合物基与陶瓷基3D打印", "type": "technology", "discovered_at": "2026-11-10T23:07:21.127312"}, {"id": "node_6", "name": "复合材料自动铺放（ATL/AFP）", "type": "technology", "discovered_at": "2026-11-10T23:07:21.127317"}, {"id": "node_7", "name": "热塑性复合材料", "type": "technology", "discovered_at": "2026-11-10T23:07:21.127324"}, {"id": "node_8", "name": "航空发动机部件3D打印", "type": "technology", "discovered_at": "2026-11-10T23:07:21.127330"}], "edges": [{"source": "Market Research Future (MRFR)", "relation": "航空航天3D打印市场规模预测数据源", "discovered_at": "2026-11-10T23:07:21.127273"}, {"source": "Market Research Future (MRFR)", "relation": "被腾讯新闻引用", "discovered_at": "2026-11-10T23:07:21.127276"}, {"source": "QYResearch", "relation": "航空航天3D打印材料结构89.09%数据源", "discovered_at": "2026-11-10T23:07:21.127282"}, {"source": "QYResearch", "relation": "被小牛行研、三个皮匠报告引用", "discovered_at": "2026-11-10T23:07:21.127284"}, {"source": "华经产业研究院", "relation": "中国军机复合材料用量占比数据源", "discovered_at": "2026-11-10T23:07:21.127289"}, {"source": "华经产业研究院", "relation": "航空复材零部件行业报告发布方", "discovered_at": "2026-11-10T23:07:21.127291"}, {"source": "报告大厅", "relation": "军用3D打印市场报告发布方", "discovered_at": "2026-11-10T23:07:21.127298"}, {"source": "金属增材制造（钛合金/镍基超合金/铝合金粉末）", "relation": "占航空航天3D打印89.09%份额", "discovered_at": "2026-11-10T23:07:21.127305"}, {"source": "金属增材制造（钛合金/镍基超合金/铝合金粉末）", "relation": "应用于航空发动机与承力结构件", "discovered_at": "2026-11-10T23:07:21.127307"}, {"source": "聚合物基与陶瓷基3D打印", "relation": "应用于客舱内饰、非承力件与高温环境部件", "discovered_at": "2026-11-10T23:07:21.127314"}, {"source": "复合材料自动铺放（ATL/AFP）", "relation": "h_2假设中的主流工艺路线，本次搜索未获得证据", "discovered_at": "2026-11-10T23:07:21.127321"}, {"source": "热塑性复合材料", "relation": "h_2假设中的技术路线，本次搜索未获得证据", "discovered_at": "2026-11-10T23:07:21.127327"}, {"source": "航空发动机部件3D打印", "relation": "航空航天3D打印占比最高的应用领域", "discovered_at": "2026-11-10T23:07:21.127334"}]}, "stats": {"entitiesCount": 9, "relationsCount": 13}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:07:21.127532", "content": {"agent": "DeepScout", "section": "市场概况", "facts_count": 8, "duplicates_removed": 0, "data_points_count": 13, "insights": ["市场规模数据存在明显口径冲突：MRFR口径下2024年全球航空航天3D打印为24亿美元（约170亿元人民币），而报告大厅口径下2026年全球军用3D打印仅177亿元人民币，两者量级接近但一为“航空航天整体”、一为“军用”，说明军用细分市场占比可能被高估或统计口径混乱，需谨慎使用。", "增长叙事高度一致（CAGR 20%—23%），但所有高增长结论均来自二手转述的咨询机构数据，无一家原始报告可核验，且部分文档关键数值被“XX”脱敏，属于典型的“结论可信、数字不可引用”状态。", "材料结构证据相对扎实：金属基占航空航天3D打印近九成份额，说明当前增材制造在战机上的价值量仍集中在发动机热端与承力结构件，而非大面积机体结构；这与“复合材料减重靠自动铺放、增材靠金属件”的分工逻辑吻合。"], "source_quality": "整体来源质量偏低（加权可信度约0.45）。8条结果中，5条来自文档分享平台（原创力文档、人人文库），属用户上传的模板化报告，关键数值以“XX”脱敏、无原始出处，可信度仅0.25—0.3；2条为行业数据聚合站（小牛行研、三个皮匠报告）转述QYResearch，可信度0.65—0.7，但同一数据重复出现不构成独立交叉验证；1条为腾讯新闻转述MRFR，可信度0.6；1条为报告大厅，数据修订于2020年，时效性差。所有结果均未直接链接到QYResearch、MRFR原始报告或官方统计（如SIPRI、美国国防部预算文件、中国航空工业集团年报），且“军用”与“航空航天整体”口径混用严重。建议后续优先补充券商深度报告（中信、中金、国盛军工）、政府/央企公开文件及原始咨询机构摘要，以替换当前低质量证据。", "hypothesis_updates": 3, "search_results": [{"title": "2024年航空航天3D打印市场发展现状.doc-原创力文档", "url": "https://max.book118.com/html/2024/0513/5303312102011210.shtm", "source": "原创力文档", "snippet": "根据研究机构 的数据,航空航天3D打印市场预计在未来几年内将以每年10%的复合增长率增长, 到2025年有望达到100亿美元规模。 3.主要应用领域 航空航天领域对于航空航天3D打印技术的需求非常迫切,并在多个领域进行广 泛应用。 3.1航空发动机部件制造 航空发动机部件是航空航天3D打印技术的重要应用领域之一。通过3D打印技术, 可以制造出复杂形状的发动机零部件,提高燃烧效率,降低重量。", "date": "2024-05-15T14:57:05+08:00"}, {"title": "2025年军用3D打印市场分析报告", "url": "https://m.chinabgao.com/k/jy3Ddy/analysis/", "source": "报告大厅", "snippet": "2020-2026全球及中国 军用3D打印 行业发展现状调研及投资前景分析报告\n2019年全球军用3D打印市场总值达到了42亿元,预计2026年可以增长到177亿元,年复合增长率(CAGR)为22.7%。 ... [详细] 编号:No.6150679 最新修订:2020年04月\n2020-2026全球及中国 军用3D打印 行业发展现状调研及投资前景分析报告\n2019年全球军用3D打印市场总值达到了42亿元,预计2026年可以增长到177亿元,年复合增长率(CAGR)为22.7%。 ... [详细] 编号:No.6150679 最新修订:2020年04月", "date": "2025-01-01T08:00:00+08:00"}, {"title": "2024年按材料类型分航空航天3D打印全球市场规模占比 - 2024年10月-行业研究数据 - 小牛行研", "url": "https://www.hangyan.co/charts/3490253374647960625", "source": "小牛行研", "snippet": "航空航天领域需要具有高韧性、耐热性和耐腐蚀性的高性能材料,以满足使用条件的要求,3D 打印用材料主要为金属基复合材料,据QYResearch 报告,2024 年金属材料占航空航天 3D 打印全球市场 89.09%的份额。适用于 3D 打印的特殊材料有铝合金、不锈钢、钛合金、镍基和铁基超合金、铜合金、钴合金、耐高温合金及其他金属材料;其中大部分 3D 打印原料以合金粉末或丝、线材的形式使用。在航天领域中,如火箭发动机,由多种型号的零部件组成,不同零部件需要结合材料的力学性能来满足特殊使用环境,因此材料的选择至关重要。", "date": "2024-10-31T07:42:35+08:00"}, {"title": "2025年中国航空航天3D打印市场前景预测及未来发展趋势报告.docx-原创力文档", "url": "https://max.book118.com/html/2025/0124/8074052053007025.shtm", "source": "原创力文档", "snippet": "研究报告 PAGE 1- 2025年中国航空航天3D打印市场前景预测及未来发展趋势报告 一、市场概述 1.1市场规模与增长趋势 (1)根据最新市场调研数据,2025年中国航空航天3D打印市场规模预计将超过XX亿元,较2020年增长XX%。这一增长趋势得益于国家对航空航天产业的重视,以及3D打印技术在航空航天领域的广泛应用。随着航空制造技术的不断进步,对轻量化、定制化产品的需求日益增加,3D打印技术因其独特的优势,在航空航天领域的应用前景十分广阔。 (2)从细分市场来看,航空航天3D打印市场主要分为航空发动机、飞机结构件、飞机内饰等几个部分。其中,航空发动机领域占比最高,预计2025年将达到XX%。随着航空发动机技术的不断突破,对高性能、轻量化零部件的需求日益增加,3D打印技术在航空发动机领域的应用潜力巨大。此外,飞机结构件和内饰领域的市场规模也在稳步增长,预计未来几年将保持较高的增速。 (3)未来,中国航空航天3D打印市场规模的增长将受到多方面因素的影响。首先,随着航空制造技术的不断进步,对3D打印技术的需求将持续增长。其次,国家对航空航天产业的政策支持力度加大,将进一步推动3D打印技术在航空航天领域的应用。此外,全球航空航天市场的不断扩大,也将为中国航空航天3D打印市场提供广阔的发展空间。预计到2025年,中国航空航天3D打印市场规模将达到XX亿元,成为全球航空航天3D打印市场的重要力量。 1.2产品类型与应用领域 (1)中国航空航天3D打印市场涉及的产品类型丰富多样,主要包括金属3D打印、塑料3D打印和陶瓷3D打印等。金属3D打印在航空航天领域占据重要地位,尤其适用于复杂结构件的制造,如飞机发动机部件、航空器结构件等。塑料3D打印则广泛应用于飞机内饰、非结构件制造等领域,具有成本低、制造周期短等优势。陶瓷3D打印技术也在逐步应用于航空航天领域,用于制造耐高温、耐腐蚀的部", "date": "2025-02-08T16:34:02+08:00"}, {"title": "2024年按材料类型分航空航天3D打印全球市场规模占比-行业数据-三个皮匠报告", "url": "https://www.sgpjbg.com/hyshuju/0553568a62545833636244e4040b0d26.html", "source": "三个皮匠报告", "snippet": "航空航天领域需要具有高韧性、耐热性和耐腐蚀性的高性能材料,以满足使用条件的要求,3D 打印用材料主要为金属基复合材料,据QYResearch 报告,2024年金属材料占航空航天 3D打印全球市场 89.09%的份额。适用于 3D打印的特殊材料有铝合金、不锈钢、钛合金、镍基和铁基超合金、铜合金、钴合金、耐高温合金及其他金属材料;其中大部分 3D打印原料以合金粉末或丝、线材的形式使用。在航天领域中,如火箭发动机,由多种型号的零部件组成,不同零部件需要结合材料的力学性能来满足特殊使用环境,因此材料的选择至关重要。", "date": "2024-01-01T00:00:00+08:00"}, {"title": "最新航空复材零部件相关文章_华经情报网_华经产业研究院", "url": "https://www.huaon.com/tag/hangkongfucailingbujian", "source": "华经情报网", "snippet": "复合材料正成为航空以及国防装备的关键材料。复合材料在我国军机的用量占比不断提升,已从最初用量1%左右提升至20%左右,且目标用量将增加至29%。 2024-2030年中国航空复材零部件行业市场调查研究及投资前景展望报告,主要包括行业竞争形势及策略、重点企业发展分析、投资前景、投资风险及策略建议等内容。", "date": "2024-09-10T01:14:57+08:00"}, {"title": "航空航天3D打印市场加速发展,2035年将突破178亿美元_腾讯新闻", "url": "https://news.qq.com/rain/a/20251217A021LO00", "source": "腾讯网", "snippet": "2025年12月,南极熊获悉,据Market\nResearch\nFuture(MRFR)分析,2024年全球航空航天3D打印市场规模约为24亿美元。预计该市场将从2025年的28.8亿美元稳步攀升,到2035年达到178.3亿美元,2025至2035年间复合年增长率(CAGR)高达20.0%。3D打印正深刻改变飞机与航天器零部件的生产方式,它能制造复杂几何结构、大幅减少材料浪费,并显著缩短制造周期。核心增长驱动力行业对轻量化飞机的迫切需求是主要推力。轻质部件可提升燃油效率、降低碳排放。同时,航空制造商面临成本控制与交付提速的双重压力,促使他们加快采用3D打印技术。这项技术能以极低废料率生产高度定制化、结构复杂的零件,极大契合航空工程对性能与效率的要求。快速原型能力也加速了设计验证与迭代。此外,新一代飞机与航天器订单持续增长、商用机队不断扩张,进一步拉动市场需求。高性能聚合物与金属合金等可打印材料的进步,也让3D打印部件在强度与可靠性上满足严苛的航空标准。市场细分格局•按材料类型,市场分为金属基、聚合物基和陶瓷基3D打印。其中,金属基占据主导地位,广泛用于发动机与承力结构件;聚合物基在客舱内饰与轻质非承力部件中应用增多;陶瓷基则逐步进入高温环境应用场景。•按用途划分,包括原型制作、工装夹具和功能部件制造。原型仍是基础应用,但功能部件制造正快速增长,越来越多经认证的3D打印零件已用于商用与军用飞机。•在技术方面,立体光刻(SLA)占据最大的市场份额。SLA能够生产高精度零件,使其成为航空航天应用中制造复杂原型和组件的首选。与此同时,选择性激光烧结(SLS)凭借其能够利用多种材料并生产对航空航天功能至关重要的坚固零件,正迅速成为增长最快的技术。未来关键机遇随着更多关键部件获得适航认证,3D打印将从辅助角色转向核心制造环节。各国加大太空计划投入,为高性能打印部件创造新需求。人工智能", "date": "2025-12-17T08:20:47+08:00"}, {"title": "2025-2030年复合材料3D打印创新行业深度调研及发展战略咨询报告", "url": "https://m.renrendoc.com/paper/387768078.html", "source": "人人文库", "snippet": "上传人:1*** IP属地:重庆 上传时间:2025-02-13 格式:DOCX 页数:32 大小:31.91KB 积分:49\n第1页 / 共32页\n第2页 / 共32页\n第3页 / 共32页\n第4页 / 共32页\n第5页 / 共32页\n文档描述\n研究报告-1-2025-2030年复合材料3D打印创新行业深度调研及发展战略咨询报告一、行业背景分析1.1全球复合材料3D打印市场现状(1)近年来,全球复合材料3D打印市场呈现出快速增长的趋势。根据最新市场研究报告,预计到2025年,全球复合材料3D打印市场规模将达到XX亿美元,年复合增长率达到XX%。这一增长主要得益于航空航天、汽车制造、医疗健康等领域对高性能复合材料的需求不断上升。以航空航天领域为例,复合材料3D打印技术已被广泛应用于飞机结构件、发动机部件等领域,显著提升了飞行器的性能和可靠性。(2)在全球范围内,美国、欧洲和亚洲是复合材料3D打印市场的主要参与者。美国凭借其强大的研发能力和市场基础,占据了全球市场的重要份额。欧洲则在材料科学和加工技术方面具有显著优势,尤其是在碳纤维增强塑料3D打印领域。亚洲,尤其是中国,近年来在复合材料3D打印领域的发展速度惊人,政府的大力支持和产业政策的扶持使得亚洲市场增长迅速。以中国市场为例,2019年,我国复合材料3D打印市场规模达到XX亿元,同比增长XX%,预计未来几年仍将保持高速增长。(3)复合材料3D打印技术的快速发展也带动了相关产业链的壮大。从原材料供应商到设备制造商,再到应用企业,整个产业链上下游的企业都在积极布局这一领域。例如,全球领先的3D打印设备制造商Stratasys和EOS,以及材料供应商如SGLCarbon和Hexcel,都在不断推出新产品和解决方案,以满足市场需求。此外,许多初创企业也在积极探索复合材料3D打印技术的创新应用,如医疗植入物、体育用品等领域。以医疗", "date": "2025-02-13T08:00:00+08:00"}], "extracted_facts": [{"content": "据Market Research Future（MRFR）分析，2024年全球航空航天3D打印市场规模约为24亿美元，2025年约28.8亿美元，预计2035年达到178.3亿美元，2025—2035年复合年增长率约20.0%；增长驱动力包括轻量化需求、成本与交付压力、快速原型验证、新一代飞机与航天器订单增长以及可打印材料性能提升。", "source_name": "腾讯新闻（转载MRFR数据）", "source_url": "https://news.qq.com/rain/a/20251217A021LO00", "credibility": 0.6}, {"content": "据QYResearch报告，2024年金属材料占航空航天3D打印全球市场89.09%的份额，其余为聚合物基与陶瓷基；3D打印原料主要为铝合金、不锈钢、钛合金、镍基/铁基超合金、铜合金、钴合金及耐高温合金，多以合金粉末或丝线材形式使用。", "source_name": "小牛行研（引用QYResearch）", "source_url": "https://www.hangyan.co/charts/3490253374647960625", "credibility": 0.7}, {"content": "同一QYResearch数据在三个皮匠报告平台重复出现，确认2024年金属材料占航空航天3D打印全球市场89.09%份额，材料体系以钛合金、镍基超合金、铝合金等金属粉末为主。", "source_name": "三个皮匠报告", "source_url": "https://www.sgpjbg.com/hyshuju/0553568a62545833636244e4040b0d26.html", "credibility": 0.65}, {"content": "2019年全球军用3D打印市场总值达42亿元，预计2026年增长至177亿元，年复合增长率22.7%（该报告最新修订于2020年4月，数据时效性较差）。", "source_name": "报告大厅《2025年军用3D打印市场分析报告》", "source_url": "https://m.chinabgao.com/k/jy3Ddy/analysis/", "credibility": 0.55}, {"content": "复合材料正成为航空及国防装备的关键材料，我国军机复合材料用量占比已从最初约1%提升至约20%，目标用量将增加至29%。", "source_name": "华经情报网（华经产业研究院）", "source_url": "https://www.huaon.com/tag/hangkongfucailingbujian", "credibility": 0.7}, {"content": "航空航天3D打印市场预计未来几年以每年10%的复合增长率增长，到2025年有望达到100亿美元规模；航空发动机部件是重要应用领域，3D打印可制造复杂形状零部件以提高燃烧效率、降低重量。", "source_name": "原创力文档《2024年航空航天3D打印市场发展现状》", "source_url": "https://max.book118.com/html/2024/0513/5303312102011210.shtm", "credibility": 0.3}, {"content": "中国航空航天3D打印市场细分中航空发动机领域占比最高，飞机结构件与内饰市场稳步增长；但报告关键数值均以“XX”脱敏，无法提取有效量化数据。", "source_name": "原创力文档《2025年中国航空航天3D打印市场前景预测报告》", "source_url": "https://max.book118.com/html/2025/0124/8074052053007025.shtm", "credibility": 0.25}, {"content": "全球复合材料3D打印市场快速增长，美国、欧洲、亚洲为主要参与者：美国凭研发能力与市场基础占重要份额，欧洲在碳纤维增强塑料3D打印的材料科学与加工技术具优势，中国在政策扶持下增长迅速；但报告具体数值均被“XX”脱敏。", "source_name": "人人文库《2025-2030年复合材料3D打印创新行业深度调研报告》", "source_url": "https://m.renrendoc.com/paper/387768078.html", "credibility": 0.25}], "data_points": [{"name": "全球航空航天3D打印市场规模", "value": "24", "unit": "亿美元", "year": 2024, "source": "腾讯新闻（转载MRFR数据）"}, {"name": "全球航空航天3D打印市场规模", "value": "28.8", "unit": "亿美元", "year": 2025, "source": "腾讯新闻（转载MRFR数据）"}, {"name": "全球航空航天3D打印市场规模（预测）", "value": "178.3", "unit": "亿美元", "year": 2035, "source": "腾讯新闻（转载MRFR数据）"}, {"name": "2025-2035年复合年增长率", "value": "20.0", "unit": "%", "year": 2025, "source": "腾讯新闻（转载MRFR数据）"}, {"name": "金属材料占航空航天3D打印市场份额", "value": "89.09", "unit": "%", "year": 2024, "source": "小牛行研（引用QYResearch）"}, {"name": "金属材料占航空航天3D打印市场份额", "value": "89.09", "unit": "%", "year": 2024, "source": "三个皮匠报告"}, {"name": "全球军用3D打印市场总值", "value": "42", "unit": "亿元", "year": 2019, "source": "报告大厅《2025年军用3D打印市场分析报告》"}, {"name": "全球军用3D打印市场总值（预测）", "value": "177", "unit": "亿元", "year": 2026, "source": "报告大厅《2025年军用3D打印市场分析报告》"}, {"name": "2019-2026年复合年增长率", "value": "22.7", "unit": "%", "year": 2020, "source": "报告大厅《2025年军用3D打印市场分析报告》"}, {"name": "中国军机复合材料用量占比（当前）", "value": "20", "unit": "%", "year": 2024, "source": "华经情报网（华经产业研究院）"}]}}

