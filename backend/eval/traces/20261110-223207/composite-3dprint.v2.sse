data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T23:06:52.794207", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述全球军用航空复合材料与增材制造市场规模、增速及驱动因素，按材料类型、工艺路线、战机机型、应用部件和地区拆分，分析新一代战机列装、现役机型升级和备件保障带来的需求。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["军用航空复合材料 市场规模 增速 3D打印 战机 制造 2024 2025"]}, {"id": "sec_2", "title": "竞争格局", "description": "梳理主要整机厂、复合材料供应商、增材制造设备商和服务商，包括Hexcel、Toray、Syensqo、GE Aerospace、Renishaw、EOS、铂力特、华曙高科、中航高科等，分析其军工资质、产品布局、客户关系和市场份额。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["战机 复合材料 3D打印 主要企业 供应商 竞争格局 GE Hexcel 铂力特 中航高科"]}, {"id": "sec_3", "title": "技术趋势", "description": "分析碳纤维增强复合材料、自动铺丝铺带、RTM、热塑性复合材料、连续纤维3D打印、激光粉末床熔融、定向能量沉积、拓扑优化、一体化成型、数字孪生和无损检测等核心技术在新一代战机上的应用现状与成熟度。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["战机 复合材料 自动铺丝 热塑性 3D打印 激光粉末床 定向能量沉积 一体化成型"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、装备采购计划、军品认证与适航要求、出口管制、供应链安全和保密政策对复合材料和3D打印应用的影响，比较主要国家政策走向及对市场格局的作用。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军用航空 复合材料 3D打印 政策 出口管制 国防预算 军品认证 供应链安全"]}, {"id": "sec_5", "title": "挑战机遇", "description": "挑战包括认证周期长、材料与设备成本高、缺陷检测和批产一致性难、供应链受限及技术保密；机遇包括轻量化减重、零件整合、快速迭代、备件保障、隐身结构优化和无人作战平台需求增长。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["战机 复合材料 3D打印 挑战 认证 成本 缺陷检测 机遇 轻量化"]}, {"id": "sec_6", "title": "未来展望", "description": "展望复合材料占比提升、热塑性复材和自动化铺放推广、增材制造从非承力件向承力件拓展、混合制造、数字孪生与AI质检、分布式制造和战备保障等发展趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["新一代战机 复合材料 3D打印 未来趋势 热塑性 承力件 混合制造 数字孪生"]}], "research_questions": ["新一代战机中复合材料和3D打印的应用比例及典型部件是什么？", "复合材料自动铺放和增材制造在批产中的成熟度与认证瓶颈如何？", "国防预算、出口管制和供应链政策如何影响市场格局与技术路线？"]}}

