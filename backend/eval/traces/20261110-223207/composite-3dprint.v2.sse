data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:07:34.651845", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["Wohlers Report 2021 global additive manufacturing market 12.758 billion", "Wohlers Associates 2024 全球增材制造市场规模 航空航天 占比"], "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:07:34.966421", "content": {"results": [{"id": "sr_7a7c79", "title": "Wohlers Report 2016 Published: Additive Manufacturing Industry Surpassed 5.1 Bil", "source": "wohlersassociates.com", "url": "http://wohlersassociates.com/press71.html", "snippet": "Wohlers Report 2016 Published: Additive Manufacturing Industry Surpassed $5.1 Billion FORT COLLINS, COLORADO, USA, April 5, 2016—Wohlers Associates, Inc., recognized widely as the leading consulting firm and preeminent authority on additive manufacturing and 3D printing worldwide—terms that are used interchangeably—today announced the publication of the  Wohlers Report 2016 . The 2016 edition marks the 21st consecutive year of its availability. According to  Wohlers Report 2016 , the additive manufacturing (AM) industry, consisting of all AM products and services worldwide, grew 25.9% (CAGR) to $5.165 billion in 2015. The CAGR for the previous three years was 31.5%. Over the past 27 years, the CAGR for the industry is an impressive 26.2%. The annual state-of-the-industry report is highly a", "date": "2022-05-24T19:12:08+08:00"}, {"id": "sr_2a501a", "title": "Additive Manufacturing Glossary of Terms - Wohlers Associates", "source": "wohlersassociates.com", "url": "https://wohlersassociates.com/am-glossary-of-terms/", "snippet": "The following are key terms used in Wohlers Report 2022 and across the additive manufacturing and 3D printing industry. Most of these terms conform to the ISO/ASTM 52900 terminology standard. An", "date": "2022-06-30T15:05:42+08:00"}, {"id": "sr_3b2100", "title": "Wohlers Report 2022:2021年增材制造的全球市场增长了19.5%-今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7076834361835897377/", "snippet": "Wohlers Report 2022是Wohlers Associates自去年年底被美国材料试验协会(ASTM)收购以来发布的第一份报告也是其发布的第27份增材制造行业年度报告。这份426页的报告提供了对全球AM行业当前状态的分析,确定", "date": "2022-03-19T23:36:00+08:00"}, {"id": "sr_dba08a", "title": "Metal Additive Manufacturing Market to grow by  4.42 Billion during 2020-2024  T", "source": "PR Newswire", "url": "https://www.prnewswire.com/news-releases/metal-additive-manufacturing-market-to-grow-by--4-42-billion-during-2020-2024--technavio-301349482.html", "snippet": "Share this article NEW YORK , Aug. 5, 2021 /PRNewswire/ -- According to Technavio, incremental growth of USD 4.42 billion is expected in the metal additive manufacturing market during 2020-2024. The", "date": "2021-08-05T10:55:00+08:00"}, {"id": "sr_e8c6ea", "title": "2021 年全球金属和塑料增材制造市场价值 83.3 亿欧元,AMPOWER发布报告_技术_零件_泰莱", "source": "搜狐", "url": "https://www.sohu.com/a/530789172_274912", "snippet": "3D科学谷的全球战略合作伙伴-来自德国汉堡的咨询公司AMPOWER于2021年3月16日发布了其《2022工业增材制造的年度市场报告》。该报告分析了2021年全球行业发展情况,并提供了未来5年的前景预测。 (该报告可在线获得,也可以在www.additive-manufacturing-report.com上以PDF格式获得。) 《2022增材制造市场报告》 © AMPOWER 技术飞跃加速市场产业化进程 根据AMPOWER,在过去的2021年,L-PBF激光选区金属熔化技术在一致性和控制零件质量合格性方面做了进一步的改进;Binder Jetting 粘结剂喷射金属3D打印技术在技术成熟度方面取得了重大飞跃,例如通过更多可用材料。 预计在未来 2 年内跃升至第一个工业用途;虽然在应用方面没有太大进展,但冷喷增材制造技术在2021年取得了强劲的技术进步;液态金属3D打印也有类似的发展,业界看到了比前一年更稳定的技术;借助金属光刻技术,在2021 年看到了首个工业端部件应用,这提高了该技术在工业化指数中的地位。 金属增材制造技术成熟指数 © AMPOWER /全面增长 2021 年的特点是恢复了超过 16% 的增长。其中零件增材制造服务呈指数级增长,3D打印系统设备供应商一直在努力应对供应链中断中进一步获得增长。随着这些积极的市场进步,金属和塑料3D打印供应商积极展望未来,并计划在 2026 年实现 200 亿欧元的市场规模。 AMPOWER的报告指出,增材制造市场在疫情爆发的第二年开始复苏,2021 年全球金属和塑料增材制造市场价值 83.3 亿欧元,同比增长超过 16%。 全球金属与塑料增材制造市场情况及预测 © AMPOWER 零件制造商的增材制造设施在 2020年疫情造成的停滞后大多恢复满负荷生产,供应商能够弥补他们失去的业务。尽管世界各地持续存在经济挑战,但目前这种", "date": "2022-03-18T13:03:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 1}}

