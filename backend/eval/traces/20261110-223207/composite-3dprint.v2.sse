ation": "航空航天3D打印占比最高的应用领域", "discovered_at": "2026-11-10T23:07:21.127334"}, {"source": "大族激光", "relation": "LPBF金属3D打印装备供应商", "discovered_at": "2026-11-10T23:07:30.337985"}, {"source": "大族激光", "relation": "与航空航天零部件增材制造相关", "discovered_at": "2026-11-10T23:07:30.337989"}, {"source": "中国商飞复合材料中心", "relation": "自动铺带/自动铺丝设备用户", "discovered_at": "2026-11-10T23:07:30.337999"}, {"source": "中国商飞复合材料中心", "relation": "C919复材平尾量产", "discovered_at": "2026-11-10T23:07:30.338002"}, {"source": "中国商飞复合材料中心", "relation": "CR929复材前机身筒段", "discovered_at": "2026-11-10T23:07:30.338006"}, {"source": "中国商飞复合材料中心", "relation": "热塑性复材与液体成型研究", "discovered_at": "2026-11-10T23:07:30.338010"}, {"source": "山东大学航空构件制造技术及装备研究中心", "relation": "大尺寸粉末床金属3D打印装备研发", "discovered_at": "2026-11-10T23:07:30.338018"}, {"source": "泰昂科技（tyontech）", "relation": "激光定向能量沉积（DED）送粉设备", "discovered_at": "2026-11-10T23:07:30.338027"}, {"source": "自动铺丝（AFP）", "relation": "与热固性/热塑性复材结构件成型相关", "discovered_at": "2026-11-10T23:07:30.338037"}, {"source": "自动铺丝（AFP）", "relation": "与战机减重和隐身相关", "discovered_at": "2026-11-10T23:07:30.338040"}, {"source": "自动铺带（ATL）", "relation": "与大型复材壁板/蒙皮制造相关", "discovered_at": "2026-11-10T23:07:30.338050"}, {"source": "激光粉末床熔融（LPBF）", "relation": "与钛合金/铝合金复杂结构件相关", "discovered_at": "2026-11-10T23:07:30.338060"}, {"source": "定向能量沉积（DED）", "relation": "与大型金属结构件修复与梯度材料相关", "discovered_at": "2026-11-10T23:07:30.338070"}, {"source": "液体成型/RTM", "relation": "与商飞复材中心工艺能力相关", "discovered_at": "2026-11-10T23:07:30.338081"}, {"source": "波音787", "relation": "复合材料用量50%的民机标杆", "discovered_at": "2026-11-10T23:07:30.338094"}, {"source": "空客A350", "relation": "复合材料用量52%的民机标杆", "discovered_at": "2026-11-10T23:07:30.338104"}, {"source": "C919", "relation": "复材平尾量产", "discovered_at": "2026-11-10T23:07:30.338114"}, {"source": "CR929", "relation": "复材前机身全尺寸筒段下线", "discovered_at": "2026-11-10T23:07:30.338124"}, {"source": "铂力特", "relation": "金属3D打印设备与零件", "discovered_at": "2026-11-10T23:07:34.651335"}, {"source": "铂力特", "relation": "航空航天市占率第一", "discovered_at": "2026-11-10T23:07:34.651339"}, {"source": "铂力特", "relation": "C919钛合金部件供应商", "discovered_at": "2026-11-10T23:07:34.651342"}, {"source": "铂力特", "relation": "军工背景", "discovered_at": "2026-11-10T23:07:34.651344"}, {"source": "铂力特", "relation": "与EOS/GE增材/SLM Solutions竞争", "discovered_at": "2026-11-10T23:07:34.651346"}, {"source": "华曙高科", "relation": "金属+高分子3D打印设备", "discovered_at": "2026-11-10T23:07:34.651353"}, {"source": "华曙高科", "relation": "设备价格优势", "discovered_at": "2026-11-10T23:07:34.651355"}, {"source": "华曙高科", "relation": "向材料环节延伸", "discovered_at": "2026-11-10T23:07:34.651357"}, {"source": "EOS GmbH", "relation": "金属/高分子工业3D打印领导者", "discovered_at": "2026-11-10T23:07:34.651362"}, {"source": "EOS GmbH", "relation": "航空航天设备供应商", "discovered_at": "2026-11-10T23:07:34.651364"}, {"source": "EOS GmbH", "relation": "铂力特海外竞争对手", "discovered_at": "2026-11-10T23:07:34.651368"}, {"source": "GE Aerospace / GE Additive", "relation": "金属增材制造设备", "discovered_at": "2026-11-10T23:07:34.651373"}, {"source": "GE Aerospace / GE Additive", "relation": "航空发动机零件", "discovered_at": "2026-11-10T23:07:34.651375"}, {"source": "GE Aerospace / GE Additive", "relation": "铂力特海外竞争对手", "discovered_at": "2026-11-10T23:07:34.651377"}, {"source": "Renishaw", "relation": "航空航天金属3D打印设备供应商", "discovered_at": "2026-11-10T23:07:34.651385"}, {"source": "SLM Solutions", "relation": "金属粉末床熔融设备", "discovered_at": "2026-11-10T23:07:34.651392"}, {"source": "SLM Solutions", "relation": "航空航天应用", "discovered_at": "2026-11-10T23:07:34.651395"}, {"source": "Stratasys", "relation": "航空航天3D打印设备（产品数最多）", "discovered_at": "2026-11-10T23:07:34.651400"}, {"source": "Stratasys", "relation": "高分子打印", "discovered_at": "2026-11-10T23:07:34.651403"}, {"source": "Arcam AB", "relation": "电子束熔融(EBM)设备", "discovered_at": "2026-11-10T23:07:34.651409"}, {"source": "Arcam AB", "relation": "航空航天钛合金零件", "discovered_at": "2026-11-10T23:07:34.651411"}, {"source": "中航高科", "relation": "航空复合材料预浸料", "discovered_at": "2026-11-10T23:07:34.651419"}, {"source": "中航高科", "relation": "军工产业链复合材料环节", "discovered_at": "2026-11-10T23:07:34.651423"}, {"source": "中简科技", "relation": "碳纤维", "discovered_at": "2026-11-10T23:07:34.651428"}, {"source": "中简科技", "relation": "军机复合材料", "discovered_at": "2026-11-10T23:07:34.651431"}, {"source": "光威复材", "relation": "碳纤维及复合材料", "discovered_at": "2026-11-10T23:07:34.651437"}, {"source": "中复神鹰", "relation": "碳纤维", "discovered_at": "2026-11-10T23:07:34.651444"}, {"source": "中航迈特", "relation": "航空级钛合金粉末国产化", "discovered_at": "2026-11-10T23:07:34.651450"}, {"source": "中航沈飞", "relation": "战斗机主机厂", "discovered_at": "2026-11-10T23:07:34.651458"}, {"source": "中航沈飞", "relation": "复合材料与增材制造下游客户", "discovered_at": "2026-11-10T23:07:34.651461"}, {"source": "中航西飞", "relation": "军民用飞机主机厂", "discovered_at": "2026-11-10T23:07:34.651468"}, {"source": "航发动力", "relation": "航空发动机主机厂", "discovered_at": "2026-11-10T23:07:34.651474"}, {"source": "航发动力", "relation": "增材制造零件潜在客户", "discovered_at": "2026-11-10T23:07:34.651477"}, {"source": "先临三维", "relation": "3D打印设备", "discovered_at": "2026-11-10T23:07:34.651483"}, {"source": "先临三维", "relation": "医疗与工业应用", "discovered_at": "2026-11-10T23:07:34.651487"}, {"source": "Wohlers Associates", "relation": "全球增材制造市场数据来源", "discovered_at": "2026-11-10T23:07:34.651493"}, {"source": "粉末床熔融(PBF/SLM)", "relation": "航空航天金属件主流工艺", "discovered_at": "2026-11-10T23:07:34.651499"}, {"source": "粉末床熔融(PBF/SLM)", "relation": "与DED/FDM并列", "discovered_at": "2026-11-10T23:07:34.651502"}, {"source": "定向能量沉积(DED)", "relation": "大型金属结构件修复与成形", "discovered_at": "2026-11-10T23:07:34.651508"}, {"source": "定向能量沉积(DED)", "relation": "航空航天目录中仅1项产品", "discovered_at": "2026-11-10T23:07:34.651511"}]}, "stats": {"entitiesCount": 42, "relationsCount": 71}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:07:34.651742", "content": {"agent": "DeepScout", "section": "竞争格局", "facts_count": 9, "duplicates_removed": 0, "data_points_count": 15, "insights": ["现有搜索结果几乎全部聚焦增材制造，复合材料（Hexcel、Toray、Syensqo、中航高科）仅有名单式提及，无任何市场份额、单机用量或认证数据，本章节“复合材料+3D打印”双主线中复合材料一侧证据严重不足。", "增材制造在航空航天领域已呈现明显的‘设备+材料+服务’垂直一体化趋势（铂力特、EOS、华曙高科），且客户高度集中于军工主机厂体系（前三家航空航天客户占铂力特营收53.76%），印证了‘少数具备军工资质与一体化能力企业主导格局’的判断。", "全球3D打印整体市场2020年规模127.58亿美元、增速降至7.5%，说明行业增长并非线性高速；军用航空作为高价值细分市场，其增速需单独数据支撑，不能直接用全行业数据外推。"], "source_quality": "整体来源质量偏低（加权可信度约0.5）。9条结果中无政府/军方/央企官方文件，无学术论文或一手券商深度报告原文；可信度最高的是前瞻产业研究院与新浪财经转载的铂力特研究报告（0.7），但其数据分别停留在2020年和2019年；AeroExpo为B2B目录站，可作供应商清单参考但统计口径不严谨；铂力特市占率、C919唯一供应商等关键结论均出自东方财富财富号、网易转中商情报网、今日头条等自媒体（0.3-0.45），存在夸大与二手转引风险。此外，全部结果对复合材料（Hexcel、Toray、Syensqo、中航高科）几乎无实质信息，与本章节“复合材料+增材制造”双主线严重不匹配，建议补充券商深度报告、上市公司年报/招股书、Wohlers原文及军工集团公开采购信息后再定稿。", "hypothesis_updates": 3, "search_results": [{"title": "全球3D打印设备行业企业竞争格局 - 前瞻产业研究院", "url": "https://x.qianzhan.com/xcharts/detail/ab350f42a256a795.html", "source": "首页_数据图表库_行业分析", "snippet": "整体来看,全球3D打印设备制造商目前正在积极布局3D打印材料相关产品,如EOS、铂力特、华曙高科等企业,兼顾3D打印整体行业的各大细分领域发展。未来,全球3D打印材料行业的竞争或将更加激烈。", "date": "2024-10-27T18:24:25+08:00"}, {"title": "推荐给朋友: 深度分析!十张图了解2021年全球3D打印行业市场规模与竞争格局 - OFweek3D打印网", "url": "https://3dprint.ofweek.com/recommendfriends-30515012.html", "source": "OFweek3D打印网", "snippet": "国内3D打印行业主要上市公司:铂力特(688333)、科力尔(002892)、有研新材(600206)、楚江新材(002171)、大族激光(002008)、杰普特(688025)、苏大维格(30033", "date": "2025-09-12T00:00:00+08:00"}, {"title": "航空航天业3D打印机产品信息、经销网络 - 航空产品制造商 - AeroExpo", "url": "https://www.aeroexpo.cn/zhizaoshang-aero/hang-kong-hang-tian-ye3d-da-yin-ji-2798.html", "source": "AirHub", "snippet": "19 个企业 | 103 个产品 产品筛选 用于航空航天业 全部删除 最新产品 品牌制造商 / 生产厂家 3D GENCE (5) A AddUp (6) Arcam AB (4) B BEAM - FIVES (3) BIGREP GMBH (3) Breton SpA - Advanced Technologies (1) E EOS GmbH Electro Optical Systems (13) Eplus3D (10) G GF MACHINING SOLUTIONS (3) GF Machining Solutions - Step Tec (3) H HAMUEL MASCHINENBAU GMBH & CO. KG (2) I INNSE-BERARDI SPA (5) M Markforged (9) O O2 Corporation (1) R Renishaw PLC (1) Roboze (3) S SLM SOLUTIONS GMBH (6) STRATASYS GMBH (18) U ULTIMAKER BV (7) 刷新 印制材料 金属 (69) 塑料 (43) 刷新 烹饪方式 粉末床融合 (47) FDM (46) 材料喷射 (5) DED (1) 刷新4) 刷新 平台入驻 & 任何时间、任何地点都可以与客户联系 平台入驻 {{/each}} {{/if}} - {{/if}} {{/if}} {{name}} : {{value}} {{#i!=(product.specData.length-1)}} 添加到产品对比表 移出产品对比表 {{/each}} {{/each}} {{/if}} - {{/if}} {{/if}} {{name}} : {{value}} {{#i!=(product.specData.length-1)}}", "date": "2024-12-14T05:52:22+08:00"}, {"title": "科创板新材料系列之四:铂力特__新浪财经_新浪网", "url": "http://vip.stock.finance.sina.com.cn/q/go.php/vReport_Show/kind/search/rptid/4564632/index.phtml", "source": "新浪财经", "snippet": "前五名客户销售金额占总营收的比重为68.35%,其中前三家航空航天领域客户销售占比达到53.76%。 对标公司估值:在金属3D打印领域,公司海外的主要竞争对手包括德国EOS公司、美国GE增材制造、德国SLM solutions等。德国EOS是金属和高分子材料工业3D打印的领导者,国内主要是新三板上市公司杭州先临三维科技股份有限公司。在非金属3D打印领域,美国Stratasys和3D", "date": "2019-04-23T20:30:58+08:00"}, {"title": "深度分析!十张图了解2021年全球3D打印行业市场规模与竞争格局 中美合计占一半_工业机器人-机器人在线", "url": "https://www.imrobotic.com/news/detail/28674.html", "source": "机器人在线", "snippet": "国内3D打印行业主要上市公司:铂力特(688333)、科力尔(002892)、有研新材(600206)、楚江新材(002171)、大族激光(002008)、杰普特(688025)、苏大维格(300331)、银邦股份(300337)、机器人(300024)、金运激光(300220)、有研粉材(688456)、国瓷材料(300285)、光韵达(300227)、中钢国际(000928)、华工科技(000988)、蓝光发展(600466)、海原复材(002529)等本文核心数据:3D打印产业规模、3D打印设备销售额、3D打印机销量、3D打印服务销售额、3D打印材料销售额、全球各国3D打印产业规模、全球主要3D打印企业出货量占比等1、市场规模:全球市场规模超120亿美元Wohlers\nAssociates是权威的全球3D产业研究机构,通过总结全球261家服务提供商、系统制造商和材料生产商的数据,《Wohlers\nReport\n2021》指出,2020年全球3D打印市场规模达到127.58亿美元,相比2019年增长7.5%,低于此前21.2%的增长率。主要是因为2020年全球范围内众多公司受到疫情影响,裁员、削减支出更是普遍,其中以业内最大的两家公司Stratasys和3D\nSystems最为典型。2020年,两家公司在整个行业所占比重为8.5%,而2019和2018年分别是10.7%和13.8%,呈现逐年下降的趋势,这也意味着,业内其他设备制造商正在崛起。2、全球3D打印细分市场:服务成3D打印行业主要推动力\n设备市场需求较稳定——3D打印产业结构:3D打印设备及服务占据主要市场据《Wohlers\nReport\n2021》数据,2020年,全球3D打印产业结构中,来自3D打印服务的收入约74.54亿美元,占比达59.29%,同比增长了20.3%;全球3D打印设备实现销售额30.14亿", "date": "2021-08-05T00:00:00+08:00"}, {"title": "3D打印哪家强?_财富号_东方财富网", "url": "https://caifuhao.eastmoney.com/news/20231120155913968426030", "source": "财富号", "snippet": "纵观国内3D打印主要上市厂商,铂力特、华曙高科和先临三维最有实力。 铂力特的业务主要包括3D打印设备、定制化产品和金属粉末原材料,优势领域在航空航天,2022年相关业务营收达6.38亿,占比近70%,并在该领域市占率第一,有自己的基本盘。 严格来说铂力特是军工企业,在其披露招股书中", "date": "2023-11-20T15:59:00+08:00"}, {"title": "国防军工:主机厂:中航沈飞、中航西飞、航发动力、内蒙一机、中国船舶、中船防务;航空锻件:中航重机、三角防务、派克新材、航宇科技;航空航天3...", "url": "https://www.toutiao.com/w/1813698650138762/", "source": "今日头条", "snippet": "国防军工: 主机厂:中航沈飞、中航西飞、航发动力、内蒙一机、中国船舶、中船防务; 航空锻件:中航重机、三角防务、派克新材、航宇科技; 航空航天3D打印:铂力特; 飞机零部件加工:广联航空、爱乐达; 金属材料:抚顺特钢、钢研高纳、图南股份、隆达股份、西部超导、宝钛股份、西部材料; 复合材料:中简科技、中复神鹰、中航高科、光威复材; 军工电子:国博电子、雷电微力、臻镭科技、铖昌科技。", "date": "2024-10-23T18:03:00+08:00"}, {"title": "2025年中国3D打印行业最具发展潜力企业排名", "url": "https://m.163.com/dy/article/JQUOL21705198SOQ.html", "source": "网易", "snippet": "中商情报网讯:中国3D打印行业处于高速发展期,核心潜力企业通过技术差异化与场景深耕构建竞争壁垒。 金属3D打印 领域,铂力特(国产大飞机C919钛合金部件唯一供应商)、华曙高科(新能源车轻量化解决方案)、中航迈特(航空级钛合金粉末国产化)凭借军工/航空航天背景和技术垄断地位,主导高端市场; 非金属3D打印 方面,光韵达(华为Mate60折叠屏核心供应商)、惠普(本土化成本优势)、创想三维(消费级市场龙头)通过材料创新与供应链绑定抢占民用市场。\n2025年中国3D打印行业最具发展潜力企业排名\n排名\n企业名称\n主要产品\n潜力亮点\n竞争优势\n应用领域\n1\n铂力特\n金属3D打印机(SLM)、航空发动机叶片\n国内C919钛合金部件唯一认证企业,航空航天市占率超70%\n军工背景技术积累,全产业链布局(设备+材料+服务)\n航空航天、国防军工\n2\n华曙高科\n金属/树脂3D打印机、多材料混合系统\n全球首个“金属+光固化”双技术量产化,宁德时代/蔚来合作订单年增200%\n自研陶瓷基复合材料,设备性价比为欧美的60%-70%\n新能源汽车、消费电子\n3\n先临三维\n医用3D打印机、骨科/牙科植入物\n国内唯一通过FDA认证的金属骨科植入物企业,AI手术平台提升成功率40%\n全产业链覆盖,与三甲医院共建临床应用中心\n医疗健康、教育科研\n4\n光韵达\nSLS设备、消费电子结构件\n华为Mate60折叠屏铰链核心供应商,AR/VR设备光学模组良率达99.3%\n“材料+工艺+设备”一体化模式,毛利率超50%(行业平均35%)\n消费电子、工业模具\n5\n银禧科技\n高性能工程塑料、汽车轻量化部件\n碳纤维增强PLA材料成本较进口低30%,特斯拉ModelY保险杠供应商\n年产3万吨医用级生物相容性材料,注塑+3D打印一体化生产\n新能源汽车、5G通信\n6\n中航迈特\n钛合金/高温合金粉末、发动机叶片\nC919机身紧固件100%", "date": "2025-03-19T00:00:05+08:00"}, {"title": "深度分析!十张图了解2021年全球3D打印行业市场规模与竞争格局 中美合计占一半_行业研究报告 - 前瞻网", "url": "https://www.qianzhan.com/analyst/detail/220/210803-a051fdc9.html", "source": "前瞻网", "snippet": "国内3D打印行业主要上市公司: 铂力特(688333)、科力尔(002892)、有研新材(600206)、楚江新材(002171)、大族激光(002008)、杰普特(688025)、苏大维格(300331)、银邦股份(300337)、机器人(300024)、金运激光(300220)、有研粉材(688456)、国瓷材料(300285)、光韵达(300227)、中钢国际(000928)、华工科技(000988)、蓝光发展(600466)、海原复材(002529)等 本文核心数据: 3D打印产业规模、3D打印设备销售额、3D打印机销量、3D打印服务销售额、3D打印材料销售额、全球各国3D打印产业规模、全球主要3D打印企业出货量占比等 1、市场规模:全球市场规模超120亿美元 Wohlers Associates是权威的全球3D产业研究机构,通过总结全球261家服务提供商、系统制造商和材料生产商的数据,《Wohlers Report 2021》指出,2020年全球3D打印市场规模达到127.58亿美元,相比2019年增长7.5%,低于此前21.2%的增长率。 主要是因为2020年全球范围内众多公司受到疫情影响,裁员、削减支出更是普遍,其中以业内最大的两家公司Stratasys和3D Systems最为典型。2020年,两家公司在整个行业所占比重为8.5%,而2019和2018年分别是10.7%和13.8%,呈现逐年下降的趋势,这也意味着,业内其他设备制造商正在崛起。 2、全球3D打印细分市场:服务成3D打印行业主要推动力 设备市场需求较稳定 ——3D打印产业结构:3D打印设备及服务占据主要市场 据《Wohlers Report 2021》数据,2020年,全球3D打印产业结构中,来自3D打印服务的收入约74.54亿美元,占比达59.29%,同比增长了20.3%;全球3D打印设备实现", "date": "2021-08-03T12:00:41+08:00"}], "extracted_facts": [{"content": "据Wohlers Report 2021，2020年全球3D打印市场规模为127.58亿美元，同比增长7.5%，低于2019年21.2%的增速；行业集中度下降，Stratasys与3D Systems两家合计份额由2018年的13%以上降至2019年10.7%、2020年8.5%。", "source_name": "机器人在线（转引Wohlers Report 2021）", "source_url": "https://www.imrobotic.com/news/detail/28674.html", "credibility": 0.6}, {"content": "前瞻网/前瞻产业研究院同样引用Wohlers Report 2021数据，确认2020年全球3D打印市场规模127.58亿美元、增速7.5%，并指出疫情导致企业裁员与削减支出是增速下滑主因。", "source_name": "前瞻网", "source_url": "https://www.qianzhan.com/analyst/detail/220/210803-a051fdc9.html", "credibility": 0.7}, {"content": "铂力特招股书披露，其前五名客户销售金额占总营收比重为68.35%，其中前三家航空航天领域客户销售占比达53.76%，显示航空航天客户高度集中；海外主要竞争对手为德国EOS、美国GE增材制造、德国SLM Solutions。", "source_name": "新浪财经（科创板新材料系列之四：铂力特）", "source_url": "http://vip.stock.finance.sina.com.cn/q/go.php/vReport_Show/kind/search/rptid/4564632/index.phtml", "credibility": 0.7}, {"content": "铂力特2022年航空航天相关业务营收6.38亿元，占其总营收近70%，在航空航天金属3D打印领域市占率第一；公司被描述为具有军工企业属性，业务覆盖设备、定制化产品与金属粉末原材料。", "source_name": "东方财富财富号", "source_url": "https://caifuhao.eastmoney.com/news/20231120155913968426030", "credibility": 0.4}, {"content": "中商情报网2025年中国3D打印潜力企业排名称，铂力特为国产大飞机C919钛合金部件唯一认证供应商，航空航天市占率超70%，具备军工背景与设备+材料+服务全产业链布局；华曙高科实现“金属+光固化”双技术量产，设备价格为欧美的60%-70%；中航迈特主攻航空级钛合金粉末国产化。", "source_name": "网易（转引中商情报网）", "source_url": "https://m.163.com/dy/article/JQUOL21705198SOQ.html", "credibility": 0.45}, {"content": "AeroExpo航空航天3D打印设备目录显示，面向航空航天领域的3D打印设备供应商共19家、产品103个，主要品牌包括Stratasys(18)、EOS(13)、Eplus3D(10)、Markforged(9)、SLM Solutions(6)、AddUp(6)、Arcam(4)、Roboze(3)、Renishaw(1)；材料以金属(69)和塑料(43)为主，工艺以粉末床熔融(47)和FDM(46)为主，DED仅1项。", "source_name": "AeroExpo（航空产品制造商目录）", "source_url": "https://www.aeroexpo.cn/zhizaoshang-aero/hang-kong-hang-tian-ye3d-da-yin-ji-2798.html", "credibility": 0.65}, {"content": "前瞻产业研究院指出，全球3D打印设备制造商正积极向3D打印材料环节延伸布局，EOS、铂力特、华曙高科等企业同时覆盖设备与材料，未来材料环节竞争将更激烈。", "source_name": "前瞻产业研究院", "source_url": "https://x.qianzhan.com/xcharts/detail/ab350f42a256a795.html", "credibility": 0.7}, {"content": "行业梳理将中国军工产业链划分为：主机厂（中航沈飞、中航西飞、航发动力、内蒙一机、中国船舶、中船防务）、航空锻件（中航重机、三角防务、派克新材、航宇科技）、航空航天3D打印（铂力特）、复合材料（中简科技、中复神鹰、中航高科、光威复材）等环节。", "source_name": "今日头条自媒体", "source_url": "https://www.toutiao.com/w/1813698650138762/", "credibility": 0.3}], "data_points": [{"name": "全球3D打印市场规模", "value": "127.58", "unit": "亿美元", "year": 2020, "source": "机器人在线（转引Wohlers Report 2021）"}, {"name": "全球3D打印市场同比增速", "value": "7.5", "unit": "%", "year": 2020, "source": "机器人在线（转引Wohlers Report 2021）"}, {"name": "Stratasys+3D Systems合计份额", "value": "8.5", "unit": "%", "year": 2020, "source": "机器人在线（转引Wohlers Report 2021）"}, {"name": "全球3D打印市场规模", "value": "127.58", "unit": "亿美元", "year": 2020, "source": "前瞻网"}, {"name": "全球3D打印市场同比增速", "value": "7.5", "unit": "%", "year": 2020, "source": "前瞻网"}, {"name": "前五大客户营收占比", "value": "68.35", "unit": "%", "year": 2019, "source": "新浪财经（科创板新材料系列之四：铂力特）"}, {"name": "前三家航空航天客户营收占比", "value": "53.76", "unit": "%", "year": 2019, "source": "新浪财经（科创板新材料系列之四：铂力特）"}, {"name": "铂力特航空航天业务营收", "value": "6.38", "unit": "亿元", "year": 2022, "source": "东方财富财富号"}, {"name": "航空航天业务营收占比", "value": "70", "unit": "%", "year": 2022, "source": "东方财富财富号"}, {"name": "铂力特航空航天市占率", "value": ">70", "unit": "%", "year": 2025, "source": "网易（转引中商情报网）"}]}}

