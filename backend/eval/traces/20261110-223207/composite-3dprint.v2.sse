data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:23:10.314937", "content": {"results": [{"id": "fact_8f01e9e7", "title": "预计2023-2025年全球增材制造市场增长率为23.7%，2025-2026年增长率为20.4%；2020-2026年3D打印市场规模预计增加近三倍。", "source": "云掌财经", "url": "", "snippet": "预计2023-2025年全球增材制造市场增长率为23.7%，2025-2026年增长率为20.4%；2020-2026年3D打印市场规模预计增加近三倍。", "date": "", "isSupplementary": true}, {"id": "fact_dbb8d5da", "title": "金属增材制造在军工新材料领域空间巨大。", "source": "中研网", "url": "https://www.chinairn.com/scfx/20240125/160428962.shtml", "snippet": "金属增材制造在军工新材料领域空间巨大。", "date": "", "isSupplementary": true}, {"id": "fact_3443f8ae", "title": "研究提出了一种结构拓扑与连续纤维取向顺序耦合优化方法，用于连续碳纤维增强聚合物复合材料的3D打印：先针对特定载荷工况进行拓扑优化以获得结构几何，再布置连续纤维。", "source": "Composite Structures (X-MOL)", "url": "", "snippet": "研究提出了一种结构拓扑与连续纤维取向顺序耦合优化方法，用于连续碳纤维增强聚合物复合材料的3D打印：先针对特定载荷工况进行拓扑优化以获得结构几何，再布置连续纤维。", "date": "", "isSupplementary": true}, {"id": "fact_f287e382", "title": "西安交通大学研究团队开展了连续碳纤维增强复合材料多尺度点阵结构的拓扑优化与3D打印研究，指出连续碳纤维3D打印可制造由纤维轨迹定义宏观和细观结构的多尺度点阵结构...", "source": "西安交通大学", "url": "", "snippet": "西安交通大学研究团队开展了连续碳纤维增强复合材料多尺度点阵结构的拓扑优化与3D打印研究，指出连续碳纤维3D打印可制造由纤维轨迹定义宏观和细观结构的多尺度点阵结构。", "date": "", "isSupplementary": true}, {"id": "fact_4e9ca5c5", "title": "研究建立了拓扑优化连续碳纤维增强复合材料机翼翼梁的设计与制造框架，目标是实现高性能复杂纤维增强复合材料零件的高效制造，并兼顾高制造可行性。", "source": "西安交通大学", "url": "", "snippet": "研究建立了拓扑优化连续碳纤维增强复合材料机翼翼梁的设计与制造框架，目标是实现高性能复杂纤维增强复合材料零件的高效制造，并兼顾高制造可行性。", "date": "", "isSupplementary": true}, {"id": "fact_972b2152", "title": "研究提出正交单元SOMP拓扑优化方法，将连续碳纤维增强复合材料的3D打印制造可行性纳入优化，并结合打印路径规划策略；采用剪切梁和弯曲梁验证方法有效性，并与传统密...", "source": "ScienceDirect", "url": "", "snippet": "研究提出正交单元SOMP拓扑优化方法，将连续碳纤维增强复合材料的3D打印制造可行性纳入优化，并结合打印路径规划策略；采用剪切梁和弯曲梁验证方法有效性，并与传统密度法SOMP拓扑优化结果进行比较。", "date": "", "isSupplementary": true}, {"id": "fact_6794227a", "title": "研究提出面向连续纤维增强聚合物增材制造的分层纤维取向优化方法，采用多材料拓扑优化以尽可能减轻构件重量，满足轻量化需求。", "source": "ScienceDirect", "url": "", "snippet": "研究提出面向连续纤维增强聚合物增材制造的分层纤维取向优化方法，采用多材料拓扑优化以尽可能减轻构件重量，满足轻量化需求。", "date": "", "isSupplementary": true}, {"id": "fact_5d5c312f", "title": "研究关注3D打印纤维复合材料拓扑优化中的几何复杂度控制，以提升性能，并指出制造可行性一直是拓扑优化长期存在的问题。", "source": "Europe PMC / Materials", "url": "", "snippet": "研究关注3D打印纤维复合材料拓扑优化中的几何复杂度控制，以提升性能，并指出制造可行性一直是拓扑优化长期存在的问题。", "date": "", "isSupplementary": true}, {"id": "fact_69a51d69", "title": "研究涉及采用感应加热制造3D打印连续碳纤维复合材料网格加筋结构；指出航空航天应用中复合材料网格广泛用于增强大型薄壳构件强度，连续纤维增强热塑性复合材料3D打印相...", "source": "ResearchGate", "url": "", "snippet": "研究涉及采用感应加热制造3D打印连续碳纤维复合材料网格加筋结构；指出航空航天应用中复合材料网格广泛用于增强大型薄壳构件强度，连续纤维增强热塑性复合材料3D打印相比传统模压工艺具有工艺更简单等优势。", "date": "", "isSupplementary": true}, {"id": "fact_39868bc5", "title": "综述文章系统探讨了纤维增强复合材料3D打印在航空航天、汽车、医疗和消费品等行业的精密制造应用。", "source": "Heliyon / Europe PMC", "url": "", "snippet": "综述文章系统探讨了纤维增强复合材料3D打印在航空航天、汽车、医疗和消费品等行业的精密制造应用。", "date": "", "isSupplementary": true}, {"id": "fact_d539608c", "title": "华曙高科设备收入占比接近80%，研报指出设备单价与销量双升，反映高端制造国产替代逻辑正在兑现；公司正从“卖设备”向“解决方案提供商”转型，金属SLM与高分子SL...", "source": "中财网股票频道（CFi.CN）", "url": "", "snippet": "华曙高科设备收入占比接近80%，研报指出设备单价与销量双升，反映高端制造国产替代逻辑正在兑现；公司正从“卖设备”向“解决方案提供商”转型，金属SLM与高分子SLS双线并进，形成40余款设备+40余种专用材料的生态壁垒。", "date": "", "isSupplementary": true}, {"id": "fact_6a6ab8cf", "title": "2026年前三季度华曙高科营收5.10亿元，同比增长28.11%；扣非归母净利润1322.93万元，大增120.15%；Q3单季毛利率47.90%，同比提升8....", "source": "中财网股票频道（CFi.CN）", "url": "", "snippet": "2026年前三季度华曙高科营收5.10亿元，同比增长28.11%；扣非归母净利润1322.93万元，大增120.15%；Q3单季毛利率47.90%，同比提升8.99个百分点；设备销量同比增长41.25%，海外收入同比激增81.38%，高毛利境外业务占比升至22.89%。", "date": "", "isSupplementary": true}, {"id": "fact_1f45a583", "title": "按地区划分的收入结构显示，华曙高科外销收入占比21.40%、毛利率60.67%，内销收入占比78.60%、毛利率46.60%，外销毛利率显著高于内销约14个百分...", "source": "搜狐证券-华曙高科(688433)主营收入构成", "url": "", "snippet": "按地区划分的收入结构显示，华曙高科外销收入占比21.40%、毛利率60.67%，内销收入占比78.60%、毛利率46.60%，外销毛利率显著高于内销约14个百分点，可作为海外（含欧美）市场定价溢价的间接证据。", "date": "", "isSupplementary": true}, {"id": "fact_bdc5e7ef", "title": "按行业划分，华曙高科航空航天领域收入占比高达61.40%（3.72亿元），毛利率52.43%，是其第一大下游应用领域，印证航空航天为该公司核心收入来源。", "source": "搜狐证券-华曙高科(688433)主营收入构成", "url": "", "snippet": "按行业划分，华曙高科航空航天领域收入占比高达61.40%（3.72亿元），毛利率52.43%，是其第一大下游应用领域，印证航空航天为该公司核心收入来源。", "date": "", "isSupplementary": true}, {"id": "fact_35d7d5ce", "title": "按产品划分，3D打印设备及辅机配件收入占比81.17%（1.84亿元）、毛利率47.32%；3D打印粉末材料占比7.93%、毛利率51.09%；售后服务及其他占...", "source": "搜狐证券-华曙高科(688433)主营收入构成", "url": "", "snippet": "按产品划分，3D打印设备及辅机配件收入占比81.17%（1.84亿元）、毛利率47.32%；3D打印粉末材料占比7.93%、毛利率51.09%；售后服务及其他占比10.68%、毛利率65.27%，服务类业务毛利率最高。", "date": "", "isSupplementary": true}, {"id": "fact_42c327c2", "title": "截至上半年末，华曙高科在手设备订单6.22亿元，存货较年初增长42.2%，反映产能与交付节奏加快；FS1521M等新型号已获客户验证并落地订单。", "source": "中国财经信息网（CFi.CN）", "url": "", "snippet": "截至上半年末，华曙高科在手设备订单6.22亿元，存货较年初增长42.2%，反映产能与交付节奏加快；FS1521M等新型号已获客户验证并落地订单。", "date": "", "isSupplementary": true}, {"id": "fact_135537ad", "title": "华曙高科拟募资17.54亿元建设增材制造综合服务平台及全球运营中心，重点切入消费电子、具身智能等高景气赛道，并在德国、捷克等地加速海外布局，海外产能前置可缩短交...", "source": "中国财经信息网（CFi.CN）", "url": "", "snippet": "华曙高科拟募资17.54亿元建设增材制造综合服务平台及全球运营中心，重点切入消费电子、具身智能等高景气赛道，并在德国、捷克等地加速海外布局，海外产能前置可缩短交付周期、增强本地响应能力。", "date": "", "isSupplementary": true}, {"id": "fact_e222a349", "title": "华曙高科在全球的累计销量已突破800台，拥有发明专利148项、实用新型专利141项、外观专利34项、软件著作权35项；产品广泛应用于航空航天、精准医疗、汽车产业...", "source": "财经头条/金融界、网易", "url": "", "snippet": "华曙高科在全球的累计销量已突破800台，拥有发明专利148项、实用新型专利141项、外观专利34项、软件著作权35项；产品广泛应用于航空航天、精准医疗、汽车产业、精密机械、模具及教育科研等领域。", "date": "", "isSupplementary": true}, {"id": "fact_b8343b96", "title": "2026年上半年华曙高科实现营业收入3.41亿元，同比增长42.27%；归母净利润843.48万元，同比增长87.09%；扣非净利润366.45万元，同比增长1...", "source": "智通财经网", "url": "", "snippet": "2026年上半年华曙高科实现营业收入3.41亿元，同比增长42.27%；归母净利润843.48万元，同比增长87.09%；扣非净利润366.45万元，同比增长115.78%，业绩增长主要系3D打印设备销售增加。", "date": "", "isSupplementary": true}, {"id": "fact_fdc1f6de", "title": "2024年前三季度华曙高科营业收入3.45亿元，同比减少7.09%；归属净利润4379.88万元，同比减少39.85%，显示公司业绩存在明显周期性波动，2024...", "source": "财经头条/金融界", "url": "", "snippet": "2024年前三季度华曙高科营业收入3.45亿元，同比减少7.09%；归属净利润4379.88万元，同比减少39.85%，显示公司业绩存在明显周期性波动，2024年曾出现阶段性下滑。", "date": "", "isSupplementary": true}]}}

