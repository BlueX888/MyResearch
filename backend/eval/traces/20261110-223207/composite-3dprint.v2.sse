data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:16:25.166345", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'年份': [2024, 2025, 2035], '市场规模': [24, 28.8, 178.3]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = df['年份']\ny = df['市场规模']\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='全球航空航天3D打印市场规模')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(x[i], v + 3, f'{v}亿美元', ha='center', fontsize=11, fontweight='bold')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿美元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.annotate('2025-2035年CAGR: 20.0%', xy=(2030, 120), fontsize=12, color='#ef4444', ha='center')\nplt.legend(fontsize=12)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

