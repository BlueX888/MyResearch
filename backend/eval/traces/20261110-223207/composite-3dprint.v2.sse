data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:16:17.028410", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'year_aero': [2024, 2025, 2035], 'value_aero': [24, 28.8, 178.3], 'year_mil': [2019, 2026], 'value_mil': [42, 177]}\nfig, ax1 = plt.subplots(figsize=(12, 7), dpi=200)\nax2 = ax1.twinx()\nax1.plot(data['year_aero'], data['value_aero'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='全球航空航天3D打印市场规模（亿美元）')\nax1.fill_between(data['year_aero'], data['value_aero'], alpha=0.15, color='#6366f1')\nax2.plot(data['year_mil'], data['value_mil'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='全球军用3D打印市场总值（亿元）')\nfor x, y in zip(data['year_aero'], data['value_aero']):\n    ax1.text(x, y + 3, f'{y}', ha='center', fontsize=11, color='#6366f1')\nfor x, y in zip(data['year_mil'], data['value_mil']):\n    ax2.text(x, y + 5, f'{y}', ha='center', fontsize=11, color='#f59e0b')\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('航空航天3D打印市场规模（亿美元）', fontsize=14, color='#6366f1')\nax2.set_ylabel('军用3D打印市场总值（亿元）', fontsize=14, color='#f59e0b')\nax1.tick_params(axis='x', labelsize=12)\nax1.tick_params(axis='y', labelsize=12, colors='#6366f1')\nax2.tick_params(axis='y', labelsize=12, colors='#f59e0b')\nax1.set_xlim(2018, 2036)\nax1.grid(True, linestyle='--', alpha=0.3)\nax1.set_title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=11)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

