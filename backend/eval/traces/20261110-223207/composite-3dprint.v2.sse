65"}, {"id": "node_17", "name": "液体成型/RTM", "type": "technology", "discovered_at": "2026-11-10T23:07:30.338077"}, {"id": "node_18", "name": "波音787", "type": "technology", "discovered_at": "2026-11-10T23:07:30.338087"}, {"id": "node_19", "name": "空客A350", "type": "technology", "discovered_at": "2026-11-10T23:07:30.338099"}, {"id": "node_20", "name": "C919", "type": "technology", "discovered_at": "2026-11-10T23:07:30.338109"}, {"id": "node_21", "name": "CR929", "type": "technology", "discovered_at": "2026-11-10T23:07:30.338120"}], "edges": [{"source": "Market Research Future (MRFR)", "relation": "航空航天3D打印市场规模预测数据源", "discovered_at": "2026-11-10T23:07:21.127273"}, {"source": "Market Research Future (MRFR)", "relation": "被腾讯新闻引用", "discovered_at": "2026-11-10T23:07:21.127276"}, {"source": "QYResearch", "relation": "航空航天3D打印材料结构89.09%数据源", "discovered_at": "2026-11-10T23:07:21.127282"}, {"source": "QYResearch", "relation": "被小牛行研、三个皮匠报告引用", "discovered_at": "2026-11-10T23:07:21.127284"}, {"source": "华经产业研究院", "relation": "中国军机复合材料用量占比数据源", "discovered_at": "2026-11-10T23:07:21.127289"}, {"source": "华经产业研究院", "relation": "航空复材零部件行业报告发布方", "discovered_at": "2026-11-10T23:07:21.127291"}, {"source": "报告大厅", "relation": "军用3D打印市场报告发布方", "discovered_at": "2026-11-10T23:07:21.127298"}, {"source": "金属增材制造（钛合金/镍基超合金/铝合金粉末）", "relation": "占航空航天3D打印89.09%份额", "discovered_at": "2026-11-10T23:07:21.127305"}, {"source": "金属增材制造（钛合金/镍基超合金/铝合金粉末）", "relation": "应用于航空发动机与承力结构件", "discovered_at": "2026-11-10T23:07:21.127307"}, {"source": "聚合物基与陶瓷基3D打印", "relation": "应用于客舱内饰、非承力件与高温环境部件", "discovered_at": "2026-11-10T23:07:21.127314"}, {"source": "复合材料自动铺放（ATL/AFP）", "relation": "h_2假设中的主流工艺路线，本次搜索未获得证据", "discovered_at": "2026-11-10T23:07:21.127321"}, {"source": "热塑性复合材料", "relation": "h_2假设中的技术路线，本次搜索未获得证据", "discovered_at": "2026-11-10T23:07:21.127327"}, {"source": "航空发动机部件3D打印", "relation": "航空航天3D打印占比最高的应用领域", "discovered_at": "2026-11-10T23:07:21.127334"}, {"source": "大族激光", "relation": "LPBF金属3D打印装备供应商", "discovered_at": "2026-11-10T23:07:30.337985"}, {"source": "大族激光", "relation": "与航空航天零部件增材制造相关", "discovered_at": "2026-11-10T23:07:30.337989"}, {"source": "中国商飞复合材料中心", "relation": "自动铺带/自动铺丝设备用户", "discovered_at": "2026-11-10T23:07:30.337999"}, {"source": "中国商飞复合材料中心", "relation": "C919复材平尾量产", "discovered_at": "2026-11-10T23:07:30.338002"}, {"source": "中国商飞复合材料中心", "relation": "CR929复材前机身筒段", "discovered_at": "2026-11-10T23:07:30.338006"}, {"source": "中国商飞复合材料中心", "relation": "热塑性复材与液体成型研究", "discovered_at": "2026-11-10T23:07:30.338010"}, {"source": "山东大学航空构件制造技术及装备研究中心", "relation": "大尺寸粉末床金属3D打印装备研发", "discovered_at": "2026-11-10T23:07:30.338018"}, {"source": "泰昂科技（tyontech）", "relation": "激光定向能量沉积（DED）送粉设备", "discovered_at": "2026-11-10T23:07:30.338027"}, {"source": "自动铺丝（AFP）", "relation": "与热固性/热塑性复材结构件成型相关", "discovered_at": "2026-11-10T23:07:30.338037"}, {"source": "自动铺丝（AFP）", "relation": "与战机减重和隐身相关", "discovered_at": "2026-11-10T23:07:30.338040"}, {"source": "自动铺带（ATL）", "relation": "与大型复材壁板/蒙皮制造相关", "discovered_at": "2026-11-10T23:07:30.338050"}, {"source": "激光粉末床熔融（LPBF）", "relation": "与钛合金/铝合金复杂结构件相关", "discovered_at": "2026-11-10T23:07:30.338060"}, {"source": "定向能量沉积（DED）", "relation": "与大型金属结构件修复与梯度材料相关", "discovered_at": "2026-11-10T23:07:30.338070"}, {"source": "液体成型/RTM", "relation": "与商飞复材中心工艺能力相关", "discovered_at": "2026-11-10T23:07:30.338081"}, {"source": "波音787", "relation": "复合材料用量50%的民机标杆", "discovered_at": "2026-11-10T23:07:30.338094"}, {"source": "空客A350", "relation": "复合材料用量52%的民机标杆", "discovered_at": "2026-11-10T23:07:30.338104"}, {"source": "C919", "relation": "复材平尾量产", "discovered_at": "2026-11-10T23:07:30.338114"}, {"source": "CR929", "relation": "复材前机身全尺寸筒段下线", "discovered_at": "2026-11-10T23:07:30.338124"}]}, "stats": {"entitiesCount": 22, "relationsCount": 31}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:07:30.338460", "content": {"agent": "DeepScout", "section": "技术趋势", "facts_count": 9, "duplicates_removed": 0, "data_points_count": 6, "insights": ["本轮搜索结果与“新一代战机”这一核心对象严重脱节：9条结果中0条直接涉及F-35、歼-20、NGAD、GCAP、FCAS等型号，多数为通用设备介绍、教学页面或文档分享平台内容，证据链无法支撑章节核心命题。", "可用的量化数据仅有一条（军机复材结构重量占比25%~50%，民机787为50%、A350为52%），且来自文档分享平台，属二手转述，需回溯至原始统计机构（如行业白皮书、厂商官方数据）。", "工艺能力侧证据相对充分：AFP/ATL、LPBF大尺寸成形（1000×600×500mm）、DED梯度材料、热塑性预浸带铺放专利均已出现，说明“技术可用”成立，但“战机型号已批量应用”未被证明。"], "source_quality": "整体质量偏低（加权可信度约0.45）。9条结果中：学术来源1条（山东大学，0.8，但为2019年设备介绍）、高校教学页面1条（0.75，内容与主题无关，属噪声）、专利/技术市场1条（0.55）、行业新闻1条（0.5）、企业产品页与自媒体/股吧/文档分享平台共5条（0.35~0.4）。主要问题：①无任何政府、军方、央企官方文件或权威咨询机构报告；②无一条直接涉及新一代战机型号；③关键量化数据（25%~50%、50%、52%）均来自文档分享平台的二手转述，缺乏原始出处与统计口径；④部分来源时效性差（2019、2021年）。结论：本轮结果仅可作为“技术能力存在性”的弱证据，不足以支撑研究假设的验证，必须补充官方采购公告、军工集团年报、权威咨询报告（如Teal Group、MarketsandMarkets、中国航空工业集团公开资料）与学术论文。", "hypothesis_updates": 3, "search_results": [{"title": "装备/材料", "url": "http://www.tyontech.com/product/detail/id/143.html", "source": "www.tyontech.com", "snippet": "激光定向能量沉积金属增材制造设备,是研究院与国内外专家共同研发的送粉式金属3D打印机(简称金属3D打印机)。该金属3D打印机具有性价比高、易成形、自主设计、操作简单、可嫁接式3D打印、以及金属零件增材再制造与表面强化等多种功能,可用于产品研发、材料性能测试、3D打印工艺研究等。 技术特点 1.打印材料范围广,成本低;兼容普通激光熔覆粉末及3D打印专用粉末。 2.多金属打印功能,制造梯度合金材料;", "date": "2025-02-21T12:44:39+08:00"}, {"title": "大族激光铺粉式3D打印装备,万物皆可造! - 维科号", "url": "https://mp.ofweek.com/3dprint/a156714183287", "source": "维科号", "snippet": "可打印不锈钢、模具钢、钛合金、铝合金等材料 成形精度高,尺寸精度可达为±0.1mm 可成形结构复杂、壁厚小于0.1mm的薄壁零件 医疗、汽车、模具、航空航天等行业应用广泛", "date": "2021-11-11T15:57:00+08:00"}, {"title": "如何让复合材料制造生产更高效?_化工仪器网", "url": "https://www.chem17.com/tech_news/detail/2764478.html", "source": "化工仪器网", "snippet": "复合材料具有高比强度、高比模量、良好抗疲劳性、抗腐蚀性和隐身性能,一系列优点使其成为减轻航宇飞行器重量、提高性能的理想结构用材,在飞机设计制造领域得到广泛应用。为在提高生产率的同时控制材料浪费情况,并保证产品质量,自动铺丝机(AFP)被投入应用。 自动铺丝机的铺丝头一般包括纤维束牵丝分配辅助装置、送进、夹紧、剪切、重送、加热和滚压等装置。", "date": "2021-08-31T16:11:00+08:00"}, {"title": "综合服务", "url": "https://www.cup.edu.cn/ciee/zhfw/lian/gczx/eaaa4dea7aeb4c54a6b067899ed1ebcb.htm", "source": "中国石油大学(北京)", "snippet": "工程训练中心\n工程训练中心作品介绍\n发布日期:2023-09-15 \n项目成果\n1.3D打印作品\n3D打印技术以增材制造技术实现快速造物定制化生产。\n2.线切割作品\n数控线切割技术利用电弧放电完成金属材料切割,是一种高精度的金属加工技术。\n3.车工作品\n车床的加工领域广泛,被称作制造机器的机器。\n4.激光切割作品\n激光切割技术改造传统制造技术,成为了人们所幻想追求的“削铁如泥”的宝剑。\n5.钳工作品\n钳工是魅力独特的手工制造技术,在机械制造中有着特殊的、不可取代的作用。\n6.智能产线\n智能产线复刻了现代制造业的生产方式和工艺过程。", "date": "2023-09-15T08:00:00+08:00"}, {"title": "复合材料自动铺丝成型工艺 - 道客巴巴", "url": "https://www.doc88.com/p-74187949848430.html", "source": "道客巴巴", "snippet": "下载积分: 1000 内容提示: 复合材料自动铺丝成型工艺 先进材料具有轻重量、高强度、高模量、结构功能整合、设计与制造一体化、易形成大组件等优点。这在航空航天行业中发挥着非常重要的作用。这是理想的结构材料。国外军机上复合材料的用量普遍占结构重量的 25%~50%;在民用领域, 波音 787 飞机的复合材料用量达到 50%, 而空客 A350 复合材料用量更是达到了创纪录的 52%", "date": "2023-10-13T11:57:55+08:00"}, {"title": "增材制造—粉末床-山东大学航空构件制造技术及装备研究中心", "url": "https://www.cacm.sdu.edu.cn/info/1051/1153.htm", "source": "www.cacm.sdu.edu.cn", "snippet": "图 金属 3D 打印粉末床 负责人: 孙杰 教授 组成部分: 电气系统、机械系统、控制系统 功能及用途: 装铺金属粉末、放置基板,用于铺粉式和送粉式的金属 3D 打印 创新点: 1) 自主研发大尺寸( 1000 × 600 × 500mm )打印 , 突破常规成型尺寸局限; 2) 外置出粉口,接粉更加便捷和高效。", "date": "2019-07-18T12:33:25+08:00"}, {"title": "一种基于3D打印技术的复合材料自动铺带机_宁夏技术市场", "url": "https://www.nxtt.org.cn/tec/297/297271.html", "source": "www.nxtt.org.cn", "snippet": "摘要:本发明公开了一种基于3D打印的复合材料自动铺带机,包括主机机构、工作台、复合材料预浸带铺设装置、材料成型压实机构,所述的主机机构为五轴联动机构,所诉的工作台为静止放置,所诉的复合材料预浸带铺设装置自动夹紧、输送、加热熔化、铺设预浸带的功能,所诉压实装置有加热、压实、铺平的功能,机器铺设的复合材料预浸带为热塑性预浸带。本发明发挥了3D打印技术的优势,实现复材产品的整体成型,解决了复合材料成型过程的孔隙、分层、鼓泡等缺陷,五轴联动解决了,复合曲面板的成型难问题,以及3D打印技术纵向拉应力小的缺陷。", "date": "2024-12-15T14:02:32+08:00"}, {"title": " 国内外复合材料工艺设备发展述评之四——自动铺放成型 - 道客巴巴 ", "url": "https://www.doc88.com/p-31273485725139.html", "source": "道客巴巴", "snippet": "下载积分: 1000 内容提示: 国内外复合材料工艺设备发展述评之四 —— 自动铺放成型 随着复合材料在航空、航天、汽车、船舶等领域中的广泛应用,自动铺放成型技术越来越成为发展方向,它能够有效地提高生产效率和产品质量,并能够降低成本和能耗。 自动铺放成型技术是一种先进的复合材料制造技术,它主要是通过计算机程序控制铺放机器人的运动轨迹和材料铺放的方式,完成对复合材料的自动化铺放,从而实现对产品制造过程的精准控制。自动铺放成型技术不仅能够实现对复合材料的自动化生产和加工,而且具有生产效率高、精度高、产生废弃物少、重复加工率低等优点。 自动铺放成型技术主要应用... 文档格式:DOCX | 页数:2 | 浏览次数:3 | 国内外复合材料工艺设备发展述评之四 —— 自动铺放成型 随着复合材料在航空、航天、汽车、船舶等领域中的广泛应用,自动铺放成型技术越来越成为发展方向,它能够有效地提高生产效率和产品质量,并能够降低成本和能耗。 自动铺放成型技术是一种先进的复合材料制造技术,它主要是通过计算机程序控制铺放机器人的运动轨迹和材料铺放的方式,完成对复合材料的自动化铺放,从而实现对产品制造过程的精准控制。自动铺放成型技术不仅能够实现对复合材料的自动化生产和加工,而且具有生产效率高、精度高、产生废弃物少、重复加工率低等优点。 自动铺放成型技术主要应用于飞机、汽车、火箭、卫星、航空航天器、船舶等高档复合材料制品的生产,随着这些产品在市场中的不断增加,使得自动铺放成型技术的应用范围和市场需求得到不断扩大和增强。同时,在国际市场上,自动铺放成型技术得到了广泛的应用和推广,这也促进了我国自动铺放成型技术在国际市场上的竞争能力和影响力的提高。 目前,自动铺放成型技术是国内复合材料制造工艺和设备领域的热门研究和应用方向之一。我国自动铺放成型技术的开发与应用经历了一个快速发展的过程,其中,中国航天科技集团", "date": "2023-12-06T19:46:02+08:00"}, {"title": "中国商飞复合材料中心现有自动铺带机、自动铺丝机、热隔膜机、热模压机、高压水切割机-东方财富网股吧", "url": "https://mguba.eastmoney.com/mguba/article/0/1210894031", "source": "东方财富网股吧", "snippet": "$XD上工申(SH600843)$ 中国商飞复合材料中心现有自动铺带机、自动铺丝机、热隔膜机、热模压机、高压水切割机等先进设备,具备大型热固性复合材料结构件自动化制造能力,液体成型、热塑性复合材料成型、修理和无损检测等工艺技术的研究能力。 C919飞机复合材料平尾部件的量产制造,以及CR929项目复合材料前机身攻关全尺寸筒段总装下线,标志着商飞复材中心在大型复合材料结构研发与制造领域取得突破性进展,达到国内领先水平。", "date": "2022-07-27T13:34:58+08:00"}], "extracted_facts": [{"content": "激光定向能量沉积（DED）送粉式金属3D打印设备可兼容普通激光熔覆粉末与3D打印专用粉末，支持多金属打印与梯度合金材料制造，并可用于金属零件增材再制造与表面强化。", "source_name": "泰昂科技（tyontech）产品页", "source_url": "http://www.tyontech.com/product/detail/id/143.html", "credibility": 0.35}, {"content": "大族激光铺粉式（LPBF）金属3D打印装备可打印不锈钢、模具钢、钛合金、铝合金，尺寸精度可达±0.1mm，可成形壁厚小于0.1mm的薄壁复杂结构，应用于航空航天等行业。", "source_name": "维科号（OFweek）", "source_url": "https://mp.ofweek.com/3dprint/a156714183287", "credibility": 0.35}, {"content": "复合材料因高比强度、高比模量、抗疲劳、抗腐蚀和隐身性能成为航空结构理想用材；自动铺丝机（AFP）铺丝头包含纤维束分配、送进、夹紧、剪切、重送、加热和滚压等装置，用于提高生产率并控制材料浪费。", "source_name": "化工仪器网", "source_url": "https://www.chem17.com/tech_news/detail/2764478.html", "credibility": 0.5}, {"content": "中国石油大学（北京）工程训练中心页面仅介绍3D打印、线切割、车工、激光切割、钳工和智能产线等教学实训项目，与战机复合材料/增材制造无实质关联。", "source_name": "中国石油大学（北京）", "source_url": "https://www.cup.edu.cn/ciee/zhfw/lian/gczx/eaaa4dea7aeb4c54a6b067899ed1ebcb.htm", "credibility": 0.75}, {"content": "国外军机上复合材料用量普遍占结构重量的25%~50%；波音787复合材料用量达50%，空客A350达52%。", "source_name": "道客巴巴《复合材料自动铺丝成型工艺》", "source_url": "https://www.doc88.com/p-74187949848430.html", "credibility": 0.4}, {"content": "山东大学航空构件制造技术及装备研究中心自主研发大尺寸粉末床金属3D打印装备，成形尺寸达1000×600×500mm，突破常规成形尺寸局限，并设外置出粉口提升效率。", "source_name": "山东大学航空构件制造技术及装备研究中心", "source_url": "https://www.cacm.sdu.edu.cn/info/1051/1153.htm", "credibility": 0.8}, {"content": "一项专利公开了基于3D打印技术的复合材料自动铺带机：五轴联动主机、静止工作台、热塑性预浸带自动夹紧/输送/加热熔化/铺设及加热压实铺平机构，旨在实现复材整体成型并解决孔隙、分层、鼓泡缺陷及复合曲面成型难题。", "source_name": "宁夏技术市场（专利信息）", "source_url": "https://www.nxtt.org.cn/tec/297/297271.html", "credibility": 0.55}, {"content": "自动铺放成型通过计算机程序控制铺放机器人运动轨迹与铺放方式，实现复合材料自动化铺放，具有效率高、精度高、废料少、重复加工率低的优点，广泛应用于飞机、火箭、卫星、船舶等。", "source_name": "道客巴巴《国内外复合材料工艺设备发展述评之四——自动铺放成型》", "source_url": "https://www.doc88.com/p-31273485725139.html", "credibility": 0.4}], "data_points": [{"name": "尺寸精度", "value": "±0.1", "unit": "mm", "year": 2021, "source": "维科号（OFweek）"}, {"name": "最小壁厚", "value": "<0.1", "unit": "mm", "year": 2021, "source": "维科号（OFweek）"}, {"name": "国外军机复合材料结构重量占比", "value": "25-50", "unit": "%", "year": null, "source": "道客巴巴《复合材料自动铺丝成型工艺》"}, {"name": "波音787复合材料用量", "value": "50", "unit": "%", "year": null, "source": "道客巴巴《复合材料自动铺丝成型工艺》"}, {"name": "空客A350复合材料用量", "value": "52", "unit": "%", "year": null, "source": "道客巴巴《复合材料自动铺丝成型工艺》"}, {"name": "粉末床成形尺寸", "value": "1000×600×500", "unit": "mm", "year": 2019, "source": "山东大学航空构件制造技术及装备研究中心"}]}}

data: {"type": "thought", "agent": "DeepScout", "timestamp": "2026-11-10T23:07:30.338538", "content": {"agent": "DeepScout", "content": "追溯原始数据源: 国外军机 复合材料 结构重量占比 25% 50% 数据来源, 波音787 复合材料 占结构重量 50% 官方数据"}}

data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:07:30.338613", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["国外军机 复合材料 结构重量占比 25% 50% 数据来源", "波音787 复合材料 占结构重量 50% 官方数据"], "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:07:30.739184", "content": {"results": [{"id": "sr_31652c", "title": "投资者提问:目前世界先进军机中复合材料用量占全机结构重量的20%-50%不...复合材料_新浪财经_新浪网", "source": "新浪财经", "url": "https://finance.sina.com.cn/stock/relnews/dongmiqa/2023-02-22/doc-imyhqhru8626514.shtml", "snippet": "目前世界先进军机中复合材料用量占全机结构重量的20%-50%不等,主要应用复合材料的部位包括整流罩、平尾、垂尾、平尾翼盒、机翼、中前机身等。贵公司能生产此类树脂基复合材料以用于军事军工、航天、汽车等高科技领域吗?", "date": "2023-02-22T16:55:00+08:00"}, {"id": "sr_1b951f", "title": "部分军机及直升机复合材料占比-行业数据-三个皮匠报告", "source": "三个皮匠报告", "url": "https://www.sgpjbg.com/info/2eee3ad4ba53138dacb122626875225f.html", "snippet": "碳纤维增强树脂基复合材料的飞机,在减轻飞机重量、减少燃油、减少维修成本和延长飞机使用寿命上有明显优势。根据《机械工程材料》,目前世界先进军机中复合材料用量占全机结构重量的 20%~50%不等,如果复合材料占飞机总重量的 50%左右,则全机绝大部分结构件由复合材料制成,如B-2 隐形轰炸机。此外,直升机、无人机均大量应用碳纤维复合材料,直升机复合材料用量已达到结构重量的40%~60%。例如,美国武装直升机 RAH-66 的复合材料使用量为 50%;欧洲 NH-90直升机的复合材料使用量达到 80%,接近全复合材料结构;美国 X-45 系列飞机的复合材料用量达 90%以上,“全球鹰”无人侦察机复合材料用量达 65%。", "date": "2024-09-20T05:41:46+08:00"}, {"id": "sr_7a5757", "title": "复合材料在军用飞机制造中应用状态样本.doc_淘豆网", "source": "淘豆网", "url": "https://www.taodocs.com/p-435294337.html", "snippet": "如新型战斗机F-35复合材料应用百分比达成31%,大型民用客机B787及A350XWB分别达成结构重量50%和52%,A用于百分比将达成65%。广泛应用于机翼、机身等主承力结构,飞机结构已经进入了复合材料时代。国外关键飞机复合材料用量见表1。", "date": "2020-10-30T20:24:06+08:00"}, {"id": "sr_f0ed59", "title": "碳纤维材料孔隙率超声测验与评价技术研究.doc - 豆丁网", "source": "豆丁网", "url": "https://www.docin.com/p-1485934070.html", "snippet": "Airbus公司的A350客机,复合材料结构重量占全机结构重量的52%,被认为.是迄今为止复合材料用量比例最大的一种客机;波音公司的波音787客机复合材料结构重量比例也达到了50%,大大提高了结构效率[2’3];先进复合材料在国内外研制的各式无人机中的用量比例更是达到了结构总重量的80%~90%[4]。", "date": "2016-03-13T09:52:02+08:00"}, {"id": "sr_fc4c80", "title": "国外固定翼战机复合材料应用比例趋势-行业数据-三个皮匠报告", "source": "三个皮匠报告", "url": "https://www.sgpjbg.com/hyshuju/4767932c801f561769cb82e9555a60c3.html", "snippet": "进战斗机便开始大量使用先进树脂基复合材料。目前,世界各国的先进军用飞机的复合材料大约占到全飞机总质量的 20%~50%,应用范围囊括了机体各个部位。复合材料应用比例 成为了衡量战机先进 的重 指标,和三代战斗机 比,四代战斗机用结构材料的最大差别是先进复合材料的大量应用,F-22、F-35 复合材料用量分别达 25%、35%。高韧 结构复合材料降低了结构重量系数;宽频隐身一体化吸波复合材料应用使飞机能够在保持良好气动外 的同时实现雷达隐身;高 能透波复合材料使有源 控阵雷达、无源探测和电子干扰装备得到高 应用,提升了探测和电子战能力。", "date": "2024-09-08T23:33:51+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 1}}

