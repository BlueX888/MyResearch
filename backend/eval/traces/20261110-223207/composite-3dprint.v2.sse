data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:11:20.730721", "content": {"agent": "DeepScout", "tool": "deep_search_follow_up", "queries": ["Lockheed Martin F-35 composite material percentage airframe weight official", "F-35 Selected Acquisition Report composite materials weight percent"], "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:11:21.160867", "content": {"results": [{"id": "sr_8f4fdb", "title": "洛马公司开发F-35整机先进测量手段 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7036261156289249800/", "snippet": "复合材料占机体重量的35%,其中大部分是双马树脂,以及一些碳纳米管增强环氧树脂,其拉伸强度大约是钢的100倍。", "date": "2021-11-30T15:26:00+08:00"}, {"id": "sr_7e44d8", "title": "How Composite Materials Challenge the Automotive Manufacturing Industry - Part 1", "source": "insights.globalspec.com", "url": "https://insights.globalspec.com/article/7242/how-composite-materials-challenge-the-automotive-manufacturing-industry-part-1-cost-barriers", "snippet": "Figure 1 - 50% of the components in the Boeing 787 are composites. Highly stressed landing gear part require steel. Source: Boeing The latest commercial aircraft, Boeing 787/777 and the Airbus A350XWP, contain up to 50% carbon fiber reinforced plastics (CFRP) composites by weight. The average amount of fuel used per flight by US airlines in 2013 was 2,790 gaing in total fuel costs of $40.5 billion USD. The reduction of aircraft mass justifies the price of composite materials through reduced drag and improved fuel efficiency. An improvement in fuel efficiency and dease in fuel economy.... Using lightweight components and high-efficiency engines enabled by advanced materials in one-quarter of the U.S. [automotive] fleet could save more than 5 billion gallons of fusses. As a result of the “fu", "date": "2017-10-28T22:35:41+08:00"}, {"id": "sr_291865", "title": "复合材料在军用飞机制造中应用状态样本.doc_淘豆网", "source": "淘豆网", "url": "https://www.taodocs.com/p-435294337.html", "snippet": "如新型战斗机F-35复合材料应用百分比达成31%,大型民用客机B787及A350XWB分别达成结构重量50%和52%,A用于百分比将达成65%。广泛应用于机翼、机身等主承力结构,飞机结构已经进入了复合材料时代。国外关键飞机复合材料用量见表1。", "date": "2020-10-30T20:24:06+08:00"}, {"id": "sr_f6e930", "title": "A350的复合材料构件制造-《航空制造技术》2013年13期-中国知网", "source": "中国知网", "url": "https://mall.cnki.net/magazine/Article/HKGJ201313006.htm", "snippet": "A350是迄今为止被认为复合材料用量占全机结构重量比例最大的一种客机,其复合材料结构重量占全机结构重量52%,超过了波音787复合材料结构重量比例的50%。由于复合材料构件都比较大,质量要求更加严格,在设备上,工艺流程上也带来了许多新的要求,本文即对该飞机的复合材料大型构件的制造进行阐述。 (共4页)", "date": "2013-01-01T00:00:00+08:00"}, {"id": "sr_ca5ada", "title": "碳纤维材料孔隙率超声测验与评价技术研究.doc - 豆丁网", "source": "豆丁网", "url": "https://www.docin.com/p-1485934070.html", "snippet": "Airbus公司的A350客机,复合材料结构重量占全机结构重量的52%,被认为.是迄今为止复合材料用量比例最大的一种客机;波音公司的波音787客机复合材料结构重量比例也达到了50%,大大提高了结构效率[2’3];先进复合材料在国内外研制的各式无人机中的用量比例更是达到了结构总重量的80%~90%[4]。", "date": "2016-03-13T09:52:02+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:11:33.053179", "content": {"results": [{"id": "sr_8412ec", "title": "碳纤维龙头企业发布24年业绩,空天板块增长助力营收和利润双提升 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7463385623731323402/", "snippet": "1月23日,全球领先的碳纤维制造商——美国Hexcel赫氏公司公布了2024年第四季度以及2024全年业绩报告,2024年第四季度销售额为4.738亿美元,较2023年增长了3.6%。2024年全年Hexcel公司的 销售额为19.03亿美元,与2023年销售额相比提高了6.4% ; 全年调整后的营业利润为2.361亿美元 ,同比 增长8.9% 。 2024年第四季度市场概述 2024年第四季度销售额为4.738亿美元,较2023年第四季度的4.575亿美元增长了3.6%。 商业航空业务: 2024年第四季度Hexcel公司商业航空业务的销售额为2.783亿美元,与2023年第四季度相比增长了4.0%(按固定汇率计算为4.6%),大幅增长主要得益于空客A320neo和波音787的适度增长;但波音737 MAX的销售额同比下降。2024年第四季度其他商业航空航天业务出现增长,主要由支线喷气机的强劲表现推动。 使用美国Hexcel碳纤维产品的商业飞机生产率 太空与国防业务: 与2023年第四季度相比,2024年第四季度太空与国防销售额为1.633亿美元,同比增长7.2%(按固定货币计算为7.6%),增长主要来自西科斯基CH-53K和洛克希德F-35,以及国内外航天领域的强劲表现。 美国Hexcel碳纤维用于多款军用直升机项目中 工业领域业务: 2024年第四季度的工业总销售额为3220万美元,与2023年第四季相比下降了14.6%(按固定汇率计算为14.8%),除休闲娱乐领域外,所有子市场均出现下滑。 2024年第四季度毛利率为25.0%,高于2023年第四季度的22.5%。销售、一般和管理费用占销售额的比例为10.1%,高于2023年第四季度的9.2%。研发费用占净销售额的比例为2.8%,高于2023年第四季度的2.6%。2024年第四季度调整后的营业利润为5710万美元,占", "date": "2025-01-25T07:30:00+08:00"}, {"id": "sr_8c75a6", "title": "【行业资讯】NS1647 销售额128.4亿元!碳纤维复材巨头-美国赫氏(Hexcel)公布202..._澎湃号·政务_澎湃新闻-The Paper", "source": "澎湃新闻", "url": "https://www.thepaper.cn/newsDetail_forward_26247148", "snippet": "1月24日,美国Hexcel公司公布了2023年财报。 (Hexcel官网截图) 2023年第四季度,公司实现销售额为4.575亿美元,同比增长6.5%,调整后营业收入为4910万美元,毛利率为22.5%。其中: 商业航空业务方面,销售额为2.675亿美元,同比增长了4.4%(按固定汇率计算为5.3%),主要系空客A350和波音787宽体飞机销量的增长支撑,而大型客舱公务机越来越多地采用复合材料。但窄体机销量同比下降部分抵消了这一增长。 太空与国防业务:销售额为1.523亿美元,同比增长20.4%(按固定汇率计算为19.7%),增速显著。 工业领域业务:销售额为3770万美元,同比下降了19.3%(按固定货币计算为22.3%)。 2023年全年,销售额为17.89亿美元(约128.4亿元人民币),而2022年的销售额为15.777亿美元,增长了13.4%。调整后营业收入为2.167亿美元,毛利率为24.2%。其中: 商用航空业务:销售额为10.682亿美元,同比增长了17.2%(按固定货币计算为17.0%)。 太空与国防:销售额增长了17.1%(按固定货币计算为16.6%),达到5.448亿美元,这主要得益于全球固定翼、太空项目以及欧洲直升机等领域增长。 工业领域:销售额为1.76亿美元,同比下降了12.3%(按固定货币计算为13.6%),因为许多工业子市场疲软,超过了汽车两位数的销售增长。 由于商用飞机积压创造新纪录以及公司客户预期的建造速度增长,公司预计2024年的销售额将再次实现两位数的增长。 来源:赛奥碳纤维技术、复材社、Hexcel", "date": "2024-02-02T08:00:00+08:00"}, {"id": "sr_65dbef", "title": "空天板块碳纤维销售占比达93%,行业龙头2024前三季度营收稳增长 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7430834406555664935/", "snippet": "10月22日,全球领先的碳纤维制造商——美国Hexcel赫氏公司公布了第三季度业绩报告,2024年第三季度的销售额为4.565亿美元,而2023年、2022年第三季度销售额分别为4.195亿美元、3.647亿美元; 2024年前三季度(1月-9月)的销售额为14.292亿美元,而2023年、2022年同期销售额分别为13.315亿美元、11.483亿美元 。 2024年第三季度市场概述 商业航空业务: 2024年第三季度Hexcel公司商业航空业务的销售额为2.959亿美元,与2023年第三季度相比 增长了17.5% (按固定汇率计算为17.0%), 大幅增长主要是由空客A350和A320neo项目带动的;波音787的销售额也有所增长 。2024年第三季度其他商用航空(包括支线飞机和商用飞机)的销售额与2023年第三季度相比增长了9.1%,其中最新一代公务机的销售额居首。 使用美国Hexcel碳纤维产品的商业飞机生产率 太空与国防业务: 与2023年第三季度相比,本季度太空与国防销售额为1.282亿美元,相对保持不变(按固定汇率计算下降0.9%) 美国Hexcel碳纤维用于多款军用直升机项目中 工业领域业务: 2024年第三季度的工业总销售额为3240万美元,与2023年第三季相比下降了16.5%(按固定汇率计算为17.3%),而与之相比2024年第三季度该领域销售额曾高达4700万美元。 2024年前三季度市场概述 2024年前三季度(1-9月)Hexcel公司的 销售额为14.292亿美元,与2023年前三季度销售额13.315亿美元,提高了7.3% 。 商用航空(占年初至今销售额的64%) :2024年前9个月,商业航空销售额为9.159亿美元,与2023年前9月相比增长了14.4%(按固定汇率计算为14.3%), A350、波音787以及A320neo都引领了增长", "date": "2024-10-29T07:30:00+08:00"}, {"id": "sr_26cba3", "title": "销售额128.4亿元!美国赫氏公司公布2023年财报_文章_同比增长_货币", "source": "搜狐新闻", "url": "https://news.sohu.com/a/755995527_121124370", "snippet": "1月24日,美国赫氏( Hexcel) 公司公布了2023年财报。 2023年第四季度,公司实现销售额为4.575亿美元,同比增长6.5%,调整后营业收入为4910万美元,毛利率为22.5%。其中: 商业航空:销售额为2.675亿美元,同比增长了4.4%(按固定汇率计算为5.3%),主要系空客A350和波音787宽体飞机销量的增长支撑,而大型客舱公务机越来越多地采用复合材料。但窄体机销量同比下降部分抵消了这一增长。 太空与国防:销售额为1.523亿美元,同比增长20.4%(按固定汇率计算为19.7%),增速显著。 工业领域:销售额为3770万美元,同比下降了19.3%(按固定货币计算为22.3%)。 2023年全年,销售额为17.89亿美元(约128.4亿元人民币),而2022年的销售额为15.777亿美元,增长了13.4%。调整后营业收入为2.167亿美元,毛利率为24.2%。其中: 商用航空:销售额为10.682亿美元,同比增长了17.2%(按固定货币计算为17.0%)。 太空与国防:销售额增长了17.1%(按固定货币计算为16.6%),达到5.448亿美元,这主要得益于全球固定翼、太空项目以及欧洲直升机等领域增长。 工业领域:销售额为1.76亿美元,同比下降了12.3%(按固定货币计算为13.6%),因为许多工业子市场疲软,超过了汽车两位数的销售增长。 由于商用飞机订单积压创造新纪录,以及公司客户预期的建造速度提高,公司预计2024年的销售额将再次实现两位数的增长。 深圳国际复材展参观预登记 请扫描或长按下方二维码 声明:本公众号部分文章和图片来源于网络,发布的文章仅用于复合材料专业知识和市场资讯的交流与分享,不用于任何商业目的。任何个人或组织若对文章版权或其内容的真实性、准确性存有疑义,请第一时间联系我们。我们将及时进行处理。", "date": "2024-02-02T17:55:00+08:00"}, {"id": "sr_9b38bc", "title": "Aspen Aerogels, Inc. Provides Business Update", "source": "PR Newswire", "url": "https://www.prnewswire.com/news-releases/aspen-aerogels-inc-provides-business-update-302032189.html", "snippet": "Pre-Announces Full Year 2023 Revenues of $238 million ; $84 million in Q4 Supplemental supply for Energy Industrial products initiated in Q4 Potential to Deliver Over 47% YoY revenue growth in 2024", "date": "2024-01-11T07:30:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:11:35.414328", "content": {"results": [{"id": "sr_2b3b74", "title": "航空复材零部件观点_华经情报网_华经产业研究院", "source": "华经情报网", "url": "https://www.huaon.com/tag/hangkongfucailingbujian/guandian/", "snippet": "复合材料的用量已成为衡量军用装备先进性的重要标志。复合材料正成为航空以及国防装备的关键材料。复合材料在我国军机的用量占比不断提升,已从最初用量1%左右提升至20%左右,且目标用量将增加至29%。", "date": "2024-09-10T02:06:58+08:00"}, {"id": "sr_46ac96", "title": "复合材料在军机上的应用历程 - 行业研究数据 - 小牛行研", "source": "小牛行研", "url": "https://www.hangyan.co/charts/3051458972247655934", "snippet": "新机型复材占比不断增加,有望带动碳纤维需求量进一步提升。伴随新一代战机对隐身及减重要求进一步增加,复合材料用量占比不断增加,根据《航空复合材料技术》,1969 年时,美军 F-14A 战机碳纤维复材用量仅有 1%,到当前美军主战战机 F-22 与F-35 碳纤维复合材料用量已经达到 24%与36%,以隐身特性见长的 B-2 隐形轰炸机复材用量更是超过了 50%,可见国外战机中复材用量占比呈增长趋势。根据产业信息网及智研咨询,我国二代战机中,歼-7复材占比 3%;三代机中,歼-10 复材占比 6%,歼-11 复材占比约为 10%;四代机中,歼-20 复材占比 20%。虽我军新机型中复材用量已逐步增加,但与美军横向比较看,仍有较大提升空间。从下游主机厂看,以J-20、Z-20、Y-20 等为代表的新机型逐步量产,其复合材料占比较原有机型均有较大程度的提高,势必带动碳纤维需求量的进一步提升。", "date": "2023-03-05T21:04:42+08:00"}, {"id": "sr_6fa1c2", "title": "海外军机碳纤维复材使用情况-行业数据-三个皮匠报告", "source": "三个皮匠报告", "url": "https://www.sgpjbg.com/hyshuju/1108fbf3b644d42cbee4bfab61b9b278.html", "snippet": "1、军机:碳纤维复材在先进军机使用比例不断提升,目前先进战机碳纤维复材用量达20%~50%。美国最先将碳纤维复材用导军机,从20世纪 60年代用导军机舱门、口盖、整流罩以及副翼、方向舵等受力较小或非承力部件,到80年代初发展到垂尾、平尾等尾翼一级的次承力部件,再到 80年代末到机翼、机身等主要承力结构,现在碳纤维复材占军机结构质量的 20%~50%。目前美国 F-22和F35为代表的第四代战斗机上碳纤维复材用量达到 25%和35%,我国战斗机 J-20碳纤维复材用量高达 27%。", "date": "2024-11-07T23:22:16+08:00"}, {"id": "sr_4a6ec6", "title": "长江证券-军工行业激浊扬清，周观军工 第95期：本月金股·中航高科-241201", "source": "慧博投研资讯", "url": "http://m.hibor.com.cn/wap_detail.aspx?id=7501a843a75f2d742803fe806854ed35", "snippet": "研报摘要\n 军用航空:军机列装与复材占比齐升,未来需求高景气趋势确定\n复合材料对战机轻型化、隐身化、高性能化关重要,美国最新四代机F-35的复合材料用量高达35%。高韧性结构复合材料降低了结构重量系数;宽频隐身一体化吸波复合材料应用使飞机能够在保持良好气动外形的同时实现雷达隐身;高性能透波复合材料使有源相控阵雷达、无源探测和电子干扰装备得到高效应用,提升了探测和电子战能力,F-22、F-35复合材料用量分别达25%、35%。\n军用无人机对于减重要求严格,复合材料用量显著高于有人机,甚至出现全复合材料无人机。无人机对减重有特殊的需求,只有将结构质量系数控制在30%以下才能腾出质量空间让给燃油、有效载荷、补偿隐身带来的增重。目前,无论是各种大中型军用无人机还是微型无人机,复合材料大量应用,用量一般占机体结构总重的50%~80%,应用比例明显超过有人飞机。\n风险提示\n1、我国国防科技工业体系的体制机制改革进程低于预期,产业组织架构变革的不确定性;\n2、“十四五”武器装备建设规划牵引下,大批量交付产能及时释放的不确定性,我们预测上市公司在建工程和固定资产开支维持高位表征公司积极扩产,如果因为各种原因产能未能及时投入或需求订单未能按期下达导致产品未能按期交付,可能导致行业景气预期向下;\n3、科研型号研制进度不及预期,招标的不确定性;\n4、国企改革效率提升不及预期,供给侧改革的不确定性。\n研报全文\n激浊扬清,周观军工第95期:本月金股·中航高科长江证券研究所军工研究小组2024-12-01%%%%%%%%research.95579.com1分析师王贺嘉分析师王清分析师张晨晨联系人杨继虎SAC执业证书编号:S0490520110004SAC执业证书编号:S0490524050001SAC执业证书编号:S0490524080007SFC执业证书编号:BUX462联系人张飞联系人李麟君分析", "date": "2024-12-02T05:22:56+08:00"}, {"id": "sr_e0f229", "title": "国外部分军用飞机复合材料用量 - 2022年05月-行业研究数据 - 小牛行研", "source": "小牛行研", "url": "https://www.hangyan.co/charts/2849187037209167536", "snippet": "当前我国航空航天领域的复合材料应用水平与国外仍有较大差距。目前,国内航空航天领域的复合材料应用已取得很大的进展,特别是军用飞机已由原先的非承力结构已经开始向次承力、主承力结构发展,由原来的飞机内饰件发展到水平尾翼、垂直尾翼、机翼、机身等部件,其零件结构向大型化、整体化方向发展。但从应用比例来看相较国外仍有较大差距:国内歼击机、直升机和运输机的复材应用比例分别为 25%/40%/12%,而国外同种类应用水平分别为 36%/60%/40%。此外,在小型商务飞机方面,国外复材应用比例为 70-80%,而国内仍为空白。其中国产民机 ARJ21 的复合材料结构用量仅为 2%,正在研制的大飞机C919 的复合材料结构用量 12%,并且尚未用于机翼机身这样的主承力结构,相较而言,国外的波音 787 和空客 350 及后续研制的飞机均超过 50%。", "date": "2022-05-30T01:32:34+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:11:41.042316", "content": {"results": [{"id": "sr_5124cd", "title": "洛马公司开发F-35整机先进测量手段 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7036261156289249800/", "snippet": "复合材料占机体重量的35%,其中大部分是双马树脂,以及一些碳纳米管增强环氧树脂,其拉伸强度大约是钢的100倍。", "date": "2021-11-30T15:26:00+08:00"}, {"id": "sr_8c1716", "title": "How Composite Materials Challenge the Automotive Manufacturing Industry - Part 1", "source": "insights.globalspec.com", "url": "https://insights.globalspec.com/article/7242/how-composite-materials-challenge-the-automotive-manufacturing-industry-part-1-cost-barriers", "snippet": "Figure 1 - 50% of the components in the Boeing 787 are composites. Highly stressed landing gear part require steel. Source: Boeing The latest commercial aircraft, Boeing 787/777 and the Airbus A350XWP, contain up to 50% carbon fiber reinforced plastics (CFRP) composites by weight. The average amount of fuel used per flight by US airlines in 2013 was 2,790 gaing in total fuel costs of $40.5 billion USD. The reduction of aircraft mass justifies the price of composite materials through reduced drag and improved fuel efficiency. An improvement in fuel efficiency and dease in fuel economy.... Using lightweight components and high-efficiency engines enabled by advanced materials in one-quarter of the U.S. [automotive] fleet could save more than 5 billion gallons of fusses. As a result of the “fu", "date": "2017-10-28T22:35:41+08:00"}, {"id": "sr_86ffb8", "title": "Processing Technology for Composite Materials  SpringerLink", "source": "ScienceDirect", "url": "https://link.springer.com/chapter/10.1007/978-3-540-92122-6_6", "snippet": "971 Accesses Current airplanes still consist mainly of metal which are mainly aluminum alloys. In the Airbus A320, the weight fraction of carbon fibre-composite (CFC) materials already amounts to 15%. These composite materials consist of fibre materials and a hardened polymeric resin. The amount CFC materials is continuously increasing as it is shown for the new megaliner A380 which will be delivered in September 2007 (Fig. 6.1). This is a preview of subscription content, log in via an institution to check access. Access this chapter Log in via an institution Subscribe and save Springer+ Basic €32.70 /Month Get 10 units per month Download Article/Chapter or eBook 1 Unit = 1 Article or 1 Chapter Buy Now Chapter EUR 29.95 Price includes VAT (China (P.R.)) eBook EUR 85.59 Price includes VAT (", "date": "2009-01-01T03:00:58+08:00"}, {"id": "sr_66346d", "title": "复合材料在军用飞机制造中应用状态样本.doc_淘豆网", "source": "淘豆网", "url": "https://www.taodocs.com/p-435294337.html", "snippet": "如新型战斗机F-35复合材料应用百分比达成31%,大型民用客机B787及A350XWB分别达成结构重量50%和52%,A用于百分比将达成65%。广泛应用于机翼、机身等主承力结构,飞机结构已经进入了复合材料时代。国外关键飞机复合材料用量见表1。", "date": "2020-10-30T20:24:06+08:00"}, {"id": "sr_ce4945", "title": "(整理)常用材料成分及机械性能-USB迷专注于互联网分享", "source": "电脑我帮您", "url": "https://www.usbmi.com/quan/1710447044a1442077.html", "snippet": "化学成分(%) Material WCB A105 CF8 CF3 CF8M CF3M F6a F304 F304L F316 F316L SS304 SS316 SS304L SS316L SS410 WC6 WC9 C5 CA15 LCB LC2 LF2 LF3 F111 F11 2 F113 F221 F223 F51 C 0.05~0.2 0.05~0.18 0.05~0.15 0.1~0.2 0.1~0.2 0.05~0.15 0.05~0.15 0.1~0.35 0.15~0.3 0.2~0.35 0.5~1 0.5~1 0.5~1 Mn 0.6~1.05 0.5~0.8 0.4~0.7 0.4~0.7 o.5~0.8 0.6~1.35 0.3~0.6 0.3~0.8 0.3~0.8 0.3~0.6 0.3~0.6 0.024.5~6.5 3.3~3.7 1~1.5 1~1.5 1~1.5 2~2.5 2~2.5 21~23 0.44~0.65 0.44~0.65 0.44~0.65 0.87~1.13 0.87~1.13 2.5~3.5 8~11 8~12 9~12 9~13 8~11 8~13 10~14 10~15 8~10.5 10~14 8~12 10~14 Cr 18~21 17~21 18~21 17~21 11.5~13.5 18~20 18~20 16~18 16~18 18~20 16~18 18~20 16~18 11.5~13.5 1~1.5 2~2.75 4~6.5 11.5~14 0.45~0.65 0.9~1.2 0.45~0.65 2~3 2~3 2~3 2~3 Mo 2~3 2~3 Nb REDUCTIN OF AREA 机械性能 YieldTensile PointStrength MPAMPA 250485~655 485~", "date": "2024-03-15T18:00:20+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:12:00.155617", "content": {"results": [{"id": "sr_d2001f", "title": "歼-20战斗机中碳纤维的使用量约为27%歼-35战斗机的碳纤维使用量占比约为30-东方财富网股吧", "source": "东方财富网股吧", "url": "https://mguba.eastmoney.com/mguba/article/0/1479931392", "snippet": "郑重声明: 用户在社区发表的所有信息将由本网站记录保存,仅代表作者个人观点,与本网站立场无关,不对您构成任何投资建议,据此操作风险自担。 请勿相信代客理财、免费荐股和炒股培训等宣传内容,远离非法证券活动。请勿添加发言用户的手机号码、公众号、微博、微信及QQ等信息,谨防上当受骗!", "date": "2024-11-05T18:24:50+08:00"}, {"id": "sr_831b34", "title": "歼-20使用了哪些复合材料？比例是多少？", "source": "网易", "url": "https://m.163.com/dy/article/DTR9J61N051198M2.html", "snippet": "近日,有媒体公开了一组歼20的最新照片,此次公布的照片都是底漆状态的歼20并且清晰度都比较高。此次曝光中的歼20战机,在包括机身,机翼,垂尾,进气口以及鸭翼部分都拥有明显颜色不同的复合材料窗口。\n有人可能会问,歼-20使用多少比例的复合材料?\n现代隐身战机机身大量使用钛合金等复合材料已经不是秘密。新型复合材料质量轻韧性高,对于提高现代隐身战机的机动性和其他性能指标至关重要。美国F22机身复合材料使用率达到了26%左右。为了提高机翼性能,其机翼复合材料使用率高达95%左右,大量复合材料使用在提高战机性能的同时,也致使改型战机造价长期居高不下。\n歼20作为一款性能最为先进五代隐身战机,大量使用复合材料是毋庸置疑的,但具体使用多大比例没有具体数据。据有关专家透露,歼20复合材料使用比率达到了20%左右。有人问为什么不使用更高比率的复合材料?其实这是一个复杂的系统工程,关乎复合材料制造,设计,制造等多个环节。所以战机增加复合材料比例不是一件简单的事。\n专家指出,复合材料应用到战机上,需要综合考虑考虑复合材料结构性能的可设计性和结构成型与材料形成等。大家都说F22是温室的战机,对环境保养等要求非常高,就连机身材料填缝都是白银制成的。这款战机除了杀鸡儆猴在叙利亚进行了反恐作战实践之外,至今也没有经过大的实战检验。一种复合材料制造使用可能涉及设计师、应力分析、材料和工艺、制造、质量控制、后勤保障工程师(可靠性、维护性和生存性)和成本估算师等,所以这是一个复杂的巨系统。我国在高端复合材料设计制造方面总体上还处于追赶的上升阶段。目前我们在复合材料方面与国际先进水平还有差距。\n所以歼20复合材料使用率能够达到20%已经是一个很不错的成就。复合材料使用率成为衡量未来战机性能的一个重要指标,歼20以及未来战机不断加大新材料使用比率将是新趋势。\n歼20使用了哪些复合材料?\n从歼20的照片,到处可见到", "date": null}, {"id": "sr_e26230", "title": "我国“J20”战斗机已经广泛采用碳纤维复合材料,复合材料占全机比例为40%.下列-刷刷题APP", "source": "刷刷题", "url": "https://www.shuashuati.com/ti/3d82a4ca5c2a4bf7bc27884c7e0c4a56.html", "snippet": "大学职业搜题刷题APP 下载APP 首页 课程 题库模板 Word题库模板 Excel题库模板 PDF题库模板 医考护考模板 答案在末尾模板 创建题库 登录 创建自己的小题库 搜索 【单选题】 A. 复合材料一定是由两种或两种以上材料制成的 B. 复合材料既保持了原材料的优点,又有优于原材料的特点 C. 在复合材料中,增强体起骨架作用 D. 传统无机非金属材料和新型无机非金属材料的主要成分都是硅酸盐 参考答案: B 复制 纠错 举一反三 参考解析: 复合材料既保持了原材料的优点,又有优于原材料的特点", "date": "2025-02-06T08:38:03+08:00"}, {"id": "sr_6c517d", "title": "复合材料,衡量战机性能的重要指标,歼-20占比率是多少?-今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/6768769290339353096/", "snippet": "自飞机诞生以来,其材料结构发生天翻地覆的变化,先后经历4个发展阶段,目前复合材料的使用正在迈入第5个阶段。", "date": "2019-12-10T19:21:00+08:00"}, {"id": "sr_c75385", "title": "航空航天碳纤维复合材料行业的发展情况 - 产业科技 - 行业新闻 - 思瀚产业研究院", "source": "www.chinasihan.com", "url": "http://www.chinasihan.com/news/cykj/7924.html", "snippet": "碳纤维(carbonfiber,简称 CF)是一种含碳量在 95%以上的高强度、高模量纤维的新型纤维材料。碳纤维质量比金属铝轻,但强度却高于钢铁,并且具有高硬度、高强度、重量轻、高耐化学性、耐高温的特性。碳纤维很少直接应用,大多是经过深加工制成中间产物或复合材料使用,碳纤维复合材料作为结构件或功能件现已广泛应用在航空航天、工业和体育休闲用品三大领域。 碳纤维以其质量轻、高强度、高模量、耐高低温和耐腐蚀等特点最早应用于航天及国防领域,如大型飞机、军用飞机、无人机及导弹、火箭、人造卫星和雷达罩等,且航空航天领域用碳纤维的性能等级相对而言是最高的。 随着碳纤维的不断发展,碳纤维在航空航天领域的应用范围不断扩大。在航空领域,碳纤维复合材料是大型整体化结构的理想材料。与常规材料相比,复合材料可使飞机减重 20%-40%。复合材料还克服了金属材料容易出现疲劳和被腐蚀的缺点,增加了飞机的耐用性。复合材料的良好成型性可以使结构设计成本和制造成本大幅度降低。 20 世纪 70 年代至今,复合材料在军用飞机上的应用范围不断扩大,目前已广泛应用于机翼、机身、垂尾、尾部整流罩、后掠翼、进气道等多个部位。以美国军机为例,F-14A 战机碳纤维复合材料用量仅有 1%,到F-22 和F-35 为代表的第四代战斗机上碳纤维复合材料用量分别达到 24%和36%,大型轰炸机方面 B-2 隐身战略轰炸机的碳纤维复合材料占比达到了 38%。 目前我国最先进的第四代战斗机歼-20 的碳纤维使用比例约为 27%,相比之下第三代战斗机歼-10 和歼-11 的碳纤维用量仅为 6%和10%。随着我国新型战机的换代升级,军机碳纤维使用比例也将不断提升。 资料来源:先进复合材料在飞机结构中的应用 碳纤维复合材料在民航客机与无人机上应用占比提升明显。在民航客机方面,碳纤维复合材料从 20 世纪 80 年代开始应用在客机上的非承力", "date": "2023-05-30T20:29:22+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:12:04.221896", "content": {"results": [{"id": "sr_52a6f3", "title": "精工科技(002006.SZ):生产线满足T400/T800/T1000/T1100等不同等级高性能碳纤维的生产需求材料航空航天t800t1000_网易订阅", "source": "网易", "url": "https://www.163.com/dy/article/IUCL964N05198ETO.html", "snippet": "格隆汇3月28日丨精工科技(002006.SZ)在投资者互动平台表示,碳纤维因其优异的力学性能和轻量化特性,在航空航天领域具有广泛的应用前景,无论是民用飞机还是军用飞行器,碳纤维都是实现结构减重、提高性能的重要材料。后续,随着航空航天等技术的不断进步、低空经济的发展,碳纤维的应用将迎来更加广阔的发展空间。精工科技碳纤维产业经过近几年的创新发展,已构建完成“聚合纺丝装备、碳化装备、复材装备“三位一体”的总体布局,可根据客户的不同需求定制各种规格的碳纤维生产线并提供系统解决方案,生产线满足T400/T800/T1000/T1100等不同等级高性能碳纤维的生产需求,产品可广泛应用于风电叶片、汽车部件、高压容器、航空航天、体育用品等领域。", "date": "2024-03-28T15:55:20+08:00"}, {"id": "sr_d83274", "title": "航空发动机用T800级碳纤维增强聚酰亚胺复合材料-阿里巴巴", "source": "1688", "url": "https://detail.1688.com/offer/814584932139.html", "snippet": "首页 全部商品 店铺动态 公司档案 联系方式 参考价 ¥ 18.00 ¥ 10.00 ¥ 8.00 起批量 1-4 5-9 ≥10 调研方式 高分子材料 货号 技术定制 市场范围 技术难题攻关 负80-2500度 耐盐雾 耐酸碱 疑难技术咨询服务 新材料 新技术 新工艺 技术攻关 技术瓶颈 技术难题 改性技术 产品信息 PRODUCT DESCRIPTION 市场范围 技术难题攻关 调研方式", "date": "2024-08-11T22:23:29+08:00"}, {"id": "sr_697d49", "title": "分析FT800级碳纤维用在哪些领域?_复合材料_隐身_航空_材料-仿真秀干货文章", "source": "仿真秀", "url": "http://www.fangzhenxiu.com/post/8476599/?uri=287_evrprpYfkNd", "snippet": "就民用航空工业来说,日本东丽的T800系列碳纤维 ,是唯一被美国联邦航空管理局批准用于波音777关键飞行部件的碳纤维,其在航空工业重要性不言而喻。 采用碳纤维替换传统金属材料,可以有效降低客机的重量,使民航 客机更省油、更经济。正是因此,碳纤维也被大量用于飞机的机翼、舱门、整流罩、起落架后撑杆和发动机 叶片。在空客的A380上,碳纤维等复合材料用量达到飞机结构用量的25%。而波音787和空客A350的碳纤维复合材料使用量占比达到50%以上。 机身采用T800碳纤维制造 在军事领域,碳纤维的使用更是由来已久,在上世纪70年代,美国就在战略导弹和作战飞机中开始使用碳纤维增强树脂材料来提高武器性能。雷达 之所以能够发现战机的根源就是在于雷达发出的电磁波会被战机的金属材料反射回去,而在战机上用碳纤维复合材料替换金属材料,就能在一定程度上提升飞机的隐身性能。而且使用碳纤维材料可以降低结构重量,提高飞机的推重比。", "date": "2024-08-03T05:04:25+08:00"}, {"id": "sr_644f78", "title": "光威复材航空航天用碳纤维定位和发展历史 - 行业研究数据 - 小牛行研", "source": "小牛行研", "url": "https://www.hangyan.co/charts/3411794376844642096", "snippet": "研究报告节选: 表15:光威复材碳纤维业务产品条线 牌号TZ300 相关行业研究图表 2023年碳纤维分业务收入(按应用;亿元) 2022年碳纤维分业务收入(按型号:亿元) TP500无人运输机 美国新一代战机复材占比相对更高 中外典型无人机型号复材占比 TANGO ALCAS 相关行业研究报告 图表内容 表16:光威复材航空航天用碳纤维定位和发展历史 主要型号 产品定位 发展历史 T300H 航空用主力碳纤维 2008年产业化项目投产,已批量供应十余年 CCF700G 航空用高端碳纤维 2022年通过装机评审并开始生产供货,扩大了公司业务機盖的终端客户范围 T800H 新一代航空用碳纤雏 2022年一条龙项目通过,开始批量应用,待千吨线等同性验证通过后将放量 40J、M55J、M60J、M65J 强度与模量兼备,用于航天领域 作为卫星结构件等材料 数据来源:公司公告,西南证茶整理", "date": "2024-07-14T01:38:30+08:00"}, {"id": "sr_fec3c2", "title": "《Toray_碳纤维资料》.pdf文档全文免费阅读、在线看", "source": "原创力文档", "url": "https://max.book118.com/html/2016/0105/32787605.shtm", "snippet": "Toray Proprietary Toray Proprietary 材料 ~新T620S~ 面向叶片开发的T620S (1) 质量稳定性 7000 (机械特性、纤维宽度、单位长度重量等) T1000G ) (2) 纤维丝束 24K 和48K a P 6000 ) T800S M ( a (3) 几种可用的类型 P h t T800H ex. 50C:常用途(缠绕、预浸布等.) M g ( n  1.0% 60E 0.2% 0.2% 3000 100 200 300 400 500 600 700 拉伸模量(GPa) Tensile Modulus (GPa) Copyright 2010 Toray Industries, Inc. All Rights Reserved Toray Proprietary Toray Proprietary GL 认证 ~T620SC-24K-50C~ Copyright 2010 Toray Industries, Inc. All Rights Reserved Toray Proprietary Toray Proprietary GL 认证 ~T620SC-24K-60E~ Copyright 2010 Toray Industries, Inc. All Rights Reserved Toray Proprietary GL 认证 ~予浸料、 碳布~ 予浸料(ACG [UK]) NCF (Saertex [DE]) 公司 T620S-24K-60E T700S-24K-50C T6g (600gsm) NCF (900gsm) 实验室 ACG IMA-Dresden ACG IMA-Dresden T620S- CV T620S- CV T700S- CV T620S- CV 碳纤维 24K-60E % 24K-60E %", "date": "2016-01-07T08:25:37+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:12:18.246519", "content": {"results": [{"id": "sr_bf5d99", "title": "洛马公司开发F-35整机先进测量手段 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7036261156289249800/", "snippet": "复合材料占机体重量的35%,其中大部分是双马树脂,以及一些碳纳米管增强环氧树脂,其拉伸强度大约是钢的100倍。", "date": "2021-11-30T15:26:00+08:00"}, {"id": "sr_5ea6fa", "title": "How Composite Materials Challenge the Automotive Manufacturing Industry - Part 1", "source": "insights.globalspec.com", "url": "https://insights.globalspec.com/article/7242/how-composite-materials-challenge-the-automotive-manufacturing-industry-part-1-cost-barriers", "snippet": "Figure 1 - 50% of the components in the Boeing 787 are composites. Highly stressed landing gear part require steel. Source: Boeing The latest commercial aircraft, Boeing 787/777 and the Airbus A350XWP, contain up to 50% carbon fiber reinforced plastics (CFRP) composites by weight. The average amount of fuel used per flight by US airlines in 2013 was 2,790 gaing in total fuel costs of $40.5 billion USD. The reduction of aircraft mass justifies the price of composite materials through reduced drag and improved fuel efficiency. An improvement in fuel efficiency and dease in fuel economy.... Using lightweight components and high-efficiency engines enabled by advanced materials in one-quarter of the U.S. [automotive] fleet could save more than 5 billion gallons of fusses. As a result of the “fu", "date": "2017-10-28T22:35:41+08:00"}, {"id": "sr_99c8b8", "title": "复合材料在军用飞机制造中应用状态样本.doc_淘豆网", "source": "淘豆网", "url": "https://www.taodocs.com/p-435294337.html", "snippet": "如新型战斗机F-35复合材料应用百分比达成31%,大型民用客机B787及A350XWB分别达成结构重量50%和52%,A用于百分比将达成65%。广泛应用于机翼、机身等主承力结构,飞机结构已经进入了复合材料时代。国外关键飞机复合材料用量见表1。", "date": "2020-10-30T20:24:06+08:00"}, {"id": "sr_d99121", "title": "碳纤维材料孔隙率超声测验与评价技术研究.doc - 豆丁网", "source": "豆丁网", "url": "https://www.docin.com/p-1485934070.html", "snippet": "Airbus公司的A350客机,复合材料结构重量占全机结构重量的52%,被认为.是迄今为止复合材料用量比例最大的一种客机;波音公司的波音787客机复合材料结构重量比例也达到了50%,大大提高了结构效率[2’3];先进复合材料在国内外研制的各式无人机中的用量比例更是达到了结构总重量的80%~90%[4]。", "date": "2016-03-13T09:52:02+08:00"}, {"id": "sr_7c2da5", "title": "(整理)常用材料成分及机械性能-USB迷专注于互联网分享", "source": "电脑我帮您", "url": "https://www.usbmi.com/quan/1710447044a1442077.html", "snippet": "化学成分(%) Material WCB A105 CF8 CF3 CF8M CF3M F6a F304 F304L F316 F316L SS304 SS316 SS304L SS316L SS410 WC6 WC9 C5 CA15 LCB LC2 LF2 LF3 F111 F11 2 F113 F221 F223 F51 C 0.05~0.2 0.05~0.18 0.05~0.15 0.1~0.2 0.1~0.2 0.05~0.15 0.05~0.15 0.1~0.35 0.15~0.3 0.2~0.35 0.5~1 0.5~1 0.5~1 Mn 0.6~1.05 0.5~0.8 0.4~0.7 0.4~0.7 o.5~0.8 0.6~1.35 0.3~0.6 0.3~0.8 0.3~0.8 0.3~0.6 0.3~0.6 0.024.5~6.5 3.3~3.7 1~1.5 1~1.5 1~1.5 2~2.5 2~2.5 21~23 0.44~0.65 0.44~0.65 0.44~0.65 0.87~1.13 0.87~1.13 2.5~3.5 8~11 8~12 9~12 9~13 8~11 8~13 10~14 10~15 8~10.5 10~14 8~12 10~14 Cr 18~21 17~21 18~21 17~21 11.5~13.5 18~20 18~20 16~18 16~18 18~20 16~18 18~20 16~18 11.5~13.5 1~1.5 2~2.75 4~6.5 11.5~14 0.45~0.65 0.9~1.2 0.45~0.65 2~3 2~3 2~3 2~3 Mo 2~3 2~3 Nb REDUCTIN OF AREA 机械性能 YieldTensile PointStrength MPAMPA 250485~655 485~", "date": "2024-03-15T18:00:20+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

