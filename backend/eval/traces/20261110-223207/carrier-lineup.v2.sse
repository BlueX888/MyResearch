data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:03:03.293700", "content": {"results": [{"id": "fact_14da0e9e", "title": "歼-15T首次公开亮相；歼-15最大起飞重量达到33吨，最大飞行速度2700（公里/小时级别）。", "source": "腾讯网", "url": "", "snippet": "歼-15T首次公开亮相；歼-15最大起飞重量达到33吨，最大飞行速度2700（公里/小时级别）。", "date": "", "isSupplementary": true}, {"id": "fact_7c647aad", "title": "歼-15最大起飞重量可达32,500公斤，作战半径为1500公里；歼-15T采用有源相控阵雷达和涡扇10C发动机等。", "source": "抖音", "url": "", "snippet": "歼-15最大起飞重量可达32,500公斤，作战半径为1500公里；歼-15T采用有源相控阵雷达和涡扇10C发动机等。", "date": "", "isSupplementary": true}, {"id": "fact_a51b00db", "title": "歼-15最大起飞重量为32,500千克（该来源部分尺寸数据存在混乱，可信度较低）。", "source": "搜狗问问", "url": "", "snippet": "歼-15最大起飞重量为32,500千克（该来源部分尺寸数据存在混乱，可信度较低）。", "date": "", "isSupplementary": true}, {"id": "fact_91245d30", "title": "央视13套《军情时间到》首次公开歼-35系列核心参数：最大起飞重量近30吨，采用我国完全自主研发的中推双发发动机，雷达反射截面积比人的手掌还要小。", "source": "腾讯网（转述央视《军情时间到》）", "url": "", "snippet": "央视13套《军情时间到》首次公开歼-35系列核心参数：最大起飞重量近30吨，采用我国完全自主研发的中推双发发动机，雷达反射截面积比人的手掌还要小。", "date": "", "isSupplementary": true}, {"id": "fact_89daaaf1", "title": "央视公布歼-35最大起飞重量接近30吨，媒体解读其已触及重型战斗机门槛；横向比较：法国阵风M为24.5吨、俄罗斯米格-29K为24吨、美国FA-18E/F接近3...", "source": "中华网军事", "url": "", "snippet": "央视公布歼-35最大起飞重量接近30吨，媒体解读其已触及重型战斗机门槛；横向比较：法国阵风M为24.5吨、俄罗斯米格-29K为24吨、美国FA-18E/F接近30吨、F-35C为31.8吨、中国歼-15系列为32至33吨。", "date": "", "isSupplementary": true}, {"id": "fact_65aa36d7", "title": "央视称歼-35最大重量近30吨，已接近F-15；F-35C最大起飞重量31.8吨，F-15A/B/C/D约30.8吨，歼-15约32.5吨；歼-35与F-35C...", "source": "腾讯网/网易新闻（转述央视）", "url": "", "snippet": "央视称歼-35最大重量近30吨，已接近F-15；F-35C最大起飞重量31.8吨，F-15A/B/C/D约30.8吨，歼-15约32.5吨；歼-35与F-35C均为第五代中型隐身舰载机，采用两侧DSI进气道、EOTS/EODAS和折叠机翼。", "date": "", "isSupplementary": true}, {"id": "fact_cd9b1a31", "title": "央视罕见公开歼-35关键性能参数，最大起飞重量接近30吨，标志中国武器装备发展透明度提升；该吨位已触及重型战斗机门槛，并与FA-18E/F、F-35C相当。", "source": "搜狐", "url": "", "snippet": "央视罕见公开歼-35关键性能参数，最大起飞重量接近30吨，标志中国武器装备发展透明度提升；该吨位已触及重型战斗机门槛，并与FA-18E/F、F-35C相当。", "date": "", "isSupplementary": true}, {"id": "fact_365bf371", "title": "官方首次公开歼-35舰载机部分核心信息，最大起飞重量逼近30吨；该文解读其属中型舰载机水准，与FA-18E/F“超级大黄蜂”29.5吨相当，低于歼-15T“飞鲨...", "source": "腾讯新闻", "url": "", "snippet": "官方首次公开歼-35舰载机部分核心信息，最大起飞重量逼近30吨；该文解读其属中型舰载机水准，与FA-18E/F“超级大黄蜂”29.5吨相当，低于歼-15T“飞鲨”32.5吨，并认为未来舰载机发展更强调中型机的高出动率。", "date": "", "isSupplementary": true}, {"id": "fact_87974312", "title": "港媒文汇网称歼-35为标准重型舰载机，正面RCS仅0.01平方米，搭载两台涡扇-19矢量发动机、氮化镓有源相控阵雷达和光电分布式孔径系统；该说法与央视“近30吨...", "source": "网易订阅（转述香港文汇网）", "url": "", "snippet": "港媒文汇网称歼-35为标准重型舰载机，正面RCS仅0.01平方米，搭载两台涡扇-19矢量发动机、氮化镓有源相控阵雷达和光电分布式孔径系统；该说法与央视“近30吨”数据及部分媒体“中型机”解读存在差异。", "date": "", "isSupplementary": true}, {"id": "fact_41aa2a63", "title": "珠海航展公布的FC-31资料显示，其最大起飞重量为28吨，机腹弹仓可挂载2吨武器，机翼6个挂点可挂载共6吨装备，整体挂载能力为8吨；FC-31为歼-35前身，可...", "source": "中华网军事", "url": "", "snippet": "珠海航展公布的FC-31资料显示，其最大起飞重量为28吨，机腹弹仓可挂载2吨武器，机翼6个挂点可挂载共6吨装备，整体挂载能力为8吨；FC-31为歼-35前身，可作为吨位与挂载能力参照。", "date": "", "isSupplementary": true}, {"id": "fact_87c3c970", "title": "截至2018年4月，全球严格意义上拥有航母的国家除中国外有8个，分别为美、俄、英、法、意、泰、巴西和印度；共装备现役航母19艘，其中40000吨级中型航母16艘...", "source": "道客巴巴《世界各国航母战斗力简析》", "url": "", "snippet": "截至2018年4月，全球严格意义上拥有航母的国家除中国外有8个，分别为美、俄、英、法、意、泰、巴西和印度；共装备现役航母19艘，其中40000吨级中型航母16艘、轻型航母3艘；日本、西班牙、澳大利亚和韩国另装备“准航母”共6艘。", "date": "", "isSupplementary": true}, {"id": "fact_7ce34dad", "title": "美国尼米兹级和福特级超级航母满载排水量超过10万吨，单舰可携带75至90架战机；福特级采用全电推进和电磁弹射器后，每天舰载机出动量可达180架次，高强度作战时可...", "source": "道客巴巴《世界各国航母战斗力简析》", "url": "", "snippet": "美国尼米兹级和福特级超级航母满载排水量超过10万吨，单舰可携带75至90架战机；福特级采用全电推进和电磁弹射器后，每天舰载机出动量可达180架次，高强度作战时可达220架次；F-35C战机具备隐身突防和战场态势感知能力。", "date": "", "isSupplementary": true}, {"id": "fact_5772875f", "title": "美国海军要求正规海军作战编成中的大型航空母舰不少于11艘，这一数字包括至少未来30年的长期远景计划。", "source": "道客巴巴《美国海军航母打击力量：作战使用与发展前景》", "url": "", "snippet": "美国海军要求正规海军作战编成中的大型航空母舰不少于11艘，这一数字包括至少未来30年的长期远景计划。", "date": "", "isSupplementary": true}, {"id": "fact_bd2a9fe8", "title": "完全依靠自身国力制造航母的国家有限：拥有中型以上航母制造能力的只有美国；俄罗斯需恢复人员储备和造船能力；法国戴高乐级第二舰需向美国进口蒸汽弹射器；英国新航母也需...", "source": "爱问知识人《世界上有几个国家有能力自造航母》", "url": "", "snippet": "完全依靠自身国力制造航母的国家有限：拥有中型以上航母制造能力的只有美国；俄罗斯需恢复人员储备和造船能力；法国戴高乐级第二舰需向美国进口蒸汽弹射器；英国新航母也需向美进口蒸汽弹射器；能自造轻型/超轻型航母的国家有英国、西班牙、意大利；日本大隅级全通甲板仅具改造可能，能力有限；韩国独岛号更像两栖攻击舰，仅能起降AV-8B等极少数固定翼飞机。另有回答称能建造航母群并用于战争的是美国、英国和日本，美国有3", "date": "", "isSupplementary": true}, {"id": "fact_a864221a", "title": "美空军CCA（协同作战飞机）旨在远程或自主运行，执行情报、监视、侦察、目标获取、火力打击等任务，与有人作战飞机组成有人-无人团队，主要充当飞行“导弹卡车”，并执...", "source": "腾讯网", "url": "", "snippet": "美空军CCA（协同作战飞机）旨在远程或自主运行，执行情报、监视、侦察、目标获取、火力打击等任务，与有人作战飞机组成有人-无人团队，主要充当飞行“导弹卡车”，并执行电子战和ISR；采用AI深度赋能、开放式架构和模块化任务载荷，可灵活切换任务。项目背景包括未来5年美退役有人战斗机将是其购买数量的2倍。", "date": "", "isSupplementary": true}, {"id": "fact_edc76c0f", "title": "美国已推出三项无人战斗机开发计划：空军型UCAV-AF计划2010年装备部队，海军型舰载无人战斗机UCAV-N由美海军与DARPA开发、计划2015年开始装备部...", "source": "道客巴巴", "url": "", "snippet": "美国已推出三项无人战斗机开发计划：空军型UCAV-AF计划2010年装备部队，海军型舰载无人战斗机UCAV-N由美海军与DARPA开发、计划2015年开始装备部队，另有陆军无人战斗机；每架无人战斗机成本约为有人战斗机的1/3。", "date": "", "isSupplementary": true}, {"id": "fact_07237036", "title": "UCAV任务范围已从压制敌方防空火力（SEAD，如X-45/47）扩展到制空、近距空中支援、纵深遮断等战斗/攻击机和轰炸机任务；目前发展的无人战斗机更类似战斗轰...", "source": "豆丁网", "url": "", "snippet": "UCAV任务范围已从压制敌方防空火力（SEAD，如X-45/47）扩展到制空、近距空中支援、纵深遮断等战斗/攻击机和轰炸机任务；目前发展的无人战斗机更类似战斗轰炸机，技术上被视为有人战斗机的延伸。", "date": "", "isSupplementary": true}, {"id": "fact_04a942f0", "title": "全球包括中国和俄罗斯均在开展UCAV研究；已首飞和计划研制的UCAV在外型上相似，由未来UCAV强调隐身、远航程和长航时的作战要求决定。", "source": "中国军网", "url": "", "snippet": "全球包括中国和俄罗斯均在开展UCAV研究；已首飞和计划研制的UCAV在外型上相似，由未来UCAV强调隐身、远航程和长航时的作战要求决定。", "date": "", "isSupplementary": true}, {"id": "fact_9a7e9857", "title": "21世纪无人驾驶作战飞行器（UCAV）很可能加入空中进攻力量主体，未来空中打击行动可能发展为以UCAV为先导的战术行动；美国已掀起UCAV研制热。", "source": "中国知网", "url": "", "snippet": "21世纪无人驾驶作战飞行器（UCAV）很可能加入空中进攻力量主体，未来空中打击行动可能发展为以UCAV为先导的战术行动；美国已掀起UCAV研制热。", "date": "", "isSupplementary": true}, {"id": "fact_bcde1989", "title": "不远的将来无人战斗机很可能成为空中打击力量的主体，以无人战斗机为主导的战术行动可能发展为未来空中打击的主要战术之一；在无人作战系统中人类操作员只是指挥者而非任务...", "source": "豆丁网", "url": "", "snippet": "不远的将来无人战斗机很可能成为空中打击力量的主体，以无人战斗机为主导的战术行动可能发展为未来空中打击的主要战术之一；在无人作战系统中人类操作员只是指挥者而非任务执行者。", "date": "", "isSupplementary": true}]}}

