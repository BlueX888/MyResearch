data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:55:52.412817", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndf1 = pd.DataFrame({'Model': ['歼-15T', 'F/A-18E/F', 'F-35C', '歼-35', '阵风M', '米格-29K'], 'MTOW': [32.5, 29.8, 31.8, 28.0, 24.5, 24.0]})\ndf2 = pd.DataFrame({'Config': ['歼-15T', '歼-35', 'F/A-18E/F', 'F/A-18E/F+MQ-25'], 'Radius': [1500, 1250, 830, 1300]})\nfor d in (df1, df2):\n    for c in d.columns:\n        if c not in ('Model', 'Config'):\n            d[c] = pd.to_numeric(d[c], errors='coerce')\ndf1 = df1.dropna()\ndf2 = df2.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(14, 6.5), dpi=200)\ncolors1 = ['#6366f1' if m in ('歼-15T', '歼-35') else '#06b6d4' for m in df1['Model']]\nbars1 = axes[0].bar(df1['Model'], df1['MTOW'], color=colors1, edgecolor='white', width=0.62)\nfor b, v in zip(bars1, df1['MTOW']):\n    axes[0].text(b.get_x() + b.get_width() / 2, v + 0.5, f'{v}', ha='center', fontsize=11, fontweight='bold')\naxes[0].set_title('中美主力舰载战斗机最大起飞重量对比', fontsize=15, fontweight='bold', pad=15)\naxes[0].set_ylabel('最大起飞重量（吨）', fontsize=13)\naxes[0].set_ylim(0, 38)\naxes[0].tick_params(labelsize=11)\naxes[0].grid(True, axis='y', linestyle='--', alpha=0.3)\ncolors2 = ['#6366f1', '#6366f1', '#06b6d4', '#10b981']\nbars2 = axes[1].bar(df2['Config'], df2['Radius'], color=colors2, edgecolor='white', width=0.62)\nfor b, v in zip(bars2, df2['Radius']):\n    axes[1].text(b.get_x() + b.get_width() / 2, v + 30, f'{v}', ha='center', fontsize=11, fontweight='bold')\naxes[1].set_title('作战半径与无人加油延伸效果', fontsize=15, fontweight='bold', pad=15)\naxes[1].set_ylabel('作战半径（公里）', fontsize=13)\naxes[1].set_ylim(0, 1750)\naxes[1].tick_params(labelsize=11)\naxes[1].grid(True, axis='y', linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "围绕'舰载机谱系演进方向'，从三个维度提炼关键数据：(1) 平台重型化/隐身化——对比中美主力舰载机最大起飞重量（歼-15T 32.5吨、F/A-18E/F 29.8吨、F-35C 31.8吨、歼-35 28吨、阵风M 24.5吨、米格-29K 24吨），显示第四代隐身机在保持中型吨位的同时以隐身与航电取胜，重型平台仍是打击半径主力；(2) 作战半径与体系延伸——歼-15T 1500km、歼-35 1250km、F/A-18E/F 830km，经MQ-25无人加油后提升至1300km，体现'有人机+无人加油/预警'的体系化演进；(3) 代次与规模——现役主体为第三代，未来为三代与四代并存，主战机型维持1~2型，中国未来航母6+艘、舰载战斗机需求400-500架、海军航空兵1000+架，指向'少型号、多用途、成体系'的谱系收敛。最终以双栏柱状图呈现平台吨位与航程能力对比。"}}

