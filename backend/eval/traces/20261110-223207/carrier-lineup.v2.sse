"支撑"}, {"source": "emals", "target": "electromagnetic_catapult", "relation": "实现"}, {"source": "unmanned", "target": "carrier_aircraft_evolution", "relation": "驱动"}, {"source": "stealth", "target": "carrier_aircraft_evolution", "relation": "驱动"}, {"source": "multi_role", "target": "carrier_aircraft", "relation": "优化"}, {"source": "cooperative_combat", "target": "carrier_uav", "relation": "应用"}, {"source": "aircraft_carrier", "target": "carrier_aircraft", "relation": "约束"}, {"source": "carrier_fighter", "target": "carrier_aircraft", "relation": "属于"}, {"source": "next_gen_fighter", "target": "carrier_fighter", "relation": "迭代"}, {"source": "ship_aircraft_adaptation", "target": "aircraft_carrier", "relation": "适配"}]}, "stats": {"entities_count": 15, "relations_count": 15}}}

data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T22:55:39.185467", "content": {"charts": [{"id": "chart_001", "title": "中国海军舰载机需求预测", "subtitle": "未来20-30年需求规模（架）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["舰载战斗机（下限）", "舰载战斗机（上限）", "海军航空兵总规模"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "fontSize": 12}}, "yAxis": {"type": "value", "name": "架", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"type": "bar", "data": [{"value": 400, "itemStyle": {"color": "#1677ff"}}, {"value": 500, "itemStyle": {"color": "#52c41a"}}, {"value": 1000, "itemStyle": {"color": "#722ed1"}}], "barWidth": 40, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#333", "fontSize": 12}}]}}, {"id": "chart_002", "title": "全球舰载机市场结构", "subtitle": "截至2020年（数量）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["拥有航母国家", "自研舰载战斗机国家", "主流现役舰载战斗机型号"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "fontSize": 12}}, "yAxis": {"type": "value", "name": "数量", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"type": "bar", "data": [{"value": 8, "itemStyle": {"color": "#1677ff"}}, {"value": 4, "itemStyle": {"color": "#fa8c16"}}, {"value": 4, "itemStyle": {"color": "#eb2f96"}}], "barWidth": 40, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#333", "fontSize": 12}}]}}, {"id": "chart_003", "title": "中国舰船电子系统装备市场规模", "subtitle": "2024年（亿元）", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "25%", "right": "15%", "top": "5%", "bottom": "5%"}, "xAxis": {"type": "value", "name": "亿元", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "category", "data": ["市场规模（下限）", "市场规模（上限）"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 1000, "itemStyle": {"color": "#1677ff"}}, {"value": 1500, "itemStyle": {"color": "#52c41a"}}], "barWidth": 20, "label": {"show": true, "position": "right", "formatter": "{c}", "color": "#666", "fontSize": 12}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}]}}

