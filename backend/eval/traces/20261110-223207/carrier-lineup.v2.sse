data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:56:37.166807", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2017, 2023, 2025], 'Fighter_Demand': [60, 450, 500]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['Fighter_Demand'], marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='舰载战斗机需求（架）')\nplt.fill_between(df['Year'], df['Fighter_Demand'], alpha=0.15, color='#6366f1')\nplt.scatter([2023], [1000], marker='s', s=100, color='#f59e0b', label='海军航空兵总规模（架）', zorder=5)\nfor x, y in zip(df['Year'], df['Fighter_Demand']):\n    plt.text(x, y + 20, str(y), ha='center', fontsize=11, fontweight='bold')\nplt.text(2023, 1020, '1000+', ha='center', fontsize=11, fontweight='bold', color='#f59e0b')\nplt.title('竞争格局分析：中国舰载机需求规模预测', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('数量（架）', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

