data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:56:12.470979", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'年份': [2017, 2023], '舰载战斗机需求': [60, 450]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = df['年份']\ny = df['舰载战斗机需求']\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='舰载战斗机需求（架）')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nlabels = ['60架', '400-500架（中值450）']\nfor xi, yi, lab in zip(x, y, labels):\n    plt.text(xi, yi + 20, lab, ha='center', fontsize=11, fontweight='bold')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('需求规模（架）', fontsize=14)\nplt.xticks(x, fontsize=12)\nplt.yticks(fontsize=12)\nplt.xlim(2016, 2024)\nplt.ylim(0, 520)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

