data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T22:47:43.679332", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述全球海军舰载机装备采购、升级与全寿命保障规模，主要国家航母舰载机编制数量、更新周期和未来增速，区分新增采购与现役改装需求。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["海军舰载机 市场规模 采购预算 航母舰载机 装备更新 增速"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述主要国家及企业竞争格局，包括美国洛马、波音、诺格，中国航空工业，法国达索，俄罗斯相关企业等，在有人舰载机、无人舰载机和舰载适配系统上的布局与份额。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["舰载机 制造商 竞争格局 F-35C 歼-35 阵风M 无人舰载机"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述舰载机谱系演进的核心技术，包括隐身设计、弹射起飞与拦阻适配、有人无人协同、自主控制、网络化作战、模块化任务系统和舰载保障技术。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["舰载隐身战机 无人舰载机 电磁弹射 有人无人协同 舰载适配技术"]}, {"id": "sec_4", "title": "政策环境", "description": "描述影响舰载机谱系演进的国防战略、军费预算、航母建设计划、装备采办政策、出口管制和盟友合作机制等政策环境。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 航母建设 舰载机政策 装备采办 出口管制"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述舰载机谱系演进面临的成本、技术复杂度、舰机适配、训练保障和供应链挑战，以及无人化、体系化作战、盟友合作和存量升级带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["舰载机 成本 挑战 无人化 机遇 舰机适配"]}, {"id": "sec_6", "title": "未来展望", "description": "描述未来10至20年舰载机谱系向第六代隐身有人机、无人作战飞机、有人无人编队和模块化舰载航空联队发展的趋势与可能路径。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["第六代舰载机 无人舰载作战飞机 未来航母航空联队 有人无人编队"]}], "research_questions": ["舰载机谱系演进的主要驱动因素和约束条件是什么", "有人无人协同将如何改变舰载机谱系结构与航母航空联队编制", "主要国家航母和舰载机计划及预算将如何影响未来10至20年谱系更替节奏"]}}

