: "chengfei", "target": "vtol", "relation": "研发"}, {"source": "vtol", "target": "j35", "relation": "可能应用"}, {"source": "j20", "target": "j35", "relation": "竞争"}, {"source": "chengfei", "target": "avic_electro", "relation": "借壳"}, {"source": "avic_electro", "target": "chengfei", "relation": "收购"}, {"source": "avic_electro", "target": "avic_chengfei", "relation": "更名"}, {"source": "avic_chengfei", "target": "chengfei", "relation": "上市平台"}, {"source": "avic_chengfei", "target": "j20", "relation": "证券化"}, {"source": "shenfei", "target": "avic_black_panther", "relation": "借壳"}, {"source": "avic_black_panther", "target": "avic_shenfei", "relation": "更名"}, {"source": "avic_shenfei", "target": "shenfei", "relation": "上市平台"}, {"source": "chengfei", "target": "capital_path", "relation": "资本化"}, {"source": "shenfei", "target": "capital_path", "relation": "资本化"}, {"source": "capital_path", "target": "backdoor", "relation": "包含"}, {"source": "capital_path", "target": "listing_platform", "relation": "包含"}, {"source": "chengfei", "target": "backdoor", "relation": "采用"}, {"source": "shenfei", "target": "backdoor", "relation": "采用"}, {"source": "avic_electro", "target": "backdoor", "relation": "构成"}, {"source": "avic_chengfei", "target": "listing_platform", "relation": "属于"}, {"source": "avic_shenfei", "target": "listing_platform", "relation": "属于"}]}, "stats": {"entities_count": 15, "relations_count": 30}}}

