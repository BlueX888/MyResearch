: {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 800, "itemStyle": {"color": "#1677ff"}}, {"value": 1000, "itemStyle": {"color": "#722ed1"}}, {"value": 3000, "itemStyle": {"color": "#fa8c16"}}], "barWidth": 16, "label": {"show": true, "position": "right", "formatter": "{c}", "color": "#666"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}]}}

