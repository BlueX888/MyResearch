data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:40:37.404514", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'阶段': ['重组前壳公司', '停牌前中航电测', '成飞测算市值'], '市值': [30, 100, 3000]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['市值'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, markeredgecolor='#6366f1', label='市值（亿元）')\nplt.fill_between(x, y, 1, alpha=0.15, color='#6366f1')\nplt.yscale('log')\nfor i, v in enumerate(y):\n    plt.text(i, v * 1.3, str(v) + ' 亿元', ha='center', fontsize=12, fontweight='bold', color='#4338ca')\nplt.xticks(x, df['阶段'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('重组进程阶段', fontsize=14)\nplt.ylabel('市值（亿元，对数刻度）', fontsize=14)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

