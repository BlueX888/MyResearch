data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:40:44.658701", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'阶段': ['重组前壳公司', '停牌前（中航电测）', '成飞测算市值'], '市值': [30, 100, 3000]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['市值'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='#f59e0b', markeredgecolor='#6366f1', markeredgewidth=2, label='市值规模')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 70, str(v) + '亿元', ha='center', fontsize=11, fontweight='bold', color='#1e293b')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('重组阶段', fontsize=14)\nplt.ylabel('市值（亿元）', fontsize=14)\nplt.xticks(x, df['阶段'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 3400)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

