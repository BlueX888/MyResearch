data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:40:25.525758", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Company': ['中航沈飞\\n(借壳中航黑豹)', '中航成飞\\n(借壳中航电测)'],\n    'Deal_Value': [79.8, 174.39],\n    'Appraisal_Growth': [129.81, 88.47],\n    'Share_Ratio': [74.2, 77.93],\n    'Market_Cap': [1200, 3000]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Company':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nx = np.arange(len(df))\nw = 0.35\nb1 = ax1.bar(x - w/2, df['Deal_Value'], w, label='交易对价(亿元)', color='#6366f1')\nb2 = ax1.bar(x + w/2, df['Appraisal_Growth'], w, label='评估增值率(%)', color='#06b6d4')\nax1.set_xticks(x)\nax1.set_xticklabels(df['Company'], fontsize=12)\nax1.set_title('交易对价与评估增值率对比', fontsize=16, fontweight='bold', pad=15)\nax1.set_ylabel('数值', fontsize=14)\nax1.legend(fontsize=11)\nax1.bar_label(b1, fmt='%.1f', fontsize=11)\nax1.bar_label(b2, fmt='%.1f', fontsize=11)\nax1.grid(True, linestyle='--', alpha=0.3)\nax2 = axes[1]\nb3 = ax2.bar(df['Company'], df['Market_Cap'], color=['#6366f1', '#10b981'], width=0.5)\nax2.bar_label(b3, fmt='%d', fontsize=12)\nax2.set_title('上市后市值规模对比', fontsize=16, fontweight='bold', pad=15)\nax2.set_ylabel('市值(亿元)', fontsize=14)\nax2.set_xticklabels(df['Company'], fontsize=12)\nax2.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦成飞与沈飞两条资本化路径的核心可比指标：交易对价（79.8亿 vs 174.39亿）、评估增值率（129.81% vs 88.47%）、发行股份占发行后总股本比例（约74% vs 77.93%）以及上市后市值规模（1200亿 vs 约3000亿）。通过双面板分组柱状图对比交易结构与市值体量，揭示沈飞'小体量借壳+配套融资'与成飞'大体量整体注入+高比例换股'的路径差异。"}}

