data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T22:32:19.661895", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述军工航空整机市场与军工资产证券化背景，包括航空工业集团核心总装资产上市进程、成飞与沈飞各自上市平台的形成时间、交易规模及市场影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 中航电测 重组 上市 军工资产证券化 沈飞 中航黑豹 重组"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述成飞与沈飞在航空工业集团内的业务分工、上市平台格局及资本运作差异，比较中航成飞与中航沈飞的板块定位、股权结构、融资功能和估值表现。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 300114 中航沈飞 600760 上市平台 对比 股权结构 估值"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述军机总装、隐身战机、舰载机和多用途战机等技术方向对资本化路径的影响，分析核心总装资产注入上市平台时技术保密、产能扩张和研发投入安排。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 歼-20 沈飞 歼-15 歼-35 军机总装 资产注入 技术保密"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国企改革、军工资产证券化、上市公司重大资产重组和注册制改革等政策，分析创业板与主板规则差异对成飞和沈飞资本化路径及上市平台选择的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军工资产证券化 国企改革 重大资产重组 创业板 主板 中航电测 中航黑豹"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述成飞与沈飞资本化后面临的关联交易、保密合规、估值波动、产能交付和市值管理等挑战，以及后续资产整合、融资扩产和激励机制优化带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 关联交易 保密 估值 市值管理 中航沈飞 产能 融资"]}, {"id": "sec_6", "title": "未来展望", "description": "描述成飞与沈飞上市平台未来发展趋势，包括航空工业集团内部资产整合、核心军机资产进一步证券化、融资功能发挥、市值管理深化及资本化路径对军工企业改革的示范效应。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业集团 资产整合 军工资产证券化 中航成飞 中航沈飞 未来 市值管理"]}], "research_questions": ["成飞与沈飞资本化路径的具体步骤和交易结构有何差异", "两者上市平台在板块定位、股权结构、融资功能和估值表现上有何不同及成因", "政策环境与航空工业集团战略如何影响二者未来资本化与资产整合方向"]}}

