data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:42:57.856880", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'year': [2025, 2025, 2024, 2024, 2024, 2024, 2025, 2025, 2025, 2026], 'confidence': [0.4, 0.4, 0.35, 0.35, 0.35, 0.35, 0.9, 0.9, 0.9, 0.35], 'name': ['成飞并表单位数量', '科研骨干规模', '翼龙-3沙特订单金额', '翼龙-3航程', '翼龙-3最大起飞重量', '翼龙-3挂载能力', '领航级智能工厂入选批次', '设备24小时利用率', '单机床操作人员降幅', '产出效率提升']}\ndf = pd.DataFrame(data)\ng = df.groupby('year').agg(count=('name', 'count'), avg_conf=('confidence', 'mean')).reset_index()\ng['avg_conf_pct'] = g['avg_conf'] * 100\nplt.figure(figsize=(12, 7), dpi=200)\nax1 = plt.gca()\nax1.plot(g['year'], g['count'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='年度指标数量（个）')\nax1.fill_between(g['year'], g['count'], alpha=0.15, color='#6366f1')\nfor x, y in zip(g['year'], g['count']):\n    ax1.text(x, y + 0.18, str(int(y)), ha='center', fontsize=11, color='#4338ca', fontweight='bold')\nax2 = ax1.twinx()\nax2.plot(g['year'], g['avg_conf_pct'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='平均置信度（%）')\nax2.fill_between(g['year'], g['avg_conf_pct'], alpha=0.15, color='#f59e0b')\nfor x, y in zip(g['year'], g['avg_conf_pct']):\n    ax2.text(x, y + 3, str(round(y, 1)) + '%', ha='center', fontsize=11, color='#b45309', fontweight='bold')\nax1.set_ylim(0, max(g['count']) * 1.45)\nax2.set_ylim(0, max(g['avg_conf_pct']) * 1.45)\nax1.set_xticks(g['year'])\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('年度指标数量（个）', fontsize=14)\nax2.set_ylabel('平均置信度（%）', fontsize=14)\nax1.tick_params(axis='both', labelsize=12)\nax2.tick_params(axis='both', labelsize=12)\nax1.grid(True, linestyle='--', alpha=0.3)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12, frameon=True)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

