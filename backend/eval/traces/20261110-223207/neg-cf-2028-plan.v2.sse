data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:41:52.611896", "content": {"results": [{"id": "fact_e38a33ce", "title": "“2323”指全年一、二、三、四季度分别完成年度任务的20%、30%、20%、30%。", "source": "IT之家", "url": "", "snippet": "“2323”指全年一、二、三、四季度分别完成年度任务的20%、30%、20%、30%。", "date": "", "isSupplementary": false}, {"id": "fact_ad57cf03", "title": "IT之家/新浪财经称，连续6年达成“2323”意味着歼-20年产量或再度超过100架。", "source": "IT之家、新浪财经", "url": "", "snippet": "IT之家/新浪财经称，连续6年达成“2323”意味着歼-20年产量或再度超过100架。", "date": "", "isSupplementary": false}, {"id": "fact_38c350ed", "title": "财富号文章称，中航成飞2024年生产歼击机100架，并称全年生产100架歼-20；另有分析估计2024年歼-20产量在100到120架之间。", "source": "东方财富网财富号", "url": "", "snippet": "财富号文章称，中航成飞2024年生产歼击机100架，并称全年生产100架歼-20；另有分析估计2024年歼-20产量在100到120架之间。", "date": "", "isSupplementary": false}, {"id": "fact_b798ff96", "title": "中华网军事称，成飞官方账号报道公司顺利完成年度各项任务目标，这是连续第七年高质量完成目标（文中语境为2025年即将结束）。", "source": "中华网军事", "url": "", "snippet": "中华网军事称，成飞官方账号报道公司顺利完成年度各项任务目标，这是连续第七年高质量完成目标（文中语境为2025年即将结束）。", "date": "", "isSupplementary": false}, {"id": "fact_9ffa2a07", "title": "中华网军事称，解放军自用型歼-10系列基本停产，成飞可能将歼-10相关生产线和生产任务转移给其他单位，目前全力生产第五代战斗机歼-20。", "source": "中华网军事", "url": "", "snippet": "中华网军事称，解放军自用型歼-10系列基本停产，成飞可能将歼-10相关生产线和生产任务转移给其他单位，目前全力生产第五代战斗机歼-20。", "date": "", "isSupplementary": false}, {"id": "fact_a23965ec", "title": "中华网军事称，双发均采用国产最新型大推力小涵道比涡扇发动机的“黄皮”歼-20照片表明，达到完全体状态的歼-20已开始量产；采用AL-31系列和涡扇-10C的早期...", "source": "中华网军事", "url": "", "snippet": "中华网军事称，双发均采用国产最新型大推力小涵道比涡扇发动机的“黄皮”歼-20照片表明，达到完全体状态的歼-20已开始量产；采用AL-31系列和涡扇-10C的早期型将逐步停产，未来成飞歼-20系列将全部为搭载涡扇-15的歼-20A和歼-20S。", "date": "", "isSupplementary": false}, {"id": "fact_b8625b8b", "title": "中华网军事预测，若六代机试飞顺利，中国可能在2030年前实现六代机小批量生产和列装，并称2027年或2028年可能迎来量产型六代机入列。", "source": "中华网军事", "url": "", "snippet": "中华网军事预测，若六代机试飞顺利，中国可能在2030年前实现六代机小批量生产和列装，并称2027年或2028年可能迎来量产型六代机入列。", "date": "", "isSupplementary": false}, {"id": "fact_5637d364", "title": "中华网军事标题称未来五年歼-20有望达500架，但正文未给出可核验的官方依据。", "source": "中华网军事", "url": "", "snippet": "中华网军事标题称未来五年歼-20有望达500架，但正文未给出可核验的官方依据。", "date": "", "isSupplementary": false}, {"id": "fact_034aa7a7", "title": "腾讯网称，成飞应在从贵飞全部移交歼-10系列生产后开始全力生产歼-20系列，时间点约为2022年，并提到安装涡扇-15的完整版歼-20。", "source": "腾讯网", "url": "", "snippet": "腾讯网称，成飞应在从贵飞全部移交歼-10系列生产后开始全力生产歼-20系列，时间点约为2022年，并提到安装涡扇-15的完整版歼-20。", "date": "", "isSupplementary": false}, {"id": "fact_4e557a7f", "title": "搜索结果未提供成飞2028年各型号排产计划的官方文件、具体型号产量或交付时间表；也未提供歼-10CE等外贸型号的公开订单与2028交付节奏。", "source": "本次搜索结果综合", "url": "", "snippet": "搜索结果未提供成飞2028年各型号排产计划的官方文件、具体型号产量或交付时间表；也未提供歼-10CE等外贸型号的公开订单与2028交付节奏。", "date": "", "isSupplementary": false}, {"id": "fact_b56f1c27", "title": "搜索结果未包含国防预算、军贸政策、出口管制或关键供应链安全影响成飞2028排产的具体政策文件、预算报告或出口许可信息。", "source": "本次搜索结果综合", "url": "", "snippet": "搜索结果未包含国防预算、军贸政策、出口管制或关键供应链安全影响成飞2028排产的具体政策文件、预算报告或出口许可信息。", "date": "", "isSupplementary": false}, {"id": "fact_a13bc46f", "title": "中航成飞2025年度业绩说明会（投资者关系活动记录表编号2026-003）于2026年5月20日15:00-17:00通过全景网“投资者关系互动平台”以网络远程...", "source": "中财网（转载中航成飞公告节选）", "url": "", "snippet": "中航成飞2025年度业绩说明会（投资者关系活动记录表编号2026-003）于2026年5月20日15:00-17:00通过全景网“投资者关系互动平台”以网络远程方式召开；接待人员包括董事长隋少春、总经理蒋敏、董事会秘书兼副总经理肖峰、副总经理田刚。", "date": "", "isSupplementary": false}, {"id": "fact_5336f268", "title": "在上述2025年度业绩说明会上，投资者提问提到“一季报合同负债60.45亿元创阶段性新高”，并请求公司结合在手订单给出2026年全年营收增速大致指引范围。", "source": "中财网（转载中航成飞公告节选）", "url": "", "snippet": "在上述2025年度业绩说明会上，投资者提问提到“一季报合同负债60.45亿元创阶段性新高”，并请求公司结合在手订单给出2026年全年营收增速大致指引范围。", "date": "", "isSupplementary": false}, {"id": "fact_03a28501", "title": "公司在该业绩说明会回复中表示：当前我国国防和军队现代化建设已进入新的发展阶段，国防支出预算连续多年保持增长，为行业提供了坚实的资金保障；从中长期看，国防现代化建...", "source": "中财网（转载中航成飞公告节选）", "url": "", "snippet": "公司在该业绩说明会回复中表示：当前我国国防和军队现代化建设已进入新的发展阶段，国防支出预算连续多年保持增长，为行业提供了坚实的资金保障；从中长期看，国防现代化建设目标清晰、政策支撑明确，行业发展具有可持续性。", "date": "", "isSupplementary": false}, {"id": "fact_c653afb3", "title": "中财网显示中航成飞另有编号2026-004的投资者关系活动记录表（2026年5月27日），但公告节选省略余下内容，完整内容需查看交易所发布的PDF全文原文。", "source": "中财网（转载中航成飞公告节选）", "url": "", "snippet": "中财网显示中航成飞另有编号2026-004的投资者关系活动记录表（2026年5月27日），但公告节选省略余下内容，完整内容需查看交易所发布的PDF全文原文。", "date": "", "isSupplementary": false}, {"id": "fact_fd78ec5e", "title": "中航成飞在2024年度业绩说明会记录中称，公司是我国航空整机装备研制生产和出口的主要基地，先后研制生产枭龙、歼教-9、歼-10、歼-20等航空整机装备。", "source": "中财网（转载中航成飞公告节选）", "url": "", "snippet": "中航成飞在2024年度业绩说明会记录中称，公司是我国航空整机装备研制生产和出口的主要基地，先后研制生产枭龙、歼教-9、歼-10、歼-20等航空整机装备。", "date": "", "isSupplementary": false}, {"id": "fact_6f2a412f", "title": "中航成飞在2024年度业绩说明会记录中称，公司是民机零部件重要制造商，生产多型大飞机机头，具备完整的机头设计研发体系和航空大部件制造专业化优势，以及“产备修”一...", "source": "中财网（转载中航成飞公告节选）", "url": "", "snippet": "中航成飞在2024年度业绩说明会记录中称，公司是民机零部件重要制造商，生产多型大飞机机头，具备完整的机头设计研发体系和航空大部件制造专业化优势，以及“产备修”一体化能力。", "date": "", "isSupplementary": false}, {"id": "fact_8b7dee7f", "title": "中航成飞在2024年度业绩说明会记录中表示，公司坚持“航空为本、体系发展，自主创新、开放融合”发展方针，将持续建设军机研制生产和出口基地、航空大部件专业化制造基...", "source": "中财网（转载中航成飞公告节选）", "url": "", "snippet": "中航成飞在2024年度业绩说明会记录中表示，公司坚持“航空为本、体系发展，自主创新、开放融合”发展方针，将持续建设军机研制生产和出口基地、航空大部件专业化制造基地、军贸飞机专业化维修保障基地，并围绕核心业务、核心能力探索发展相关新业务。", "date": "", "isSupplementary": false}, {"id": "fact_a0621c3c", "title": "雪球页面仅转发中航成飞投资者关系活动记录表（2025年6月25日）和（2025年8月29日）的链接，搜索结果未提供这两份记录的正文内容。", "source": "雪球", "url": "", "snippet": "雪球页面仅转发中航成飞投资者关系活动记录表（2025年6月25日）和（2025年8月29日）的链接，搜索结果未提供这两份记录的正文内容。", "date": "", "isSupplementary": false}, {"id": "fact_e81a5bbf", "title": "本次搜索结果未包含成飞2028年各型号排产计划的具体型号、数量、时间表或官方披露；现有信息仅涉及历史型号谱系、业绩说明会问答、合同负债和国防预算政策背景。", "source": "本次搜索结果综合", "url": "", "snippet": "本次搜索结果未包含成飞2028年各型号排产计划的具体型号、数量、时间表或官方披露；现有信息仅涉及历史型号谱系、业绩说明会问答、合同负债和国防预算政策背景。", "date": "", "isSupplementary": false}]}}

