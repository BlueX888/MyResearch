data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:43:26.825166", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'指标': ['成飞并表单位', '科研骨干规模', '翼龙-3订单金额', '翼龙-3航程', '翼龙-3最大起飞重量', '翼龙-3挂载能力', '智能工厂入选批次', '设备24小时利用率', '单机床操作人员降幅', '产出效率提升'], '年份': [2025, 2025, 2024, 2024, 2024, 2024, 2025, 2025, 2025, 2026], '数值': [7, 5000, 60, 10000, 6, 2, 1, 80, 90, 1.5], '标签': ['7家', '5000人', '60+亿元', '10000km', '6+吨', '2吨', '首批', '>80%', '约90%', '1.5倍']}\ndf = pd.DataFrame(data)\ndf['指数'] = np.log10(df['数值']) / np.log10(df['数值'].max()) * 100\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\nplt.plot(x, df['指数'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2, zorder=3, label='综合能力指数')\nplt.fill_between(x, df['指数'], alpha=0.15, color='#6366f1')\ncolors = {2024: '#0ea5e9', 2025: '#8b5cf6', 2026: '#f59e0b'}\nfor yr, c in colors.items():\n    m = df['年份'] == yr\n    plt.scatter(x[m], df['指数'][m], s=140, color=c, edgecolor='white', linewidth=1.5, zorder=4, label=str(yr) + '年')\nfor i, v in enumerate(df['指数']):\n    plt.text(i, v + 4, df['标签'].iloc[i], ha='center', fontsize=10, fontweight='bold', color='#334155')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('核心竞争指标（按年份排序）', fontsize=14)\nplt.ylabel('归一化竞争力指数（0-100）', fontsize=14)\nplt.xticks(x, df['指标'], rotation=30, ha='right', fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 115)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=11, loc='upper left', frameon=True)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

