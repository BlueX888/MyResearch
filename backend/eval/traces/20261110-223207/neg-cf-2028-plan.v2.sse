data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:42:46.263512", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Model': ['歼-20', '歼-10CE', '歼-10C', '翼龙-3'], 'Plan2028': [130, 40, 20, 48]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Model':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\ntrend = {'Year': [2019, 2021, 2023, 2025, 2026, 2028], 'J20_Capacity': [15, 40, 100, 110, 120, 130]}\ndt = pd.DataFrame(trend)\ndt['J20_Capacity'] = pd.to_numeric(dt['J20_Capacity'], errors='coerce')\ndt = dt.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\ncolors = ['#6366f1', '#06b6d4', '#10b981', '#f59e0b']\nbars = axes[0].bar(df['Model'], df['Plan2028'], color=colors, edgecolor='white')\nfor b, v in zip(bars, df['Plan2028']):\n    axes[0].text(b.get_x() + b.get_width() / 2, v + 2, f'{int(v)}', ha='center', fontsize=12, fontweight='bold')\naxes[0].set_title('2028年成飞各型号排产估算（架）', fontsize=15, fontweight='bold', pad=15)\naxes[0].set_ylabel('计划产量（架）', fontsize=13)\naxes[0].tick_params(labelsize=11)\naxes[0].grid(True, linestyle='--', alpha=0.3)\naxes[1].plot(dt['Year'], dt['J20_Capacity'], linewidth=2.5, marker='o', markersize=8, color='#6366f1')\naxes[1].fill_between(dt['Year'], dt['J20_Capacity'], alpha=0.15, color='#6366f1')\naxes[1].set_title('歼-20产能爬坡与2028展望', fontsize=15, fontweight='bold', pad=15)\naxes[1].set_xlabel('年份', fontsize=13)\naxes[1].set_ylabel('年产能（架）', fontsize=13)\naxes[1].tick_params(labelsize=11)\naxes[1].grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "公开数据中并无成飞2028年官方排产计划，因此基于可用产能与订单线索做情景推演：①以歼-20年产能100+架/年、脉动线理论产能120架/年为锚，外推2028年歼-20排产约130架；②以歼-10CE累计签约150+架、翼龙-3吉达总装线48架/年产能，估算外贸与无人机排产；③用产能爬坡曲线展示2019—2028年歼-20产能演进，形成'型号结构柱状图+产能趋势折线图'的双面板专业图表。所有数值均标注为估算值。"}}

