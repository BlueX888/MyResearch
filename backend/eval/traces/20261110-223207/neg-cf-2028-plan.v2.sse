data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T23:35:53.257211", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "仅基于公开信息梳理军用航空装备更新需求、外贸军机市场及民机机头配套市场规模与增速，分析成飞相关型号的潜在需求背景，不涉及非公开排产数据。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 军机 市场需求 2028 公开信息;歼-20 歼-10CE 外贸 订单 公开;民机机头 C919 AG600 成飞 配套"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述成飞在航空工业体系内与沈飞、西飞等主机厂的分工，以及国际军机出口市场的竞争态势，分析竞争格局对成飞型号排产优先级的可能影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 沈飞 西飞 军机 分工 竞争;歼-10CE 枭龙 国际 军机 出口 竞争;成飞 航空工业 产能 布局 公开"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述隐身战机、无人协同、数字化制造和脉动生产线等核心技术趋势，分析技术升级对成飞多型号并行生产和2028年排产节奏的潜在影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 脉动生产线 数字化 制造 公开;歼-20 产能 技术 升级 公开;航空 智能制造 多型号 并行 生产"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、军贸政策、出口管制、供应链安全和航空工业规划等相关政策，分析政策环境对成飞2028年型号排产和交付节奏的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 2028 航空 装备 政策;军贸 出口 管制 政策 战斗机;航空工业 规划 成飞 产能 政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述成飞2028年排产面临的产能瓶颈、供应链安全、保密合规和外部出口限制等挑战，以及装备更新、外贸拓展和民机配套带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 产能 瓶颈 供应链 公开;军机 外贸 机遇 出口 限制;成飞 民机 配套 机遇 挑战"]}, {"id": "sec_6", "title": "未来展望", "description": "基于公开信息推断成飞2028年各型号排产的可能方向，重点分析产能建设、订单信号和政策走向，不涉及非公开生产计划，形成情景化展望。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 2028 产能 扩建 公开;歼-20 歼-10 枭龙 2028 交付 预测;成飞 排产 公开 信息 研究"]}], "research_questions": ["仅凭公开信息能否合理推断成飞2028年各型号排产方向？", "成飞产能扩建和供应链信号如何影响2028年多型号并行生产？", "国防预算、军贸政策和出口管制将如何改变成飞2028年型号交付优先级？"]}}

