le_crystal_blade", "relation": "制造"}, {"source": "casting_defect_control", "target": "single_crystal_blade", "relation": "提升"}, {"source": "dd_series", "target": "single_crystal_superalloy", "relation": "属于"}, {"source": "dd_series", "target": "single_crystal_blade", "relation": "用于"}, {"source": "rare_metals", "target": "single_crystal_superalloy", "relation": "限制"}, {"source": "tech_barrier", "target": "single_crystal_superalloy", "relation": "制约"}, {"source": "western_monopoly", "target": "aero_engine", "relation": "垄断"}, {"source": "western_monopoly", "target": "domestic_substitution", "relation": "倒逼"}, {"source": "government_policy", "target": "domestic_substitution", "relation": "推动"}, {"source": "government_policy", "target": "aero_engine", "relation": "减少依赖"}, {"source": "china_aero_engine_industry_chain", "target": "domestic_substitution", "relation": "支撑"}, {"source": "aero_engine_maintenance", "target": "aero_engine", "relation": "服务"}, {"source": "pre_research_weakness", "target": "domestic_substitution", "relation": "制约"}, {"source": "data_conflict", "target": "aero_engine", "relation": "影响"}, {"source": "single_crystal_superalloy", "target": "domestic_substitution", "relation": "支撑"}, {"source": "casting_defect_control", "target": "domestic_substitution", "relation": "支撑"}, {"source": "dd_series", "target": "domestic_substitution", "relation": "支撑"}]}, "stats": {"entities_count": 15, "relations_count": 22}}}

data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T22:57:04.008422", "content": {"charts": [{"id": "chart_001", "title": "中国航空发动机市场规模趋势", "subtitle": "2021-2023年（报告大厅口径，亿元）", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2021", "2022", "2023"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "line", "data": [400, 487, 600], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}}]}}, {"id": "chart_002", "title": "中国航空发动机市场规模：不同来源数据对比", "subtitle": "数据口径差异显著（亿元）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2020\n(原创力)", "2021\n(报告大厅)", "2022\n(报告大厅)", "2023\n(报告大厅)", "2025\n(原创力预测)"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "interval": 0, "fontSize": 11}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "bar", "data": [{"value": 1000, "itemStyle": {"color": "#fa8c16"}}, {"value": 400, "itemStyle": {"color": "#1677ff"}}, {"value": 487, "itemStyle": {"color": "#1677ff"}}, {"value": 600, "itemStyle": {"color": "#1677ff"}}, {"value": 1500, "itemStyle": {"color": "#fa8c16"}}], "barWidth": 40, "label": {"show": true, "position": "top", "color": "#666"}}]}}, {"id": "chart_003", "title": "单晶高温合金技术代际对比", "subtitle": "中国已开发第五代，但产业化能力待提升", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["全球最高\n代际", "全球批量\n生产", "中国具备\n生产能力", "中国已开发\n产品", "先进发动机\n应用较多"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "interval": 0, "fontSize": 11}}, "yAxis": {"type": "value", "name": "代际", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "min": 0, "max": 6}, "series": [{"type": "bar", "data": [{"value": 5, "itemStyle": {"color": "#1677ff"}}, {"value": 4, "itemStyle": {"color": "#1677ff"}}, {"value": 4, "itemStyle": {"color": "#52c41a"}}, {"value": 5, "itemStyle": {"color": "#52c41a"}}, {"value": 3, "itemStyle": {"color": "#722ed1"}}], "barWidth": 40, "label": {"show": true, "position": "top", "color": "#666"}}]}}, {"id": "chart_004", "title": "叶片精密数控加工周期对比", "subtitle": "国内周期显著长于国外（月）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "legend": {"data": ["下限", "上限"], "top": 0, "right": 0}, "xAxis": {"type": "category", "data": ["国内", "国外"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "月", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"name": "下限", "type": "bar", "data": [6, 3], "itemStyle": {"color": "#1677ff"}, "barWidth": 30, "label": {"show": true, "position": "top", "color": "#666"}}, {"name": "上限", "type": "bar", "data": [12, 6], "itemStyle": {"color": "#fa8c16"}, "barWidth": 30, "label": {"show": true, "position": "top", "color": "#666"}}]}}, {"id": "chart_005", "title": "八大主机厂上市平台关联情况", "subtitle": "产业证券化进展与未整合部分", "type": "pie", "echarts_option": {"series": [{"type": "pie", "radius": ["40%", "70%"], "center": ["50%", "50%"], "data": [{"value": 5, "name": "已注入/母公司", "itemStyle": {"color": "#1677ff"}}, {"value": 3, "name": "无关联上市平台", "itemStyle": {"color": "#fa8c16"}}], "label": {"show": true, "formatter": "{b}: {c}家 ({d}%)", "color": "#666"}, "emphasis": {"itemStyle": {"shadowBlur": 10, "shadowOffsetX": 0, "shadowColor": "rgba(0,0,0,0.5)"}}}]}}]}}

