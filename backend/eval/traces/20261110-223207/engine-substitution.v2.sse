data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T22:49:28.002397", "content": {"graph": {"nodes": [{"id": "node_0", "name": "中国航空发动机协会", "type": "organization", "discovered_at": "2026-11-10T22:49:21.288900"}, {"id": "node_1", "name": "中国航发集团（AECC）", "type": "company", "discovered_at": "2026-11-10T22:49:21.288911"}, {"id": "node_2", "name": "GE航空 / 赛峰 / 普惠 / 罗罗", "type": "company", "discovered_at": "2026-11-10T22:49:21.288917"}, {"id": "node_3", "name": "两机专项（航空发动机与燃气轮机重大专项）", "type": "policy", "discovered_at": "2026-11-10T22:49:21.288923"}, {"id": "node_4", "name": "航空发动机维修（MRO）后市场", "type": "technology", "discovered_at": "2026-11-10T22:49:21.288928"}, {"id": "node_5", "name": "通用航空维修市场", "type": "technology", "discovered_at": "2026-11-10T22:49:21.288936"}, {"id": "node_6", "name": "北京航空材料研究院", "type": "company", "discovered_at": "2026-11-10T22:49:27.753712"}, {"id": "node_7", "name": "央视新闻", "type": "company", "discovered_at": "2026-11-10T22:49:27.753722"}, {"id": "node_8", "name": "全球铁合金网", "type": "company", "discovered_at": "2026-11-10T22:49:27.753728"}, {"id": "node_9", "name": "新思界", "type": "company", "discovered_at": "2026-11-10T22:49:27.753735"}, {"id": "node_10", "name": "PCC（精密铸件公司）", "type": "company", "discovered_at": "2026-11-10T22:49:27.753741"}, {"id": "node_11", "name": "DD系列单晶高温合金", "type": "technology", "discovered_at": "2026-11-10T22:49:27.753753"}, {"id": "node_12", "name": "ReneN6", "type": "technology", "discovered_at": "2026-11-10T22:49:27.753762"}, {"id": "node_13", "name": "CMSX-10", "type": "technology", "discovered_at": "2026-11-10T22:49:27.753798"}, {"id": "node_14", "name": "PWA1480", "type": "technology", "discovered_at": "2026-11-10T22:49:27.753808"}, {"id": "node_15", "name": "单晶叶片典型铸造缺陷全过程控制技术", "type": "technology", "discovered_at": "2026-11-10T22:49:27.753815"}, {"id": "node_16", "name": "中国航发商用航空发动机有限责任公司（商发）", "type": "company", "discovered_at": "2026-11-10T22:49:28.002076"}, {"id": "node_17", "na