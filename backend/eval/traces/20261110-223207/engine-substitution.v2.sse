data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:57:32.436913", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'year_china': [2020, 2021, 2022, 2023, 2025], 'value_china': [1000, 400, 487, 600, 1500], 'year_global': [2023, 2029], 'value_global': [2424.11, 3478.46]}\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(data['year_china'], data['value_china'], marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='中国航空发动机市场规模')\nplt.fill_between(data['year_china'], data['value_china'], alpha=0.15, color='#6366f1')\nplt.plot(data['year_global'], data['value_global'], marker='s', markersize=8, linewidth=2.5, color='#f59e0b', label='全球航空发动机市场规模')\nplt.fill_between(data['year_global'], data['value_global'], alpha=0.15, color='#f59e0b')\nfor x, y in zip(data['year_china'], data['value_china']):\n    label = f'{y}'\n    if x == 2020:\n        label += '*'\n    if x == 2025:\n        label += '(预测)'\n    plt.text(x, y + 50, label, ha='center', fontsize=11, color='#6366f1')\nfor x, y in zip(data['year_global'], data['value_global']):\n    label = f'{y:.2f}'\n    if x == 2029:\n        label += '(预测)'\n    plt.text(x, y + 50, label, ha='center', fontsize=11, color='#f59e0b')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿元人民币）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12)\nplt.text(2020.5, 3200, '全球CAGR 5.64% (2023-2029)\\n民用占比80% / 军用20% (2023)\\n* 低置信度数据', fontsize=11, bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

