data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:04:20.475764", "content": {"results": [{"id": "fact_fd0d6402", "title": "由于历史原因，中国航空发动机研发长期以军用领域为主，民用航空发动机研发历史几乎为空白，目前国内大部分国产民用飞机装配的发动机均为进口产品。", "source": "前瞻网", "url": "", "snippet": "由于历史原因，中国航空发动机研发长期以军用领域为主，民用航空发动机研发历史几乎为空白，目前国内大部分国产民用飞机装配的发动机均为进口产品。", "date": "", "isSupplementary": true}, {"id": "fact_7be13937", "title": "中国航空发动机产业链包括研发设计、原材料毛坯制造、零部件加工制造、整机制造交付、运营维修等全部环节，研制和生产体系完整。", "source": "中研网", "url": "", "snippet": "中国航空发动机产业链包括研发设计、原材料毛坯制造、零部件加工制造、整机制造交付、运营维修等全部环节，研制和生产体系完整。", "date": "", "isSupplementary": true}, {"id": "fact_a5836ace", "title": "2023年全球与中国航空发动机市场规模分别为2424.11亿元（人民币）与463.97亿元；报告预计全球航空发动机市场规模在预测期以5.64%的CAGR增长，2...", "source": "万国企业网", "url": "", "snippet": "2023年全球与中国航空发动机市场规模分别为2424.11亿元（人民币）与463.97亿元；报告预计全球航空发动机市场规模在预测期以5.64%的CAGR增长，2029年达3478.46亿元。", "date": "", "isSupplementary": true}, {"id": "fact_7f595e26", "title": "航空发动机市场调研报告显示，2023年全球航空发动机市场规模达2424.11亿元（人民币），中国航空发动机市场规模达463.97亿元；报告同时给出2023年中国...", "source": "搜狐", "url": "", "snippet": "航空发动机市场调研报告显示，2023年全球航空发动机市场规模达2424.11亿元（人民币），中国航空发动机市场规模达463.97亿元；报告同时给出2023年中国航空发动机进口和出口金额，并预测2029年全球市场规模达3478.46亿元，预测期年均复合增长率5.64%。", "date": "", "isSupplementary": true}, {"id": "fact_21020def", "title": "2023年全球与中国航空发动机市场规模分别为2424.11亿元（人民币）与463.97亿元；航空发动机可细分为活塞、涡轮螺旋桨、涡轮轴、涡轮风扇等，军用飞机和民...", "source": "手机搜狐网", "url": "", "snippet": "2023年全球与中国航空发动机市场规模分别为2424.11亿元（人民币）与463.97亿元；航空发动机可细分为活塞、涡轮螺旋桨、涡轮轴、涡轮风扇等，军用飞机和民用飞机是主要应用领域。", "date": "", "isSupplementary": true}, {"id": "fact_8b0c0dc4", "title": "中商情报网给出不同口径数据：2022年中国航空发动机行业营收达312.6亿元，同比增长5.1%，预计2023年营收达344亿元；现有主要在役民用航空发动机中，活...", "source": "中商情报网", "url": "", "snippet": "中商情报网给出不同口径数据：2022年中国航空发动机行业营收达312.6亿元，同比增长5.1%，预计2023年营收达344亿元；现有主要在役民用航空发动机中，活塞发动机占比40%，涡扇、涡轴、涡桨发动机分别占比32%、14%、11%，其他类型占比3%。", "date": "", "isSupplementary": true}, {"id": "fact_1570c47d", "title": "2023年中国航空发动机行业产业链中，国内研发和制造主要由国有企业主导，国家航空发动机集团有限公司在产业发展中发挥关键作用；零部件主要由国内供应商提供，外购零部...", "source": "三个皮匠报告", "url": "", "snippet": "2023年中国航空发动机行业产业链中，国内研发和制造主要由国有企业主导，国家航空发动机集团有限公司在产业发展中发挥关键作用；零部件主要由国内供应商提供，外购零部件也占有一定份额，随着国有企业、民营企业等发动机制造企业加入，可能影响原有发动机供应链。", "date": "", "isSupplementary": true}, {"id": "fact_f488ade6", "title": "行业标准MH/T 6089-2012《航空燃气涡轮发动机寿命使用监控和部件管理指南》已废止，废止日期为2019-07-15；该标准发布日期为2012-10-10...", "source": "全国标准信息公共服务平台（国家市场监督管理总局）", "url": "", "snippet": "行业标准MH/T 6089-2012《航空燃气涡轮发动机寿命使用监控和部件管理指南》已废止，废止日期为2019-07-15；该标准发布日期为2012-10-10，实施日期为2012-12-20。", "date": "", "isSupplementary": true}, {"id": "fact_5c5be604", "title": "MH/T 6089-2012由中国民用航空局主管，中国民航科学技术研究院归口上报，主要起草单位为中航商用发动机有限公司（另一来源表述为中航商用航空发动机有限责任...", "source": "全国标准信息公共服务平台（国家市场监督管理总局）", "url": "", "snippet": "MH/T 6089-2012由中国民用航空局主管，中国民航科学技术研究院归口上报，主要起草单位为中航商用发动机有限公司（另一来源表述为中航商用航空发动机有限责任公司），主要起草人包括侯乃先、杨坤等。", "date": "", "isSupplementary": true}, {"id": "fact_afb63808", "title": "MH/T 6089-2012标准文本显示，其标准名称为《航空燃气涡轮发动机寿命使用监控和部件管理指南》，中国标准分类号V30，国际标准分类号49.050，由中国...", "source": "原创力文档", "url": "", "snippet": "MH/T 6089-2012标准文本显示，其标准名称为《航空燃气涡轮发动机寿命使用监控和部件管理指南》，中国标准分类号V30，国际标准分类号49.050，由中国民用航空局发布，起草单位为中航商用航空发动机有限责任公司，主要起草人包括侯乃先、杨坤、蔡宁泊、曾海军。", "date": "", "isSupplementary": true}, {"id": "fact_5f5ad442", "title": "MH/T 6089-2012备案号为38458-2013，备案公告为2013年第2号。", "source": "全国标准信息公共服务平台（国家市场监督管理总局）", "url": "", "snippet": "MH/T 6089-2012备案号为38458-2013，备案公告为2013年第2号。", "date": "", "isSupplementary": true}, {"id": "fact_dd2aa375", "title": "相关国际指南SAE AIR1872-1988《飞机燃气轮机发动机寿命使用监测和零件管理指南》已被代替，表明航空燃气涡轮发动机寿命使用监控与部件管理领域存在标准更...", "source": "分析测试百科网", "url": "", "snippet": "相关国际指南SAE AIR1872-1988《飞机燃气轮机发动机寿命使用监测和零件管理指南》已被代替，表明航空燃气涡轮发动机寿命使用监控与部件管理领域存在标准更新替代关系。", "date": "", "isSupplementary": true}, {"id": "fact_df02fc0e", "title": "学术研究指出，随着单元体设计与基于状态维修等理念发展，航空发动机限寿件使用寿命监视技术得到发展，涉及使用寿命监视概念、功能结构、关键技术和应用前景，并结合国内现...", "source": "淘豆网（《燃气涡轮试验与研究》论文）", "url": "", "snippet": "学术研究指出，随着单元体设计与基于状态维修等理念发展，航空发动机限寿件使用寿命监视技术得到发展，涉及使用寿命监视概念、功能结构、关键技术和应用前景，并结合国内现状提出开展使用寿命监视研究的建议。", "date": "", "isSupplementary": true}, {"id": "fact_6e8f218f", "title": "GJB 7795-2012《航空发动机外场使用寿命评定方法》规定了航空发动机外场使用寿命评定方法，适用于交付使用的航空发动机外场使用寿命评定。", "source": "分析测试百科网", "url": "", "snippet": "GJB 7795-2012《航空发动机外场使用寿命评定方法》规定了航空发动机外场使用寿命评定方法，适用于交付使用的航空发动机外场使用寿命评定。", "date": "", "isSupplementary": true}, {"id": "fact_35b50ef1", "title": "中国科学院沈阳分院发布信息称，金属所“先进动力系统用复杂粉末部件精确成型技术和应用”获2023年度辽宁省技术发明奖一等奖。", "source": "中国科学院沈阳分院", "url": "", "snippet": "中国科学院沈阳分院发布信息称，金属所“先进动力系统用复杂粉末部件精确成型技术和应用”获2023年度辽宁省技术发明奖一等奖。", "date": "", "isSupplementary": true}, {"id": "fact_4dbe749a", "title": "中国科学院金属所公示2023年度辽宁省科学技术奖拟提名项目，其中包括“先进动力系统用复杂粉末部件精确成形技术和应用”“航空发动机防护涂层的高温高速摩擦磨损机制”...", "source": "中国科学院金属研究所", "url": "", "snippet": "中国科学院金属所公示2023年度辽宁省科学技术奖拟提名项目，其中包括“先进动力系统用复杂粉末部件精确成形技术和应用”“航空发动机防护涂层的高温高速摩擦磨损机制”等项目，公示期为2024年2月1日至2月7日。", "date": "", "isSupplementary": true}, {"id": "fact_63e15416", "title": "一项电子束熔炼技术高纯化制备镍基高温合金的专利显示，该方法可降低合金中C、N、P、O等微量元素含量，将出成率提高至85%以上，把宏观偏析控制在极小范围，并实现大...", "source": "辽阳市科技创新服务平台", "url": "", "snippet": "一项电子束熔炼技术高纯化制备镍基高温合金的专利显示，该方法可降低合金中C、N、P、O等微量元素含量，将出成率提高至85%以上，把宏观偏析控制在极小范围，并实现大型铸锭工程化制备；专利号为CN201710756120.8，技术成熟度为“正在研发”。", "date": "", "isSupplementary": true}, {"id": "fact_fa0d26c7", "title": "沈阳铸造研究所有限公司“超大规格钛合金铸件铸造工艺”入选《中央企业科技创新成果推荐目录（2023年版）》，该成果涉及高纯净高均质成分调控等关键技术，先进性达国际...", "source": "沈阳铸造研究所有限公司", "url": "", "snippet": "沈阳铸造研究所有限公司“超大规格钛合金铸件铸造工艺”入选《中央企业科技创新成果推荐目录（2023年版）》，该成果涉及高纯净高均质成分调控等关键技术，先进性达国际领先水平。", "date": "", "isSupplementary": true}, {"id": "fact_fbee76d8", "title": "中国科学院金属研究所专利“镍基单晶高温合金精密铸造过程的再结晶倾向性评价方法”的申请号为201711019309.5，授权日期为2020年8月21日。", "source": "中国科学院金属研究所", "url": "", "snippet": "中国科学院金属研究所专利“镍基单晶高温合金精密铸造过程的再结晶倾向性评价方法”的申请号为201711019309.5，授权日期为2020年8月21日。", "date": "", "isSupplementary": true}, {"id": "fact_bb7e77f2", "title": "中国科学院金属研究所专利“一种性能优异的抗熔盐腐蚀的镍基高温合金”于2017年7月7日授权。", "source": "中国科学院金属研究所", "url": "", "snippet": "中国科学院金属研究所专利“一种性能优异的抗熔盐腐蚀的镍基高温合金”于2017年7月7日授权。", "date": "", "isSupplementary": true}]}}

