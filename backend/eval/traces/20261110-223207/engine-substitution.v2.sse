data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T22:48:58.164613", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述国产航空发动机市场规模、增速、军用与商用细分结构、国产化率及替代空间，区分整机、维修后市场和配套零部件市场。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["国产航空发动机 市场规模 增速 国产化率 军用 商用 维修后市场 2024 2025"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述中国航发集团、商发、航发动力、中航重机等整机与配套企业格局，分析国际寡头垄断、民企配套进入和细分环节竞争态势。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["航空发动机 竞争格局 中国航发 商发 航发动力 中航重机 民营企业 配套 国际寡头"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述核心机、涡扇/涡轴/涡桨发动机、高温合金、单晶叶片、FADEC、适航取证、可靠性与寿命验证等核心技术进展及国产化难点。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空发动机 核心技术 高温合金 单晶叶片 FADEC 适航取证 可靠性 寿命 国产替代"]}, {"id": "sec_4", "title": "政策环境", "description": "描述两机专项、航空强国、军民融合、适航审定、自主可控和出口管制等政策对国产航空发动机替代的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空发动机 政策 两机专项 军民融合 适航审定 出口管制 自主可控"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述适航认证、可靠性验证、材料工艺、供应链安全、国际制裁等挑战，以及军机换发、商用飞机配套、维修后市场和自主可控带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国产航空发动机 挑战 风险 适航认证 供应链 制裁 机遇 军机换发 C919 维修后市场"]}, {"id": "sec_6", "title": "未来展望", "description": "描述国产航空发动机分阶段替代路径、军用与商用替代节奏、2030—2035年发展展望及关键风险监测指标。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国产航空发动机 未来展望 替代路径 2030 2035 军用 商用 风险监测"]}], "research_questions": ["国产航空发动机在军用和商用领域的替代进展与国产化率如何？", "制约国产替代的关键技术、适航认证与供应链风险有哪些？", "政策支持与外部出口管制将如何影响未来5—10年国产航空发动机替代节奏？"]}}

