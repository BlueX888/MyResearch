data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:57:39.886725", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ncn_years = [2020, 2021, 2022, 2023, 2025]\ncn_values = [1000, 400, 487, 600, 1500]\ngl_years = [2023, 2029]\ngl_values = [2424.11, 3478.46]\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(cn_years, cn_values, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='中国航空发动机市场规模')\nplt.fill_between(cn_years, cn_values, alpha=0.15, color='#6366f1')\nplt.plot(gl_years, gl_values, color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='全球航空发动机市场规模')\nplt.fill_between(gl_years, gl_values, alpha=0.15, color='#f59e0b')\nfor x, y in zip(cn_years, cn_values):\n    plt.text(x, y + 70, str(y), ha='center', fontsize=11, color='#4338ca', fontweight='bold')\nfor x, y in zip(gl_years, gl_values):\n    plt.text(x, y + 70, f'{y:.0f}', ha='center', fontsize=11, color='#b45309', fontweight='bold')\nplt.annotate('预测值', xy=(2025, 1500), xytext=(2024.2, 1750), fontsize=11, color='#4338ca', arrowprops=dict(arrowstyle='->', color='#4338ca', alpha=0.6))\nplt.annotate('预测值', xy=(2029, 3478.46), xytext=(2027.6, 3300), fontsize=11, color='#b45309', arrowprops=dict(arrowstyle='->', color='#b45309', alpha=0.6))\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿元人民币）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left', frameon=True)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

