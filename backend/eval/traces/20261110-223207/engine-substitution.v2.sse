data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T22:54:44.486281", "content": {"results": [{"id": "fact_db95859a", "title": "新浪财经转CCTV4报道，中国工程院院士张彦仲称长江1000A发动机研发进展顺利。", "source": "新浪财经/财经头条（引CCTV4）", "url": "", "snippet": "新浪财经转CCTV4报道，中国工程院院士张彦仲称长江1000A发动机研发进展顺利。", "date": "", "isSupplementary": false}, {"id": "fact_7e399dea", "title": "中国航发商发研制的CJ-1000AX验证机首台整机在上海点火成功，核心机转速最高达到6600rpm；2017年12月完成首台整机装配，2018年3月30日完成全...", "source": "浙江在线时政频道（引述中国航发商发消息）", "url": "", "snippet": "中国航发商发研制的CJ-1000AX验证机首台整机在上海点火成功，核心机转速最高达到6600rpm；2017年12月完成首台整机装配，2018年3月30日完成全部调试并通过试验前评审。", "date": "", "isSupplementary": false}, {"id": "fact_d2e960ac", "title": "2016年12月，中国航发商发与商飞签订C919飞机系列动力装置意向书，被正式确认为C919国内动力装置提供商；2017年4月向中国民用航空适航审定中心递交CJ...", "source": "浙江在线时政频道（引述中国航发商发消息）", "url": "", "snippet": "2016年12月，中国航发商发与商飞签订C919飞机系列动力装置意向书，被正式确认为C919国内动力装置提供商；2017年4月向中国民用航空适航审定中心递交CJ-1000A项目适航工作联系函。", "date": "", "isSupplementary": false}, {"id": "fact_5bd775bb", "title": "中国航发商发遵循“主制造商-供应商”模式，已有110多家全球合作伙伴参与中国商用航空发动机产业，涉及产品研发、制造、原材料以及试验测试等领域。", "source": "浙江在线时政频道（引述中国航发商发消息）", "url": "", "snippet": "中国航发商发遵循“主制造商-供应商”模式，已有110多家全球合作伙伴参与中国商用航空发动机产业，涉及产品研发、制造、原材料以及试验测试等领域。", "date": "", "isSupplementary": false}, {"id": "fact_55757dfb", "title": "官方通稿评论称，航空发动机研制技术难度大、风险高、投入多、周期长，商用航空发动机已成为中国大飞机产业发展亟待突破的瓶颈。", "source": "浙江在线时政频道（引述中国航发商发消息）", "url": "", "snippet": "官方通稿评论称，航空发动机研制技术难度大、风险高、投入多、周期长，商用航空发动机已成为中国大飞机产业发展亟待突破的瓶颈。", "date": "", "isSupplementary": false}, {"id": "fact_c8977d12", "title": "网易订阅文章称，中航商发10月9日组织召开“加速推进CJ-1000A商用航发适航取证”工作动员会，CJ-1000A产品开发团队和适航取证团队参加；文章称最快本月...", "source": "网易订阅", "url": "", "snippet": "网易订阅文章称，中航商发10月9日组织召开“加速推进CJ-1000A商用航发适航取证”工作动员会，CJ-1000A产品开发团队和适航取证团队参加；文章称最快本月底开始适航取证，但未给出明确年份。", "date": "", "isSupplementary": false}, {"id": "fact_ebe87e40", "title": "网易订阅文章梳理CJ-1000A时间线称：2012年珠海航展首次展示全尺寸模型，2017年完成设计评审，2018年完成首次点火测试，2019年下半年开始全面地面...", "source": "网易订阅", "url": "", "snippet": "网易订阅文章梳理CJ-1000A时间线称：2012年珠海航展首次展示全尺寸模型，2017年完成设计评审，2018年完成首次点火测试，2019年下半年开始全面地面航发测试。", "date": "", "isSupplementary": false}, {"id": "fact_f27574a0", "title": "腾讯新闻文章称，CJ-1000A取证试飞试验首次飞行圆满成功，横幅日期为2026年6月30日，试验载机为改装后的运-20空中试验平台；该日期晚于当前可核验时间且...", "source": "腾讯新闻", "url": "", "snippet": "腾讯新闻文章称，CJ-1000A取证试飞试验首次飞行圆满成功，横幅日期为2026年6月30日，试验载机为改装后的运-20空中试验平台；该日期晚于当前可核验时间且未见官方来源，真实性存疑。", "date": "", "isSupplementary": false}, {"id": "fact_5ab2d862", "title": "腾讯新闻文章称，CJ-1000A已进入民航局监督下的适航取证阶段，设计制造基本冻结；取证试飞需检验高空启动、进气畸变、防冰系统与FADEC全权限数字控制系统故障...", "source": "腾讯新闻", "url": "", "snippet": "腾讯新闻文章称，CJ-1000A已进入民航局监督下的适航取证阶段，设计制造基本冻结；取证试飞需检验高空启动、进气畸变、防冰系统与FADEC全权限数字控制系统故障容错能力。", "date": "", "isSupplementary": false}, {"id": "fact_1ba87323", "title": "腾讯新闻文章称，CJ-1000A升空前需完成吞鸟、吞冰、风扇叶片断裂包容性、长时间超负荷耐久等严苛地面测试；取证试飞数据将作为申领型号合格证TC的法定依据。", "source": "腾讯新闻", "url": "", "snippet": "腾讯新闻文章称，CJ-1000A升空前需完成吞鸟、吞冰、风扇叶片断裂包容性、长时间超负荷耐久等严苛地面测试；取证试飞数据将作为申领型号合格证TC的法定依据。", "date": "", "isSupplementary": false}, {"id": "fact_bb776bf8", "title": "今日头条文章称，CJ-1000A取证试飞依托专门改造的运-20空中试验台，试飞院对左侧内侧挂架进行加固和气动外形修改；文章还称C919依赖进口航发、供应链受制于...", "source": "今日头条", "url": "", "snippet": "今日头条文章称，CJ-1000A取证试飞依托专门改造的运-20空中试验台，试飞院对左侧内侧挂架进行加固和气动外形修改；文章还称C919依赖进口航发、供应链受制于人。", "date": "", "isSupplementary": false}, {"id": "fact_73cb7f7a", "title": "风闻帖文声称CJ-1000A已可用、装机C919飞行通过，并由民航局颁发单机适航证即可投入商业运营；该说法与CJ-1000A仍处适航取证阶段的公开信息矛盾，且未...", "source": "风闻", "url": "", "snippet": "风闻帖文声称CJ-1000A已可用、装机C919飞行通过，并由民航局颁发单机适航证即可投入商业运营；该说法与CJ-1000A仍处适航取证阶段的公开信息矛盾，且未提供官方来源，可信度低。", "date": "", "isSupplementary": false}, {"id": "fact_5099f1a5", "title": "风闻帖文称，全球首架B-919A于2022年12月26日启动100小时验证飞行，覆盖9省市10座机场，至2023年2月中旬完成；该信息为C919飞机验证飞行，并...", "source": "风闻", "url": "", "snippet": "风闻帖文称，全球首架B-919A于2022年12月26日启动100小时验证飞行，覆盖9省市10座机场，至2023年2月中旬完成；该信息为C919飞机验证飞行，并非CJ-1000A装机取证。", "date": "", "isSupplementary": false}, {"id": "fact_1e4cdf42", "title": "中国民航局发布《民用航空器(发动机、螺旋桨)型号合格证/型号认可证(TC/VTC)核发》指南，适用于TC/VTC申请；TC受理和决定机构为中国民航局或民航地区管...", "source": "中国民用航空局", "url": "", "snippet": "中国民航局发布《民用航空器(发动机、螺旋桨)型号合格证/型号认可证(TC/VTC)核发》指南，适用于TC/VTC申请；TC受理和决定机构为中国民航局或民航地区管理局，VTC决定机构为中国民航局。", "date": "", "isSupplementary": false}, {"id": "fact_f3a4fbdb", "title": "TC申请人应具有民用航空产品设计能力；VTC申请人应持有或正在申请其所在国局方颁发的型号设计批准，并且两国之间已经签署能涵盖该民用航空产品的适航协议、备忘录或技...", "source": "中国民用航空局", "url": "", "snippet": "TC申请人应具有民用航空产品设计能力；VTC申请人应持有或正在申请其所在国局方颁发的型号设计批准，并且两国之间已经签署能涵盖该民用航空产品的适航协议、备忘录或技术性协议。", "date": "", "isSupplementary": false}, {"id": "fact_71ed0d42", "title": "TC申请材料依据《航空器型号合格审定程序》(AP-21-03)和《民用航空产品和零部件合格审定规定》(CCAR-21)第21.15条，需提交申请书、航空器型号设...", "source": "中国民用航空局", "url": "", "snippet": "TC申请材料依据《航空器型号合格审定程序》(AP-21-03)和《民用航空产品和零部件合格审定规定》(CCAR-21)第21.15条，需提交申请书、航空器型号设计特征、三面图、基本数据和审定计划(CP)等。", "date": "", "isSupplementary": false}, {"id": "fact_8a6bb900", "title": "民航局航空器适航审定司就中国航发商发CJ-1000A型发动机三份专用条件征求意见；依据CCAR-21第21.16条，基于该型发动机型号设计特征和商发申请，拟颁发...", "source": "中国民用航空局", "url": "", "snippet": "民航局航空器适航审定司就中国航发商发CJ-1000A型发动机三份专用条件征求意见；依据CCAR-21第21.16条，基于该型发动机型号设计特征和商发申请，拟颁发三份专用条件，意见征集期为15个工作日。", "date": "", "isSupplementary": false}, {"id": "fact_2069c0d3", "title": "CJ-1000A三份专用条件征求意见稿附件分别为：PSC-33-006《CJ-1000A型发动机复合材料风扇叶片》、PSC-33-007《CJ-1000A型发动...", "source": "中国民用航空局", "url": "", "snippet": "CJ-1000A三份专用条件征求意见稿附件分别为：PSC-33-006《CJ-1000A型发动机复合材料风扇叶片》、PSC-33-007《CJ-1000A型发动机风扇、压气机和涡轮转子完整性》、PSC-33-008《CJ-1000A型发动机过冷大水滴、混合相、冰晶及扬雪降雪结冰条件》。", "date": "", "isSupplementary": false}, {"id": "fact_7f6e58e8", "title": "本次搜索结果中未出现CJ-1000A型号合格证(TC)已核发的公告；可见的TC数据单为Y7-100、Y7H-500、Y7-200A、MA60、MA600、MA6...", "source": "中国民用航空局", "url": "", "snippet": "本次搜索结果中未出现CJ-1000A型号合格证(TC)已核发的公告；可见的TC数据单为Y7-100、Y7H-500、Y7-200A、MA60、MA600、MA600F，编号TC0015A，版次16，日期2018年12月14日，持有人为中航西飞民用飞机有限责任公司。", "date": "", "isSupplementary": false}, {"id": "fact_13807995", "title": "中国民航局发布《型号合格审定程序》，文号AP-21-11R2，办文单位为航空器适航审定司，有效性为有效；页面显示发文日期为2026-06-25，该日期异常，需进...", "source": "中国民用航空局", "url": "", "snippet": "中国民航局发布《型号合格审定程序》，文号AP-21-11R2，办文单位为航空器适航审定司，有效性为有效；页面显示发文日期为2026-06-25，该日期异常，需进一步核验。", "date": "", "isSupplementary": false}]}}

