data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:57:13.885083", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2021, 2022, 2023, 2025], 'China_Size': [400, 487, 600, 1500]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nplt.figure(figsize=(12, 7), dpi=200)\nax1 = plt.subplot(1, 2, 1)\nax1.plot(df['Year'], df['China_Size'], linewidth=2.5, marker='o', markersize=8, color='#6366f1')\nax1.fill_between(df['Year'], df['China_Size'], alpha=0.15, color='#6366f1')\nfor x, y in zip(df['Year'], df['China_Size']):\n    ax1.annotate(f'{y}', (x, y), textcoords='offset points', xytext=(0, 10), ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nax1.set_title('中国航发市场规模（2025为预测）', fontsize=15, fontweight='bold', pad=15)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('市场规模（亿元）', fontsize=14)\nax1.tick_params(labelsize=12)\nax1.grid(True, linestyle='--', alpha=0.3)\nax2 = plt.subplot(1, 2, 2)\nlabels = ['军用单晶叶片国产化率', 'CJ-1000A叶片国产化率', '外资在华民航叶片份额', '高端高温合金供给缺口', '中国全球研发投入占比']\nvals = [70, 20, 85, 30, 1]\ncolors = ['#10b981', '#f59e0b', '#ef4444', '#ef4444', '#6366f1']\nbars = ax2.barh(labels, vals, color=colors, height=0.6)\nfor b, v in zip(bars, vals):\n    ax2.text(v + 1.5, b.get_y() + b.get_height() / 2, f'{v}%', va='center', fontsize=12, fontweight='bold')\nax2.set_xlim(0, 100)\nax2.set_title('国产化进展与风险敞口', fontsize=15, fontweight='bold', pad=15)\nax2.set_xlabel('百分比（%）', fontsize=14)\nax2.tick_params(labelsize=11)\nax2.grid(True, linestyle='--', alpha=0.3, axis='x')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从数据中提取三条主线：(1) 中国航发市场规模 2021-2023 实际值及 2025 预测值，展示国产替代带动的内需扩张；(2) 国产化进展与风险敞口对比——军用单晶叶片国产化率>70%（进展良好）、CJ-1000A 民用叶片国产化率<20%、外资在华民航叶片份额>85%、高端高温合金供给缺口30%、中国全球研发投入占比仅1%（核心风险）；(3) 通过左右双面板组合图，直观呈现'军用突破快、民用受制于人'的结构性特征。数据经 to_numeric 转换与 dropna 清洗，图表采用靛蓝/翡翠绿/警示红专业配色。"}}

