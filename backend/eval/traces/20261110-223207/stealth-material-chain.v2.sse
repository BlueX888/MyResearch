data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:14:31.087251", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2021, 2024, 2025], 'Value': [10.4, 8.46, 9.36], 'Label': ['合计营收', '合计净利润', '光启超材料收入']}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['Value'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='关键规模指标')\nplt.fill_between(df['Year'], df['Value'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['Value']):\n    plt.text(df['Year'][i], v + 0.35, f'{v}亿元', ha='center', fontsize=11, fontweight='bold', color='#1e293b')\n    plt.text(df['Year'][i], v - 0.9, df['Label'][i], ha='center', fontsize=10, color='#64748b')\nplt.text(2021.5, 11.2, '2018-2021营收CAGR: 83%', fontsize=11, color='#ef4444', fontweight='bold')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('金额（亿元）', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 12.5)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

