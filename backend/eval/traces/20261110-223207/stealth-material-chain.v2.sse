data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T23:05:12.132097", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述全球及中国隐身材料与超材料市场规模、增速、细分结构（雷达吸波、红外隐身、结构隐身、超材料/超表面）及主要应用领域。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["隐身材料 超材料 市场规模 增速 军工 应用 2024 2025"]}, {"id": "sec_2", "title": "竞争格局", "description": "梳理国内外核心供应商、上市公司及其产品布局、客户关系、产能和市场份额，重点分析光启技术、华秦科技、佳驰科技、中航高科、菲利华、悦安新材等。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["隐身材料 上市公司 核心供应商 光启技术 华秦科技 佳驰科技 超材料 供应链"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述雷达吸波材料、红外隐身材料、结构隐身复合材料、电磁超材料、超表面、频率选择表面及多频谱兼容隐身等核心技术路线和产业化进展。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["雷达吸波材料 红外隐身 结构隐身 超材料 超表面 频率选择表面 技术趋势"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防装备现代化、自主可控、军民融合、出口管制、新材料产业政策及国际技术封锁对隐身材料与超材料供应链的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["隐身材料 超材料 政策 国防 自主可控 出口管制 军民融合 新材料"]}, {"id": "sec_5", "title": "挑战机遇", "description": "分析行业面临的技术验证周期长、原材料与设备依赖、成本高、保密约束等挑战，以及装备升级、国产替代、低空经济和商业航天带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["隐身材料 超材料 挑战 机遇 国产替代 成本 原材料 装备升级"]}, {"id": "sec_6", "title": "未来展望", "description": "展望多频谱隐身、智能隐身、超材料规模化制造、供应链国产化和国际竞争格局演变趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["隐身材料 超材料 未来趋势 多频谱 智能隐身 规模化 国产化"]}], "research_questions": ["隐身材料与超材料供应链各环节的核心供应商和上市公司分别有哪些", "关键原材料、工艺设备和下游客户是否存在卡脖子或进口依赖", "未来3至5年哪些技术路线和上市公司最受益于装备隐身化与超材料产业化"]}}

