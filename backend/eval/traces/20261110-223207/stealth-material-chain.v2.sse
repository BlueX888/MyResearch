data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T23:13:59.190078", "content": {"charts": [{"id": "chart_001", "title": "隐身材料技术分类数量对比", "subtitle": "不同分类维度下的类别数量（类）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["按探测系统", "按探测手段", "按产品类型", "按应用领域", "雷达吸波材料类型", "雷达隐身复合材料", "按用途", "主要发展方向"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "interval": 0, "rotate": 30}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "bar", "data": [6, 5, 5, 6, 4, 2, 2, 2], "barWidth": 20, "itemStyle": {"color": "#1677ff"}, "label": {"show": true, "position": "top", "color": "#666"}}]}}, {"id": "chart_002", "title": "核心上市公司净利润对比", "subtitle": "2024年前三季度净利润（亿元）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["光启技术", "华秦科技"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "bar", "data": [{"value": 5.37, "itemStyle": {"color": "#1677ff"}}, {"value": 3.09, "itemStyle": {"color": "#52c41a"}}], "barWidth": 40, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#666"}}]}}, {"id": "chart_003", "title": "核心上市公司流通市值对比", "subtitle": "2024年流通市值（亿元）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["光启技术", "华秦科技"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "bar", "data": [{"value": 673, "itemStyle": {"color": "#722ed1"}}, {"value": 48, "itemStyle": {"color": "#fa8c16"}}], "barWidth": 40, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#666"}}]}}, {"id": "chart_004", "title": "隐身材料行业营收CAGR", "subtitle": "2018-2021年华秦科技与光启技术合计营收复合增长率", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "20%", "right": "15%", "top": "5%", "bottom": "5%"}, "xAxis": {"type": "value", "show": false, "max": 100}, "yAxis": {"type": "category", "data": ["CAGR"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 83, "itemStyle": {"color": "#1677ff"}}], "barWidth": 20, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#666"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}]}}

