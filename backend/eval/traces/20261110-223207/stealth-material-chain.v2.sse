": "node_37", "name": "超材料技术", "type": "technology", "discovered_at": "2026-11-10T23:05:51.231763"}, {"id": "node_38", "name": "隐身涂层材料", "type": "technology", "discovered_at": "2026-11-10T23:05:51.231775"}, {"id": "node_39", "name": "低频超宽带吸波材料", "type": "technology", "discovered_at": "2026-11-10T23:05:51.231786"}], "edges": [{"source": "雷达吸波材料", "relation": "属于雷达隐身技术核心路线", "discovered_at": "2026-11-10T23:05:35.816635"}, {"source": "雷达吸波材料", "relation": "与频率选择表面复合使用", "discovered_at": "2026-11-10T23:05:35.816640"}, {"source": "红外隐身材料", "relation": "与雷达隐身构成多频谱兼容隐身需求", "discovered_at": "2026-11-10T23:05:35.816649"}, {"source": "结构隐身复合材料", "relation": "与涂敷型隐身材料并列的两大材料形态", "discovered_at": "2026-11-10T23:05:35.816657"}, {"source": "频率选择表面（FSS）", "relation": "与低厚度吸波涂层复合实现宽频段表面波衰减", "discovered_at": "2026-11-10T23:05:35.816669"}, {"source": "多频谱/多频段兼容隐身", "relation": "被列为吸波材料主要发展方向之一", "discovered_at": "2026-11-10T23:05:35.816680"}, {"source": "智能型隐身材料", "relation": "被列为吸波材料主要发展方向之一", "discovered_at": "2026-11-10T23:05:35.816689"}, {"source": "铁氧体/金属微粉/纳米/多晶铁纤维吸波剂", "relation": "雷达吸波材料主要材料体系", "discovered_at": "2026-11-10T23:05:35.816699"}, {"source": "RCS伴随优化设计", "relation": "吸波材料与外形一体化隐身设计方法", "discovered_at": "2026-11-10T23:05:35.816710"}, {"source": "桑建华《飞行器隐身技术》", "relation": "隐身技术领域权威专著作者，航空工业出版社2013", "discovered_at": "2026-11-10T23:05:35.816719"}, {"source": "姬金祖《隐身原理》", "relation": "隐身原理专著作者，北航出版社2018", "discovered_at": "2026-11-10T23:05:35.816729"}, {"source": "雷达隐身材料", "relation": "隐身材料主要细分品类", "discovered_at": "2026-11-10T23:05:38.629207"}, {"source": "雷达隐身材料", "relation": "应用于隐身战机、舰船、导弹", "discovered_at": "2026-11-10T23:05:38.629212"}, {"source": "可见光/激光隐身材料", "relation": "隐身材料细分品类", "discovered_at": "2026-11-10T23:05:38.629222"}, {"source": "可见光/激光隐身材料", "relation": "多频谱隐身发展方向", "discovered_at": "2026-11-10T23:05:38.629226"}, {"source": "超材料（metamaterial）", "relation": "隐身材料技术路线之一", "discovered_at": "2026-11-10T23:05:38.629234"}, {"source": "超材料（metamaterial）", "relation": "被列为国家战略性新兴产业方向", "discovered_at": "2026-11-10T23:05:38.629238"}, {"source": "隐身战机/舰船/导弹/无人机/航天器", "relation": "隐身材料主要应用领域", "discovered_at": "2026-11-10T23:05:38.629248"}, {"source": "隐身战机/舰船/导弹/无人机/航天器", "relation": "军费与装备采购的传导环节", "discovered_at": "2026-11-10T23:05:38.629252"}, {"source": "智信中科研究网", "relation": "行业报告出版机构", "discovered_at": "2026-11-10T23:05:38.629260"}, {"source": "智信中科研究网", "relation": "可能持有全球隐身材料规模原始数据", "discovered_at": "2026-11-10T23:05:38.629264"}, {"source": "中研智业研究院", "relation": "行业报告出版机构", "discovered_at": "2026-11-10T23:05:38.629274"}, {"source": "中研智业研究院", "relation": "中国隐身材料（超材料）市场预测报告出版方", "discovered_at": "2026-11-10T23:05:38.629278"}, {"source": "中赢信合研究网", "relation": "行业报告出版机构", "discovered_at": "2026-11-10T23:05:38.629289"}, {"source": "中赢信合研究网", "relation": "竞争格局与投资盈利分析报告出版方", "discovered_at": "2026-11-10T23:05:38.629293"}, {"source": "光启技术", "relation": "002625", "discovered_at": "2026-11-10T23:05:51.231566"}, {"source": "光启技术", "relation": "超材料航空/海洋结构件", "discovered_at": "2026-11-10T23:05:51.231571"}, {"source": "光启技术", "relation": "国内唯一超材料规模化应用于尖端装备", "discovered_at": "2026-11-10T23:05:51.231574"}, {"source": "光启技术", "relation": "2025H1超材料收入9.36亿元", "discovered_at": "2026-11-10T23:05:51.231576"}, {"source": "光启技术", "relation": "与华秦科技、佳驰科技构成国内隐身材料三强", "discovered_at": "2026-11-10T23:05:51.231579"}, {"source": "华秦科技", "relation": "688281", "discovered_at": "2026-11-10T23:05:51.231589"}, {"source": "华秦科技", "relation": "隐身涂层+结构隐身材料", "discovered_at": "2026-11-10T23:05:51.231593"}, {"source": "华秦科技", "relation": "全温域覆盖、中高温优势", "discovered_at": "2026-11-10T23:05:51.231595"}, {"source": "华秦科技", "relation": "2025年3月股份解禁", "discovered_at": "2026-11-10T23:05:51.231599"}, {"source": "华秦科技", "relation": "与光启技术并列为A股两家隐身材料公司", "discovered_at": "2026-11-10T23:05:51.231602"}, {"source": "佳驰科技", "relation": "吸波贴片/泡沫/蜂窝", "discovered_at": "2026-11-10T23:05:51.231609"}, {"source": "佳驰科技", "relation": "低频超宽带多频谱兼容", "discovered_at": "2026-11-10T23:05:51.231613"}, {"source": "佳驰科技", "relation": "拟上市（2023年时点）", "discovered_at": "2026-11-10T23:05:51.231624"}, {"source": "中航高科", "relation": "被前瞻网列入超材料相关上市公司名单", "discovered_at": "2026-11-10T23:05:51.231631"}, {"source": "中航高科", "relation": "航空复合材料预浸料（待验证与隐身结构件关系）", "discovered_at": "2026-11-10T23:05:51.231634"}, {"source": "菲利华", "relation": "石英纤维/石英玻璃，潜在隐身结构材料上游（本轮搜索无直接证据）", "discovered_at": "2026-11-10T23:05:51.231642"}, {"source": "悦安新材", "relation": "羰基铁粉，潜在吸波剂上游（本轮搜索无直接证据）", "discovered_at": "2026-11-10T23:05:51.231650"}, {"source": "天和防务", "relation": "300397", "discovered_at": "2026-11-10T23:05:51.231657"}, {"source": "天和防务", "relation": "被前瞻网列为超材料行业主要上市公司", "discovered_at": "2026-11-10T23:05:51.231660"}, {"source": "航天发展", "relation": "注册资本近16亿元，超材料上市公司之一", "discovered_at": "2026-11-10T23:05:51.231668"}, {"source": "民士达", "relation": "被列入超材料相关上市公司对比表", "discovered_at": "2026-11-10T23:05:51.231676"}, {"source": "中复神鹰", "relation": "碳纤维，被列入超材料相关上市公司对比表", "discovered_at": "2026-11-10T23:05:51.231684"}, {"source": "铂力特", "relation": "增材制造，被列入超材料相关上市公司对比表", "discovered_at": "2026-11-10T23:05:51.231691"}, {"source": "华曙高科", "relation": "增材制造设备，被列入超材料相关上市公司对比表", "discovered_at": "2026-11-10T23:05:51.231699"}, {"source": "华正新材", "relation": "覆铜板/高频材料，被列入超材料相关上市公司对比表", "discovered_at": "2026-11-10T23:05:51.231706"}, {"source": "南亚新材", "relation": "高频高速覆铜板，被列入超材料相关上市公司对比表", "discovered_at": "2026-11-10T23:05:51.231713"}, {"source": "中航沈飞", "relation": "下游主机厂，隐身材料终端客户（待验证）", "discovered_at": "2026-11-10T23:05:51.231720"}, {"source": "海格通信", "relation": "被列入超材料下游应用上市公司", "discovered_at": "2026-11-10T23:05:51.231728"}, {"source": "四创电子", "relation": "雷达整机，被列入超材料下游应用上市公司", "discovered_at": "2026-11-10T23:05:51.231736"}, {"source": "盛路通信", "relation": "天线/微波，被列入超材料下游应用上市公司", "discovered_at": "2026-11-10T23:05:51.231744"}, {"source": "中国卫星", "relation": "被列入超材料下游应用上市公司", "discovered_at": "2026-11-10T23:05:51.231751"}, {"source": "国家国防科技工业局", "relation": "2016年对华秦科技隐身材料出具技术鉴定结论", "discovered_at": "2026-11-10T23:05:51.231759"}, {"source": "超材料技术", "relation": "通过微观结构设计实现超常电磁性能", "discovered_at": "2026-11-10T23:05:51.231767"}, {"source": "超材料技术", "relation": "光启技术核心路线", "discovered_at": "2026-11-10T23:05:51.231771"}, {"source": "隐身涂层材料", "relation": "华秦科技、佳驰科技主要产品形态", "discovered_at": "2026-11-10T23:05:51.231779"}, {"source": "隐身涂层材料", "relation": "需定期补涂", "discovered_at": "2026-11-10T23:05:51.231782"}, {"source": "低频超宽带吸波材料", "relation": "佳驰科技核心技术方向", "discovered_at": "2026-11-10T23:05:51.231789"}, {"source": "低频超宽带吸波材料", "relation": "多频谱兼容", "discovered_at": "2026-11-10T23:05:51.231793"}]}, "stats": {"entitiesCount": 40, "relationsCount": 63}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:05:51.232088", "content": {"agent": "DeepScout", "section": "竞争格局", "facts_count": 11, "duplicates_removed": 0, "data_points_count": 9, "insights": ["国内隐身材料/超材料呈典型寡头格局：规模企业仅华秦科技、佳驰科技、光启技术三家，A股上市标的仅光启技术与华秦科技两家，稀缺性构成估值溢价基础（支持h_2的“高壁垒、寡头化”判断）。", "三家企业并非同质竞争而是技术路径与温域分工：光启=超材料结构件（常温、机身机翼雷达边缘）、华秦=涂层+结构件（中高温、发动机热端）、佳驰=低频超宽带吸波贴片/泡沫/蜂窝（常温、多频谱兼容），竞争格局更接近“分赛道共存”而非直接价格战。", "规模量级仍偏小：2021年华秦+光启隐身材料合计营收仅10.4亿元，而光启技术2025年上半年超材料收入已达9.36亿元，四年间单品收入接近翻倍以上，隐含行业处于高速成长期，但缺乏全市场规模口径数据。"], "source_quality": "整体来源质量偏低且结构失衡。10条结果中：行业研究数据平台（小牛行研）2条，为二手图表摘录，可信度中等（0.7），但未标注原始出处（应为华秦科技/佳驰科技招股书），需回溯；咨询机构报告（前瞻网）1条，可信度本应较高，但正文出现“超材料矿勘探/开采”等明显与超材料定义矛盾的表述，且标注日期为2026年（未来时间），疑为模板化或抓取错误，可信度下调至0.4-0.6；问答平台（未来智库）1条，内容较详实但无原始引用，0.55；自媒体4条（雪球2、东方财富财富号2、股吧1），含明显荐股倾向与疑似错误数据（华秦科技流通市值48亿元与其股价过百、总股本约1.86亿股明显矛盾），可信度0.25-0.35，仅可用于获取线索不可作为论据。全部结果中无一条来自公司公告、年报、招股书、政府文件或学术论文，缺乏一手权威来源；且搜索结果高度集中于三家中游厂商的产品描述，对上游供应链、产能、份额、政策与国际对比几乎零覆盖，无法支撑本章节“供应链核心供应商+上市公司产品布局+客户关系+产能+市场份额”的完整写作需求，建议补充公司公告与券商深度报告后再行定稿。", "hypothesis_updates": 3, "search_results": [{"title": "国内三家隐身材料(超材料)公司产品概览(左图);华秦光启 - 行业研究数据 - 小牛行研", "url": "https://www.hangyan.co/charts/2895572036707419430", "source": "小牛行研", "snippet": "国内从事隐身材料研发和生产的 模企业较少,稀缺性显著。根据公司招股书披露,目前国内隐身材料规模企业仅有华秦科技、佳驰科技、光启技术等少数几家。华秦科技拥有隐身涂层和结构隐身材料产品;佳驰科技主要生产吸波贴片、吸波泡沫、吸波蜂窝等;光启技术提供超材料航空结构件和海洋结构件产品。公司隐身材料全温域覆盖,中高温领域优势明显。公司是国内极少数全面覆盖常温、中温和高温隐身材料设计、研发和生产的公司,且在中高温隐身材料领域技术优势明显。2018~2021 年,华秦科技和光启技术隐身材料(超材料)营收均实现大幅增长,3 年合计 CAGR 达83%,2021 年合计规模达 10.4 亿元。", "date": "2022-08-02T19:24:12+08:00"}, {"title": "国内隐身材料行业主要军品企业产品技术情况 - 行业研究数据 - 小牛行研", "url": "https://www.hangyan.co/charts/3008728898541192511", "source": "小牛行研", "snippet": "研究报告节选: 我国隐身材料企业有华秦科技、光启技术和佳驰科技(拟上市)等。华秦科技、佳驰科技业务覆盖隐身涂层材料及隐身结构件,光启技术业务覆盖航空结构超材料和海洋结构超材料。 相关行业研究图表 航空发动机各部位价值占比 2018-2022前三季度军工各细分板块研发费率逐步提高 2020-2022年中信国防军工成分股涨跌幅前十位及末五位排名 碳纤维产业链全景图 高温合金产业链 2022年中国连接器市场有望达到420亿美元 相关行业研究报告 图表内容 图表121:国内隐身材料行业主要军品企业产品技术情况 公司 隐身材料产品 技术水平 2021年营业收入(亿元 隐身涂层材料:包括耐温隐身涂 层材料和防腐隐身涂层材料; 是目前国内极少数能够全面覆盖常温、中温和高 华秦科技 结构隐身材料:已实现小批量生 温隐身材料设计、研发和生产的企业,尤其在中 高温隐身材料领域技术优势明显 隐身功能涂层材料:具有吸收雷 围绕EMMS产业发展的产品主流和技术前沿,全 佳驰科技 达、红外线等电磁波的功能; 面覆盖隐身功能涂层材料、隐身功能结构件; 隐身结构件:兼具电磁吸收和高 EMMS产品在低频超宽带、多频谱兼容、薄型轻 强度两种特性 量化等方面具有行业显著的技术优势和特色 掌握新一代超材料技术产品的深度计算、智能制 光启技术 超材料(航空结构产品、海洋结 造以及高效测试等核心技术,与尖端装备行业结 构产品) 合,率先应用到了我国尖端装备领域,在世界超 材料产业化竞争中抢占了先机,成为行业引领者 Wind 信达证券研发中心", "date": "2023-01-05T23:25:21+08:00"}, {"title": "公司业务涵盖多种隐身材料_财富号_东方财富网", "url": "https://caifuhao.eastmoney.com/news/20241101172613057625810", "source": "财富号", "snippet": "华秦和光启技术两市唯二隐身超材料公司,华秦不单有隐身超材料,还有隐身涂层、航空发动机红外隐身等超材料,范围更广。华秦科技营收、毛利率和光启技术一个档次,市值一个900亿一个180亿,严重低估,上涨空间巨大。都是隐身超材料,玩完光启技术,再来一轮华秦科技更爽 追加内容 本文作者可以追加内容哦 ! 举报 郑重声明: 用户在社区发表的所有信息将由本网站记录保存,仅代表作者个人观点,与本网站立场无关,不对您构成任何投资建议,据此操作风险自担。 请勿相信代客理财、免费荐股和炒股培训等宣传内容,远离非法证券活动。请勿添加发言用户的手机号码、公众号、微博、微信及QQ等信息,谨防上当受骗! 总收益 20日收益 日收益 -- -- -- 最新操作 历史收益率走势(%) Chart 代码 名称 最新价 涨跌幅 查看更多 浪客视频", "date": "2024-11-01T17:26:00+08:00"}, {"title": "目前主要从事航空隐身材料业务的企业有哪些? - 问答集锦 - 未来智库", "url": "https://www.vzkoo.com/question/1677859985", "source": "未来智库", "snippet": "问题详情 目前主要从事航空隐身材料业务的企业有哪些? 浏览次数:532 提问者:匿名用户 共有 1 个回答 目前主要从事航空隐身材料业务的企业主要有华秦科技和光启技术。 华秦科技:公司主要从事特种功能材料,包括隐身材料、伪装材料及防护材料的研发、生 产和销售,产品主要应用于我国重大国防武器装备如飞机、主战坦克、舰船、导弹等的隐 身、重要地面军事目标的伪装和各类装备部件的表面防护。公司是目前国内极少数能够 全面覆盖常温、中温和高温隐身材料设计、研发和生产的高新技术企业,尤其在中高温隐 身材料领域技术优势明显,产业化成果突出。通过多年的技术攻关,公司成功研制出可以 长期应用于中高温环境的耐温隐身涂层材料,并实现在武器装备上的批产应用。公司隐 身材料相关的核心技术处于行业领先地位。2016 年,根据国家国防科技工业局鉴定结果, 公司隐身材料“综合技术水平达到国际先进水平,在XX 方面达到国际领先水平”。此外, 隐身材料行业技术要求较高,从而市场壁垒较高,公司未来成长确定性较强。 光启技术:截至目前,公司深耕超材料尖端装备行业。公司是我国新一代尖端装备的核心 供应商,也是国内唯一一家将超材料技术形成产品并大规模应用于尖端装备领域的公司。 公司超材料业务方面,根据国家战略布局,尖端装备市场升级换代加速,最终客户的需 求、直接客户下达的交付任务不断增加。由于公司超材料产品在新型装备加速升级换代 中起到重要作用,外部需求的不断增加带动公司超材料业务快速增长,在核心装备中的 市场渗透率逐步提升。近年来,公司营业收入实现大幅提升。2021 年,公司超材料业务 营收同比增长 50.01%,其中批产收入同比增长 102.50%,占超材料业务收入比重从 63.30% 增加到 85.45%,收入结构持续改善。2021 年超材料业务整体毛利率增长到 58.41%,较上 年增加 5.58%。公司目前经营", "date": "2023-02-23T21:42:00+08:00"}, {"title": "华秦科技688281调研情况汇报", "url": "https://xueqiu.com/4862692890/319118641?_ugc_source=ugcbaiducard&md5__1038=n4AxB7DQiQitoBKqGXnCxoDOndi=zD9iDQu42pD", "source": "雪球", "snippet": "二 、 横向比较\n华秦科技 、 光启技术 、 佳驰科技 在隐身材料方面 , 三家方向不完全相同 。\n华秦偏重于中高温区域 , 主要用在发动机零部件和发动机对应的机身部位 ;\n光启主要做常温隐身材料 , 主要用在机身和机翼以及雷达的边缘部位 ;\n佳驰也是常温隐身材料 , 主要用在机身 、 机翼等部位 。\n华秦目前在开发常温材料 , 光启和佳驰在中高温方面尚无布局 。\n三 、 隐身材料产品的生命周期\n不管是常温材料还是中高温材料 , 都有一定的生命周期 。\n常温材料在飞机飞到一定时长后 ( 像汽车保养 ) 重新补涂 。\n华秦的材料有两种使用方式 , 其一是在零部件上溅射成涂层 , 其二是用隐身材料制作成结构件 生命周期较长 , 到期后直接换零部件 。\n四 股份解禁\n今年 3月份解禁股份数量较大 , 如图所示 。 大部分是老股东上市前持有的股份 , 当初是以团队持股的方式分配的 , 解禁后公司会组织 , 以统一的方式处理 。 比如协议转让 、 大宗交易 、 引进战投等方式 , 不会出现各股东单打独斗的情况 \n1 目前华秦总市值 最低时的120亿 有一定的涨幅 不是相对低位 绝对值也不便宜 \n2 2025年上市满三年 面临 \n综合以上两点 短时间投资机会 保持跟进吧", "date": "2025-01-03T16:17:00+08:00"}, {"title": "华秦股价过百了-东方财富网股吧", "url": "https://mguba.eastmoney.com/mguba/article/0/1475347482", "source": "东方财富网股吧", "snippet": "两者的相同点:华秦科技和光启技术都是中国军工领域的高新技术企业,专注于隐身材料的研发和生产。两家公司都致力于军工领域的隐身材料技术,为国防提供高科技材料支持。产品主要应用于军事装备,如飞机、舰船、导弹等,以提高装备的隐身性能。...", "date": "2024-10-27T00:15:07+08:00"}, {"title": "光启", "url": "https://xueqiu.com/2504698885/325370905", "source": "雪球", "snippet": "、 华秦 、 佳驰 : 隐身材料赛道分道扬镳\n一 、 技术路径 : 材料设计的底层逻辑不同\n光启技术 ( 超材料技术 ) 核心是通过对材料物理结构的微观设计 ( 如铜箔等基础材料的精密排列 ) , 赋予材料超常规的电磁性能 , 例如隐身 、 电子对抗等 。 这种技术属于 人造物质的全新创造 , 创新程度高 , 能实现多功能的集成 ( 如隐身+结构强度+耐高温 ) 。 举例 : 类似用乐高积木重新组装出自然界不存在的材料 。\n华秦科技 ( 传统材料优化 ) 基于现有材料的性能改良 , 例如在涂层中添加金属粉末 、 铁氧体等吸波剂 , 通过涂覆或结构复合的方式吸收电磁波 。 其技术路径更偏向 传统材料的深度挖掘 , 尤其是中高温隐身材料 ( 如飞机发动机部件 ) 的领先优势显著 。 举例 : 给金属表面刷一层 “ 吸波油漆 ” 。\n佳驰科技 ( 低频多频谱兼容 ) 专注于雷达吸波材料的低频超宽带技术 , 强调 多频谱兼容性 ( 如同时应对雷达 、 红外探测 ) 和薄型轻量化设计 。 其产品以吸波贴片 、 泡沫 、 蜂窝等形态为主 , 适用于复杂电磁环境下的多频段隐身需求 。 举例 : 像 “ 电磁波海绵 ” , 能在不同频率下吸收不同波段的信号 。\n二 、 产品形态与应用场景\n三 、 行业壁垒与市场定位\n光启 : 技术壁垒最高 , 超材料专利布局密集 , 且已实现规模化量产 ( 如顺德基地年产能超10亿元 ) 。 其产品定位为 “ 军工主航道关键部件供应商 ” , 占据国内超材料市场近90%份额 。\n华秦 : 依托西北工业大学技术沉淀 , 在中高温隐身材料领域 无国内直接竞争对手 , 且军品资质认证周期长 , 客户黏性高 。\n佳驰 : 面临华秦向常温领域渗透的竞争压力 , 但通过低频技术差异化切入市场 , 并拓展民用电波暗室等新兴领域 。\n四 、 未来发展方向\n光启 : 向低空", "date": "2025-02-28T17:39:00+08:00"}, {"title": "军用隐身材料龙头:华秦科技,先发优势明显后劲仍足 - 今日头条", "url": "https://www.toutiao.com/article/7181604067989357089/", "source": "今日头条", "snippet": "公司是目前国内极少数能够全面覆盖常温、中温和高温隐身材料设计、研发和生产的高新技术企业,实现了全温域、多频谱、多功能覆盖。", "date": "2022-12-27T16:05:00+08:00"}, {"title": "A股仅2家军工隐身功能材料公司,前景看好!_财富号_东方财富网", "url": "https://caifuhao.eastmoney.com/news/20241119111041691030870", "source": "财富号", "snippet": "目前,全A 股,仅2家军工隐身特种功能材料公司,分别为光启技术(002625)和华秦科技(688281),我国隐身功能材料研发技术,现处在在世界领先行列,仅有少数国家掌握。隐身功能材料主要用于军用飞机、船舶、导弹、无人机、地面武器设备伪装防护等。具较好的发展前景! 光启技术:今年前3季度净利润5.37亿元,流通市值673亿元。 华秦科技:今年前3季度净利润3.09亿元,流通市值48亿元。", "date": "2024-11-19T11:10:00+08:00"}, {"title": "【全网最全】2026年超材料行业上市公司全方位对比(附业务布局汇总、业绩对比、业务规划等)_经济学人 - 手机前瞻网", "url": "https://xw.qianzhan.com/analyst/detail/220/260601-5fc9cf57.html", "source": "前瞻网", "snippet": "以下数据及分析来自于前瞻产业研究院超材料研究小组发布的《中国隐身材料(超材料)行业发展前景预测与投资战略规划分析报告》\n行业主要上市公司:光启技术(002625)、华秦科技(688281)、天和防务(300397)等\n本文核心数据:超材料业务收入\n1、超材料行业上市公司汇总\n超材料产业上游为北矿科技、神开股份、德石股份、中海油服等超材料矿勘探企业,以及新锐股份、山河智能、铁建重工、天地科技等超材料矿开采设备厂商,中游为金石资源、中萤集团等超材料生产加工厂商;下游应用领域包括光学工业、冶金工业、建材工业、陶瓷工业、新材料、新能源等。\n注:上表中民士达、中航高科、中复神鹰、铂力特、华正新材、南亚新材、华曙高科等公司营收数据为2025年全年,其余公司营收数据为2025年1-9月。\n注:上表中公司营收数据为2025年1-9月。\n注:上表中中航沈飞、中国卫星、海格通信、比亚迪等为2025年全年收入,四创电子、盛路通信为2025年1-9月。\n2、超材料行业上市公司基本信息对比\n从超材料行业的上市企业布局和已有公开信息分析,注册资本最大的公司是光启技术,超21亿元;其次为航天发展,注册资本近16亿元。中国超材料上市公司注册时间普遍较早,其中华秦技术注册日期为1992年。\n3、超材料行业企业业务布局对比\n从超材料研制企业布局来看,代表性龙头企业光启技术2025年上半年超材料业务收入达9.36亿元,超材料业务收入占其营收占比约99.41%;其余公司超材料业务收入占比较小。\n截至2026年4月,中国超材料行业龙头企业光启技术的员工总数为2424人,其中生产人员和技术人员占比较高;其次,华秦科技员工人数约1136人。\n4、超材料行业企业业务业绩对比\n中国超材料行业上市公司中,龙头企业光启技术2025年1-9月营收为15.96亿元,2025年1-6月超材料业务收入为9.36亿元,毛利率为54.9", "date": "2026-06-03T14:00:00+08:00"}], "extracted_facts": [{"content": "国内隐身材料规模企业仅有华秦科技、佳驰科技、光启技术等少数几家，稀缺性显著；2018~2021年华秦科技与光启技术隐身材料（超材料）营收均大幅增长，3年合计CAGR达83%，2021年合计规模达10.4亿元。", "source_name": "小牛行研（行业研究数据）", "source_url": "https://www.hangyan.co/charts/2895572036707419430", "credibility": 0.7}, {"content": "国内隐身材料军品企业产品技术布局：华秦科技覆盖隐身涂层材料（耐温、防腐）与结构隐身材料（已小批量生产），是国内极少数全面覆盖常温、中温、高温隐身材料设计研发生产的企业，中高温领域优势明显；佳驰科技覆盖隐身功能涂层与隐身功能结构件，在低频超宽带、多频谱兼容、薄型轻量化方面具技术优势；光启技术掌握超材料深度计算、智能制造与高效测试核心技术，产品为航空结构超材料与海洋结构超材料。", "source_name": "小牛行研（行业研究数据）", "source_url": "https://www.hangyan.co/charts/3008728898541192511", "credibility": 0.7}, {"content": "华秦科技主要从事特种功能材料（隐身材料、伪装材料、防护材料）研发生产销售，产品应用于飞机、主战坦克、舰船、导弹等装备隐身与地面军事目标伪装；2016年经国家国防科技工业局鉴定，其隐身材料“综合技术水平达到国际先进水平，在XX方面达到国际领先水平”。", "source_name": "未来智库（问答集锦）", "source_url": "https://www.vzkoo.com/question/1677859985", "credibility": 0.55}, {"content": "光启技术是我国新一代尖端装备的核心供应商，也是国内唯一一家将超材料技术形成产品并大规模应用于尖端装备领域的公司；随着尖端装备升级换代加速，最终客户需求与直接客户交付任务不断增加。", "source_name": "未来智库（问答集锦）", "source_url": "https://www.vzkoo.com/question/1677859985", "credibility": 0.55}, {"content": "三家隐身材料公司技术路径分化：光启技术为超材料技术，通过对材料微观结构精密设计（如铜箔等基础材料排列）赋予超常规电磁性能，创新程度高、可多功能集成，专利布局密集且已规模化量产；华秦科技为传统材料优化路径，在涂层中添加金属粉末、铁氧体等吸波剂，中高温隐身材料（发动机部件）优势显著；佳驰科技专注雷达吸波材料低频超宽带与多频谱兼容、薄型轻量化，产品形态为吸波贴片、泡沫、蜂窝。", "source_name": "雪球", "source_url": "https://xueqiu.com/2504698885/325370905", "credibility": 0.35}, {"content": "横向比较：华秦科技偏重中高温区域，主要用于发动机零部件及对应机身部位；光启技术主要做常温隐身材料，用于机身、机翼及雷达边缘部位；佳驰科技亦为常温隐身材料，用于机身、机翼等部位；华秦正在开发常温材料，光启与佳驰在中高温方面尚无布局。常温材料有使用周期，需定期补涂；结构件形式生命周期较长，到期更换零部件。", "source_name": "雪球（华秦科技调研纪要）", "source_url": "", "credibility": 0.35}, {"content": "A股仅2家军工隐身特种功能材料公司，分别为光启技术（002625）与华秦科技（688281）；文中称光启技术2024年前三季度净利润5.37亿元、流通市值673亿元，华秦科技前三季度净利润3.09亿元、流通市值48亿元。", "source_name": "东方财富网·财富号", "source_url": "https://caifuhao.eastmoney.com/news/20241119111041691030870", "credibility": 0.3}, {"content": "前瞻产业研究院统计：超材料行业主要上市公司为光启技术（002625）、华秦科技（688281）、天和防务（300397）等；光启技术注册资本超21亿元为行业最大，航天发展注册资本近16亿元次之；光启技术2025年上半年超材料业务收入达9.36亿元。", "source_name": "前瞻网（前瞻产业研究院）", "source_url": "https://xw.qianzhan.com/analyst/detail/220/260601-5fc9cf57.html", "credibility": 0.6}], "data_points": [{"name": "华秦+光启隐身材料合计营收", "value": "10.4", "unit": "亿元", "year": 2021, "source": "小牛行研（行业研究数据）"}, {"name": "2018-2021隐身材料营收合计CAGR", "value": "83", "unit": "%", "year": 2021, "source": "小牛行研（行业研究数据）"}, {"name": "光启技术前三季度净利润", "value": "5.37", "unit": "亿元", "year": 2024, "source": "东方财富网·财富号"}, {"name": "华秦科技前三季度净利润", "value": "3.09", "unit": "亿元", "year": 2024, "source": "东方财富网·财富号"}, {"name": "光启技术流通市值", "value": "673", "unit": "亿元", "year": 2024, "source": "东方财富网·财富号"}, {"name": "华秦科技流通市值", "value": "48", "unit": "亿元", "year": 2024, "source": "东方财富网·财富号"}, {"name": "光启技术超材料业务收入（上半年）", "value": "9.36", "unit": "亿元", "year": 2025, "source": "前瞻网（前瞻产业研究院）"}, {"name": "光启技术注册资本", "value": "21", "unit": "亿元", "year": 2025, "source": "前瞻网（前瞻产业研究院）"}, {"name": "华秦科技历史最低总市值", "value": "120", "unit": "亿元", "year": 2024, "source": "雪球（华秦科技调研纪要）"}]}}

