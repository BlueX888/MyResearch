data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:21:03.702938", "content": {"results": [{"id": "fact_e2191a78", "title": "截至2022年，光启技术累计申请专利5911件，获得授权专利3799件，超材料领域专利申请总量位居全球第一；其将隐身超材料从二维拓展到三维，技术达到4.0版本，...", "source": "雪球", "url": "", "snippet": "截至2022年，光启技术累计申请专利5911件，获得授权专利3799件，超材料领域专利申请总量位居全球第一；其将隐身超材料从二维拓展到三维，技术达到4.0版本，结构件采用芳纶、碳纤维替代传统材料。", "date": "", "isSupplementary": true}, {"id": "fact_001821c6", "title": "截至2021年，光启累计申请超材料专利5891件，授权3743件，专利申请总量全球第一，覆盖超材料底层技术专利85%以上；2011年单年申请703项，占当年全球...", "source": "今日头条", "url": "", "snippet": "截至2021年，光启累计申请超材料专利5891件，授权3743件，专利申请总量全球第一，覆盖超材料底层技术专利85%以上；2011年单年申请703项，占当年全球超材料专利申请总量的68%。", "date": "", "isSupplementary": true}, {"id": "fact_7860406c", "title": "有自媒体称光启技术超材料领域专利发明绝对数量已超过6000件，全球占比接近90%。", "source": "财富号（东方财富网）", "url": "", "snippet": "有自媒体称光启技术超材料领域专利发明绝对数量已超过6000件，全球占比接近90%。", "date": "", "isSupplementary": true}, {"id": "fact_a77af3d9", "title": "光启技术超材料业务收入从2018年的1.3亿元增长约十倍，五年复合增长率达56.89%；2023年预计净利润为5.15亿元至6.3亿元。", "source": "雪球", "url": "", "snippet": "光启技术超材料业务收入从2018年的1.3亿元增长约十倍，五年复合增长率达56.89%；2023年预计净利润为5.15亿元至6.3亿元。", "date": "", "isSupplementary": true}, {"id": "fact_294b6cb1", "title": "2021年3月，光启在佛山顺德高新区新建266亩产业基地，在职员工约2700余人，基地涵盖复合超材料产品的生产、测试及交付。", "source": "顺德就业网", "url": "", "snippet": "2021年3月，光启在佛山顺德高新区新建266亩产业基地，在职员工约2700余人，基地涵盖复合超材料产品的生产、测试及交付。", "date": "", "isSupplementary": true}, {"id": "fact_1701c420", "title": "华秦科技2022年实现营业收入6.72亿元，同比增长31.37%；归母净利润3.33亿元，同比增长42.99%；扣非归母净利润3.12亿元，同比增长57.31%...", "source": "新浪财经", "url": "", "snippet": "华秦科技2022年实现营业收入6.72亿元，同比增长31.37%；归母净利润3.33亿元，同比增长42.99%；扣非归母净利润3.12亿元，同比增长57.31%。", "date": "", "isSupplementary": true}, {"id": "fact_a9cff02f", "title": "华秦科技2022年隐身材料、伪装材料、防护材料分别实现收入5.57亿元、0.82亿元、0.34亿元，占比分别为82.8%、12.2%、5.0%。", "source": "新浪财经", "url": "", "snippet": "华秦科技2022年隐身材料、伪装材料、防护材料分别实现收入5.57亿元、0.82亿元、0.34亿元，占比分别为82.8%、12.2%、5.0%。", "date": "", "isSupplementary": true}, {"id": "fact_8af06873", "title": "华秦科技2022年毛利率和净利率分别同比提升2.19个百分点和4.03个百分点至61.00%和49.58%。", "source": "新浪财经", "url": "", "snippet": "华秦科技2022年毛利率和净利率分别同比提升2.19个百分点和4.03个百分点至61.00%和49.58%。", "date": "", "isSupplementary": true}, {"id": "fact_e9bb53cc", "title": "华秦科技2022年年报显示，隐身材料收入占比82.82%，伪装材料收入占比12.17%，防护材料及其他业务收入占比5.01%；营业收入6.724亿元，同比增长3...", "source": "搜狐", "url": "", "snippet": "华秦科技2022年年报显示，隐身材料收入占比82.82%，伪装材料收入占比12.17%，防护材料及其他业务收入占比5.01%；营业收入6.724亿元，同比增长31.37%。", "date": "", "isSupplementary": true}, {"id": "fact_b157084b", "title": "华秦科技2020~2022年毛利率稳定在60%左右，净利率自37.4%提升至49.6%，主要因生产效率提升和规模效应下费用率持续优化。", "source": "chaguwang.cn", "url": "", "snippet": "华秦科技2020~2022年毛利率稳定在60%左右，净利率自37.4%提升至49.6%，主要因生产效率提升和规模效应下费用率持续优化。", "date": "", "isSupplementary": true}, {"id": "fact_bb02e60e", "title": "小牛行研图表显示国内三家隐身材料公司2018-2021年隐身材料端营收，其中佳驰电子未披露2018年营收；华秦科技未披露2021年营收拆分，使用特种功能材料业务...", "source": "小牛行研", "url": "", "snippet": "小牛行研图表显示国内三家隐身材料公司2018-2021年隐身材料端营收，其中佳驰电子未披露2018年营收；华秦科技未披露2021年营收拆分，使用特种功能材料业务营收。", "date": "", "isSupplementary": true}, {"id": "fact_cea0d9da", "title": "新劲刚在互动平台表示，吸波材料领域分为研究院所和民营企业，国有企业大都有直属研究院所，民营隐身材料企业主要有光启技术、华秦科技等；新劲刚子公司康泰威从事涂层吸波...", "source": "金融界股票", "url": "", "snippet": "新劲刚在互动平台表示，吸波材料领域分为研究院所和民营企业，国有企业大都有直属研究院所，民营隐身材料企业主要有光启技术、华秦科技等；新劲刚子公司康泰威从事涂层吸波隐身材料。", "date": "", "isSupplementary": true}, {"id": "fact_083d5086", "title": "新劲刚被市场称为“战斗机隐身材料第一股”，其互动和调研报告显示有战机雷达隐身涂层材料；有观点称军工隐身材料除了新劲刚和光启技术之外没有第三家。", "source": "淘股吧", "url": "", "snippet": "新劲刚被市场称为“战斗机隐身材料第一股”，其互动和调研报告显示有战机雷达隐身涂层材料；有观点称军工隐身材料除了新劲刚和光启技术之外没有第三家。", "date": "", "isSupplementary": true}, {"id": "fact_96f85950", "title": "楚江新材（002171）主打“铜基新材料+军工碳材料/特种装备”双板块，军工/碳基新材料包括碳纤维复合材料预制体（天鸟高新）、碳/碳和碳/陶制品、纤维布与预浸料...", "source": "财富号（东方财富网）", "url": "", "snippet": "楚江新材（002171）主打“铜基新材料+军工碳材料/特种装备”双板块，军工/碳基新材料包括碳纤维复合材料预制体（天鸟高新）、碳/碳和碳/陶制品、纤维布与预浸料等，可用于航空航天、军工等领域。", "date": "", "isSupplementary": true}, {"id": "fact_89f12d31", "title": "光威复材（威海光威复合材料股份有限公司）被列为碳纤维产业链的“链主”企业。", "source": "www.sdzdxm.com", "url": "", "snippet": "光威复材（威海光威复合材料股份有限公司）被列为碳纤维产业链的“链主”企业。", "date": "", "isSupplementary": true}, {"id": "fact_78cce23b", "title": "PCB（印刷电路板）产业链可按“上游原材料/设备—中游制造—下游应用终端”三层划分，并逐层对应上市公司：上游覆铜板（CCL）为生益科技（龙头）、金安国纪，铜箔为...", "source": "雪球", "url": "", "snippet": "PCB（印刷电路板）产业链可按“上游原材料/设备—中游制造—下游应用终端”三层划分，并逐层对应上市公司：上游覆铜板（CCL）为生益科技（龙头）、金安国纪，铜箔为诺德股份、嘉元科技，玻纤布为中国巨石、宏和科技，油墨/干膜为容大感光、广信材料，设备为大族数控；中游PCB制造按应用分，通信/服务器为沪电股份（龙头）、深南电路、生益电子，消费电子为鹏鼎控股、东山精密，汽车电子为世运电路、依顿电子、中京电子", "date": "", "isSupplementary": true}, {"id": "fact_7f98f2d5", "title": "集成电路产业链同样采用上中下游分层并对应上市公司：上游为半导体材料与设备（硅片：沪硅产业、TCL中环；光刻胶：容大感光、华懋科技、雅克科技；电子特气：金宏气体、...", "source": "今日头条", "url": "", "snippet": "集成电路产业链同样采用上中下游分层并对应上市公司：上游为半导体材料与设备（硅片：沪硅产业、TCL中环；光刻胶：容大感光、华懋科技、雅克科技；电子特气：金宏气体、华特气体、凯美特气；靶材：安泰科技、康达新材、江丰电子；CMP抛光材料：鼎龙股份、安集科技；湿电子化学品：江化微、中巨芯、格林达；设备：北方华创、中微公司、盛美上海）；中游为设计、制造、封测（设计：韦尔股份、紫光国微；EDA：华大九天、概伦", "date": "", "isSupplementary": true}, {"id": "fact_c4f53ca1", "title": "产业链上中下游的通用定义：上游为原材料采掘、种植、养殖等基础材料与初级产品供应环节；中游为对上游原材料进行加工再加工、生产半成品或零部件的制造环节；下游为产品组...", "source": "牛炒股", "url": "", "snippet": "产业链上中下游的通用定义：上游为原材料采掘、种植、养殖等基础材料与初级产品供应环节；中游为对上游原材料进行加工再加工、生产半成品或零部件的制造环节；下游为产品组装、销售与服务环节。三者相互依存，上游供给影响中下游生产运营，下游需求反向影响上游与中游策略。该定义可作为隐身材料供应链分层的分析框架，但未给出任何隐身材料/超材料企业名单。", "date": "", "isSupplementary": true}, {"id": "fact_52032c56", "title": "供应链管理服务行业在产业链中处于中下游位置，上游主要由商品提供厂家组成；该行业上市企业业务覆盖面广、赛道差异大，服务型业务下游一般为消费者和上游原厂家，因此相关...", "source": "悟空智库（图表数据库）", "url": "", "snippet": "供应链管理服务行业在产业链中处于中下游位置，上游主要由商品提供厂家组成；该行业上市企业业务覆盖面广、赛道差异大，服务型业务下游一般为消费者和上游原厂家，因此相关汇总仅讨论上游及中游上市企业情况。此条为供应链服务行业口径，与隐身材料/超材料供应链无直接关联。", "date": "", "isSupplementary": true}, {"id": "fact_59c4ed4c", "title": "搜索结果中出现的光伏产业链题目（上游为硅料、硅片等原材料企业，选项含通威股份、隆基股份、中环股份、阳光电源）与芯片原材料及设备A股上市公司条目，均为其他行业的上...", "source": "搜题易 / 简答题 / 行行查", "url": "", "snippet": "搜索结果中出现的光伏产业链题目（上游为硅料、硅片等原材料企业，选项含通威股份、隆基股份、中环股份、阳光电源）与芯片原材料及设备A股上市公司条目，均为其他行业的上游/中游划分示例，未提供隐身材料、吸波填料、超材料或总装环节的任何供应商或上市公司信息。", "date": "", "isSupplementary": true}]}}

