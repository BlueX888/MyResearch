data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:14:51.918143", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2018, 2019, 2020, 2021], 'Revenue': [1.70, 3.11, 5.68, 10.40]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['Revenue'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='隐身材料合计营收')\nplt.fill_between(df['Year'], df['Revenue'], alpha=0.15, color='#6366f1')\nfor x, y in zip(df['Year'], df['Revenue']):\n    plt.text(x, y + 0.3, f'{y:.2f}亿元', ha='center', fontsize=11, fontweight='bold')\nplt.text(2018.05, 8.8, '2024前三季度净利润：光启5.37亿 / 华秦3.09亿；流通市值：光启673亿 / 华秦48亿', fontsize=10, bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('营收（亿元）', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

