data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:12:23.042048", "content": {"results": [{"id": "fact_33c4877e", "title": "第三方估值网站汇总：华秦科技2021、2022、2023年上半年营业收入分别为1.97亿元、2.70亿元、3.82亿元；归母净利润分别为0.89亿元、1.24亿...", "source": "估值网", "url": "", "snippet": "第三方估值网站汇总：华秦科技2021、2022、2023年上半年营业收入分别为1.97亿元、2.70亿元、3.82亿元；归母净利润分别为0.89亿元、1.24亿元、1.84亿元；扣非净利润分别为0.66亿元、1.09亿元、1.75亿元。", "date": "", "isSupplementary": false}, {"id": "fact_c231f3cc", "title": "光启技术2024年年报显示，公司营业总收入为15.58亿元，归母净利润为6.52亿元；经营活动现金净流入为-8601.57万元，较上年同期减少7013.58万元...", "source": "财经头条", "url": "", "snippet": "光启技术2024年年报显示，公司营业总收入为15.58亿元，归母净利润为6.52亿元；经营活动现金净流入为-8601.57万元，较上年同期减少7013.58万元。", "date": "", "isSupplementary": false}, {"id": "fact_49d964bf", "title": "光启技术2024年年报显示，公司毛利率为51.39%，同比增加5.49个百分点；资产负债率为9.93%；ROE为7.30%；摊薄每股收益为0.30元；总资产周转...", "source": "腾讯网", "url": "", "snippet": "光启技术2024年年报显示，公司毛利率为51.39%，同比增加5.49个百分点；资产负债率为9.93%；ROE为7.30%；摊薄每股收益为0.30元；总资产周转率为0.16次；存货周转率为3.12次。", "date": "", "isSupplementary": false}, {"id": "fact_eb8c002b", "title": "光启技术2024年年报显示，公司研发总投入为1.25亿元，同比下降34.79%；研发投入占比为8.05%，同比减少4.81个百分点。", "source": "腾讯网", "url": "", "snippet": "光启技术2024年年报显示，公司研发总投入为1.25亿元，同比下降34.79%；研发投入占比为8.05%，同比减少4.81个百分点。", "date": "", "isSupplementary": false}, {"id": "fact_05623fbd", "title": "光启技术2024年年报显示，公司前十大股东持股数量为10.35亿股，占总股本比例为48.01%；股东户数为12.99万户。", "source": "腾讯网", "url": "", "snippet": "光启技术2024年年报显示，公司前十大股东持股数量为10.35亿股，占总股本比例为48.01%；股东户数为12.99万户。", "date": "", "isSupplementary": false}, {"id": "fact_36842d03", "title": "光启技术2024年三季报显示，前三季度营业总收入为12.69亿元，同比增长3.67%；归母净利润为5.37亿元，同比增长20.05%；扣非净利润为5.31亿元，...", "source": "搜狐", "url": "", "snippet": "光启技术2024年三季报显示，前三季度营业总收入为12.69亿元，同比增长3.67%；归母净利润为5.37亿元，同比增长20.05%；扣非净利润为5.31亿元，同比增长28.39%；经营活动现金流净额为9857.12万元；投资活动现金流净额为-4.09亿元。", "date": "", "isSupplementary": false}, {"id": "fact_381c02a6", "title": "有自媒体分析称，光启技术客户集中度在80%以上，且主要营收依赖超材料产品；并引用2024年三季报营业总收入12.69亿元，提示主要客户订单减少或合作问题将较大冲...", "source": "财富号", "url": "", "snippet": "有自媒体分析称，光启技术客户集中度在80%以上，且主要营收依赖超材料产品；并引用2024年三季报营业总收入12.69亿元，提示主要客户订单减少或合作问题将较大冲击业绩。", "date": "", "isSupplementary": false}, {"id": "fact_944baaef", "title": "该自媒体称，截至2024年12月7日，光启技术整体质押股份为7.76亿股，占总股本35.98%；控股股东及一致行动人质押占其持股比例为94.55%；质押股价预警...", "source": "财富号", "url": "", "snippet": "该自媒体称，截至2024年12月7日，光启技术整体质押股份为7.76亿股，占总股本35.98%；控股股东及一致行动人质押占其持股比例为94.55%；质押股价预警线为17.34元/股，平仓线为15.18元/股。", "date": "", "isSupplementary": false}, {"id": "fact_69319a8e", "title": "该自媒体称，光启技术2024年三季报应收账款同比增幅达50.49%，应收账款占营业收入比例高达98.98%；经营活动净现金流与净利润比值为0.18；投资现金流为...", "source": "财富号", "url": "", "snippet": "该自媒体称，光启技术2024年三季报应收账款同比增幅达50.49%，应收账款占营业收入比例高达98.98%；经营活动净现金流与净利润比值为0.18；投资现金流为-4.09亿元，同比-286.33%。", "date": "", "isSupplementary": false}, {"id": "fact_b94fb0f8", "title": "小牛行研页面显示（页面未明确公司名称，不能直接确认指光启技术）：2019年以来前五大客户占比维持在70%以上；2023年前五大客户销售金额占比为76.37%，分...", "source": "小牛行研", "url": "", "snippet": "小牛行研页面显示（页面未明确公司名称，不能直接确认指光启技术）：2019年以来前五大客户占比维持在70%以上；2023年前五大客户销售金额占比为76.37%，分项分别为27.87%、17.82%、17.69%、7.03%、5.96%；第一大客户销售金额占比同比上升2.67个百分点；2023年经销模式占营业收入59.89%，同比上升16.32个百分点，直销模式占40.11%。", "date": "", "isSupplementary": false}, {"id": "fact_346d5085", "title": "本次搜索结果未直接披露光启技术2024年年报前五名客户的具体销售额及合计销售占比；现有“80%以上”为客户集中度自媒体表述，2023年76.37%及分项数据来自...", "source": "本次搜索结果综合", "url": "", "snippet": "本次搜索结果未直接披露光启技术2024年年报前五名客户的具体销售额及合计销售占比；现有“80%以上”为客户集中度自媒体表述，2023年76.37%及分项数据来自未明确公司名称的行业数据页面，均需以巨潮资讯网年报原文核验。", "date": "", "isSupplementary": false}, {"id": "fact_a251028a", "title": "国泰君安研报称，华秦科技系隐身材料龙头，产品先发优势明显，下游需求高度确定，叠加渗透率不断提升，业绩有望保持稳定增长。", "source": "中金在线转载国泰君安研报", "url": "", "snippet": "国泰君安研报称，华秦科技系隐身材料龙头，产品先发优势明显，下游需求高度确定，叠加渗透率不断提升，业绩有望保持稳定增长。", "date": "", "isSupplementary": false}, {"id": "fact_2382234e", "title": "国泰君安预计华秦科技2024年H1实现营业收入4.97亿元，同比增长30.05%；归母净利润2.20亿元，同比增长19.63%；扣非净利润2.12亿元，同比增长...", "source": "中金在线转载国泰君安研报", "url": "", "snippet": "国泰君安预计华秦科技2024年H1实现营业收入4.97亿元，同比增长30.05%；归母净利润2.20亿元，同比增长19.63%；扣非净利润2.12亿元，同比增长21.21%。", "date": "", "isSupplementary": false}, {"id": "fact_8f44718f", "title": "国泰君安预计华秦科技2024年Q2实现营业收入2.49亿元，同比增长27.60%；归母净利润1.05亿元，同比增长10.56%；扣非净利润1.01亿元，同比增长...", "source": "中金在线转载国泰君安研报", "url": "", "snippet": "国泰君安预计华秦科技2024年Q2实现营业收入2.49亿元，同比增长27.60%；归母净利润1.05亿元，同比增长10.56%；扣非净利润1.01亿元，同比增长14.17%。", "date": "", "isSupplementary": false}, {"id": "fact_a26db1e9", "title": "国泰君安称华秦科技受益于批产型号放量，深度参与新型号研发，并持续拓展航发零部件等新业务。", "source": "中金在线转载国泰君安研报", "url": "", "snippet": "国泰君安称华秦科技受益于批产型号放量，深度参与新型号研发，并持续拓展航发零部件等新业务。", "date": "", "isSupplementary": false}, {"id": "fact_7e975c04", "title": "国泰君安维持华秦科技目标价135.44元，对应2024年50倍PE，维持“增持”评级；调整2024-2026年EPS至2.72/3.59/4.43元。", "source": "中金在线转载国泰君安研报", "url": "", "snippet": "国泰君安维持华秦科技目标价135.44元，对应2024年50倍PE，维持“增持”评级；调整2024-2026年EPS至2.72/3.59/4.43元。", "date": "", "isSupplementary": false}, {"id": "fact_b92578e2", "title": "东吴证券2024年三季报点评标题为“屡获重大订单，隐身材料行业持续发力”，显示华秦科技在隐身材料订单获取方面有积极进展。", "source": "小牛行研", "url": "", "snippet": "东吴证券2024年三季报点评标题为“屡获重大订单，隐身材料行业持续发力”，显示华秦科技在隐身材料订单获取方面有积极进展。", "date": "", "isSupplementary": false}, {"id": "fact_b4d87693", "title": "2024年华秦科技分析报告称公司为“耐温隐身龙头”，先发优势明显，新材料旗舰战略布局初步成型。", "source": "原创力文档", "url": "", "snippet": "2024年华秦科技分析报告称公司为“耐温隐身龙头”，先发优势明显，新材料旗舰战略布局初步成型。", "date": "", "isSupplementary": false}, {"id": "fact_0212d5be", "title": "2024年华秦科技分析报告包含2019-2023年公司营收及归母净利润、2019-2023年主营产品收入占比、2018-2020年隐身材料收入情况等图表，但搜索...", "source": "原创力文档", "url": "", "snippet": "2024年华秦科技分析报告包含2019-2023年公司营收及归母净利润、2019-2023年主营产品收入占比、2018-2020年隐身材料收入情况等图表，但搜索结果未给出具体数值。", "date": "", "isSupplementary": false}, {"id": "fact_1416a7e0", "title": "2024年华秦科技分析报告提到，公司董监高与核心技术人员大部分来自西北工业大学（截至2023年报）。", "source": "原创力文档", "url": "", "snippet": "2024年华秦科技分析报告提到，公司董监高与核心技术人员大部分来自西北工业大学（截至2023年报）。", "date": "", "isSupplementary": false}]}}

