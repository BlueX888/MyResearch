data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:14:14.645814", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nseg = {'Segment': ['批产收入', '研制收入'], 'Value': [12.69, 2.82]}\nd1 = pd.DataFrame(seg)\nd1['Value'] = pd.to_numeric(d1['Value'], errors='coerce')\nd1 = d1.dropna()\nbars = axes[0].bar(d1['Segment'], d1['Value'], color=['#6366f1', '#06b6d4'], width=0.55)\nfor b, v in zip(bars, d1['Value']):\n    axes[0].text(b.get_x() + b.get_width() / 2, v + 0.25, f'{v:.2f}亿', ha='center', fontsize=12, fontweight='bold')\naxes[0].set_title('光启技术超材料业务结构（2024）', fontsize=15, fontweight='bold', pad=15)\naxes[0].set_ylabel('收入（亿元）', fontsize=13)\naxes[0].tick_params(labelsize=12)\naxes[0].grid(True, linestyle='--', alpha=0.3)\nrev = {'Year': [2019, 2020, 2021, 2022, 2023, 2024], 'Revenue': [1.17, 4.14, 5.12, 6.72, 9.17, 11.45]}\nd2 = pd.DataFrame(rev)\nd2['Revenue'] = pd.to_numeric(d2['Revenue'], errors='coerce')\nd2 = d2.dropna()\naxes[1].plot(d2['Year'], d2['Revenue'], linewidth=2.5, marker='o', markersize=8, color='#10b981')\naxes[1].fill_between(d2['Year'], d2['Revenue'], alpha=0.15, color='#10b981')\nfor x, y in zip(d2['Year'], d2['Revenue']):\n    axes[1].text(x, y + 0.35, f'{y:.2f}', ha='center', fontsize=10, color='#065f46')\naxes[1].set_title('华秦科技营业收入趋势', fontsize=15, fontweight='bold', pad=15)\naxes[1].set_xlabel('年份', fontsize=13)\naxes[1].set_ylabel('营业收入（亿元）', fontsize=13)\naxes[1].tick_params(labelsize=12)\naxes[1].grid(True, linestyle='--', alpha=0.3)\ncagr = (d2['Revenue'].iloc[-1] / d2['Revenue'].iloc[0]) ** (1 / 5) - 1\nprint(f'华秦科技2019-2024营收CAGR: {cagr:.1%}')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦隐身材料/超材料供应链核心上市公司（光启技术、华秦科技、佳驰科技），选取最具代表性的数据点：光启技术2024年超材料业务拆分（批产12.69亿、研制2.82亿）与华秦科技2019-2024年营收增长轨迹（1.17→11.45亿），并计算营收CAGR作为关键统计指标。通过双面板专业图表呈现业务结构与成长性，揭示供应链核心供应商的竞争格局。"}}

