ed_at": "2026-11-10T22:32:49.558614"}, {"id": "node_18", "name": "攻击-11“利剑”", "type": "technology", "discovered_at": "2026-11-10T22:32:49.558643"}, {"id": "node_19", "name": "暗剑", "type": "technology", "discovered_at": "2026-11-10T22:32:49.558670"}, {"id": "node_20", "name": "低空经济", "type": "policy", "discovered_at": "2026-11-10T22:32:49.558682"}, {"id": "node_21", "name": "中航成飞（302132）", "type": "company", "discovered_at": "2026-11-10T22:32:57.486420"}, {"id": "node_22", "name": "中航沈飞（600760）", "type": "company", "discovered_at": "2026-11-10T22:32:57.486426"}, {"id": "node_23", "name": "中无人机（688297）", "type": "company", "discovered_at": "2026-11-10T22:32:57.486430"}, {"id": "node_24", "name": "航天彩虹（002389）", "type": "company", "discovered_at": "2026-11-10T22:32:57.486434"}, {"id": "node_25", "name": "洪都航空（600316）", "type": "company", "discovered_at": "2026-11-10T22:32:57.486439"}, {"id": "node_26", "name": "中国航空工业集团有限公司", "type": "company", "discovered_at": "2026-11-10T22:32:57.486442"}, {"id": "node_27", "name": "《无人驾驶航空器飞行管理暂行条例》", "type": "policy", "discovered_at": "2026-11-10T22:32:57.486446"}, {"id": "node_28", "name": "《通用航空装备创新应用实施方案（2024-2030年）》", "type": "policy", "discovered_at": "2026-11-10T22:32:57.486450"}, {"id": "node_29", "name": "二十大报告（2022）", "type": "policy", "discovered_at": "2026-11-10T22:32:57.486454"}, {"id": "node_30", "name": "察打一体无人机", "type": "technology", "discovered_at": "2026-11-10T22:32:57.486457"}, {"id": "node_31", "name": "隐身无人机/忠诚僚机/舰载无人机", "type": "technology", "discovered_at": "2026-11-10T22:32:57.486461"}], "edges": [{"source": "海军研究院", "relation": "发表《海上无人机及蜂群作战指挥控制系统发展》", "discovered_at": "2026-11-10T22:32:48.677704"}, {"source": "海军研究院", "relation": "关注舰载/海上无人机蜂群指挥控制", "discovered_at": "2026-11-10T22:32:48.677706"}, {"source": "丰翼科技（深圳）有限公司", "relation": "物流无人机", "discovered_at": "2026-11-10T22:32:48.677709"}, {"source": "丰翼科技（深圳）有限公司", "relation": "持有无人机起降控制专利CN112416013B", "discovered_at": "2026-11-10T22:32:48.677711"}, {"source": "丰翼科技（深圳）有限公司", "relation": "与成飞/沈飞无关联", "discovered_at": "2026-11-10T22:32:48.677712"}, {"source": "无人机蜂群/集群控制技术", "relation": "与自主控制、人工智能、协同算法相关", "discovered_at": "2026-11-10T22:32:48.677715"}, {"source": "无人机蜂群/集群控制技术", "relation": "与海上作战、舰载适配相关", "discovered_at": "2026-11-10T22:32:48.677717"}, {"source": "无人机隐身技术", "relation": "与飞翼布局、低可探测性相关", "discovered_at": "2026-11-10T22:32:48.677720"}, {"source": "无人机隐身技术", "relation": "与军事侦察打击场景相关", "discovered_at": "2026-11-10T22:32:48.677721"}, {"source": "有人无人协同/多机协同作战", "relation": "与智能指挥控制系统相关", "discovered_at": "2026-11-10T22:32:48.677725"}, {"source": "有人无人协同/多机协同作战", "relation": "与忠诚僚机概念相关（结果中未直接出现）", "discovered_at": "2026-11-10T22:32:48.677726"}, {"source": "美国蜂群计划", "relation": "被中国自媒体作为对标对象", "discovered_at": "2026-11-10T22:32:48.677729"}, {"source": "美国蜂群计划", "relation": "与无人机蜂群作战相关", "discovered_at": "2026-11-10T22:32:48.677731"}, {"source": "专利CN113156993A", "relation": "多架无人机协同作战智能指挥控制系统", "discovered_at": "2026-11-10T22:32:48.677734"}, {"source": "专利CN113156993A", "relation": "申请人为民间主体", "discovered_at": "2026-11-10T22:32:48.677735"}, {"source": "成飞（集团）公司/航空工业成飞", "relation": "翼龙系列研制方", "discovered_at": "2026-11-10T22:32:49.558491"}, {"source": "成飞（集团）公司/航空工业成飞", "relation": "云影系列研制方", "discovered_at": "2026-11-10T22:32:49.558496"}, {"source": "成飞（集团）公司/航空工业成飞", "relation": "歼击机研制基地", "discovered_at": "2026-11-10T22:32:49.558500"}, {"source": "成飞（集团）公司/航空工业成飞", "relation": "与中航无人机（翼龙产业化主体）存在产业关联待核实", "discovered_at": "2026-11-10T22:32:49.558503"}, {"source": "沈飞/中航沈飞", "relation": "攻击-11“利剑”关联方", "discovered_at": "2026-11-10T22:32:49.558512"}, {"source": "沈飞/中航沈飞", "relation": "暗剑无人机关联方", "discovered_at": "2026-11-10T22:32:49.558516"}, {"source": "沈飞/中航沈飞", "relation": "神雕、旋风侦察兵被列为旗下产品", "discovered_at": "2026-11-10T22:32:49.558519"}, {"source": "中航无人机（中无人机）", "relation": "翼龙系列产业化主体（待核实）", "discovered_at": "2026-11-10T22:32:49.558527"}, {"source": "中航无人机（中无人机）", "relation": "低空经济整机标的", "discovered_at": "2026-11-10T22:32:49.558530"}, {"source": "航天彩虹", "relation": "彩虹-3/-4/-5/-6/-7/-10研制方", "discovered_at": "2026-11-10T22:32:49.558539"}, {"source": "航天彩虹", "relation": "射手-1/-2空地导弹", "discovered_at": "2026-11-10T22:32:49.558542"}, {"source": "航天彩虹", "relation": "军贸出口代表", "discovered_at": "2026-11-10T22:32:49.558546"}, {"source": "洪都航空", "relation": "被列为“利剑系列无人机”产品方", "discovered_at": "2026-11-10T22:32:49.558554"}, {"source": "洪都航空", "relation": "与沈飞攻击-11“利剑”型号归属存在表述冲突", "discovered_at": "2026-11-10T22:32:49.558557"}, {"source": "贵航股份/贵航集团", "relation": "中航工业无人机产业基地", "discovered_at": "2026-11-10T22:32:49.558566"}, {"source": "长鹰信质/北航天宇长鹰", "relation": "中大型长航时无人机供应商", "discovered_at": "2026-11-10T22:32:49.558574"}, {"source": "长鹰信质/北航天宇长鹰", "relation": "长鹰系列、无侦-5", "discovered_at": "2026-11-10T22:32:49.558577"}, {"source": "腾盾科创", "relation": "双尾蝎TB/TB-A、扑天雕TA、混江龙TU、没羽箭HA", "discovered_at": "2026-11-10T22:32:49.558585"}, {"source": "航天电子", "relation": "彩虹、猎鹰系列配套供应商", "discovered_at": "2026-11-10T22:32:49.558594"}, {"source": "翼龙系列", "relation": "成飞研制", "discovered_at": "2026-11-10T22:32:49.558603"}, {"source": "翼龙系列", "relation": "中低空长航时察打一体", "discovered_at": "2026-11-10T22:32:49.558606"}, {"source": "翼龙系列", "relation": "外贸主力", "discovered_at": "2026-11-10T22:32:49.558609"}, {"source": "云影系列", "relation": "成飞研制", "discovered_at": "2026-11-10T22:32:49.558618"}, {"source": "云影系列", "relation": "高空高速多功能", "discovered_at": "2026-11-10T22:32:49.558634"}, {"source": "云影系列", "relation": "高端外贸", "discovered_at": "2026-11-10T22:32:49.558638"}, {"source": "攻击-11“利剑”", "relation": "隐身无人作战飞机", "discovered_at": "2026-11-10T22:32:49.558649"}, {"source": "攻击-11“利剑”", "relation": "沈飞关联", "discovered_at": "2026-11-10T22:32:49.558653"}, {"source": "攻击-11“利剑”", "relation": "洪都制造环节待核实", "discovered_at": "2026-11-10T22:32:49.558656"}, {"source": "暗剑", "relation": "沈飞关联", "discovered_at": "2026-11-10T22:32:49.558674"}, {"source": "暗剑", "relation": "高机动隐身无人作战概念机", "discovered_at": "2026-11-10T22:32:49.558678"}, {"source": "低空经济", "relation": "无人机整机与配套标的分类框架", "discovered_at": "2026-11-10T22:32:49.558686"}, {"source": "中航成飞（302132）", "relation": "被列为察打一体无人机相关上市企业", "discovered_at": "2026-11-10T22:32:57.486422"}, {"source": "中航成飞（302132）", "relation": "隶属中国航空工业集团", "discovered_at": "2026-11-10T22:32:57.486424"}, {"source": "中航沈飞（600760）", "relation": "被列为察打一体无人机相关上市企业", "discovered_at": "2026-11-10T22:32:57.486427"}, {"source": "中航沈飞（600760）", "relation": "隶属中国航空工业集团", "discovered_at": "2026-11-10T22:32:57.486428"}, {"source": "中无人机（688297）", "relation": "无人机整机上市平台", "discovered_at": "2026-11-10T22:32:57.486431"}, {"source": "中无人机（688297）", "relation": "与成飞系存在产业关联（待核实）", "discovered_at": "2026-11-10T22:32:57.486433"}, {"source": "航天彩虹（002389）", "relation": "察打一体无人机主要厂商", "discovered_at": "2026-11-10T22:32:57.486436"}, {"source": "航天彩虹（002389）", "relation": "成飞/沈飞的潜在竞品", "discovered_at": "2026-11-10T22:32:57.486437"}, {"source": "洪都航空（600316）", "relation": "被列为察打一体无人机相关上市企业", "discovered_at": "2026-11-10T22:32:57.486440"}, {"source": "中国航空工业集团有限公司", "relation": "成飞与沈飞的共同母公司", "discovered_at": "2026-11-10T22:32:57.486443"}, {"source": "中国航空工业集团有限公司", "relation": "军用无人机主要研制主体", "discovered_at": "2026-11-10T22:32:57.486444"}, {"source": "《无人驾驶航空器飞行管理暂行条例》", "relation": "规范无人机发展", "discovered_at": "2026-11-10T22:32:57.486447"}, {"source": "《无人驾驶航空器飞行管理暂行条例》", "relation": "影响无人机商业化路径", "discovered_at": "2026-11-10T22:32:57.486448"}, {"source": "《通用航空装备创新应用实施方案（2024-2030年）》", "relation": "低空经济/通航装备政策", "discovered_at": "2026-11-10T22:32:57.486451"}, {"source": "《通用航空装备创新应用实施方案（2024-2030年）》", "relation": "间接影响无人机产业", "discovered_at": "2026-11-10T22:32:57.486452"}, {"source": "二十大报告（2022）", "relation": "提出加快无人智能作战力量发展", "discovered_at": "2026-11-10T22:32:57.486455"}, {"source": "察打一体无人机", "relation": "多用途无人机主流形态", "discovered_at": "2026-11-10T22:32:57.486458"}, {"source": "察打一体无人机", "relation": "2023年中国市场规模524.78亿元", "discovered_at": "2026-11-10T22:32:57.486460"}, {"source": "隐身无人机/忠诚僚机/舰载无人机", "relation": "行业升级方向", "discovered_at": "2026-11-10T22:32:57.486463"}, {"source": "隐身无人机/忠诚僚机/舰载无人机", "relation": "本次搜索结果中缺乏具体型号与企业归属证据", "discovered_at": "2026-11-10T22:32:57.486464"}]}, "stats": {"entitiesCount": 32, "relationsCount": 66}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T22:32:57.486585", "content": {"agent": "DeepScout", "section": "市场概况", "facts_count": 7, "duplicates_removed": 0, "data_points_count": 8, "insights": ["现有搜索结果几乎全部是行业总量层面的二手报告摘要，缺乏成飞与沈飞公司层面的产品谱系、订单、研发投入等一手数据，无法直接回答'布局差异'这一核心问题。", "察打一体是中国军用无人机中规模最大、数据最可得的细分市场（2023年约524.78亿元，增速21.58%），但该赛道的头部整机厂商更多指向航天彩虹、中无人机等，成飞/沈飞在该赛道的相对地位需进一步核实。", "成飞系存在独立的无人机上市平台（中无人机688297），而沈飞未见对应的无人机独立资本平台，这一结构性差异可能是'成飞偏外贸/察打一体、沈飞偏军方立项/隐身与舰载'假设的间接线索，但需一手资料验证。"], "source_quality": "整体质量偏低。7条结果中无一条来自政府、军方或企业官方渠道，也无学术论文；核心数据（524.78亿元、21.58%、600亿元）均出自智研咨询报告，但仅通过财经头条、新浪看点等自媒体账号转载摘要，原始报告未公开、口径不明，可信度约0.45-0.55。中商情报网、观研报告网、经济管理文库为报告目录或二手汇编，信息颗粒度停留在目录层级。人人文库为文档分享平台，权威性最低（0.35）。新浪财经投资者问答虽为一手互动记录，但属公司模糊表述，无量化信息。所有来源均未涉及成飞与沈飞的具体型号、订单、专利或中标信息，对本研究问题的直接证据贡献接近于零，仅能作为行业背景与市场规模的基础参照，且需通过原始报告与官方披露进行追溯验证。", "hypothesis_updates": 3, "search_results": [{"title": "投资者提问:你好!能否筒单介绍一下察打一体无人机和隐身无人机的全球发展趋势...无人机_新浪财经_新浪网", "url": "https://finance.sina.com.cn/stock/relnews/dongmiqa/2022-03-23/doc-imcwiwss7658208.shtml", "source": "新浪财经", "snippet": "您好,从产品技术的发展趋势上看,全球无人机行业正朝着高端智能化、高机动性、隐身、低成本集群化、高空及超长航时等方向发展。从市场规模看,根据相关研究机构预测,预计未来几年,军、民用(工业级,下同)无人机增速将保持在15%至30%左右。从应用模式上看,无人机行业将向功能模块定制化服务、数据获取服务等方向发展。公司背靠科研院所,技术升级的潜力、稳定性、抗风险能力较强,研发能力优势明显。从长期看,各国国防及民用领域的无人装备将持续扩大规模并逐渐占据主导。公司希望通过努力,可以在未来争取到更大的市占率。相信公司的市场价格将回归公司价值。感谢您对公司的关注!", "date": "2022-03-23T15:42:00+08:00"}, {"title": "2024-2029全球及中国军用无人机行业发展现状调研及投资前景分析报告-中商产业研究院", "url": "https://www.askci.com/reports/20200325/0853244455874053.shtml", "source": "中商情报网", "snippet": "1\n军用无人机市场概述1.1\n军用无人机产品定义及统计范围1.2.1\n不同产品类型军用无人机增长趋势2020\nVS\n20261.2.2\n固定翼1.2.3\n旋翼1.2.4\n混合动力1.3\n从不同应用,军用无人机主要包括如下几个方面1.3.1\n侦查1.3.2\n攻击1.3.3\n其他应用1.4\n全球与中国发展现状对比1.4.1\n全球发展现状及未来趋势1.4.2\n中国生产发展现状及未来趋势1.5\n全球军用无人机供需现状及预测1.5.1\n全球军用无人机产能、产量、产能利用率及发展趋势1.5.2\n全球军用无人机产量、表观消费量及发展趋势1.6\n中国军用无人机供需现状及预测1.6.1\n中国军用无人机产能、产量、产能利用率及发展趋势1.6.2\n中国军用无人机产量、表观消费量及发展趋势1.6.3\n中国军用无人机产量、市场需求量及发展趋势1.7\n军用无人机中国及欧美日等行业政策分析2\n全球与中国主要厂商军用无人机产量、产值及竞争分析2.1\n全球军用无人机主要厂商列表2.1.1\n全球军用无人机主要厂商产量列表2.1.2\n全球军用无人机主要厂商产值列表2.1.3\n2019年全球主要生产商军用无人机收入排名2.1.4\n全球军用无人机主要厂商产品价格列表2.2\n中国军用无人机主要厂商产量、产值及市场份额2.2.1\n中国军用无人机主要厂商产量列表2.2.2\n中国军用无人机主要厂商产值列表2.3\n军用无人机厂商产地分布及商业化日期2.4\n军用无人机行业集中度、竞争程度分析2.4.1\n军用无人机行业集中度分析:全球Top\n5和Top\n10生产商市场份额2.4.2\n全球军用无人机第一梯队、第二梯队和第三梯队生产商(品牌)及市场份额(2018\nVS\n2019)2.5\n军用无人机全球领先企业SWOT分析2.6\n全球主要军用无人机企业采访及观点3\n全球军用无人机主要生产地区分析3.1\n全球主要地区军用无人机市场规模", "date": "2026-04-14T17:38:16+08:00"}, {"title": "察打一体无人机行业概况：无人机应用广泛，市场规模呈现上升趋势", "url": "https://cj.sina.cn/articles/view/7829375716/1d2aacae400101fham", "source": "财经头条", "snippet": "内容概要: 在现代战争的舞台上,无人机已经成为不可或缺的重要角色。中国,作为世界军事大国之一,其军用无人机的发展更是日新月异,种类繁多,性能卓越。从侦察无人机到察打一体无人机,从制空无人机到运输无人机,中国军用无人机以其独特的优势和广泛的应用领域,成为了国家安全和军事战略的重要支撑。察打一体无人机作为中国军用无人机中的重要组成部分,它不仅具备侦察能力,还能执行打击任务,是现代战争中不可或缺的“杀手锏”。为了提升国防实力和维护国家安全,我国加大了对察打一体无人机的研发和采购投入,出台了一系列鼓励和规范察打一体无人机发展的政策和措施,如《无人驾驶航空器飞行管理暂行条例》、《通用航空装备创新应用实施方案(2024-2030年)》等。在这些政策的作用下,我国察打一体无人机行业市场规模不断上升。据统计,2023年中国察打一体无人机行业市场规模达到524.78亿元,同比上涨21.58%,估计2024年行业市场规模达到600亿元以上。\n相关上市企业: 中航机载(600372)、航天彩虹(002389)、威海广泰(002111)、中无人机(688297)、航天电子(600879)、纵横股份(688070)、中航成飞(302132)、中航沈飞(600760)、洪都航空(600316)、华力创通(300045)等。\n相关企业 :中国航空科技工业股份有限公司、中国航空工业集团有限公司、中国航空发动机集团有限公司、重庆宗申动力机械股份有限公司、成都飞机工业(集团)有限责任公司、航天神舟飞行器有限公司、北方天途航空技术发展(北京)有限公司、东方哨兵(北京)科技有限公司、成都安则科技有限公司等。\n关键词:察打一体无人机、军用无人机、市场规模、“彩虹”、“翼龙”\n一、察打一体无人机行业相关概述\n无人机是利用无线电遥控设备和自备的程序控制装置操纵的不载人飞机。行业通常以用途来对无人机进行划分,并对其分为军", "date": "2025-04-03T21:49:00+08:00"}, {"title": "察打一体无人机行业概况：无人机应用广泛，市场规模呈现上升趋势", "url": "https://k.sina.cn/article_7829375716_1d2aacae400101fham.html", "source": "新浪看点", "snippet": "内容概要: 在现代战争的舞台上,无人机已经成为不可或缺的重要角色。中国,作为世界军事大国之一,其军用无人机的发展更是日新月异,种类繁多,性能卓越。从侦察无人机到察打一体无人机,从制空无人机到运输无人机,中国军用无人机以其独特的优势和广泛的应用领域,成为了国家安全和军事战略的重要支撑。察打一体无人机作为中国军用无人机中的重要组成部分,它不仅具备侦察能力,还能执行打击任务,是现代战争中不可或缺的“杀手锏”。为了提升国防实力和维护国家安全,我国加大了对察打一体无人机的研发和采购投入,出台了一系列鼓励和规范察打一体无人机发展的政策和措施,如《无人驾驶航空器飞行管理暂行条例》、《通用航空装备创新应用实施方案(2024-2030年)》等。在这些政策的作用下,我国察打一体无人机行业市场规模不断上升。据统计,2023年中国察打一体无人机行业市场规模达到524.78亿元,同比上涨21.58%,估计2024年行业市场规模达到600亿元以上。\n   相关上市企业: 中航机载(600372)、航天彩虹(002389)、威海广泰(002111)、中无人机(688297)、航天电子(600879)、纵横股份(688070)、中航成飞(302132)、中航沈飞(600760)、洪都航空(600316)、华力创通(300045)等。\n   相关企业 :中国航空科技工业股份有限公司、中国航空工业集团有限公司、中国航空发动机集团有限公司、重庆宗申动力机械股份有限公司、成都飞机工业(集团)有限责任公司、航天神舟飞行器有限公司、北方天途航空技术发展(北京)有限公司、东方哨兵(北京)科技有限公司、成都安则科技有限公司等。\n   关键词:察打一体无人机、军用无人机、市场规模、“彩虹”、“翼龙”\n   一、察打一体无人机行业相关概述\n   无人机是利用无线电遥控设备和自备的程序控制装置操纵的不载人飞机。行业通常以", "date": "2025-04-03T21:49:00+08:00"}, {"title": "无人机_观研报告网", "url": "https://www.chinabaogao.com/tag/wurenji?page=2", "source": "行业数据网", "snippet": "随着无人机产业发展不断发展,逐渐从军用领域延伸到了民用领域,并且民用无人机市场呈现出迅猛增长的态势。据有关数据统计,2013年中国无人机行业市场规模已达88亿元。2014年中国无人机行业市场规模突破百亿元。截止至2017年中国无人机行业市场规模约为151亿元,其中,民用无人机市场规模为83亿元,军用无人机市场规模为68亿元。", "date": "2019-09-26T00:00:00+08:00"}, {"title": "察打一体无人机行业概况：无人机应用广泛，市场规模呈现上升趋势", "url": "https://k.sina.cn/article_7829375716_1d2aacae400101fham.html?from=mil&pos=24&vt=4", "source": "新浪看点", "snippet": "关注 \n内容概要: 在现代战争的舞台上,无人机已经成为不可或缺的重要角色。中国,作为世界军事大国之一,其军用无人机的发展更是日新月异,种类繁多,性能卓越。从侦察无人机到察打一体无人机,从制空无人机到运输无人机,中国军用无人机以其独特的优势和广泛的应用领域,成为了国家安全和军事战略的重要支撑。察打一体无人机作为中国军用无人机中的重要组成部分,它不仅具备侦察能力,还能执行打击任务,是现代战争中不可或缺的“杀手锏”。为了提升国防实力和维护国家安全,我国加大了对察打一体无人机的研发和采购投入,出台了一系列鼓励和规范察打一体无人机发展的政策和措施,如《无人驾驶航空器飞行管理暂行条例》、《通用航空装备创新应用实施方案(2024-2030年)》等。在这些政策的作用下,我国察打一体无人机行业市场规模不断上升。据统计,2023年中国察打一体无人机行业市场规模达到524.78亿元,同比上涨21.58%,估计2024年行业市场规模达到600亿元以上。\n相关上市企业: 中航机载(600372)、航天彩虹(002389)、威海广泰(002111)、中无人机(688297)、航天电子(600879)、纵横股份(688070)、中航成飞(302132)、中航沈飞(600760)、洪都航空(600316)、华力创通(300045)等。\n相关企业 :中国航空科技工业股份有限公司、中国航空工业集团有限公司、中国航空发动机集团有限公司、重庆宗申动力机械股份有限公司、成都飞机工业(集团)有限责任公司、航天神舟飞行器有限公司、北方天途航空技术发展(北京)有限公司、东方哨兵(北京)科技有限公司、成都安则科技有限公司等。\n关键词:察打一体无人机、军用无人机、市场规模、“彩虹”、“翼龙”\n一、察打一体无人机行业相关概述\n无人机是利用无线电遥控设备和自备的程序控制装置操纵的不载人飞机。行业通常以用途来对无人机进行划分,并对", "date": "2025-04-03T21:49:00+08:00"}, {"title": "全球及中国军用无人机行业现状及发展趋势分析", "url": "https://m.renrendoc.com/paper/339518590.html", "source": "人人文库", "snippet": "上传人:1*** IP属地:广东 上传时间:2024-07-25 格式:DOC 页数:3 大小:14.27KB 积分:28\n文档描述\n-1-全球及中国军用无人机行业现状及发展趋势分析一、军用无人机产业概述无人机是指没有驾驶人员、可携带任务载荷、可重复使用、以无线电遥控或者自身程序控制为主的新型航空器。按照无人机用途划分,可分为军用无人机和民用无人机。军用无人机按照作战用途可以分为单用途无人机和多用途无人机,单用途无人机按照任务又可以划分侦察机、战斗机、电子干扰机、通信中继无人机等,多用途无人机主要指察打一体无人机。世界各国军队都非常注重察打一体无人机应用能力的开发、验证和试用,察打一体无人机是未来无人机发展的重要方向。二、军用无人机行业发展背景1、军用无人机行业相关政策无人机作为装备智能化、无人化、远程化的重要一环,持续受到政策促进。2022年10月国务院发布《二十大报告》,将加快无人智能作战力量发展。政策频繁提出实现武器的远程化、智能化、无人化,为国防装备未来发展方向做出指引,将有效促进无人机相关技术的突破和军用无人机产业的快速发展。2、中国国防预算情况中国国防预算持续保持稳定增长,在2022年增速再次突破7%。2023年中国国防预算约15537亿元。三、军用无人机行业产业链军用无人机产业链一般由基础构件制造、核心部件制造、总体设计与集成以及销售服务四部分组成。其中核心部件制造、总体设计与集成为产业链关键环节。核心部件包括无人机的动力系统(发动机)、地面系统(飞行控制、数据链通信导航及载荷控制等)以及任务载荷(光电传感器、合成孔径雷达及武器管理等);无人机总体技术一般由主机厂根据任务需求制定总体方案。产业链上游的无人机整机设计研发、核心部件开发等关键环节空间利润最大。四、全球军用无人机行业现状分析1、全球军用无人机行业市场规模根据数据显示,2019-2028年全球军用无人", "date": "2024-07-26T00:19:55+08:00"}, {"title": "2025年中国察打一体无人机行业市场现状分析及发展趋势预测报告(智研咨询发布)_领域", "url": "https://www.sohu.com/a/879118492_120950077", "source": "搜狐", "snippet": "2025-04-03 09:10 内容概要: 在现代战争的舞台上,无人机已经成为不可或缺的重要角色。中国,作为世界军事大国之一,其军用无人机的发展更是日新月异,种类繁多,性能卓越。从侦察无人机到察打一体无人机,从制空无人机到运输无人机,中国军用无人机以其独特的优势和广泛的应用领域,成为了国家安全和军事战略的重要支撑。察打一体无人机作为中国军用无人机中的重要组成部分,它不仅具备侦察能力,还能执行打击任务,是现代战争中不可或缺的“杀手锏”。为了提升国防实力和维护国家安全,我国加大了对察打一体无人机的研发和采购投入,出台了一系列鼓励和规范察打一体无人机发展的政策和措施,如《无人驾驶航空器飞行管理暂行条例》、《通用航空装备创新应用实施方案(2024-2030年)》等。在这些政策的作用下,我国察打一体无人机行业市场规模不断上升。据统计,2023年中国察打一体无人机行业市场规模达到524.78亿元,同比上涨21.58%,估计2024年行业市场规模达到600亿元以上。 相关上市企业: 中航机载(600372)、航天彩虹(002389)、威海广泰(002111)、中无人机(688297)、航天电子(600879)、纵横股份(688070)、中航成飞(302132)、中航沈飞(600760)、洪都航空(600316)、华力创通(300045)等。 相关企业 :中国航空科技工业股份有限公司、中国航空工业集团有限公司、中国航空发动机集团有限公司、重庆宗申动力机械股份有限公司、成都飞机工业(集团)有限责任公司、航天神舟飞行器有限公司、北方天途航空技术发展(北京)有限公司、东方哨兵(北京)科技有限公司、成都安则科技有限公司等。 关键词:察打一体无人机、军用无人机、市场规模、“彩虹”、“翼龙” 一、察打一体无人机行业相关概述 ‌无人机是利用无线电遥控设备和自备的程序控制装置操纵的不载人飞机。行业通", "date": "2025-04-03T09:10:00+08:00"}, {"title": "军用无人机市场分析( 47 页)-经济管理文库", "url": "https://hy.chnmc.com/hyjj/hyfx/2022-11-07/12547.html", "source": "论文资料网", "snippet": "军用无人机市场分析(\n47\n页)\n目录1.\n无人机定位在逐渐改变,从辅助力量变为主力力量,我国正值产业链快速发展期.......\n61.1.\n无人机具备作战优势\n.....\n61.2.\n无人机具备侦察、协同、作战等全方位能力,作战模式多样化\n......\n61.3.\n无人机在战场中应用日益广泛\n.......\n81.4.\n2023\n年美军无人机投入大幅上升,现有无人机数量庞大\n....\n81.5.\n我国具备无人机发展条件,产业链正值快速发展期....\n91.6.\n我国无人机技术已后来居上,部分性能超越国际先进水平\n....112.\n军用无人机行业分析....\n132.1.\n全球军用无人机市场现状与发展前景\n.......\n132.1.1.\n全球无人机市场:规模快速上升,军用占比最大\n....\n132.1.2.\n全球军用无人机市场:北美地区是最大军用无人机市场\n......\n152.1.3.\n军用无人机竞争梯队:美国占据优势,中国技术不断提升\n......\n162.2.\n中国军用无人机市场现状与发展前景\n.......\n172.2.1.\n中国军用无人机的发展历程及现状:我国军用无人机主要由各大军工集团研制172.2.2.\n中国军用无人机市场:增速高于全球军用无人机市场预期增长\n.......\n212.3.\n全球军用无人机军贸市场:以、美、中三国出口占据全球市场主要份额\n......\n222.4.\n中国军用无人机现状与发展前景\n......\n232.4.1.\n中国无人机军贸出口占据性价比优势\n......\n232.4.2.\n中国无人机军贸发展前景:已在多国开拓渠道,高性价比备受青睐\n....\n232.5.\n军用无人机行业发展现状与技术趋势\n.......\n242.5.1.\n军用无人机发展现状:新型作战概念不断涌现,无人机型号持续推陈出新\n......\n242.5.2.\n军用无", "date": "2022-11-07T00:00:00+08:00"}], "extracted_facts": [{"content": "全球无人机行业正朝高端智能化、高机动性、隐身、低成本集群化、高空及超长航时方向发展；预计未来几年军、民用无人机增速将保持在15%至30%左右。该表述来自上市公司（投资者问答）对行业趋势的回复，未点名具体企业。", "source_name": "新浪财经（投资者问答）", "source_url": "https://finance.sina.com.cn/stock/relnews/dongmiqa/2022-03-23/doc-imcwiwss7658208.shtml", "credibility": 0.55}, {"content": "2023年中国察打一体无人机行业市场规模达524.78亿元，同比上涨21.58%；估计2024年市场规模达600亿元以上。文中将中航成飞（302132）、中航沈飞（600760）、中无人机（688297）、航天彩虹（002389）、洪都航空（600316）等列为相关上市企业，但未区分各家在察打一体领域的具体产品与份额。", "source_name": "财经头条/新浪看点（转载智研咨询报告摘要）", "source_url": "https://cj.sina.cn/articles/view/7829375716/1d2aacae400101fham", "credibility": 0.5}, {"content": "中国已出台《无人驾驶航空器飞行管理暂行条例》《通用航空装备创新应用实施方案（2024-2030年）》等政策，鼓励和规范察打一体无人机发展；文章称我国加大了对察打一体无人机的研发和采购投入。", "source_name": "新浪看点（智研咨询报告摘要）", "source_url": "https://k.sina.cn/article_7829375716_1d2aacae400101fham.html", "credibility": 0.45}, {"content": "军用无人机按用途可分为单用途（侦察、战斗、电子干扰、通信中继等）与多用途（察打一体）；察打一体无人机被视为未来无人机发展的重要方向。2022年10月《二十大报告》提出加快无人智能作战力量发展；2023年中国国防预算约15537亿元。", "source_name": "人人文库（行业分析文档）", "source_url": "https://m.renrendoc.com/paper/339518590.html", "credibility": 0.35}, {"content": "中商产业研究院《2024-2029全球及中国军用无人机行业发展现状调研及投资前景分析报告》目录显示，其按固定翼/旋翼/混合动力分类，按侦查/攻击/其他应用分类，并包含全球与中国主要厂商产量、产值、市场份额及2019年全球主要生产商收入排名等章节，但公开页面未披露具体厂商数据。", "source_name": "中商情报网", "source_url": "https://www.askci.com/reports/20200325/0853244455874053.shtml", "credibility": 0.6}, {"content": "2017年中国无人机行业市场规模约151亿元，其中民用83亿元、军用68亿元；行业由军用向民用延伸。数据较早，仅反映历史基数。", "source_name": "观研报告网", "source_url": "https://www.chinabaogao.com/tag/wurenji?page=2", "credibility": 0.5}, {"content": "全球军用无人机市场中北美为最大区域市场，美国占据竞争优势，中国技术不断提升；中国军用无人机增速高于全球预期增速；全球军贸出口以以色列、美国、中国三国占据主要份额。中国军用无人机主要由各大军工集团研制。", "source_name": "经济管理文库（军用无人机市场分析）", "source_url": "https://hy.chnmc.com/hyjj/hyfx/2022-11-07/12547.html", "credibility": 0.45}], "data_points": [{"name": "无人机行业增速预测区间", "value": "15-30", "unit": "%", "year": 2022, "source": "新浪财经（投资者问答）"}, {"name": "中国察打一体无人机市场规模", "value": "524.78", "unit": "亿元", "year": 2023, "source": "财经头条/新浪看点（转载智研咨询报告摘要）"}, {"name": "中国察打一体无人机市场规模同比增速", "value": "21.58", "unit": "%", "year": 2023, "source": "财经头条/新浪看点（转载智研咨询报告摘要）"}, {"name": "中国察打一体无人机市场规模（预测）", "value": "600+", "unit": "亿元", "year": 2024, "source": "财经头条/新浪看点（转载智研咨询报告摘要）"}, {"name": "中国国防预算", "value": "15537", "unit": "亿元", "year": 2023, "source": "人人文库（行业分析文档）"}, {"name": "中国无人机行业市场规模", "value": "151", "unit": "亿元", "year": 2017, "source": "观研报告网"}, {"name": "中国军用无人机市场规模", "value": "68", "unit": "亿元", "year": 2017, "source": "观研报告网"}, {"name": "中国民用无人机市场规模", "value": "83", "unit": "亿元", "year": 2017, "source": "观研报告网"}]}}

