data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T22:32:21.089648", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述全球及中国军用无人机市场规模、增速，重点拆分察打一体、隐身作战、忠诚僚机、舰载无人机等细分市场，并分析成飞与沈飞所处细分赛道的需求特征。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["全球军用无人机市场规模 增速 察打一体无人机 隐身无人机 忠诚僚机 舰载无人机 中国无人机产业"]}, {"id": "sec_2", "title": "竞争格局", "description": "梳理成飞、沈飞在无人机领域的产品谱系、业务主体和产业化平台，对比航天彩虹、洪都航空、中航无人机等主要参与者，分析两家企业在整机研制、外贸出口和军方配套中的竞争位置。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 无人机 翼龙 云影 产品谱系 沈飞 无人机 利剑 暗剑 攻击-11 航天彩虹 洪都航空 竞争格局"]}, {"id": "sec_3", "title": "技术趋势", "description": "分析长航时察打一体、隐身飞翼布局、自主控制与人工智能、蜂群作战、有人无人协同、舰载适配等核心技术方向，比较成飞与沈飞的技术积累、研发重点和型号验证进展。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["无人机 长航时 隐身飞翼 自主控制 蜂群 有人无人协同 舰载无人机 成飞 沈飞 技术专利"]}, {"id": "sec_4", "title": "政策环境", "description": "梳理军品出口管制、国防装备采购立项、军民融合、低空经济等政策，分析政策对成飞外贸型无人机和沈飞军方主导型无人机项目的差异化影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军用无人机 出口管制 军贸政策 国防采购 装备立项 军民融合 低空经济 无人机产业政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "识别成飞与沈飞在无人机业务中面临的挑战，包括订单波动、技术转化周期、供应链配套、出口限制和体系化竞争，同时分析外贸需求、有人无人协同和舰载化带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 无人机 挑战 订单 供应链 出口限制 沈飞 无人机 机遇 体系化 舰载 外贸"]}, {"id": "sec_6", "title": "未来展望", "description": "展望成飞与沈飞无人机布局的演进方向，判断成飞是否继续强化察打一体外贸谱系，沈飞是否加速隐身作战和舰载无人机体系化发展，并分析两家企业在未来无人机作战体系中的分工与竞合关系。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 无人机 未来 发展 沈飞 隐身无人机 舰载无人机 忠诚僚机 体系化 竞合"]}], "research_questions": ["成飞与沈飞在无人机产品谱系、目标市场和研发重点上的核心差异是什么？", "两家企业的布局差异分别受哪些技术、市场和政策因素驱动？", "未来成飞与沈飞在无人机作战体系和外贸市场中是互补分工还是直接竞争？"]}}

