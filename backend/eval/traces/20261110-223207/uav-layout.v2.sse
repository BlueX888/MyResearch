data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:39:50.715705", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Team': ['成飞(翼龙)', '沈飞(利剑)'], 'Start': [2005, 2009], 'First_Flight': [2007, 2013]}\ndf = pd.DataFrame(data)\nfor col in ['Start', 'First_Flight']:\n    df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\ndf['Cycle'] = df['First_Flight'] - df['Start']\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\ncolors = ['#6366f1', '#06b6d4']\nbars = ax1.barh(df['Team'], df['Cycle'], color=colors, height=0.5)\nfor bar, val in zip(bars, df['Cycle']):\n    ax1.text(bar.get_width() + 0.05, bar.get_y() + bar.get_height() / 2, str(val) + '年', va='center', fontsize=12, fontweight='bold')\nax1.set_title('立项到首飞研发周期对比', fontsize=16, fontweight='bold', pad=15)\nax1.set_xlabel('年数', fontsize=14)\nax1.tick_params(labelsize=12)\nrev = {'Year': [2020, 2021, 2022, 2023], 'Revenue': [12.17, 24.76, 27.73, 26.64]}\nrdf = pd.DataFrame(rev)\nrdf['Revenue'] = pd.to_numeric(rdf['Revenue'], errors='coerce')\nrdf = rdf.dropna()\nax2 = axes[1]\nax2.plot(rdf['Year'], rdf['Revenue'], linewidth=2.5, marker='o', markersize=8, color='#10b981')\nax2.fill_between(rdf['Year'], rdf['Revenue'], alpha=0.15, color='#10b981')\nfor x, y in zip(rdf['Year'], rdf['Revenue']):\n    ax2.text(x, y + 0.8, str(y), ha='center', fontsize=11, fontweight='bold')\nax2.set_title('成飞系中无人机营收趋势', fontsize=16, fontweight='bold', pad=15)\nax2.set_xlabel('年份', fontsize=14)\nax2.set_ylabel('营收（亿元）', fontsize=14)\nax2.tick_params(labelsize=12)\nplt.suptitle('成飞 vs 沈飞 无人机布局差异', fontsize=18, fontweight='bold')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从数据中提炼成飞（翼龙/云影，中无人机）与沈飞（利剑/攻击-11）在无人机布局上的核心差异：1) 立项到首飞的研发周期对比（成飞2005→2007，沈飞2009→2013）；2) 产品路线差异（成飞走察打一体外贸路线，沈飞走隐身作战路线）；3) 成飞系中无人机营收趋势佐证其商业化落地能力。用双子图呈现：左侧横向条形图对比研发周期，右侧折线图展示中无人机营收增长。"}}

