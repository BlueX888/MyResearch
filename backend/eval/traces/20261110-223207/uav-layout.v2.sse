data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T22:39:41.317969", "content": {"charts": [{"id": "chart_001", "title": "中国察打一体无人机市场规模", "subtitle": "2023-2024年（亿元，2024年为估计下限）", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "top": "18%", "containLabel": true}, "tooltip": {"trigger": "axis"}, "xAxis": {"type": "category", "data": ["2023", "2024"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "亿元", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "line", "data": [524.78, 600], "smooth": true, "symbol": "circle", "symbolSize": 10, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "label": {"show": true, "position": "top", "color": "#1677ff", "formatter": "{c}"}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.25)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}}]}}, {"id": "chart_002", "title": "无人机行业增速对比", "subtitle": "中国察打一体（2023）与全球行业预期区间（%）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "top": "18%", "containLabel": true}, "tooltip": {"trigger": "axis"}, "xAxis": {"type": "category", "data": ["中国察打一体\n(2023)", "全球增速\n下限", "全球增速\n上限"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "fontSize": 11}}, "yAxis": {"type": "value", "name": "%", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "bar", "barWidth": 40, "data": [{"value": 21.58, "itemStyle": {"color": "#1677ff"}}, {"value": 15, "itemStyle": {"color": "#52c41a"}}, {"value": 30, "itemStyle": {"color": "#fa8c16"}}], "label": {"show": true, "position": "top", "color": "#666", "formatter": "{c}%"}}]}}, {"id": "chart_003", "title": "世界察打一体无人机市场品牌份额", "subtitle": "中国品牌合计占比（%）", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}: {c}%"}, "legend": {"bottom": "2%", "textStyle": {"color": "#666"}}, "series": [{"type": "pie", "radius": ["45%", "70%"], "center": ["50%", "45%"], "avoidLabelOverlap": true, "itemStyle": {"borderColor": "#fff", "borderWidth": 2}, "label": {"show": true, "formatter": "{b}\n{c}%", "color": "#666"}, "data": [{"value": 90, "name": "彩虹/翼龙/云影合计", "itemStyle": {"color": "#1677ff"}}, {"value": 10, "name": "其他品牌", "itemStyle": {"color": "#e8e8e8"}}]}]}}, {"id": "chart_004", "title": "翼龙/云影系列研制关键节点", "subtitle": "成飞系无人机重要里程碑年份", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "22%", "right": "12%", "top": "8%", "bottom": "5%", "containLabel": true}, "tooltip": {"trigger": "axis"}, "xAxis": {"type": "value", "show": false, "min": 2000, "max": 2020}, "yAxis": {"type": "category", "data": ["云影公开亮相", "翼龙性能试飞完成", "翼龙首飞", "翼龙研制启动"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 12}}, "series": [{"type": "bar", "barWidth": 14, "data": [{"value": 2016, "itemStyle": {"color": "#722ed1"}}, {"value": 2008, "itemStyle": {"color": "#1677ff"}}, {"value": 2007, "itemStyle": {"color": "#1677ff"}}, {"value": 2005, "itemStyle": {"color": "#1677ff"}}], "label": {"show": true, "position": "right", "color": "#666", "formatter": "{c}"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}]}}

