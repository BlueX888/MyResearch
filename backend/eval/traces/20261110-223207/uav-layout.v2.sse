data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:40:01.997868", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'年份': [2023, 2024], '市场规模': [524.78, 600]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['年份'], df['市场规模'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='市场规模')\nplt.fill_between(df['年份'], df['市场规模'], alpha=0.15, color='#6366f1')\nfor i, row in df.iterrows():\n    label = f\"{row['市场规模']:.2f}\" if row['年份'] == 2023 else \"600+\"\n    plt.text(row['年份'], row['市场规模'] + 10, label, ha='center', fontsize=11, fontweight='bold')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿元）', fontsize=14)\nplt.xticks(df['年份'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

data: {"type": "chart", "agent": "CodeWizard", "timestamp": "2026-11-10T22:40:02.137447", "content": {"agent": "CodeWizard", "title": "市场概况", "chart_type": "generated", "image_base64": ""}}

data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:41:07.898426", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# 数据准备\ncategories = ['2005', '2007', '2008', '2016', '2020', '2022', '2023', '2024']\nvalues = [1, 1, 1, 1, 90, 22.5, 524.78, 600]\n\n# 创建图表\nplt.figure(figsize=(12, 7), dpi=200)\n\n# 绘制折线图\nplt.plot(categories, values, marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='关键指标')\n\n# 添加面积填充\nplt.fill_between(categories, values, alpha=0.15, color='#6366f1')\n\n# 添加数据标签\nfor i, v in enumerate(values):\n    plt.text(i, v + 10, str(v), ha='center', fontsize=11, fontweight='bold')\n\n# 设置标题和标签\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('数值', fontsize=14)\n\n# 设置刻度字体\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\n\n# 网格线\nplt.grid(True, linestyle='--', alpha=0.3)\n\n# 去除边框\nsns.despine()\n\n# 保存图表\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')\n\n# 显示图表\nplt.show()", "purpose": "生成图表: 竞争格局"}}

