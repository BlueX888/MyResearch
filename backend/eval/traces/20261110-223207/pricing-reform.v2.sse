data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:33:10.496308", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2018, 2019, 2019, 2024], 'Value': [8.1, 4.5, 10.5, 8.5], 'Series': ['实际/当前', '实际/当前', '目标/预测', '目标/预测']}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx1 = df[df['Series']=='实际/当前']['Year']\ny1 = df[df['Series']=='实际/当前']['Value']\nplt.plot(x1, y1, marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='实际/当前指标')\nplt.fill_between(x1, y1, alpha=0.15, color='#6366f1')\nx2 = df[df['Series']=='目标/预测']['Year']\ny2 = df[df['Series']=='目标/预测']['Value']\nplt.plot(x2, y2, marker='s', markersize=8, linewidth=2.5, color='#f59e0b', label='目标/预测指标')\nplt.fill_between(x2, y2, alpha=0.15, color='#f59e0b')\nfor x, y in zip(x1, y1):\n    plt.text(x, y+0.3, f'{y}%', ha='center', fontsize=11)\nfor x, y in zip(x2, y2):\n    plt.text(x, y+0.3, f'{y}%', ha='center', fontsize=11)\nplt.title('军工主机厂市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('百分比 (%)', fontsize=14)\nplt.xticks([2018, 2019, 2024], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 军工主机厂市场概况"}}

