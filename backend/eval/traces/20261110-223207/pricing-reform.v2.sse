data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:38:48.709595", "content": {"results": [{"id": "fact_d8c573fd", "title": "据IMF《世界经济展望》2026年10月预测值，按市场汇率折算，美国名义GDP约32.64万亿美元，中国约21.55万亿美元，印度约4.06万亿美元（全球第六）...", "source": "今日头条（转引IMF WEO）", "url": "", "snippet": "据IMF《世界经济展望》2026年10月预测值，按市场汇率折算，美国名义GDP约32.64万亿美元，中国约21.55万亿美元，印度约4.06万亿美元（全球第六）。该数据可作为计算军费占GDP比重的分母参考。", "date": "", "isSupplementary": true}, {"id": "fact_36345f08", "title": "同一IMF数据库按购买力平价（PPP）口径：中国44.55万亿国际美元、美国32.64万亿、印度19.19万亿（第三）。若用PPP口径作分母，军费占GDP比重会...", "source": "腾讯网（转引IMF WEO）", "url": "", "snippet": "同一IMF数据库按购买力平价（PPP）口径：中国44.55万亿国际美元、美国32.64万亿、印度19.19万亿（第三）。若用PPP口径作分母，军费占GDP比重会显著低于名义汇率口径，这是跨国比较军费负担时的重要口径差异。", "date": "", "isSupplementary": true}, {"id": "fact_de6b0224", "title": "2026年3月10日中国国防部公布当年国防预算：全国一般公共预算安排国防支出1.94万亿元人民币，同比增长6.9%；其中中央本级国防支出1.91万亿元，增长7%...", "source": "今日头条（转引中国国防部）", "url": "", "snippet": "2026年3月10日中国国防部公布当年国防预算：全国一般公共预算安排国防支出1.94万亿元人民币，同比增长6.9%；其中中央本级国防支出1.91万亿元，增长7%。资金用于机械化、信息化、智能化融合发展及先进武器装备与国防科技创新。", "date": "", "isSupplementary": true}, {"id": "fact_145c6fad", "title": "美国国防部长赫格塞斯提出美国2027年国防预算将达1.5万亿美元，用于重建美军、应对中国军事现代化，重点投向自主作战、机器人与人工智能。该数字为政策表态/提案，...", "source": "搜狐", "url": "", "snippet": "美国国防部长赫格塞斯提出美国2027年国防预算将达1.5万亿美元，用于重建美军、应对中国军事现代化，重点投向自主作战、机器人与人工智能。该数字为政策表态/提案，非最终核定预算。", "date": "", "isSupplementary": true}, {"id": "fact_e15e7b17", "title": "英国经济与商业研究中心（CEBR）《World Economic League Table 2026》预测：全球GDP由2026年约124万亿美元增至2040年...", "source": "风闻（转引CEBR）", "url": "", "snippet": "英国经济与商业研究中心（CEBR）《World Economic League Table 2026》预测：全球GDP由2026年约124万亿美元增至2040年227万亿美元；美国2040年52.85万亿、中国47.88万亿、印度14.09万亿（当前约4万亿美元出头）。", "date": "", "isSupplementary": true}, {"id": "fact_20c914f8", "title": "2023年中国国防费预算约为15537亿元人民币，同比增长7.2%，增幅比2022年上调0.1个百分点，为连续8年保持个位数增长。", "source": "易商讯/荣欣网", "url": "", "snippet": "2023年中国国防费预算约为15537亿元人民币，同比增长7.2%，增幅比2022年上调0.1个百分点，为连续8年保持个位数增长。", "date": "", "isSupplementary": true}, {"id": "fact_3e04b110", "title": "2024年中国军费预算为17847亿元人民币，同比增长7.2%，增幅与2023年持平；自2022年以来连续四年军费预算增幅超过7%。", "source": "腾讯网（编译CSIS文章）", "url": "", "snippet": "2024年中国军费预算为17847亿元人民币，同比增长7.2%，增幅与2023年持平；自2022年以来连续四年军费预算增幅超过7%。", "date": "", "isSupplementary": true}, {"id": "fact_0e149ee4", "title": "按2023年政府工作报告设定的5%增长目标测算，全年GDP约127万亿元，2023年中国军费占GDP比重约1.2%；改革开放以来国防费占GDP比重从最高5.43...", "source": "网易订阅", "url": "", "snippet": "按2023年政府工作报告设定的5%增长目标测算，全年GDP约127万亿元，2023年中国军费占GDP比重约1.2%；改革开放以来国防费占GDP比重从最高5.43%下降至2023年的1.2%，30多年来一直保持在2%以内。", "date": "", "isSupplementary": true}, {"id": "fact_c5702891", "title": "中国国防费从2016年起连续9年保持个位数增长，国防费占国内生产总值的比重多年维持在1.5%以内，低于世界平均水平。", "source": "中国网", "url": "", "snippet": "中国国防费从2016年起连续9年保持个位数增长，国防费占国内生产总值的比重多年维持在1.5%以内，低于世界平均水平。", "date": "", "isSupplementary": true}, {"id": "fact_b8159942", "title": "根据斯德哥尔摩国际和平研究所（SIPRI）统计，2012—2021年中国国防支出占GDP比例均值为1.3%，较美国3.6%、俄罗斯4.2%仍有较大差距。", "source": "小牛行研", "url": "", "snippet": "根据斯德哥尔摩国际和平研究所（SIPRI）统计，2012—2021年中国国防支出占GDP比例均值为1.3%，较美国3.6%、俄罗斯4.2%仍有较大差距。", "date": "", "isSupplementary": true}, {"id": "fact_1a8fa0e3", "title": "中国国防费总体保持与国家经济和财政支出同步适度协调增长，国防费占GDP比重近年一直保持在2%以内，并随GDP增长呈持续稳定增长趋势。", "source": "三个皮匠报告", "url": "", "snippet": "中国国防费总体保持与国家经济和财政支出同步适度协调增长，国防费占GDP比重近年一直保持在2%以内，并随GDP增长呈持续稳定增长趋势。", "date": "", "isSupplementary": true}, {"id": "fact_f92b7d39", "title": "全国公共财政支出、国防支出及GDP增速趋势基本一致。", "source": "三个皮匠报告", "url": "", "snippet": "全国公共财政支出、国防支出及GDP增速趋势基本一致。", "date": "", "isSupplementary": true}, {"id": "fact_935c480c", "title": "中国军费开支占GDP比例一直低于1.5%，而美国、印度、英国等国占GDP比重高于2%，远超中国。", "source": "易商讯/荣欣网", "url": "", "snippet": "中国军费开支占GDP比例一直低于1.5%，而美国、印度、英国等国占GDP比重高于2%，远超中国。", "date": "", "isSupplementary": true}, {"id": "fact_da122c12", "title": "中航沈飞2024年年报显示，公司实现营业总收入428.37亿元，同比下降7.37%；归母净利润33.94亿元，同比增长12.86%；扣非净利润33.73亿元，同...", "source": "新浪财经", "url": "", "snippet": "中航沈飞2024年年报显示，公司实现营业总收入428.37亿元，同比下降7.37%；归母净利润33.94亿元，同比增长12.86%；扣非净利润33.73亿元，同比增长15.88%。", "date": "", "isSupplementary": true}, {"id": "fact_4f6fb145", "title": "中航沈飞2024年航空制造业实现收入425.5亿元，同比下滑7.4%；毛利率为12.5%，同比增加1.52个百分点。其他业务营业收入0.4亿元，同比下滑44.7...", "source": "新浪财经", "url": "", "snippet": "中航沈飞2024年航空制造业实现收入425.5亿元，同比下滑7.4%；毛利率为12.5%，同比增加1.52个百分点。其他业务营业收入0.4亿元，同比下滑44.7%；毛利率为10.6%，同比增加3.21个百分点。", "date": "", "isSupplementary": true}, {"id": "fact_fd1228cf", "title": "中航沈飞2024年四季度单季度实现营收175.4亿元，同比增长51%；归母净利润15.8亿元，同比增长145%。四季度订单复苏，业绩大幅增长。", "source": "新浪财经", "url": "", "snippet": "中航沈飞2024年四季度单季度实现营收175.4亿元，同比增长51%；归母净利润15.8亿元，同比增长145%。四季度订单复苏，业绩大幅增长。", "date": "", "isSupplementary": true}, {"id": "fact_bb34d756", "title": "中航沈飞2024年年报（主营地区财务报表）显示，国内营业收入为42,590,654,078.55元（约425.91亿元），营业成本为37,264,181,317...", "source": "前瞻眼上市企业库", "url": "", "snippet": "中航沈飞2024年年报（主营地区财务报表）显示，国内营业收入为42,590,654,078.55元（约425.91亿元），营业成本为37,264,181,317.21元（约372.64亿元），毛利为5,326,472,761.34元（约53.26亿元），毛利率为12.51%。", "date": "", "isSupplementary": true}, {"id": "fact_93aab630", "title": "中航西飞发布2024年业绩预告，预计2024年归母净利润9.9亿元—10.76亿元，同比增长15%—25%。", "source": "腾讯网等多家媒体", "url": "", "snippet": "中航西飞发布2024年业绩预告，预计2024年归母净利润9.9亿元—10.76亿元，同比增长15%—25%。", "date": "", "isSupplementary": true}, {"id": "fact_18975d3f", "title": "中航沈飞主要子公司沈飞公司2024年实现营收413.4亿元，同比下滑8.8%；净利润33.4亿元，同比增长12.7%。", "source": "新浪财经", "url": "", "snippet": "中航沈飞主要子公司沈飞公司2024年实现营收413.4亿元，同比下滑8.8%；净利润33.4亿元，同比增长12.7%。", "date": "", "isSupplementary": true}, {"id": "fact_a22c314e", "title": "中航沈飞2024年基本每股收益为1.23元，加权平均净资产收益率为20.20%，经营活动产生的现金流量净额为-37.42亿元（上年同期为-43.93亿元）。", "source": "新浪财经", "url": "", "snippet": "中航沈飞2024年基本每股收益为1.23元，加权平均净资产收益率为20.20%，经营活动产生的现金流量净额为-37.42亿元（上年同期为-43.93亿元）。", "date": "", "isSupplementary": true}]}}

