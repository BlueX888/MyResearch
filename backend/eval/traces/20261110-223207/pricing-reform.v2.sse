data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T23:22:58.126054", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "军工主机厂市场概况", "description": "描述军工主机厂所处航空装备、军机整机及发动机等市场规模、增速、订单节奏和收入结构，重点分析军品定价机制改革所处的市场背景。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["军工主机厂 市场规模 增速 军机整机 收入结构 军品定价改革"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述主要主机厂及配套企业的竞争格局，包括中航沈飞、中航西飞、航发动力、洪都航空等企业的业务定位、收入规模、盈利水平和市场份额。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["军工主机厂 竞争格局 中航沈飞 中航西飞 航发动力 盈利能力 市场份额"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述军品定价改革相关的成本核算、全寿命周期成本管理、数字化成本管控、目标价格论证和激励约束定价等核心技术与管理趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军品定价机制 目标价格 激励约束定价 全寿命周期成本 数字化成本管理"]}, {"id": "sec_4", "title": "政策环境", "description": "描述军品定价机制改革、装备采购制度、审价制度、目标价格管理、激励约束机制及军工科研生产相关政策及其对主机厂盈利能力的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军品定价机制改革 装备采购制度 审价 目标价格管理 激励约束机制 政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述主机厂在定价改革下面临的成本透明化、审价趋严、供应链降本和利润弹性等挑战，以及成本管控能力提升、激励利润释放和盈利分化带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军品定价改革 主机厂 成本管控 利润弹性 挑战 机遇 供应链降本"]}, {"id": "sec_6", "title": "未来展望", "description": "描述军品定价机制改革未来走向、主机厂盈利能力变化趋势、市场化定价程度提升及行业盈利分化的发展趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军品定价机制改革 未来趋势 主机厂 盈利能力 市场化定价 盈利分化"]}], "research_questions": ["军品定价机制改革的具体规则和激励约束强度如何影响主机厂毛利率与净利率", "主机厂成本管控能力和供应链议价能力如何决定改革后的利润弹性", "不同主机厂在定价改革下的盈利能力分化趋势及关键驱动因素是什么"]}}

