data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:32:44.258447", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Cost_Ratio': [92.86, 100.0, 107.14], 'Margin': [9.72, 4.76, 0.0]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\ndata2 = {'Year': [2023, 2024], 'Gross_Margin': [10.95, 12.47], 'Net_Margin': [6.50, 7.92]}\ndf2 = pd.DataFrame(data2)\nfor col in df2.columns:\n    if col != 'Year':\n        df2[col] = pd.to_numeric(df2[col], errors='coerce')\ndf2 = df2.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nx_s = np.linspace(92.86, 107.14, 120)\ny_s = np.interp(x_s, df['Cost_Ratio'], df['Margin'])\naxes[0].plot(x_s, y_s, linewidth=2.5, color='#6366f1')\naxes[0].fill_between(x_s, y_s, alpha=0.15, color='#6366f1')\naxes[0].scatter(df['Cost_Ratio'], df['Margin'], s=90, color='#06b6d4', zorder=5)\naxes[0].axhline(5, linestyle='--', linewidth=2, color='#ef4444', label='改革前成本加成固定利润率 5%')\naxes[0].set_title('目标价格机制：成本-利润率敏感性', fontsize=15, fontweight='bold', pad=15)\naxes[0].set_xlabel('实际成本 / 目标成本（%）', fontsize=13)\naxes[0].set_ylabel('营业利润率（%）', fontsize=13)\naxes[0].tick_params(labelsize=11)\naxes[0].legend(fontsize=10)\nw = 0.35\nx = np.arange(len(df2))\naxes[1].bar(x - w/2, df2['Gross_Margin'], w, label='毛利率', color='#06b6d4')\naxes[1].bar(x + w/2, df2['Net_Margin'], w, label='净利率', color='#10b981')\nfor i, v in enumerate(df2['Gross_Margin']):\n    axes[1].text(i - w/2, v + 0.25, f'{v:.1f}%', ha='center', fontsize=11, fontweight='bold')\nfor i, v in enumerate(df2['Net_Margin']):\n    axes[1].text(i + w/2, v + 0.25, f'{v:.1f}%', ha='center', fontsize=11, fontweight='bold')\naxes[1].set_xticks(x)\naxes[1].set_xticklabels(df2['Year'], fontsize=12)\naxes[1].set_ylim(0, 15)\naxes[1].set_title('中航沈飞盈利能力提升', fontsize=15, fontweight='bold', pad=15)\naxes[1].set_xlabel('年份', fontsize=13)\naxes[1].set_ylabel('比率（%）', fontsize=13)\naxes[1].tick_params(labelsize=11)\naxes[1].legend(fontsize=10)\nfig.suptitle('军品定价机制改革对主机厂盈利能力的影响', fontsize=18, fontweight='bold')\nplt.tight_layout()\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "选取军品定价机制改革的核心量化证据：①目标价格管理机制下的成本-利润率敏感性（成本偏离目标成本时营业利润率从9.72%→4.76%→0%），对比改革前成本加成固定5%利润率；②主机厂代表中航沈飞2023-2024年毛利率与净利率的提升，验证改革对盈利能力的实际改善。通过双面板图展示机制逻辑与实证结果。"}}

