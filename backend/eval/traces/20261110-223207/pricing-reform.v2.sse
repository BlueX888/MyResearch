data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:33:26.860081", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Arial Unicode MS']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'指标': ['国防军费增速', '单一来源类军工企业当前净利润率', '改革后目标净利润率', '军工市场年均增长率预测'], '数值': [8.1, 5, 10, 8], '原始值': ['8.1%', '<5%', '>10%', '>8%']}\ndf = pd.DataFrame(data)\nx = np.arange(len(df))\ny = df['数值'].values\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='关键指标')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(x[i], v + 0.3, df['原始值'][i], ha='center', fontsize=11, fontweight='bold')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('关键指标', fontsize=14)\nplt.ylabel('百分比 (%)', fontsize=14)\nplt.xticks(x, df['指标'], rotation=15, fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

