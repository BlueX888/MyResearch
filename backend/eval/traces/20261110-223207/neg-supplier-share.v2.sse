data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T23:41:34.518528", "content": {"graph": {"nodes": [{"id": "node_0", "name": "成飞（成都飞机工业集团）", "type": "company", "discovered_at": "2026-11-10T23:41:34.518445"}, {"id": "node_1", "name": "Global Market Insights Inc.", "type": "company", "discovered_at": "2026-11-10T23:41:34.518452"}, {"id": "node_2", "name": "超材料隐身技术", "type": "technology", "discovered_at": "2026-11-10T23:41:34.518459"}, {"id": "node_3", "name": "雷达吸波涂层（RAC）", "type": "technology", "discovered_at": "2026-11-10T23:41:34.518465"}, {"id": "node_4", "name": "《材料导报》", "type": "company", "discovered_at": "2026-11-10T23:41:34.518471"}, {"id": "node_5", "name": "报告大厅", "type": "company", "discovered_at": "2026-11-10T23:41:34.518477"}], "edges": [{"source": "成飞（成都飞机工业集团）", "relation": "研究问题核心主体", "discovered_at": "2026-11-10T23:41:34.518448"}, {"source": "成飞（成都飞机工业集团）", "relation": "搜索结果中未被任何来源提及", "discovered_at": "2026-11-10T23:41:34.518450"}, {"source": "Global Market Insights Inc.", "relation": "隐身材料/隐身涂料市场规模数据原始出处", "discovered_at": "2026-11-10T23:41:34.518454"}, {"source": "Global Market Insights Inc.", "relation": "被网易文章转引", "discovered_at": "2026-11-10T23:41:34.518456"}, {"source": "超材料隐身技术", "relation": "被视为突破传统吸波涂料频段限制的路径", "discovered_at": "2026-11-10T23:41:34.518461"}, {"source": "超材料隐身技术", "relation": "与隐身涂层市场技术路线相关", "discovered_at": "2026-11-10T23:41:34.518463"}, {"source": "雷达吸波涂层（RAC）", "relation": "隐身涂料核心品类", "discovered_at": "2026-11-10T23:41:34.518466"}, {"source": "雷达吸波涂层（RAC）", "relation": "由吸波剂与胶粘剂构成", "discovered_at": "2026-11-10T23:41:34.518469"}, {"source": "《材料导报》", "relation": "刊载雷达吸波涂层研究进展的学术期刊", "discovered_at": "2026-11-10T23:41:34.518474"}, {"source": "报告大厅", "relation": "发布雷达吸波涂层材料行业分析报告", "discovered_at": "2026-11-10T23:41:34.518479"}]}, "stats": {"entitiesCount": 6, "relationsCount": 10}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:41:34.518604", "content": {"agent": "DeepScout", "section": "市场概况", "facts_count": 9, "duplicates_removed": 0, "data_points_count": 3, "insights": ["本轮搜索结果与“成飞隐身涂层独家供应商及供货份额”这一核心问题几乎零交集：无一条来源提及成飞、其供应商名称或份额数据，说明该信息在公开中文网络中以常规检索难以获得，符合军工供应链信息高度不透明的特征。", "唯一可用的量化数据（全球隐身材料2025年11.7亿美元、CAGR>30%；隐身涂料2026年8.34亿美元）均来自同一篇网易自媒体对Global Market Insights的二手转引，属单点信源、无法交叉验证，且为全球口径，不含中国、不含军工细分、不含维护修复细分。", "维护修复市场的逻辑线索存在但无量化：舰艇高盐雾环境导致吸波涂层老化失效、寿命缩短，可支撑“维护修复材料”为独立细分市场的判断，但缺乏规模、频次、单价等数据。"], "source_quality": "整体来源质量偏低。9条结果中，学术来源仅1条（中国知网《材料导报》2004年，时效性差，可信度0.8）；一般新闻1条（搜狐，0.5）；行业报告1条（报告大厅，仅有目录无数据，0.3）；其余6条为自媒体、问答、文档分享与企业黄页（0.2–0.35）。关键市场数据全部依赖网易自媒体对Global Market Insights的二手转引，属单一信源且无法核验原始报告口径与年份，需回溯GMI原报告。所有来源均未涉及成飞及其供应商，对本研究核心问题（独家供应商与供货份额）无直接证据价值，仅能为“市场概况”章节提供背景性、方向性描述，定量结论必须另行补充券商研报、上市公司年报与专利/招标数据。", "hypothesis_updates": 3, "search_results": [{"title": "吸波隐身涂料发展趋势怎样啊? 爱问知识人", "url": "https://iask.sina.com.cn/b/DPWWNN8z3.html", "source": "爱问知识人", "snippet": "吸波隐身涂料发展趋势怎样啊? 最具挑战性的隐身技术是隐身涂料的开发与应用。隐身涂料作为一种最方便、最经济、极强适应性的隐身技术已经在航空航天、装备上得到广泛应用。近年来,美、英、俄、法等强国纷纷投入巨资加大隐身涂料的开发力度。显而易见,隐身涂料的发展不仅标志着一个国家科学领域的进步,而且关系到国防力量的巩固,现阶段存在巨大的生存和发展空间。 吸波材料隐身涂料是固定涂覆在武器系统结构上的隐身材料,按其功能可分为雷达隐身涂料、红外隐身涂料、可见光隐身涂料、激光隐身涂料、声纳隐身涂料和多功能隐身涂料。隐身涂层要求具有:较宽温度的化学稳定性;较好的频带特性;面密度小,重量轻;粘结强度高,耐一定的温度和不同环境变化。", "date": "2017-11-27T14:39:08+08:00"}, {"title": "我国耐腐蚀雷达吸波涂料的研究进展_隐身_涂层_应用", "url": "https://news.sohu.com/a/656690805_121124764", "source": "搜狐新闻", "snippet": "有制备简单,施工方便,不受装备外形条件限制等优势,其应用领域正逐步由传统飞行器领域拓展至舰艇等装备。 目前世界海军强国均大力发展新型隐身舰艇,整体采用隐身外形设计,并结合大量隐身材料应用,涂覆型高性能雷达吸波涂料需求日益旺盛。而实际应用中,舰艇面临高温、高湿、高盐雾的恶劣海洋腐蚀环境破坏,传统的雷达吸波涂料极易老化失效,使用寿命较其他应用环境下大大缩短,严重影响舰艇整体的雷达吸波效果。", "date": "2023-03-20T14:54:00+08:00"}, {"title": "雷达波隐身涂料的研究现状和前景.doc - 豆丁网", "url": "https://www.docin.com/p-476755578.html", "source": "豆丁网", "snippet": "材料表面工程学学生班级:材料物理081雷达波隐身涂料的研究现状和前景摘要:隐身技术是当今世界各国重点发展的国防高技术.隐身涂料普遍应用于军事领域。雷达隐身涂料是隐身技术的重要组成部分之一。重点介绍了隐身吸波涂料的种类,阐述了各种涂料的特点、最新研究现状及应用,对吸波涂料的发展趋势进行了概括。关键词::雷达隐身材料、隐身涂料、吸波涂料、发展趋势Abstract:Stealthtechnologyworldfocusdefensehightechnology.Stealthcoatinggenerallyappliedmilitaryfield.Coatingmostimportantpartstealthtechnologyone.Mainlyintroducesstealthantiradarcoating,expoundsvariouscoating,latestresearchstatusdevelopmenttrendantiradarcoatingweresummarized.keywords:radarstealthmaterial;radarcoating;absorbentmaterial;developmenttrend.现代战争、特别是高科技条件下的局部战争,是一场以中远程精确打击为特点的海、陆、空、天、磁五位一体化信息战争。而随着现代科学的突飞猛进,声、光、电、等技术的迅猛发展,极大地丰富了信息的获取手段,而这些技术也正在改变着世界各国的军事探测和防御体系。高科技带来的军事高技术的迅猛发展,世界各国防御体系的探测、跟踪、攻击能力越来越强,陆、海、空各兵种地面军事目标的生存能力,以及武器系统的突防能力日益受到严重威胁。为了隐蔽自己,巧妙打击敌人,大力发展隐身技术并装备有隐身功能的武器系统已成为争夺国防高科技制高点和控制战争主动权的重要手段。隐身技术便是在探", "date": "2012-09-09T02:05:34+08:00"}, {"title": "雷达隐身涂料的发展现状 - 豆丁网", "url": "https://www.docin.com/p-733757072.html", "source": "豆丁网", "snippet": "(总参工程兵科研三所,河南洛阳,471023):隐身技术是当今世界各国重点发展的国防高技术,雷达隐身涂料是隐身技术的重要组成部分之一。本文介绍了雷达隐身涂料的发展、特点以及雷达隐身涂料的应用现状。指出雷达隐身涂料的发展趋势关键词:雷达隐身材料;隐身涂料;吸波材料中图分类号TN972144文献标识码文章编号:100920401(2001)0320020204DevelopmentRadarStealtCoatingMaterialZHAOQing2rongResearchheEngineerirtersheGeneralAbstract:Stealthehightechnologyhenationaldefensefocusedcountriesalloverheworld.Radarstealtheimportantparthestealtdevelopment,characteristicsheradarstealtintroducedhispa2perhedevelopingtendencyheradarstealtKeywords:radarstealtradarcoating;absorbentmaterial随着军事高技术的迅猛发展,世界各国防御体系的探测、跟踪、攻击能力越来越强空各兵种地面军事目标的生存能力,以及武器系统的突防能力日益受到严重威胁。在立体化多维化的现代战场上,如果不能有效地隐蔽自己,就可能出现先遭难的结局。为了提高国防体系中地面军事目标的生存能力和武器系统的突防和纵深打击能力,发展和应用隐身技术成为国防体系发展的重要方向隐身技术是通过降低目标的可探测信号特征,使其不易或难以被敌方各种探测设备发现识别、跟踪、定位和攻击的综合性技术。隐身技术的出现,打破了世界各国现有的攻防平衡响了现代战争的结局,影响未来战争的模式和战场范围。现代隐身技术包括雷达隐身", "date": "2013-12-01T03:49:18+08:00"}, {"title": "超材料和涂层——军用隐身材料解析", "url": "https://m.163.com/dy/article/HHAQ191G0553UGRI.html", "source": "网易", "snippet": "超材料和涂层——军用隐身材料解析\n隐身能力已成为衡量现代武器装备性能的重要指标之一,隐身材料是隐身技术的关键。全球范围内,各军事强国对武器装备的隐身性能均较为重视,隐身材料已广泛应用于多种武器装备和各军种,如飞机和航空发动机、导弹、舰船、武装直升机等,分布于空军、海军、陆军和导弹部队等各军兵种。\n从全球隐身材料的市场规模来看,到2025年市场有望达到11.7亿美元左右,年均复合增长率在30%以上。根据Global Market Insights Inc.的研究报告,到2026年,隐形涂料市场规模预计将超过8.34亿美元,其中航空航天和国防产的消费将强劲推动对隐形涂料的需求。\n隐身材料的功能或者分类主要针对探测技术而言,可分为雷达隐身、红外隐身、可见光隐身、激光隐身以及多频谱隐身等。雷达隐身材料主要用于对抗雷达探测系统,通过吸收电磁波能量,降低回波强度实现雷达隐身;红外隐身技术则主要用于对抗红外探测系统的侦察。\n涂层隐身技术主要就是把隐身材料涂覆在尖端装备上面,而传统的雷达吸波涂料最多只能覆盖到S波段。因为雷达吸波涂料受其工作原理限制,隐身频段和涂层厚度相关,其最大工作波长最多只能达到涂层厚度的十分之一左右。而战机上能够涂装的吸波涂料厚度是有限制的,这就导致传统的雷达吸波涂料无法实现对L及以上波段的雷达波的隐形。\n而超材料隐身技术既不是让电磁波反射,也不是让电磁波吸收,而是通过在物体表面覆盖特殊的超材料,引导着被物体阻挡的电磁波绕着走,从而实现完美隐身。两者的技术原理差异很大,相比传统雷达吸波涂料,超材料隐身技术首先是覆盖频带宽,能够覆盖1-18GHZ频段,也就是大部分军用雷达常用频段,甚至可以覆盖更宽的范围,比如太赫兹频段。其次是超材料使命寿命长、重量轻、二次维护方便,并且在隐身、探测、结构承载等一体化上更具有优势,总体优点远超涂层材料。", "date": "2022-09-16T00:53:34+08:00"}, {"title": "雷达吸波涂层的研究进展-《材料导报》2004年12期-中国知网", "url": "https://mall.cnki.net/magazine/Article/CLDB200412002.htm", "source": "中国知网", "snippet": "隐身技术是当今各国重点发展的国防高科技技术,其中雷达吸波涂层RAC(Radar Absorbing Coating)是实现隐身技术的重要组成部分。论述了雷达吸波涂层吸波剂和胶粘剂的特点及应用现状,指出了RAC的发展趋势及相应技术的要求。 (共3页)", "date": "2004-01-01T00:00:00+08:00"}, {"title": "隐身涂料发展趋势.doc_淘豆网", "url": "https://www.taodocs.com/p-54443347.html", "source": "淘豆网", "snippet": "目前,隐身涂料正向多频谱、宽频带方向发展。 2 雷达隐身涂料雷达发射的电磁波碰到金属材料时易感应生成同频电磁流并建立电磁场,向雷达二次辐射能量。材料隐身设计通过使用能够吸收和衰减电磁波的吸波材料, 将电磁能转化为热能耗散掉或是造成电磁波因干涉而消失。在材料隐身设计中, 有两个关键问题:一是如何让入射波能够最大限度地进入材料内部而不被表面反射;二是如何让进入材料内部的电磁波能够迅速地被材料吸收衰减。", "date": "2016-07-09T09:30:20+08:00"}, {"title": "2026年雷达吸波涂层材料行业分析报告_能源其它研究报告_报告大厅", "url": "https://www.chinabgao.com/k/ldxbtccl.html", "source": "报告大厅", "snippet": "雷达吸波涂层材料行业分析市场调查报告是运用科学的方法,有目的地、有系统地搜集、记录、整理有关雷达吸波涂层材料行业市场信息和资料,分析雷达吸波涂层材料行业市场情况,了解雷达吸波涂层材料行业市场的现状及其发展趋势,为雷达吸波涂层材料行业投资决策或营销决策提供客观的、正确的资料\n[详细]", "date": "2026-02-08T05:37:27+08:00"}, {"title": "吸波涂料吸波水泥", "url": "https://nanjing.11467.com/info/13685501.htm", "source": "南京企业网", "snippet": "可分为声、雷达、红外、可见光、激光隐身材料。按材料用途可分为隐身涂层材料和隐身结构材料。采用不同的技术手段减少被雷达、红外等探测到的概率,大幅度降低敌人获取信息的准确性和完整性,从而提高生存能力。涂料隐身技术相比于外形结构隐身技术具有工艺简单、成本低、涂覆方便、吸波效果好、环境适用性强等优点,在航空航天、武器装备等领域受到了广泛的关注。", "date": "2022-04-11T09:53:00+08:00"}, {"title": "隐形涂料 - 搜狗百科", "url": "http://baike.sogou.com/v61473777.htm?fromTitle=%E9%9A%90%E5%BD%A2%E6%B6%82%E6%96%99", "source": "搜狗百科", "snippet": "通过涂装降低物体可被识别特征的涂料,隐形涂料也叫雷达吸波材料。 隐形涂料也叫雷达吸波材料。雷达吸波材料是最重要的隐身材料,其中尤以结构型雷达吸波材料和吸波涂料最为重要,国外已实用的主要也是这两类隐身材料。 化学式 无 别称 雷达吸波材料 应用 军机和导弹 分子量 无 特点 质轻、高强 英文名 Stealth coating 中文名 隐形涂料 简介 隐形涂料也叫雷达吸波材料。", "date": "2024-12-24T20:27:40+08:00"}], "extracted_facts": [{"content": "据Global Market Insights Inc.研究报告，全球隐身材料市场规模到2025年有望达到约11.7亿美元，年均复合增长率在30%以上。", "source_name": "网易（超材料和涂层——军用隐身材料解析）", "source_url": "https://m.163.com/dy/article/HHAQ191G0553UGRI.html", "credibility": 0.35}, {"content": "同一文章援引Global Market Insights报告称，到2026年隐形涂料（隐身涂层）市场规模预计超过8.34亿美元，航空航天与国防领域消费是主要驱动力。", "source_name": "网易（超材料和涂层——军用隐身材料解析）", "source_url": "https://m.163.com/dy/article/HHAQ191G0553UGRI.html", "credibility": 0.35}, {"content": "涂覆型雷达吸波涂料的应用领域正由传统飞行器拓展至舰艇等装备；舰艇面临高温、高湿、高盐雾环境，传统雷达吸波涂料易老化失效、使用寿命显著缩短，形成持续的维护修复需求。", "source_name": "搜狐新闻（我国耐腐蚀雷达吸波涂料的研究进展）", "source_url": "https://news.sohu.com/a/656690805_121124764", "credibility": 0.5}, {"content": "隐身涂料按功能可分为雷达隐身涂料、红外隐身涂料、可见光隐身涂料、激光隐身涂料、声纳隐身涂料和多功能隐身涂料；要求具备宽温域化学稳定性、宽频带特性、面密度小、粘结强度高、耐温及耐环境变化等性能。", "source_name": "爱问知识人", "source_url": "https://iask.sina.com.cn/b/DPWWNN8z3.html", "credibility": 0.25}, {"content": "传统雷达吸波涂料受工作原理限制，最大工作波长约为涂层厚度的十分之一，最多只能覆盖到S波段，难以对L及以上波段实现隐身；超材料隐身技术通过改变电磁波传播路径而非单纯反射或吸收，被视为突破方向。", "source_name": "网易（超材料和涂层——军用隐身材料解析）", "source_url": "https://m.163.com/dy/article/HHAQ191G0553UGRI.html", "credibility": 0.35}, {"content": "涂料隐身技术相比外形结构隐身技术具有工艺简单、成本低、涂覆方便、吸波效果好、环境适用性强等优点，在航空航天、武器装备领域受到广泛关注；隐身材料按用途可分为隐身涂层材料和隐身结构材料。", "source_name": "南京企业网（吸波涂料吸波水泥）", "source_url": "https://nanjing.11467.com/info/13685501.htm", "credibility": 0.2}, {"content": "《材料导报》2004年第12期发表《雷达吸波涂层的研究进展》，论述雷达吸波涂层吸波剂与胶粘剂的特点及应用现状，指出发展趋势与技术需求。", "source_name": "中国知网（材料导报）", "source_url": "https://mall.cnki.net/magazine/Article/CLDB200412002.htm", "credibility": 0.8}, {"content": "报告大厅发布《2026年雷达吸波涂层材料行业分析报告》，声称提供雷达吸波涂层材料行业市场信息与趋势分析，但公开页面未披露具体市场规模、增速数值。", "source_name": "报告大厅", "source_url": "https://www.chinabgao.com/k/ldxbtccl.html", "credibility": 0.3}], "data_points": [{"name": "全球隐身材料市场规模", "value": "11.7", "unit": "亿美元", "year": 2025, "source": "网易（超材料和涂层——军用隐身材料解析）"}, {"name": "全球隐身材料市场年均复合增长率", "value": "30", "unit": "%", "year": null, "source": "网易（超材料和涂层——军用隐身材料解析）"}, {"name": "全球隐形涂料市场规模", "value": "8.34", "unit": "亿美元", "year": 2026, "source": "网易（超材料和涂层——军用隐身材料解析）"}]}}

