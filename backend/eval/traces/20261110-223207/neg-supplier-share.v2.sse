data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:49:14.977124", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2025, 2026, 2027, 2028], '隐身材料': [11.7, 15.21, 19.77, 25.70], '隐形涂料': [np.nan, 8.34, 10.84, 14.09]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['隐身材料'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='隐身材料市场规模')\nplt.fill_between(df['Year'], df['隐身材料'], alpha=0.15, color='#6366f1')\nplt.plot(df['Year'], df['隐形涂料'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='隐形涂料市场规模')\nplt.fill_between(df['Year'], df['隐形涂料'], alpha=0.15, color='#f59e0b')\nfor i, v in enumerate(df['隐身材料']):\n    plt.text(df['Year'][i], v + 0.8, f'{v:.2f}', ha='center', fontsize=11, color='#6366f1')\nfor i, v in enumerate(df['隐形涂料']):\n    if not np.isnan(v):\n        plt.text(df['Year'][i], v + 0.8, f'{v:.2f}', ha='center', fontsize=11, color='#f59e0b')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿美元）', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

