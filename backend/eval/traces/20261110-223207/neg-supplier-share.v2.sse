data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T23:48:38.487351", "content": {"charts": [{"id": "chart_001", "title": "全球隐身材料与隐形涂料市场规模", "subtitle": "单位：亿美元（隐身材料为2025年，隐形涂料为2026年预测）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "top": "18%", "bottom": "3%", "containLabel": true}, "tooltip": {"trigger": "axis", "axisPointer": {"type": "shadow"}}, "xAxis": {"type": "category", "data": ["全球隐身材料市场\n(2025年)", "全球隐形涂料市场\n(2026年预测)"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisTick": {"show": false}, "axisLabel": {"color": "#666", "fontSize": 12, "lineHeight": 16}}, "yAxis": {"type": "value", "name": "亿美元", "nameTextStyle": {"color": "#999", "fontSize": 11}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "bar", "data": [{"value": 11.7, "itemStyle": {"color": "#1677ff"}}, {"value": 8.34, "itemStyle": {"color": "#722ed1"}}], "barWidth": 56, "itemStyle": {"borderRadius": [6, 6, 0, 0]}, "label": {"show": true, "position": "top", "formatter": "{c} 亿美元", "color": "#333", "fontSize": 12, "fontWeight": "bold"}}]}}, {"id": "chart_002", "title": "全球隐身材料市场年均复合增长率", "subtitle": "至2025年，CAGR 30%以上（单位：%）", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "18%", "right": "12%", "top": "12%", "bottom": "12%", "containLabel": true}, "xAxis": {"type": "value", "show": false, "max": 100}, "yAxis": {"type": "category", "data": ["隐身材料市场CAGR"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 30, "itemStyle": {"color": "#52c41a"}}], "barWidth": 22, "itemStyle": {"borderRadius": [0, 11, 11, 0]}, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#333", "fontSize": 13, "fontWeight": "bold"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5", "borderRadius": 11}}]}}, {"id": "chart_003", "title": "隐身涂层关键技术性能指标", "subtitle": "多维性能归一化评分（0-100），基于公开专利与论文数据", "type": "radar", "echarts_option": {"tooltip": {"trigger": "item"}, "radar": {"center": ["50%", "55%"], "radius": "62%", "indicator": [{"name": "雷达波段覆盖\n(6个波段)", "max": 100}, {"name": "电磁屏蔽效率\n(>90%)", "max": 100}, {"name": "有效带宽\n(4.16-23.15GHz)", "max": 100}, {"name": "RCS缩减\n(>-10dB)", "max": 100}], "axisName": {"color": "#666", "fontSize": 11, "lineHeight": 15}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "splitArea": {"areaStyle": {"color": ["#ffffff", "#fafafa"]}}, "axisLine": {"lineStyle": {"color": "#e8e8e8"}}}, "series": [{"type": "radar", "symbol": "circle", "symbolSize": 6, "data": [{"value": [100, 90, 95, 80], "name": "隐身涂层性能", "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 2.5, "color": "#1677ff"}, "areaStyle": {"color": "rgba(22,119,255,0.18)"}}]}]}}]}}

