data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T23:41:10.285680", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "梳理隐身涂层及雷达吸波材料相关市场规模、增速、主要应用场景，重点区分航空隐身涂料、维护修复材料和配套材料市场，并评估公开数据可得性。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["隐身涂层 市场规模 增速 雷达吸波材料 军工涂料 航空隐身材料"]}, {"id": "sec_2", "title": "竞争格局", "description": "分析成飞隐身涂层潜在供应商类型，包括军工科研院所、特种涂料企业、上市公司子公司及配套施工维护单位，重点核查是否存在公开披露的独家供应关系和供货份额。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 隐身涂层 供应商 供货份额 独家供应 军工涂料 企业 竞争格局"]}, {"id": "sec_3", "title": "技术趋势", "description": "梳理雷达吸波涂层、红外隐身涂层、多频谱兼容隐身材料、耐候耐磨及维护修复技术路线，判断技术壁垒和供应商绑定关系。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["雷达吸波涂层 红外隐身 多频谱隐身 隐身材料 技术路线 专利 成飞"]}, {"id": "sec_4", "title": "政策环境", "description": "分析军工保密、武器装备科研生产许可、军品配套准入、出口管制和军民融合政策对隐身涂层供应商信息披露及供货格局的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军工保密 武器装备科研生产许可 隐身材料 出口管制 军民融合 供应商披露"]}, {"id": "sec_5", "title": "挑战机遇", "description": "识别公开信息不足、供应商身份难验证、供货份额不透明等挑战，同时关注国产化替代、供应链安全、双源/多源供应和维修保障需求带来的机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["隐身涂层 供应链安全 国产化替代 双源供应 航空维修 军工配套 挑战 机遇"]}, {"id": "sec_6", "title": "未来展望", "description": "展望隐身涂层向多频谱兼容、耐候长寿命、低成本可维护方向发展，并判断成飞相关供应链可能趋向核心供应商稳定与配套环节多元化的格局。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["隐身涂层 未来趋势 多频谱 耐候 低成本 维护 供应链 成飞 航空隐身材料"]}], "research_questions": ["成飞隐身涂层是否存在可公开确认的独家供应商", "相关供应商的供货份额是否有公开数据或可交叉验证的线索", "如何通过专利、招标、上市公司公告和产业链信息推断供应商格局与份额"]}}

