data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:48:59.515471", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'年份': [2025, 2026], '市场规模': [11.7, 8.34], '指标': ['全球隐身材料市场规模', '全球隐形涂料市场规模']}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['年份'], df['市场规模'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='市场规模')\nplt.fill_between(df['年份'], df['市场规模'], alpha=0.15, color='#6366f1')\nfor i, row in df.iterrows():\n    plt.text(row['年份'], row['市场规模'] + 0.35, str(row['市场规模']) + '亿美元', ha='center', fontsize=11, fontweight='bold')\n    plt.text(row['年份'], row['市场规模'] - 0.9, row['指标'], ha='center', fontsize=10, color='#475569')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿美元）', fontsize=14)\nplt.xticks(df['年份'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.legend(fontsize=12, loc='upper right')\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

