data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:48:48.024128", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Segment': ['隐身涂层材料', '隐身功能结构件', '电磁兼容材料'],\n    'Revenue': [3.95, 1.77, 0.1444],\n    'Gross_Margin': [76.97, 81.26, 45.0]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Segment':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nplt.figure(figsize=(12, 7), dpi=200)\nbars = plt.bar(df['Segment'], df['Revenue'], color=['#6366f1', '#06b6d4', '#10b981'], width=0.55)\nfor b, v in zip(bars, df['Revenue']):\n    plt.text(b.get_x() + b.get_width() / 2, v + 0.06, f'{v:.2f}亿元', ha='center', fontsize=12, fontweight='bold')\nax2 = plt.gca().twinx()\nax2.plot(df['Segment'], df['Gross_Margin'], color='#f59e0b', linewidth=2.5, marker='o', markersize=8)\nfor x, y in zip(df['Segment'], df['Gross_Margin']):\n    ax2.text(x, y + 2.5, f'{y:.1f}%', ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nax2.set_ylabel('毛利率 (%)', fontsize=14)\nax2.set_ylim(0, 100)\nax2.tick_params(labelsize=12)\nplt.title('隐身材料供应商业务结构（成飞供货份额：公开数据未披露）', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('业务板块', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "核心结论：公开数据中“成飞隐身涂层供货份额”明确标注为“未披露”，且无任何数据点可证明存在“独家供应商”。因此分析聚焦于可验证的隐身涂层/结构件供应商（佳驰科技、华秦科技）的业务结构与客户集中度，用以说明供应链格局，并在图表标题中明确标注份额未披露这一事实。选取佳驰科技三大业务板块收入与毛利率作为主图，辅以华秦科技营收/合同额作为参照。"}}

