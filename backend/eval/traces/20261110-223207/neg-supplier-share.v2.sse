data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:54:28.901455", "content": {"results": [{"id": "fact_814a4eaf", "title": "喷涂设备行业呈现高效、智能、环保的技术创新趋势，行业竞争激烈；空气喷涂设备利用压缩空气将涂料雾化并喷涂到工件表面，适用于小面积、低粘度涂料喷涂，具有成本低、操作...", "source": "豆丁网《2024年喷涂设备相关项目实施方案》", "url": "", "snippet": "喷涂设备行业呈现高效、智能、环保的技术创新趋势，行业竞争激烈；空气喷涂设备利用压缩空气将涂料雾化并喷涂到工件表面，适用于小面积、低粘度涂料喷涂，具有成本低、操作简便的特点。", "date": "", "isSupplementary": true}, {"id": "fact_e7095bcf", "title": "华秦科技在互动平台回答投资者提问时表示，公司不了解光启技术产品的具体情况。该信息仅说明两家公司业务独立性，未涉及任何客户集中度数据。", "source": "证券日报网", "url": "", "snippet": "华秦科技在互动平台回答投资者提问时表示，公司不了解光启技术产品的具体情况。该信息仅说明两家公司业务独立性，未涉及任何客户集中度数据。", "date": "", "isSupplementary": true}, {"id": "fact_0ff215ba", "title": "华秦科技十大股东明细显示：折生阳持股22.57%、周万城持股10.51%、泉州华秦万生商务信息咨询合伙企业持股8.06%、罗发持股7.35%、白红艳持股6.75...", "source": "前瞻上市企业库", "url": "", "snippet": "华秦科技十大股东明细显示：折生阳持股22.57%、周万城持股10.51%、泉州华秦万生商务信息咨询合伙企业持股8.06%、罗发持股7.35%、白红艳持股6.75%（2024年三季报）。此为股东持股结构，并非前五大客户集中度数据。", "date": "", "isSupplementary": true}, {"id": "fact_bb3895cb", "title": "华秦科技最新价81.32元，总市值158亿元，市盈率38.37倍。此为市值数据，与客户集中度无关。", "source": "手机东方财富网", "url": "", "snippet": "华秦科技最新价81.32元，总市值158亿元，市盈率38.37倍。此为市值数据，与客户集中度无关。", "date": "", "isSupplementary": true}, {"id": "fact_9ec93745", "title": "估值网分析称，光启技术全年净利润或约6亿元，其中超材料业务营收或15亿元、贡献净利润近4亿元；2020年超材料业务营收4亿元、净利润仅0.4亿元，4年增长约10...", "source": "估值网（乌龟量化）", "url": "", "snippet": "估值网分析称，光启技术全年净利润或约6亿元，其中超材料业务营收或15亿元、贡献净利润近4亿元；2020年超材料业务营收4亿元、净利润仅0.4亿元，4年增长约10倍。按327亿市值估算整体估值约54.5倍。此为业绩与估值数据，未涉及前五大客户集中度。", "date": "", "isSupplementary": true}, {"id": "fact_adc560f2", "title": "有投资者提及华秦科技预告上半年业绩：营收增约3成、净利增约2成，并据此推测光启技术上半年净利增3成达3.68亿元。此为投资者推测，非官方披露，且不涉及客户集中度...", "source": "估值网（乌龟量化）", "url": "", "snippet": "有投资者提及华秦科技预告上半年业绩：营收增约3成、净利增约2成，并据此推测光启技术上半年净利增3成达3.68亿元。此为投资者推测，非官方披露，且不涉及客户集中度。", "date": "", "isSupplementary": true}, {"id": "fact_04637fe5", "title": "搜索结果中未出现任何与'成飞'（成都飞机工业集团）、'隐身涂层'、'雷达吸波材料'或'军工涂料供应商'相关的主体、企业名称或供货份额数据；全部结果均为采购招投标...", "source": "本次补充搜索全部结果（链晓得、东风公司采购招投标平台、刷刷题、文库吧、搜狗问问、原创力文档）", "url": "", "snippet": "搜索结果中未出现任何与'成飞'（成都飞机工业集团）、'隐身涂层'、'雷达吸波材料'或'军工涂料供应商'相关的主体、企业名称或供货份额数据；全部结果均为采购招投标流程、供应商评估模板、考试题库等通用性内容，与研究问题无实质关联。", "date": "", "isSupplementary": true}, {"id": "fact_201087dc", "title": "关于'独家供应商'概念，仅有问答类内容给出模糊界定：'唯一供应商'指其产品在行业内属独家、其他供应商产品无法比拟，或由客户指定的情形；该表述为一般性采购概念解释...", "source": "搜狗问问", "url": "", "snippet": "关于'独家供应商'概念，仅有问答类内容给出模糊界定：'唯一供应商'指其产品在行业内属独家、其他供应商产品无法比拟，或由客户指定的情形；该表述为一般性采购概念解释，未涉及任何具体企业或军工领域案例，不能作为认定成飞隐身涂层独家供应商的依据。", "date": "", "isSupplementary": true}, {"id": "fact_b637216d", "title": "东风公司采购招投标平台公示的两则'无候选成交供应商'公告显示，因响应文件签字盖章缺失、业绩合同无法辨识标的物、未提供盈利财务报表等形式与资格评审不合格原因，多个...", "source": "东风公司采购招投标平台", "url": "", "snippet": "东风公司采购招投标平台公示的两则'无候选成交供应商'公告显示，因响应文件签字盖章缺失、业绩合同无法辨识标的物、未提供盈利财务报表等形式与资格评审不合格原因，多个项目通过初审的供应商数量不足3家而流标；此类信息仅反映一般采购合规审查机制，与成飞隐身涂层供应链无关。", "date": "", "isSupplementary": true}, {"id": "fact_f23b12c7", "title": "文库类资料提供的供应商评估框架包含'候选供应商A/B/C评估—综合竞争力排名—风险分析—结论'结构，并列出供货周期、性价比、服务、信誉、ISO质量认证等评估维度...", "source": "文库吧《附录q-7供应商评估报告》", "url": "", "snippet": "文库类资料提供的供应商评估框架包含'候选供应商A/B/C评估—综合竞争力排名—风险分析—结论'结构，并列出供货周期、性价比、服务、信誉、ISO质量认证等评估维度；该框架可作为梳理隐身涂层潜在供应商候选范围的通用方法论，但不含任何成飞相关实证数据。", "date": "", "isSupplementary": true}, {"id": "fact_74ca0e53", "title": "搜索结果中未出现任何关于“智能电磁隐身”市场规模的数据，也未出现“87.3亿美元”这一数值。唯一数值接近的是具身智能（embodied AI）全球市场规模：20...", "source": "搜狐（转载《2025具身智能产业发展趋势研究及安全威胁分析报告》，引赛迪研究院）", "url": "", "snippet": "搜索结果中未出现任何关于“智能电磁隐身”市场规模的数据，也未出现“87.3亿美元”这一数值。唯一数值接近的是具身智能（embodied AI）全球市场规模：2024年为25.335亿美元，预计2033年达87.565亿美元——该数据属于具身智能/机器人领域，与电磁隐身材料或隐身涂层市场无关，不能用于支撑“智能电磁隐身市场规模87.3亿美元（2025）”这一说法。", "date": "", "isSupplementary": true}, {"id": "fact_7f7cb990", "title": "其余搜索结果均为无关领域：全球具身智能市场2025年约195.25亿元、2030年约2326.3亿元（CAGR 64.18%）；中国具身智能市场2024年863...", "source": "中研网 / 证券之星 / 维库电子市场网 / 豆丁网", "url": "", "snippet": "其余搜索结果均为无关领域：全球具身智能市场2025年约195.25亿元、2030年约2326.3亿元（CAGR 64.18%）；中国具身智能市场2024年8634亿元、2025年预计9731亿元；全球先进芯片封装市场2025年503.8亿美元、2032年798.5亿美元（CAGR 6.8%）；全球智能家居市场2025年预计1.5万亿美元。这些均不涉及隐身涂层、电磁隐身材料或成飞的供应商体系。", "date": "", "isSupplementary": true}, {"id": "fact_4def4f2c", "title": "渝三峡A在互动平台表示，公司曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二号F运载火箭提供涂料服务，并于2012年收到中国航天科技集团授予的物资供应商奖牌...", "source": "腾讯网", "url": "", "snippet": "渝三峡A在互动平台表示，公司曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二号F运载火箭提供涂料服务，并于2012年收到中国航天科技集团授予的物资供应商奖牌；目前主要产品包括重防腐漆和辐射制冷材料，暂不涉足有机硅三防漆。", "date": "", "isSupplementary": true}, {"id": "fact_e16b98a4", "title": "渝三峡A在互动平台表示，公司曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二号F运载火箭提供涂料服务，并于2012年收到中国航天科技集团授予的物资供应商奖牌...", "source": "证券时报", "url": "", "snippet": "渝三峡A在互动平台表示，公司曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二号F运载火箭提供涂料服务，并于2012年收到中国航天科技集团授予的物资供应商奖牌；目前主要产品包括重防腐漆和辐射制冷材料。", "date": "", "isSupplementary": true}, {"id": "fact_0b5e001c", "title": "财联社报道，渝三峡A在互动平台表示，公司曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二号F运载火箭提供涂料服务，并于2012年收到中国航天科技集团授予的物...", "source": "财联社", "url": "", "snippet": "财联社报道，渝三峡A在互动平台表示，公司曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二号F运载火箭提供涂料服务，并于2012年收到中国航天科技集团授予的物资供应商奖牌；目前主要产品包括重防腐漆和辐射制冷材料。", "date": "", "isSupplementary": true}, {"id": "fact_57aa4d29", "title": "证券之星报道，针对投资者询问产品是否应用于核电、可控核聚变、大飞机、无人机、航空发动机等领域，渝三峡A回复称曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二...", "source": "证券之星股票频道", "url": "", "snippet": "证券之星报道，针对投资者询问产品是否应用于核电、可控核聚变、大飞机、无人机、航空发动机等领域，渝三峡A回复称曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二号F运载火箭提供涂料服务，并于2012年收到中国航天科技集团授予的物资供应商奖牌；目前主要产品包括重防腐漆和辐射制冷材料。", "date": "", "isSupplementary": true}, {"id": "fact_b5b77be9", "title": "证券日报网报道，渝三峡A在互动平台回答投资者提问时表示，公司曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二号F运载火箭提供涂料服务，并于2012年收到中国...", "source": "证券日报网", "url": "", "snippet": "证券日报网报道，渝三峡A在互动平台回答投资者提问时表示，公司曾为“天宫一号”目标飞行器、神舟九号载人飞船及长征二号F运载火箭提供涂料服务，并于2012年收到中国航天科技集团授予的物资供应商奖牌；目前公司主要产品包括重防腐漆和辐射制冷材料。", "date": "", "isSupplementary": true}, {"id": "fact_2c20c425", "title": "东方财富网报道，渝三峡A在互动平台表示，公司曾为“天宫一号”目标飞行器等航天工程项目提供涂料服务，并于2012年收到中国航天科技集团授予的物资供应商奖牌；目前主...", "source": "东方财富网", "url": "", "snippet": "东方财富网报道，渝三峡A在互动平台表示，公司曾为“天宫一号”目标飞行器等航天工程项目提供涂料服务，并于2012年收到中国航天科技集团授予的物资供应商奖牌；目前主营业务为重防腐涂料和辐射制冷材料，暂无航天工程项目相关涂料。", "date": "", "isSupplementary": true}, {"id": "fact_539855e7", "title": "金融界报道，投资者提问称渝三峡A重防腐涂料系列在军工相关工程中成功应用，为天宫一号目标飞行器、神舟九号飞船和长征二号F运载火箭研制提供配套，获得国家航天科工集团...", "source": "金融界股票", "url": "", "snippet": "金融界报道，投资者提问称渝三峡A重防腐涂料系列在军工相关工程中成功应用，为天宫一号目标飞行器、神舟九号飞船和长征二号F运载火箭研制提供配套，获得国家航天科工集团荣誉授牌，并为西昌卫星发射中心工程提供产品服务；公司回答称重防腐涂料系列应用情况详见公司2023年年度报告，未在回复中直接逐项确认。", "date": "", "isSupplementary": true}, {"id": "fact_37e450b2", "title": "新浪财经报道，渝三峡A董秘回答称，公司重防腐涂料系列在国内影响力名列前茅，于2012年8月获得中国航天科技集团公司授予的首次载人交会对接任务天宫一号、神舟九号和...", "source": "新浪财经", "url": "", "snippet": "新浪财经报道，渝三峡A董秘回答称，公司重防腐涂料系列在国内影响力名列前茅，于2012年8月获得中国航天科技集团公司授予的首次载人交会对接任务天宫一号、神舟九号和长征二号F研制配套荣誉奖牌。", "date": "", "isSupplementary": true}]}}

