data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:16:07.811400", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid')\nplt.rcParams['font.sans-serif'] = ['SimHei']\nplt.rcParams['axes.unicode_minus'] = False\nplt.figure(figsize=(12,7), dpi=200)\nax1 = plt.gca()\nx1 = [2024, 2025]\ny1 = [1.56, 1.67]\nax1.plot(x1, y1, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='国防预算（万亿元）')\nax1.fill_between(x1, y1, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y1):\n    ax1.text(x1[i], v + 0.02, f'{v:.2f}', ha='center', fontsize=11, color='#6366f1')\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('国防预算（万亿元）', fontsize=14, color='#6366f1')\nax1.tick_params(axis='y', labelcolor='#6366f1')\nax1.set_xticks([2024, 2025, 2030])\nax1.set_xticklabels(['2024', '2025', '2030（预测）'], fontsize=12)\nax2 = ax1.twinx()\nx2 = [2025, 2030]\ny2 = [3, 10]\nax2.plot(x2, y2, color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='中国军贸全球份额（%）')\nax2.fill_between(x2, y2, alpha=0.15, color='#f59e0b')\nfor i, v in enumerate(y2):\n    ax2.text(x2[i], v + 0.5, f'{v}%', ha='center', fontsize=11, color='#f59e0b')\nax2.set_ylabel('中国军贸全球份额（%）', fontsize=14, color='#f59e0b')\nax2.tick_params(axis='y', labelcolor='#f59e0b')\nplt.title('市场概况：军机需求与十五五预算分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况：军机需求与十五五预算"}}

