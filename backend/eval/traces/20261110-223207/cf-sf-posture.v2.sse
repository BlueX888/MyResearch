data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:17:31.538177", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.figure(figsize=(12, 7), dpi=200)\n\ncategories = ['歼-20\\n产量阶段', '歼-35\\n产量阶段', '国防预算\\n(万亿元)', '国防预算\\n同比增速(%)', '主机厂Q1\\n订单增速(%)', '成飞合同\\n负债(亿元)', '成飞合同负债\\n同比增幅(倍)', '沈飞合同\\n负债(亿元)', '军贸份额\\n当前(%)', '军贸份额\\n预测(%)']\nvalues = [1, 0.5, 1.67, 7.2, 80, 187, 281, 75, 3, 10]\n\nx = np.arange(len(categories))\n\nplt.plot(x, values, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='#6366f1', markeredgecolor='white', markeredgewidth=1.5, label='指标数值')\nplt.fill_between(x, values, alpha=0.15, color='#6366f1')\n\nfor i, v in enumerate(values):\n    plt.text(i, v + max(values)*0.03, str(v), ha='center', fontsize=11, fontweight='bold', color='#1e293b')\n\nplt.title('竞争格局：成飞与沈飞产品谱系分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('指标类别', fontsize=14)\nplt.ylabel('数值（单位见标签）', fontsize=14)\nplt.xticks(x, categories, fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局：成飞与沈飞产品谱系"}}

