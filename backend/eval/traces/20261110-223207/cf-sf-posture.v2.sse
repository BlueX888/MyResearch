 "2026-11-10T21:07:24.247609"}, {"id": "node_18", "name": "中航西飞", "type": "company", "discovered_at": "2026-11-10T21:07:24.247631"}, {"id": "node_19", "name": "航空工业集团", "type": "company", "discovered_at": "2026-11-10T21:07:24.247637"}, {"id": "node_20", "name": "十五五规划", "type": "policy", "discovered_at": "2026-11-10T21:07:24.247640"}, {"id": "node_21", "name": "075两栖攻击舰", "type": "technology", "discovered_at": "2026-11-10T21:07:24.247645"}], "edges": [{"source": "航空工业成都飞机工业集团（成飞）", "relation": "歼-20", "discovered_at": "2026-11-10T21:07:21.918223"}, {"source": "航空工业成都飞机工业集团（成飞）", "relation": "歼-10", "discovered_at": "2026-11-10T21:07:21.918233"}, {"source": "航空工业成都飞机工业集团（成飞）", "relation": "枭龙", "discovered_at": "2026-11-10T21:07:21.918235"}, {"source": "航空工业成都飞机工业集团（成飞）", "relation": "航空工业集团子公司", "discovered_at": "2026-11-10T21:07:21.918237"}, {"source": "航空工业沈阳飞机工业集团（沈飞/中航沈飞）", "relation": "歼-11", "discovered_at": "2026-11-10T21:07:21.918243"}, {"source": "航空工业沈阳飞机工业集团（沈飞/中航沈飞）", "relation": "歼-15", "discovered_at": "2026-11-10T21:07:21.918245"}, {"source": "航空工业沈阳飞机工业集团（沈飞/中航沈飞）", "relation": "歼-16", "discovered_at": "2026-11-10T21:07:21.918248"}, {"source": "航空工业沈阳飞机工业集团（沈飞/中航沈飞）", "relation": "歼-35", "discovered_at": "2026-11-10T21:07:21.918250"}, {"source": "航空工业沈阳飞机工业集团（沈飞/中航沈飞）", "relation": "航空工业集团子公司", "discovered_at": "2026-11-10T21:07:21.918252"}, {"source": "中航西安飞机工业集团（西飞）", "relation": "运-20", "discovered_at": "2026-11-10T21:07:21.918257"}, {"source": "中航西安飞机工业集团（西飞）", "relation": "轰-6", "discovered_at": "2026-11-10T21:07:21.918259"}, {"source": "中航西安飞机工业集团（西飞）", "relation": "航空工业集团子公司", "discovered_at": "2026-11-10T21:07:21.918261"}, {"source": "航空工业陕飞", "relation": "预警机", "discovered_at": "2026-11-10T21:07:21.918266"}, {"source": "航空工业陕飞", "relation": "反潜机", "discovered_at": "2026-11-10T21:07:21.918268"}, {"source": "航空工业陕飞", "relation": "特种机", "discovered_at": "2026-11-10T21:07:21.918270"}, {"source": "贵州航空工业（贵飞）", "relation": "承接成飞歼-10产能转移", "discove