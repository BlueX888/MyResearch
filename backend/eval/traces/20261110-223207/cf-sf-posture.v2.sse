data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T21:15:25.634301", "content": {"charts": [{"id": "chart_001", "title": "成飞与沈飞合同负债对比", "subtitle": "2025年合同负债（亿元），成飞同比+281倍，订单预收弹性显著", "type": "bar", "echarts_option": {"grid": {"left": "8%", "right": "8%", "top": "18%", "bottom": "12%", "containLabel": true}, "xAxis": {"type": "category", "data": ["中航成飞", "中航沈飞"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "yAxis": {"type": "value", "name": "亿元", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisTick": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"type": "bar", "data": [{"value": 187, "itemStyle": {"color": "#1677ff"}}, {"value": 75, "itemStyle": {"color": "#52c41a"}}], "barWidth": 56, "label": {"show": true, "position": "top", "formatter": "{c}亿元", "color": "#333", "fontSize": 13, "fontWeight": "bold"}, "itemStyle": {"borderRadius": [6, 6, 0, 0]}}]}}, {"id": "chart_002", "title": "成飞与沈飞战略定位差异", "subtitle": "基于订单弹性、军贸潜力、产能扩张、技术代际、现金流质量五维定性评估", "type": "radar", "echarts_option": {"legend": {"data": ["中航成飞", "中航沈飞"], "bottom": 0, "textStyle": {"color": "#666"}}, "radar": {"center": ["50%", "48%"], "radius": "62%", "indicator": [{"name": "订单弹性", "max": 100}, {"name": "军贸潜力", "max": 100}, {"name": "产能扩张", "max": 100}, {"name": "技术代际", "max": 100}, {"name": "现金流质量", "max": 100}], "axisName": {"color": "#333", "fontSize": 12}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "splitArea": {"areaStyle": {"color": ["#ffffff", "#fafafa"]}}, "axisLine": {"lineStyle": {"color": "#e8e8e8"}}}, "series": [{"type": "radar", "data": [{"value": [95, 90, 85, 95, 90], "name": "中航成飞", "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 2}, "areaStyle": {"color": "rgba(22,119,255,0.15)"}}, {"value": [75, 70, 75, 90, 70], "name": "中航沈飞", "itemStyle": {"color": "#52c41a"}, "lineStyle": {"width": 2}, "areaStyle": {"color": "rgba(82,196,26,0.12)"}}], "symbolSize": 5}]}}, {"id": "chart_003", "title": "中国军贸全球市场份额提升空间", "subtitle": "当前3% → 十五五预测10%，成飞外贸机型为主要贡献方向", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "22%", "right": "18%", "top": "12%", "bottom": "12%", "containLabel": true}, "xAxis": {"type": "value", "show": false, "max": 12}, "yAxis": {"type": "category", "data": ["十五五预测", "当前份额"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 10, "itemStyle": {"color": "#1677ff"}}, {"value": 3, "itemStyle": {"color": "#fa8c16"}}], "barWidth": 22, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#333", "fontSize": 13, "fontWeight": "bold"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5", "borderRadius": 11}, "itemStyle": {"borderRadius": 11}}]}}, {"id": "chart_004", "title": "未来20年战斗机与舰载机市场空间", "subtitle": "合计5800亿元，战斗机占94.8%，舰载机为沈飞差异化方向", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}<br/>{c}亿元（{d}%）"}, "legend": {"bottom": 0, "textStyle": {"color": "#666"}}, "series": [{"type": "pie", "radius": ["42%", "66%"], "center": ["50%", "46%"], "avoidLabelOverlap": true, "itemStyle": {"borderRadius": 6, "borderColor": "#fff", "borderWidth": 2}, "label": {"show": true, "formatter": "{b}\n{d}%", "color": "#333", "fontSize": 12}, "labelLine": {"length": 12, "length2": 8, "lineStyle": {"color": "#d9d9d9"}}, "data": [{"value": 5500, "name": "战斗机", "itemStyle": {"color": "#1677ff"}}, {"value": 300, "name": "舰载机", "itemStyle": {"color": "#fa8c16"}}]}]}}]}}

