data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:15:34.531987", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Company': ['中航成飞', '中航沈飞'], 'Contract_Liability': [187, 75]}\ndf = pd.DataFrame(data)\ndf['Contract_Liability'] = pd.to_numeric(df['Contract_Liability'], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nbars = ax1.bar(df['Company'], df['Contract_Liability'], color=['#6366f1', '#06b6d4'], width=0.55)\nfor b, v in zip(bars, df['Contract_Liability']):\n    ax1.text(b.get_x() + b.get_width() / 2, v + 4, str(int(v)) + '亿元', ha='center', fontsize=13, fontweight='bold')\nax1.set_title('合同负债：成飞订单蓄水显著领先', fontsize=15, fontweight='bold', pad=15)\nax1.set_ylabel('合同负债（亿元）', fontsize=13)\nax1.set_ylim(0, 220)\nax1.tick_params(labelsize=12)\nax1.grid(True, linestyle='--', alpha=0.3, axis='y')\nax2 = axes[1]\nyears = [2025, 2030]\nshare = [3, 10]\nax2.plot(years, share, linewidth=2.5, marker='o', markersize=8, color='#10b981')\nax2.fill_between(years, share, alpha=0.15, color='#10b981')\nfor x, y in zip(years, share):\n    ax2.text(x, y + 0.7, str(y) + '%', ha='center', fontsize=13, fontweight='bold')\nax2.set_title('中国军贸全球份额：沈飞外贸弹性', fontsize=15, fontweight='bold', pad=15)\nax2.set_ylabel('全球市场份额（%）', fontsize=13)\nax2.set_xticks(years)\nax2.set_ylim(0, 13)\nax2.tick_params(labelsize=12)\nax2.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦成飞与沈飞战略定位差异的核心证据：①合同负债（成飞187亿 vs 沈飞75亿）反映订单蓄水与产能爬坡节奏差异——成飞处于歼-20达峰+新机型放量的高确定性交付期，沈飞处于歼-35小批量转批产的订单前置期；②中国军贸全球份额从3%向10%跃升，对应沈飞歼-35的外贸弹性。用左右双图分别呈现'内需订单确定性'与'外贸成长弹性'两条主线，形成战略定位对比。"}}

