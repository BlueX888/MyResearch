data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T21:06:57.271613", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况：军机需求与十五五预算", "description": "梳理十五五国防预算、空军海军装备更新、军贸市场规模与增速，区分制空、舰载、多用途、无人协同等细分需求，为比较成飞与沈飞订单结构提供基线。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["十五五 国防预算 军机 需求 成飞 沈飞 订单 市场规模"]}, {"id": "sec_2", "title": "竞争格局：成飞与沈飞产品谱系", "description": "对比成飞歼-20、歼-10、枭龙、无人机等与沈飞歼-35、歼-16、歼-15等产品谱系、产能、客户与军贸布局，识别两厂战略定位差异。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 沈飞 产品谱系 歼-20 歼-35 歼-16 歼-15 竞争格局"]}, {"id": "sec_3", "title": "技术趋势：核心技术路线与能力建设", "description": "分析隐身设计、舰载适配、无人协同、智能制造、发动机与航电等核心技术方向，比较成飞与沈飞研发重点、技术路线与能力建设差异。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 隐身 舰载 无人协同 智能制造 技术路线"]}, {"id": "sec_4", "title": "政策环境：集团战略与采购改革", "description": "梳理航空工业集团战略、军品定价与采购改革、军贸政策、海军与空军装备规划对成飞和沈飞战略定位的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业集团 十五五 战略 军品定价 军贸政策 舰载航空"]}, {"id": "sec_5", "title": "挑战机遇：产能供应链与军贸空间", "description": "识别产能瓶颈、供应链约束、技术迭代、军贸竞争、定价机制等挑战，以及舰载化、隐身化、无人化、外贸拓展等机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 产能 供应链 军贸 挑战 机遇 十五五"]}, {"id": "sec_6", "title": "未来展望：差异化定位与协同关系", "description": "基于需求、产品、技术与政策，判断十五五期间成飞与沈飞差异化战略定位、集团内协同关系及关键观察指标。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 十五五 战略定位 差异化 协同 展望"]}], "research_questions": ["十五五期间成飞与沈飞在产品谱系和客户结构上的核心差异是什么？", "成飞与沈飞的技术路线分别如何匹配空军制空、海军舰载和军贸需求？", "集团战略、军品定价和军贸政策将如何影响两厂的差异化定位与协同关系？"]}}

