data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:10:43.158669", "content": {"results": [{"id": "sr_ca0ece", "title": "一图读懂丨《民用航空发展“十五五”规划》-手机大河网", "source": "大河网", "url": "https://4g.dahe.cn/news/202608072118136", "snippet": "一图读懂丨《民用航空发展“十五五”规划》\n2026-08-08中国新闻网\n来源:中国民航局网站\n编辑:陈梦伊\n欢迎登录\n提交", "date": "2026-08-08T00:00:00+08:00"}, {"id": "sr_cfaab6", "title": "一图读懂丨《民用航空发展“十五五”规划》_国内新闻_大河网", "source": "大河网新闻中心", "url": "https://news.dahe.cn/2026/08-07/2118136.html", "snippet": "一图读懂丨《民用航空发展“十五五”规划》\n2026年08月07日16:27\n来源:中国新闻网\n来源:中国民航局网站\n编辑:陈梦伊\n新闻标签:", "date": "2026-08-07T16:27:00+08:00"}, {"id": "sr_6dd704", "title": "一图读懂丨《民用航空发展“十五五”规划》-顶端新闻", "source": "www.topnews.cn", "url": "https://www.topnews.cn/news/145ED5EC40BF4D75", "snippet": "来源:中国民航局网站【编辑:蔡星雨】\n免责声明:本文由顶端号作者上传发布,仅代表作者观点,顶端新闻仅提供信息发布平台。如文章内容涉及侵权或其他问题,请30日内与本平台联系,反映情况属实我们将第一时间删除。", "date": "2026-08-07T15:52:00+08:00"}, {"id": "sr_7d907c", "title": "《国家信息化“十五五”规划》", "source": "全国电子商务公共服务网", "url": "https://dzswgf.mofcom.gov.cn/news/22/2026/10/1793080107743.html", "snippet": "《国家信息化“十五五”规划》\n文章来源:中国网信网\n文章类型:转载\n内容分类:政策发布\n发布时间:2026-10-27\n13:46", "date": "2026-10-27T13:46:00+08:00"}, {"id": "sr_a9d730", "title": "《民用航空发展“十五五”规划》印发:推进基础设施更新和数智化改造,率先建成一流设施_北京商报", "source": "北京商报", "url": "https://www.bbtnews.com.cn/2026/0807/601582.shtml", "snippet": "《民用航空发展“十五五”规划》印发:推进基础设施更新和数智化改造,率先建成一流设施\n出处:北京商报\n作者:关子辰\n牛清妍\n网编:方彬楠\n2026-08-07\n北京商报讯(记者\n关子辰\n牛清妍)8月7日,记者从民航局获悉,《民用航空发展“十五五”规划》印发。规划提出,全力建设系统协同的基础设施体系。坚持适度超前、不过度超前,坚持智能化、绿色化、融合化方向,坚持提质存量、做优增量并重,推进基础设施更新和数智化改造,提升安全运营可持续性,率先建成一流设施。", "date": "2026-08-07T00:00:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:10:43.253644", "content": {"results": [{"id": "sr_777795", "title": "攻击-11这个正式军用编号标志着由沈阳航空航天大学、洪都航空工业集团和沈阳飞机设-东方财富网股吧", "source": "东方财富网股吧", "url": "https://mguba.eastmoney.com/mguba/article/0/879338900/", "snippet": "攻击-11这个正式军用编号标志着由沈阳航空航天大学、洪都航空工业集团和沈阳飞机设计研究所共同研制的“利剑”无人机终于上了户口,成为全球第一种正式服役的飞翼隐身无人作战飞机。", "date": "2019-10-03T07:27:59+08:00"}, {"id": "sr_a20de0", "title": "攻击-11无人机(中国人民解放军武器装备) - 搜狗百科", "source": "搜狗百科", "url": "http://baike.sogou.com/v214282500.htm?fromTitle=%E6%94%BB%E5%87%BB-11", "snippet": "攻击-11无人机是中国人民解放军武器装备。 攻击-11无人机采用上部进气道设计,下部无腔体,进一步增强雷达隐身能力。此外该机发动机尾喷口也进行了隐身化处理,降低雷达信号的同时还可以降低红外信号。该机采用内埋式弹舱、背负式进气道、锯齿状舱门...... 装备功能 攻击-11无人机可遂行制空突击、压制防空等作战任务,反辐射无人机具备压制敌预警探测和指挥通信系统的强大功能。", "date": "2024-09-27T10:48:21+08:00"}, {"id": "sr_1a68dc", "title": "洪都航空(SH600316) 我国第一款隐身无人攻击机利剑(攻击 11)由 中航沈飞 主持设计,中航洪都公司制 造,... - 雪球", "source": "雪球", "url": "https://xueqiu.com/5842900570/221624105", "snippet": "$洪都航空(SH600316)$ 我国第一款隐身无人攻击机利剑(攻击 11)由中航沈飞主持设计,中航洪都公司制 造,于2013 年完成首飞,标志着我国成为世界上继美国、法国、英国后第四个拥有 隐身无人机的国家。利剑 11 具备先进的隐身功能,其独特的机体设计能够有效减少 雷达探测和红外感应装置探测。此外,利剑 11 还具备非常强大的杀伤力和威慑力, 其不同于“翼龙”、“彩虹”系列无人机使用螺旋桨发动机,利剑 11 使用现役三四代战 机采用的涡轮发动机,最大起飞重量能达到 10 吨,最大飞行速度超 1000km/h,最 大航程超 7000 公里,利剑 11 内置 2 个弹仓,能够挂载 8 枚制导导弹,进而实现空 中支援、战略轰炸、制空权夺取等目标任务。隐身无人机除了能发挥侦查监视、干 扰诱敌、对地攻击外,还能与现有战机相配合形成联合作战网络,此外无人攻击机 未来还有上舰可能,将进一步扩充其功能。", "date": "2022-06-02T11:05:00+08:00"}, {"id": "sr_7cb32d", "title": "洪都造利lj剑量产版攻击-11型隐形无人攻击机_财富号_东方财富网", "source": "财富号", "url": "https://caifuhao.eastmoney.com/news/20191001200911022611050", "snippet": "这一款具备隐形设计的无人机是攻击-11无人机验证机。它属于沈飞自主研发的无尾飞翼布局无人机,具有隐身性能好、续航时间长、攻击精度高等特点,可执行制空突击、压制防空等作战任务。2013年由沈 sf飞设计,洪都航空生产的原型机利lj剑终于出量产版了!而进行了导弹防务资产注入的洪都航空成为中航防务平台的可能大增,下一步会否把攻击-11飞机注入,机弹一体成最大看点! (来源:领君_2019的财富号", "date": "2019-10-01T20:09:00+08:00"}, {"id": "sr_17ac08", "title": "攻击-11无人机有顶尖隐形飞机的所有优点, 发动机是我国最尖端的_综合资讯_资讯_无人机网(www.youuav.com)_无人机专家--无人机专业网络平台", "source": "无人机网", "url": "https://www.youuav.com/news/detail/201910/36433.html", "snippet": "我国攻击-11无人机是世界第一款投入现役的飞翼隐身无人机,这款飞机与世界上的有人隐身轰炸机和无人隐形攻击机设计方案高度一致,使用了尖端的雷达与光电隐身技...", "date": "2019-10-17T11:13:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

