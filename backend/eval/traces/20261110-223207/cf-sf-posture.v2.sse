data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:09:19.151357", "content": {"results": [{"id": "sr_1e63a7", "title": "2026年全国一般公共预算安排国防支出1.94万亿元", "source": "搜狐", "url": "https://www.sohu.com/a/994767004_115376?scm=10001.2024_13-101000-0_922.0-0.0-0-0-0-0.a2_5X151X618", "snippet": "2026年全国一般公共预算安排国防支出1.94万亿元\n发布于:北京市\n2026.03.10\n19:24", "date": "2026-03-10T19:24:00+08:00"}, {"id": "sr_a16d15", "title": "2026年全国一般公共预算安排国防支出1.94万亿元_看看新闻网", "source": "看看新闻网", "url": "https://www.kankanews.com/detail/m9wB6Xr98wn", "snippet": "2026年全国一般公共预算安排国防支出1.94万亿元\n2026-03-11\n18:05:29\n看看新闻Knews综合", "date": "2026-03-11T18:05:29+08:00"}, {"id": "sr_50c661", "title": "2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。..._网易视频", "source": "网易", "url": "https://m.163.com/v/video/VAMAVKS41.html", "snippet": "2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。...", "date": "2026-03-05T12:43:41+08:00"}, {"id": "sr_026ff5", "title": "2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。", "source": "搜狐", "url": "https://www.sohu.com/a/992783010_162522?scm=10001.2024_13-101000-0_922.0-0.0-0-0-0-0.a2_5X151X618", "snippet": "2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。\n发布于:北京市\n2026.03.05\n12:45\n2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。#2026全国两会", "date": "2026-03-05T12:45:00+08:00"}, {"id": "sr_3254a7", "title": "解放军和武警部队代表团新闻发言人介绍今年国防支出安排 - 八一视频·中国军网", "source": "八一电视", "url": "http://tv.81.cn/jszqy/16447685.html", "snippet": "来源:中国军网八一视频\n作者:黄显文\n郭鹏\n王震\n康鹏程\n孙文壮\n丛冠月\n编辑:李琛\n责编:魏晓妹\n发布:\n2026-03-10\n18:55:15\n视频信息\n2026年中央和地方预算草案报告明确了国防支出预算总额,请问今年国防支出将如何安排?", "date": "2026-03-10T00:00:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

