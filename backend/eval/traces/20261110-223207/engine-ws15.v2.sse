data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:11:16.419335", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2017, 2020, 2022, 2023, 2024, 2025], 'J20_Output': [24, 48, 70, 100, 110, 120]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\neng = pd.DataFrame({'Engine': ['WS-15', 'F119', 'AL-31F'], 'Thrust': [18.5, 15.5, 12.5], 'TWR': [10.5, 11.7, 8.0]})\nfor col in ['Thrust', 'TWR']:\n    eng[col] = pd.to_numeric(eng[col], errors='coerce')\neng = eng.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nax1.bar(df['Year'], df['J20_Output'], color='#6366f1', width=0.6, label='歼-20年产量')\nax1.plot(df['Year'], df['J20_Output'], color='#06b6d4', linewidth=2.5, marker='o', markersize=8)\nfor x, y in zip(df['Year'], df['J20_Output']):\n    ax1.text(x, y + 3, str(int(y)), ha='center', fontsize=11, fontweight='bold', color='#334155')\nax1.axvline(2023, color='#10b981', linestyle='--', linewidth=2.5)\nax1.text(2023.1, 105, 'WS-15量产交付\\n(2023)', color='#10b981', fontsize=11, fontweight='bold')\nax1.set_title('歼-20年产量与涡扇-15量产节点', fontsize=18, fontweight='bold', pad=20)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('年产量（架）', fontsize=14)\nax1.tick_params(labelsize=12)\nax1.grid(True, linestyle='--', alpha=0.3)\nax1.legend(fontsize=12, loc='upper left')\nax2 = axes[1]\nbars = ax2.bar(eng['Engine'], eng['Thrust'], color=['#06b6d4', '#10b981', '#f59e0b'], width=0.55)\nfor b, t, w in zip(bars, eng['Thrust'], eng['TWR']):\n    ax2.text(b.get_x() + b.get_width() / 2, t + 0.3, f'{t}吨\\n推重比{w}', ha='center', fontsize=11, fontweight='bold', color='#334155')\nax2.set_title('主力发动机推力与推重比对比', fontsize=18, fontweight='bold', pad=20)\nax2.set_xlabel('发动机型号', fontsize=14)\nax2.set_ylabel('最大加力推力（吨）', fontsize=14)\nax2.set_ylim(0, 22)\nax2.tick_params(labelsize=12)\nax2.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "选取歼-20逐年产量（2017-2025）与涡扇-15关键里程碑（2022装机首飞、2023量产、2024批量交付）构建时间序列，观察产能跃升与发动机国产化节点的耦合关系；同时对比WS-15与F119、AL-31F的推力与推重比，量化动力升级对产能释放的技术支撑。输出双面板图：左为产能趋势+里程碑标注，右为发动机性能对比。"}}

