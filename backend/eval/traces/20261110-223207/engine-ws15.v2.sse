data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T23:11:04.496115", "content": {"charts": [{"id": "chart_001", "title": "涡扇-15研制与量产关键节点", "subtitle": "2006-2024年重要里程碑年份", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2006", "2011", "2022", "2023", "2024"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "里程碑事件", "nameTextStyle": {"color": "#666"}, "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"type": "line", "data": [1, 2, 3, 4, 5], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}, "label": {"show": true, "position": "top", "formatter": "{b}", "color": "#1677ff"}}]}}, {"id": "chart_002", "title": "歼-20年产量预测对比", "subtitle": "不同来源的产能估计（架/年）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["Military Watch", "今日头条下限", "今日头条上限"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "interval": 0}}, "yAxis": {"type": "value", "name": "架/年", "nameTextStyle": {"color": "#666"}, "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"type": "bar", "data": [{"value": 120, "itemStyle": {"color": "#1677ff"}}, {"value": 50, "itemStyle": {"color": "#52c41a"}}, {"value": 100, "itemStyle": {"color": "#fa8c16"}}], "barWidth": 40, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#666"}}]}}, {"id": "chart_003", "title": "涡扇-15推力与推重比对比", "subtitle": "不同来源数据对比", "type": "radar", "echarts_option": {"radar": {"indicator": [{"name": "最大推力(吨)", "max": 20}, {"name": "推重比", "max": 12}, {"name": "寿命(千小时)", "max": 7}, {"name": "涡轮前温度(百K)", "max": 20}], "center": ["50%", "50%"], "radius": "60%", "axisName": {"color": "#666"}}, "series": [{"type": "radar", "data": [{"value": [18, 10, 4, 18], "name": "易车网", "itemStyle": {"color": "#1677ff"}, "areaStyle": {"color": "rgba(22,119,255,0.2)"}}, {"value": [15.3, 10, 6, 19], "name": "太平洋汽车", "itemStyle": {"color": "#52c41a"}, "areaStyle": {"color": "rgba(82,196,26,0.2)"}}, {"value": [18.5, 10.5, 4, 18.5], "name": "搜狐", "itemStyle": {"color": "#fa8c16"}, "areaStyle": {"color": "rgba(250,140,22,0.2)"}}]}]}}, {"id": "chart_004", "title": "涡扇-15生产批次与总量", "subtitle": "2019年数据", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["生产批次", "生产总量"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "数量", "nameTextStyle": {"color": "#666"}, "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"type": "bar", "data": [{"value": 3, "itemStyle": {"color": "#1677ff"}}, {"value": 30, "itemStyle": {"color": "#722ed1"}}], "barWidth": 60, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#666"}}]}}]}}

