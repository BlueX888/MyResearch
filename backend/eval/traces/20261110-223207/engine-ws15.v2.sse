data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:12:03.706376", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'指标': ['歼-20累计总产量', '歼-20年产能', '歼-20年交付量', '涡扇-15累计产量', '最大推力', '推重比', '涡扇-15生产批次'], '数值': [1000, 120, 75, 30, 17, 10, 3]}\ndf = pd.DataFrame(data)\nx = np.arange(len(df))\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(x, df['数值'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='指标数值')\nplt.fill_between(x, df['数值'], 0.1, alpha=0.15, color='#6366f1')\nplt.yscale('log')\nplt.xticks(x, df['指标'], rotation=30, ha='right', fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('关键指标', fontsize=14)\nplt.ylabel('数值（对数刻度）', fontsize=14)\nfor i, v in enumerate(df['数值']):\n    plt.text(i, v * 1.15, str(v), ha='center', fontsize=11, fontweight='bold')\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

