data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:11:31.734029", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'指标': ['涡扇-15累计产量(台)', '涡扇-15生产批次(批)', '最大推力(吨)', '推重比', '歼-20年交付量(架/年)', '歼-20年产能(架/年)', '歼-20累计总产量(架)'], '数值': [30, 3, 17, 10, 75, 120, 1000]}\ndf = pd.DataFrame(data)\ndf = df.sort_values('数值').reset_index(drop=True)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['数值'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2, markeredgecolor='#6366f1', label='指标数值')\nplt.fill_between(x, y, 1, alpha=0.15, color='#6366f1')\nplt.yscale('log')\nfor i, v in enumerate(y):\n    plt.text(i, v * 1.18, str(v), ha='center', fontsize=11, fontweight='bold', color='#312e81')\nplt.xticks(x, df['指标'], rotation=20, ha='right', fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('关键指标', fontsize=14)\nplt.ylabel('数值（对数刻度）', fontsize=14)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, frameon=False)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

