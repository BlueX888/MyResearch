data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T23:02:41.531515", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述军用航空发动机与五代机整机市场空间、歼-20交付规模、涡扇-15批产对整机产能弹性的影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["涡扇-15 批产 歼-20 产能 交付量 军用航空发动机 市场"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述航空发动机主机厂、整机总装厂及上游高温合金、精密加工等主要供应企业格局。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["涡扇-15 供应商 航发动力 成飞 歼-20 总装 供应链 竞争格局"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述涡扇-15推力、可靠性、寿命、良率及总装脉动线、供应链国产化等核心技术趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["涡扇-15 推力 可靠性 寿命 良率 脉动生产线 国产化"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、装备采购政策、军工产能建设及出口管制等政策与外部因素。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 装备采购 军工产能 出口管制 航空发动机 政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述发动机良率、高温合金、精密加工、产能爬坡等挑战，以及国产替代和产能释放机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["涡扇-15 产能爬坡 高温合金 精密加工 瓶颈 国产替代 机遇"]}, {"id": "sec_6", "title": "未来展望", "description": "描述涡扇-15批产推动歼-20年交付量提升、双发国产化和产能天花板变化的发展趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["涡扇-15 歼-20 年交付量 产能 预测 未来 趋势"]}], "research_questions": ["涡扇-15当前批产良率和年交付能力如何？歼-20总装产能与发动机供应匹配度如何？政策与供应链约束对产能释放的影响有多大？"]}}

