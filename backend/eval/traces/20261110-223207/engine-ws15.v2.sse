data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:18:02.596072", "content": {"results": [{"id": "fact_a0cd6e1b", "title": "张勇总师提到涡扇-19和涡扇-20；中国航发已为涡扇-19和涡扇-20组织起供应链，当务之急是优化供应链，为大规模生产做好准备。", "source": "中华网军事", "url": "", "snippet": "张勇总师提到涡扇-19和涡扇-20；中国航发已为涡扇-19和涡扇-20组织起供应链，当务之急是优化供应链，为大规模生产做好准备。", "date": "", "isSupplementary": true}, {"id": "fact_e29d1c3e", "title": "涡扇-19被认为是歼-35舰载战斗机的动力，涡扇-20是运-20战略运输机的国产发动机。", "source": "中华网军事", "url": "", "snippet": "涡扇-19被认为是歼-35舰载战斗机的动力，涡扇-20是运-20战略运输机的国产发动机。", "date": "", "isSupplementary": true}, {"id": "fact_28f021aa", "title": "2023年初国产航空发动机出现“井喷”，歼-20“完全体”战机的大批量生产被提上日程。", "source": "中华网军事", "url": "", "snippet": "2023年初国产航空发动机出现“井喷”，歼-20“完全体”战机的大批量生产被提上日程。", "date": "", "isSupplementary": true}, {"id": "fact_ca4d4a96", "title": "涡扇-15推力达到18吨级，目前研发进展到台架测试阶段，预计装备歼-20和歼-10B。", "source": "业百科/百度知道", "url": "", "snippet": "涡扇-15推力达到18吨级，目前研发进展到台架测试阶段，预计装备歼-20和歼-10B。", "date": "", "isSupplementary": true}, {"id": "fact_d57ff693", "title": "涡扇-15总设计师为江和甫，研制单位为中国燃气涡轮研究院，生产厂商包括西安发动机公司/贵州黎阳航空发动机公司。", "source": "搜狗问问", "url": "", "snippet": "涡扇-15总设计师为江和甫，研制单位为中国燃气涡轮研究院，生产厂商包括西安发动机公司/贵州黎阳航空发动机公司。", "date": "", "isSupplementary": true}, {"id": "fact_c69c07aa", "title": "WS-15全称涡扇15“峨眉”涡扇发动机，总设计师为江和甫，由606所、624所、614所、410厂、430厂和113厂等单位专家组织研制，2006年5月首次台...", "source": "搜狗百科", "url": "", "snippet": "WS-15全称涡扇15“峨眉”涡扇发动机，总设计师为江和甫，由606所、624所、614所、410厂、430厂和113厂等单位专家组织研制，2006年5月首次台架运转试车成功。", "date": "", "isSupplementary": true}, {"id": "fact_fb76b7ae", "title": "涡扇-15由中国航空发动机集团自主研发，性能达到世界先进水平，已用于歼-20战斗机。", "source": "易车百科", "url": "", "snippet": "涡扇-15由中国航空发动机集团自主研发，性能达到世界先进水平，已用于歼-20战斗机。", "date": "", "isSupplementary": true}, {"id": "fact_c2713443", "title": "涡扇-15用于歼-20，涡扇-20用于运-20B；航发动力被描述为航空发动机相关上市公司。", "source": "估值网", "url": "", "snippet": "涡扇-15用于歼-20，涡扇-20用于运-20B；航发动力被描述为航空发动机相关上市公司。", "date": "", "isSupplementary": true}, {"id": "fact_7f67c880", "title": "涡扇-15已进入批量装机阶段，公开讨论的首翻期约4000小时，新批次达到4500小时左右。", "source": "搜狐", "url": "", "snippet": "涡扇-15已进入批量装机阶段，公开讨论的首翻期约4000小时，新批次达到4500小时左右。", "date": "", "isSupplementary": true}, {"id": "fact_e94b18f6", "title": "涡扇-15加力推力18.5吨，推重比突破10，并已进入批量装机阶段。", "source": "搜狐", "url": "", "snippet": "涡扇-15加力推力18.5吨，推重比突破10，并已进入批量装机阶段。", "date": "", "isSupplementary": true}, {"id": "fact_3ea4ee28", "title": "F119常被提到的“8000小时”并非8000飞行小时，而是按TAC战术航空循环计算，设计值约8650个TAC，折合首翻概念约4325小时。", "source": "搜狐", "url": "", "snippet": "F119常被提到的“8000小时”并非8000飞行小时，而是按TAC战术航空循环计算，设计值约8650个TAC，折合首翻概念约4325小时。", "date": "", "isSupplementary": true}, {"id": "fact_dd1cd7f4", "title": "F119强调模块化、视情维修，热端老化可换热端、冷端继续使用，零件分批更换并累计整机寿命；涡扇-15公开讨论的是首翻期，即第一次进厂大修前能运行多久，两者寿命统...", "source": "搜狐", "url": "", "snippet": "F119强调模块化、视情维修，热端老化可换热端、冷端继续使用，零件分批更换并累计整机寿命；涡扇-15公开讨论的是首翻期，即第一次进厂大修前能运行多久，两者寿命统计口径不同。", "date": "", "isSupplementary": true}, {"id": "fact_19613097", "title": "到2026年5月，航材院李嘉荣团队推动的第二代DD6镍基单晶高温合金取得进展，耐温可达1500°C，铼元素比例优化，制造成本比欧美同级材料低约20%，单晶叶片良...", "source": "搜狐", "url": "", "snippet": "到2026年5月，航材院李嘉荣团队推动的第二代DD6镍基单晶高温合金取得进展，耐温可达1500°C，铼元素比例优化，制造成本比欧美同级材料低约20%，单晶叶片良品率突破72%，粉末冶金涡轮盘实现自主量产。", "date": "", "isSupplementary": true}, {"id": "fact_67801e3e", "title": "中华网文章称，换装涡扇-15后歼-20超音速巡航速度有望达到1.8马赫，推力达18.5吨；2024年歼-20年产量已突破100架，部分机构推测达到120架；截至...", "source": "中华网", "url": "", "snippet": "中华网文章称，换装涡扇-15后歼-20超音速巡航速度有望达到1.8马赫，推力达18.5吨；2024年歼-20年产量已突破100架，部分机构推测达到120架；截至2024年底总装备数量保守估计超过350架；随着涡扇-15开始批量供应，后续生产的歼-20将全部采用该发动机。", "date": "", "isSupplementary": true}, {"id": "fact_a17e31b0", "title": "网易新闻称，2025年年底成飞年度生产交付任务进入尾声，网友拍到出厂试飞的新机尾喷口为涡扇-15，包括黄皮机和歼-20A量产机，表明涡扇-15版歼-20批量生产...", "source": "网易新闻客户端", "url": "", "snippet": "网易新闻称，2025年年底成飞年度生产交付任务进入尾声，网友拍到出厂试飞的新机尾喷口为涡扇-15，包括黄皮机和歼-20A量产机，表明涡扇-15版歼-20批量生产已是确定事实；2024年9月美国The War Zone曾曝光搭载涡扇-15的歼-20高清照片，但当时仍为测试状态。", "date": "", "isSupplementary": true}, {"id": "fact_52abb728", "title": "新浪新闻称，2024年涡扇-15发动机进入定型阶段，推力达到16.3吨，接近美国F-22所用F119发动机的15.8吨推力，使歼-20实现完全国产化并提升超音速...", "source": "新浪网", "url": "", "snippet": "新浪新闻称，2024年涡扇-15发动机进入定型阶段，推力达到16.3吨，接近美国F-22所用F119发动机的15.8吨推力，使歼-20实现完全国产化并提升超音速巡航、隐形能力和机动性。", "date": "", "isSupplementary": true}, {"id": "fact_5efef6c6", "title": "腾讯网文章称，歼-20正在试飞换装涡扇-15发动机，涡扇-15提供更高推力和燃油效率，提升机动性、速度和续航能力；专家分析认为未来几年内歼-20总产量有望达到1...", "source": "腾讯网", "url": "", "snippet": "腾讯网文章称，歼-20正在试飞换装涡扇-15发动机，涡扇-15提供更高推力和燃油效率，提升机动性、速度和续航能力；专家分析认为未来几年内歼-20总产量有望达到1000架左右。", "date": "", "isSupplementary": true}, {"id": "fact_664a569b", "title": "中华网文章引用成飞官方通告称，2024年成飞超额完成军机生产任务，连续6年达成均衡生产目标。", "source": "中华网", "url": "", "snippet": "中华网文章引用成飞官方通告称，2024年成飞超额完成军机生产任务，连续6年达成均衡生产目标。", "date": "", "isSupplementary": true}, {"id": "fact_69a35672", "title": "易车百科称涡扇-15仍在研发中，尚未正式投入批量生产和使用，该说法与2024—2025年多条新闻所称的批量装机信息存在矛盾，可信度较低。", "source": "易车百科", "url": "", "snippet": "易车百科称涡扇-15仍在研发中，尚未正式投入批量生产和使用，该说法与2024—2025年多条新闻所称的批量装机信息存在矛盾，可信度较低。", "date": "", "isSupplementary": true}, {"id": "fact_c6a1046b", "title": "喜马拉雅FM音频内容称涡扇-15已正式进入量产阶段，配置国产发动机的歼-20将很快亮相，但来源为音频平台，可信度较低。", "source": "喜马拉雅FM", "url": "", "snippet": "喜马拉雅FM音频内容称涡扇-15已正式进入量产阶段，配置国产发动机的歼-20将很快亮相，但来源为音频平台，可信度较低。", "date": "", "isSupplementary": true}]}}

