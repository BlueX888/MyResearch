data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:08:04.594650", "content": {"results": [{"id": "fact_4f1d5a8f", "title": "今日头条文章预测，歼-20在2023-2025年期间年产100架，使用涡扇-15发动机，2025年末量产型总数预计达到516架。", "source": "今日头条", "url": "", "snippet": "今日头条文章预测，歼-20在2023-2025年期间年产100架，使用涡扇-15发动机，2025年末量产型总数预计达到516架。", "date": "", "isSupplementary": false}, {"id": "fact_c94b1ce7", "title": "雪球帖子称，截至2021年末歼-20实际下线约85台，生产编号到CB0385；2022年总装二厂投产，当年生产约80台；2023年总装三厂已投产，全年可下线10...", "source": "雪球", "url": "", "snippet": "雪球帖子称，截至2021年末歼-20实际下线约85台，生产编号到CB0385；2022年总装二厂投产，当年生产约80台；2023年总装三厂已投产，全年可下线100台以上。", "date": "", "isSupplementary": false}, {"id": "fact_beea8862", "title": "雪球帖子称，2023年部装（所有零件）可交到300套，按脉动生产线边不留物料原则，实际可造280台上下。", "source": "雪球", "url": "", "snippet": "雪球帖子称，2023年部装（所有零件）可交到300套，按脉动生产线边不留物料原则，实际可造280台上下。", "date": "", "isSupplementary": false}, {"id": "fact_e2e93377", "title": "雪球帖子称，装WS-15发动机的歼-20在“今年6月”首飞，帖文语境约为2023年。", "source": "雪球", "url": "", "snippet": "雪球帖子称，装WS-15发动机的歼-20在“今年6月”首飞，帖文语境约为2023年。", "date": "", "isSupplementary": false}, {"id": "fact_fb626cee", "title": "财经头条文章转引美国“防务博客”及《军事观察杂志》称，2023年歼-20产量已接近100架，2025年后年产将达120架，目前已有大约200架歼-20，列装五大...", "source": "财经头条（转引防务博客/军事观察杂志）", "url": "", "snippet": "财经头条文章转引美国“防务博客”及《军事观察杂志》称，2023年歼-20产量已接近100架，2025年后年产将达120架，目前已有大约200架歼-20，列装五大战区13个航空旅，2030年将装备30个航空旅。", "date": "", "isSupplementary": false}, {"id": "fact_e1680383", "title": "财经头条文章称，2022年珠海航展上歼-20已换装WS-10C国产发动机；目前歼-20 3.0版本正在换装WS-15发动机，并称动力系统瓶颈被彻底解决。", "source": "财经头条", "url": "", "snippet": "财经头条文章称，2022年珠海航展上歼-20已换装WS-10C国产发动机；目前歼-20 3.0版本正在换装WS-15发动机，并称动力系统瓶颈被彻底解决。", "date": "", "isSupplementary": false}, {"id": "fact_73671982", "title": "今日头条转引美媒称，2024年歼-20交付量将超百架，2025年将超过120架；专家预计到2024年底歼-20总产量将达到400架；涡扇-15前年已装机。", "source": "今日头条（转引美媒）", "url": "", "snippet": "今日头条转引美媒称，2024年歼-20交付量将超百架，2025年将超过120架；专家预计到2024年底歼-20总产量将达到400架；涡扇-15前年已装机。", "date": "", "isSupplementary": false}, {"id": "fact_f5ba0c02", "title": "风闻文章称，西方分析家认为2023年仅歼-20隐形战斗机产量就超过100架；美国“防务博客”2023年8月预测歼-20每年可生产100架；美国分析师里克·乔伊估...", "source": "风闻（转引防务博客/里克·乔伊）", "url": "", "snippet": "风闻文章称，西方分析家认为2023年仅歼-20隐形战斗机产量就超过100架；美国“防务博客”2023年8月预测歼-20每年可生产100架；美国分析师里克·乔伊估算2023年底年产量可能达到100架，并在2024年轻松达到该目标。", "date": "", "isSupplementary": false}, {"id": "fact_7065ee42", "title": "腾讯网文章称，歼-20在2023年总产量超过100架，现役规模约300架；预计2024年底中国空军将有400架歼-20可用。", "source": "腾讯网", "url": "", "snippet": "腾讯网文章称，歼-20在2023年总产量超过100架，现役规模约300架；预计2024年底中国空军将有400架歼-20可用。", "date": "", "isSupplementary": false}, {"id": "fact_2d493a0f", "title": "财经头条文章还称，有法国军事专家分析歼-20总产量已逼近300架大关，该说法与同文“目前约200架”及腾讯“现役约300架”存在口径和数字冲突。", "source": "财经头条", "url": "", "snippet": "财经头条文章还称，有法国军事专家分析歼-20总产量已逼近300架大关，该说法与同文“目前约200架”及腾讯“现役约300架”存在口径和数字冲突。", "date": "", "isSupplementary": false}, {"id": "fact_438c1996", "title": "今日头条文章转述称，央视国防专题透露中国当时有4条歼-20生产线，每条生产线每月可生产1架，年最多可产48架。", "source": "今日头条-笑史云烟", "url": "", "snippet": "今日头条文章转述称，央视国防专题透露中国当时有4条歼-20生产线，每条生产线每月可生产1架，年最多可产48架。", "date": "", "isSupplementary": false}, {"id": "fact_9051618e", "title": "今日头条文章称，成飞对歼-20生产线进行全面升级，采用“飞机动人不动”的脉动生产线模式，以提升装配效率。", "source": "今日头条-笑史云烟", "url": "", "snippet": "今日头条文章称，成飞对歼-20生产线进行全面升级，采用“飞机动人不动”的脉动生产线模式，以提升装配效率。", "date": "", "isSupplementary": false}, {"id": "fact_2332436d", "title": "今日头条文章称，新脉动生产线生产一架歼-20仅需8天时间；该数据以“据称”表述，未给出央视原始报道链接。", "source": "今日头条-笑史云烟", "url": "", "snippet": "今日头条文章称，新脉动生产线生产一架歼-20仅需8天时间；该数据以“据称”表述，未给出央视原始报道链接。", "date": "", "isSupplementary": false}, {"id": "fact_7589a022", "title": "今日头条文章推算称，成都新厂房可容纳5条脉动生产线，其中3条专门用于生产歼-20，一年可打造130多架；加上原有老生产线，每年可产歼-20数量将达到176架，足...", "source": "今日头条-笑史云烟", "url": "", "snippet": "今日头条文章推算称，成都新厂房可容纳5条脉动生产线，其中3条专门用于生产歼-20，一年可打造130多架；加上原有老生产线，每年可产歼-20数量将达到176架，足以装备7个歼-20满编航空旅。", "date": "", "isSupplementary": false}, {"id": "fact_6f453c31", "title": "网易新闻客户端文章称，歼-20于2011年1月11日首飞，2017年3月正式列装空军，从小批量起步。", "source": "网易新闻客户端", "url": "", "snippet": "网易新闻客户端文章称，歼-20于2011年1月11日首飞，2017年3月正式列装空军，从小批量起步。", "date": "", "isSupplementary": false}, {"id": "fact_d0c0d0b5", "title": "网易新闻客户端文章称，歼-20早期发动机从进口AL-31F换到国产WS-10C，经历了一段过渡过程。", "source": "网易新闻客户端", "url": "", "snippet": "网易新闻客户端文章称，歼-20早期发动机从进口AL-31F换到国产WS-10C，经历了一段过渡过程。", "date": "", "isSupplementary": false}, {"id": "fact_261c7899", "title": "网易新闻客户端文章称，到2022年歼-20累计交付破百架，空军多个航空旅开始换装。", "source": "网易新闻客户端", "url": "", "snippet": "网易新闻客户端文章称，到2022年歼-20累计交付破百架，空军多个航空旅开始换装。", "date": "", "isSupplementary": false}, {"id": "fact_e793658a", "title": "网易新闻客户端文章称，2023年是转折点，歼-20年产量冲到100架左右，脉动生产线投用后效率直接翻番。", "source": "网易新闻客户端", "url": "", "snippet": "网易新闻客户端文章称，2023年是转折点，歼-20年产量冲到100架左右，脉动生产线投用后效率直接翻番。", "date": "", "isSupplementary": false}, {"id": "fact_97714ed9", "title": "网易新闻客户端文章称，歼-20服役数量到2024年中超过300架。", "source": "网易新闻客户端", "url": "", "snippet": "网易新闻客户端文章称，歼-20服役数量到2024年中超过300架。", "date": "", "isSupplementary": false}, {"id": "fact_902c8357", "title": "本次搜索结果未提供涡扇-15批产良率、交付节奏、装机歼-20数量或与总装线扩张匹配的直接官方数据；关键产能数据多为二手转述或推算。", "source": "本次搜索结果综合", "url": "", "snippet": "本次搜索结果未提供涡扇-15批产良率、交付节奏、装机歼-20数量或与总装线扩张匹配的直接官方数据；关键产能数据多为二手转述或推算。", "date": "", "isSupplementary": false}]}}

