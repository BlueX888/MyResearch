data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T23:03:06.195433", "content": {"graph": {"nodes": [{"id": "node_0", "name": "中国航发（AECC）", "type": "company", "discovered_at": "2026-11-10T23:03:06.195297"}, {"id": "node_1", "name": "中国航发北京航空材料研究院", "type": "company", "discovered_at": "2026-11-10T23:03:06.195305"}, {"id": "node_2", "name": "张勇", "type": "person", "discovered_at": "2026-11-10T23:03:06.195310"}, {"id": "node_3", "name": "中航工业（AVIC）", "type": "company", "discovered_at": "2026-11-10T23:03:06.195315"}, {"id": "node_4", "name": "涡扇-15（峨眉）", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195320"}, {"id": "node_5", "name": "涡扇-10C", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195329"}, {"id": "node_6", "name": "歼-20A/歼-20S", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195335"}, {"id": "node_7", "name": "涡扇-19", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195340"}, {"id": "node_8", "name": "涡扇-20", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195345"}, {"id": "node_9", "name": "Military Watch Magazine", "type": "company", "discovered_at": "2026-11-10T23:03:06.195350"}, {"id": "node_10", "name": "英国皇家联合军种研究院（RUSI）", "type": "company", "discovered_at": "2026-11-10T23:03:06.195354"}, {"id": "node_11", "name": "C919", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195358"}], "edges": [{"source": "中国航发（AECC）", "relation": "涡扇-15研制生产主体", "discovered_at": "2026-11-10T23:03:06.195300"}, {"source": "中国航发（AECC）", "relation": "涡扇-10/19/20研制方", "discovered_at": "2026-11-10T23:03:06.195302"}, {"source": "中国航发（AECC）", "relation": "供应链组织者", "discovered_at": "2026-11-10T23:03:06.195303"}, {"source": "中国航发北京航空材料研究院", "relation": "张勇所在单位", "discovered_at": "2026-11-10T23:03:06.195307"}, {"source": "中国航发北京航空材料研究院", "relation": "涡扇-15材料与工艺研发", "discovered_at": "2026-11-10T23:03:06.195308"}, {"source": "张勇", "relation": "中国航发北京航空材料研究院项目负责人/总师", "discovered_at": "2026-11-10T23:03:06.195312"}, {"source": "张勇", "relation": "涡扇-15量产信息发布者", "discovered_at": "2026-11-10T23:03:06.195313"}, {"source": "中航工业（AVIC）", "relation": "歼-20整机研制生产主体", "discovered_at": "2026-11-10T23:03:06.195317"}, {"source": "中航工业（AVIC）", "relation": "总装产能承担方", "discovered_at": "2026-11-10T23:03:06.195318"}, {"source": "涡扇-15（峨眉）", "relation": "歼-20目标动力", "discovered_at": "2026-11-10T23:03:06.195323"}, {"source": "涡扇-15（峨眉）", "relation": "第五代军用涡扇发动机", "discovered_at": "2026-11-10T23:03:06.195324"}, {"source": "涡扇-15（峨眉）", "relation": "支持超音速巡航与矢量推力", "discovered_at": "2026-11-10T23:03:06.195325"}, {"source": "涡扇-10C", "relation": "歼-20过渡动力型号", "discovered_at": "2026-11-10T23:03:06.195331"}, {"source": "涡扇-10C", "relation": "被涡扇-15替代", "discovered_at": "2026-11-10T23:03:06.195333"}, {"source": "歼-20A/歼-20S", "relation": "涡扇-15装机平台", "discovered_at": "2026-11-10T23:03:06.195336"}, {"source": "歼-20A/歼-20S", "relation": "双座型/改进型", "discovered_at": "2026-11-10T23:03:06.195338"}, {"source": "涡扇-19", "relation": "歼-35舰载机动力", "discovered_at": "2026-11-10T23:03:06.195341"}, {"source": "涡扇-19", "relation": "供应链优化对象", "discovered_at": "2026-11-10T23:03:06.195343"}, {"source": "涡扇-20", "relation": "运-20动力", "discovered_at": "2026-11-10T23:03:06.195347"}, {"source": "涡扇-20", "relation": "供应链优化对象", "discovered_at": "2026-11-10T23:03:06.195348"}, {"source": "Military Watch Magazine", "relation": "歼-20年产能120架说法的外媒来源", "discovered_at": "2026-11-10T23:03:06.195352"}, {"source": "英国皇家联合军种研究院（RUSI）", "relation": "被引用的防务智库来源", "discovered_at": "2026-11-10T23:03:06.195356"}, {"source": "C919", "relation": "民用航发断供风险案例", "discovered_at": "2026-11-10T23:03:06.195360"}, {"source": "C919", "relation": "航发自主可控参照", "discovered_at": "2026-11-10T23:03:06.195362"}]}, "stats": {"entitiesCount": 12, "relationsCount": 24}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:03:06.195518", "content": {"agent": "DeepScout", "section": "市场概况", "facts_count": 11, "duplicates_removed": 0, "data_points_count": 8, "insights": ["涡扇-15“批量生产/批量交付”的核心信息源可追溯至中国航发北京航空材料研究院张勇2023年3月的公开表述，但所有检索到的文章均为二手转述，缺乏原始官方通稿或央视原文链接，需回溯一手来源。", "关于歼-20产能的数字（50-100架/年、120架/年、总产量1000架）全部为自媒体或外媒推测，无任何官方或券商/智库量化模型支撑，且不同来源区间差异达2倍以上，不宜直接用于市场空间测算。", "“发动机批产→整机产能弹性”的传导链条在证据上存在断点：没有任何来源披露涡扇-15的实际年产量、良率、交付节奏，也没有歼-20总装线数量/节拍数据，因此产能弹性系数无法量化。"], "source_quality": "整体来源质量偏低（加权可信度约0.33）。11条事实中9条来自自媒体平台（AcFun 0.15、B站 0.3、网易号 0.45、头条号 0.3、喜马拉雅 0.25、天眼查转载 0.3），普遍存在标题党、数字臆测、无原始出处等问题；仅新浪军事（2018）与中华网军事（2023）为一般新闻媒体（0.5-0.55），且前者信息已过时。所有关键量化数据（歼-20年产能50/100/120架、总产量1000架、涡扇-15产量30台）均无可追溯的一手来源，属于推测性内容。核心事实“涡扇-15批量生产交付”虽被多源重复，但均指向同一二手转述（张勇2023年3月采访），存在信息同源放大风险。建议后续优先补充：中国航发/航空工业官方通稿、央视军事原始报道、RUSI等智库报告原文、券商军工行业深度报告，以替换当前自媒体证据链。", "hypothesis_updates": 3, "search_results": [{"title": "涡扇15已经生产3个批次?总量或高达30台:比美制发动机更给力 - AcFun弹幕视频网 - 认真你就输啦 (?ω?)ノ- ( - )つロ", "url": "https://www.acfun.cn/v/ac10406531", "source": "AcFun", "snippet": "众所周知,涡扇15是我国性能指标最为先进的国产发动机,也是歼20完全体的配备,最近,这款发动机似乎完成了交付。", "date": "2019-07-09T20:49:16+08:00"}, {"title": "大干一场!美媒:歼-20A/S搭载涡扇-15性能拉满,产能涨到120架?-其他_ 天眼查新闻", "url": "https://news.tianyancha.com/ll_hnvsq9gqaj.html", "source": "天眼查企业头条", "snippet": "涡轮吹响,产能冲天!歼-20A/S“拉满档”,年产120架真能吃得消?说到今年的军圈“大瓜”,涡扇-15这台发动机绝对是主角。美国“军事观察”网站最近还特意掰开扒了讲,说中航工业就是等涡扇-15煮熟以后才敢放开手脚,现在歼-20A和歼-20S都搭上了这颗“中国心”,预计产量能蹿到120架一年。听着是不是有点像“涡扇-15一装上,直接起飞到地球边缘”,但实际情况真这么猛吗?对了,英国皇家联合服务研...查看全文", "date": "2008-11-06T00:00:00+08:00"}, {"title": "我歼20加速换装新型涡扇15 2025年后可夺取亚太制空权歼20战斗机涡扇15_新浪军事_新浪网", "url": "http://mil.news.sina.com.cn/jssd/2018-09-30/doc-ifxeuwwr9846002.shtml", "source": "新浪网新闻中心", "snippet": "涡扇-15发动机就是改进以后为歼-20配置的新型发动机。 新型涡扇-15发动机拥有世界先进的单晶涡轮叶片,虽然已经注入大量投资研发了好几年,但仍未能够投入大批量生产,主要还是历史因素造成的尴尬局面。由于中国航空工业发展的时间相对较短,工业基础相比美俄等国仍较为薄弱,航空发动机的研制与批量生产长期以来一直是中国的短板。", "date": "2018-09-30T15:25:00+08:00"}, {"title": "歼20换装涡扇-15发动机,总产量有望达到1000架左右_腾讯新闻", "url": "https://view.inews.qq.com/a/20241010A05VAN00", "source": "腾讯网", "snippet": "中国歼-20战斗机正在进行重要升级,换装涡扇-15发动机,提升战斗力。 2 . 涡扇-15发动机提供更高推力和燃油效率,使歼-20在空中具有更卓越的机动性和速度。 3 . 除此之外,歼-20还装备了霹雳-15和霹雳-10导弹,提升了制空作战综合实力。 而现在,它正在进行一次重要升级, 试飞换装涡扇-15发动机 ,作为目标动力的新型航发,给这位“空中龙卷风”带来了更完整的战斗力。 涡扇-15提供了更高的推力,使得 歼-20 在空中能够实现更为卓越的机动性与速度。涡扇-15在燃油效率方面的进步同样不可小觑。", "date": "2024-10-10T16:54:00+08:00"}, {"title": "官方证实,涡扇15已批量交付!五代航发也取得重大进展_大国重器中国基建与军技、大国竞争与国际机遇_免费在线阅读收听下载 - 喜马拉雅", "url": "https://www.ximalaya.com/sound/718883712", "source": "喜马拉雅FM", "snippet": "在我国西安举行相关活动时曝出了与我国工业研发有关的大消息,其中就有我们涡扇15发动机的先关消息,所说中证实了它目前已经实现了批量交付。实际上在去年3月份的时候,中央电视台也曾经提到过已经完成了对于这一款发动机的研制,而且在经过多轮的测试之后,已经使它的性能得到了很大的改善,所以在当时大家就猜测它已经进入了批量生产的状态,目前这一消息得以证实更是确定了大家所想。而且这一消息不仅仅是让军迷为之欢喜,同时这一爆炸性消息的得知也更让其他国家感受到了巨大的军事压力。在当下这一时期西方国家正在急于向我国断供航空发动机,尤其是在我们民用大型客机C919即将运营之际,他们特别想在这一方面让我国受到牵制,从而影响我国的发展,但这显然会是徒劳的。航空发动机作为工业发展当中相当关键的一个部件,是国家战略发展当中极其重要的一个建设基础,同时也是体现一个国家发展速度快慢的重要参考因素,涡扇15进入批量生产的事情已经让我国在今后工业发展之中具备了更大的底气。虽然,由于我国在发动机研发中缺乏经验,不仅仅起步晚,也遭受到其他国家进行的封锁,所以一直以来都是对国外的发动机大量引进和运用。但是这些发动机大部分都不能满足于我国空军对于发动机的需求,而且还受到价格波动的影响,好在我国现在的航空发动机领域投入加大之后,在我们科研人员的努力之下已经取得了很大的突破,这使得我们在之后不再受到西方国家的制约。然而这一次所提到的涡扇15发动机,并不是我国航空工业目前能够达到的最高水平,但是从目前批量生产的应用上来说,这一款发动机绝对是我国性能极为不错的发动机。它在全世界的同类产品之中也非常的突出,更重要的是它还是与我们歼20隐身战机进行官方匹配的发动机,歼20作为我国五代机,而且是我国先进技术之下最新的一款隐身战机,而且在隐身性上达到的性能在全世界范围之内都是数一数二的。然而在之前我们这一款战机使用的发动机却一直都是俄制的", "date": "2024-03-29T22:48:06+08:00"}, {"title": "涡扇-15发动机 - 哔哩哔哩", "url": "https://www.bilibili.com/read/cv23287494", "source": "哔哩哔哩", "snippet": "代号“峨眉”的涡扇-15发动机是中国自主研发的第五代隐形战斗机的发动机,是歼-20隐身战斗机的动力心脏。今年3月26日,中国航发北京航空材料研究院项目负责人张勇接受采访时透露:涡扇-15发动机已经实现量产,这对于歼-20战机来说是一个重大的里程碑。本文将探讨涡扇-15发动机实现批交付对歼-20战机带来的变化。 涡扇-15发动机的量产意味着歼-20的产量将得到提升。由于发动机是战斗机的核心部件之一,而涡扇-15发动机又是一款高性能的发动机,所以其交付对于提高歼-20的整体性能和数量都有着重要的意义。随着涡扇-15发动机的大规模应用,未来歼-20的数量也将得到增加,这将进一步提高中国空军的综合战斗力。 涡扇-15发动机的大量投入使用,将使得歼-20的动力性能有了极大的提升。该发动机采用了最新的技术和材料,具有更高的推力、更低的热特征和更长的使用寿命等优点。相比之前歼-20使用的WS-10C发动机,涡扇-15发动机将使得歼-20战斗机的速度、机动性和隐身性能都有所提高。这将使得歼-20在未来的空战中更加具有优势,能够更好地应对各种威胁和挑战。", "date": "2023-04-25T01:23:00+08:00"}, {"title": "涡扇15量产,歼20完全版性能足以赶越F22战斗机五代机发动机歼-20矢量推力军工企业隐身战机军用飞行器f22战斗机F-22猛禽战斗机_网易订阅", "url": "https://www.163.com/dy/article/I0RQHNSP05530QHY.html", "source": "网易", "snippet": "涡扇15,而且还是矢量发动机,没想到中国航空发动机发展如此神速。近期,中国航发北京航空材料研究院项目负责人张勇表示,所有技术瓶颈已经被我们打破,涡扇10、涡扇15已经批量生产交付。可以这么理解,大家期待的涡扇15发动机已经实现量产,装机对象歼-20已经能够发挥最强性能。涡扇15装机试飞不过两年,现在就能够批量交付,足以说明中国航空工业发展到了一个顶峰。多年以来的技术积累,厚积薄发慢慢以新式装备展现出来,如果目前进展顺利的话,可能在明年后就能看到量产型歼-20C,也就是换装涡扇15矢量推力新型号。解决了超音速巡航问题,以及矢量推力技术问题,歼-20隐形战斗机成为真正意义上五代机最强。", "date": "2023-03-27T17:27:27+08:00"}, {"title": "国产航发熬出头:涡扇15量产,歼-20获得真正超巡能力_军事频道_中华网", "url": "https://military.china.com/news/13004177/20230329/44767449_2.html", "source": "中华网军事", "snippet": "涡扇-15发动机为数不多的官方照片在这次中国航空创新创业大赛上,张勇总师还提到了另外两款发动机,涡扇-19和涡扇-20,未来的第五代发动机也在进行研制中。涡扇-19被认为是我国歼-35舰载战斗机的动力,而涡扇-20是运-20战略运输机的国产发动机。张勇总师称,中国航发已经为涡扇-19和涡扇-20组织起了供应链,当务之急是对供应链进行优化,为大规模生产做好准备。事实证明,是中国航发人数十年如一日默默无闻的奉献,才提高了我们的基础科研能力、整体和分系统设计能力、材料水平、电子技术水平和先进制造能力。也正因为这些航发人的奋斗,才带来了2023年初,我们国产航空发动机的“井喷”。中国的航空工业正在摆脱“心脏病”。到了现在,歼-20“完全体”战机下饺子式的大批量生产,终于是时候安排上了。", "date": "2023-03-29T10:19:13+08:00"}, {"title": "歼20开始下饺子，涡扇15全面列装，交付量或达一年50-100架", "url": "https://m.toutiao.com/article/7395511000575574528/", "source": "今日头条", "snippet": "涡扇15型发动机作为中国自主研发的高性能航空发动机,其国产化不仅标志着我国在航空动力领域取得了重大突破,也极大提升了国防实力。这款发动机的列装,为歼20战斗机提供了强大的动力支持,使其在空中作战能力上有了显著的提升。随着技术成熟度的提高和生产线的优化,涡扇15型发动机的年产能也在不断增加。据估计,未来几年内,歼20的年产能有望达到一个新的高度,这不仅将满足国内军方的需求,还有可能对外出口,展示中国航空工业的实力。量产的实现,将进一步降低成本,提高生产效率,为我国航空工业的持续发展和国际竞争力的提升打下坚实的基础。\n歼20生产车间的公开视频向世界展示了中国航空制造业的先进水平。在视频中,观众可以看到高度自动化的生产流程,每一个环节都严格遵循着既定的标准和流程,确保了生产效率的最大化。从原材料的准备到最终的组装,每一个步骤都被精确控制,以减少任何可能的延误和错误。生产线上的机器人和自动化设备协同工作,不仅提高了生产速度,也保证了产品的一致性和高质量。此外,生产过程中的实时监控系统能够及时发现并解决生产中的问题,进一步提高了生产效率。这种高效率的生产流程不仅体现了中国航空工业的现代化,也展示了中国在高端制造业领域的竞争力。\n在当前的国际军事竞争中,歼20与美国F35战机的数量和性能比较一直是热点话题。随着中国歼20的不断列装和产能提升,其在全球范围内的影响力也在逐步增强。相比之下,美国F35战机虽然在数量上占据优势,但面对歼20的快速发展,美国也在积极调整其应对策略。美国不仅在提升F35的生产和部署速度,还在研发新一代的战斗机,以保持其在国际军事竞争中的领先地位。同时,美国也在加强与其他盟友的军事合作,通过联合演习和技术交流,共同应对潜在的挑战。这种多方面的策略调整,旨在确保美国在全球军事竞争中始终保持优势地位。\n歼20作为中国自主研发的第五代隐身战斗机,其性能优势在多个方面得到", "date": "2024-07-26T19:18:00+08:00"}], "extracted_facts": [{"content": "中国航发北京航空材料研究院项目负责人张勇在2023年3月接受采访时表示，涡扇-10、涡扇-15已批量生产交付，所有技术瓶颈已被打破。", "source_name": "网易（转载中国航发北京航空材料研究院项目负责人张勇采访）", "source_url": "https://www.163.com/dy/article/I0RQHNSP05530QHY.html", "credibility": 0.45}, {"content": "2023年3月26日，中国航发北京航空材料研究院项目负责人张勇透露涡扇-15已实现量产，被视为歼-20动力瓶颈解除的里程碑。", "source_name": "哔哩哔哩专栏", "source_url": "https://www.bilibili.com/read/cv23287494", "credibility": 0.3}, {"content": "2024年3月有消息称官方证实涡扇-15已实现批量交付，此前2022年3月央视曾报道该发动机完成研制并通过多轮测试。", "source_name": "喜马拉雅FM（音频自媒体）", "source_url": "https://www.ximalaya.com/sound/718883712", "credibility": 0.25}, {"content": "中华网军事援引张勇总师表述称，中国航发已为涡扇-19、涡扇-20组织起供应链，当务之急是对供应链进行优化，为大规模生产做好准备；文章称歼-20“完全体”大批量生产“是时候安排上了”。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20230329/44767449_2.html", "credibility": 0.55}, {"content": "美媒“军事观察”（Military Watch）称，中航工业在涡扇-15成熟后才放开歼-20A/歼-20S生产，预计年产量可提升至120架；该文同时对该数字提出质疑，并援引英国皇家联合军种研究院（RUSI）观点。", "source_name": "天眼查企业头条（转载）", "source_url": "https://news.tianyancha.com/ll_hnvsq9gqaj.html", "credibility": 0.3}, {"content": "今日头条文章称，随着涡扇-15技术成熟度提高和生产线的优化，歼-20年交付量或达50-100架，并称生产车间已实现高度自动化（机器人、自动化设备、实时监控系统）。", "source_name": "今日头条", "source_url": "https://m.toutiao.com/article/7395511000575574528/", "credibility": 0.3}, {"content": "腾讯新闻2024年10月报道称，歼-20正在试飞换装涡扇-15，涡扇-15提供更高推力与燃油效率，使歼-20具备更优机动性与速度；文章推测歼-20总产量有望达约1000架。", "source_name": "腾讯新闻", "source_url": "https://view.inews.qq.com/a/20241010A05VAN00", "credibility": 0.5}, {"content": "2018年新浪军事报道指出，涡扇-15虽已投入大量资金研发多年，但当时仍未能够投入大批量生产，主因是中国航空工业基础相对薄弱、航发研制与批产长期是短板。", "source_name": "新浪军事", "source_url": "http://mil.news.sina.com.cn/jssd/2018-09-30/doc-ifxeuwwr9846002.shtml", "credibility": 0.5}], "data_points": [{"name": "涡扇-15状态", "value": "批量生产交付", "unit": "状态", "year": 2023, "source": "网易（转载中国航发北京航空材料研究院项目负责人张勇采访）"}, {"name": "涡扇-15量产时间", "value": "2023年3月", "unit": "时间", "year": 2023, "source": "哔哩哔哩专栏"}, {"name": "涡扇-15批量交付", "value": "已实现", "unit": "状态", "year": 2024, "source": "喜马拉雅FM（音频自媒体）"}, {"name": "歼-20年产能（推测）", "value": "120", "unit": "架/年", "year": 2024, "source": "天眼查企业头条（转载）"}, {"name": "歼-20年交付量（推测）", "value": "50-100", "unit": "架/年", "year": 2024, "source": "今日头条"}, {"name": "歼-20累计总产量（推测）", "value": "约1000", "unit": "架", "year": 2024, "source": "腾讯新闻"}, {"name": "涡扇-15累计产量（推测）", "value": "约30", "unit": "台", "year": 2019, "source": "AcFun弹幕视频网"}, {"name": "涡扇-15生产批次（推测）", "value": "3", "unit": "批", "year": 2019, "source": "AcFun弹幕视频网"}]}}

data: {"type": "thought", "agent": "DeepScout", "timestamp": "2026-11-10T23:03:06.196138", "content": {"agent": "DeepScout", "content": "追溯原始数据源: 张勇 中国航发北京航空材料研究院 涡扇-15 批量生产 采访 原文, 央视 2022年3月 涡扇-15 研制完成 报道"}}

data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:03:06.196190", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["张勇 中国航发北京航空材料研究院 涡扇-15 批量生产 采访 原文", "央视 2022年3月 涡扇-15 研制完成 报道"], "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:03:06.488932", "content": {"results": [{"id": "sr_0a9241", "title": "国产航发熬出头:涡扇15量产,歼-20获得真正超巡能力_军事频道_中华网", "source": "中华网军事", "url": "https://military.china.com/news/13004177/20230329/44767449_2.html", "snippet": "涡扇-15发动机为数不多的官方照片在这次中国航空创新创业大赛上,张勇总师还提到了另外两款发动机,涡扇-19和涡扇-20,未来的第五代发动机也在进行研制中。涡扇-19被认为是我国歼-35舰载战斗机的动力,而涡扇-20是运-20战略运输机的国产发动机。张勇总师称,中国航发已经为涡扇-19和涡扇-20组织起了供应链,当务之急是对供应链进行优化,为大规模生产做好准备。事实证明,是中国航发人数十年如一日默默无闻的奉献,才提高了我们的基础科研能力、整体和分系统设计能力、材料水平、电子技术水平和先进制造能力。也正因为这些航发人的奋斗,才带来了2023年初,我们国产航空发动机的“井喷”。中国的航空工业正在摆脱“心脏病”。到了现在,歼-20“完全体”战机下饺子式的大批量生产,终于是时候安排上了。", "date": "2023-03-29T10:19:13+08:00"}, {"id": "sr_156eab", "title": "国产航发熬出头:涡扇15量产,歼-20获得真正超巡能力_军事频道_中华网", "source": "中华网军事", "url": "https://military.china.com/news/13004177/20230329/44767449.html", "snippet": "进入今年以来,我国广大军迷们可谓是惊喜连连,中国航空发动机行业厚积薄发,终于迎来了收获的时刻。先是装备涡扇-20发动机的空军涂装的运-20运输机照片在网络上流传,标志着涡扇-20已经技术定型,并正式装备中国空军。第三届中国航空投资峰会暨第七届中国航空创新创业大赛而最大的惊喜来自于近日发布的一段视频,显示近期在西安举办的第三届中国航空投资峰会暨第七届中国航空创新创业大赛上,中国航发北京航空材料研究院项目负责人张勇在回答专家问题时明确表示:“在技术方面,我们已经打破所有的技术瓶颈。涡扇-10、涡扇-15已经实现批数生产交付,材料已经固化;涡扇-19,涡扇-20和第五代(下一代变循环涡扇发动机)正处于选材阶段”。不排除未来歼-20也会换装第五代发动机。也是在这个中国航空创新创业大赛上,张勇总师提到了发动机生产的供应链问题,希望未来能够理顺供应链,实现发动机高质量、低成本的大规模生产。张勇总师确认涡扇15已经交付此视频一出,不但让我国军迷们欣喜,而且立即引起了国际军事媒体的关注。英国《飞行国际》也在近日专门撰文对此进行了报道。文章称这个视频说明涡扇-15正在进行“有限的”生产,目前装备涡扇-15的歼-20战斗机的照片虽然尚未公布,但是很可能正在进行测试。《飞行国际》认为,以涡扇-10“太行”发动机为例,目前这款发动机正在为中国空军几种现役型号的战斗机提供动力,如歼-10C、歼-11B、歼-15和歼-16,因此涡扇-10C的大规模生产并不令人惊讶。《飞行国际》猜测涡扇-15的最大推力为18.4吨(180千牛),而涡扇-10的最大推力约为15吨,因此涡扇-15将会给歼-20带来真正的“第五代”性能,包括超音速巡航能力。", "date": "2023-03-29T10:19:13+08:00"}, {"id": "sr_56830e", "title": "总师证实涡扇15发动机量产：歼20“完全体”下饺子，是时候安排", "source": "腾讯网", "url": "https://view.inews.qq.com/a/20230328A07EG300", "snippet": "进入今年以来,我国广大军迷们可谓是惊喜连连,中国航空发动机行业厚积薄发,终于迎来了收获的时刻。先是装备涡扇-20发动机的空军涂装的运-20运输机照片在网络上流传,标志着涡扇-20已经技术定型,并正式装备中国空军。接着中国试飞院基于运-20的新型航空发动机通用试飞平台的照片曝光,显示为C919客机配套的长江-1000民用大涵道比涡扇发动机也开始了试飞工作。\n第三届中国航空投资峰会暨第七届中国航空创新创业大赛\n而最大的惊喜来自于近日发布的一段视频,显示近期在西安举办的第三届中国航空投资峰会暨第七届中国航空创新创业大赛上,中国航发北京航空材料研究院项目负责人张勇在回答专家问题时明确表示:“在技术方面,我们已经打破所有的技术瓶颈。涡扇-10、涡扇-15已经实现批数生产交付,材料已经固化;涡扇-19,涡扇-20和第五代(下一代变循环涡扇发动机)正处于选材阶段”。在这个中国航空创新创业大赛上,张勇总师提到了发动机生产的供应链问题,希望未来能够理顺供应链,实现发动机高质量、低成本的大规模生产。\n张勇总师确认涡扇15已经交付\n此视频一出,不但让我国军迷们欣喜,而且立即引起了国际军事媒体的关注。英国《飞行国际》也在近日专门撰文对此进行了报道。文章称这个视频说明涡扇-15正在进行“有限的”生产,目前装备涡扇-15的歼-20战斗机的照片虽然尚未公布,但是很可能正在进行测试。\n《飞行国际》指出,以涡扇-10“太行”发动机为例,目前这款发动机正在为中国空军几种现役型号的战斗机提供动力,如歼-10C、歼-11B、歼-15和歼-16,因此涡扇-10C的大规模生产并不令人惊讶。《飞行国际》猜测涡扇-15的最大推力为18.4吨(180千牛),而涡扇-10的最大推力约为15吨,因此涡扇-15将会给歼-20带来真正的“第五代”性能,包括超音速巡航能力。\n歼-16战斗机上的国产涡扇10发动机\n我们无法证实这些数字", "date": "2023-03-29T02:12:00+08:00"}, {"id": "sr_1677e1", "title": "德专家高度关注,WS-15官宣已量产,WS-19与五代发动机已在选材中涡扇五代机战斗机歼-20运-20隐身战机ws-15ws-19_网易订阅", "source": "网易", "url": "https://www.163.com/dy/article/I0S7SK9L0535H9SJ.html", "snippet": "近日召开的《第三届中国航空投资峰会暨第七届中国航空创新创业大赛》中,中国航发北京航空材料研究院项目负责人张勇演讲时表示,涡扇-10、涡扇-15已经批生产交付,涡扇-19,涡扇-20以及五代发动机也已处于选材阶段,CJ-1000发动机也有好消息传出......这种表态意味着中国航空工业即将摆脱卡脖子的困境。现如今的中国早已是聚光灯之下的存在,因此中国任何技术取得突破之时,都会在国际范围内引起或大或小的反响。", "date": "2023-03-28T05:18:13+08:00"}, {"id": "sr_a8b9a5", "title": "总师证实涡扇15发动机量产：歼20“完全体”下饺子，是时候安排", "source": "腾讯网", "url": "https://new.qq.com/rain/a/20230328A07EG300", "snippet": "进入今年以来,我国广大军迷们可谓是惊喜连连,中国航空发动机行业厚积薄发,终于迎来了收获的时刻。先是装备涡扇-20发动机的空军涂装的运-20运输机照片在网络上流传,标志着涡扇-20已经技术定型,并正式装备中国空军。接着中国试飞院基于运-20的新型航空发动机通用试飞平台的照片曝光,显示为C919客机配套的长江-1000民用大涵道比涡扇发动机也开始了试飞工作。\n第三届中国航空投资峰会暨第七届中国航空创新创业大赛\n而最大的惊喜来自于近日发布的一段视频,显示近期在西安举办的第三届中国航空投资峰会暨第七届中国航空创新创业大赛上,中国航发北京航空材料研究院项目负责人张勇在回答专家问题时明确表示:“在技术方面,我们已经打破所有的技术瓶颈。涡扇-10、涡扇-15已经实现批数生产交付,材料已经固化;涡扇-19,涡扇-20和第五代(下一代变循环涡扇发动机)正处于选材阶段”。在这个中国航空创新创业大赛上,张勇总师提到了发动机生产的供应链问题,希望未来能够理顺供应链,实现发动机高质量、低成本的大规模生产。\n张勇总师确认涡扇15已经交付\n此视频一出,不但让我国军迷们欣喜,而且立即引起了国际军事媒体的关注。英国《飞行国际》也在近日专门撰文对此进行了报道。文章称这个视频说明涡扇-15正在进行“有限的”生产,目前装备涡扇-15的歼-20战斗机的照片虽然尚未公布,但是很可能正在进行测试。\n《飞行国际》指出,以涡扇-10“太行”发动机为例,目前这款发动机正在为中国空军几种现役型号的战斗机提供动力,如歼-10C、歼-11B、歼-15和歼-16,因此涡扇-10C的大规模生产并不令人惊讶。《飞行国际》猜测涡扇-15的最大推力为18.4吨(180千牛),而涡扇-10的最大推力约为15吨,因此涡扇-15将会给歼-20带来真正的“第五代”性能,包括超音速巡航能力。\n歼-16战斗机上的国产涡扇10发动机\n我们无法证实这些数字", "date": "2023-03-29T02:12:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 1}}

data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T23:03:07.740639", "content": {"graph": {"nodes": [{"id": "node_0", "name": "中国航发（AECC）", "type": "company", "discovered_at": "2026-11-10T23:03:06.195297"}, {"id": "node_1", "name": "中国航发北京航空材料研究院", "type": "company", "discovered_at": "2026-11-10T23:03:06.195305"}, {"id": "node_2", "name": "张勇", "type": "person", "discovered_at": "2026-11-10T23:03:06.195310"}, {"id": "node_3", "name": "中航工业（AVIC）", "type": "company", "discovered_at": "2026-11-10T23:03:06.195315"}, {"id": "node_4", "name": "涡扇-15（峨眉）", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195320"}, {"id": "node_5", "name": "涡扇-10C", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195329"}, {"id": "node_6", "name": "歼-20A/歼-20S", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195335"}, {"id": "node_7", "name": "涡扇-19", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195340"}, {"id": "node_8", "name": "涡扇-20", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195345"}, {"id": "node_9", "name": "Military Watch Magazine", "type": "company", "discovered_at": "2026-11-10T23:03:06.195350"}, {"id": "node_10", "name": "英国皇家联合军种研究院（RUSI）", "type": "company", "discovered_at": "2026-11-10T23:03:06.195354"}, {"id": "node_11", "name": "C919", "type": "technology", "discovered_at": "2026-11-10T23:03:06.195358"}, {"id": "node_12", "name": "涡扇-15（WS-15，峨嵋）", "type": "technology", "discovered_at": "2026-11-10T23:03:07.740449"}, {"id": "node_13", "name": "歼-20", "type": "technology", "discovered_at": "2026-11-10T23:03:07.740464"}, {"id": "node_14", "name": "AL-31系列", "type": "technology", "discovered_at": "2026-11-10T23:03:07.740472"}, {"id": "node_15", "name": "涡扇-10“太行”（含10B/10C）", "type": "technology", "discovered_at": "2026-11-10T23:03:07.740481"}, {"id": "node_16", "name": "F119", "type": "technology", "discovered_at": "2026-11-10T23:03:07.740489"}, {"id": "node_17", "name": "中国航发/606所/624所/614所", "type": "company", "discovered_at": "2026-11-10T23:03:07.740495"}, {"id": "node_18", "name": "410厂/430厂/113厂/中航黎明", "type": "company", "discovered_at": "2026-11-10T23:03:07.740501"}, {"id": "node_19", "name": "贵州黎阳航空发动机公司", "type": "company", "discovered_at": "2026-11-10T23:03:07.740508"}, {"id": "node_20", "name": "高端轴承", "type": "technology", "discovered_at": "2026-11-10T23:03:07.740514"}, {"id": "node_21", "name": "单晶涡轮叶片/热障涂层/粉末冶金", "type": "technology", "discovered_at": "2026-11-10T23:03:07.740521"}], "edges": [{"source": "中国航发（AECC）", "relation": "涡扇-15研制生产主体", "discovered_at": "2026-11-10T23:03:06.195300"}, {"source": "中国航发（AECC）", "relation": "涡扇-10/19/20研制方", "discovered_at": "2026-11-10T23:03:06.195302"}, {"source": "中国航发（AECC）", "relation": "供应链组织者", "discovered_at": "2026-11-10T23:03:06.195303"}, {"source": "中国航发北京航空材料研究院", "relation": "张勇所在单位", "discovered_at": "2026-11-10T23:03:06.195307"}, {"source": "中国航发北京航空材料研究院", "relation": "涡扇-15材料与工艺研发", "discovered_at": "2026-11-10T23:03:06.195308"}, {"source": "张勇", "relation": "中国航发北京航空材料研究院项目负责人/总师", "discovered_at": "2026-11-10T23:03:06.195312"}, {"source": "张勇", "relation": "涡扇-15量产信息发布者", "discovered_at": "2026-11-10T23:03:06.195313"}, {"source": "中航工业（AVIC）", "relation": "歼-20整机研制生产主体", "discovered_at": "2026-11-10T23:03:06.195317"}, {"source": "中航工业（AVIC）", "relation": "总装产能承担方", "discovered_at": "2026-11-10T23:03:06.195318"}, {"source": "涡扇-15（峨眉）", "relation": "歼-20目标动力", "discovered_at": "2026-11-10T23:03:06.195323"}, {"source": "涡扇-15（峨眉）", "relation": "第五代军用涡扇发动机", "discovered_at": "2026-11-10T23:03:06.195324"}, {"source": "涡扇-15（峨眉）", "relation": "支持超音速巡航与矢量推力", "discovered_at": "2026-11-10T23:03:06.195325"}, {"source": "涡扇-10C", "relation": "歼-20过渡动力型号", "discovered_at": "2026-11-10T23:03:06.195331"}, {"source": "涡扇-10C", "relation": "被涡扇-15替代", "discovered_at": "2026-11-10T23:03:06.195333"}, {"source": "歼-20A/歼-20S", "relation": "涡扇-15装机平台", "discovered_at": "2026-11-10T23:03:06.195336"}, {"source": "歼-20A/歼-20S", "relation": "双座型/改进型", "discovered_at": "2026-11-10T23:03:06.195338"}, {"source": "涡扇-19", "relation": "歼-35舰载机动力", "discovered_at": "2026-11-10T23:03:06.195341"}, {"source": "涡扇-19", "relation": "供应链优化对象", "discovered_at": "2026-11-10T23:03:06.195343"}, {"source": "涡扇-20", "relation": "运-20动力", "discovered_at": "2026-11-10T23:03:06.195347"}, {"source": "涡扇-20", "relation": "供应链优化对象", "discovered_at": "2026-11-10T23:03:06.195348"}, {"source": "Military Watch Magazine", "relation": "歼-20年产能120架说法的外媒来源", "discovered_at": "2026-11-10T23:03:06.195352"}, {"source": "英国皇家联合军种研究院（RUSI）", "relation": "被引用的防务智库来源", "discovered_at": "2026-11-10T23:03:06.195356"}, {"source": "C919", "relation": "民用航发断供风险案例", "discovered_at": "2026-11-10T23:03:06.195360"}, {"source": "C919", "relation": "航发自主可控参照", "discovered_at": "2026-11-10T23:03:06.195362"}, {"source": "涡扇-15（WS-15，峨嵋）", "relation": "歼-20的动力系统", "discovered_at": "2026-11-10T23:03:07.740453"}, {"source": "涡扇-15（WS-15，峨嵋）", "relation": "由606所/624所等研制", "discovered_at": "2026-11-10T23:03:07.740456"}, {"source": "涡扇-15（WS-15，峨嵋）", "relation": "2022年11月装机首飞", "discovered_at": "2026-11-10T23:03:07.740458"}, {"source": "涡扇-15（WS-15，峨嵋）", "relation": "已进入批量装备阶段（待核实）", "discovered_at": "2026-11-10T23:03:07.740460"}, {"source": "歼-20", "relation": "涡扇-15的装机平台", "discovered_at": "2026-11-10T23:03:07.740467"}, {"source": "歼-20", "relation": "此前使用AL-31系列与涡扇-10系列", "discovered_at": "2026-11-10T23:03:07.740469"}, {"source": "AL-31系列", "relation": "歼-20的过渡动力（俄制）", "discovered_at": "2026-11-10T23:03:07.740475"}, {"source": "AL-31系列", "relation": "被涡扇-15替代", "discovered_at": "2026-11-10T23:03:07.740478"}, {"source": "涡扇-10“太行”（含10B/10C）", "relation": "国产航发成熟化路径参照", "discovered_at": "2026-11-10T23:03:07.740483"}, {"source": "涡扇-10“太行”（含10B/10C）", "relation": "装备歼-11/歼-15/歼-16", "discovered_at": "2026-11-10T23:03:07.740486"}, {"source": "F119", "relation": "美制F-22动力，被用作对比基准", "discovered_at": "2026-11-10T23:03:07.740492"}, {"source": "中国航发/606所/624所/614所", "relation": "涡扇-15研制单位", "discovered_at": "2026-11-10T23:03:07.740498"}, {"source": "410厂/430厂/113厂/中航黎明", "relation": "涡扇-15制造与验证机交付单位", "discovered_at": "2026-11-10T23:03:07.740505"}, {"source": "贵州黎阳航空发动机公司", "relation": "被单一低可信来源称为涡扇-15生产方（存疑）", "discovered_at": "2026-11-10T23:03:07.740511"}, {"source": "高端轴承", "relation": "被指为航发寿命短板的关键基础件", "discovered_at": "2026-11-10T23:03:07.740517"}, {"source": "单晶涡轮叶片/热障涂层/粉末冶金", "relation": "决定涡扇-15寿命与批产一致性的关键工艺", "discovered_at": "2026-11-10T23:03:07.740524"}]}, "stats": {"entitiesCount": 22, "relationsCount": 40}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:03:07.740769", "content": {"agent": "DeepScout", "section": "技术趋势", "facts_count": 8, "duplicates_removed": 0, "data_points_count": 22, "insights": ["现有搜索结果全部来自汽车垂直网站、文档分享平台和自媒体，无任何官方（国防部、中国航发、航空工业）、学术或权威智库来源，参数彼此矛盾（推力150kN/16-18吨/18.5吨；寿命4000/6000小时），数据可信度整体偏低。", "关于“涡扇-15已量产/批量装备”的说法仅见于自媒体评论文章，缺乏交付数量、良率、产能等硬指标，无法直接量化其对歼-20年产能的拉动幅度。", "唯一较有价值的分析性观点是：航发产业化的真正瓶颈在于批量一致性与寿命可靠性（以涡扇-10早期教训为鉴），而非峰值推力指标——这直接指向h_1中“良率是否匹配总装线扩张”这一未验证环节。"], "source_quality": "整体来源质量很低（加权可信度约0.2-0.3）。9条结果中，6条来自汽车垂直媒体（易车、汽车之家、太平洋汽车、有驾）的百科或问答页，2条为搜狐自媒体评论文章，1条为文档分享平台的讲稿模板，1条为百度知道类问答。存在明显的同源重复（[1][2]内容完全相同，[7][8]为同一文章PC/移动端），且无任何一条引用可核查的原始出处（无官方公告、无学术论文、无券商或智库报告）。参数互相冲突（推力150kN/16-18t/18.5t，寿命4000h/6000h），部分信息明显过时（[9]称涡扇-15仍处设计阶段，且错误归属贵州黎阳）。这些材料仅可用于把握公开讨论的方向性共识（如“已进入量产”“替代AL-31”），不可用于支撑任何量化结论。建议后续优先检索中国航发与中国航空工业的官方发布、IISS《军事平衡》、SIPRI、Janes、以及中文核心期刊（如《航空动力学报》）以获取可验证数据。", "hypothesis_updates": 3, "search_results": [{"title": "涡扇15发动机推力", "url": "https://m.yiche.com/baike/29580496.htm", "source": "易车网", "snippet": "涡扇-15的最大推力达到了16-18吨。其推重比达到了10左右。该发动机使用三元矢量喷口,很大程度上增强了战斗机的机动性能。其推力的产生来源于进、排气之间的温度差,而高压涡轮是其中的关键部件。我国自主研发的第三代单晶涡轮叶片在该发动机中具有良好的综合性能,叶片最高温度可达1800摄氏度,工作寿命可达4000小时以上,大修寿命达到了6000小时以上。 \n打开易车App,进入“易车榜”,查看最新最全汽车产业数据\n标签: 涡扇15发动机推力", "date": "2024-11-22T16:08:41+08:00"}, {"title": "涡扇15发动机推力", "url": "https://www.yiche.com/baike/29580496.htm", "source": "易车", "snippet": "涡扇-15的最大推力达到了16-18吨。其推重比达到了10左右。该发动机使用三元矢量喷口,很大程度上增强了战斗机的机动性能。其推力的产生来源于进、排气之间的温度差,而高压涡轮是其中的关键部件。我国自主研发的第三代单晶涡轮叶片在该发动机中具有良好的综合性能,叶片最高温度可达1800摄氏度,工作寿命可达4000小时以上,大修寿命达到了6000小时以上。 \n打开易车App,进入“易车榜”,查看最新最全汽车产业数据\n标签: 涡扇15发动机推力", "date": "2024-11-22T16:08:41+08:00"}, {"title": "产涡扇15发动机的出现,从现有数据来看, - 有驾", "url": "https://m.yoojia.com/pages/dongtai/index?id=870764002&from_src=biji_tab", "source": "汽车之家", "snippet": " 笔记详情 是否需要切换到? 为您提供更精准的汽车经销商报价 取消 确定 琪仔饿了es 2024‐06‐24发布 产涡扇15发动机的出现,从现有数据来看,涡扇15发动机的推力高达18.5吨,寿命更是成长达6000小时,远超美F119发动机的15.5吨推力。 可以肯定的说,从推力方面,歼-20或许已经完美拿捏F22战机。 相关车系 中型SUV销量榜 No.3 瑞虎8 9.78-16.19万  2.00万 已有 48001 人询价成功 请输入手机号 已加密 查成交价 提交后会有经销商与您联系,提交视为同意 《个人信息保护声明》 全部评论 仆春垒25 1  2024-12-14 天津 全文 涡扇15肯定超过美国的f119发动机。涡扇15能达到6000小时做保养。F 119能达到多少小时做保养。  回复 回复评论  1  957  查报价单  手机号 已加密 查报价单 提交后会有经销商与您联系,提交视为同意 《个人信息保护声明》 最低成交价 此价格仅供参考,实际价格以经销商报价为准 确认 百度保障先行赔付", "date": "2024-10-15T03:12:10+08:00"}, {"title": "涡扇15发动机参数", "url": "https://m.pcauto.com.cn/baike/513428/995309/", "source": "太平洋汽车", "snippet": "作为我国自研自产的第四代涡扇发动机,涡扇15发动机的参数已经达到了F119发动机的同等水平。涡扇15发动机是一种高效的涡轮风扇发动机,最大推力可达150 kN,空气进口直径为1.5米,长度为4.9米,重量约5吨,压缩比超过了30:1,燃油消耗率为每小时6000升,安装位置适用于各种民用和军用大型喷气式飞机。涡扇15发动机采用了新一代的单晶空心叶片,其涡轮前温度达到了1900K左右,推重比超过10,是一款典型的第四代小涵道比大推力涡轮风扇发动机。它采用了涡轮风扇技术,具有较高的推力、燃油效率和可靠性。\n涡扇15发动机研发 成功 的意义:\n我国涡扇15的研发成功,意义无比巨大,标志着我国经过半个 世纪 的追赶,在涡扇发动机领域追上了世界先进水平。不过研发人员们仍然要看到不足,那就是我国在航空发动机的性能和总体寿命上还有很大的差距。\n其实我国在材料领域已经赶上来了,目前最落后的地方是轴承。国际航空发动机用了高端轴承,其生产质量比我国的好,这也是航空发动机寿命短的直接原因。认清事实,埋头发展,不妄自菲薄也不狂妄自大。相信未来一定可以在航发领域再次取得突破。", "date": "2023-11-25T23:01:10+08:00"}, {"title": "涡扇15发动机什么水平-汽车之家", "url": "https://www.autohome.com.cn/ask/6682897.html", "source": "汽车之家", "snippet": "涡扇-15发动机是中国自主研发的新型大推力军用发动机,其性能达到了世界先进水平。 该发动机采用了先进的气动设计、材料技术和制造工艺,具有较高的燃油效率、可靠性和安全性。涡扇-15发动机的性能特点包括:1. 大推力:涡扇-15发动机的最大推力超过18吨,能够满足我国新一代战斗机的需求。2. 高燃油效率:通过采用先进的燃烧室和涡轮设计,涡扇-15发动机的燃油消耗率较低,有助于降低飞行成本。3. 可靠性高:涡扇-15发动机采用了成熟的技术和严格的质量控制,确保了其在各种环境条件下的稳定性和可靠性。4. 安全性好:涡扇-15发动机在设计和制造过程中充分考虑了安全性因素,能够确保飞行员和地面人员的安全。总的来说,涡扇-15发动机是我国航空发动机技术的重要突破,其性能已经达到了世界先进水平。", "date": "2025-01-09T15:26:34+08:00"}, {"title": "涡轮发动机_讲稿模板.pptx-原创力文档", "url": "https://max.book118.com/html/2024/0426/8055023071006062.shtm", "source": "原创力文档", "snippet": "涡轮15发动机涡轮15发展历史WS-15全称涡扇15峨眉涡扇发动机。由606所、624所、614所、410厂、430厂和113厂等单位专家组织研制,在2006年5月首次台架运转试车成功。系统介绍这标志着我国在自主研制航空发动机的道路上又实现了历史性跨越,在研制我国第四代战斗机的征程上迈出了坚实的一步。2011年中航黎明完成了ws-15验证机的交付 涡轮15发动机从中国燃气涡轮研究院(624所)工作会上获悉,我国自行研制的推重比为9的涡轮风扇航空发动机的核心机CJ2000于2005年4月14日首次点火成功后,推重比为9的涡轮风扇航空发动机的核心机已于2005年7月上旬在台架运转试车时,各种性能完全达到了设计指标,转速推到地面最高转 涡轮15发动机涡轮15类型、装配机型涡扇15是航空用涡轮风扇发动机,是喷气机的一种涡扇发动机,是为我国第五代战斗机而研制的小涵道比推力矢量涡扇发动机。小涵道比推力矢量涡扇发动机听着好拗口,但其实主要用于双发隐身战斗机歼-20 涡轮15发动机涡轮进口温度:1850K最大直径:1.02m长度:5.05m质量:1633.7kg涡轮15发动机现在装配于歼20,于2022年11月完成首飞涡轮15服役时间、典型参数推重比:9.7-10.87空气流量:138kg/s涵道比:0.25总增压比:30.5标题标题标题 涡轮15发动机涡轮15发动机对于时代的先进性该发动机采用了先进的双轴涡扇技术,使得其具有更高的燃烧效率和更低的热损失。", "date": "2024-04-28T20:25:54+08:00"}, {"title": "涡扇‐15 量产之后,客观看待中国航发与美俄的真实差距_发动机_寿命_系列", "url": "https://www.sohu.com/a/1076940871_100056250?scm=10001.8085_13-8085_13.0.0-0-0-0-0.0", "source": "搜狐", "snippet": "涡扇-15真正值得看的,不只是16.5吨到18.5吨的加力推力,也不是推重比超过10.5,而是中国终于把先进大推力发动机推进到批量装备这一步。\n过去歼-20使用俄制AL-31系列发动机,战斗力当然能形成,但多少有点“好马配旧鞋”的味道,如今涡扇-15进入量产,歼-20在超音速巡航、持续机动和航程控制这些方面,才更有条件把先进机体的潜力充分发挥出来。\n据了解,涡扇-15设计寿命约4000小时,这个数字其实比单纯追求大推力更值得琢磨,航发最怕的,不是试车台跑不出漂亮成绩,而是批量生产以后质量忽高忽低。发动机长期处在高温、高压、高转速环境中,压气机、燃烧室、涡轮叶片、冷却系统和控制系统,哪一环掉链子,整架战机都得跟着歇菜。\n然而,中国在这方面吃过苦头,早期涡扇-10“太行”真正麻烦的地方,不完全是纸面性能,而是寿命、可靠性和批量一致性。维修周期长,地勤压力就大,战机出动率也会受影响,参数写得再漂亮,三天两头进机库,那多少有点“锣鼓敲得响,车还没开出门”。\n这些年太行系列一路改进,涡扇-10B、涡扇-10C以及舰载型号逐步成熟,歼-11、歼-15、歼-16也越来越多使用国产动力,背后真正磨出来的,是高温合金、单晶叶片、粉末冶金、精密铸造、热障涂层和数控加工这些“不上镜”的硬功夫。\n所以放到中俄之间看,中国的位置已经明显变了,俄罗斯AL-31系列技术成熟,底子很厚,部分型号在寿命、维护效率和生产保障方面存在压力。中国靠太行系列持续改进,再接上涡扇-15,在新一代战机动力、规模制造和综合保障上,已经表现出明显进步。\n可如果因此就喊“全面超过美国”,那多少有点高兴得太早,美国真正难缠的地方,不只是F119、F135这两款发动机,而是它们背后有完整的设计、试验、制造和维护体系,与此同时,美国还在自适应变循环发动机、三涵道结构、陶瓷基复合材料这些方向持续验证。\n这些技术没有全部大规模装备,", "date": "2026-09-19T01:06:00+08:00"}, {"title": "涡扇‐15 量产之后,客观看待中国航发与美俄的真实差距_发动机_寿命_系列", "url": "https://m.sohu.com/a/1076940871_100056250?scm=10001.849_13-101000-0_8000.0-0.0-0-0-0-0.0_6155", "source": "手机搜狐网", "snippet": "涡扇-15真正值得看的,不只是16.5吨到18.5吨的加力推力,也不是推重比超过10.5,而是中国终于把先进大推力发动机推进到批量装备这一步。\n过去歼-20使用俄制AL-31系列发动机,战斗力当然能形成,但多少有点“好马配旧鞋”的味道,如今涡扇-15进入量产,歼-20在超音速巡航、持续机动和航程控制这些方面,才更有条件把先进机体的潜力充分发挥出来。\n据了解,涡扇-15设计寿命约4000小时,这个数字其实比单纯追求大推力更值得琢磨,航发最怕的,不是试车台跑不出漂亮成绩,而是批量生产以后质量忽高忽低。发动机长期处在高温、高压、高转速环境中,压气机、燃烧室、涡轮叶片、冷却系统和控制系统,哪一环掉链子,整架战机都得跟着歇菜。\n然而,中国在这方面吃过苦头,早期涡扇-10“太行”真正麻烦的地方,不完全是纸面性能,而是寿命、可靠性和批量一致性。维修周期长,地勤压力就大,战机出动率也会受影响,参数写得再漂亮,三天两头进机库,那多少有点“锣鼓敲得响,车还没开出门”。\n这些年太行系列一路改进,涡扇-10B、涡扇-10C以及舰载型号逐步成熟,歼-11、歼-15、歼-16也越来越多使用国产动力,背后真正磨出来的,是高温合金、单晶叶片、粉末冶金、精密铸造、热障涂层和数控加工这些“不上镜”的硬功夫。\n所以放到中俄之间看,中国的位置已经明显变了,俄罗斯AL-31系列技术成熟,底子很厚,部分型号在寿命、维护效率和生产保障方面存在压力。中国靠太行系列持续改进,再接上涡扇-15,在新一代战机动力、规模制造和综合保障上,已经表现出明显进步。\n可如果因此就喊“全面超过美国”,那多少有点高兴得太早,美国真正难缠的地方,不只是F119、F135这两款发动机,而是它们背后有完整的设计、试验、制造和维护体系,与此同时,美国还在自适应变循环发动机、三涵道结构、陶瓷基复合材料这些方向持续验证。\n这些技术没有全部大规模装备,", "date": "2026-09-19T01:06:00+08:00"}, {"title": "涡扇15推力多少 - 业百科", "url": "https://www.yebaike.com/22/1470372.html", "source": "百度知道", "snippet": "1、涡扇15推力达到了18吨级。 2、涡扇-15,简称WS-15,它是一款中国贵州黎阳航空发动机公司设计生产的涡轮风扇航空发动机,代号“峨嵋”。目前处于设计阶段,预计将会装备在中国人民解放军空军的第五代战斗机J-20,以及三代半战斗机J-10B上。 3、涡扇15发动机目前研发进展到了台架测试阶段。虽然很多军事专家都认为歼20战斗机即便是没有涡扇15战斗机也能具备很强大的作战能力和先进的超级机动能力,但是经过这次歼10B战斗机的超机动展示后,人们都越发觉得,如果歼20战斗机也能配备这样一台发动机,那么战斗力还将会跃升一个台阶。", "date": "2020-10-28T07:09:58+08:00"}], "extracted_facts": [{"content": "涡扇-15最大推力为16-18吨，推重比约10，采用三元矢量喷口；高压涡轮使用国产第三代单晶涡轮叶片，叶片最高工作温度可达1800摄氏度，工作寿命4000小时以上，大修寿命6000小时以上。", "source_name": "易车网（百科词条）", "source_url": "https://m.yiche.com/baike/29580496.htm", "credibility": 0.25}, {"content": "涡扇-15推力高达18.5吨、寿命达6000小时，超过美制F119发动机的15.5吨推力。", "source_name": "有驾（汽车之家系，用户笔记）", "source_url": "https://m.yoojia.com/pages/dongtai/index?id=870764002&from_src=biji_tab", "credibility": 0.2}, {"content": "涡扇-15为第四代小涵道比大推力涡扇发动机，最大推力150kN（约15.3吨），空气进口直径1.5米、长度4.9米、重量约5吨，总增压比超过30:1，涡轮前温度约1900K，推重比超过10；文章同时指出中国在航空发动机总体寿命上仍有差距，最落后环节是高端轴承。", "source_name": "太平洋汽车（百科）", "source_url": "https://m.pcauto.com.cn/baike/513428/995309/", "credibility": 0.25}, {"content": "涡扇-15由606所、624所、614所、410厂、430厂、113厂等单位联合研制，2006年5月首次台架试车成功，2011年中航黎明完成验证机交付；涡轮进口温度1850K、最大直径1.02m、长度5.05m、质量1633.7kg、推重比9.7-10.87、空气流量138kg/s、涵道比0.25、总增压比30.5，2022年11月装配歼-20完成首飞。", "source_name": "原创力文档（讲稿模板）", "source_url": "https://max.book118.com/html/2024/0426/8055023071006062.shtm", "credibility": 0.2}, {"content": "涡扇-15已进入批量装备阶段，加力推力16.5-18.5吨、推重比超过10.5、设计寿命约4000小时；此前歼-20使用俄制AL-31系列发动机，涡扇-15量产后歼-20在超音速巡航、持续机动和航程控制方面才具备充分发挥机体潜力的条件。", "source_name": "搜狐（自媒体号）", "source_url": "", "credibility": 0.3}, {"content": "文章指出航空发动机真正的难点在于批量生产后的质量一致性（良率），而非试车台性能；早期涡扇-10“太行”的主要问题不是纸面性能，而是寿命、可靠性和批量一致性，导致维修周期长、地勤压力大、战机出动率受影响；其背后依赖高温合金、单晶叶片、粉末冶金、精密铸造、热障涂层和数控加工等基础工艺能力。", "source_name": "搜狐（自媒体号）", "source_url": "", "credibility": 0.3}, {"content": "涡扇-15推力达18吨级，代号“峨嵋”，文中称由贵州黎阳航空发动机公司设计生产，当时处于设计/台架测试阶段，预计装备歼-20与歼-10B。", "source_name": "业百科（百度知道）", "source_url": "https://www.yebaike.com/22/1470372.html", "credibility": 0.15}, {"content": "涡扇-15采用先进气动设计、材料技术和制造工艺，具有大推力（超过18吨）、高燃油效率、高可靠性和良好安全性，性能达到世界先进水平。", "source_name": "汽车之家（问答）", "source_url": "https://www.autohome.com.cn/ask/6682897.html", "credibility": 0.2}], "data_points": [{"name": "最大推力", "value": "16-18", "unit": "吨", "year": 2024, "source": "易车网（百科词条）"}, {"name": "推重比", "value": "10", "unit": "无量纲", "year": 2024, "source": "易车网（百科词条）"}, {"name": "涡轮叶片工作温度", "value": "1800", "unit": "摄氏度", "year": 2024, "source": "易车网（百科词条）"}, {"name": "工作寿命", "value": "4000", "unit": "小时", "year": 2024, "source": "易车网（百科词条）"}, {"name": "大修寿命", "value": "6000", "unit": "小时", "year": 2024, "source": "易车网（百科词条）"}, {"name": "涡扇-15推力", "value": "18.5", "unit": "吨", "year": 2024, "source": "有驾（汽车之家系，用户笔记）"}, {"name": "涡扇-15寿命", "value": "6000", "unit": "小时", "year": 2024, "source": "有驾（汽车之家系，用户笔记）"}, {"name": "F119推力", "value": "15.5", "unit": "吨", "year": 2024, "source": "有驾（汽车之家系，用户笔记）"}, {"name": "最大推力", "value": "150", "unit": "kN", "year": 2023, "source": "太平洋汽车（百科）"}, {"name": "发动机重量", "value": "5", "unit": "吨", "year": 2023, "source": "太平洋汽车（百科）"}]}}

