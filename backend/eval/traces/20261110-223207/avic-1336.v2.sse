data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:15:52.385016", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2019, 2037], 'Market': [2.8, 5.9], 'Fleet': [30000, 48000]}\ndf = pd.DataFrame(data)\nfig, ax1 = plt.subplots(figsize=(12, 7), dpi=200)\ncolor1 = '#6366f1'\nax1.plot(df['Year'], df['Market'], color=color1, linewidth=2.5, marker='o', markersize=8, label='全球航空航天市场规模（万亿美元）')\nax1.fill_between(df['Year'], df['Market'], alpha=0.15, color=color1)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('全球航空航天市场规模（万亿美元）', fontsize=14, color=color1)\nax1.set_xticks([2019, 2037])\nax1.tick_params(axis='x', labelsize=12)\nax1.tick_params(axis='y', labelcolor=color1, labelsize=12)\nfor x, y in zip(df['Year'], df['Market']):\n    ax1.text(x, y + 0.15, str(y) + '万亿美元', ha='center', fontsize=11, color=color1, fontweight='bold')\nax2 = ax1.twinx()\ncolor2 = '#f59e0b'\nax2.plot(df['Year'], df['Fleet'], color=color2, linewidth=2.5, marker='s', markersize=8, label='全球民航客机机队规模（架）')\nax2.fill_between(df['Year'], df['Fleet'], alpha=0.15, color=color2)\nax2.set_ylabel('全球民航客机机队规模（架）', fontsize=14, color=color2)\nax2.tick_params(axis='y', labelcolor=color2, labelsize=12)\nfor x, y in zip(df['Year'], df['Fleet']):\n    ax2.text(x, y + 1500, str(y) + '架', ha='center', fontsize=11, color=color2, fontweight='bold')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=11, frameon=True)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

