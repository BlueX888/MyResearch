data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:15:41.012536", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2020, 2023], 'Revenue': [422.4, 749.7], 'Profit': [14.3, 24.2]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nbars = ax1.bar(df['Year'].astype(str), df['Revenue'], color='#6366f1', width=0.5, label='营业收入')\nfor b, v in zip(bars, df['Revenue']):\n    ax1.text(b.get_x() + b.get_width() / 2, v + 15, f'{v:.0f}', ha='center', fontsize=12, fontweight='bold', color='#6366f1')\nax1.set_title('成飞营业收入与归母净利润（主机厂增长动能）', fontsize=16, fontweight='bold', pad=15)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('营业收入（亿元）', fontsize=14)\nax1.tick_params(labelsize=12)\nax2 = ax1.twinx()\nax2.plot(df['Year'].astype(str), df['Profit'], color='#10b981', linewidth=2.5, marker='o', markersize=8, label='归母净利润')\nax2.set_ylabel('归母净利润（亿元）', fontsize=14, color='#10b981')\nax2.tick_params(labelsize=12, colors='#10b981')\nax2.grid(False)\nseg = {'环节': ['机体部件', '航空发动机', '其他系统'], 'Value': [2.0, 1.25, 1.75]}\nd2 = pd.DataFrame(seg)\nd2['Value'] = pd.to_numeric(d2['Value'], errors='coerce')\nd2 = d2.dropna()\nbars2 = axes[1].barh(d2['环节'], d2['Value'], color=['#06b6d4', '#f59e0b', '#94a3b8'])\nfor b, v in zip(bars2, d2['Value']):\n    axes[1].text(v + 0.05, b.get_y() + b.get_height() / 2, f'{v}万亿', va='center', fontsize=12, fontweight='bold')\naxes[1].set_title('2036年大飞机产业链市场空间（合计5万亿元）', fontsize=16, fontweight='bold', pad=15)\naxes[1].set_xlabel('市场规模（万亿元）', fontsize=14)\naxes[1].tick_params(labelsize=12)\naxes[1].invert_yaxis()\nplt.tight_layout()\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "围绕“1336发展战略”对主机厂的要求，选取最具代表性的数据点构建两组对比：①成飞2020→2023年营业收入与归母净利润（体现主机厂规模扩张与盈利质量，营收CAGR约21%、净利CAGR约19%）；②2036年大飞机5万亿市场空间的产业链价值分布（机体部件2万亿、航空发动机1.25万亿、其他系统1.75万亿），对应1336战略中主机厂需牵引的机体集成与供应链协同责任。数据经列字典定义、数值类型转换与缺失值剔除后，绘制左柱线双轴（营收+净利）与右横向条形（产业链价值）的组合图，突出“主机厂增长动能”与“产业链价值承接”两条主线。"}}

