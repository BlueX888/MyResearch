data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:16:28.768765", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nyears = [2019, 2037]\nmarket = [2.8, 5.9]\nfleet = [3.0, 4.8]\nfig, ax1 = plt.subplots(figsize=(12, 7), dpi=200)\nax2 = ax1.twinx()\nline1 = ax1.plot(years, market, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='全球航空航天市场规模（万亿美元）')\nax1.fill_between(years, market, alpha=0.15, color='#6366f1')\nline2 = ax2.plot(years, fleet, color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='全球民航客机机队规模（万架）')\nax2.fill_between(years, fleet, alpha=0.15, color='#f59e0b')\nfor x, y in zip(years, market):\n    ax1.text(x, y + 0.15, f'{y}万亿美元', ha='center', fontsize=11, color='#6366f1', fontweight='bold')\nfor x, y in zip(years, fleet):\n    ax2.text(x, y + 0.15, f'{y}万架', ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nax1.set_title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('市场规模（万亿美元）', fontsize=14, color='#6366f1')\nax2.set_ylabel('机队规模（万架）', fontsize=14, color='#f59e0b')\nax1.tick_params(axis='x', labelsize=12)\nax1.tick_params(axis='y', labelsize=12, colors='#6366f1')\nax2.tick_params(axis='y', labelsize=12, colors='#f59e0b')\nax1.set_xticks(years)\nax1.set_ylim(0, 7)\nax2.set_ylim(0, 6)\nax1.grid(True, linestyle='--', alpha=0.3)\nax2.grid(False)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=11, frameon=True)\nax1.text(0.98, 0.02, '成飞十四五预计总营收3398.49亿元 | 较十三五增长151.22% | C919在手订单1000架', transform=ax1.transAxes, fontsize=11, va='bottom', ha='right', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8, edgecolor='#e5e7eb'))\nsns.despine(ax=ax1, top=True, right=True)\nsns.despine(ax=ax2, top=True, left=True, right=False)\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

