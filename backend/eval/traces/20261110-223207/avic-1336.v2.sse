data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T21:06:12.723208", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "梳理军用航空装备、民用航空与航空维修市场的规模、增速及结构，分析“1336”战略下主机厂面临的需求变化与批产/研制任务。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["航空工业 1336 发展战略 主机厂 市场需求 规模 增速"]}, {"id": "sec_2", "title": "竞争格局", "description": "分析国内外航空主机厂及系统集成商的竞争格局，识别“1336”战略对主机厂在产业链链长、供应链协同和系统集成方面的定位要求。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["航空工业 主机厂 竞争格局 供应链 系统集成 1336"]}, {"id": "sec_3", "title": "技术趋势", "description": "梳理数字化设计制造、智能装配、机载系统与全寿命周期服务等技术趋势，分析“1336”战略对主机厂核心能力建设的要求。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业 1336 数字化 智能制造 系统集成 技术趋势"]}, {"id": "sec_4", "title": "政策环境", "description": "梳理国企改革、军民融合、航空强国、科技创新等政策，分析政策对“1336”战略内涵及主机厂考核、投资和资源配置的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业 1336 发展战略 政策 国企改革 军民融合"]}, {"id": "sec_5", "title": "挑战机遇", "description": "识别主机厂在战略落地中面临的批产能力、供应链安全、成本控制、人才与机制等挑战，以及国产化替代、服务化转型和国际化机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业 主机厂 挑战 机遇 供应链 批产 服务化"]}, {"id": "sec_6", "title": "未来展望", "description": "展望“1336”战略下主机厂向世界一流航空企业迈进的发展路径，分析能力建设、组织变革和产业协同趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业 1336 世界一流 主机厂 发展路径"]}], "research_questions": ["“1336”发展战略的准确内涵和构成是什么？", "该战略对主机厂在能力、机制和考核上有哪些具体要求？", "主机厂落实战略的关键路径、挑战与可验证指标是什么？"]}}

