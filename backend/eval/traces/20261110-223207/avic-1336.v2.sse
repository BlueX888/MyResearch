data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:14:22.258133", "content": {"results": [{"id": "fact_5fa2f223", "title": "刷刷题题库判断题称“航空工业集团战略是‘一心、两融、三力、五化’”，参考答案为正确。", "source": "刷刷题", "url": "", "snippet": "刷刷题题库判断题称“航空工业集团战略是‘一心、两融、三力、五化’”，参考答案为正确。", "date": "", "isSupplementary": false}, {"id": "fact_4a749bfc", "title": "搜狐文章在“航空工业集团文化知多少（二）”中列出航电战略行动项目的“六力”：技术创新力、生产制造力、架构与流程能力、运营管控能力、专业研发能力、人力保障能力；并...", "source": "搜狐", "url": "", "snippet": "搜狐文章在“航空工业集团文化知多少（二）”中列出航电战略行动项目的“六力”：技术创新力、生产制造力、架构与流程能力、运营管控能力、专业研发能力、人力保障能力；并提到五大经营发展理念、四重、四新。", "date": "", "isSupplementary": false}, {"id": "fact_e41f1a76", "title": "本次检索结果未出现航空工业集团“1336”战略（一个目标、三个定位、六大能力）的官方原文；出现的近似或易混淆表述包括中国航材“13648”、航空工业“一心、两融...", "source": "综合搜索结果", "url": "", "snippet": "本次检索结果未出现航空工业集团“1336”战略（一个目标、三个定位、六大能力）的官方原文；出现的近似或易混淆表述包括中国航材“13648”、航空工业“一心、两融、三力、五化”、中国航发商发“一个目标…六大核心能力”以及兵器体系“11363”。", "date": "", "isSupplementary": false}, {"id": "fact_1249d173", "title": "官网“发展战略”页面列出“五化”：坚持“集约化经营、精准化管理、市场化改革、体系化发展、国际化共赢”的发展路径和原则；该摘要未展开“1336”发展战略的具体内涵...", "source": "中国航空工业集团有限公司官网-发展战略", "url": "https://m.avic.com/sycd/gywm/jtgk/jtjj/", "snippet": "官网“发展战略”页面列出“五化”：坚持“集约化经营、精准化管理、市场化改革、体系化发展、国际化共赢”的发展路径和原则；该摘要未展开“1336”发展战略的具体内涵。", "date": "", "isSupplementary": false}, {"id": "fact_f25f236d", "title": "中国航空工业集团有限公司是由中央管理的国有特大型企业，是国家授权的投资机构，于2008年11月6日由原中国航空工业第一、第二集团公司重组整合而成立。", "source": "中国航空工业集团有限公司官网-集团简介", "url": "https://m.avic.com/sycd/gywm/jtgk/jtjj/", "snippet": "中国航空工业集团有限公司是由中央管理的国有特大型企业，是国家授权的投资机构，于2008年11月6日由原中国航空工业第一、第二集团公司重组整合而成立。", "date": "", "isSupplementary": false}, {"id": "fact_e7708fe7", "title": "集团简介页面称集团下辖100余家成员单位，员工约40万人。", "source": "中国航空工业集团有限公司官网-集团简介", "url": "https://m.avic.com/sycd/gywm/jtgk/jtjj/", "snippet": "集团简介页面称集团下辖100余家成员单位，员工约40万人。", "date": "", "isSupplementary": false}, {"id": "fact_45cca4ab", "title": "集团公告页面称中国航空工业集团公司下辖500家子公司、26家上市公司，员工约50万人，是首家进入500强的中国军工企业。", "source": "中国航空工业集团有限公司官网-集团公告", "url": "", "snippet": "集团公告页面称中国航空工业集团公司下辖500家子公司、26家上市公司，员工约50万人，是首家进入500强的中国军工企业。", "date": "", "isSupplementary": false}, {"id": "fact_0077da6a", "title": "人才招聘页面称航空工业共有员工45.8万人，平均年龄36.2岁；其中35岁及以下22.8万人，占在岗职工的53.3%；36至45岁10.5万人，占24.5%。", "source": "中国航空工业集团有限公司官网-人才招聘", "url": "", "snippet": "人才招聘页面称航空工业共有员工45.8万人，平均年龄36.2岁；其中35岁及以下22.8万人，占在岗职工的53.3%；36至45岁10.5万人，占24.5%。", "date": "", "isSupplementary": false}, {"id": "fact_49858e05", "title": "人才结构页面称46至55岁8.2万人，占19.2%；56岁以上1.3万人，占3.1%；经营管理人员7.7万人，占17.9%；专业技术人员12.2万人，占28.3...", "source": "中国航空工业集团有限公司官网-人才结构", "url": "", "snippet": "人才结构页面称46至55岁8.2万人，占19.2%；56岁以上1.3万人，占3.1%；经营管理人员7.7万人，占17.9%；专业技术人员12.2万人，占28.3%；工勤技能人员23.1万人，占53.8%。", "date": "", "isSupplementary": false}, {"id": "fact_2a4ee8cf", "title": "人才战略页面称航空工业坚持人才是第一资源的理念，大力实施“人才强企”战略，目标是培养造就数量充足、结构合理、素质精良、能力突出的人才队伍，支撑集团公司改革发展。", "source": "中国航空工业集团有限公司官网-人才战略", "url": "", "snippet": "人才战略页面称航空工业坚持人才是第一资源的理念，大力实施“人才强企”战略，目标是培养造就数量充足、结构合理、素质精良、能力突出的人才队伍，支撑集团公司改革发展。", "date": "", "isSupplementary": false}, {"id": "fact_4878cc53", "title": "人才招聘页面称航空工业围绕建设新时代航空强国的使命战略，坚持面向全体员工、面向核心骨干、面向重点群体，完善选人用人机制、完善考核评价机制。", "source": "中国航空工业集团有限公司官网-人才招聘", "url": "", "snippet": "人才招聘页面称航空工业围绕建设新时代航空强国的使命战略，坚持面向全体员工、面向核心骨干、面向重点群体，完善选人用人机制、完善考核评价机制。", "date": "", "isSupplementary": false}, {"id": "fact_35e726c0", "title": "集团简介页面列出企业使命为“建设航空强国，做国家安全守护者、高质量发展引领者、可持续发展价值创造者”；企业宗旨为“服务国家战略、服务国防建设、服务社会民生”；管...", "source": "中国航空工业集团有限公司官网-集团简介", "url": "https://m.avic.com/sycd/gywm/jtgk/jtjj/", "snippet": "集团简介页面列出企业使命为“建设航空强国，做国家安全守护者、高质量发展引领者、可持续发展价值创造者”；企业宗旨为“服务国家战略、服务国防建设、服务社会民生”；管理理念为“平台共享、集团产品、法人经营、一体管控”；行动准则为“赤心向党、为国担当、强基固本、守正创新、开放协同、对标一流”。", "date": "", "isSupplementary": false}, {"id": "fact_a6befb1c", "title": "集团简介页面称集团设有航空武器装备、军用运输类飞机、直升机、机载系统、通用航空、航空研究、飞行试验、航空供应链与军贸、专用装备、汽车零部件、资产管理、金融、工程...", "source": "中国航空工业集团有限公司官网-集团简介", "url": "https://m.avic.com/sycd/gywm/jtgk/jtjj/", "snippet": "集团简介页面称集团设有航空武器装备、军用运输类飞机、直升机、机载系统、通用航空、航空研究、飞行试验、航空供应链与军贸、专用装备、汽车零部件、资产管理、金融、工程建设等产业。", "date": "", "isSupplementary": false}, {"id": "fact_69d0f7e1", "title": "集团简介页面称企业愿景为“为客户提供世界一流的航空高科技产品和服务”。", "source": "中国航空工业集团有限公司官网-集团简介", "url": "https://m.avic.com/sycd/gywm/jtgk/jtjj/", "snippet": "集团简介页面称企业愿景为“为客户提供世界一流的航空高科技产品和服务”。", "date": "", "isSupplementary": false}, {"id": "fact_0f02cd35", "title": "在本次site:avic.com检索结果中，未出现“1336”字样或对“1336发展战略”内涵的直接解释；官网发展战略摘要仅显示“五化”。", "source": "本次搜索结果汇总（avic.com）", "url": "", "snippet": "在本次site:avic.com检索结果中，未出现“1336”字样或对“1336发展战略”内涵的直接解释；官网发展战略摘要仅显示“五化”。", "date": "", "isSupplementary": false}, {"id": "fact_417c563c", "title": "中国航空器材集团有限公司在“十四五”期间确立“13648”总体发展战略：以打造全球一流民航服务提供商为战略目标，围绕“三个重要角色”定位，通过平台化、数字化、国...", "source": "中国航空器材集团有限公司官网", "url": "", "snippet": "中国航空器材集团有限公司在“十四五”期间确立“13648”总体发展战略：以打造全球一流民航服务提供商为战略目标，围绕“三个重要角色”定位，通过平台化、数字化、国产化、国际化、市场化、资产证券化“六化”路径，落实四项重点任务，并全面加强八大保障措施。该主体为中国航空器材集团，并非中国航空工业集团。", "date": "", "isSupplementary": false}, {"id": "fact_dacce43a", "title": "沈飞民机公司发展目标为“成为世界一流飞机机体结构制造商”。", "source": "中航沈飞民用飞机有限责任公司官网", "url": "https://www.sacc.com.cn/sycd/gywm/fzzl/", "snippet": "沈飞民机公司发展目标为“成为世界一流飞机机体结构制造商”。", "date": "", "isSupplementary": false}, {"id": "fact_a06ba1f3", "title": "搜狐文章列出航电战略行动项目中的“五大经营发展理念、四重、四新、六力”，其中“六力”为技术创新力、生产制造力、架构与流程能力、运营管控能力、专业研发能力、人力保...", "source": "搜狐", "url": "https://www.sohu.com/a/148120429_738846", "snippet": "搜狐文章列出航电战略行动项目中的“五大经营发展理念、四重、四新、六力”，其中“六力”为技术创新力、生产制造力、架构与流程能力、运营管控能力、专业研发能力、人力保障能力；文章称包含“航空工业集团公司战略”详细解读，但未给出“1336”表述。", "date": "", "isSupplementary": false}, {"id": "fact_3d444763", "title": "中国航空工业集团是由中央管理的国有特大型企业，经营范围涵盖航空武器装备、军用运输类飞机、直升机、机载系统、通用航空、航空研究、飞行试验、航空供应链与军贸、专用装...", "source": "中国航空工业集团通用航空官网", "url": "https://www.avicgeneral.com/gywm/gsgk/gsjj/index.shtml", "snippet": "中国航空工业集团是由中央管理的国有特大型企业，经营范围涵盖航空武器装备、军用运输类飞机、直升机、机载系统、通用航空、航空研究、飞行试验、航空供应链与军贸、专用装备、汽车零部件、资产管理、金融、工程建设等产业；下辖100余家成员单位、25家上市公司，员工逾40万人。", "date": "", "isSupplementary": false}, {"id": "fact_e1ebf6e5", "title": "道客巴巴2012年文档称中航工业下辖近200家子公司/分公司、20多家上市公司、员工约40万人，并在2009年《财富》世界500强排名第426位。该信息较旧且来...", "source": "道客巴巴", "url": "", "snippet": "道客巴巴2012年文档称中航工业下辖近200家子公司/分公司、20多家上市公司、员工约40万人，并在2009年《财富》世界500强排名第426位。该信息较旧且来源为文档分享平台。", "date": "", "isSupplementary": false}]}}

