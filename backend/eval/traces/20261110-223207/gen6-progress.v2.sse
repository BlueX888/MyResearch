data: {"type": "knowledge_graph", "agent": "DataAnalyst", "timestamp": "2026-11-10T22:39:05.137606", "content": {"graph": {"nodes": [{"id": "china_6gen", "name": "中国六代机预研", "type": "core", "importance": 10, "size": 50}, {"id": "chengfei_6gen", "name": "成飞六代机", "type": "product", "importance": 9, "size": 47}, {"id": "shenfei_6gen", "name": "沈飞六代机", "type": "product", "importance": 9, "size": 47}, {"id": "adaptive_engine", "name": "自适应变循环发动机", "type": "tech", "importance": 9, "size": 47}, {"id": "chengfei", "name": "成飞", "type": "company", "importance": 8, "size": 44}, {"id": "shenfei", "name": "沈飞", "type": "company", "importance": 8, "size": 44}, {"id": "ws15", "name": "涡扇-15", "type": "product", "importance": 7, "size": 41}, {"id": "j20", "name": "歼-20", "type": "product", "importance": 7, "size": 41}, {"id": "made_in_china_2025", "name": "中国制造2025", "type": "policy", "importance": 7, "size": 41}, {"id": "defense_spending", "name": "国防支出增长", "type": "policy", "importance": 7, "size": 41}, {"id": "air_force_modernization", "name": "空军现代化", "type": "policy", "importance": 7, "size": 41}, {"id": "detonation_engine", "name": "爆震发动机", "type": "tech", "importance": 6, "size": 38}, {"id": "avic_shenfei", "name": "中航沈飞", "type": "company", "importance": 6, "size": 38}, {"id": "aec", "name": "航发动力", "type": "company", "importance": 6, "size": 38}, {"id": "avic_electronic", "name": "中航电测", "type": "company", "importance": 5, "size": 35}], "edges": [{"source": "chengfei", "target": "chengfei_6gen", "relation": "研制"}, {"source": "shenfei", "target": "shenfei_6gen", "relation": "研制"}, {"source": "chengfei_6gen", "target": "china_6gen", "relation": "属于"}, {"source": "shenfei_6gen", "target": "china_6gen", "relation": "属于"}, {"source": "chengfei_6gen", "target": "adaptive_engine", "relation": "拟装备"}, {"source": "chengfei_6gen", "target": "adaptive_engine", "relation": "未证实"}, {"source": "shenfei_6gen", "target": "detonation_engine", "relation": "推测搭载"}, {"source": "adaptive_engine", "target": "china_6gen", "relation": "动力方向"}, {"source": "ws15", "target": "chengfei_6gen", "relation": "推测采用"}, {"source": "j20", "target": "chengfei_6gen", "relation": "性能参照"}, {"source": "made_in_china_2025", "target": "china_6gen", "relation": "推动"}, {"source": "defense_spending", "target": "china_6gen", "relation": "经费支撑"}, {"source": "air_force_modernization", "target": "china_6gen", "relation": "需求牵引"}, {"source": "avic_shenfei", "target": "shenfei_6gen", "relation": "关联"}, {"source": "aec", "target": "adaptive_engine", "relation": "产业链"}, {"source": "avic_electronic", "target": "chengfei_6gen", "relation": "产业链"}]}, "stats": {"entities_count": 15, "relations_count": 16}}}

data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T22:39:05.137807", "content": {"charts": [{"id": "chart_001", "title": "中国国防预算增长趋势", "subtitle": "2011-2021年国防预算/支出（亿元）", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "tooltip": {"trigger": "axis"}, "xAxis": {"type": "category", "data": ["2011", "2016", "2020", "2021"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "亿元", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"name": "国防预算/支出", "type": "line", "data": [6011, 9543, 12900, 13600], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}, "label": {"show": true, "position": "top", "color": "#1677ff", "formatter": "{c}"}}]}}, {"id": "chart_002", "title": "主要国家国防开支占GDP比重", "subtitle": "2021年对比（%）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "tooltip": {"trigger": "axis", "axisPointer": {"type": "shadow"}}, "xAxis": {"type": "category", "data": ["中国", "美国", "俄罗斯", "英国", "法国", "日本", "德国"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "%", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"type": "bar", "data": [{"value": 1.0, "itemStyle": {"color": "#1677ff"}}, {"value": 4.1, "itemStyle": {"color": "#fa8c16"}}, {"value": 1.2, "itemStyle": {"color": "#722ed1"}}, {"value": 2.1, "itemStyle": {"color": "#52c41a"}}, {"value": 1.8, "itemStyle": {"color": "#eb2f96"}}, {"value": 1.0, "itemS