data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:39:19.373415", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2018, 2020, 2021, 2022, 2023, 2025, 2026], 'Budget': [11070, 12680, 13553, 14504.5, 15537, 18100, 19095.61]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nev = {'Item': ['官方确认首飞', '提及试飞来源', '公开构型', '试飞验证机', '可确认发动机', '传闻发动机'], 'Count': [0, 2, 3, 3, 2, 3]}\ndf2 = pd.DataFrame(ev)\ndf2['Count'] = pd.to_numeric(df2['Count'], errors='coerce')\ndf2 = df2.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nax1.plot(df['Year'], df['Budget'], linewidth=2.5, marker='o', markersize=8, color='#6366f1')\nax1.fill_between(df['Year'], df['Budget'], alpha=0.15, color='#6366f1')\nax1.set_title('中国国防预算增长趋势', fontsize=15, fontweight='bold', pad=15)\nax1.set_xlabel('年份', fontsize=13)\nax1.set_ylabel('国防预算（亿元）', fontsize=13)\nax1.tick_params(labelsize=11)\nax1.grid(True, linestyle='--', alpha=0.3)\nax2 = axes[1]\nbars = ax2.barh(df2['Item'], df2['Count'], color=['#ef4444', '#06b6d4', '#10b981', '#10b981', '#f59e0b', '#f59e0b'])\nfor i, v in enumerate(df2['Count']):\n    ax2.text(v + 0.06, i, str(int(v)), va='center', fontsize=11, fontweight='bold')\nax2.set_title('六代机公开证据强度对比', fontsize=15, fontweight='bold', pad=15)\nax2.set_xlabel('数量（条 / 款 / 台）', fontsize=13)\nax2.tick_params(labelsize=11)\nax2.grid(True, linestyle='--', alpha=0.3, axis='x')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从庞杂的公开信息中提取两类核心数据：(1) 国防预算的连续年度序列（2018-2026），用于刻画六代机预研的资金与投入背景；(2) 六代机相关的“证据强度”指标（官方确认首飞来源数、提及试飞的来源数、公开构型数量、进入试飞的验证机数量、可确认发动机数量、传闻发动机数量），用于量化公开进展与不确定性。清洗后绘制双面板图：左侧为国防预算折线+面积填充，右侧为横向柱状图对比证据强度，直观呈现“传闻多、官方确认少”的不确定性结构。"}}

