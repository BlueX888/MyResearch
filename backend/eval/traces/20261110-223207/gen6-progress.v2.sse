data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T22:32:52.017176", "content": {"graph": {"nodes": [{"id": "node_0", "name": "成都飞机工业集团（成飞）", "type": "company", "discovered_at": "2026-11-10T22:32:52.016824"}, {"id": "node_1", "name": "沈阳飞机工业集团（沈飞）", "type": "company", "discovered_at": "2026-11-10T22:32:52.016835"}, {"id": "node_2", "name": "中航沈飞", "type": "company", "discovered_at": "2026-11-10T22:32:52.016843"}, {"id": "node_3", "name": "中航电测", "type": "company", "discovered_at": "2026-11-10T22:32:52.016850"}, {"id": "node_4", "name": "航发动力", "type": "company", "discovered_at": "2026-11-10T22:32:52.016857"}, {"id": "node_5", "name": "中国科学院工程热物理研究所", "type": "company", "discovered_at": "2026-11-10T22:32:52.016865"}, {"id": "node_6", "name": "变循环/自适应循环发动机", "type": "technology", "discovered_at": "2026-11-10T22:32:52.016872"}, {"id": "node_7", "name": "涡扇-15", "type": "technology", "discovered_at": "2026-11-10T22:32:52.016881"}, {"id": "node_8", "name": "爆震发动机", "type": "technology", "discovered_at": "2026-11-10T22:32:52.016886"}, {"id": "node_9", "name": "无尾/飞翼布局与全动翼尖", "type": "technology", "discovered_at": "2026-11-10T22:32:52.016892"}, {"id": "node_10", "name": "三发动机布局", "type": "technology", "discovered_at": "2026-11-10T22:32:52.016897"}, {"id": "node_11", "name": "歼-36 / 歼-50", "type": "technology", "discovered_at": "2026-11-10T22:32:52.016905"}], "edges": [{"source": "成都飞机工业集团（成飞）", "relation": "被指为六代机研制主机厂之一", "discovered_at": "2026-11-10T22:32:52.016829"}, {"source": "成都飞机工业集团（成飞）", "relation": "与沈飞形成方案竞争/并行研制关系", "discovered_at": "2026-11-10T22:32:52.016832"}, {"source": "沈阳飞机工业集团（沈飞）", "relation": "被指为六代机研制主机厂之一", "discovered_at": "2026-11-10T22:32:52.016837"}, {"source": "沈阳飞机工业集团（沈飞）", "relation": "被推测发展舰载六代机型号", "discovered_at": "2026-11-10T22:32:52.016839"}, {"source": "中航沈飞", "relation": "上市公司平台", "discovered_at": "2026-11-10T22:32:52.016845"}, {"source": "中航沈飞", "relation": "被券商类帖子列为六代机核心主机厂标的", "discovered_at": "2026-11-10T22:32:52.016847"}, {"source": "中航电测", "relation": "被列为六代机产业链核心标的", "discovered_at": "2026-11-10T22:32:52.016852"}, {"source": "中航电测", "relation": "涉及航电/测控系统", "discovered_at": "2026-11-10T22:32:52.016854"}, {"source": "航发动力", "relation": "被列为六代机动力配套标的", "discovered_at": "2026-11-10T22:32:52.016860"}, {"source": "航发动力", "relation": "与中国航发体系相关", "discovered_at": "2026-11-10T22:32:52.016863"}, {"source": "中国科学院工程热物理研究所", "relation": "被指主导变循环发动机研制", "discovered_at": "2026-11-10T22:32:52.016867"}, {"source": "中国科学院工程热物理研究所", "relation": "完成整机高空台试验（待核实）", "discovered_at": "2026-11-10T22:32:52.016870"}, {"source": "变循环/自适应循环发动机", "relation": "六代机核心动力方向", "discovered_at": "2026-11-10T22:32:52.016875"}, {"source": "变循环/自适应循环发动机", "relation": "与涡扇-15等现役动力形成代际差异", "discovered_at": "2026-11-10T22:32:52.016877"}, {"source": "变循环/自适应循环发动机", "relation": "被指仍处高空台试验阶段", "discovered_at": "2026-11-10T22:32:52.016879"}, {"source": "涡扇-15", "relation": "被自媒体用于推算三发布局总推力", "discovered_at": "2026-11-10T22:32:52.016884"}, {"source": "爆震发动机", "relation": "被军事爱好者推测用于沈飞新机，无证据", "discovered_at": "2026-11-10T22:32:52.016889"}, {"source": "无尾/飞翼布局与全动翼尖", "relation": "被指用于降低RCS、提升超音速与航程性能", "discovered_at": "2026-11-10T22:32:52.016894"}, {"source": "三发动机布局", "relation": "被指为成飞机型特征，含背部DSI进气道", "discovered_at": "2026-11-10T22:32:52.016899"}, {"source": "歼-36 / 歼-50", "relation": "自媒体使用的非官方型号命名，未经证实", "discovered_at": "2026-11-10T22:32:52.016908"}]}, "stats": {"entitiesCount": 12, "relationsCount": 20}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T22:32:52.017329", "content": {"agent": "DeepScout", "section": "竞争格局：主机厂与科研体系", "facts_count": 9, "duplicates_removed": 0, "data_points_count": 10, "insights": ["本次搜索结果全部为自媒体或股吧类内容，无一条官方、学术或权威媒体一手来源，整体可信度低，只能作为“舆论关注点”而非“事实依据”。", "“2024年12月26日成飞/沈飞六代机首飞”是当前中文网络的核心叙事，但腾讯、搜狐、头条、网易多篇文章内容高度同源、互相转引，存在明显的循环引用与信息放大风险，不能视为独立多源印证。", "技术焦点与假设h_2高度吻合：无尾布局、全向隐身、三发大推力、变循环动力、超远作战半径是被反复提及的方向；但热管理、AI辅助决策、开放式航电、定向能、有人/无人协同等方向在本次结果中缺乏实质证据。"], "source_quality": "整体来源质量低（加权可信度约0.25–0.35）。9条结果全部为自媒体、视频号或股吧类内容（腾讯网、搜狐、今日头条、网易号、东方财富财富号），无一条来自政府/军方/央企官方渠道、学术期刊或权威通讯社。存在三个结构性问题：一是同源转引，同一篇“成飞六代机涡轮基冲压组合发动机全解”在腾讯网以两个URL重复出现，网易与今日头条文章内容完全一致，构成伪多源；二是关键数据（4马赫、55吨推力、3000公里作战半径、编号36011）均以“可能”“据分析”“军事爱好者推测”表述，无工程或官方依据；三是核心事实（首飞）依赖“社交媒体曝光照片/视频”，无法追溯原始拍摄者与时间。因此本批材料仅可用于识别舆论关注点与技术讨论方向，不可用于确认研制阶段或性能指标；任何写入研究结论的表述都必须标注“未经官方证实”，并优先补充官方表述、专利与学术论文等一手来源。", "hypothesis_updates": 3, "search_results": [{"title": "成飞六代机涡轮基冲压组合发动机全解", "url": "https://view.inews.qq.com/a/20250212A03X8000?scene=qqsearch", "source": "腾讯网", "snippet": "我国成飞和沈飞的两款六代机相继试飞,如同两声嘹亮的号角,震撼了世界军事舞台。原本预想中的中美之争,怎就演变成了成飞、沈飞这两家军工企业的“内部切磋”了呢?      我们知道,第6代战斗机扩展飞行包线已是必然。全球航空界普遍认为第6代战斗机将装备自适应变循环发动机,最大速度提高到3马赫以上,巡航速度提高到1.5马赫以上,甚至超过2马赫。", "date": "2025-02-12T11:36:45+08:00"}, {"title": "成飞六代机涡轮基冲压组合发动机全解", "url": "https://new.qq.com/rain/a/20250212A03X8000", "source": "腾讯网", "snippet": "我国成飞和沈飞的两款六代机相继试飞,如同两声嘹亮的号角,震撼了世界军事舞台。原本预想中的中美之争,怎就演变成了成飞、沈飞这两家军工企业的“内部切磋”了呢?      我们知道,第6代战斗机扩展飞行包线已是必然。全球航空界普遍认为第6代战斗机将装备自适应变循环发动机,最大速度提高到3马赫以上,巡航速度提高到1.5马赫以上,甚至超过2马赫。", "date": "2025-02-12T11:36:45+08:00"}, {"title": "实锤了,成飞六代机第三个发动机另有乾坤。_中国_沈飞_航空", "url": "https://www.sohu.com/a/846639231_121974737", "source": "搜狐", "snippet": "在航空工业的浩瀚星空中,中国航空工业的两颗璀璨明珠——成飞与沈飞,正以六代机的研发试飞为笔,书写着中国航空史上的新篇章。近日,两款六代机分别进行了更多试飞,它们的亮相不仅展示了中国航空工业的雄厚实力,更引发了全球航空界的广泛关注。 成飞与沈飞,作为中国航空工业的两大巨头,此次在六代机的研发上各展所长。", "date": "2025-01-08T11:50:00+08:00"}, {"title": "【六代机】1核心主机厂:【中航沈飞】、【中航电测】2超远作战半径:【航发动力】、_财富号_东方财富网", "url": "https://caifuhao.eastmoney.com/news/20241226230142043070460", "source": "财富号", "snippet": "郑重声明: 用户在社区发表的所有信息将由本网站记录保存,仅代表作者个人观点,与本网站立场无关,不对您构成任何投资建议,据此操作风险自担。 请勿相信代客理财、免费荐股和炒股培训等宣传内容,远离非法证券活动。请勿添加发言用户的手机号码、公众号、微博、微信及QQ等信息,谨防上当受骗! 总收益 20日收益 日收益 -- -- -- 代码 名称 最新价 涨跌幅 查看更多", "date": "2024-12-26T23:01:00+08:00"}, {"title": "实锤了，成飞六代机第三个发动机另有乾坤。", "url": "https://m.toutiao.com/article/7457455547952939583/", "source": "今日头条", "snippet": "根据最新的报道,中国的两款第六代战斗机(六代机)分别由成都飞机工业公司(成飞)和沈阳飞机工业集团(沈飞)研发,并在2024年12月26日进行了首次试飞,这一事件引起了全球的广泛关注。\n成飞的六代机首次公开亮相即以36011编号,表明其研发进度可能已进入较为成熟的阶段。该战机采用了飞翼结构、无垂尾设计,以及全动翼尖,显示出极高的技术水平和隐身能力。最引人注目的是,这款战机采用了三发动机布局,其中包括一台位于机身前部下方两侧的发动机和一台背部DSI进气道发动机。这种设计不仅提供了强大的推力,也可能意味着该战机具有更高的速度和更好的机动性。据报道,如果采用最新的涡扇15发动机,三发的总推力可能超过55吨,最大速度可能达到4马赫以上。\n沈飞的六代机同样采用了隐身设计,体型也远超现役战机。根据网传视频,沈飞新机的进气口格外巨大,尾喷口部位也十分宏伟,虽然目前仅能确认是双发设计,但有军事爱好者推测它可能搭载了传说中的爆震发动机。\n这两款六代机的首飞,不仅展示了中国航空工业的惊人进步,也为未来解放军海空军的装备布局提供了更多选择。成飞的六代机采用了无尾翼设计,大幅度降低了雷达反射截面(RCS),增强了战机的隐身性能。此外,无尾翼设计还为六代机带来了出色的飞行性能,包括更高的巡航速度、更长的作战半径和更强的超音速能力。据分析,成飞的六代机作战半径有望达到3000公里以上,相较于歼-20提升了50%,其作战范围甚至可以轻松覆盖关岛地区。\n总的来说,成飞和沈飞的六代机首飞成功,标志着中国航空工业在战斗机研发领域取得了重大突破,这不仅是中国航空工业的里程碑,也是全球航空技术发展的一个重要时刻。", "date": "2025-01-09T02:36:00+08:00"}, {"title": "成飞和沈飞的两款飞机是六代机吗,六代机应该具备哪些特点?第六代战斗机军事武器成都飞机工业集团沈阳飞机工业集团航空知识太空工程飞机知识美...", "url": "https://www.163.com/v/video/VJJO3UNEN.html", "source": "网易", "snippet": "点击按住拖动小窗 关闭 2944粉丝 新鲜资讯每日更新,欢迎关注 所属MCN:鲜菓MCN 1997-2025 网易公司版权所有 About NetEase 不良信息举报 Complaint", "date": "2025-01-04T16:30:00+08:00"}, {"title": "世界最强航空发动机,将在我国诞生?让六代机航程超10000公里|推重比|涡扇|涵道比|耗油率|航空发动机|超声速_手机网易网", "url": "https://m.163.com/dy/article/KFRMAJ6B055692A9.html", "source": "网易", "snippet": "社交媒体曝光的最新照片显示,由中国科学院工程热物理研究所主导研制的变循环发动机已经完成整机高空台试验。试验结果表明,该发动机在推力增加和耗油率降低方面效果显著,从而为其后续发展奠定坚实基础。外界普遍认为,第六代战斗机将会装备变循环发动机,加之美俄等国在该领域动作频频,所以再看中国科学院的相关研制进展,对于处在试飞阶段的成六代及沈六代来说,无疑是一大福音。\n打开网易新闻\n查看精彩图片\n六代机本身对超机动能力极为看重,这是由其战术定位与任务用途所决定的,具体到与之配套的动力引擎上来看,就需突出超大推力和推重比、超低油耗、超低费用、长耐久(寿命)等特征。反观现有的涡扇发动机,则很难在上述指标之间达到平衡,特别是在大推力/推重比与低油耗上,面临着顾此失彼的境地,于是在此背景下,变循环发动机当即应运而生。细究变循环发动机的优势,在于其既能够兼顾大涵道比涡扇发动机在亚声速飞行条件下的低油耗,以及小涵道比涡扇甚至涡喷发动机在超声速飞行条件下的高推力、低油耗的优势;同时也能有效降低亚声速飞行条件下的安装损失,从而可以满足多任务(亚声速和超声速飞行)飞行器的性能要求。\n打开网易新闻\n查看精彩图片\n进一步讲,变循环发动机通过调整自身一些部件的几何形状、尺寸或位置,改变发动机的循环参数,以此实现不同特征的热力循环。发动机的调节变量越多、热力循环参数的调节范围越大,从而使其工作模式就越灵活。将变循环发动机安装在六代机上后,该机便能根据任务需求主动调节自身工作状态,如此动力模式不仅能达到实时切换,并且在全飞行包线内还具有最佳的推进效率,当然也会更省油。有鉴于此,当变循环发动机概念从20世纪60年代诞生以来,旋即使其受到了包括英国、日本、美国等国的力捧,我国对此自然也不能例外。再者需要强调的是,在变循环发动机不断迭代之际,还催生出了自适应变循环发动机这一全新产物,相比前者,自适应变循环发动机具有更大", "date": "2025-12-03T10:51:29+08:00"}, {"title": "世界最强航空发动机,将在我国诞生?让六代机航程超10000公里 - 今日头条", "url": "https://www.toutiao.com/article/7579456366700413492/", "source": "今日头条", "snippet": "社交媒体曝光的最新照片显示,由中国科学院工程热物理研究所主导研制的变循环发动机已经完成整机高空台试验。试验结果表明,该发动机在推力增加和耗油率降低方面效果显著,从而为其后续发展奠定坚实基础。外界普遍认为,第六代战斗机将会装备变循环发动机,加之美俄等国在该领域动作频频,所以再看中国科学院的相关研制进展,对于处在试飞阶段的成六代及沈六代来说,无疑是一大福音。六代机本身对超机动能力极为看重,这是由其战术定位与任务用途所决定的,具体到与之配套的动力引擎上来看,就需突出超大推力和推重比、超低油耗、超低费用、长耐久(寿命)等特征。反观现有的涡扇发动机,则很难在上述指标之间达到平衡,特别是在大推力/推重比与低油耗上,面临着顾此失彼的境地,于是在此背景下,变循环发动机当即应运而生。细究变循环发动机的优势,在于其既能够兼顾大涵道比涡扇发动机在亚声速飞行条件下的低油耗,以及小涵道比涡扇甚至涡喷发动机在超声速飞行条件下的高推力、低油耗的优势;同时也能有效降低亚声速飞行条件下的安装损失,从而可以满足多任务(亚声速和超声速飞行)飞行器的性能要求。进一步讲,变循环发动机通过调整自身一些部件的几何形状、尺寸或位置,改变发动机的循环参数,以此实现不同特征的热力循环。发动机的调节变量越多、热力循环参数的调节范围越大,从而使其工作模式就越灵活。将变循环发动机安装在六代机上后,该机便能根据任务需求主动调节自身工作状态,如此动力模式不仅能达到实时切换,并且在全飞行包线内还具有最佳的推进效率,当然也会更省油。有鉴于此,当变循环发动机概念从20世纪60年代诞生以来,旋即使其受到了包括英国、日本、美国等国的力捧,我国对此自然也不能例外。再者需要强调的是,在变循环发动机不断迭代之际,还催生出了自适应变循环发动机这一全新产物,相比前者,自适应变循环发动机具有更大的参数调节范围和更好的性能,可以增加飞机的转场航程、作战半径、", "date": "2025-12-03T10:48:00+08:00"}, {"title": "世界最强航空发动机,将在我国诞生?让六代机航程超10000公里|涡扇|耗油率|推重比|涵道比|超声速_网易订阅", "url": "https://www.163.com/dy/article/KFRMAJ6B055692A9.html", "source": "网易", "snippet": "社交媒体曝光的最新照片显示,由中国科学院工程热物理研究所主导研制的变循环发动机已经完成整机高空台试验。试验结果表明,该发动机在推力增加和耗油率降低方面效果显著,从而为其后续发展奠定坚实基础。外界普遍认为,第六代战斗机将会装备变循环发动机,加之美俄等国在该领域动作频频,所以再看中国科学院的相关研制进展,对于处在试飞阶段的成六代及沈六代来说,无疑是一大福音。六代机本身对超机动能力极为看重,这是由其战术定位与任务用途所决定的,具体到与之配套的动力引擎上来看,就需突出超大推力和推重比、超低油耗、超低费用、长耐久(寿命)等特征。反观现有的涡扇发动机,则很难在上述指标之间达到平衡,特别是在大推力/推重比与低油耗上,面临着顾此失彼的境地,于是在此背景下,变循环发动机当即应运而生。细究变循环发动机的优势,在于其既能够兼顾大涵道比涡扇发动机在亚声速飞行条件下的低油耗,以及小涵道比涡扇甚至涡喷发动机在超声速飞行条件下的高推力、低油耗的优势;同时也能有效降低亚声速飞行条件下的安装损失,从而可以满足多任务(亚声速和超声速飞行)飞行器的性能要求。进一步讲,变循环发动机通过调整自身一些部件的几何形状、尺寸或位置,改变发动机的循环参数,以此实现不同特征的热力循环。发动机的调节变量越多、热力循环参数的调节范围越大,从而使其工作模式就越灵活。将变循环发动机安装在六代机上后,该机便能根据任务需求主动调节自身工作状态,如此动力模式不仅能达到实时切换,并且在全飞行包线内还具有最佳的推进效率,当然也会更省油。有鉴于此,当变循环发动机概念从20世纪60年代诞生以来,旋即使其受到了包括英国、日本、美国等国的力捧,我国对此自然也不能例外。再者需要强调的是,在变循环发动机不断迭代之际,还催生出了自适应变循环发动机这一全新产物,相比前者,自适应变循环发动机具有更大的参数调节范围和更好的性能,可以增加飞机的转场航程、作战半径", "date": "2025-12-03T10:51:29+08:00"}, {"title": "沈飞歼50再度试飞,相比于成飞歼36,会成为全球首款舰载六代机 - 今日头条", "url": "https://www.toutiao.com/video/7587497734731547177/", "source": "今日头条", "snippet": "展开沈飞歼50再度试飞,相比于成飞歼36,会成为全球首款舰载六代机播放\n1872发布于\n2025-12-25\n02:46", "date": "2025-12-25T02:46:00+08:00"}], "extracted_facts": [{"content": "腾讯网文章称，成飞与沈飞两款第六代战斗机相继试飞，并称全球航空界普遍认为六代机将装备自适应变循环发动机，最大速度提高到3马赫以上、巡航速度提高到1.5马赫以上。文中未给出试飞时间、地点、官方消息源或影像出处。", "source_name": "腾讯网（转载自媒体）", "source_url": "https://view.inews.qq.com/a/20250212A03X8000?scene=qqsearch", "credibility": 0.3}, {"content": "今日头条/搜狐自媒体称，成飞与沈飞两款六代机于2024年12月26日进行首次试飞；成飞机型公开亮相编号为“36011”，采用飞翼结构、无垂尾设计、全动翼尖和三发动机布局（含背部DSI进气道发动机）。该说法未获任何官方渠道确认，编号与构型均来自网络视频解读。", "source_name": "今日头条（自媒体）", "source_url": "https://m.toutiao.com/article/7457455547952939583/", "credibility": 0.25}, {"content": "自媒体推测性数据：若成飞三发布局采用涡扇-15，总推力可能超过55吨，最大速度可能达4马赫以上，作战半径有望达3000公里以上、较歼-20提升约50%。上述均为“可能/据分析”式推测，无工程数据或官方口径支撑。", "source_name": "今日头条（自媒体）", "source_url": "https://m.toutiao.com/article/7457455547952939583/", "credibility": 0.2}, {"content": "自媒体称沈飞六代机采用隐身设计、机体尺寸远超现役战机，进气口与尾喷口尺寸巨大，目前仅能确认双发设计，有军事爱好者推测其可能搭载“爆震发动机”。该表述本身承认信息来源为爱好者推测。", "source_name": "今日头条（自媒体）", "source_url": "https://m.toutiao.com/article/7457455547952939583/", "credibility": 0.2}, {"content": "网易/今日头条文章称，社交媒体曝光照片显示，由中国科学院工程热物理研究所主导研制的变循环发动机已完成整机高空台试验，试验结果表明推力增加、耗油率降低，为后续发展奠定基础；文章将其与“处在试飞阶段的成六代及沈六代”相联系。原始信息为“社交媒体曝光照片”，非中科院或官方发布。", "source_name": "网易（自媒体号）", "source_url": "https://www.163.com/dy/article/KFRMAJ6B055692A9.html", "credibility": 0.35}, {"content": "同一文章指出，变循环发动机需在超大推力/推重比与超低油耗之间取得平衡，现有涡扇发动机难以兼顾，因此变循环是六代机动力必然方向；这间接说明自适应变循环动力尚未成熟装机，仍处试验验证阶段。", "source_name": "网易（自媒体号）", "source_url": "https://www.163.com/dy/article/KFRMAJ6B055692A9.html", "credibility": 0.35}, {"content": "东方财富“财富号”帖子将六代机产业链标的列为：核心主机厂中航沈飞、中航电测，超远作战半径相关航发动力等。属券商/股吧式概念梳理，无产业订单或研制分工的一手证据。", "source_name": "东方财富财富号", "source_url": "https://caifuhao.eastmoney.com/news/20241226230142043070460", "credibility": 0.3}, {"content": "今日头条视频称“沈飞歼50再度试飞，相比于成飞歼36，会成为全球首款舰载六代机”，使用“歼-36”“歼-50”等非官方型号命名，并称已进入“再度试飞”阶段。无官方编号依据。", "source_name": "今日头条（视频自媒体）", "source_url": "https://www.toutiao.com/video/7587497734731547177/", "credibility": 0.2}], "data_points": [{"name": "六代机预期最大速度", "value": ">3", "unit": "马赫", "year": 2025, "source": "腾讯网（转载自媒体）"}, {"name": "六代机预期巡航速度", "value": ">1.5", "unit": "马赫", "year": 2025, "source": "腾讯网（转载自媒体）"}, {"name": "所称首飞日期", "value": "2024-12-26", "unit": "日期", "year": 2024, "source": "今日头条（自媒体）"}, {"name": "所称原型机编号", "value": "36011", "unit": "编号", "year": 2024, "source": "今日头条（自媒体）"}, {"name": "推测总推力", "value": ">55", "unit": "吨", "year": 2025, "source": "今日头条（自媒体）"}, {"name": "推测最大速度", "value": ">4", "unit": "马赫", "year": 2025, "source": "今日头条（自媒体）"}, {"name": "推测作战半径", "value": ">3000", "unit": "公里", "year": 2025, "source": "今日头条（自媒体）"}, {"name": "作战半径相对歼-20提升", "value": "50", "unit": "%", "year": 2025, "source": "今日头条（自媒体）"}, {"name": "可确认发动机数量", "value": "2", "unit": "台", "year": 2025, "source": "今日头条（自媒体）"}, {"name": "变循环发动机试验状态", "value": "整机高空台试验完成", "unit": "阶段", "year": 2025, "source": "网易（自媒体号）"}]}}

