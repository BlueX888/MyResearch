data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T22:32:20.293917", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况：国防航空预研投入与产业规模", "description": "描述中国国防预算中航空装备与预研投入的代理指标、军工航空产业链规模及增速；六代机相关研发支出不单独公开，需用国防预算、航空工业营收、研发投入强度等估算。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中国 国防预算 航空装备 预研 投入 六代机 研发 产业规模"]}, {"id": "sec_2", "title": "竞争格局：主机厂与科研体系", "description": "描述主要参与主体，包括航空工业成飞、沈飞、西飞、中国航发、中国电科、航天科工及相关高校院所；竞争合作围绕方案竞标、发动机、航电、隐身材料和试验设施展开。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 沈飞 六代机 预研 中国航发 变循环发动机 中国电科 航电"]}, {"id": "sec_3", "title": "技术趋势：六代机核心技术方向", "description": "描述核心技术，包括全向/宽频隐身、无尾布局、变循环发动机、有人无人协同、AI辅助决策、开放式航电、定向能武器、先进传感器融合和热管理等。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["六代机 无尾布局 变循环发动机 有人无人协同 智能航电 定向能 公开论文 专利"]}, {"id": "sec_4", "title": "政策环境：国防科技工业与外部约束", "description": "描述相关政策，包括国防科技工业政策、军民融合、装备预研管理、航空发动机专项、科技创新规划，以及出口管制、制裁和保密制度等外部因素。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防科技工业 预研 政策 军民融合 航空发动机 专项 出口管制 六代机"]}, {"id": "sec_5", "title": "挑战机遇：技术瓶颈与产业机会", "description": "描述挑战，包括先进发动机、隐身材料、热管理、系统集成、试验设施和保密导致的信息不透明；机遇包括AI、无人系统、新材料、数字工程和航空产业升级。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["六代机 技术瓶颈 航空发动机 隐身材料 系统集成 数字工程 机遇 挑战"]}, {"id": "sec_6", "title": "未来展望：预研节奏与公开信息演进", "description": "描述发展趋势，判断2030年前后可能进入原型机/演示验证阶段、2035年后形成服役能力的预期；公开信息可能逐步增多，但仍以官方选择性披露为主。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中国 六代机 首飞 时间 2030 2035 原型机 演示验证 公开进展"]}], "research_questions": ["中国六代机预研目前处于哪个阶段，有哪些可验证的公开证据？", "六代机关键技术中哪些已公开突破、哪些仍是主要不确定性？", "国防预算、出口管制和保密制度如何影响预研节奏与公开信息可得性？"]}}

