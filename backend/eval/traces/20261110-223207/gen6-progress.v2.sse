"发动机数量", "最大速度推测", "作战半径推测", "总推力推测"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 12}}, "series": [{"type": "scatter", "data": [{"name": "首飞日期", "value": ["2024-12-26", 0, 0.25], "symbolSize": 14, "itemStyle": {"color": "#fa8c16"}}, {"name": "原型机编号", "value": ["2024-11-01", 1, 0.2], "symbolSize": 12, "itemStyle": {"color": "#eb2f96"}}, {"name": "变循环发动机试验", "value": ["2025-03-01", 2, 0.35], "symbolSize": 18, "itemStyle": {"color": "#52c41a"}}, {"name": "原型累计数量", "value": ["2025-08-01", 3, 0.4], "symbolSize": 20, "itemStyle": {"color": "#52c41a"}}, {"name": "发动机数量", "value": ["2025-01-01", 4, 0.2], "symbolSize": 12, "itemStyle": {"color": "#eb2f96"}}, {"name": "最大速度推测", "value": ["2025-01-01", 5, 0.2], "symbolSize": 12, "itemStyle": {"color": "#eb2f96"}}, {"name": "作战半径推测", "value": ["2025-01-01", 6, 0.2], "symbolSize": 12, "itemStyle": {"color": "#eb2f96"}}, {"name": "总推力推测", "value": ["2025-01-01", 7, 0.2], "symbolSize": 12, "itemStyle": {"color": "#eb2f96"}}], "label": {"show": true, "position": "right", "formatter": "{@[2]}", "color": "#666"}}]}}]}}

