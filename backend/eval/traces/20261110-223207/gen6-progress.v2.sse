data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T22:34:05.691296", "content": {"results": [{"id": "sr_5aebdf", "title": "英语新闻 China's Next-Gen 6th-Generation Fighter Jet_成都英锐教育", "source": "m.cdenreach.com", "url": "http://m.cdenreach.com/news/5057.html", "snippet": "Breaking News: China's Next-Gen 6th-Generation Fighter Jet Successfully Completes First Flight. 26 Dec, 2024 - 9:17 Defense News Aerospace 2024 On December 26, 2024, a major milestone was achieved in the field of military aviation as China’s next-generation (6th-gen) fighter jet successfully made its first flight. The event, which was shared through videos released on social media, marks a significant advancement in China's aerospace capabilities. It places the country in direct competition with other global superpion and speculation regarding China's ambitions to shape the next era of military aviation. The new fighter jet, although its exact specifications remain confidential, is believed to feature a range of cuttinre advanced stealth capabilities, which will make the jet harder to dete", "date": "2025-01-05T15:46:03+08:00"}, {"id": "sr_2a364c", "title": "Fighter jet takes off for training - Photos China - 中国军网(英文版)", "source": "PLA Daily", "url": "http://eng.chinamil.com.cn/MEDIA/PhotosChina/16348715.html", "snippet": "China Military Fighter jet takes off for training A fighter jet attached to a brigade under the Chinese PLA Air Force takes off for a flight training exercise aiming to hone the pilots' capabilities on September 29, 2024. (eng.chinamil.com.cn/Photo by Cui Baoliang) Source:China Military Online", "date": "2024-10-30T22:49:45+08:00"}, {"id": "sr_dcd9b8", "title": "Fighter jet takes off at night - Photos China - 中国军网(英文版)", "source": "PLA Daily", "url": "http://eng.chinamil.com.cn/MEDIA/PhotosChina/16315759.html", "snippet": "China Military Fighter jet takes off at night A fighter jet attached to an aviation unit of the PLA Air Force takes off for a flight training exercise on May 24, 2024. (eng.chinamil.com.cn/Photo by Liao Weiqi) Source:China Military Online", "date": "2024-12-09T00:00:00+08:00"}, {"id": "sr_6ecc07", "title": "Fighter jets take off for flight training - People's Daily Online", "source": "en.people.cn", "url": "http://en.people.cn/n3/2024/0911/c90000-20217735.html", "snippet": "Pilots assigned to an aviation brigade with the air force under the Chinese PLA Eastern Theater Command sit in the cockpit of their fight jet to get ready for a flight training exercise on July 30, 2024. (eng.chinamil.com.cn/Photo by Zhan Peng) A fighter jet attached to an aviation brigade with the air force under the Chinese PLA Eastern Theater Command taxies on the runway before takeoff during a flight training exercise on July 30, 2024. (eng.chinamil.com.cn/Photo by Zhan Peng) Fighter jets attached to an aviation brigade with the air force under the Chinese PLA Eastern Theater Command soar in the sky during a flight training exercise on July 30, 2024. (eng.chinamil.com.cn/Photo by Zhan Peng) (Web editor: Tian Yi, Zhong Wenxing)", "date": "2024-09-11T19:47:53+08:00"}, {"id": "sr_c9aa5c", "title": "转载美国《战区》报道:中国2024年12月26号试飞的新型战机对美国加油机、空运机、空中预警和控制机、侦察机以及在前沿地区行动的盟军舰艇和部队具...", "source": "今日头条", "url": "https://www.toutiao.com/w/1819557215296908/", "snippet": "美国《战区》报道: 中国2024年12月26号试飞的新型战机对美国加油机、空运机、空中预警和控制机、侦察机以及在前沿地区行动的盟军舰艇和部队具有真正的影响。 它还将作为一个关键的力倍增传感器平台,在后方工作。如果与具有配备续航能力的无人机僚机配合,它的杀伤力和生存能力将成倍增加!", "date": "2024-12-27T10:03:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

