9"}, {"source": "歼-36 / 歼-50", "relation": "自媒体使用的非官方型号命名，未经证实", "discovered_at": "2026-11-10T22:32:52.016908"}, {"source": "中国航空工业集团", "relation": "航空装备研制主体", "discovered_at": "2026-11-10T22:32:54.487836"}, {"source": "中国航空工业集团", "relation": "先进战机技术积累", "discovered_at": "2026-11-10T22:32:54.487838"}, {"source": "中国航发", "relation": "航空发动机研制", "discovered_at": "2026-11-10T22:32:54.487841"}, {"source": "中国航发", "relation": "六代机动力潜在瓶颈", "discovered_at": "2026-11-10T22:32:54.487842"}, {"source": "歼-20", "relation": "五代机", "discovered_at": "2026-11-10T22:32:54.487845"}, {"source": "歼-20", "relation": "技术人才积累", "discovered_at": "2026-11-10T22:32:54.487847"}, {"source": "歼-20", "relation": "六代机预研基础", "discovered_at": "2026-11-10T22:32:54.487848"}, {"source": "第六代战斗机", "relation": "预研一代", "discovered_at": "2026-11-10T22:32:54.487851"}, {"source": "第六代战斗机", "relation": "高度保密", "discovered_at": "2026-11-10T22:32:54.487852"}, {"source": "第六代战斗机", "relation": "公开信息以CG和评论为主", "discovered_at": "2026-11-10T22:32:54.487853"}, {"source": "变循环发动机", "relation": "六代机潜在动力方向", "discovered_at": "2026-11-10T22:32:54.487856"}, {"source": "变循环发动机", "relation": "搜索结果未提供中国进展证据", "discovered_at": "2026-11-10T22:32:54.487857"}, {"source": "国防预算", "relation": "航空装备采购资金来源", "discovered_at": "2026-11-10T22:32:54.487860"}, {"source": "国防预算", "relation": "预研投入代理指标", "discovered_at": "2026-11-10T22:32:54.487862"}, {"source": "军民融合", "relation": "预研政策环境", "discovered_at": "2026-11-10T22:32:54.487866"}, {"source": "军民融合", "relation": "搜索结果未展开", "discovered_at": "2026-11-10T22:32:54.487867"}, {"source": "空军三步走战略", "relation": "2020年战略空军门槛", "discovered_at": "2026-11-10T22:32:54.487870"}, {"source": "空军三步走战略", "relation": "2035年现代化战略空军", "discovered_at": "2026-11-10T22:32:54.487871"}, {"source": "空军三步走战略", "relation": "本世纪中叶世界一流战略空军", "discovered_at": "2026-11-10T22:32:54.487872"}, {"source": "World air forces 2022", "relation": "军机数量数据来源", "discovered_at": "2026-11-10T22:32:54.487875"}, {"source": "World air forces 2022", "relation": "中美军机数量对比", "discovered_at": "2026-11-10T22:32:54.487876"}, {"source": "美国空军部长", "relation": "美国六代机计划评论", "discovered_at": "2026-11-10T22:32:54.487879"}, {"source": "美国空军部长", "relation": "研发预算评论", "discovered_at": "2026-11-10T22:32:54.487880"}, {"source": "歼-36", "relation": "被指为成飞系六代机构型", "discovered_at": "2026-11-10T22:32:57.755914"}, {"source": "歼-36", "relation": "与歼-50并列构成多路线竞标", "discovered_at": "2026-11-10T22:32:57.755915"}, {"source": "歼-50", "relation": "被指为沈飞系六代机构型", "discovered_at": "2026-11-10T22:32:57.755918"}, {"source": "歼-50", "relation": "与歼-36并列", "discovered_at": "2026-11-10T22:32:57.755918"}, {"source": "沈阳飞机工业集团/沈阳所", "relation": "六代机技术路线之一", "discovered_at": "2026-11-10T22:32:57.755921"}, {"source": "西北工业大学", "relation": "公开变后掠舰载机专利设计", "discovered_at": "2026-11-10T22:32:57.755923"}, {"source": "西北工业大学", "relation": "被指为第三款新机方案来源", "discovered_at": "2026-11-10T22:32:57.755924"}, {"source": "西北工业大学", "relation": "与西飞可能联合开发无人僚机", "discovered_at": "2026-11-10T22:32:57.755925"}, {"source": "西安飞机工业集团（西飞）", "relation": "被指参与第三款六代机/无人僚机研制", "discovered_at": "2026-11-10T22:32:57.755927"}, {"source": "变循环发动机（三涵道/自适应循环）", "relation": "六代机核心动力方向", "discovered_at": "2026-11-10T22:32:57.755929"}, {"source": "变循环发动机（三涵道/自适应循环）", "relation": "被自媒体称为已突破", "discovered_at": "2026-11-10T22:32:57.755930"}, {"source": "变循环发动机（三涵道/自适应循环）", "relation": "韩国招标同样要求", "discovered_at": "2026-11-10T22:32:57.755931"}, {"source": "无尾/无垂尾布局", "relation": "全向隐身关键手段", "discovered_at": "2026-11-10T22:32:57.755933"}, {"source": "无尾/无垂尾布局", "relation": "多国六代机概念共同特征", "discovered_at": "2026-11-10T22:32:57.755934"}, {"source": "宽频段隐身/超材料智能蒙皮", "relation": "覆盖L/S/X波段及红外光学", "discovered_at": "2026-11-10T22:32:57.755936"}, {"source": "宽频段隐身/超材料智能蒙皮", "relation": "与全向隐身相关", "discovered_at": "2026-11-10T22:32:57.755937"}, {"source": "旋转爆震燃烧", "relation": "被中华网称为已实现", "discovered_at": "2026-11-10T22:32:57.755939"}, {"source": "旋转爆震燃烧", "relation": "与变循环动力组合", "discovered_at": "2026-11-10T22:32:57.755940"}, {"source": "量子雷达", "relation": "被推测用于六代机", "discovered_at": "2026-11-10T22:32:57.755942"}, {"source": "量子雷达", "relation": "证据薄弱", "discovered_at": "2026-11-10T22:32:57.755943"}, {"source": "韩国国防采办计划管理局（DAPA）", "relation": "2026年8月发布下一代战斗机概念研究招标", "discovered_at": "2026-11-10T22:32:57.755945"}, {"source": "韩国国防科学研究院（ADD）", "relation": "展示无尾双发六代机概念", "discovered_at": "2026-11-10T22:32:57.755947"}, {"source": "韩国国防科学研究院（ADD）", "relation": "2025年11月启动全尺寸隐身验证机", "discovered_at": "2026-11-10T22:32:57.755948"}, {"source": "F-47（美）", "relation": "被韩国招标书列为参考对象", "discovered_at": "2026-11-10T22:32:57.755950"}, {"source": "GCAP（英日意）", "relation": "被韩国招标书列为参考对象", "discovered_at": "2026-11-10T22:32:57.755952"}, {"source": "忠诚僚机/有人无人协同", "relation": "六代机体系化竞争核心", "discovered_at": "2026-11-10T22:32:57.755954"}, {"source": "忠诚僚机/有人无人协同", "relation": "与第三款新机身份判断相关", "discovered_at": "2026-11-10T22:32:57.755955"}]}, "stats": {"entitiesCount": 37, "relationsCount": 70}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T22:32:57.756075", "content": {"agent": "DeepScout", "section": "技术趋势：六代机核心技术方向", "facts_count": 8, "duplicates_removed": 0, "data_points_count": 12, "insights": ["公开信息生态严重失衡：10条结果中6条为自媒体视频/文章，2条为军事门户转载，仅1条权威媒体（南方周末）且为泛论，无任何官方或学术一手来源，中国六代机的可核查公开进展实质上接近于零。", "技术方向已形成跨来源共识：无尾/无垂尾、宽频全向隐身、变循环（自适应循环）发动机、AI辅助决策、有人无人协同、内置弹舱与体系化作战，且与韩国最新招标书要求高度重合，说明这是全球六代机的“标准配置”而非中国独有。", "关键性能数据（推力+47%、油耗-40%、航程1万公里、RCS 0.001 m²）全部出自单一自媒体且无原始出处，属于典型的“参数型叙事”，不可作为研究结论使用，必须追溯原始来源或直接剔除。"], "source_quality": "整体质量偏低且高度同质化。10条结果中，6条为自媒体（网易视频、网易号、今日头条），credibility 0.2左右，内容多为标题党、无署名、无原始出处，且带有明显“领先/超越”倾向性叙事；2条为中华网军事频道转载（0.4-0.5），属一般军事门户，信息未经核实且含大量推测性表述（如“已实现旋转爆震燃烧”“量子雷达”）；1条为南方周末（0.75），属权威媒体但内容为宏观评论，无具体进展信息；2条关于韩国六代机的报道（0.6）为多源综合转引，相对可核查但仍属二手。全部结果中无任何官方来源（0.9-1.0）或学术来源（0.8-0.95），关键性能数据（47%、40%、1万公里、0.001 m²）均不可追溯。结论：现有搜索结果不足以支撑对中国六代机预研进展的实质性判断，仅可用于识别“技术方向共识”与“信息不透明程度”，所有具体参数与型号信息须标记为待验证。", "hypothesis_updates": 3, "search_results": [{"title": "无尾飞翼,智能协同:中国六代战机新突破_网易视频", "url": "https://m.163.com/v/video/VRIAOHTSU.html", "source": "网易", "snippet": "无尾飞翼,智能协同:中国六代战机新突破\n无尾飞翼,智能协同:中国六代战机新突破\n声明:个人原创,仅供参考\n打开网易新闻\n体验效果更佳", "date": "2026-01-14T17:36:58+08:00"}, {"title": "中国第三款六代机是无人机还是有人机 新机型引发热议_军事频道_中华网", "url": "https://military.china.com/news/13004177/20250806/48694871_1.html", "source": "中华网军事", "snippet": "关于它是否为有人驾驶的问题,可以参考西北工业大学之前的一个专利图。去年西工大公开了一种变后掠舰载机的设计方案,图中的战机也是无垂尾,翼尖向后斜切,双发喷口隐蔽,尾部有锯齿状结构,肚子底下留有内弹舱空间,这些特征与照片中的新机非常相似。这样看来,说它是西工大方案的“实物版”有一定道理。若真带“变后掠翼”设计,作为舰载机的可能性更大。航母上的飞机需要低速稳定性和超音速能力,变后掠翼正好能平衡这两点。再加上无垂尾带来的隐身优势,非常适合未来航母。目前中国的舰载机是歼-15T和歼-35,如果再有一款六代机,海空战力将大幅提升。这是几个月内曝光的第三款六代机原型。歼-36、歼-50加上这款,三种完全不同的构型显示了多条技术路线的竞争。这种竞争类似于上世纪美国YF-22和YF-23竞标五代机的情况,正是这种竞争催生了后来的F-22。而美国后来因缺乏对手,六代机发展反而慢了下来。中国现在采取“多头竞标”,不仅能激活航空工业的潜力,还能让不同设计理念碰撞出火花,最终找到最适合未来空战的方案。", "date": "2025-08-06T07:12:13+08:00"}, {"title": "各国六代机设计新趋势:无垂尾设计第六代战斗机_网易视频", "url": "https://www.163.com/v/video/VULB4N2FJ.html", "source": "网易", "snippet": "点击按住拖动小窗 关闭 重播 声明:个人原创,仅供参考 17粉丝 感谢关注,持续更新 1997-2025 网易公司版权所有 About NetEase 不良信息举报 Complaint Center", "date": "2025-01-19T11:34:16+08:00"}, {"title": "无人敢言的真相:中国六代机真正制胜关键曝光,领先之处远超速度|中国六代机|五代机|原型机|歼20|舰载机|速度|隐身战机_手机网易网", "url": "https://m.163.com/dy/article/KTN64E3E0556BN5T.html", "source": "网易", "snippet": "就在全球军事观察家仍在争论六代机标准之时,中国航空工业悄然交出了一份震撼答卷,2026年的天空并非平静无波。从西北大漠到东南沿海,多款神秘战机的试飞轨迹正在改写全球空中力量平衡,这背后隐藏的核心优势,远非大众热议的速度与隐身那么简单。\n打开网易新闻\n查看精彩图片\n传统航空发动机在高速冲刺与省油巡航之间长期无法两全,这一困扰航空界数十年的技术死结,如今已在中国科研人员手中迎刃而解。三涵道架构的变循环发动机,可根据飞行状态毫秒级切换工作模式,在超音速突防和亚音速巡航间任意转换,这一突破让战机心脏拥有了前所未有的适应能力。\n打开网易新闻\n查看精彩图片\n搭载全新变循环动力系统的六代机,航程有望突破一万公里大关,相关数据显示,新发动机高空推力提升47个百分点,燃油消耗降低近四成。这意味着战机无需空中加油就能横跨太平洋执行任务,美军精心构筑的岛链防御体系将面临直接冲击,空中力量的投射半径正在被重新定义。\n打开网易新闻\n查看精彩图片\n隐身技术从单一走向全面,六代机的隐身能力不再局限于雷达波段,而是覆盖全频段的全方位隐身,超材料薄膜与智能蒙皮技术的结合,让战机在红外探测和光学侦察面前同样难以捉摸。雷达散射截面积降至0.001平方米级别,比现役最先进五代机还要小一个数量级,这种级别的隐身性能,让对手的防御系统几乎无从下手。\n打开网易新闻\n查看精彩图片\n成都与沈阳两条技术路线的并行推进,展现了中国航空工业的体系化优势,成飞专注隐身突防,沈飞主攻高速高机动,双轨并进大幅降低了研发风险。十三个月内四架原型机接连升空,开创了边飞边改的高效验证模式,技术迭代速度远超传统单机试飞动辄数年的流程,这种研发效率本身就是一种战略优势。\n打开网易新闻\n查看精彩图片\n2026年开展的1架六代机搭配4架隐身忠诚僚机的编队实战演练,标志着有人无人协同作战从理论走向现实。六代机不再是孤军奋战的单打冠军,而是空中作战群", "date": "2026-05-24T16:31:12+08:00"}, {"title": "我国研发第六代战机,无尾三角翼战机,将搭载人工智能技术! - 今日头条", "url": "https://www.toutiao.com/video/7654744949317009926/", "source": "今日头条", "snippet": "展开我国研发第六代战机,无尾三角翼战机,将搭载人工智能技术!播放\n13发布于\n2026-06-30\n09:23", "date": "2026-06-30T09:23:00+08:00"}, {"title": "搜索: 六代机 | 南方周末", "url": "https://www.infzm.com/search?k=%E5%85%AD%E4%BB%A3%E6%9C%BA", "source": "www.infzm.com", "snippet": "“谁先研制出六代机,谁就能打破现有作战逻辑,让未来的空战形态、作战模式发生颠覆性转变。这堪比海军从战列舰时代走向航母时代,将彻底重构作战规则。”\n从外在上来看,六代机继承了五代机的隐身性能,但其明显的特点是尽量减少甚至取消垂直尾翼,从而减少雷达反射面积,在正面隐身性能方面做到登峰造极。\n新一代战机竞研的本质是定义权的争夺,“谁率先研发出可用的六代机,谁就将掌握下一代空战标准的制定权。”", "date": "2025-10-24T00:00:00+08:00"}, {"title": "韩国六代机无尾布局野心不小,可变循环发动机是其最大命门", "url": "https://c.m.163.com/news/a/L6DUBJOV05357FCK.html", "source": "网易新闻客户端", "snippet": "最近,综合人民网军事频道、DefenseMirror、Defence\nIndustry\nEurope、搜狐、中时新闻网等多家媒体报道,2026年8月21日,韩国国防采办计划管理局正式发布了一份“韩国下一代战斗机概念研究”的招标书。\n这个为期14个月、预算9亿韩元(约合65万美元)的项目,目标是定义下一代战机的作战概念、机体构型和技术路线图。这标志着韩国在KF-21“猎鹰”研发收官后,马不停蹄地启动了第六代战斗机的预研工作。招标书对性能的要求相当高:两种竞争性隐身构型,包括无尾设计和替代控制面;覆盖L、S、X波段的宽频段隐身;两台具备超音速巡航能力的自适应循环发动机;单座布局和内置弹舱。招标文件还要求承包方参考美国F-47、英日意GCAP等新一代战斗机项目,明确韩国下一代战斗机的作战半径、飞行速度、隐身水平及电子战能力等关键指标。韩国国防科学研究院在今年7月7日于大田举行的“航空航天会议2026”上,已经展示了一款内部研究的六代机设计概念。这是一款完全无尾、双发隐身战机,没有垂直或水平尾翼,采用双三角翼加鸭翼布局,机身与机翼融为一体。设计带有三个内置弹舱,中央弹舱可挂载四枚欧洲“流星”导弹,两侧各挂一枚IRIS-T导弹。根据导弹比例估算,这架飞机长约16米、翼展约11米,尺寸明显小于欧美同类六代机平台。据韩国媒体报道,韩国国防科学研究所已于2025年11月启动全尺寸隐身验证机研制计划,目标在4年内制造一架技术验证机,重点验证无尾布局气动特性及飞行控制技术。最大的难题是发动机。自适应循环发动机能在燃油经济性巡航和高推力超音速作战之间切换,是六代机的核心标志之一。韩国在战斗机发动机领域才刚刚起步,正在自研的KTF16000发动机属于传统涡扇发动机,与自适应循环存在代差。韩国尚未确定六代机是深度改进现有发动机,还是从零全新研发自适应动力系统。韩国启动六代机概念研究主要基于两方面考量", "date": "2026-09-09T22:43:00+08:00"}, {"title": "我国研发第六代战机,无尾三角翼战机,将搭载人工智能技术 - 今日头条", "url": "https://www.toutiao.com/video/7585558133867676187/", "source": "今日头条", "snippet": "展开我国研发第六代战机,无尾三角翼战机,将搭载人工智能技术播放\n231发布于\n2025-12-19\n21:19", "date": "2025-12-19T21:19:00+08:00"}, {"title": "韩国六代机无尾布局野心不小,可变循环发动机是其最大命门_腾讯新闻", "url": "https://news.qq.com/rain/a/20260909A0EZZM00", "source": "腾讯网", "snippet": "最近,综合人民网军事频道、DefenseMirror、Defence\nIndustry\nEurope、搜狐、中时新闻网等多家媒体报道,2026年8月21日,韩国国防采办计划管理局正式发布了一份“韩国下一代战斗机概念研究”的招标书。这个为期14个月、预算9亿韩元(约合65万美元)的项目,目标是定义下一代战机的作战概念、机体构型和技术路线图。这标志着韩国在KF-21“猎鹰”研发收官后,马不停蹄地启动了第六代战斗机的预研工作。招标书对性能的要求相当高:两种竞争性隐身构型,包括无尾设计和替代控制面;覆盖L、S、X波段的宽频段隐身;两台具备超音速巡航能力的自适应循环发动机;单座布局和内置弹舱。招标文件还要求承包方参考美国F-47、英日意GCAP等新一代战斗机项目,明确韩国下一代战斗机的作战半径、飞行速度、隐身水平及电子战能力等关键指标。韩国国防科学研究院在今年7月7日于大田举行的“航空航天会议2026”上,已经展示了一款内部研究的六代机设计概念。这是一款完全无尾、双发隐身战机,没有垂直或水平尾翼,采用双三角翼加鸭翼布局,机身与机翼融为一体。设计带有三个内置弹舱,中央弹舱可挂载四枚欧洲“流星”导弹,两侧各挂一枚IRIS-T导弹。根据导弹比例估算,这架飞机长约16米、翼展约11米,尺寸明显小于欧美同类六代机平台。据韩国媒体报道,韩国国防科学研究所已于2025年11月启动全尺寸隐身验证机研制计划,目标在4年内制造一架技术验证机,重点验证无尾布局气动特性及飞行控制技术。最大的难题是发动机。自适应循环发动机能在燃油经济性巡航和高推力超音速作战之间切换,是六代机的核心标志之一。韩国在战斗机发动机领域才刚刚起步,正在自研的KTF16000发动机属于传统涡扇发动机,与自适应循环存在代差。韩国尚未确定六代机是深度改进现有发动机,还是从零全新研发自适应动力系统。韩国启动六代机概念研究主要基于两方面考量。", "date": "2026-09-09T22:22:02+08:00"}, {"title": "解放军试飞的神秘战机是忠诚僚机吗 六代机研发新进展_军事频道_中华网", "url": "https://military.china.com/news/13004177/20250806/48697914_2.html", "source": "中华网军事", "snippet": "无论这款新机是有人六代机还是无人僚机,无论这款战机是西飞研制的还是西工大研制的,其亮相都印证了中国在六代机研发上的多路线并行策略。与美国的NGAD相比,中国已至少有三款验证机进入试飞阶段,技术迭代速度远超预期。中国已实现变循环+旋转爆震燃烧等颠覆性技术,六代机可能采用动态热隐身涂层和量子雷达,这都将彻底改变制空权争夺模式,使F-35、F-22的隐身优势荡然无存。综合现有信息,此次曝光的战机极可能是西工大主导的第六代舰载机,或与成飞联合开发的无人僚机系统。其无垂尾设计、高超音速潜力及隐身优化,标志着中国六代机研发已进入“体系化竞争”阶段。若最终确认为舰载型号,中国将成为全球首个部署六代舰载机的国家,进一步巩固西太平洋的制空权;若为无人作战飞机,则意味着中国在智能化空战领域已领先美国。西工大的技术突破表明,中国航空工业正从“追赶者”转变为“规则制定者”,而美国在六代机竞赛中,恐将首次面临被全面超越的危机。", "date": "2025-08-06T15:53:58+08:00"}], "extracted_facts": [{"content": "中华网军事报道称，2025年8月曝光的一款新机构型是中国几个月内出现的第三款六代机原型，此前已有歼-36、歼-50；三种完全不同的构型显示中国采取“多头竞标”的多技术路线并行策略，类似美国YF-22/YF-23竞标模式。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20250806/48694871_1.html", "credibility": 0.5}, {"content": "中华网军事称，新机外形与西北工业大学此前公开的变后掠舰载机设计方案高度相似：无垂尾、翼尖向后斜切、双发喷口隐蔽、尾部锯齿状结构、机腹内弹舱；若确为变后掠翼设计，则舰载型可能性更大。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20250806/48694871_1.html", "credibility": 0.5}, {"content": "中华网军事文章称，与美NGAD相比，中国已至少有三款验证机进入试飞阶段，技术迭代速度超预期；并称中国已实现变循环+旋转爆震燃烧等颠覆性技术，六代机可能采用动态热隐身涂层和量子雷达。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20250806/48697914_2.html", "credibility": 0.4}, {"content": "网易自媒体文章称，中国三涵道架构变循环发动机可毫秒级切换工作模式，高空推力提升47%、燃油消耗降低近四成，使六代机航程突破1万公里；隐身方面采用超材料薄膜与智能蒙皮，实现全频段（含红外、光学）隐身，雷达散射截面积降至0.001平方米级；成都与沈阳两条技术路线并行推进。", "source_name": "网易（自媒体号）", "source_url": "https://m.163.com/dy/article/KTN64E3E0556BN5T.html", "credibility": 0.2}, {"content": "南方周末文章指出，六代机继承五代机隐身性能，但显著特征是尽量减少甚至取消垂直尾翼以降低雷达反射面积，在正面隐身方面做到极致；新一代战机竞研的本质是空战标准“定义权”的争夺。", "source_name": "南方周末", "source_url": "https://www.infzm.com/search?k=%E5%85%AD%E4%BB%A3%E6%9C%BA", "credibility": 0.75}, {"content": "韩国国防采办计划管理局（DAPA）于2026年8月21日发布“韩国下一代战斗机概念研究”招标书，为期14个月、预算9亿韩元（约65万美元），要求提出两种竞争性隐身构型（含无尾设计与替代控制面）、覆盖L/S/X波段的宽频隐身、两台具备超音速巡航能力的自适应循环发动机、单座布局与内置弹舱，并要求参考美国F-47与英日意GCAP项目。", "source_name": "网易新闻客户端/腾讯新闻（综合人民网军事、DefenseMirror等）", "source_url": "https://c.m.163.com/news/a/L6DUBJOV05357FCK.html", "credibility": 0.6}, {"content": "韩国国防科学研究院（ADD）在2026年7月7日“航空航天会议2026”上展示内部研究的六代机概念：完全无尾、双发隐身、双三角翼加鸭翼、机身机翼融合、三个内置弹舱（中央挂4枚“流星”，两侧各1枚IRIS-T），估算机长约16米、翼展约11米；并已于2025年11月启动全尺寸隐身验证机研制计划。", "source_name": "腾讯新闻（转引韩媒）", "source_url": "https://news.qq.com/rain/a/20260909A0EZZM00", "credibility": 0.6}, {"content": "多条自媒体视频以“无尾飞翼、智能协同”“无尾三角翼+人工智能技术”为标题报道中国六代机进展，但正文/摘要无具体技术参数或可核查来源。", "source_name": "网易视频/今日头条", "source_url": "https://m.163.com/v/video/VRIAOHTSU.html", "credibility": 0.2}], "data_points": [{"name": "公开曝光的六代机构型数量", "value": "3", "unit": "款", "year": 2025, "source": "中华网军事"}, {"name": "进入试飞阶段的验证机数量", "value": "≥3", "unit": "款", "year": 2025, "source": "中华网军事"}, {"name": "变循环发动机高空推力提升", "value": "47", "unit": "%", "year": 2026, "source": "网易（自媒体号）"}, {"name": "燃油消耗降低", "value": "约40", "unit": "%", "year": 2026, "source": "网易（自媒体号）"}, {"name": "六代机航程", "value": "10000+", "unit": "km", "year": 2026, "source": "网易（自媒体号）"}, {"name": "雷达散射截面积", "value": "0.001", "unit": "m²", "year": 2026, "source": "网易（自媒体号）"}, {"name": "概念研究周期", "value": "14", "unit": "个月", "year": 2026, "source": "网易新闻客户端/腾讯新闻（综合人民网军事、DefenseMirror等）"}, {"name": "概念研究预算", "value": "9", "unit": "亿韩元", "year": 2026, "source": "网易新闻客户端/腾讯新闻（综合人民网军事、DefenseMirror等）"}, {"name": "预算折合美元", "value": "约65", "unit": "万美元", "year": 2026, "source": "网易新闻客户端/腾讯新闻（综合人民网军事、DefenseMirror等）"}, {"name": "概念机长度", "value": "约16", "unit": "米", "year": 2026, "source": "腾讯新闻（转引韩媒）"}]}}

