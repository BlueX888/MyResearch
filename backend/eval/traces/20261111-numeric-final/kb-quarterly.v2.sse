data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T16:25:52.338771", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述航空装备整机市场规模、增速及中航成飞在军机整机领域的市场地位，为分析2025年季度营业收入分布提供行业背景。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 季度营业收入 航空装备 整机 市场规模 增速"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述国内军机整机主要主机厂竞争格局、中航成飞核心产品定位及订单获取能力，分析其对季度营收分布的影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 军机 整机 主机厂 竞争格局 订单 交付"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述航空制造数字化装配、隐身技术、试飞交付等核心技术趋势，分析技术成熟度和产能释放对季度收入确认的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 航空制造 数字化装配 隐身 技术 产能 交付"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、装备采购政策、军工央企改革等政策环境，分析政策变化对中航成飞2025年营收节奏和季度分布的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["2025 国防预算 装备采购 军工央企改革 中航成飞 政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述中航成飞面临的交付节奏、供应链配套、产能爬坡等挑战，以及新型号放量、军贸拓展等机遇，分析其对季度营收高低点的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 交付节奏 供应链 产能 军贸 机遇 挑战"]}, {"id": "sec_6", "title": "未来展望", "description": "描述中航成飞2025年及后续季度营业收入分布趋势，判断哪个季度可能最高及季节性特征是否延续。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 各季度 营业收入 分布 最高 季度 趋势"]}], "research_questions": ["中航成飞2025年各季度营业收入具体数值及占比如何？", "中航成飞2025年哪个季度营业收入最高，主要驱动因素是什么？", "中航成飞季度营收分布受交付节奏、订单确认和政策哪些因素影响，未来趋势如何？"]}}

