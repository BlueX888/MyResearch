data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T16:35:30.130291", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'], 'Revenue': [3308640285.35, 17393488964.30, 27584043546.48, 27072785205.73]}\ndf = pd.DataFrame(data)\ndf['Revenue'] = pd.to_numeric(df['Revenue'], errors='coerce')\ndf = df.dropna()\ndf['Revenue_yi'] = df['Revenue'] / 1e8\ntotal = df['Revenue_yi'].sum()\ndf['Share'] = df['Revenue_yi'] / total * 100\ndf['QoQ'] = df['Revenue_yi'].pct_change() * 100\ntop = df.loc[df['Revenue_yi'].idxmax()]\nprint(df)\nprint('全年合计(亿元): %.2f' % total)\nprint('最高季度: %s, %.2f亿元, 占比%.2f%%' % (top['Quarter'], top['Revenue_yi'], top['Share']))\nprint('Q1占比仅%.2f%%, 下半年(Q3+Q4)占比%.2f%%' % (df.loc[0, 'Share'], df.loc[2, 'Share'] + df.loc[3, 'Share']))\ncolors = ['#a5b4fc', '#6366f1', '#10b981', '#06b6d4']\nplt.figure(figsize=(12, 7), dpi=200)\nbars = plt.bar(df['Quarter'], df['Revenue_yi'], color=colors, width=0.6, edgecolor='white')\nfor b, v, s in zip(bars, df['Revenue_yi'], df['Share']):\n    plt.text(b.get_x() + b.get_width() / 2, v + 5, '%.2f亿元\\n(%.1f%%)' % (v, s), ha='center', va='bottom', fontsize=12, fontweight='bold')\nplt.axhline(df['Revenue_yi'].mean(), color='#ef4444', linestyle='--', linewidth=1.8, label='季度均值 %.2f亿元' % df['Revenue_yi'].mean())\nplt.title('中航成飞2025年各季度营业收入分布', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, df['Revenue_yi'].max() * 1.22)\nplt.legend(fontsize=12, loc='upper left')\nplt.grid(True, linestyle='--', alpha=0.3, axis='y')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "提取2025年四个季度营业收入数据，统一转换为亿元并做类型清洗，计算合计、季度占比、环比增速与最高季度等关键指标，最后用柱状图（含数值标签与占比标注）展示季度分布，突出最高季度。"}}

