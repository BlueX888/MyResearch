data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T16:35:46.219294", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'Quarter': ['2025Q1', '2025Q2', '2025Q3', '2025Q4'], '单季度营业收入': [33.09, 173.93, 275.84, 270.73], '累计营业收入': [33.09, 207.02, 482.86, 753.59]}\ndf = pd.DataFrame(data)\nx = np.arange(len(df['Quarter']))\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(x, df['单季度营业收入'], marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='单季度营业收入')\nplt.fill_between(x, df['单季度营业收入'], alpha=0.15, color='#6366f1')\nplt.plot(x, df['累计营业收入'], marker='s', markersize=8, linewidth=2.5, color='#f59e0b', label='累计营业收入')\nplt.fill_between(x, df['累计营业收入'], alpha=0.12, color='#f59e0b')\nfor i, v in enumerate(df['单季度营业收入']):\n    plt.text(i, v + 18, f'{v:.2f}亿', ha='center', fontsize=11, color='#4338ca', fontweight='bold')\nfor i, v in enumerate(df['累计营业收入']):\n    plt.text(i, v + 18, f'{v:.2f}亿', ha='center', fontsize=11, color='#b45309', fontweight='bold')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('报告期（2025年分季度）', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(x, df['Quarter'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 860)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left', frameon=True)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

