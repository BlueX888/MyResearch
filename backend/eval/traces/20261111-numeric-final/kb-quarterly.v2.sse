data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T16:41:35.440223", "content": {"results": [{"id": "fact_f8f61c43", "title": "公司2025年度利润分配预案为以总股本267,209.14万股为基数，每10股派发现金红利3.86元（含税），不送红股、不转增，体现当期盈利与现金流分配能力。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司2025年度利润分配预案为以总股本267,209.14万股为基数，每10股派发现金红利3.86元（含税），不送红股、不转增，体现当期盈利与现金流分配能力。", "date": "", "isSupplementary": true}, {"id": "fact_94e587d5", "title": "中国航空工业集团有限公司持股78.66%（2,101,738,612股），为国有法人控股股东；汉中汉航机电（5.75%）、汉中航空工业集团（5.29%）同受航空...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中国航空工业集团有限公司持股78.66%（2,101,738,612股），为国有法人控股股东；汉中汉航机电（5.75%）、汉中航空工业集团（5.29%）同受航空工业集团控制，股权结构稳定，控股股东背景构成订单与产能获取的体制性支撑。", "date": "", "isSupplementary": true}, {"id": "fact_337aca25", "title": "中航成飞2025年年度报告摘要中“重要事项”章节内容为“无”，未包含挑战与机遇相关分析或说明。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年年度报告摘要中“重要事项”章节内容为“无”，未包含挑战与机遇相关分析或说明。", "date": "", "isSupplementary": true}, {"id": "fact_183af4e0", "title": "年度报告摘要中未出现“挑战机遇”或类似章节标题，仅提示投资者应到证监会指定媒体阅读年度报告全文以了解未来发展规划。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "年度报告摘要中未出现“挑战机遇”或类似章节标题，仅提示投资者应到证监会指定媒体阅读年度报告全文以了解未来发展规划。", "date": "", "isSupplementary": true}, {"id": "fact_ed203e76", "title": "年度报告摘要披露公司2025年基本每股收益为1.2845元/股，上年同期为0.19元/股，同比变化6.46%。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "年度报告摘要披露公司2025年基本每股收益为1.2845元/股，上年同期为0.19元/股，同比变化6.46%。", "date": "", "isSupplementary": true}, {"id": "fact_b7411f20", "title": "年度报告摘要披露公司2025年加权平均净资产收益率为26.76%，上年同期为4.60%，同比变化-3.58个百分点。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "年度报告摘要披露公司2025年加权平均净资产收益率为26.76%，上年同期为4.60%，同比变化-3.58个百分点。", "date": "", "isSupplementary": true}, {"id": "fact_4fe25d1b", "title": "年度报告摘要披露公司总股本为267,209.14万股，利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，转增0股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "年度报告摘要披露公司总股本为267,209.14万股，利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_f6396b06", "title": "中航成飞2025年实现营业收入753.59亿元，较调整后的2024年营业收入650.55亿元增长15.84%。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年实现营业收入753.59亿元，较调整后的2024年营业收入650.55亿元增长15.84%。", "date": "", "isSupplementary": true}, {"id": "fact_b54a8b54", "title": "中航成飞2025年归属于上市公司股东的净利润为34.32亿元，同比增长6.47%；归属于上市公司股东的净资产为212.09亿元，同比增长9.15%。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年归属于上市公司股东的净利润为34.32亿元，同比增长6.47%；归属于上市公司股东的净资产为212.09亿元，同比增长9.15%。", "date": "", "isSupplementary": true}, {"id": "fact_b4c383d0", "title": "中航成飞2025年末总资产为1145.48亿元，较上年末调整后增长6.16%。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年末总资产为1145.48亿元，较上年末调整后增长6.16%。", "date": "", "isSupplementary": true}, {"id": "fact_578fdcd2", "title": "中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，属于航空工业集团控股的军工央企上市平台。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，属于航空工业集团控股的军工央企上市平台。", "date": "", "isSupplementary": true}, {"id": "fact_ea76d415", "title": "中国航空工业集团有限公司持有中航成飞78.66%股份（2,101,738,612股），为公司控股股东，公司实际控制人为中国航空工业集团有限公司。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中国航空工业集团有限公司持有中航成飞78.66%股份（2,101,738,612股），为公司控股股东，公司实际控制人为中国航空工业集团有限公司。", "date": "", "isSupplementary": true}, {"id": "fact_57002fd5", "title": "中航成飞2025年度利润分配预案为：以总股本267,209.14万股为基数，每10股派发现金红利3.86元（含税），不送红股、不转增。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度利润分配预案为：以总股本267,209.14万股为基数，每10股派发现金红利3.86元（含税），不送红股、不转增。", "date": "", "isSupplementary": true}, {"id": "fact_0020afb0", "title": "中航成飞2025年年度报告摘要中不含“未来展望/经营计划”章节，摘要明确指引投资者到证监会指定媒体阅读年度报告全文以了解公司未来发展规划，说明未来展望内容仅存在...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年年度报告摘要中不含“未来展望/经营计划”章节，摘要明确指引投资者到证监会指定媒体阅读年度报告全文以了解公司未来发展规划，说明未来展望内容仅存在于年报全文中，摘要本身缺失该章节。", "date": "", "isSupplementary": true}, {"id": "fact_54677ff3", "title": "该年度报告摘要的章节结构为：一、重要提示；二、公司基本情况（公司简介、主要业务或产品简介、主要会计数据和财务指标、股本及股东情况）；三、重要事项。全文未设置“未...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "该年度报告摘要的章节结构为：一、重要提示；二、公司基本情况（公司简介、主要业务或产品简介、主要会计数据和财务指标、股本及股东情况）；三、重要事项。全文未设置“未来展望”“经营计划”“发展战略”等章节，印证未来展望章节在摘要中完全缺失。", "date": "", "isSupplementary": true}, {"id": "fact_bfeac5b1", "title": "摘要“重要事项”章节披露为“无”，即摘要层面未披露任何重大事项，也未包含前瞻性经营计划或未来展望内容。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "摘要“重要事项”章节披露为“无”，即摘要层面未披露任何重大事项，也未包含前瞻性经营计划或未来展望内容。", "date": "", "isSupplementary": true}, {"id": "fact_e848d3b8", "title": "摘要披露公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，可作为未来展望缺失情况下的业务定位替代信息...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "摘要披露公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，可作为未来展望缺失情况下的业务定位替代信息。", "date": "", "isSupplementary": true}, {"id": "fact_74d55bd0", "title": "摘要披露2025年末总资产为114,547,703,019.42元，较上年末调整后增长6.16%，但未提供分季度营业收入数据，无法据此回答各季度收入分布问题。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "摘要披露2025年末总资产为114,547,703,019.42元，较上年末调整后增长6.16%，但未提供分季度营业收入数据，无法据此回答各季度收入分布问题。", "date": "", "isSupplementary": true}, {"id": "fact_4cf1c92c", "title": "摘要披露利润分配预案：以总股本267,209.14万股为基数，每10股派发现金红利3.86元（含税），不送红股、不转增，属于报告期已确定事项而非未来展望。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "摘要披露利润分配预案：以总股本267,209.14万股为基数，每10股派发现金红利3.86元（含税），不送红股、不转增，属于报告期已确定事项而非未来展望。", "date": "", "isSupplementary": true}, {"id": "fact_8df62e25", "title": "摘要披露大信会计师事务所对公司2025年度财务报告出具标准无保留意见审计意见，且公司报告期无优先股股东持股情况、无存续债券情况。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "摘要披露大信会计师事务所对公司2025年度财务报告出具标准无保留意见审计意见，且公司报告期无优先股股东持股情况、无存续债券情况。", "date": "", "isSupplementary": true}]}}

