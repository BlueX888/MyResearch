data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:36:41.681494", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Quarter': ['2025Q1', '2025Q2', '2025Q3', '2025Q4'],\n    'Revenue': [33.09, 173.93, 275.84, 270.73],\n    'NetProfit': [1.56, 7.56, 12.56, 12.63]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Quarter':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nfig, ax1 = plt.subplots(figsize=(12, 7), dpi=200)\nbars = ax1.bar(df['Quarter'], df['Revenue'], color='#6366f1', alpha=0.85, width=0.55, label='营业收入')\nfor b, v in zip(bars, df['Revenue']):\n    ax1.text(b.get_x() + b.get_width() / 2, v + 6, f'{v:.1f}', ha='center', fontsize=12, fontweight='bold', color='#4338ca')\nax1.set_xlabel('2025年季度', fontsize=14)\nax1.set_ylabel('营业收入（亿元）', fontsize=14, color='#4338ca')\nax1.tick_params(labelsize=12)\nax1.grid(True, linestyle='--', alpha=0.3)\nax2 = ax1.twinx()\nax2.plot(df['Quarter'], df['NetProfit'], color='#10b981', linewidth=2.5, marker='o', markersize=8, label='归母净利润')\nfor x, y in zip(df['Quarter'], df['NetProfit']):\n    ax2.text(x, y + 0.6, f'{y:.2f}', ha='center', fontsize=12, fontweight='bold', color='#047857')\nax2.set_ylabel('归母净利润（亿元）', fontsize=14, color='#10b981')\nax2.tick_params(labelsize=12)\nplt.title('中航成飞2025年季度业绩与年度利润分配预案', fontsize=18, fontweight='bold', pad=20)\nfig.text(0.5, 0.015, '分配预案：每10股派现3.86元（含税）｜送红股0股｜资本公积转增0股｜基数267,209.14万股｜合计派现约10.31亿元', ha='center', fontsize=12, color='#334155')\nsns.despine()\nplt.tight_layout(rect=[0, 0.05, 1, 1])\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦2025年度利润分配预案这一核心问题：先提取预案三项关键参数（每10股派现3.86元含税、送红股0股、资本公积转增0股）与分配基数（总股本267,209.14万股），据此测算现金分红总额约10.31亿元；再结合2025年四个季度的营业收入与归母净利润，用双轴组合图展示业绩节奏，并在图下方标注分红预案要点，形成“业绩—回报”一体的专业可视化。"}}

