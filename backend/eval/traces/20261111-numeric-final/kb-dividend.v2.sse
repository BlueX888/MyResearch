data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:36:56.034660", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'季度': ['2025Q1', '2025Q2', '2025Q3'], '现金流量净额': [20.93, -97.57, 36.32]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx_pos = np.arange(len(df))\ny = df['现金流量净额'].values\nplt.plot(x_pos, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='经营活动现金流量净额')\nplt.fill_between(x_pos, y, alpha=0.15, color='#6366f1')\nplt.axhline(0, color='#94a3b8', linewidth=1, linestyle='--')\nfor i, v in enumerate(y):\n    offset = 6 if v >= 0 else -12\n    plt.text(i, v + offset, f'{v:.2f}', ha='center', fontsize=11, fontweight='bold', color='#1e293b')\nplt.title('公司盈利与分配基础分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('报告期', fontsize=14)\nplt.ylabel('经营活动现金流量净额（亿元）', fontsize=14)\nplt.xticks(x_pos, df['季度'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper right')\nplt.text(0.02, 0.04, '加权平均ROE：26.76%\\n营业收入同比增速：15.84%\\n归母净利润同比增速：6.47%\\n总股本：267,209.14万股\\n归母净资产：212.09亿元', transform=plt.gca().transAxes, fontsize=11, va='bottom', ha='left', bbox=dict(boxstyle='round,pad=0.5', facecolor='#f1f5f9', edgecolor='#cbd5e1', alpha=0.9))\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 公司盈利与分配基础"}}

