data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T15:27:09.074997", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "公司盈利与分配基础", "description": "梳理中航成飞2025年营业收入、净利润、未分配利润、经营现金流等利润分配基础数据，判断可分红的利润来源和现金能力。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 年报 净利润 未分配利润 经营现金流"]}, {"id": "sec_2", "title": "利润分配预案核心内容", "description": "核查中航成飞2025年度利润分配预案的分配方式、每股派息、现金分红总额、分红比例、送转安排及董事会和股东大会审议程序。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025年度 利润分配预案 公告 每股派息 现金分红"]}, {"id": "sec_3", "title": "历史分红与同业比较", "description": "对比中航成飞近年分红率、股息率、分红连续性与航空制造同业分红政策，判断2025年度预案的连续性和合理性。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 历史分红 分红率 股息率 航空制造 分红对比"]}, {"id": "sec_4", "title": "监管与国企分红政策", "description": "分析证监会现金分红新规、国资委国企市值管理和股东回报要求对中航成飞2025年度利润分配预案的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["上市公司 现金分红 新规 国资委 国企 分红 市值管理 2025"]}, {"id": "sec_5", "title": "影响因素与挑战", "description": "评估盈利波动、资本开支、研发投入、现金流约束与股东回报平衡等因素对中航成飞2025年度利润分配预案的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 资本开支 研发投入 现金流 分红 约束"]}, {"id": "sec_6", "title": "未来展望与验证", "description": "跟踪中航成飞2025年度利润分配预案披露、股东大会审议和后续实施进展，判断未来分红政策趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025年度 利润分配 实施 公告 股东大会"]}], "research_questions": ["中航成飞2025年度利润分配预案的具体分配方式、每股派息和现金分红总额是多少？", "公司2025年净利润、未分配利润和经营现金流是否支撑该利润分配预案？", "该预案与公司历史分红率、航空制造同业水平及监管政策要求相比是否合理？"]}}

