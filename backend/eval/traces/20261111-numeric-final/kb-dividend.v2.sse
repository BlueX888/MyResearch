data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:37:03.812580", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['2025Q1', '2025Q2', '2025Q3'], 'CashFlow': [20.93, -97.57, 36.32]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nxpos = np.arange(len(df['Quarter']))\ny = df['CashFlow'].values\nplt.plot(xpos, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='经营活动现金流量净额')\nplt.fill_between(xpos, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    offset = 4 if v >= 0 else -9\n    plt.text(i, v + offset, f'{v:.2f}亿元', ha='center', fontsize=11, fontweight='bold', color='#1e293b')\nplt.axhline(0, color='#94a3b8', linewidth=1, linestyle='--', alpha=0.6)\nplt.title('利润分配预案核心内容分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('报告期', fontsize=14)\nplt.ylabel('经营活动现金流量净额（亿元）', fontsize=14)\nplt.xticks(xpos, df['Quarter'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper right')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 利润分配预案核心内容"}}

