data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T15:42:43.417407", "content": {"results": [{"id": "fact_c63300ec", "title": "中航成飞董事会审议通过的2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞董事会审议通过的2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": false}, {"id": "fact_94eeea37", "title": "按上述预案测算，现金分红总额约为1,031,427,280.4元（267,209.14万股×0.386元/股），即约10.31亿元；该数值为根据公告披露的总股本...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "按上述预案测算，现金分红总额约为1,031,427,280.4元（267,209.14万股×0.386元/股），即约10.31亿元；该数值为根据公告披露的总股本和每10股派息额计算，公告片段未直接披露现金分红总额。", "date": "", "isSupplementary": false}, {"id": "fact_1080f069", "title": "该利润分配预案不涉及优先股利润分配，董事会决议通过的本报告期优先股利润分配预案为不适用。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "该利润分配预案不涉及优先股利润分配，董事会决议通过的本报告期优先股利润分配预案为不适用。", "date": "", "isSupplementary": false}, {"id": "fact_ffd044df", "title": "2025年末公司总资产为114,547,703,019.42元，较2024年末调整后107,905,965,442.13元增长6.16%。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "2025年末公司总资产为114,547,703,019.42元，较2024年末调整后107,905,965,442.13元增长6.16%。", "date": "", "isSupplementary": false}, {"id": "fact_d23f3380", "title": "公司控股股东为中国航空工业集团有限公司，持股比例78.66%，股东性质为国有法人。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司控股股东为中国航空工业集团有限公司，持股比例78.66%，股东性质为国有法人。", "date": "", "isSupplementary": false}, {"id": "fact_88e1c0c9", "title": "公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_bc078947", "title": "中航成飞2025年度利润分配预案为：每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度利润分配预案为：每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_340754ba", "title": "中航成飞董事会决议通过的本报告期优先股利润分配预案为不适用（公司无优先股）。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞董事会决议通过的本报告期优先股利润分配预案为不适用（公司无优先股）。", "date": "", "isSupplementary": true}, {"id": "fact_6e82c470", "title": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf，公告编号2026-009）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。该预案经本次董事会审议通过。", "date": "", "isSupplementary": true}, {"id": "fact_cea40210", "title": "中航成飞2025年度报告期内不存在优先股利润分配预案（董事会决议通过的本报告期优先股利润分配预案为“不适用”），公司报告期无优先股股东持股情况。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度报告期内不存在优先股利润分配预案（董事会决议通过的本报告期优先股利润分配预案为“不适用”），公司报告期无优先股股东持股情况。", "date": "", "isSupplementary": true}, {"id": "fact_ba5087c8", "title": "中航成飞控股股东为中国航空工业集团有限公司，持股78.66%（2,101,738,612股），其中有限售条件股份2,086,021,877股；汉中汉航机电有限公...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞控股股东为中国航空工业集团有限公司，持股78.66%（2,101,738,612股），其中有限售条件股份2,086,021,877股；汉中汉航机电有限公司持股5.75%、汉中航空工业（集团）有限公司持股5.29%、中国航空科技工业股份有限公司持股0.26%，上述股东实际控制人同为中国航空工业集团有限公司。该股权结构决定了现金分红的主要受益方为航空工业集团体系。", "date": "", "isSupplementary": true}, {"id": "fact_5b13a639", "title": "中航成飞2025年末总资产为114,547,703,019.42元，较2024年末调整后107,905,965,442.13元增长6.16%（追溯调整原因为同一...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年末总资产为114,547,703,019.42元，较2024年末调整后107,905,965,442.13元增长6.16%（追溯调整原因为同一控制下企业合并）。该规模数据可作为与同业可比公司体量对比的参照，但搜索结果未提供同业分红率、股息率数据。", "date": "", "isSupplementary": true}, {"id": "fact_6b362a1d", "title": "中航成飞2025年度利润分配预案：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf，公告编号2026-009）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度利润分配预案：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_30048ebe", "title": "该利润分配预案已由董事会审议通过，属于“董事会审议的报告期利润分配预案或公积金转增股本预案”，且公司上市时已盈利（“公司上市时未盈利且目前未实现盈利”项为不适用...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "该利润分配预案已由董事会审议通过，属于“董事会审议的报告期利润分配预案或公积金转增股本预案”，且公司上市时已盈利（“公司上市时未盈利且目前未实现盈利”项为不适用）。", "date": "", "isSupplementary": true}, {"id": "fact_6089d2f3", "title": "公司本报告期无优先股利润分配预案（优先股利润分配预案项为“不适用”），报告期亦无优先股股东持股。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司本报告期无优先股利润分配预案（优先股利润分配预案项为“不适用”），报告期亦无优先股股东持股。", "date": "", "isSupplementary": true}, {"id": "fact_c2756a13", "title": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_8d9bf24e", "title": "中航成飞2025年度利润分配预案为：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度利润分配预案为：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_0743fe64", "title": "中航成飞2025年度优先股利润分配预案为不适用。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度优先股利润分配预案为不适用。", "date": "", "isSupplementary": true}, {"id": "fact_38d11600", "title": "中航成飞2025年归属于上市公司股东的净利润为3,432,289,851.96元；2024年调整后归属于上市公司股东的净利润为3,223,753,233.81元...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年归属于上市公司股东的净利润为3,432,289,851.96元；2024年调整后归属于上市公司股东的净利润为3,223,753,233.81元；2023年调整后数据在搜索结果中不完整（显示为2,725,603,14 7.）。", "date": "", "isSupplementary": true}, {"id": "fact_51d6ba3c", "title": "中国航空工业集团有限公司持有中航成飞78.66%股份，持股数量为2,101,738,612股，可用于估算总股本以计算分红率。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中国航空工业集团有限公司持有中航成飞78.66%股份，持股数量为2,101,738,612股，可用于估算总股本以计算分红率。", "date": "", "isSupplementary": true}]}}

