data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-11T00:15:04.315945", "content": {"graph": {"nodes": [{"id": "node_0", "name": "成飞（成都飞机工业集团）", "type": "company", "discovered_at": "2026-11-11T00:15:04.315741"}, {"id": "node_1", "name": "沈飞（沈阳飞机工业集团）", "type": "company", "discovered_at": "2026-11-11T00:15:04.315755"}, {"id": "node_2", "name": "翼龙系列无人机", "type": "technology", "discovered_at": "2026-11-11T00:15:04.315765"}, {"id": "node_3", "name": "暗剑无人机", "type": "technology", "discovered_at": "2026-11-11T00:15:04.315774"}, {"id": "node_4", "name": "彩虹系列无人机", "type": "technology", "discovered_at": "2026-11-11T00:15:04.315783"}, {"id": "node_5", "name": "中航无人机（中航（成都）无人机系统股份有限公司）", "type": "company", "discovered_at": "2026-11-11T00:15:04.315791"}, {"id": "node_6", "name": "中国航空无线电电子研究所", "type": "company", "discovered_at": "2026-11-11T00:15:04.315797"}, {"id": "node_7", "name": "歼-20", "type": "technology", "discovered_at": "2026-11-11T00:15:04.315803"}, {"id": "node_8", "name": "忠诚僚机作战概念", "type": "technology", "discovered_at": "2026-11-11T00:15:04.315809"}], "edges": [{"source": "成飞（成都飞机工业集团）", "relation": "翼龙系列察打一体无人机的产业关联方（待核实）", "discovered_at": "2026-11-11T00:15:04.315747"}, {"source": "成飞（成都飞机工业集团）", "relation": "歼-20研制单位", "discovered_at": "2026-11-11T00:15:04.315750"}, {"source": "沈飞（沈阳飞机工业集团）", "relation": "暗剑隐身无人机（待核实）", "discovered_at": "2026-11-11T00:15:04.315758"}, {"source": "沈飞（沈阳飞机工业集团）", "relation": "歼-20协同作战概念关联", "discovered_at": "2026-11-11T00:15:04.315761"}, {"source": "翼龙系列无人机", "relation": "察打一体无人机代表产品", "discovered_at": "2026-11-11T00:15:04.315768"}, {"source": "翼龙系列无人机", "relation": "外贸出口主力（待核实）", "discovered_at": "2026-11-11T00:15:04.315771"}, {"source": "暗剑无人机", "relation": "隐身无人作战飞机概念", "discovered_at": "2026-11-11T00:15:04.315777"}, {"source": "暗剑无人机", "relation": "与歼-20有人/无人协同", "discovered_at": "2026-11-11T00:15:04.315780"}, {"source": "彩虹系列无人机", "relation": "航天彩虹，与成飞形成外贸竞品关系", "discovered_at": "2026-11-11T00:15:04.315787"}, {"source": "中航无人机（中航（成都）无人机系统股份有限公司）", "relation": "翼龙系列产业化平台（待核实）", "discovered_at": "2026-11-11T00:15:04.315794"}, {"source": "中国航空无线电电子研究所", "relation": "忠诚僚机/有人无人协同技术研究", "discovered_at": "2026-11-11T00:15:04.315800"}, {"source": "歼-20", "relation": "有人机平台，与隐身无人机协同", "discovered_at": "2026-11-11T00:15:04.315806"}, {"source": "忠诚僚机作战概念", "relation": "有人/无人协同作战", "discovered_at": "2026-11-11T00:15:04.315812"}, {"source": "忠诚僚机作战概念", "relation": "任务管理与分配技术", "discovered_at": "2026-11-11T00:15:04.315815"}]}, "stats": {"entitiesCount": 9, "relationsCount": 14}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-11T00:15:04.316067", "content": {"agent": "DeepScout", "section": "技术趋势", "facts_count": 6, "duplicates_removed": 0, "data_points_count": 0, "insights": ["本轮搜索结果与“成飞 vs 沈飞无人机布局差异”这一核心问题匹配度极低：10条结果中约6条为题库、输入法词库、网络小说、AI短视频等无关内容，属于严重噪声。", "唯一与沈飞隐身无人机方向相关的线索是2018年新浪军事关于“暗剑”的报道，但该报道表述含混（“研发人员沈飞”可能指人名），且为8年前的一般新闻，不能作为技术路线判断的可靠依据。", "翼龙系列作为中国察打一体无人机代表产品被多方提及（人民网、期刊摘要），但搜索结果均未明确其研制主体为成飞，也未涉及中航无人机这一产业化/外贸平台，假设h_2的关键链条（成飞—翼龙—中航无人机—出口领先）尚未被证据打通。"], "source_quality": "整体来源质量很低（加权可信度约0.4）。10条结果中仅1条学术来源（科研之友转载，0.75）、1条央媒（人民网，0.7，但信息量极低）、1条一般新闻（新浪军事，0.45，2018年旧闻且表述含混）、1条期刊摘要（0.5）、1条低质转载平台（豆丁，0.55），其余6条为题库、词库、网络小说、自媒体短视频等完全无关内容。无官方来源（政府/央企公告）、无券商或咨询行业报告、无原始统计数据。本轮检索无法为研究假设提供有效支撑，需重新构造检索式并优先获取招股说明书、SIPRI数据库、央企年报与专利数据。", "hypothesis_updates": 3, "search_results": [{"title": "无人机也称为无人飞行器,按照飞行方式可分为固定翼、__________________、及扑翼无人机。 - 上学吧找答案", "url": "https://m.shangxueba.com/ask/20228409.html", "source": "上学吧", "snippet": "A、一种基于捕食逃逸鸽群优化的多无人飞行器编队协调控制方法B、飞行器编队的控制方法、装置及控制器C、一种防止机间碰撞的固定翼无人机编队的控制方法D、基于视觉的无人机编队飞行控制方法", "date": "2025-11-13T02:08:59+08:00"}, {"title": "有人机_无人机协同概念及相关技术 - 豆丁网", "url": "https://www.docin.com/p-1268173477.html", "source": "豆丁网", "snippet": "CooperativeOperationUnmannedAerialVehicles[J].TelecommunicationEngineering,2014,54空军装备部,北京100081中国西南电子技术研究所,成都610036无人机协同作战概念和若干技术问题展开研究。首先从协同对象、协同层次、协同阶段、任务类型等四个方面分析了有人机无人机协同概念,然后对协同控制系统研制涉及的通用开放式架构、机间智能通信网络、有人机无人机协同控制、多传感器协同信息处理等技术进行了探讨,最后提出了发展建议,期望为后续研究提供一定的参考。关键词:有人机;无人机;协同作战;协同控制中图分类号:TN915.03文献标志码:文章编号:1001893X(2014)1205ConceptRelevantTechnologiesCooperativeOperationUnmannVehiclesGAOXia,XIONGJianEquipmentDepartmentAirForce,Beijing100081,China;westChinaInstituteElectronicTechnology,Chengdu610036,China)Abstract:paperdiscussescooperativeoperationalconceptseveraltechnicalinsordataprocessing.Finally,givessomesuggestionsprovidingsomevaluablereferencesfurtherresearchesarea.Keywords:mannedaerialvhicle;unmannedaerialvehicle;cooperativeoperation;coordinatedcontrol并通过飞行试验验证有人机控制无人机的可行性、有效性和实用性。", "date": "2015-08-23T05:23:13+08:00"}, {"title": "“忠诚僚机”式有人/无人机协同作战概念与任务管理技术研究  科研之友", "url": "https://www.scholarmate.com/S/qYUesV", "source": "www.scholarmate.com", "snippet": "\"忠诚僚机\"式作战概念定义了有人机与无人机协同作战的新理念,颠覆了传统作战模式。在有人/无人机协同作战过程中,有人机以指挥者的角色,对作战任务进行分解、分配与管理。实现有人/无人机编队之间在时间、空间上的协同与配合,而无人机在有人机的指挥下完成侦察与打击等任务。 单位 中国航空无线电电子研究所 收藏 分享 被引 (9) 浏览", "date": "2024-04-17T21:31:00+08:00"}, {"title": "设定篇(2.2)最后一个设定篇!-该昵称重复最新章节-免费小说-全文免费阅读-该昵称重复作品-话本小说网", "url": "https://www.ihuaben.com/book/6474837/41861334.html", "source": "话本小说", "snippet": "无人机: 〇侦查蜂型机:每一辆战车/每一个作战班配备无人侦察机以搜索附近的匿踪敌人并增加视野。 〇战斗蜂型机:每一辆坦克/每一个作战班配备搭载机pào的无人攻击机,并可维修车辆。 〇700型喷气式察打一体无人机:除了可以携带各种中小型空对地dǎodàn外,还能够挂载大型的CM-102高速反辐射,以及反舰dǎodàn。 〇双头龙\"察打一体无人机:模块化设计携带十分方便,弹药易于补充挂载也可以灵活调整。具备空中悬停的功能,对地观测较为稳定;机腹的光电探头还具备可见光、红外之间的模式切换,能够轻松对地方火力部署,人员位置进行侦察,在发现重要目标时就可直接到头顶投掷pǎi,jī,pào弹,发起致命一击,并且满电时可一次性工作六个小时,还可在零下20摄氏度到零上50摄氏度这个范围内都能正常工作,可在海拔4500m的高原顺利起降。 〇“云中龙”察打一体无人机:云影无人机除了能够携带常规察打一体无人机的标配弹药,诸如激光制导反坦克dǎodàn、卫星制导hángkōngzhàdàn、卫星制导滑翔航弹、轻型空射反舰dǎodàn以外,还配备了一种全新的、专为威龙而设计的秘密武器。此款秘密武器名为FT7防区外精确制导hángkōngzhàdàn,该型航弹采用了非比寻常的特殊折叠滑翔翼结构,在航弹挂载于挂架之下时,弹翼处于折叠收缩状态、减小体积和占用空间,只要在经过投放之后才会在半空中展开弹翼进入滑翔状态,在卫星导航的精确制导下,从防区外向着敌方纵深目标发起高效的精确打击。 〇哈瓦战斧察打一体无人机:最大载重25KG,可续航60分钟,更是具备了抗风7级、防雨、防尘、适应-40—85°环境的全天候作战能力。还可通过加载不同模块,遂行侦察、布控、抓捕、照明和排爆等特种任务,还能化身空中打击平法,发射导弹、烟雾弹、震爆弹、催泪弹等榴弹。 例如高空前发射模块,内部集成了瞄准仪和高清摄像头,携弹量5枚,攻击", "date": "2021-08-15T05:47:02+08:00"}, {"title": "无人机_搜狗输入法词库", "url": "http://pinyin.sogou.com/dict/detail/index/59677", "source": "搜狗拼音输入法官网", "snippet": "词条样例: 无人机、 固定翼、 扑翼、 单旋翼、 多旋翼、 四旋翼、 六旋翼、 八旋翼、 已有 4764 次下载 词条信息: 词条:8个 创建者:暖心咖啡 大小:10004 更新:2016-03-15 10:04:47 版本:第1个版本 词库简介: 黄石蜂鸟航拍工作室 您可能感兴趣的词库 下载:6663 词条:亚拓、飞艇、发射机、接收机 下载:6061 词条:万代、田宫、郡仕、盖亚、田宫喷罐 下载:4727 词条:娃娃、眼泥、面罩、外出包 下载:3679 词条:神皇、帝皇、帝王、皇帝、皇帝陛下 皮肤表情词库合作、品牌合作、输入法合作 邮箱: hci_bd@tencent.com", "date": "2016-03-15T10:04:47+08:00"}, {"title": "仿生机械守卫鹰 #科幻 #AIGC #AI短片 #抖音AI创作大赛 - 今日头条", "url": "https://www.toutiao.com/video/7657883811362898486/", "source": "今日头条", "snippet": "翼龙2察打一体无人机,完全可以实现这种能力!现实中,无人机不可能飞那么近再打,敌方也会有雷达,不会让一个携带大量弹药的无人机离大部队那么近!", "date": "2026-07-02T19:00:00+08:00"}, {"title": "【免费】麻雀还是鹰隼 察打一体化无人机的入门与精通-发表之家", "url": "https://www.fabiao.com/hlktgxsj/201808/35595017.html", "source": "发表之家", "snippet": "摘要: 近年来,世界各国纷纷投入军用无人机的研制热潮,除各类中小型侦察、中继以及干扰无人机产品外,察打一体化无人机市场也出现了井喷式的发展,本文以“捕食者”系列、“彩虹”“翼龙”系列以及其他几款无人机为例,详解该类型无人机的几点关键技术。 注:因版权方要求,不能公开全文,如需全文,请咨询杂志社", "date": "2018-08-01T00:00:00+08:00"}, {"title": "翼龙:察打一体无人机如何操作--人民电视--人民网", "url": "http://tv.people.com.cn/n/2012/1115/c67816-19595008.html", "source": "人民视频", "snippet": "翼龙:察打一体无人机如何操作\n2012年11月15日19:47\n来源:中国网络电视台\n人\n民\n网\n版\n权\n所\n有\n,未\n经\n书\n面\n授\n权\n禁\n止\n使\n用\nCopyright\n©\n1997-2012\nby\nwww.people.com.cn.\nall\nrights\nreserved", "date": "2012-11-15T00:00:00+08:00"}, {"title": "我空军开启智能化作战方式 暗剑无人机辅助歼20输出中国空军暗剑无人机_新浪军事_新浪网", "url": "http://mil.news.sina.com.cn/jssd/2018-06-25/doc-ihencxtt9257522.shtml", "source": "新浪网新闻中心", "snippet": "最近,研究工作者和无人机合照的照片在网络上广为流传。照片中,无人机的研发人员沈飞和他最新研制出的无人机站在一起,颇具风采,引得网民纷纷叫好。 照片中的无人机名为“暗剑”,通过长时间的研发和改良工作,它可以和歼-20相互辅助,实现机体“隐身”的作战效果。这一作战效果的成功落实将提高实战中的整体军队的隐蔽能力,增强我国空军的综合作战实力。 “暗剑”的初始机型和机体模型在最近的杂志新闻中公开亮相。", "date": "2018-06-25T18:14:00+08:00"}], "extracted_facts": [{"content": "新浪军事2018年报道称，一款名为“暗剑”的无人机经过长期研发改良，可与歼-20相互配合，实现机体“隐身”的作战效果，文中将研发人员与“沈飞”关联（表述含混，可能指沈飞公司或人名）。", "source_name": "新浪网新闻中心（新浪军事）", "source_url": "http://mil.news.sina.com.cn/jssd/2018-06-25/doc-ihencxtt9257522.shtml", "credibility": 0.45}, {"content": "中国航空无线电电子研究所发表研究，界定“忠诚僚机”式有人/无人机协同作战概念：有人机担任指挥者角色，负责任务分解、分配与管理，无人机在有人机指挥下完成侦察与打击任务，实现编队时空协同。", "source_name": "科研之友（转载学术论文）", "source_url": "https://www.scholarmate.com/S/qYUesV", "credibility": 0.75}, {"content": "2014年发表的有人/无人机协同作战研究指出，协同控制系统研制涉及通用开放式架构、机间智能通信网络、有人机无人机协同控制、多传感器协同信息处理等关键技术，并提出发展建议。", "source_name": "豆丁网（转载《电讯技术》类论文）", "source_url": "https://www.docin.com/p-1268173477.html", "credibility": 0.55}, {"content": "行业评述文章指出，近年来世界各国投入军用无人机研制热潮，除中小型侦察、中继、干扰无人机外，察打一体化无人机市场出现“井喷式”发展，并以美国“捕食者”系列、中国“彩虹”“翼龙”系列为典型案例分析关键技术。", "source_name": "发表之家（期刊文章摘要）", "source_url": "https://www.fabiao.com/hlktgxsj/201808/35595017.html", "credibility": 0.5}, {"content": "人民网2012年视频报道介绍“翼龙”察打一体无人机的操作方式，确认翼龙系列为中国察打一体无人机的代表性产品。", "source_name": "人民网/人民电视", "source_url": "http://tv.people.com.cn/n/2012/1115/c67816-19595008.html", "credibility": 0.7}, {"content": "自媒体内容提及翼龙-2察打一体无人机具备较强打击能力，但属于科普/评论性表述，无技术参数或企业归属信息。", "source_name": "今日头条（自媒体视频）", "source_url": "https://www.toutiao.com/video/7657883811362898486/", "credibility": 0.2}], "data_points": []}}

