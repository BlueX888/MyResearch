data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T00:21:06.712966", "content": {"results": [{"id": "fact_5db49260", "title": "道客巴巴文档为《中国暗剑——沈飞推出国产新概念隐形无人战机》扫描件，OCR质量差，但可佐证2006年前后沈飞/沈阳所曾公开“暗剑”隐身无人战机概念。", "source": "道客巴巴", "url": "", "snippet": "道客巴巴文档为《中国暗剑——沈飞推出国产新概念隐形无人战机》扫描件，OCR质量差，但可佐证2006年前后沈飞/沈阳所曾公开“暗剑”隐身无人战机概念。", "date": "", "isSupplementary": false}, {"id": "fact_8ecf9be2", "title": "《国际展望》2006年第24期记载，沈阳飞机设计研究所展台上展出了名为“暗剑”的隐身无人战斗机方案模型，被视为中国向无人战斗机领域进军的标志之一。", "source": "中国知网《国际展望》2006年24期", "url": "", "snippet": "《国际展望》2006年第24期记载，沈阳飞机设计研究所展台上展出了名为“暗剑”的隐身无人战斗机方案模型，被视为中国向无人战斗机领域进军的标志之一。", "date": "", "isSupplementary": false}, {"id": "fact_3501481b", "title": "多篇转载资料称，暗剑无人机由中国航空工业集团公司沈阳飞机设计研究所设计，是一种大型无人作战飞机。", "source": "今日头条", "url": "", "snippet": "多篇转载资料称，暗剑无人机由中国航空工业集团公司沈阳飞机设计研究所设计，是一种大型无人作战飞机。", "date": "", "isSupplementary": false}, {"id": "fact_b66f4e4f", "title": "新浪军事资料称，暗剑具有超音速、超高机动性能和低可探测性，主要用于未来对空作战。", "source": "新浪军事", "url": "", "snippet": "新浪军事资料称，暗剑具有超音速、超高机动性能和低可探测性，主要用于未来对空作战。", "date": "", "isSupplementary": false}, {"id": "fact_615f6aab", "title": "新浪军事称，暗剑是沈阳飞机设计研究所在预研探索中已被淘汰的众多方案之一，并曾以概念模型在珠海航展展示。", "source": "新浪军事", "url": "", "snippet": "新浪军事称，暗剑是沈阳飞机设计研究所在预研探索中已被淘汰的众多方案之一，并曾以概念模型在珠海航展展示。", "date": "", "isSupplementary": false}, {"id": "fact_278d3e41", "title": "转载资料称，暗剑在2006年10月底珠海航展上首次公开亮相，引起关注。", "source": "沐风网", "url": "", "snippet": "转载资料称，暗剑在2006年10月底珠海航展上首次公开亮相，引起关注。", "date": "", "isSupplementary": false}, {"id": "fact_e29e5311", "title": "转载资料称，暗剑采用箭形翼身融合布局，设计有别于B-2类型无人机，可能具备无人机空战能力。", "source": "沐风网", "url": "", "snippet": "转载资料称，暗剑采用箭形翼身融合布局，设计有别于B-2类型无人机，可能具备无人机空战能力。", "date": "", "isSupplementary": false}, {"id": "fact_5680e1e7", "title": "今日头条自媒体称，暗剑可作为歼-20等有人机的忠诚僚机，携带小型雷达前出探测，也可单独执行侦察任务。", "source": "今日头条", "url": "", "snippet": "今日头条自媒体称，暗剑可作为歼-20等有人机的忠诚僚机，携带小型雷达前出探测，也可单独执行侦察任务。", "date": "", "isSupplementary": false}, {"id": "fact_678709dc", "title": "今日头条自媒体称，暗剑配备高性能涡扇发动机，高空最大飞行速度可达2马赫，具备超音速巡航能力。", "source": "今日头条", "url": "", "snippet": "今日头条自媒体称，暗剑配备高性能涡扇发动机，高空最大飞行速度可达2马赫，具备超音速巡航能力。", "date": "", "isSupplementary": false}, {"id": "fact_f9c4d457", "title": "中无人机在投资者互动平台答复称：翼龙-10无人机目前为成飞产品，成飞承诺将在具备条件时注入公司，有关信息需关注公司公告。", "source": "中无人机互动平台（特特股转载）", "url": "", "snippet": "中无人机在投资者互动平台答复称：翼龙-10无人机目前为成飞产品，成飞承诺将在具备条件时注入公司，有关信息需关注公司公告。", "date": "", "isSupplementary": false}, {"id": "fact_7407a113", "title": "金融界转载同一互动平台答复：翼龙-10无人机目前为成飞产品，成飞承诺将在具备条件时注入中无人机。", "source": "金融界股票", "url": "", "snippet": "金融界转载同一互动平台答复：翼龙-10无人机目前为成飞产品，成飞承诺将在具备条件时注入中无人机。", "date": "", "isSupplementary": false}, {"id": "fact_d3c12dea", "title": "证券之星转载中无人机董秘答复：翼龙-10无人机目前为成飞产品，成飞承诺将在具备条件时注入公司。", "source": "证券之星股票频道", "url": "", "snippet": "证券之星转载中无人机董秘答复：翼龙-10无人机目前为成飞产品，成飞承诺将在具备条件时注入公司。", "date": "", "isSupplementary": false}, {"id": "fact_ad15b7d5", "title": "中无人机2023年实现营业收入26.64亿元，同比变动-3.94%；净利润3.03亿元，同比变动-18.27%；扣非净利润2.86亿元，同比变动-21.24%；...", "source": "界面新闻", "url": "", "snippet": "中无人机2023年实现营业收入26.64亿元，同比变动-3.94%；净利润3.03亿元，同比变动-18.27%；扣非净利润2.86亿元，同比变动-21.24%；经营活动产生的现金流量净额1.18亿元，同比变动-68.87%。", "date": "", "isSupplementary": false}, {"id": "fact_f8d4512c", "title": "中无人机2023年利润分配方案为10派1.77元，涉及现金分红金额1.19亿元。", "source": "界面新闻", "url": "", "snippet": "中无人机2023年利润分配方案为10派1.77元，涉及现金分红金额1.19亿元。", "date": "", "isSupplementary": false}, {"id": "fact_73866487", "title": "中无人机成立于2007年8月1日，2022年6月29日上市，专注于大型固定翼长航时无人机系统，主要产品为翼龙系列大型固定翼长航时无人机系统。", "source": "界面新闻", "url": "", "snippet": "中无人机成立于2007年8月1日，2022年6月29日上市，专注于大型固定翼长航时无人机系统，主要产品为翼龙系列大型固定翼长航时无人机系统。", "date": "", "isSupplementary": false}, {"id": "fact_23954883", "title": "界面新闻报道称，中无人机控股股东变更不影响翼龙-10无人机的注入。", "source": "界面新闻", "url": "", "snippet": "界面新闻报道称，中无人机控股股东变更不影响翼龙-10无人机的注入。", "date": "", "isSupplementary": false}, {"id": "fact_a6223617", "title": "中航无人机官方微信号文章展示翼龙家族已形成翼龙-1、翼龙-2、翼龙-3、翼龙-10等系列平台；翼龙家族实现吨位1吨级至6吨级、高度1.2万米以下、速度125至5...", "source": "腾讯网转载中航无人机系统公司微信文章", "url": "", "snippet": "中航无人机官方微信号文章展示翼龙家族已形成翼龙-1、翼龙-2、翼龙-3、翼龙-10等系列平台；翼龙家族实现吨位1吨级至6吨级、高度1.2万米以下、速度125至590千米/小时、多种任务能力全覆盖。", "date": "", "isSupplementary": false}, {"id": "fact_78c03187", "title": "中航无人机成立于2007年，2018年12月25日重组并更名为“中航（成都）无人机系统股份有限公司”，2022年6月首次公开发行股票并在科创板上市。", "source": "腾讯网转载中航无人机系统公司微信文章", "url": "", "snippet": "中航无人机成立于2007年，2018年12月25日重组并更名为“中航（成都）无人机系统股份有限公司”，2022年6月首次公开发行股票并在科创板上市。", "date": "", "isSupplementary": false}, {"id": "fact_ae5cb3c4", "title": "上交所公告列表显示中无人机发布《日常经营重大合同公告》，公告日期为2026-01-09，公告全文PDF可在上交所静态链接查阅。", "source": "上海证券交易所公告（经新浪财经索引）", "url": "", "snippet": "上交所公告列表显示中无人机发布《日常经营重大合同公告》，公告日期为2026-01-09，公告全文PDF可在上交所静态链接查阅。", "date": "", "isSupplementary": false}, {"id": "fact_486d6668", "title": "新浪财经公告列表显示：中无人机拟披露年报，公告日期2025-12-25；另有2026-01-05股份回购进展公告及2026-01-06更正公告。", "source": "新浪财经", "url": "", "snippet": "新浪财经公告列表显示：中无人机拟披露年报，公告日期2025-12-25；另有2026-01-05股份回购进展公告及2026-01-06更正公告。", "date": "", "isSupplementary": false}]}}

