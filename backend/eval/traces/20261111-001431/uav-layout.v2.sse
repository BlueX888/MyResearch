data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T00:14:43.109701", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "梳理全球及中国军用无人机市场规模、增速、主要需求方向（察打一体、隐身作战、忠诚僚机、侦察监视等），并分析成飞翼龙系列与沈飞相关无人机产品所处细分市场的规模与增长空间。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中国军用无人机市场规模 增速 察打一体无人机 军贸出口 翼龙 沈飞无人机"]}, {"id": "sec_2", "title": "竞争格局", "description": "分析成飞与沈飞在无人机领域的组织归属、产品谱系、产业化平台、客户与出口渠道差异，比较翼龙系列与沈飞隐身无人机/忠诚僚机项目的竞争定位及与航天彩虹、洪都航空等企业的关系。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 无人机 布局 翼龙 中航无人机 沈飞 无人机 暗剑 利剑 竞争格局"]}, {"id": "sec_3", "title": "技术趋势", "description": "对比成飞在察打一体、长航时、低成本可消耗无人机方面的技术路线，与沈飞在隐身设计、飞翼布局、有人/无人协同、舰载无人机等方面的技术积累，识别两家企业核心技术方向差异。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 无人机 技术 翼龙 察打一体 沈飞 隐身无人机 飞翼 忠诚僚机 有人无人协同"]}, {"id": "sec_4", "title": "政策环境", "description": "分析国防科技工业政策、军品出口管制、航空工业集团内部专业化分工、低空经济与无人机产业政策对成飞和沈飞无人机布局的影响，重点关注军贸审批和集团资源分配。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军用无人机 出口管制 国防科技工业 政策 航空工业集团 无人机 专业化分工 低空经济"]}, {"id": "sec_5", "title": "挑战机遇", "description": "识别成飞面临的军贸市场竞争加剧、产品同质化和技术升级压力，以及沈飞面临的高端无人机项目周期长、采购不确定性等挑战；同时分析军贸出口扩张、无人作战体系建设和低空经济带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 无人机 挑战 军贸竞争 沈飞 无人机 挑战 机遇 无人作战体系"]}, {"id": "sec_6", "title": "未来展望", "description": "研判成飞与沈飞无人机布局的演进方向：成飞可能继续强化翼龙品牌外贸与系列化发展，沈飞可能加速隐身无人作战飞机和有人/无人协同系统落地，二者在航空工业集团统筹下呈现差异化协同趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 无人机 未来 发展趋势 翼龙 隐身无人作战 忠诚僚机 协同"]}], "research_questions": ["成飞与沈飞在无人机产品谱系、技术路线和产业化模式上的核心差异是什么？", "两家企业在军贸出口、国内军品采购和集团内部专业化分工中的定位如何影响其无人机布局？", "未来隐身化、智能化和有人/无人协同趋势下，成飞与沈飞的竞争关系将如何演变？"]}}

