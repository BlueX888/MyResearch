", "name": "航天彩虹", "type": "company", "discovered_at": "2026-11-11T00:15:15.549343"}, {"id": "node_18", "name": "腾盾股份", "type": "company", "discovered_at": "2026-11-11T00:15:15.549349"}, {"id": "node_19", "name": "天宇长鹰", "type": "company", "discovered_at": "2026-11-11T00:15:15.549358"}, {"id": "node_20", "name": "海鹰航空", "type": "company", "discovered_at": "2026-11-11T00:15:15.549364"}, {"id": "node_21", "name": "中直股份（昌飞/哈飞）", "type": "company", "discovered_at": "2026-11-11T00:15:15.549370"}, {"id": "node_22", "name": "低空经济政策", "type": "policy", "discovered_at": "2026-11-11T00:15:15.549376"}, {"id": "node_23", "name": "中航成飞/中航工业成飞", "type": "company", "discovered_at": "2026-11-11T00:15:44.720032"}, {"id": "node_24", "name": "中航沈飞", "type": "company", "discovered_at": "2026-11-11T00:15:44.720052"}, {"id": "node_25", "name": "中无人机", "type": "company", "discovered_at": "2026-11-11T00:15:44.720068"}, {"id": "node_26", "name": "翼龙系列", "type": "technology", "discovered_at": "2026-11-11T00:15:44.720093"}, {"id": "node_27", "name": "彩虹系列", "type": "technology", "discovered_at": "2026-11-11T00:15:44.720113"}, {"id": "node_28", "name": "BZK005", "type": "technology", "discovered_at": "2026-11-11T00:15:44.720129"}, {"id": "node_29", "name": "中国航空工业集团", "type": "company", "discovered_at": "2026-11-11T00:15:44.720141"}, {"id": "node_30", "name": "航天科技十一院", "type": "company", "discovered_at": "2026-11-11T00:15:44.720153"}, {"id": "node_31", "name": "哈飞", "type": "company", "discovered_at": "2026-11-11T00:15:44.720165"}, {"id": "node_32", "name": "《无人驾驶航空器飞行管理暂行条例》", "type": "policy", "discovered_at": "2026-11-11T00:15:44.720174"}, {"id": "node_33", "name": "《通用航空装备创新应用实施方案(2024-2030年)》", "type": "policy", "discovered_at": "2026-11-11T00:15:44.720186"}], "edges": [{"source": "成飞（成都飞机工业集团）", "relation": "翼龙系列察打一体无人机的产业关联方（待核实）", "discovered_at": "2026-11-11T00:15:04.315747"}, {"source": "成飞（成都飞机工业集团）", "relation": "歼-20研制单位", "discovered_at": "2026-11-11T00:15:04.315750"}, {"source": "沈飞（沈阳飞机工业集团）", "relation": "暗剑隐身无人机（待核实）", "discovered_at": "2026-11-11T00:15:04.315758"}, {"source": "沈飞（沈阳飞机工业集团）", "relation": "歼-20协同作战概念关联", "discovered_at": "2026-11-11T00:15:04.315761"}, {"source": "翼龙系列无人机", "relation": "察打一体无人机代表产品", "discovered_at": "2026-11-11T00:15:04.315768"}, {"source": "翼龙系列无人机", "relation": "外贸出口主力（待核实）", "discovered_at": "2026-11-11T00:15:04.315771"}, {"source": "暗剑无人机", "relation": "隐身无人作战飞机概念", "discovered_at": "2026-11-11T00:15:04.315777"}, {"source": "暗剑无人机", "relation": "与歼-20有人/无人协同", "discovered_at": "2026-11-11T00:15:04.315780"}, {"source": "彩虹系列无人机", "relation": "航天彩虹，与成飞形成外贸竞品关系", "discovered_at": "2026-11-11T00:15:04.315787"}, {"source": "中航无人机（中航（成都）无人机系统股份有限公司）", "relation": "翼龙系列产业化平台（待核实）", "discovered_at": "2026-11-11T00:15:04.315794"}, {"source": "中国航空无线电电子研究所", "relation": "忠诚僚机/有人无人协同技术研究", "discovered_at": "2026-11-11T00:15:04.315800"}, {"source": "歼-20", "relation": "有人机平台，与隐身无人机协同", "discovered_at": "2026-11-11T00:15:04.315806"}, {"source": "忠诚僚机作战概念", "relation": "有人/无人协同作战", "discovered_at": "2026-11-11T00:15:04.315812"}, {"source": "忠诚僚机作战概念", "relation": "任务管理与分配技术", "discovered_at": "2026-11-11T00:15:04.315815"}, {"source": "成都飞机设计研究所（611所）/成飞集团", "relation": "翼龙系列无人机研制方", "discovered_at": "2026-11-11T00:15:15.549281"}, {"source": "成都飞机设计研究所（611所）/成飞集团", "relation": "中航无人机控股股东", "discovered_at": "2026-11-11T00:15:15.549284"}, {"source": "成都飞机设计研究所（611所）/成飞集团", "relation": "与沈飞构成差异化竞争", "discovered_at": "2026-11-11T00:15:15.549285"}, {"source": "沈阳飞机设计研究所（601所）/沈飞", "relation": "利剑、暗剑无人机设计方", "discovered_at": "2026-11-11T00:15:15.549290"}, {"source": "沈阳飞机设计研究所（601所）/沈飞", "relation": "有人机隐身与舰载技术积累", "discovered_at": "2026-11-11T00:15:15.549292"}, {"source": "沈阳飞机设计研究所（601所）/沈飞", "relation": "与成飞构成差异化竞争", "discovered_at": "2026-11-11T00:15:15.549294"}, {"source": "中航无人机（中无人机，688297）", "relation": "成飞集团控股", "discovered_at": "2026-11-11T00:15:15.549298"}, {"source": "中航无人机（中无人机，688297）", "relation": "翼龙系列产业化与出口平台", "discovered_at": "2026-11-11T00:15:15.549300"}, {"source": "中航无人机（中无人机，688297）", "relation": "2024年业绩预亏", "discovered_at": "2026-11-11T00:15:15.549301"}, {"source": "洪都航空", "relation": "利剑隐身无人攻击机制造方", "discovered_at": "2026-11-11T00:15:15.549306"}, {"source": "洪都航空", "relation": "与沈飞设计端分工", "discovered_at": "2026-11-11T00:15:15.549307"}, {"source": "翼龙系列（翼龙-1/1D/2）", "relation": "察打一体", "discovered_at": "2026-11-11T00:15:15.549312"}, {"source": "翼龙系列（翼龙-1/1D/2）", "relation": "军贸+内销", "discovered_at": "2026-11-11T00:15:15.549313"}, {"source": "翼龙系列（翼龙-1/1D/2）", "relation": "全球市占率第二", "discovered_at": "2026-11-11T00:15:15.549315"}, {"source": "利剑隐身无人攻击机", "relation": "601所设计", "discovered_at": "2026-11-11T00:15:15.549319"}, {"source": "利剑隐身无人攻击机", "relation": "洪都制造", "discovered_at": "2026-11-11T00:15:15.549321"}, {"source": "利剑隐身无人攻击机", "relation": "2013年首飞", "discovered_at": "2026-11-11T00:15:15.549323"}, {"source": "利剑隐身无人攻击机", "relation": "技术储备型工程试验机", "discovered_at": "2026-11-11T00:15:15.549324"}, {"source": "暗剑无人作战飞机", "relation": "601所设计", "discovered_at": "2026-11-11T00:15:15.549328"}, {"source": "暗剑无人作战飞机", "relation": "超音速高机动低可探测", "discovered_at": "2026-11-11T00:15:15.549330"}, {"source": "暗剑无人作战飞机", "relation": "对空作战定位", "discovered_at": "2026-11-11T00:15:15.549332"}, {"source": "暗剑无人作战飞机", "relation": "2006年珠海航展亮相", "discovered_at": "2026-11-11T00:15:15.549334"}, {"source": "云影无人机", "relation": "归属主体存疑", "discovered_at": "2026-11-11T00:15:15.549338"}, {"source": "云影无人机", "relation": "与翼龙同属成飞系讨论范围", "discovered_at": "2026-11-11T00:15:15.549341"}, {"source": "航天彩虹", "relation": "彩虹系列察打一体无人机", "discovered_at": "2026-11-11T00:15:15.549345"}, {"source": "航天彩虹", "relation": "翼龙的直接对标竞争者", "discovered_at": "2026-11-11T00:15:15.549347"}, {"source": "腾盾股份", "relation": "扑天雕/双尾蝎等长航时无人机", "discovered_at": "2026-11-11T00:15:15.549352"}, {"source": "腾盾股份", "relation": "军用长航时固定翼竞争者", "discovered_at": "2026-11-11T00:15:15.549355"}, {"source": "天宇长鹰", "relation": "BZK-005系列察打一体无人机", "discovered_at": "2026-11-11T00:15:15.549360"}, {"source": "天宇长鹰", "relation": "军品与外贸", "discovered_at": "2026-11-11T00:15:15.549362"}, {"source": "海鹰航空", "relation": "天鹰、WJ-700、WJ-600A/D等", "discovered_at": "2026-11-11T00:15:15.549366"}, {"source": "海鹰航空", "relation": "航天科工系无人机", "discovered_at": "2026-11-11T00:15:15.549368"}, {"source": "中直股份（昌飞/哈飞）", "relation": "雨燕系列等无人机布局", "discovered_at": "2026-11-11T00:15:15.549372"}, {"source": "中直股份（昌飞/哈飞）", "relation": "集团内专业化分工议题", "discovered_at": "2026-11-11T00:15:15.549373"}, {"source": "低空经济政策", "relation": "中无人机概念标签", "discovered_at": "2026-11-11T00:15:15.549378"}, {"source": "低空经济政策", "relation": "民用无人机市场扩容", "discovered_at": "2026-11-11T00:15:15.549379"}, {"source": "中航成飞/中航工业成飞", "relation": "翼龙系列/翼龙II相关生产方", "discovered_at": "2026-11-11T00:15:44.720038"}, {"source": "中航成飞/中航工业成飞", "relation": "被列为察打一体无人机相关上市企业", "discovered_at": "2026-11-11T00:15:44.720042"}, {"source": "中航成飞/中航工业成飞", "relation": "中国航空工业集团下属主机厂", "discovered_at": "2026-11-11T00:15:44.720046"}, {"source": "中航沈飞", "relation": "被列为察打一体无人机相关上市企业", "discovered_at": "2026-11-11T00:15:44.720056"}, {"source": "中航沈飞", "relation": "搜索结果中无人机具体布局证据缺失", "discovered_at": "2026-11-11T00:15:44.720060"}, {"source": "中航沈飞", "relation": "中国航空工业集团下属主机厂", "discovered_at": "2026-11-11T00:15:44.720064"}, {"source": "中无人机", "relation": "翼龙系列无人机研制/上市平台", "discovered_at": "2026-11-11T00:15:44.720073"}, {"source": "中无人机", "relation": "军贸出口受益标的", "discovered_at": "2026-11-11T00:15:44.720076"}, {"source": "中无人机", "relation": "察打一体无人机领先制造商", "discovered_at": "2026-11-11T00:15:44.720080"}, {"source": "翼龙系列", "relation": "成飞/中无人机", "discovered_at": "2026-11-11T00:15:44.720098"}, {"source": "翼龙系列", "relation": "察打一体无人机", "discovered_at": "2026-11-11T00:15:44.720101"}, {"source": "翼龙系列", "relation": "军贸明星产品", "discovered_at": "2026-11-11T00:15:44.720105"}, {"source": "翼龙系列", "relation": "翼龙-2出口占比较高", "discovered_at": "2026-11-11T00:15:44.720109"}, {"source": "彩虹系列", "relation": "航天彩虹/航天科技十一院", "discovered_at": "2026-11-11T00:15:44.720117"}, {"source": "彩虹系列", "relation": "察打一体无人机", "discovered_at": "2026-11-11T00:15:44.720120"}, {"source": "彩虹系列", "relation": "军贸出口", "discovered_at": "2026-11-11T00:15:44.720125"}, {"source": "BZK005", "relation": "北京-哈飞", "discovered_at": "2026-11-11T00:15:44.720133"}, {"source": "BZK005", "relation": "察打一体无人机代表产品", "discovered_at": "2026-11-11T00:15:44.720137"}, {"source": "中国航空工业集团", "relation": "成飞、沈飞、中无人机所属集团", "discovered_at": "2026-11-11T00:15:44.720145"}, {"source": "中国航空工业集团", "relation": "内部专业化分工可能影响无人机布局", "discovered_at": "2026-11-11T00:15:44.720149"}, {"source": "航天科技十一院", "relation": "彩虹-5生产方", "discovered_at": "2026-11-11T00:15:44.720157"}, {"source": "航天科技十一院", "relation": "察打一体无人机", "discovered_at": "2026-11-11T00:15:44.720161"}, {"source": "哈飞", "relation": "BZK005相关生产方", "discovered_at": "2026-11-11T00:15:44.720169"}, {"source": "《无人驾驶航空器飞行管理暂行条例》", "relation": "无人机产业规范", "discovered_at": "2026-11-11T00:15:44.720178"}, {"source": "《无人驾驶航空器飞行管理暂行条例》", "relation": "低空经济政策环境", "discovered_at": "2026-11-11T00:15:44.720182"}, {"source": "《通用航空装备创新应用实施方案(2024-2030年)》", "relation": "通用航空/无人机产业支持", "discovered_at": "2026-11-11T00:15:44.720190"}, {"source": "《通用航空装备创新应用实施方案(2024-2030年)》", "relation": "低空经济政策环境", "discovered_at": "2026-11-11T00:15:44.720194"}]}, "stats": {"entitiesCount": 34, "relationsCount": 77}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-11T00:15:44.720928", "content": {"agent": "DeepScout", "section": "市场概况", "facts_count": 10, "duplicates_removed": 0, "data_points_count": 11, "insights": ["搜索结果能较充分支持成飞/中无人机在翼龙系列察打一体无人机产业化和军贸出口方面的存在与市场地位，但关键数据多为二手引用，缺少原始统计口径。", "沈飞在无人机领域的具体产品、收入、订单、技术验证信息在搜索结果中几乎缺失，无法验证其忠诚僚机、隐身无人作战飞机等高端方向优势。", "中国军用无人机市场增长和察打一体细分增长有数据支持，但市场规模口径冲突严重：整体军用无人机约20亿美元与察打一体524.78亿元不能直接并列使用。"], "source_quality": "整体来源质量偏低至中等。核心市场数据主要来自搜狐号、财经头条、今日头条、豆丁等二手或自媒体来源，缺少原始统计口径；仅有小牛行研、观研报告网、中商情报网等报告节选和券商观点转载，权威性有限。关键数据（中国军用无人机约20亿美元、察打一体524.78亿元、翼龙-2出口占比30.2%、彩虹和翼龙占世界市场90%以上）相互冲突或明显夸张，需追溯SIPRI、上市公司年报、券商原始报告和官方统计。沈飞无人机布局证据几乎缺失，无法支撑差异化竞争判断。", "hypothesis_updates": 3, "search_results": [{"title": "中国军用无人机市场预计将迅速扩张,未来发展迎来新机遇_进出口_全球_技术", "url": "https://www.sohu.com/a/861476972_121924584", "source": "搜狐", "snippet": "近年来,中国军用无人机行业迎来了蓬勃发展的机遇。从2019年到2028年,全球军用无人机市场规模持续增长,预计到2023年将达到121.24亿美元。在这一背景下,中国军用无人机市场也在焕发出新的生机。根据相关数据显示,2023年中国军用无人机市场规模预计接近20亿美元,年复合增长率将超过7%。如此迅猛的增长,使得中国在全球军用无人机市场中的地位愈加显赫,预示着未来将成为国际无人机市场中最具竞争力的国家之一。 中国不仅在军用无人机市场规模上不断扩大,市场结构和进出口情况也同样令人瞩目。根据SIPRI的数据,中国在2010-2020年的无人机军贸市场中占据了约17%的份额,位居全球第三,主要出口型号包括“翼龙”系列与“彩虹”系列。数据显示,“翼龙-2”在出口数量上表现优异,累计占比达到30.2%。这种市场结构不仅反映了中国无人机技术的成熟,还展现了在全球防务行业中的潜力。未来,随着无人机相关技术的进步和应用领域的拓展,中国的军用无人机市场将迎来更大的发展空间。 在市场需求方面,随着各国对无人机的军事需求日益增加,中国的军用无人机出口市场也呈现出多样化的发展趋势。主要目标市场包括中东、东南亚和非洲等缺乏自主无人机研发能力的发展中国家。在这其中,巴基斯坦和沙特阿拉伯仍然是中国军用无人机出口的主要市场。未来,随着“一带一路”倡议的推进,中国无人机的国际市场布局将更加广泛。各国在“一带一路”沿线的合作交流将进一步加深中国军用无人机的影响力。 实际上,无人机的应用场景早已从单一的侦察任务扩展到信息收集、打击敌方目标等多个领域。尽管目前的市场主要集中在军用领域,但民用无人机市场的增长也是不可忽视的。例如,无人机在农业监测、灾后救援和基础设施检查等方面的应用逐渐被广泛接受。这些应用不仅提高了相关产业的效率,也在一定程度上改变了人们的生活方式。随着社会经济的发展,对无人机的需求将只会不断上升,", "date": "2025-02-20T15:24:00+08:00"}, {"title": "无人机_观研报告网", "url": "https://www.chinabaogao.com/tag/wurenji?page=2", "source": "行业数据网", "snippet": "随着无人机产业发展不断发展,逐渐从军用领域延伸到了民用领域,并且民用无人机市场呈现出迅猛增长的态势。据有关数据统计,2013年中国无人机行业市场规模已达88亿元。2014年中国无人机行业市场规模突破百亿元。截止至2017年中国无人机行业市场规模约为151亿元,其中,民用无人机市场规模为83亿元,军用无人机市场规模为68亿元。", "date": "2019-09-26T00:00:00+08:00"}, {"title": "察打一体无人机行业概况：无人机应用广泛，市场规模呈现上升趋势", "url": "https://cj.sina.cn/articles/view/7829375716/1d2aacae400101fham", "source": "财经头条", "snippet": "内容概要: 在现代战争的舞台上,无人机已经成为不可或缺的重要角色。中国,作为世界军事大国之一,其军用无人机的发展更是日新月异,种类繁多,性能卓越。从侦察无人机到察打一体无人机,从制空无人机到运输无人机,中国军用无人机以其独特的优势和广泛的应用领域,成为了国家安全和军事战略的重要支撑。察打一体无人机作为中国军用无人机中的重要组成部分,它不仅具备侦察能力,还能执行打击任务,是现代战争中不可或缺的“杀手锏”。为了提升国防实力和维护国家安全,我国加大了对察打一体无人机的研发和采购投入,出台了一系列鼓励和规范察打一体无人机发展的政策和措施,如《无人驾驶航空器飞行管理暂行条例》、《通用航空装备创新应用实施方案(2024-2030年)》等。在这些政策的作用下,我国察打一体无人机行业市场规模不断上升。据统计,2023年中国察打一体无人机行业市场规模达到524.78亿元,同比上涨21.58%,估计2024年行业市场规模达到600亿元以上。\n相关上市企业: 中航机载(600372)、航天彩虹(002389)、威海广泰(002111)、中无人机(688297)、航天电子(600879)、纵横股份(688070)、中航成飞(302132)、中航沈飞(600760)、洪都航空(600316)、华力创通(300045)等。\n相关企业 :中国航空科技工业股份有限公司、中国航空工业集团有限公司、中国航空发动机集团有限公司、重庆宗申动力机械股份有限公司、成都飞机工业(集团)有限责任公司、航天神舟飞行器有限公司、北方天途航空技术发展(北京)有限公司、东方哨兵(北京)科技有限公司、成都安则科技有限公司等。\n关键词:察打一体无人机、军用无人机、市场规模、“彩虹”、“翼龙”\n一、察打一体无人机行业相关概述\n无人机是利用无线电遥控设备和自备的程序控制装置操纵的不载人飞机。行业通常以用途来对无人机进行划分,并对其分为军", "date": "2025-04-03T21:49:00+08:00"}, {"title": "察打一体无人机行业概况：无人机应用广泛，市场规模呈现上升趋势", "url": "https://k.sina.cn/article_7829375716_1d2aacae400101fham.html", "source": "新浪看点", "snippet": "内容概要: 在现代战争的舞台上,无人机已经成为不可或缺的重要角色。中国,作为世界军事大国之一,其军用无人机的发展更是日新月异,种类繁多,性能卓越。从侦察无人机到察打一体无人机,从制空无人机到运输无人机,中国军用无人机以其独特的优势和广泛的应用领域,成为了国家安全和军事战略的重要支撑。察打一体无人机作为中国军用无人机中的重要组成部分,它不仅具备侦察能力,还能执行打击任务,是现代战争中不可或缺的“杀手锏”。为了提升国防实力和维护国家安全,我国加大了对察打一体无人机的研发和采购投入,出台了一系列鼓励和规范察打一体无人机发展的政策和措施,如《无人驾驶航空器飞行管理暂行条例》、《通用航空装备创新应用实施方案(2024-2030年)》等。在这些政策的作用下,我国察打一体无人机行业市场规模不断上升。据统计,2023年中国察打一体无人机行业市场规模达到524.78亿元,同比上涨21.58%,估计2024年行业市场规模达到600亿元以上。\n   相关上市企业: 中航机载(600372)、航天彩虹(002389)、威海广泰(002111)、中无人机(688297)、航天电子(600879)、纵横股份(688070)、中航成飞(302132)、中航沈飞(600760)、洪都航空(600316)、华力创通(300045)等。\n   相关企业 :中国航空科技工业股份有限公司、中国航空工业集团有限公司、中国航空发动机集团有限公司、重庆宗申动力机械股份有限公司、成都飞机工业(集团)有限责任公司、航天神舟飞行器有限公司、北方天途航空技术发展(北京)有限公司、东方哨兵(北京)科技有限公司、成都安则科技有限公司等。\n   关键词:察打一体无人机、军用无人机、市场规模、“彩虹”、“翼龙”\n   一、察打一体无人机行业相关概述\n   无人机是利用无线电遥控设备和自备的程序控制装置操纵的不载人飞机。行业通常以", "date": "2025-04-03T21:49:00+08:00"}, {"title": "军用无人机中,中国出口的两“彩虹”和“翼龙”无人机-今日头条", "url": "https://www.toutiao.com/article/6799382319602860556/", "source": "今日头条", "snippet": "军用无人机中,中国出口的两“彩虹”和“翼龙”无人机已经占据到世界察打一体无人机市场的90%以上,尤其在中东,北非等地区。", "date": "2020-03-02T07:16:00+08:00"}, {"title": "察打一体无人机行业概况：无人机应用广泛，市场规模呈现上升趋势", "url": "https://k.sina.cn/article_7829375716_1d2aacae400101fham.html?from=mil&pos=24&vt=4", "source": "新浪看点", "snippet": "关注 \n内容概要: 在现代战争的舞台上,无人机已经成为不可或缺的重要角色。中国,作为世界军事大国之一,其军用无人机的发展更是日新月异,种类繁多,性能卓越。从侦察无人机到察打一体无人机,从制空无人机到运输无人机,中国军用无人机以其独特的优势和广泛的应用领域,成为了国家安全和军事战略的重要支撑。察打一体无人机作为中国军用无人机中的重要组成部分,它不仅具备侦察能力,还能执行打击任务,是现代战争中不可或缺的“杀手锏”。为了提升国防实力和维护国家安全,我国加大了对察打一体无人机的研发和采购投入,出台了一系列鼓励和规范察打一体无人机发展的政策和措施,如《无人驾驶航空器飞行管理暂行条例》、《通用航空装备创新应用实施方案(2024-2030年)》等。在这些政策的作用下,我国察打一体无人机行业市场规模不断上升。据统计,2023年中国察打一体无人机行业市场规模达到524.78亿元,同比上涨21.58%,估计2024年行业市场规模达到600亿元以上。\n相关上市企业: 中航机载(600372)、航天彩虹(002389)、威海广泰(002111)、中无人机(688297)、航天电子(600879)、纵横股份(688070)、中航成飞(302132)、中航沈飞(600760)、洪都航空(600316)、华力创通(300045)等。\n相关企业 :中国航空科技工业股份有限公司、中国航空工业集团有限公司、中国航空发动机集团有限公司、重庆宗申动力机械股份有限公司、成都飞机工业(集团)有限责任公司、航天神舟飞行器有限公司、北方天途航空技术发展(北京)有限公司、东方哨兵(北京)科技有限公司、成都安则科技有限公司等。\n关键词:察打一体无人机、军用无人机、市场规模、“彩虹”、“翼龙”\n一、察打一体无人机行业相关概述\n无人机是利用无线电遥控设备和自备的程序控制装置操纵的不载人飞机。行业通常以用途来对无人机进行划分,并对", "date": "2025-04-03T21:49:00+08:00"}, {"title": "2024-2029全球及中国军用无人机行业发展现状调研及投资前景分析报告-中商产业研究院", "url": "https://www.askci.com/reports/20200325/0853244455874053.shtml", "source": "中商情报网", "snippet": "1\n军用无人机市场概述1.1\n军用无人机产品定义及统计范围1.2.1\n不同产品类型军用无人机增长趋势2020\nVS\n20261.2.2\n固定翼1.2.3\n旋翼1.2.4\n混合动力1.3\n从不同应用,军用无人机主要包括如下几个方面1.3.1\n侦查1.3.2\n攻击1.3.3\n其他应用1.4\n全球与中国发展现状对比1.4.1\n全球发展现状及未来趋势1.4.2\n中国生产发展现状及未来趋势1.5\n全球军用无人机供需现状及预测1.5.1\n全球军用无人机产能、产量、产能利用率及发展趋势1.5.2\n全球军用无人机产量、表观消费量及发展趋势1.6\n中国军用无人机供需现状及预测1.6.1\n中国军用无人机产能、产量、产能利用率及发展趋势1.6.2\n中国军用无人机产量、表观消费量及发展趋势1.6.3\n中国军用无人机产量、市场需求量及发展趋势1.7\n军用无人机中国及欧美日等行业政策分析2\n全球与中国主要厂商军用无人机产量、产值及竞争分析2.1\n全球军用无人机主要厂商列表2.1.1\n全球军用无人机主要厂商产量列表2.1.2\n全球军用无人机主要厂商产值列表2.1.3\n2019年全球主要生产商军用无人机收入排名2.1.4\n全球军用无人机主要厂商产品价格列表2.2\n中国军用无人机主要厂商产量、产值及市场份额2.2.1\n中国军用无人机主要厂商产量列表2.2.2\n中国军用无人机主要厂商产值列表2.3\n军用无人机厂商产地分布及商业化日期2.4\n军用无人机行业集中度、竞争程度分析2.4.1\n军用无人机行业集中度分析:全球Top\n5和Top\n10生产商市场份额2.4.2\n全球军用无人机第一梯队、第二梯队和第三梯队生产商(品牌)及市场份额(2018\nVS\n2019)2.5\n军用无人机全球领先企业SWOT分析2.6\n全球主要军用无人机企业采访及观点3\n全球军用无人机主要生产地区分析3.1\n全球主要地区军用无人机市场规模", "date": "2026-04-14T17:38:16+08:00"}, {"title": "中无人机公司旗下“翼龙”系列无人机 - 行业研究数据 - 小牛行研", "url": "https://www.hangyan.co/charts/3180469637112399346", "source": "小牛行研", "snippet": "研究报告节选: 全面发展阶段:构建察打一体无人机研制生产能力。当前,我国军用无人机性能已比肩国际先进水平。军用无人机是高科技系统化、密集型的典型代表,我国已研发出多款察打一体的无人机产品,“彩虹”、“翼龙”系列代表的无人机产品性能优异,受到海外市场的欢迎,成为无人机军贸的明星产品。", "date": "2023-08-30T21:48:25+08:00"}, {"title": "东方证券—国防军工行业：国际局势不稳定下中国军贸迎来新机遇，技术迭代引领增长新势能—250307", "url": "https://m.csai.cn/yuqing/688297/959087.html", "source": "希财网", "snippet": "中国军贸市场近年来呈现显著增长趋势,尤其在无人机领域,以翼龙与彩虹系列为主的察打一体无人机出口较多。尽管目前军贸收入占比较低,但未来随着地缘政治冲突加剧和各国军费支出增加,中国军贸出口有较大上升空间。中无人机(688297)作为国内领先的无人机制造商,有望受益于这一市场机遇。\n舆情等级\n重要\n舆情评分\n正面舆情\n舆情解析\n请登录后查看\n开通会员后解锁无限制查看权益\n点击查看舆情源网页", "date": "2025-03-10T08:00:00+08:00"}, {"title": "中国察打一体无人机行业市场前景分析-海外出口畅销,未来百亿市场规模 - 豆丁网", "url": "https://www.docin.com/p-2652837619.html", "source": "豆丁网", "snippet": "中国察打一体无人机行业市场前景分析海外出口畅销,未来百亿市场规模察打一体无人机功能强大海外出口不断提高军用无人机是属于具有广阔军事应用前景的新型装备,并且随着现代战争进一步朝着更智能的方向发展,对其军事需求将进一步增长。军事无人机中察打一体无人机因其优越的战场侦察监视及毁伤观测等功能较为强大,发展较好且海外出口不断提高。加之国内政策的不断扶持,未来,军用无人机行业规模将进一步增大。军用无人机规模扩大察打一体优势明显目前,中国察打一体无人机产品具有代表性的为彩虹5无人机、翼龙II无人机及BZK005人机,分别产自航天科技十一院、中航工业成飞及北京-哈飞。察打一体无人机无论在战场侦察监视及毁伤观测等功能还是在目标指示和精准探测上,与有人机相比,都具有较大的优首先,与有人机相比,无人机因具有目标小、突防能力强、无生命代价等优越性,故一直是获取战场情报的重要力量。其次,具备侦察打一体无人机可及时向所探测到的目标发动攻击,不需等待其它武器平台的支援,极大地提高了侦察信息的时效性和攻击的准确性。最后,大型察打一体无人机跟踪并锁定目标后,可利用搭载的激光照射器照射目标,引导有人作战飞机发射激光制导弹药进行精确攻击。利好政策支持察打一体无人机发展因其功能的强大,以及对国家军事发展的重要性,各国都给予高度重视。为了帮助建立全球统一的规范,国际标准化组织(ISO)日前发布了全球首个无人机使用标准草案ISO/CD21384-ISO希望该草案能为全球无人机制造商和操作者提供最好的指南,同时表示还将对无人机研究技术、制造质量和交通管理等进行更深入的规范。我国也相继出台了较多政策给予发展和支持,其中,2015年发布的《中国制造2025》中提出,将航空航天装备列入重点领域进行大力推广,推进无人机等航空装备产业化。另外,2018年12月《关于推动国防科技工业军民融合深度发展的意见》发布,提出推进军民结合、", "date": "2021-05-01T07:57:13+08:00"}], "extracted_facts": [{"content": "搜狐号文章援引相关数据称，全球军用无人机市场规模预计到2023年达到121.24亿美元；2023年中国军用无人机市场规模预计接近20亿美元，年复合增长率超过7%。", "source_name": "搜狐", "source_url": "https://www.sohu.com/a/861476972_121924584", "credibility": 0.4}, {"content": "搜狐号文章援引SIPRI数据称，2010-2020年中国在无人机军贸市场中占约17%份额，位居全球第三，主要出口型号包括翼龙系列与彩虹系列；翼龙-2出口数量累计占比达到30.2%。", "source_name": "搜狐", "source_url": "https://www.sohu.com/a/861476972_121924584", "credibility": 0.4}, {"content": "财经头条/新浪看点文章称，2023年中国察打一体无人机行业市场规模达到524.78亿元，同比上涨21.58%，估计2024年达到600亿元以上；该口径与前述中国军用无人机整体约20亿美元的数据存在明显差异。", "source_name": "财经头条/新浪看点", "source_url": "https://cj.sina.cn/articles/view/7829375716/1d2aacae400101fham", "credibility": 0.45}, {"content": "财经头条/新浪看点文章将中航成飞、中航沈飞、中无人机、航天彩虹等列为察打一体无人机相关上市企业，但未说明两家主机厂在无人机业务上的具体差异。", "source_name": "财经头条/新浪看点", "source_url": "https://cj.sina.cn/articles/view/7829375716/1d2aacae400101fham", "credibility": 0.45}, {"content": "小牛行研报告节选称，中无人机公司旗下拥有翼龙系列无人机，我国已研发出多款察打一体无人机产品，彩虹、翼龙系列性能优异并受到海外市场欢迎，成为无人机军贸明星产品。", "source_name": "小牛行研", "source_url": "https://www.hangyan.co/charts/3180469637112399346", "credibility": 0.6}, {"content": "希财网转载东方证券报告观点称，中国军贸市场近年显著增长，无人机领域以翼龙与彩虹系列为主的察打一体无人机出口较多；中无人机作为国内领先无人机制造商，有望受益于军贸出口扩张。", "source_name": "希财网", "source_url": "https://m.csai.cn/yuqing/688297/959087.html", "credibility": 0.5}, {"content": "豆丁网文章称，中国察打一体无人机代表产品包括彩虹-5、翼龙II及BZK005，分别产自航天科技十一院、中航工业成飞及北京-哈飞。", "source_name": "豆丁网", "source_url": "https://www.docin.com/p-2652837619.html", "credibility": 0.35}, {"content": "今日头条文章称，中国出口的彩虹和翼龙无人机已占据世界察打一体无人机市场90%以上，尤其在中东、北非等地区；该比例明显偏高，需谨慎使用。", "source_name": "今日头条", "source_url": "https://www.toutiao.com/article/6799382319602860556/", "credibility": 0.2}], "data_points": [{"name": "全球军用无人机市场规模", "value": "121.24", "unit": "亿美元", "year": 2023, "source": "搜狐"}, {"name": "中国军用无人机市场规模", "value": "20", "unit": "亿美元", "year": 2023, "source": "搜狐"}, {"name": "中国军用无人机市场年复合增长率", "value": "7", "unit": "%", "year": 2023, "source": "搜狐"}, {"name": "中国无人机军贸全球份额", "value": "17", "unit": "%", "year": 2020, "source": "搜狐"}, {"name": "翼龙-2出口数量累计占比", "value": "30.2", "unit": "%", "year": 2020, "source": "搜狐"}, {"name": "中国察打一体无人机市场规模", "value": "524.78", "unit": "亿元", "year": 2023, "source": "财经头条/新浪看点"}, {"name": "中国察打一体无人机市场规模同比增速", "value": "21.58", "unit": "%", "year": 2023, "source": "财经头条/新浪看点"}, {"name": "中国察打一体无人机市场规模估计", "value": "600", "unit": "亿元", "year": 2024, "source": "财经头条/新浪看点"}, {"name": "彩虹和翼龙占世界察打一体无人机市场份额", "value": "90", "unit": "%", "year": 2020, "source": "今日头条"}, {"name": "中国无人机行业市场规模", "value": "151", "unit": "亿元", "year": 2017, "source": "观研报告网"}]}}

