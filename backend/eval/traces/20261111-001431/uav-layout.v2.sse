data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-11T00:23:35.806098", "content": {"charts": [{"id": "chart_001", "title": "中无人机营收与净利润规模", "subtitle": "2022年 vs 2025年（亿元）", "type": "bar", "echarts_option": {"tooltip": {"trigger": "axis", "axisPointer": {"type": "shadow"}}, "legend": {"data": ["营业总收入", "归母净利润"], "bottom": 0, "textStyle": {"color": "#666"}}, "grid": {"left": "3%", "right": "4%", "bottom": "15%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2022年", "2025年"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "亿元", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"name": "营业总收入", "type": "bar", "data": [27.73, 30.16], "barWidth": 28, "itemStyle": {"color": "#1677ff", "borderRadius": [4, 4, 0, 0]}, "label": {"show": true, "position": "top", "color": "#1677ff", "formatter": "{c}"}}, {"name": "归母净利润", "type": "bar", "data": [3.64, 0.89], "barWidth": 28, "itemStyle": {"color": "#52c41a", "borderRadius": [4, 4, 0, 0]}, "label": {"show": true, "position": "top", "color": "#52c41a", "formatter": "{c}"}}]}}, {"id": "chart_002", "title": "中无人机盈利能力指标对比", "subtitle": "归母净利润与扣非归母净利润（亿元）", "type": "bar", "echarts_option": {"tooltip": {"trigger": "axis", "axisPointer": {"type": "shadow"}}, "legend": {"data": ["归母净利润", "扣非归母净利润"], "bottom": 0, "textStyle": {"color": "#666"}}, "grid": {"left": "3%", "right": "4%", "bottom": "15%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2022年", "2025年"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "亿元", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"name": "归母净利润", "type": "bar", "data": [3.64, 0.89], "barWidth": 28, "itemStyle": {"color": "#1677ff", "borderRadius": [4, 4, 0, 0]}, "label": {"show": true, "position": "top", "color": "#1677ff", "formatter": "{c}"}}, {"name": "扣非归母净利润", "type": "bar", "data": [3.58, 0.43], "barWidth": 28, "itemStyle": {"color": "#722ed1", "borderRadius": [4, 4, 0, 0]}, "label": {"show": true, "position": "top", "color": "#722ed1", "formatter": "{c}"}}]}}, {"id": "chart_003", "title": "中无人机营收与利润同比增速", "subtitle": "2022年 vs 2025年（%）", "type": "bar", "echarts_option": {"tooltip": {"trigger": "axis", "axisPointer": {"type": "shadow"}}, "legend": {"data": ["营业总收入同比", "归母净利润同比", "扣非归母净利润同比"], "bottom": 0, "textStyle": {"color": "#666"}}, "grid": {"left": "3%", "right": "4%", "bottom": "15%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2022年", "2025年"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "%", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"color": "#666"}}, "series": [{"name": "营业总收入同比", "type": "bar", "data": [12.01, 340.11], "barWidth": 20, "itemStyle": {"color": "#1677ff", "borderRadius": [4, 4, 0, 0]}, "label": {"show": true, "position": "top", "color": "#1677ff", "formatter": "{c}%"}}, {"name": "归母净利润同比", "type": "bar", "data": [23.15, 264.28], "barWidth": 20, "itemStyle": {"color": "#52c41a", "borderRadius": [4, 4, 0, 0]}, "label": {"show": true, "position": "top", "color": "#52c41a", "formatter": "{c}%"}}, {"name": "扣非归母净利润同比", "type": "bar", "data": [24.03, 169.0], "barWidth": 20, "itemStyle": {"color": "#fa8c16", "borderRadius": [4, 4, 0, 0]}, "label": {"show": true, "position": "top", "color": "#fa8c16", "formatter": "{c}%"}}]}}, {"id": "chart_004", "title": "成飞/沈飞无人机项目关键节点", "subtitle": "暗剑与利剑研发时间线（年份）", "type": "scatter", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}<br/>年份：{c}"}, "grid": {"left": "10%", "right": "10%", "bottom": "10%", "containLabel": true}, "xAxis": {"type": "value", "name": "年份", "min": 2005, "max": 2015, "interval": 1, "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "yAxis": {"type": "category", "data": ["暗剑（沈飞）", "利剑（沈飞/洪都）"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "fontSize": 13}, "splitLine": {"show": false}}, "series": [{"name": "关键节点", "type": "scatter", "symbolSize": 16, "data": [{"value": [2006, 0], "name": "暗剑模型首次公开", "itemStyle": {"color": "#722ed1"}}, {"value": [2009, 1], "name": "利剑项目启动", "itemStyle": {"color": "#1677ff"}}, {"value": [2012, 1], "name": "利剑总装下线", "itemStyle": {"color": "#52c41a"}}, {"value": [2013, 1], "name": "利剑首飞", "itemStyle": {"color": "#fa8c16"}}], "label": {"show": true, "position": "top", "formatter": "{b}", "color": "#333", "fontSize": 11}}]}}]}}

