data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:24:14.828397", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husli')\ndata = {'Year': [2020, 2021, 2022, 2023, 2024, 2025], 'Revenue': [12.17, 24.76, 27.73, 26.64, 6.85, 30.16], 'NetProfit': [1.65, 2.96, 3.70, 3.03, -0.54, 0.89]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['Revenue'], linewidth=2.5, marker='o', markersize=8, color='#6366f1', label='营业收入')\nplt.fill_between(df['Year'], df['Revenue'], alpha=0.15, color='#6366f1')\nplt.plot(df['Year'], df['NetProfit'], linewidth=2.5, marker='s', markersize=8, color='#10b981', label='归母净利润')\nplt.axhline(0, color='gray', linestyle='--', alpha=0.5)\nplt.title('成飞系中无人机（翼龙系列）营收与净利润趋势', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('金额（亿元）', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.legend(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')\nplt.close()\ncomp = {'Company': ['成飞-中无人机', '沈飞-无人机业务'], 'Revenue': [6.85, 28.0], 'Margin': [32.05, 42.0]}\ndc = pd.DataFrame(comp)\nfor col in ['Revenue', 'Margin']:\n    dc[col] = pd.to_numeric(dc[col], errors='coerce')\ndc = dc.dropna()\nplt.figure(figsize=(12, 7), dpi=200)\nbars = plt.bar(dc['Company'], dc['Revenue'], color=['#06b6d4', '#f59e0b'], width=0.5)\nfor b, v in zip(bars, dc['Revenue']):\n    plt.text(b.get_x() + b.get_width() / 2, v + 0.5, f'{v}亿元', ha='center', fontsize=13, fontweight='bold')\nplt.title('2024年成飞与沈飞无人机业务规模对比', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('企业', fontsize=14)\nplt.ylabel('无人机业务收入（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3, axis='y')\nsns.despine()\nplt.savefig('chart2.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦成飞系（中无人机/翼龙系列，成飞持股33.01%）与沈飞系（暗剑/利剑隐身无人机、无人机业务）的差异。选取中无人机2020-2025年营收与净利润趋势反映成飞系无人机商业化路径的波动性；选取2024年成飞中无人机（6.85亿元）与沈飞无人机业务（28亿元，同比+215%，毛利率42%）的规模与毛利率对比，揭示成飞偏外贸察打一体整机放量、沈飞偏隐身高端型号与高毛利结构的分化。"}}

