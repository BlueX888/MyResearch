data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-11T00:19:15.017403", "content": {"agent": "DeepScout", "tool": "deep_search_follow_up", "queries": ["中无人机 688297 2024年年度报告 全文 营业收入 军贸收入 翼龙 交付", "中无人机 2024年度业绩预亏公告 原文 归母净利润 扣非归母净利润"], "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T00:19:15.562822", "content": {"results": [{"id": "sr_7644e0", "title": "[年报]中无人机(688297):中无人机2024年年度报告- CFi.CN 中财网", "source": "中财网股票频道", "url": "https://stock.cfi.cn/p20250331005226.html", "snippet": "[年报]中无人机(688297):中无人机2024年年度报告\n时间:2025年03月31日 20:36:21&nbsp中财网\n注意:本文为公告节选,部分内容省略,完整内容请查看交易所发布的PDF全文原文。\n原标题:中无人机:中无人机2024年年度报告\n公司代码:688297                                                  公司简称:中无人机\n <(-----已省略余下内容,完整内容请查看交易所发布的PDF全文原文----)", "date": "2025-03-31T20:36:00+08:00"}, {"id": "sr_6fdd48", "title": "中无人机:2024年年度报告_报告网", "source": "报告网", "url": "https://www.baogao.com/qiye/1487497.html", "snippet": "中无人机:2024年年度报告\n2025-04-01\n16:31:05上传人:昨日**太远\nAa\n小\n中\n大\n一、经营情况\n第一节\n释义第二节\n公司简介和主要财务指标第三节\n管理层讨论与分析第四节\n公司治理第五节\n环境、社会责任和其他公司治理第六节\n重要事项第七节\n股份变动及股东情况第八节\n优先股相关情况第九节\n债券相关情况第十节\n财务报告备查文件目录载有公司负责人、主管会计工作负责人、会计机构负责人签名并盖章的财务报表。载有会计师事务所盖章、注册会计师签名并盖章的审计报告原件。报告期内公开披露过的所有文件的正本及公告底稿。\n报告网所有企业报告是由用户上传分享,未经用户书面授权,请勿作商用!", "date": "2025-04-01T16:31:05+08:00"}, {"id": "sr_d78e24", "title": " 2024年中无人机分析报告:无人机领军企业,持续拓展国内市场 - 道客巴巴 ", "source": "道客巴巴", "url": "https://www.doc88.com/p-40839525831836.html", "snippet": "下载积分: 9800 内容提示: [Table_Info1] [Table_Date] [Table_PicQuote] [Table_Author] 中无人机 军用无人机领军企业,持续拓展国内市场无人机应用场景不断拓展,市场发展空间广阔。无人机与载人飞机相比,具有体积小、造价低、使用方便、对作战环境要求低、战场生存能力较强等优点,已成为世界各国发展装备的重要方向。预计未来,在军用领域,全球军用无人机主要产值集中在无人战斗机系统、中空长航时无人机系统及高空长航时无... 文档格式:PDF | 页数:48 | 浏览次数:9 | [Table_Info1] [Table_Date] [Table_PicQuote] [Table_Author] 中无人机 军用无人机领军企业,持续拓展国内市场无人机应用场景不断拓展,市场发展空间广阔。无人机与载人飞机相比,具有体积小、造价低、使用方便、对作战环境要求低、战场生存能力较强等优点,已成为世界各国发展装备的重要方向。预计未来,在军用领域,全球军用无人机主要产值集中在无人战斗机系统、中空长航时无人机系统及高空长航时无人机系统领域,其中中空长航时无人机系统及高空长航时无人机系统约占军用无人机 48%左右的市场份额;在民用领域,随着无人机应用领域的不断深化,预计 2024 年全球民用无人机市场规模将增长至 4157.27 亿元人民币,其中工业无人机规模占比将持续提升。公司专注无人机领域,翼龙系列无人机是我国军贸出口的主力型号。公司主要产品包括翼龙-1、翼龙-1D、翼龙-2 等翼龙系列无人机系统,已出口“一带一路”沿线多个国家,其优越性能和成熟度经历了高强度实战检验并取得卓越战绩,获得国内外客户广泛认可。根据斯德哥尔摩国际和平研究所(SIPRI)统计,2010 年至 2023 年间,翼龙系列无人机军贸出口订单累计数量位列国内第一。在国内市场,公", "date": "2024-07-30T14:36:11+08:00"}, {"id": "sr_99cc71", "title": "中无人机:2023年年度报告_报告网", "source": "报告网", "url": "https://www.baogao.com/qiye/1465827.html", "snippet": "中无人机:2023年年度报告\n2024-03-15\n19:56:32上传人:Bl**l.\nAa\n小\n中\n大\n一、经营情况\n第一节\n释义第二节\n公司简介和主要财务指标第三节\n管理层讨论与分析第四节\n公司治理第五节\n环境、社会责任和其他公司治理第六节\n重要事项第七节\n股份变动及股东情况第八节\n优先股相关情况第九节\n债券相关情况第十节\n财务报告(财务部)备查文件目录载有公司负责人、主管会计工作负责人、会计机构负责人签名并盖章的财务报表。载有会计师事务所盖章、注册会计师签名并盖章的审计报告原件。报告期内公开披露过的所有文件的正本及公告底稿。\n报告网所有企业报告是由用户上传分享,未经用户书面授权,请勿作商用!", "date": "2024-03-15T19:56:32+08:00"}, {"id": "sr_300822", "title": "中无人机(688297):24年业绩预亏 未来受益无人机国内、军贸双市场增长__新浪财经_新浪网", "source": "新浪财经", "url": "http://stock.finance.sina.com.cn/stock/go.php/vReport_Show/kind/lastest/rptid/790956802383/index.phtml", "snippet": "公司发布《2024 年度业绩预亏公告》,预计2024 年年度归母净利润-5,800 万元到-4,900 万元。预计2024 年年度扣非归母净利润-6,750 万元到-5,850 万元。 24 年业绩预亏,Q3 存货提升&预付账款增加,合同负债回升。公司发布《2024年度业绩预亏公告》,预计2024 年年度归母净利润-5,800 万元到-4,900 万元。预计2024 年年度扣非归母净利润-6,750 万元到-5,850 万元。业绩预亏的主要原因系1)收入端大幅下降:国际市场需求周期波动、国内市场需求节奏调整以及重点客户的采购计划延后等影响,本报告期公司新增订单不及预期,交付产品数量较上年同期减少。2)费用端正常发生:公司坚持技术创新,持续加大研发投入,各类经营费用正常发生。资产负债表方面:24 年前三季度公司存货达到18.72 亿,较年初提升89.28%;预付账款1.05 亿,较年初提升600.0%;合同负债2.83 亿,较年初提升249.38%。 新型号领衔亮相航展,无人机协同体系日益完备。11 月12 日,第十五届中国国际航空航天博览会在珠海国际航展中心开幕,公司自主研制的“翼龙”、“云影”系列多型号先进无人机集体参展,其中翼龙-6、云影-350 等十余型无人机首次公开亮相,翼龙-X 无人机综合反潜构型首次展示。本届航展现场,“翼龙”和“云影”齐聚一堂,展示了包括翼龙-6、翼龙-X 在内的大中型无人机系统以及云影系列的中小型无人机系统,从10 公斤到6 吨级别,“高中低”搭配、“大中小”融合的全场景系列谱系。从作战效能上来看,在实战环境下,“翼龙”、“云影”无人机已经实现了不同机型之间的混合编组和灵活搭配,具备了“大中小”“高中低”的作战体系,实现了对不同强度、不同类型对抗的套餐式供给。通过体系化作战方式,达到“1 + 1 大于2”的协同效应,从而提升了整体的作战效能。", "date": "2025-01-23T22:50:48+08:00"}, {"id": "sr_950af8", "title": "中无人机(688297)：24年业绩预亏 未来受益无人机国内、军贸双市场增长", "source": "财联社", "url": "https://www.cls.cn/detail/xk/b0288857c1e9e819f793d01a7d4e9abc", "snippet": "公司发布《2024 年度业绩预亏公告》,预计2024 年年度归母净利润-5,800 万元到-4,900 万元。预计2024 年年度扣非归母净利润-6,750 万元到-5,850 万元。\n      24 年业绩预亏,Q3 存货提升&预付账款增加,合同负债回升。公司发布《2024年度业绩预亏公告》,预计2024 年年度归母净利润-5,800 万元到-4,900 万元。预计2024 年年度扣非归母净利润-6,750 万元到-5,850 万元。业绩预亏的主要原因系1)收入端大幅下降:国际市场需求周期波动、国内市场需求节奏调整以及重点客户的采购计划延后等影响,本报告期公司新增订单不及预期,交付产品数量较上年同期减少。2)费用端正常发生:公司坚持技术创新,持续加大研发投入,各类经营费用正常发生。资产负债表方面:24 年前三季度公司存货达到18.72 亿,较年初提升89.28%;预付账款1.05 亿,较年初提升600.0%;合同负债2.83 亿,较年初提升249.38%。\n      新型号领衔亮相航展,无人机协同体系日益完备。11 月12 日,第十五届中国国际航空航天博览会在珠海国际航展中心开幕,公司自主研制的“翼龙”、“云影”系列多型号先进无人机集体参展,其中翼龙-6、云影-350 等十余型无人机首次公开亮相,翼龙-X 无人机综合反潜构型首次展示。本届航展现场,“翼龙”和“云影”齐聚一堂,展示了包括翼龙-6、翼龙-X 在内的大中型无人机系统以及云影系列的中小型无人机系统,从10 公斤到6 吨级别,“高中低”搭配、“大中小”融合的全场景系列谱系。从作战效能上来看,在实战环境下,“翼龙”、“云影”无人机已经实现了不同机型之间的混合编组和灵活搭配,具备了“大中小”“高中低”的作战体系,实现了对不同强度、不同类型对抗的套餐式供给。通过体系化作战方式,达到“1 + 1 大于2”的协同效应,从", "date": "2025-01-24T00:11:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T00:19:29.942928", "content": {"results": [{"id": "sr_079906", "title": "翼龙无人机由哪个飞机厂制造 爱问知识人", "source": "爱问知识人", "url": "https://iask.sina.com.cn/b/1H0hUGhb6IpN.html", "snippet": "全部 全部答案 2018-12-14 01:45:12 中航工业研制的 全部 紧*** 0 0 评论 分享 提交评论 成飞造的飞机。。。 全部 夜*** 2018-12-14 01:39:13 0 0 评论 分享 提交评论 2018-12-14 01:35:48 翼龙是成都飞机研究所研制的的中低空军民两用,长航时无人机。 全部 A*** 2018-12-14 01:35:48 0 0 评论 分享 提交评论 2018-12-14 01:31:44 翼龙无人机是有成都飞机设计研究所研制的中低空军民两用长航时、多用途无人机。中航工业集团制造组装。 全部 冯*** 2018-12-14 01:31:44 0 0 评论 分享 提交评论", "date": "2018-12-14T01:45:12+08:00"}, {"id": "sr_057b0f", "title": "中国翼龙II无人机--中国数字科技馆", "source": "中国数字科技馆", "url": "https://www.cdstm.cn/knowledge/kptp/tpkdt/201812/t20181228_903679.html", "snippet": "翼龙无人机由中国航空工业集团公司成都飞机设计研究所自筹经费研制。从项目启动到批量生产交付,不过5年时间,多项一流成果从无到有,堪称奇迹。 本文来自:中国数字科技馆 图片来源:中国数字科技馆", "date": "2018-12-28T16:59:00+08:00"}, {"id": "sr_58c6e0", "title": "中航工业集团成都有三个单位有无人机，关系如下：中航成都飞机设计研究所（611所）", "source": "财富号", "url": "https://caifuhao.eastmoney.com/news/20230125224523977601120", "snippet": "$中无人机(SH688297)$ $中航电测(SZ300114)$  中航工业集团成都有三个单位有无人机,关系如下:\n中航成都飞机设计研究所(611所)设计的翼龙1和翼龙2已经把知识产权卖给了 中无人机 (688297),还有无侦7和无侦8知识产权在自己手里并由成飞代工制造,其它型号保密。\n中航成都飞机工业集团(成飞)设计的翼龙10“云影”承诺注入给 中无人机 ,无侦10“风影”和新“云影”系列靶机是否注入给中无待定,代工制造611所设计的无人机。\n中航(成都)无人机系统股份有限公司( 中无人机 )从611所买了翼龙1翼龙2的知识产权,自己正在研制翼龙3,等着成飞注入翼龙10。", "date": "2023-01-26T06:45:00+08:00"}, {"id": "sr_518072", "title": "翼龙无人机是那个上市公司制造 - 搜狗问问", "source": "搜狗问答", "url": "http://wenwen.sogou.com/z/q704995324.htm", "snippet": "成都飞机设计研究所,属于成飞集团(002190)。 翼龙无人机是一款中国成都飞机设计研究所研制的中低空军民两用,长航时多用途无人机,装一台100马力活塞发动机,具备全自主平轮式起降和飞行能力。 外形酷似美国较大的无人机MQ-9,但大小和MQ-1“捕食者”类似。重1.1吨,长9米,翼展有14米。“翼龙”最高可以飞到海拔5300米,航程可达4000公里,可用于军事和非军事行动。 成飞集团是中国飞机制造的重要组成部分,是中国航空工业集团公司直属特大型企业,是我国研制、生产歼击机的重要基地。中航工业成飞坐落于成都市西郊黄田坝,拥有综合性机场和专用公路、铁路货运线,紧邻成都火车货运西站,交通运输十分便利,地理位置得天独厚。公司占地近500万平方米;在册职工14000多名,其中工程技术、管理人员约占三分之一,形成了一支素质高、能力强、专业化的航空人才队伍。 最大的区别就是不同人家造的 翼龙是成飞611所的产品,侦察打一体,与捕食者的性质一样,主要任务是战场性的侦察和攻击,按照本次在珠海航展上的说法,翼龙2也出来了,内藏式弹仓,已经签了一个有史以来最大的出口单 翔龙无人机,是成都飞机工业公司的产品,翔龙与全球鹰的性质一样,主要任务是战略性的侦察和信息中继。 云影无人机,是中国航天空气动力技术研究院的产品,是航天系统研发的,类似全球鹰的产品,但增加了攻击功能 说白了就是鼓励竞争的结果 相比之下,废物所虽然牛皮吹得山响,但什么都没有", "date": "2016-11-30T00:00:00+08:00"}, {"id": "sr_21b827", "title": "中航在翼龙-2无人机的基础上,改进研制的海燕II无人机系统!|中航|无人机|海燕_新浪新闻", "source": "新浪网", "url": "https://k.sina.com.cn/article_2160553221_m80c76d0503301msw8.html", "snippet": "中航在翼龙-2无人机的基础上,改进研制的海燕II无人机系统!\n中航在翼龙-2无人机的基础上,改进研制的海燕II无人机系统!\n特别声明:以上文章内容仅代表作者本人观点,不代表新浪网观点或立场。如有关于作品内容、版权或其它问题请于作品发表后的30日内与新浪网联系。", "date": "2025-11-13T21:56:55+08:00"}, {"id": "sr_b69e0a", "title": "中无人机公司产品是翼龙无人机_财富号_东方财富网", "source": "财富号", "url": "https://caifuhao.eastmoney.com/news/20220621072455415968100", "snippet": "$中无人机(SH688297)$ 翼龙2无人机是中航工业的成都飞机研究所研制的察打一体型无人机,等于说它和歼10歼20是同一家的。按照目前公布的资料,翼龙2无人机研制于2012年,在2017年的时候首飞成功。翼龙2无人机不但在民间可以使用,也可以用于军事用途,并且大批量出口到其他国家。其最大起飞重量大约为4.2吨,最大续航时间为20小时,也就是说它可以持续不断地飞行接近一天的时间。机翼下方总共有6个挂架,最多的时候可以挂载12枚导弹或者其他武器,最大外挂重量为480千克,最常挂载的武器自然就是各种各样的反坦克导弹或者对陆攻击导弹以及制导炸弹。 郑重声明: 总收益 20日收益 日收益 -- -- -- 代码 名称 最新价 涨跌幅 查看更多", "date": "2022-06-21T07:24:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T00:19:44.172623", "content": {"results": [{"id": "sr_a2be20", "title": "沈飞暗剑隐身无人机再次亮相 或成为歼20僚机(图)战斗机_新浪军事_新浪网", "source": "新浪网新闻中心", "url": "https://mil.news.sina.com.cn/jssd/2020-01-10/doc-iihnzahk3168304.shtml", "snippet": "暗剑无人机再次公开亮相 近日航空工业沈飞无人机部恭贺新禧的图片引起关注,可以看到背景墙上有一架类似于暗剑无人作战飞机,似乎表明暗剑项目正在紧锣密鼓推进之中。 暗剑无人作战飞机第一次公开亮相是在2006年珠海航展,当时该机以国产无人作战飞机概念项目名义出现。按照航展资料,暗剑无人机是沈阳飞机设计研究所设计的无人作战飞机方案,它具备高速、高机动性能和隐身性能于一体,主要用于未来空战。", "date": "2020-01-10T09:32:00+08:00"}, {"id": "sr_5555b6", "title": "[精品]中国暗剑——沈飞推出国产新概念隐形无人战机 - 道客巴巴", "source": "道客巴巴", "url": "https://www.doc88.com/p-7973315478013.html", "snippet": "下载积分: 280 内容提示: 沈飞推出国产新概念隐形无人战机 口本刊记者 摄影 一—一々趣凡机是洗 E 充提⋯ 的崽身 察 它的tl 现怀志蓄 Ii 国 追赶 {j L未 来世 腠湖1壶f幽杭空 I. 业已绎Jl L。 iI地J盐譬施汪晓 诚 安京陈位 晏 航腱 l 究研 n0幔膏蛳 r J 沈⋯的枷 曲 心采和雌 乩禁地怍凯lI々 ̈J广谜的的剑凡0 赴l晔面墟川丁寓r向正凡啦 八帆址 当个 I 'I 1 . * 癣 台以 1 r n 普碹触抨 乓Il I导 I靶 肌茸f 务『 “ 『 避免q E行置n引k粕始岍制 琵几^ 。 的钌 鞋q 缱lt制卅丁儿 IlE 蚌 世人 尤... 文档格式:PDF | 页数:2 | 浏览次数:6 | 沈飞推出国产新概念隐形无人战机 口本刊记者 摄影 一—一々趣凡机是洗 E 充提⋯ 的崽身 察 它的tl 现怀志蓄 Ii 国 追赶 {j L未 来世 腠湖1壶f幽杭空 I. 业已绎Jl L。 iI地J盐譬施汪晓 诚 安京陈位 晏 航腱 l 究研 n0幔膏蛳 r J 沈⋯的枷 曲 心采和雌 乩禁地怍凯lI々 ̈J广谜的的剑凡0 赴l晔面墟川丁寓r向正凡啦 八帆址 当个 I 'I 1 . * 癣 台以 1 r n 普碹触抨 乓Il I导 I靶 肌茸f 务『 “ 『 避免q E行置n引k粕始岍制 琵几^ 。 的钌 鞋q 缱lt制卅丁儿 IlE 蚌 世人 尤 人胜 1 扎 J咖 咄J 錾航 空{城I 6 7(I≈ 化托M 几H L ^: 多擅战 锕If· 拦价 惟f队1l_ i 襄- E 墨成髓ll上 行I帅屯k#L i T 刊均r降低 怍 融唪域破 薄j J承荚{从1992f rl! 】 t H 1 (L CA V l 外过l多午 地』h^一枝斗 耐.峨1札戚VI趾人竹挺 桂将 维普资讯 http://www.cqvip.com", "date": "2015-02-12T12:30:58+08:00"}, {"id": "sr_39b71a", "title": "中国暗剑 沈飞推出国产新概念隐形无人战机-《国际展望》2006年24期-中国知网", "source": "中国知网", "url": "https://mall.cnki.net/magazine/Article/GJZW200624016.htm", "snippet": "本届航展上,在沈阳飞机设计研究所的展台上的一架通体黝黑、外形流畅的无人机模型引起了广大观众和媒体的浓厚兴趣。据了解,这架名为“暗剑”的无人机是沈飞研究所提出的隐身无人战斗机方案,它的出现标志着中国在追赶世界军机未来发展潮流方面迈出了坚实的一步,中国航空工业已经吹响了向无人战斗机领域进军的号角。 (共2页)", "date": "2006-01-01T00:00:00+08:00"}, {"id": "sr_3c665f", "title": "沈飞淘汰方案:暗剑无人作战飞机(组图)_新浪军事_新浪网", "source": "新浪网新闻中心", "url": "http://mil.news.sina.com.cn/p/2006-11-01/1954408958.html", "snippet": "沈飞淘汰方案:暗剑无人作战飞机(组图) 沈飞设计局展出的暗剑无人作战飞机 “暗剑-无人机”是由一航沈阳所设计的无人作战飞机概念方案之一,具有超音速、超高机动性能和低可探测性,主要用于未来对空作战。 作为早早在珠海航展上对外展示的概念模型,这一方案其实是沈阳飞机设计研究所在预研探索中已被淘汰的众多方案之一。摄影:光原*影像", "date": "2006-11-01T19:54:00+08:00"}, {"id": "sr_b0bb19", "title": "世界关注:沈飞暗剑无人机---具有人工智能的第六代隐身战斗机_中航沈飞(600760)股吧_东方财富网股吧", "source": "东方财富网股吧", "url": "http://gubaf10.eastmoney.com/news,gssz,766926887.html", "snippet": "郑重声明:用户在财富号/股吧/博客等社区发表的所有信息(包括但不限于文字、视频、音频、数据及图表)仅代表个人观点,与本网站立场无关,不对您构成任何投资建议,据此操作风险自担。 请勿相信代客理财、免费荐股和炒股培训等宣传内容,远离非法证券活动。请勿添加发言用户的手机号码、公众号、微博、微信及QQ等信息,谨防上当受骗!", "date": "2018-06-16T01:24:44+08:00"}, {"id": "sr_4e632b", "title": "沈飞暗剑隐身无人机再次亮相 或成为歼20僚机_综合资讯_资讯_无人机网(www.youuav.com)_无人机专家--无人机专业网络平台", "source": "无人机网", "url": "https://www.youuav.com/news/detail/202001/38889.html", "snippet": "暗剑无人机再次公开亮相近日航空工业沈飞无人机部恭贺新禧的图片引起关注,可以看到背景墙上有一架类似于暗剑无人作战飞机,似乎表明暗剑项目正在紧锣密鼓推进之...", "date": "2020-01-10T11:37:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T00:19:49.384128", "content": {"results": [{"id": "sr_a2809a", "title": "中无人机预计2024年度归母净利润亏损4900万元-5800万元", "source": "腾讯网", "url": "https://new.qq.com/rain/a/20250121A083QV00", "snippet": "财中社1月21日电中无人机(688297)发布公告,预计2024年度归母净利润将出现亏损,亏损范围为5800万元至4900万元。扣除非经常性损益后的归母净利润预计在6750万元至5850万元之间。相比之下,2023年度归母净利润为3.03亿元,营业收入为26.64亿元,显示出明显的业绩下滑。", "date": "2025-01-21T18:54:20+08:00"}, {"id": "sr_5f8d25", "title": "中无人机(688297.SH)发布2024年度业绩,归母净亏损5392万元,同比由盈转亏_公司_净利润_财经", "source": "搜狐", "url": "https://www.sohu.com/a/877917219_114984", "snippet": "智通财经APP讯,中无人机(688297.SH)披露2024年年度报告,报告期公司实现营收6.85亿元,同比下降74.28%;归母净利润亏损5392万元,同比由盈转亏;扣非净利润亏损6254万元,同比由盈转亏;基本每股收益-0.08元。 鉴于公司2024年度归属于上市公司股东的净利润-5391.61万元,未实现盈利,充分考虑到公司的经营情况和发展规划,为更好维护全体股东长远利益,保障公司可持续发展,公司拟定2024年度利润分配方案:不派发现金红利,不送红股,不以资本公积转增股本。 来源:智通财经网 返回搜狐,查看更多", "date": "2025-03-31T20:20:00+08:00"}, {"id": "sr_38fb3a", "title": "中无人机(688297.SH)发布2024年度业绩,归母净亏损5392万元,同比由盈转亏_净利润_基本每股收益_电报", "source": "搜狐", "url": "https://www.sohu.com/a/877909162_114984", "snippet": "中无人机(688297.SH)披露2024年年度报告,报告期公司实现营收6.85亿元,同比下降74.28%;归母净利润亏损5392万元,同比由盈转亏;扣非净利润亏损6254万元,同比由盈转亏;基本每股收益-0.08元。 来源:金融界AI电报 返回搜狐,查看更多", "date": "2025-03-31T20:27:00+08:00"}, {"id": "sr_185f8d", "title": "中无人机预计2024年度归母净利润亏损4900万元-5800万元无人机_新浪财经_新浪网", "source": "新浪财经", "url": "https://finance.sina.com.cn/stock/relnews/cn/2025-01-21/doc-ineftwet8415728.shtml", "snippet": "财中社1月21日电中无人机(688297)发布公告,预计2024年度归母净利润将出现亏损,亏损范围为5800万元至4900万元。扣除非经常性损益后的归母净利润预计在6750万元至5850万元之间。相比之下,2023年度归母净利润为3.03亿元,营业收入为26.64亿元,显示出明显的业绩下滑。 本期业绩变化的主要原因包括国际市场需求周期波动、国内市场需求节奏调整及重点客户的采购计划延后等,导致公司新增订单不及预期,交付产品数量较上年同期减少,从而使全年营业收入大幅下降。为了维持行业地位并满足后续发展需求,公司在报告期内持续加大研发投入,经营费用正常发生,这也加重了经营亏损的情况。 2024年前三季度, 中无人机 实现收入3.69亿元,归母净利润-8275万元。 (文章来源:财中社) 海量资讯、精准解读,尽在新浪财经APP", "date": "2025-01-22T02:51:00+08:00"}, {"id": "sr_80b928", "title": "中无人机(688297.SH)发布2024年度业绩,归母净亏损5392万元,同比由盈转亏_股票频道_证券之星", "source": "证券之星股票频道", "url": "https://stock.stockstar.com/notice/IG2025033100032047.shtml", "snippet": "智通财经APP讯,中无人机(688297.SH)披露2024年年度报告,报告期公司实现营收6.85亿元,同比下降74.28%;归母净利润亏损5392万元,同比由盈转亏;扣非净利润亏损6254万元,同比由盈转亏;基本每股收益-0.08元。 鉴于公司2024年度归属于上市公司股东的净利润-5391.61万元,未实现盈利,充分考虑到公司的经营情况和发展规划,为更好维护全体股东长远利益,保障公司可持续发展,公司拟定2024年度利润分配方案:不派发现金红利,不送红股,不以资本公积转增股本。", "date": "2025-03-31T20:20:27+08:00"}, {"id": "sr_5fd47b", "title": "中无人机:2024年亏损5391.61万元,同比转亏母净利润_网易订阅", "source": "网易", "url": "https://www.163.com/dy/article/JS0O65580534A4SC.html", "snippet": "中无人机3月31日发布2024年年度报告,报告期内,公司实现营业收入为6.85亿元,同比下降74.28%;归属于上市公司股东的净利润为-5391.61万元,去年同期盈利3.03亿元,由盈转亏。", "date": "2025-03-31T20:46:08+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

