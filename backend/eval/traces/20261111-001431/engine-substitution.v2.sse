data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T00:35:29.140585", "content": {"results": [{"id": "fact_dedf4338", "title": "PST TiAl单晶合金承温能力提升150-250°C，寿命延长至5万小时以上；3D打印、单晶铸造、粉末冶金等技术可提升叶片性能。", "source": "报告大厅", "url": "", "snippet": "PST TiAl单晶合金承温能力提升150-250°C，寿命延长至5万小时以上；3D打印、单晶铸造、粉末冶金等技术可提升叶片性能。", "date": "", "isSupplementary": true}, {"id": "fact_bb57e751", "title": "中国两机叶片行业预计未来几年保持年均增长率超过15%，航空发动机叶片在市场规模构成中占据主导地位，市场份额超过一半。", "source": "原创力文档", "url": "", "snippet": "中国两机叶片行业预计未来几年保持年均增长率超过15%，航空发动机叶片在市场规模构成中占据主导地位，市场份额超过一半。", "date": "", "isSupplementary": true}, {"id": "fact_e70e37b3", "title": "国产单晶高温合金已跻身国际先进行列，突破了航空发动机材料制备关键技术。", "source": "全球铁合金网（转载央视新闻）", "url": "", "snippet": "国产单晶高温合金已跻身国际先进行列，突破了航空发动机材料制备关键技术。", "date": "", "isSupplementary": true}, {"id": "fact_9c5384eb", "title": "铸造母合金主要用于制造航空发动机、燃气轮机、汽车涡轮增压器的耐热部件，产品种类包括等轴晶、定向晶、单晶。", "source": "安泰科技（铸造母合金产品介绍）", "url": "", "snippet": "铸造母合金主要用于制造航空发动机、燃气轮机、汽车涡轮增压器的耐热部件，产品种类包括等轴晶、定向晶、单晶。", "date": "", "isSupplementary": true}, {"id": "fact_a35635b0", "title": "航空发动机用单晶铸造高温合金热处理工艺综述了国外第一代至第三代单晶合金成分与热处理制度，指出最优热处理条件应尽可能减少成分偏析，升温速率和冷却速率的控制对单晶高...", "source": "豆丁网", "url": "", "snippet": "航空发动机用单晶铸造高温合金热处理工艺综述了国外第一代至第三代单晶合金成分与热处理制度，指出最优热处理条件应尽可能减少成分偏析，升温速率和冷却速率的控制对单晶高温合金尤其是单晶铸件使用性能影响重大。", "date": "", "isSupplementary": true}, {"id": "fact_b840cacf", "title": "高温合金是航空发动机性能突破的关键要素，生产工艺的发展推动高温合金材料性能不断改善；高温合金下游应用领域主要为航空发动机，全球航空发动机需求量增长带动高温合金市...", "source": "原创力文档《航空发动机国产化时代，高温合金崛起》", "url": "", "snippet": "高温合金是航空发动机性能突破的关键要素，生产工艺的发展推动高温合金材料性能不断改善；高温合金下游应用领域主要为航空发动机，全球航空发动机需求量增长带动高温合金市场增长，全球高温合金市场孕育出百亿规模龙头企业PCC。", "date": "", "isSupplementary": true}, {"id": "fact_3e2297e9", "title": "国家标准GB/T 43897-2024《铸造高温合金 母合金 单晶》已发布。", "source": "道客巴巴", "url": "", "snippet": "国家标准GB/T 43897-2024《铸造高温合金 母合金 单晶》已发布。", "date": "", "isSupplementary": true}, {"id": "fact_b62aced1", "title": "高温合金作为发动机热端承力部件，是航空发动机示意图中的红色部分。", "source": "行行查", "url": "", "snippet": "高温合金作为发动机热端承力部件，是航空发动机示意图中的红色部分。", "date": "", "isSupplementary": true}, {"id": "fact_2e8dcf9d", "title": "2016年，航空发动机及燃气轮机重大专项全面启动实施；8月28日，中国航空发动机集团公司在北京正式挂牌成立。", "source": "国家国防科技工业局", "url": "", "snippet": "2016年，航空发动机及燃气轮机重大专项全面启动实施；8月28日，中国航空发动机集团公司在北京正式挂牌成立。", "date": "", "isSupplementary": true}, {"id": "fact_cff24fa0", "title": "中国航空发动机集团公司由46家单位组成，涉及军用民用航空发动机研发、测试、生产、修理全方位。", "source": "北极星电力新闻网", "url": "", "snippet": "中国航空发动机集团公司由46家单位组成，涉及军用民用航空发动机研发、测试、生产、修理全方位。", "date": "", "isSupplementary": true}, {"id": "fact_83f1e44f", "title": "中国航发于2016年5月31日完成工商注册，并于8月28日在北京举行成立大会，被认为是承担航空发动机专项的主体企业。", "source": "报告大厅", "url": "", "snippet": "中国航发于2016年5月31日完成工商注册，并于8月28日在北京举行成立大会，被认为是承担航空发动机专项的主体企业。", "date": "", "isSupplementary": true}, {"id": "fact_9e20414a", "title": "中国航发是由中央管理的国有特大型企业，由国务院、北京市人民政府、中国航空工业集团公司、中国商用飞机有限责任公司共同出资组建，于2016年5月成立，注册资本500...", "source": "搜狐", "url": "", "snippet": "中国航发是由中央管理的国有特大型企业，由国务院、北京市人民政府、中国航空工业集团公司、中国商用飞机有限责任公司共同出资组建，于2016年5月成立，注册资本500亿元。", "date": "", "isSupplementary": true}, {"id": "fact_7521f4c3", "title": "两机专项酝酿自2012年；2015年12月24日工信部部长苗圩提出抓紧实施航空发动机重大专项，2016年1月11日科技部部长万钢表示将在航空发动机等领域部署。", "source": "北极星电力新闻网", "url": "", "snippet": "两机专项酝酿自2012年；2015年12月24日工信部部长苗圩提出抓紧实施航空发动机重大专项，2016年1月11日科技部部长万钢表示将在航空发动机等领域部署。", "date": "", "isSupplementary": true}, {"id": "fact_79106b7b", "title": "方正证券估计，“航空发动机与燃气轮机”国家科技重大专项直接投入在1000亿元量级，加上地方、企业和社会其他投入，专项投入总金额约3000亿元；航发与燃机方向分配...", "source": "中国证券网", "url": "", "snippet": "方正证券估计，“航空发动机与燃气轮机”国家科技重大专项直接投入在1000亿元量级，加上地方、企业和社会其他投入，专项投入总金额约3000亿元；航发与燃机方向分配比例约为80%、20%。", "date": "", "isSupplementary": true}, {"id": "fact_13bf55b3", "title": "市场预期两机专项资金规模达1000亿元，可满足1—2款航空发动机研发的资金需求；中国航发作为航空发动机制造行业龙头将直接受益于政策与资金红利。", "source": "赢家聊吧股吧", "url": "", "snippet": "市场预期两机专项资金规模达1000亿元，可满足1—2款航空发动机研发的资金需求；中国航发作为航空发动机制造行业龙头将直接受益于政策与资金红利。", "date": "", "isSupplementary": true}, {"id": "fact_bc417c75", "title": "中国航发成立使航空工业飞发分离体系正式确立，航空发动机研发规划与资金限制完全消除，产业地位得到极大提升；两机专项步入实质性阶段。", "source": "赢家聊吧股吧", "url": "", "snippet": "中国航发成立使航空工业飞发分离体系正式确立，航空发动机研发规划与资金限制完全消除，产业地位得到极大提升；两机专项步入实质性阶段。", "date": "", "isSupplementary": true}, {"id": "fact_bd9939a3", "title": "十三五期间目标是建立健全我国航空发动机、燃气轮机产业链，实现国产进口全替代、形成完整谱系。", "source": "中国证券网", "url": "", "snippet": "十三五期间目标是建立健全我国航空发动机、燃气轮机产业链，实现国产进口全替代、形成完整谱系。", "date": "", "isSupplementary": true}, {"id": "fact_8aa46a37", "title": "未来10年我国军用飞机用航空发动机市场规模平均每年在300亿元以上；未来20年我国新增民航飞机对应的航空发动机市场规模平均每年近600亿元；军民用航空发动机市场...", "source": "中国证券网", "url": "", "snippet": "未来10年我国军用飞机用航空发动机市场规模平均每年在300亿元以上；未来20年我国新增民航飞机对应的航空发动机市场规模平均每年近600亿元；军民用航空发动机市场需求合计每年约900亿元，国内燃气轮机市场容量达300亿元。", "date": "", "isSupplementary": true}, {"id": "fact_bb38d4de", "title": "预测未来20年军用航空发动机需求约2500亿元，民用需求约18000亿元，年均市场空间约1025亿元。", "source": "赢家聊吧股吧", "url": "", "snippet": "预测未来20年军用航空发动机需求约2500亿元，民用需求约18000亿元，年均市场空间约1025亿元。", "date": "", "isSupplementary": true}, {"id": "fact_ce2ade26", "title": "国产大飞机当前最大制约因素仍是发动机，中国航发商用航空发动机有限责任公司正集中研制大推力、高涵道比航空发动机，未来将为国产大飞机配套。", "source": "报告大厅", "url": "", "snippet": "国产大飞机当前最大制约因素仍是发动机，中国航发商用航空发动机有限责任公司正集中研制大推力、高涵道比航空发动机，未来将为国产大飞机配套。", "date": "", "isSupplementary": true}]}}

