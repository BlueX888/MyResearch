e": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 12}}, "series": [{"type": "bar", "data": [{"value": 25, "itemStyle": {"color": "#eb2f96"}}, {"value": 25, "itemStyle": {"color": "#eb2f96"}}, {"value": 55, "itemStyle": {"color": "#fa8c16"}}, {"value": 60, "itemStyle": {"color": "#fa8c16"}}, {"value": 70, "itemStyle": {"color": "#52c41a"}}, {"value": 80, "itemStyle": {"color": "#52c41a"}}], "barWidth": 12, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#666"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}]}}

