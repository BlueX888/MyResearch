data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:26:40.798274", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Arial Unicode MS', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'年份': [2020, 2021, 2022, 2025], '市场规模': [1000, 400, 487, 1500]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = df['年份']\ny = df['市场规模']\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2)\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor xi, yi in zip(x, y):\n    plt.text(xi, yi + 40, f'{yi}', ha='center', va='bottom', fontsize=11, fontweight='bold', color='#1e293b')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿元人民币）', fontsize=14)\nplt.xticks(x, fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

