data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:26:48.944463", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'年份': [2020, 2021, 2022, 2025], '市场规模': [1000, 400, 487, 1500]}\ndf = pd.DataFrame(data)\nx_actual = df['年份'][:3]\ny_actual = df['市场规模'][:3]\nx_pred = df['年份'][2:]\ny_pred = df['市场规模'][2:]\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(x_actual, y_actual, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='机构统计值')\nplt.plot(x_pred, y_pred, color='#f59e0b', linewidth=2.5, marker='o', markersize=8, linestyle='--', label='预测值')\nplt.fill_between(x_actual, y_actual, alpha=0.15, color='#6366f1')\nplt.fill_between(x_pred, y_pred, alpha=0.15, color='#f59e0b')\nfor xi, yi in zip(x_actual, y_actual):\n    plt.text(xi, yi + 45, str(yi), ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nfor xi, yi in zip(x_pred, y_pred):\n    plt.text(xi, yi + 45, str(yi), ha='center', fontsize=11, fontweight='bold', color='#b45309')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿元人民币）', fontsize=14)\nplt.xticks(df['年份'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 1750)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left', frameon=True)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

