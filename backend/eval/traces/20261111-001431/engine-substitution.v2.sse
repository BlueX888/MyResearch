data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T00:14:44.712789", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述中国航空发动机市场规模、军民需求结构、国产化率、替代空间与增速，区分军用航发、商用航发、通航及无人机动力市场。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中国航空发动机市场规模 国产化率 航空发动机替代 进展 2024"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述航发动力、中国航发集团下属厂所、中国商发、民营企业与国际巨头GE、赛峰、罗罗、普惠的竞争关系，分析整机与核心部件配套格局。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中国航发 航发动力 商发 CJ-1000A 航空发动机 竞争格局 供应商"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述涡扇、涡轴、涡桨等核心技术，单晶高温合金叶片、粉末冶金盘、FADEC、复合材料风扇叶片、适航取证与可靠性增长等关键趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空发动机 单晶叶片 FADEC 复合材料风扇 国产 技术突破 适航"]}, {"id": "sec_4", "title": "政策环境", "description": "描述两机专项、军民融合、航空强国、适航审定、出口管制与供应链安全政策对国产航空发动机替代的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空发动机 两机专项 政策 军民融合 适航审定 出口管制"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述技术成熟度、可靠性、适航认证、产能与良率、供应链卡脖子、客户验证周期等挑战，以及军机换发新增、商用大飞机国产化、低空经济和无人机动力等机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空发动机 国产替代 风险 挑战 供应链 卡脖子 机遇 低空经济"]}, {"id": "sec_6", "title": "未来展望", "description": "描述未来5至10年替代路径，包括军用先行、商用分阶段突破、核心部件国产化、维修保障体系建设和全球合作格局变化。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空发动机 国产替代 未来 趋势 预测 2030 CJ-1000A 进展"]}], "research_questions": ["国产航空发动机在军用和商用领域的替代进展与国产化率如何？", "制约国产替代的关键技术、适航认证与可靠性风险有哪些？", "政策、供应链与外部管制将如何影响替代节奏和竞争格局？"]}}

