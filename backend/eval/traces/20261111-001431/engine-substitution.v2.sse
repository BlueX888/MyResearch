n": "决定性能"}, {"source": "composite_fan_blade", "target": "cj1000a", "relation": "用于"}, {"source": "cj1000a", "target": "commercial_aeroengine", "relation": "属于"}, {"source": "cj1000a", "target": "airworthiness", "relation": "接受认证"}, {"source": "policy_support", "target": "industry_chain", "relation": "支持"}, {"source": "policy_support", "target": "domestic_aeroengine", "relation": "推动"}, {"source": "foreign_oem", "target": "commercial_aeroengine", "relation": "垄断"}, {"source": "foreign_oem", "target": "domestic_aeroengine", "relation": "竞争"}, {"source": "tech_gap", "target": "domestic_aeroengine", "relation": "制约"}, {"source": "military_aeroengine", "target": "domestic_aeroengine", "relation": "属于"}, {"source": "commercial_aeroengine", "target": "domestic_aeroengine", "relation": "属于"}, {"source": "powder_disk", "target": "domestic_aeroengine", "relation": "配套"}, {"source": "dd_series", "target": "military_aeroengine", "relation": "用于"}, {"source": "industry_chain", "target": "domestic_aeroengine", "relation": "支撑"}]}, "stats": {"entities_count": 15, "relations_count": 20}}}

