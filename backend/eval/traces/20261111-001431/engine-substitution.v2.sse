data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-11T00:15:08.239163", "content": {"graph": {"nodes": [{"id": "node_0", "name": "中国航发北京航空材料研究院（航材院）", "type": "company", "discovered_at": "2026-11-11T00:15:08.239001"}, {"id": "node_1", "name": "李嘉荣", "type": "person", "discovered_at": "2026-11-11T00:15:08.239014"}, {"id": "node_2", "name": "DD6", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239024"}, {"id": "node_3", "name": "DD9/DD15/DD13", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239034"}, {"id": "node_4", "name": "CJ1000A", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239039"}, {"id": "node_5", "name": "江苏新扬新材料股份有限公司", "type": "company", "discovered_at": "2026-11-11T00:15:08.239050"}, {"id": "node_6", "name": "中国航发", "type": "company", "discovered_at": "2026-11-11T00:15:08.239055"}, {"id": "node_7", "name": "粉末冶金涡轮盘", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239063"}, {"id": "node_8", "name": "复合材料风扇叶片", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239070"}], "edges": [{"source": "中国航发北京航空材料研究院（航材院）", "relation": "单晶高温合金DD6研发单位", "discovered_at": "2026-11-11T00:15:08.239005"}, {"source": "中国航发北京航空材料研究院（航材院）", "relation": "粉末涡轮盘研制", "discovered_at": "2026-11-11T00:15:08.239008"}, {"source": "中国航发北京航空材料研究院（航材院）", "relation": "李嘉荣团队", "discovered_at": "2026-11-11T00:15:08.239011"}, {"source": "李嘉荣", "relation": "航材院专职总师", "discovered_at": "2026-11-11T00:15:08.239017"}, {"source": "李嘉荣", "relation": "DD6单晶合金发明人", "discovered_at": "2026-11-11T00:15:08.239019"}, {"source": "李嘉荣", "relation": "复合气冷与双层壁超冷叶片技术", "discovered_at": "2026-11-11T00:15:08.239021"}, {"source": "DD6", "relation": "第二代单晶高温合金", "discovered_at": "2026-11-11T00:15:08.239027"}, {"source": "DD6", "relation": "国内应用量最大", "discovered_at": "2026-11-11T00:15:08.239029"}, {"source": "DD6", "relation": "性能对标欧美第二代", "discovered_at": "2026-11-11T00:15:08.239031"}, {"source": "DD9/DD15/DD13", "relation": "后续代次单晶合金（自媒体口径，待核实）", "discovered_at": "2026-11-11T00:15:08.239037"}, {"source": "CJ1000A", "relation": "C919配套国产大涵道比涡扇发动机", "discovered_at": "2026-11-11T00:15:08.239042"}, {"source": "CJ1000A", "relation": "复合材料风扇叶片标准配置", "discovered_at": "2026-11-11T00:15:08.239045"}, {"source": "CJ1000A", "relation": "适航认证阶段", "discovered_at": "2026-11-11T00:15:08.239047"}, {"source": "江苏新扬新材料股份有限公司", "relation": "复合材料风扇叶片研制参与方", "discovered_at": "2026-11-11T00:15:08.239052"}, {"source": "中国航发", "relation": "航发整机研制主体", "discovered_at": "2026-11-11T00:15:08.239058"}, {"source": "中国航发", "relation": "航材院上级集团", "discovered_at": "2026-11-11T00:15:08.239060"}, {"source": "粉末冶金涡轮盘", "relation": "与单晶叶片并列为航发核心材料支柱", "discovered_at": "2026-11-11T00:15:08.239065"}, {"source": "粉末冶金涡轮盘", "relation": "全链条自主量产（待核实）", "discovered_at": "2026-11-11T00:15:08.239068"}, {"source": "复合材料风扇叶片", "relation": "大涵道比涡扇关键部件", "discovered_at": "2026-11-11T00:15:08.239081"}, {"source": "复合材料风扇叶片", "relation": "减重降油耗", "discovered_at": "2026-11-11T00:15:08.239084"}]}, "stats": {"entitiesCount": 9, "relationsCount": 20}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-11T00:15:08.239271", "content": {"agent": "DeepScout", "section": "技术趋势", "facts_count": 9, "duplicates_removed": 0, "data_points_count": 5, "insights": ["材料端（单晶高温合金+粉末涡轮盘）是本轮国产航发进展中证据最集中的环节，且由央媒（中国之声）与航材院总师直接背书，可信度相对较高。", "技术叙事呈现“材料先行”特征：单晶叶片与粉末盘被定位为“一代材料、一代发动机”的核心瓶颈，突破后向整机型号（歼击机、直升机、运输机、大飞机）扩散。", "商用航发（CJ1000A）明确处于适航认证阶段，验证了“增速受适航取证与客户验证周期约束”的判断，但无时间表与节点数据。"], "source_quality": "整体质量偏低至中等。可信度最高的为新华报业网、长江云转载的中央广播电视总台中国之声报道（0.7-0.75），其核心信息源自航材院总师李嘉荣的公开表态，属可追溯的权威媒体转述，但仍是二手转载而非原始发布。今日头条、网易、360doc等自媒体（0.3-0.4）贡献了“批量装机”“反超欧美”“四款合金全打通”等更具冲击力但无法核实的表述，存在夸大与推测风险。全球铁合金网转载央视但正文付费受限，仅能确认标题层面。新浪军事2018年报道时效性不足。所有来源均未提供市场规模、国产化率、交付量等量化数据，且多篇文章实为同一稿件的多平台转载，独立性差，需补充官方公告、上市公司披露与券商行业报告进行交叉验证。", "hypothesis_updates": 3, "search_results": [{"title": "突破航空发动机材料制备关键技术 国产单晶高温合金跻身国际先进行列-钛分站-全球铁合金网", "url": "https://www.qqthj.com/news/202605273540492.html", "source": "全球铁合金网", "snippet": "突破航空发动机材料制备关键技术\n国产单晶高温合金跻身国际先进行列\n发布时间:2026年05月27日\n来源于:央视新闻\n如果说航空发动机是“现代工业皇冠上的明珠”,那么,单晶涡轮叶片就是在“明珠上镶钻”``````\n扫码下载APP\n咨询电话:028-60869083\n对不起,当前内容只对会员开放\n登录后即可查看全部信息\n非会员注册可获赠7天免费试用\n免责声明:凡在本网站出现的信息,均仅供参考,并不构成对用户决策的直接建议,本网站将尽力确保所提供的信息准确可靠、客观公正,但不保证信息全部或部分内容的准确性、真实性、完整性、有效性、及时性、原创性等,用户在使用前请进一步核实,并对任何自主决策的行为负责,本网站对有关信息所引致的错误、不确或遗漏,概不负任何法律责任(包括侵权责任、合同责任和其它责任);任何单位或个人通过本网站网页而链接及得到的资讯、产品及服务,本网站概不负责,亦不负任何法律责任;任何认为本网站中的网页或链接内容可能涉嫌侵犯其知识产权,应及时向本网站提出书面权利通知,并提供身份证明、权属证明及详细侵权情况证明,本网站在收到上述合法文件后,将会尽快删除相关内容或断开相关链接。", "date": "2026-05-27T00:00:00+08:00"}, {"title": "国产发动机重大突破:1500度单晶叶片装机,性能反超欧美 - 今日头条", "url": "https://www.toutiao.com/article/7646802008947360302/", "source": "今日头条", "snippet": "2026年5月底,中国航发航材院七十周年院庆。圈里人都在传一个好消息:能扛1500°C的单晶涡轮叶片,已经成批装上了飞机发动机。配套的粉末涡轮盘,也实现了从头到尾全自主量产。一个扛高温,一个扛大力气,这俩玩意儿凑齐了,现代航发最硬的两块骨头就算补齐了。盯着这行看了很多年的人都明白,这条消息分量不轻。行内有句老话——\"一代材料,一代发动机\"。图纸画得再漂亮,材料跟不上,发动机就上不了天。过去几十年,咱们航发被人卡得最狠的地方就是材料。单晶叶片更是榜上有名的\"老大难\"。现在航材院把DD6、DD9、DD15、DD13四款单晶合金一字摆开,研发、工艺、装机一条龙全打通,歼击机、直升机、运输机、大飞机的发动机上都开始用了。聊单晶叶片之前,先得说说它要干啥活。航发涡轮前那一截,燃气温度一千四五百度,比火山岩浆还烫。叶片本身一分钟转上万转,每片叶子承受的离心力,相当于几吨重的东西吊在尾巴上甩。再加上几十倍大气压的高温燃气日夜怼着烧。普通钢铁丢进去,几秒钟就成铁水了。能在这种环境里转几千小时不出毛病,配得上\"皇冠上的明珠\"这个名头。为了搞出这片叶子,人类换过好几茬材料。最早是普通高温合金,几百度还能凑合,再高就趴窝。后来工程师琢磨出定向凝固,让晶粒沿着受力方向排队站好,性能往上提了一截。可晶粒和晶粒之间那条缝还在,裂纹偏偏就爱从这种地方钻出来。一直拖到单晶叶片出来,事儿才算真办成——整片叶子就是一颗完整晶体,里头压根没有晶界,裂纹连个落脚的地方都找不着。单晶叶片走到今天,已经是第四代了。第一代是美国普惠的PWA1480,把\"能不能造出来\"这个问题解决了。第二代往镍基里加铼元素,CMSX-4、PWA1484是代表作,成了西方航发的标配。三代、四代接着往里加稀有金属,性能拉满,价钱也拉满。铼这东西全球一年就产几十吨,谁能压低铼用量还保住性能,谁就掌握了主动。中国这几年下的功夫,刚好就在这个刀刃", "date": "2026-06-02T22:17:00+08:00"}, {"title": "中国单晶叶片成品率大幅度提高 歼20将获更强劲航发中国歼-20航空发动机_新浪军事_新浪网", "url": "http://mil.news.sina.com.cn/jssd/2018-09-01/doc-ihiixzkm3171323.shtml", "source": "新浪网新闻中心", "snippet": "近日中国相关单位公开了“航空发动机单晶叶片典型铸造缺陷全过程控制技术”,通过这个技术研究,国产航空发动机单晶叶片取得了长足进展,尤其是成品率大为提高,标志着国产发动机研制尤其是制造技术向前迈进了一大步。 单晶叶片是现代航空发动机关键技术和部件,航空发动机一个重要指标就是涡轮前温度,这个指标越高,发动机推力也就越大,不过燃烧室出来的燃气温度高达上千度,已经超过了钢铁的熔点,在如此高温、高速、高压燃气冲击之下,高压涡轮还要高速旋转带动高压压气机,因此对于材料和工艺要求极高,单晶叶片就是高压涡轮叶片最理想的材料,所谓单晶叶片是指只有一个晶料的叶片,晶界平行应力方向,消除了空洞和裂纹,这样叶片才能抵御发动机燃气冲击,可靠性更高,因此单晶叶片已经成为现代航空发动机高压涡轮叶片主流材料。 看起来毫不起眼的航空发动机叶片却是当今材料领域最尖端技术的结晶 它承受的温度已经超过了钢铁的熔点 内部结构是关键 不过单晶叶片性能虽好,但是制造起来非常困难,因为它几乎要求叶片所有原子排列一致,难度可想而知,并且叶片里面还要有冷却空气通道,因此看起来小小的涡轮叶片,但是对于设计、材料、加工、工艺等方面非常高,稍有一慎就有可能造成产品报废,单晶叶片缺陷控制及成品率是制约它应用一个难题,发达国家也是经过多番努力才实现单晶叶片稳定生产。 中国相关单位从上世纪70年代开始研制单晶高温合金,由于当时经济技术实力不足,工业基础也比较薄弱,一直到90年代才研制出第1代单晶叶片,从技术上来讲,它相当于国外70年代末第1代单晶叶片,在此基础上相关单位研制了第2代单晶高温合金,并且在新世纪进入实用,2016年国内相关单位又展出国产第3代单晶叶片,从航展介绍来看,它采用了国产第3代单晶高温合金、双层壁冷技术,耐高温、高压等方面性能较以前产品又有较大提高。 珠海航展公开的国产第二代单晶高温合金涡轮叶片 珠海航展公开的国产第三", "date": "2018-09-01T10:14:00+08:00"}, {"title": "国产材料新突破 我国已掌握航空发动机材料制备全链条技术_单晶_叶片_涡轮", "url": "https://www.sohu.com/a/1030352661_121123900?scm=10001.8085_13-8085_13.0.0-0-0-0-0.0", "source": "搜狐", "snippet": "导读:如果说航空发动机是“现代工业皇冠上的明珠”,那么,单晶涡轮叶片就是在“明珠上镶钻”。航空涡轮发动机的本质就是一台能量转换装置,它把航空燃油的化学能,通过燃烧转化为高温高压热能,再推动涡轮旋转转变为机械能,最终转化为飞机的动能。发动机热端部件耐受温度越高,能量转换效率就越高,发动机推力更大、油耗更低、综合性能也更强。目前商用发动机涡轮前温度可达1500°C以上。军用航空发动机为实现极限战术动作,极限工作温度还要更高。所以,单晶叶片的工作条件极为苛刻,是决定发动机性能、可靠性与寿命的关键因素,也是衡量一个国家航空制造水平的重要标志。目前,我国单晶涡轮叶片处于怎样的水平?自主技术革新是如何赋能航空发动机核心研发的?1956年5月26日诞生的中国航发北京航空材料研究院见证了我国航空材料事业从跟跑到并跑、局部领跑的征途。如今,中国航发航材院专职总师李嘉荣带领团队发明的具有自主知识产权的单晶高温合金已达到国际先进水平。\n中国航发航材院专职总师\n李嘉荣:我们实现了中国的单晶涡轮叶片材料自主研制,其中第二代单晶高温合金DD6,性能优于或相当于欧美大量应用的第二代单晶高温合金,而且使用成本更低,DD6已经成为目前我国应用量最大的单晶高温合金,为国家节约大量战略资源。李嘉荣带领团队还揭示了单晶涡轮叶片结晶与再结晶缺陷形成机理及晶体生长机制,突破复合气冷与双层壁超冷单晶涡轮叶片制备关键技术。\n李嘉荣:多年来,航材院研制交付的单晶涡轮叶片,在多型先进航空发动机上获得应用,为以先进歼击机为代表的军民用飞机、直升机提供了先进材料支撑。单晶涡轮叶片的核心使命,就是在超高温、高压、高转速、腐蚀性燃气冲刷的严苛环境下,长期安全、稳定、可靠服役。\n中国航发航材院高温合金材料研究所科研人员\n岳晓岱:单晶叶片工作时不仅要承受足以熔化普通钢材的超高温,还要承受燃气大力冲刷。叶片绝不能出现拉长、变形;哪怕仅仅", "date": "2026-06-01T08:00:00+08:00"}, {"title": "国产复合材料叶片研制成功，国产航空发动机将获得更强性能", "url": "https://www.360doc.cn/article/0_887679156.html", "source": "360doc个人图书馆", "snippet": "近日,江苏新扬新材料股份有限公司的“航空航天用高性能复合材料及结构件的关键技术研发与产业化”获奖,在该公司的先进事迹之中提到他们参与研制的复合材料风扇叶片已经进入试制件生产阶段,标志着中国已经掌握了这个关键技术,为国产大涵道比涡扇发动机性能升级打下了坚实的基础。 根据江苏新扬公司透露的信息,国产复合材料风扇叶片将会用于CJ系列大涵道发动机,包括CJ1000A发动机,后者是C919客机配套发动机,CJ1000A换上复合材料风扇叶片之后,性能更好,耗油率更低,可以让C919客机性能向前再迈进一步,有效增强了客机在国内外市场的竞争能力。\n C919客机目前使用的LEAP-X1C发动机 对于大涵道比涡扇发动机来说,风扇叶片是关键部件之一。它的作用就是将空气吸入,为燃烧室提供源源不断能量,所以风扇叶片性能好坏很大程度决定着发动机性能。从涡扇发动机原理我们可以知道,发动机涵道比越大,油耗越低,因此现代民用客机发动机涵道比呈现增加趋势。 不过这样就产生一个问题,那就是发动机涵道比越大,风扇直径相应也会增加,重量随之上升,根据相关资料,风扇质量已经占据到发动机整机重量三分之一左右。风扇重量增加之后,还会带动机匣、传动系统重量上升,飞机机体和结构重量也要跟着增加,结果致飞机结构重量提高,降低飞机经济性。 这样就产生一个矛盾,想提高涵道比必须采用更大风扇叶片,但是更大风扇叶片又意味着更大的重量,又会影响飞机经济性,为了解决这个问题复合材料叶片就出现了。\n使用了复合材料的风扇叶片 C919客机的LEAP发动机就采用了复合材料叶片,发动机重量比采用钛合金叶片的发动机减少接近500公斤,加上机体降低重量,飞机结构重量降低1000公斤左右,这对于客机来说会产生非常大经济效益。另外一方面复合材料也要比金属更好加工,更容易制成复杂曲面,这样叶片工作的时候会更加贴和气流,提高工作效率。 中国相关单位研制第一", "date": "2020-01-24T08:00:00+08:00"}, {"title": "国产发动机重大突破:1500度单晶叶片装机,性能反超欧美 - 今日头条", "url": "https://www.toutiao.com/article/7646322723504898598/", "source": "今日头条", "snippet": "【本文仅在今日头条发布,谢绝转载】本文作者——岳梦泽|飞行器设计博士生,飞机制造技术教师2026年5月底,中国航发航材院七十周年院庆之际,传出实打实的好消息:耐1500°C高温的单晶涡轮叶片已批量装机,粉末涡轮盘也实现全链条自主可控量产。这两款产品凑在一块,一个扛高温、一个承强载,构成了现代航空发动机最核心的材料支柱。航发历来有个说法——“一代材料,一代发动机”。材料上不去,设计再漂亮也是纸上谈兵。单晶涡轮叶片这个环节,中国曾经被卡过脖子,现在不但追了上来,部分型号已开始并跑甚至领跑。现在航材院直接搞出DD6单晶叶片,材料研发、体系构建、批量列装一条龙,多型先进航发都在批量装机,歼击机、直升机、民用大飞机全都能用,主打一个腰杆子硬气!不同钎缝间隙的DD6接头在980°C下的抗拉强度涡轮叶片有多难造航空发动机涡轮叶片的工作环境堪称“地狱级”:温度超1500°C,比火山岩浆还烫;转速每分钟上万转,单片叶片承受的离心力相当于好几吨重物挂在上面;燃气几十倍大气压昼夜冲刷。普通金属材料放到这种环境里,几秒钟化成铁水。C919未来将换装CJ1000A国产航发涡轮叶片被称为航发上的“皇冠明珠”一点不夸张,它直接决定发动机能飞多快、推多大、靠不靠谱。没有这个底子,先进战机和大飞机都是空谈。材料进化:从合金到单晶人类为了造出能扛住这种环境的叶片,材料路线换了好几茬。最早是普通高温合金,几百度还能应付,温度再往高走就扛不住。后来搞出定向凝固叶片,让晶粒顺着受力方向排列,力学性能好了不少,但晶界这个软肋还在——晶粒接缝处依然是裂纹最容易萌生和扩展的地方。航发叶片材料的三个时代直到单晶叶片出现,局面才真正打开。整块材料就是一个晶体,内部完全没有晶界,消除了裂纹最喜欢的“老巢”,强度和耐高温性能一下子上了一个大台阶。从上世纪八十年代起,单晶叶片就成了现代先进航发的标配。这条路线至今经历了四代演进。第", "date": "2026-06-01T15:19:00+08:00"}, {"title": "国产材料新突破 我国已掌握航空发动机材料制备全链条技术", "url": "https://www.xhby.net/content/s6a14f88ce4b0e575e19bf6e9.html", "source": "新华报业网", "snippet": "2026/05/26\n09:34\n中央广播电视总台中国之声\n如果说航空发动机是“现代工业皇冠上的明珠”,那么,单晶涡轮叶片就是在“明珠上镶钻”。\n航空涡轮发动机的本质就是一台能量转换装置,它把航空燃油的化学能,通过燃烧转化为高温高压热能,再推动涡轮旋转转变为机械能,最终转化为飞机的动能。\n发动机热端部件耐受温度越高,能量转换效率就越高,发动机推力更大、油耗更低、综合性能也更强。目前商用发动机涡轮前温度可达1500°C以上。军用航空发动机为实现极限战术动作,极限工作温度还要更高。所以,单晶叶片的工作条件极为苛刻,是决定发动机性能、可靠性与寿命的关键因素,也是衡量一个国家航空制造水平的重要标志。\n目前,我国单晶涡轮叶片处于怎样的水平?自主技术革新是如何赋能航空发动机核心研发的?\n1956年5月26日诞生的中国航发北京航空材料研究院见证了我国航空材料事业从跟跑到并跑、局部领跑的征途。\n如今,中国航发航材院专职总师李嘉荣带领团队发明的具有自主知识产权的单晶高温合金已达到国际先进水平。\n中国航发航材院专职总师\n李嘉荣:我们实现了中国的单晶涡轮叶片材料自主研制,其中第二代单晶高温合金DD6,性能优于或相当于欧美大量应用的第二代单晶高温合金,而且使用成本更低,DD6已经成为目前我国应用量最大的单晶高温合金,为国家节约大量战略资源。\n李嘉荣带领团队还揭示了单晶涡轮叶片结晶与再结晶缺陷形成机理及晶体生长机制,突破复合气冷与双层壁超冷单晶涡轮叶片制备关键技术。\n李嘉荣:多年来,航材院研制交付的单晶涡轮叶片,在多型先进航空发动机上获得应用,为以先进歼击机为代表的军民用飞机、直升机提供了先进材料支撑。\n单晶涡轮叶片的核心使命,就是在超高温、高压、高转速、腐蚀性燃气冲刷的严苛环境下,长期安全、稳定、可靠服役。\n中国航发航材院高温合金材料研究所科研人员\n岳晓岱:单晶叶片工作时不仅要承受足以熔化普通钢", "date": "2026-05-26T09:34:00+08:00"}, {"title": "国产航发CJ1000告别钛合金,迎来复材叶片!能否让C919一飞冲天?cj发动机c919航空工业_网易订阅", "url": "https://www.163.com/dy/article/J12DRCS50553OUEU.html", "source": "网易", "snippet": "随着我国航空工业的飞速发展,国产大飞机C919的国产配套发动机CJ1000A的研发进程同样也备受关注。前不久,有关部门发布通知,中国将“推动航空工业全面发展大型飞机、大型水陆两栖飞机和发动机的总装集成能力和供应链支持能力”。复合材料风扇叶片相较于钛合金叶片拥有更多优势,包括但不限于高比强度、高比刚度、耐高温性能、较高的疲劳寿命和损伤容忍性等。这些特性使得复合材料风扇叶片在提升发动机性能、降低运营成本以及延长使用寿命等方面发挥着至关重要的作用。因此,自2011年起,我国便确定将复合材料风扇叶片作为CJ1000A发动机的标准配置。目前,CJ1000A发动机正处于紧锣密鼓的适航认证阶段。这一阶段对于确保发动机的安全性和可靠性至关重要,它涉及广泛的地面测试和飞行测试,以验证发动机的设计和性能是否符合国际民航组织的标准和规定。", "date": "2024-04-30T23:20:17+08:00"}, {"title": "国产材料新突破 我国已掌握航空发动机材料制备全链条技术_长江云 - 湖北网络广播电视台官方网站", "url": "https://news.hbtv.com.cn/p/4606569.html", "source": "长江云", "snippet": "中央广播电视总台中国之声\n2026-05-26\n09:17:10\n如果说航空发动机是“现代工业皇冠上的明珠”,那么,单晶涡轮叶片就是在“明珠上镶钻”。\n航空涡轮发动机的本质就是一台能量转换装置,它把航空燃油的化学能,通过燃烧转化为高温高压热能,再推动涡轮旋转转变为机械能,最终转化为飞机的动能。\n发动机热端部件耐受温度越高,能量转换效率就越高,发动机推力更大、油耗更低、综合性能也更强。目前商用发动机涡轮前温度可达1500°C以上。军用航空发动机为实现极限战术动作,极限工作温度还要更高。所以,单晶叶片的工作条件极为苛刻,是决定发动机性能、可靠性与寿命的关键因素,也是衡量一个国家航空制造水平的重要标志。\n目前,我国单晶涡轮叶片处于怎样的水平?自主技术革新是如何赋能航空发动机核心研发的?\n1956年5月26日诞生的中国航发北京航空材料研究院见证了我国航空材料事业从跟跑到并跑、局部领跑的征途。\n如今,中国航发航材院专职总师李嘉荣带领团队发明的具有自主知识产权的单晶高温合金已达到国际先进水平。\n中国航发航材院专职总师\n李嘉荣:我们实现了中国的单晶涡轮叶片材料自主研制,其中第二代单晶高温合金DD6,性能优于或相当于欧美大量应用的第二代单晶高温合金,而且使用成本更低,DD6已经成为目前我国应用量最大的单晶高温合金,为国家节约大量战略资源。\n李嘉荣带领团队还揭示了单晶涡轮叶片结晶与再结晶缺陷形成机理及晶体生长机制,突破复合气冷与双层壁超冷单晶涡轮叶片制备关键技术。\n李嘉荣:多年来,航材院研制交付的单晶涡轮叶片,在多型先进航空发动机上获得应用,为以先进歼击机为代表的军民用飞机、直升机提供了先进材料支撑。\n单晶涡轮叶片的核心使命,就是在超高温、高压、高转速、腐蚀性燃气冲刷的严苛环境下,长期安全、稳定、可靠服役。\n中国航发航材院高温合金材料研究所科研人员\n岳晓岱:单晶叶片工作时不仅要承受足以熔化", "date": "2026-05-26T09:17:10+08:00"}], "extracted_facts": [{"content": "中国航发北京航空材料研究院已实现单晶涡轮叶片材料自主研制，第二代单晶高温合金DD6性能优于或相当于欧美大量应用的第二代单晶高温合金，且使用成本更低，已成为目前我国应用量最大的单晶高温合金。", "source_name": "新华报业网（转载中央广播电视总台中国之声，引述航材院专职总师李嘉荣）", "source_url": "https://www.xhby.net/content/s6a14f88ce4b0e575e19bf6e9.html", "credibility": 0.75}, {"content": "航材院团队揭示了单晶涡轮叶片结晶与再结晶缺陷形成机理及晶体生长机制，突破复合气冷与双层壁超冷单晶涡轮叶片制备关键技术，我国单晶高温合金已达国际先进水平，实现从跟跑到并跑、局部领跑。", "source_name": "长江云（转载中央广播电视总台中国之声）", "source_url": "https://news.hbtv.com.cn/p/4606569.html", "credibility": 0.7}, {"content": "目前商用航空发动机涡轮前温度可达1500°C以上，军用航发极限工作温度更高；单晶叶片工作条件苛刻，是决定发动机性能、可靠性与寿命的关键因素。", "source_name": "搜狐（转载中国之声报道）", "source_url": "", "credibility": 0.5}, {"content": "自媒体称2026年5月底航材院七十周年院庆时，耐1500°C单晶涡轮叶片已批量装机，粉末涡轮盘实现全链条自主可控量产；DD6、DD9、DD15、DD13四款单晶合金研发、工艺、装机全打通，用于歼击机、直升机、运输机、大飞机发动机。", "source_name": "今日头条（自媒体，作者岳梦泽）", "source_url": "https://www.toutiao.com/article/7646322723504898598/", "credibility": 0.3}, {"content": "国产复合材料风扇叶片已进入试制件生产阶段，将用于CJ系列大涵道比发动机（含C919配套的CJ1000A），可降低油耗、提升性能。", "source_name": "360doc个人图书馆（转述江苏新扬新材料公司信息）", "source_url": "https://www.360doc.cn/article/0_887679156.html", "credibility": 0.3}, {"content": "我国自2011年起确定将复合材料风扇叶片作为CJ1000A发动机标准配置；CJ1000A目前处于适航认证阶段，涉及广泛地面测试和飞行测试，以验证设计性能是否符合国际民航组织标准。", "source_name": "网易（自媒体）", "source_url": "https://www.163.com/dy/article/J12DRCS50553OUEU.html", "credibility": 0.4}, {"content": "有关部门发布通知，中国将“推动航空工业全面发展大型飞机、大型水陆两栖飞机和发动机的总装集成能力和供应链支持能力”，体现政策层面对航发总装与供应链能力的支持。", "source_name": "网易（自媒体，引述政策通知）", "source_url": "https://www.163.com/dy/article/J12DRCS50553OUEU.html", "credibility": 0.4}, {"content": "中国相关单位公开“航空发动机单晶叶片典型铸造缺陷全过程控制技术”，国产单晶叶片成品率大幅提高，标志制造技术向前迈进；中国自上世纪70年代开始研制单晶高温合金。", "source_name": "新浪军事", "source_url": "http://mil.news.sina.com.cn/jssd/2018-09-01/doc-ihiixzkm3171323.shtml", "credibility": 0.55}], "data_points": [{"name": "单晶高温合金牌号", "value": "DD6（第二代）", "unit": "", "year": 2026, "source": "新华报业网（转载中央广播电视总台中国之声，引述航材院专职总师李嘉荣）"}, {"name": "商用航发涡轮前温度", "value": ">1500", "unit": "°C", "year": 2026, "source": "搜狐（转载中国之声报道）"}, {"name": "单晶合金牌号数量", "value": "4（DD6/DD9/DD15/DD13）", "unit": "款", "year": 2026, "source": "今日头条（自媒体，作者岳梦泽）"}, {"name": "单晶叶片耐温", "value": "1500", "unit": "°C", "year": 2026, "source": "今日头条（自媒体，作者岳梦泽）"}, {"name": "复材风扇叶片选型年份", "value": "2011", "unit": "年", "year": 2011, "source": "网易（自媒体）"}]}}

data: {"type": "thought", "agent": "DeepScout", "timestamp": "2026-11-11T00:15:08.239318", "content": {"agent": "DeepScout", "content": "追溯原始数据源: 中央广播电视总台中国之声 国产材料新突破 航空发动机材料制备全链条技术 原文, 中国航发北京航空材料研究院 七十周年 单晶涡轮叶片 粉末涡轮盘 官方发布"}}

data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-11T00:15:08.239364", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["中央广播电视总台中国之声 国产材料新突破 航空发动机材料制备全链条技术 原文", "中国航发北京航空材料研究院 七十周年 单晶涡轮叶片 粉末涡轮盘 官方发布"], "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T00:15:09.367538", "content": {"results": [{"id": "sr_81a4b3", "title": "解析中国制造的重大突破...航空发动机、中国高铁、C...... - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/video/7580372839950287396/", "snippet": "展开解析中国制造的重大突破...航空发动机、中国高铁、C......播放\n3发布于\n2025-12-06\n21:07", "date": "2025-12-06T21:07:00+08:00"}, {"id": "sr_ea812d", "title": "央视官宣好消息:歼-35已装国产发动机,超材料技术全球独有_战机_中国_突破", "source": "搜狐", "url": "https://www.sohu.com/a/939834726_122380369?scm=10001.327_13-327_13-61_61.0-0.0.0", "snippet": "央视官宣好消息:歼-35已装国产发动机,超材料技术全球独有\n中国舰载战机迎来重大突破!国产心脏\n黑科技震撼全球\n9月27日,央视一则重磅新闻引爆国内外军事圈:我国新一代舰载战斗机歼-35成功换装国产发动机,并首次应用全球领先的超材料技术。这不仅是一架战机的升级,更是中国航空工业里程碑式的跨越。\n【国产心脏跳动强劲】\n困扰中国航空数十年的心脏病终于治愈!歼-35搭载的全新国产发动机,标志着我国彻底摆脱了对进口发动机的依赖。这款中国心采用创新设计,在推力、耐久性和燃油效率等方面实现全面突破。特别值得骄傲的是,从原材料冶炼到精密制造,每个环节都实现了100%国产化。\n【黑科技改写游戏规则】\n更令人振奋的是战机采用的超材料技术。这种革命性材料通过微观结构设计,赋予战机三大超凡特性:\n1.\n智能温控:发动机核心部件可自动调节温度,寿命提升300%\n2.\n极致轻量化:强度不变的情况下重量减轻40%\n3.\n自修复能力:微小损伤可自动修复\n目前全球仅中国实现该技术的实战化应用,领先美国实验室阶段至少3-5年。\n【双剑合璧战力飙升】\n两项突破的完美结合让歼-35脱胎换骨:\n?\n作战半径扩大25%\n?\n机动性能提升30%\n?\n维护周期缩短50%\n军事专家评价,这标志着中国成为继美国之后,全球第二个掌握完整舰载机技术的国家。\n【产业链全面升级】\n背后是令人惊叹的工业进化:\n?\n新材料:突破12项特种材料技术\n?\n新工艺:开发9种精密制造方法\n?\n新标准:建立完整质量体系\n这些成果将辐射到民航、航天等领域,预计带动万亿级产业升级。\n【未来已来】\n歼-35的突破只是开始,其技术将衍生出:\n?\n第六代战机\n?\n舰载无人机群\n?\n空天一体作战平台\n正如央视评论:这不是终点,而是中国智造的新起点。\n这次突破生动诠释了什么是厚积薄发。从跟跑到领跑,中国航空工业用实力证明:核心技术是买不来的,必须靠自己创造", "date": "2025-09-29T15:11:00+08:00"}, {"id": "sr_ef8418", "title": "中国航空发动机材料又获突破 涡轮叶片重量降低。https://mil.sina._航发控制(000738)股吧_东方财富网股吧", "source": "东方财富网股吧", "url": "http://gubaf10.eastmoney.com/news,gssz,768097422.html", "snippet": "最近访问: 中国航空发动机材料又获突破 涡轮叶片重量降低。https://mil.sina.cn/sd/2018-06-07/detail-ihcqccip8262208.d.html?from=wap 郑重声明:用户在财富号/股吧/博客等社区发表的所有信息(包括但不限于文字、视频、音频、数据及图表)仅代表个人观点,与本网站立场无关,不对您构成任何投资建议,据此操作风险自担。 请勿相信代客理财、免费荐股和炒股培训等宣传内容,远离非法证券活动。请勿添加发言用户的手机号码、公众号、微博、微信及QQ等信息,谨防上当受骗! 作者:您目前是匿名发表 郑重声明:用户在社区发表的所有资料、言论等仅代表个人观点,与本网站立场无关,不对您构成任何投资建议。用户应基于自己的独立判断,自行决定证券投资并承担相应风险。《东方财富社区管理规定》扫一扫下载APP 东方财富产品 扫一扫下载APP 基金交易 关注天天基金 扫一扫下载APP 期货交易", "date": "2018-06-22T08:46:41+08:00"}, {"id": "sr_3889a9", "title": "[转载]央视报道:中国复合材料加工技术再获突破_博客_东方财富网", "source": "东方财富博客", "url": "https://blog.eastmoney.com/m3759094152329726/blog_220132730.html", "snippet": "原文地址:央视报道:中国复合材料加工技术再获突破 作者:投资略 ?央视报道:中国复合材料加工技术再获突破 助研新一代战机 中国复合材料加工技术再获突破 助研新一代战机 中国军情 中国新闻网 2014年11月20日14:30A-A 我要分享 原标题:中国复合材料加工技术再获突破 助研新一代战机 中航工业制造所面对国外复合材料铺放工艺与装备技术飞速发展,结合我国航空武器装备的需求,于2006年组建技术攻关团队,瞄准工程化应用,向复合材料自动化铺放制造技术发起挑战。多年来,该团队在各方支持下,经过不懈努力,已基本掌握了复合材料自动铺放制造工艺及装备的关键技术,总体水平处于国内领先地位,为国内该项技术在航空领域的推广应用做了大量的技术储备,也为我国航空制造技术整体水平的提升打下了坚实基础。 填补空白 一枝独秀 多年来,基于复合材料预浸料的铺放均以手工工艺为主,直至“十一五”初期,适用于飞机大型翼面类复合材料结构制造的自动铺带机在国内装备制造领域仍属于空白;与此同时,国内真正用于航空型号生产上的自动铺放装备屈指可数,且全部依赖于进口,极大地禁锢了航空制造业的生产效率和产品稳定性的进一步提高。为打破这一瓶颈,推进我国航空制造业向自动化、网络化、智能化有序发展,项目组勇敢地啃起了这块“硬骨头”。 五年的勤耕潜研,数不清的日夜攻坚,手工铺叠转化为自动实现的一刻,成功的喜悦浸润了项目组每个人的心田。复合材料自动铺放设备结合相关材料技术、铺放工艺的发展进步,打通了复合材料自动铺放生产流程,填补了国内空白,项目组自豪地说:“我们的整体技术已经达到了国际先进水平,某些方面称得上国际领先!” 如今在国内航空制造领域,这台经过了试验件、装机件实践检验的复合材料铺放设备,可谓是当仁不让的“独一家”。与普通的数控切削设备不同,这台设备具有结构复杂、静动态刚性强、动态性能要求高、联动坐标多、控制复杂等特点,", "date": "2019-04-26T18:00:34+08:00"}, {"id": "sr_414593", "title": "材料难题解决,五大领域发动机同时传来突破消息,动力卡脖子_网易订阅", "source": "网易", "url": "https://www.163.com/dy/article/CSPBTGQE0515DPL2.html", "snippet": "动力一直是中国装备的卡脖子核心部件,不论是汽车、航空飞机、火箭、舰艇还是导弹。可以说发动机始终是我们最为头疼的问题,其中制约最大的就是发动机材料问题。不过经过多年攻关传来了好消息,中国发动机材料取得关键突破,发动机瓶颈解决,发动机好消息也开始不断传来。中南大学粉末冶金国家实验室黄伯云院士团队通过大量实验,开发了一种新型的耐3000°C烧蚀的陶瓷涂层及其复合材料,这一发现有可能为高超声速飞行器的研制铺平道路。于此同时中国发现了占世界7%总储量的铼矿,这种美日等制约中国的稀有金属对于中国不再是难题,更为关键的是最近中国攻克了铼元素精纯提取技术,铼元素提取水平大的国家先进水平,我们完全可以自如的提取发动机必须的铼元素了。目前中国已经掌握了铸造高温合金、变形高温合金、粉末高温合金、氧化物弥散强化合金、钛铝系金属间化合物高温材料等五大类系,760°C高温材料、1200°C高温材料和1500°C高温材料体系完备的材料体系。材料的突破,技术瓶颈的攻克,中国在发动机领域的系列突破也就成为自然而然的事情。奇瑞研制出世界上具备先进水平的汽车发动机并成功出口美国;大型燃气轮机取得关键突破多个国家要抢购;联合循环发动机率先问世,抢占六代机高点;五代发动机峨眉涡扇15震撼亮相;火箭发动机取得动力极限突破,火箭发动机推力达到世界顶尖水平,等等中国发动机领域的突破一下子涌现出来,很多网友都不敢相信这些事真的。成都航宇超合金技术有限公司召开新闻发布会,展示了由该公司研发的高温合金产品、多款航空发动机叶片和燃气轮机叶片,标志着我国航空工业冶炼铸造技术取得重要突破。 《中国制造2025》规划也将航空发动机作为重点发展领域。航空方面关键技术突破外国制约,为祖国赢得空防安全作出贡献!这样关键制造老捏在别国手里,中国会永远落后在别国后面,没主动开发先进发动机能力。空中防务安全就会降一半。现在终于掌握了这项研制技术,", "date": "2017-08-26T15:36:35+08:00"}, {"id": "sr_63d183", "title": "连续旋转爆震冲压发动机有多厉害 超越美国的高超音速技术_新闻频道_中华网", "source": "中华网新闻频道", "url": "https://news.china.com/socialgd/10000169/20241228/47802254_1.html", "snippet": "这些成果不仅展示了中国在高超音速技术上的进步,还反映了材料科学领域的显著提升。每一次航空发动机的革命性进步都离不开材料的进步,这也说明了中国在材料领域取得了巨大成就。", "date": "2024-12-28T12:50:08+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 1}}

data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-11T00:15:16.630550", "content": {"graph": {"nodes": [{"id": "node_0", "name": "中国航发北京航空材料研究院（航材院）", "type": "company", "discovered_at": "2026-11-11T00:15:08.239001"}, {"id": "node_1", "name": "李嘉荣", "type": "person", "discovered_at": "2026-11-11T00:15:08.239014"}, {"id": "node_2", "name": "DD6", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239024"}, {"id": "node_3", "name": "DD9/DD15/DD13", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239034"}, {"id": "node_4", "name": "CJ1000A", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239039"}, {"id": "node_5", "name": "江苏新扬新材料股份有限公司", "type": "company", "discovered_at": "2026-11-11T00:15:08.239050"}, {"id": "node_6", "name": "中国航发", "type": "company", "discovered_at": "2026-11-11T00:15:08.239055"}, {"id": "node_7", "name": "粉末冶金涡轮盘", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239063"}, {"id": "node_8", "name": "复合材料风扇叶片", "type": "technology", "discovered_at": "2026-11-11T00:15:08.239070"}, {"id": "node_9", "name": "航发动力", "type": "company", "discovered_at": "2026-11-11T00:15:16.630279"}, {"id": "node_10", "name": "航发科技", "type": "company", "discovered_at": "2026-11-11T00:15:16.630301"}, {"id": "node_11", "name": "航发控制", "type": "company", "discovered_at": "2026-11-11T00:15:16.630309"}, {"id": "node_12", "name": "应流股份", "type": "company", "discovered_at": "2026-11-11T00:15:16.630316"}, {"id": "node_13", "name": "中航重机", "type": "company", "discovered_at": "2026-11-11T00:15:16.630323"}, {"id": "node_14", "name": "中国商飞（COMAC）", "type": "company", "discovered_at": "2026-11-11T00:15:16.630331"}, {"id": "node_15", "name": "GE Aerospace", "type": "company", "discovered_at": "2026-11-11T00:15:16.630339"}, {"id": "node_16", "name": "Rolls-Royce", "type": "company", "discovered_at": "2026-11-11T00:15:16.630346"}, {"id": "node_17", "name": "Pratt & Whitney", "type": "company", "discovered_at": "2026-11-11T00:15:16.630354"}, {"id": "node_18", "name": "Safran", "type": "company", "discovered_at": "2026-11-11T00:15:16.630361"}, {"id": "node_19", "name": "Honeywell", "type": "company", "discovered_at": "2026-11-11T00:15:16.630370"}, {"id": "node_20", "name": "MTU Aero Engines", "type": "company", "discovered_at": "2026-11-11T00:15:16.630378"}, {"id": "node_21", "name": "CJ-1000A", "type": "technology", "discovered_at": "2026-11-11T00:15:16.630383"}, {"id": "node_22", "name": "WS-20（涡扇-20）", "type": "technology", "discovered_at": "2026-11-11T00:15:16.630393"}, {"id": "node_23", "name": "LEAP-1C", "type": "technology", "discovered_at": "2026-11-11T00:15:16.630401"}, {"id": "node_24", "name": "两机专项", "type": "policy", "discovered_at": "2026-11-11T00:15:16.630409"}, {"id": "node_25", "name": "适航审定（CAAC/FAA/EASA）", "type": "policy", "discovered_at": "2026-11-11T00:15:16.630417"}], "edges": [{"source": "中国航发北京航空材料研究院（航材院）", "relation": "单晶高温合金DD6研发单位", "discovered_at": "2026-11-11T00:15:08.239005"}, {"source": "中国航发北京航空材料研究院（航材院）", "relation": "粉末涡轮盘研制", "discovered_at": "2026-11-11T00:15:08.239008"}, {"source": "中国航发北京航空材料研究院（航材院）", "relation": "李嘉荣团队", "discovered_at": "2026-11-11T00:15:08.239011"}, {"source": "李嘉荣", "relation": "航材院专职总师", "discovered_at": "2026-11-11T00:15:08.239017"}, {"source": "李嘉荣", "relation": "DD6单晶合金发明人", "discovered_at": "2026-11-11T00:15:08.239019"}, {"source": "李嘉荣", "relation": "复合气冷与双层壁超冷叶片技术", "discovered_at": "2026-11-11T00:15:08.239021"}, {"source": "DD6", "relation": "第二代单晶高温合金", "discovered_at": "2026-11-11T00:15:08.239027"}, {"source": "DD6", "relation": "国内应用量最大", "discovered_at": "2026-11-11T00:15:08.239029"}, {"source": "DD6", "relation": "性能对标欧美第二代", "discovered_at": "2026-11-11T00:15:08.239031"}, {"source": "DD9/DD15/DD13", "relation": "后续代次单晶合金（自媒体口径，待核实）", "discovered_at": "2026-11-11T00:15:08.239037"}, {"source": "CJ1000A", "relation": "C919配套国产大涵道比涡扇发动机", "discovered_at": "2026-11-11T00:15:08.239042"}, {"source": "CJ1000A",