data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:26:33.996485", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ncagr = ((600/400)**(1/2)-1)*100\ndata = {'Indicator': ['单晶叶片良品率', '母合金国产化率', '母合金进口依赖度', '航发动力毛利率', '归母净利润同比', '2021-2023市场CAGR'], 'Value': [80, 42, 58, 10.06, -39.48, cagr]}\ndf = pd.DataFrame(data)\ndf['Value'] = pd.to_numeric(df['Value'], errors='coerce')\ndf = df.dropna()\ncolors = ['#10b981' if v >= 0 else '#ef4444' for v in df['Value']]\nplt.figure(figsize=(12, 7), dpi=200)\nbars = plt.barh(df['Indicator'], df['Value'], color=colors)\nfor bar, v in zip(bars, df['Value']):\n    plt.text(v + (2 if v >= 0 else -2), bar.get_y() + bar.get_height() / 2, f'{v:.1f}%', va='center', ha='left' if v >= 0 else 'right', fontsize=12)\nplt.axvline(0, color='black', linewidth=0.8)\nplt.title('国产航空发动机替代：进展与主要风险指标', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('百分比（%）', fontsize=14)\nplt.ylabel('指标', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "选取国产化进展、进口依赖、盈利能力与市场增长等6个关键指标，计算2021-2023年中国航发市场规模CAGR，并用横向条形图对比进展与风险，绿色表示正向进展，红色表示风险或负向指标。"}}

