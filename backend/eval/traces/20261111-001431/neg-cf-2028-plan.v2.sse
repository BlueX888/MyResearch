data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:44:15.460939", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2023, 2024, 2025], 'J20_Output': [100, 110, 120]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nrev = {'Year': [2024, 2025, 2026], 'Revenue': [660.86, 699.70, 749.42]}\ndf2 = pd.DataFrame(rev)\ndf2['Revenue'] = pd.to_numeric(df2['Revenue'], errors='coerce')\ndf2 = df2.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nax1.plot(df['Year'], df['J20_Output'], linewidth=2.5, marker='o', markersize=8, color='#6366f1')\nax1.fill_between(df['Year'], df['J20_Output'], alpha=0.15, color='#6366f1')\nax1.set_title('歼-20年产量估算趋势', fontsize=16, fontweight='bold')\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('产量（架）', fontsize=14)\nax1.tick_params(labelsize=12)\nax1.grid(True, linestyle='--', alpha=0.3)\nax2 = axes[1]\nbars = ax2.bar(df2['Year'].astype(str), df2['Revenue'], color='#06b6d4')\nfor b in bars:\n    ax2.text(b.get_x() + b.get_width() / 2, b.get_height(), f'{b.get_height():.0f}', ha='center', va='bottom', fontsize=11)\nax2.set_title('承诺营业收入（排产强度代理指标）', fontsize=16, fontweight='bold')\nax2.set_xlabel('年份', fontsize=14)\nax2.set_ylabel('营业收入（亿元）', fontsize=14)\nax2.tick_params(labelsize=12)\nax2.grid(True, linestyle='--', alpha=0.3, axis='y')\nsns.despine()\nplt.suptitle('成飞2028年排产计划：公开数据未披露，仅可作趋势推断', fontsize=18, fontweight='bold')\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "核心结论：公开数据中成飞2028年各型号排产计划明确标注为“未披露”，可验证数据点为0项。因此本分析不做虚构排产，而是用可验证的产能与营收趋势做推断性可视化：(1) 歼-20年产量估算趋势（2023约100架、2024约110架、2025约120架）；(2) 成飞承诺营业收入（2024-2026）作为排产强度的代理指标。双图并列，突出“2028年具体型号排产未公开”这一事实边界。"}}

