data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-11T00:44:06.053706", "content": {"charts": [{"id": "chart_001", "title": "歼-20年产量趋势", "subtitle": "2023—2024年推算/评估值（架）｜2028年排产数据暂缺", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "6%", "bottom": "3%", "top": "18%", "containLabel": true}, "tooltip": {"trigger": "axis"}, "xAxis": {"type": "category", "data": ["2023", "2024"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "架", "nameTextStyle": {"color": "#999"}, "min": 0, "max": 140, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"name": "歼-20年产量", "type": "line", "data": [100, 110], "smooth": true, "symbol": "circle", "symbolSize": 9, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "label": {"show": true, "position": "top", "color": "#1677ff", "formatter": "{c}架"}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.22)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}}]}}, {"id": "chart_002", "title": "成飞“2323”均衡生产季度节奏", "subtitle": "各季度产量占比（%）｜可作为2028年排产节奏参考", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}: {c}%"}, "legend": {"bottom": "2%", "itemWidth": 10, "itemHeight": 10, "textStyle": {"color": "#666"}}, "series": [{"type": "pie", "radius": ["42%", "66%"], "center": ["50%", "46%"], "avoidLabelOverlap": true, "itemStyle": {"borderColor": "#fff", "borderWidth": 2}, "label": {"show": true, "formatter": "{b}\n{c}%", "color": "#666", "fontSize": 12}, "labelLine": {"length": 10, "length2": 8}, "data": [{"name": "第一季度", "value": 20, "itemStyle": {"color": "#1677ff"}}, {"name": "第二季度", "value": 30, "itemStyle": {"color": "#52c41a"}}, {"name": "第三季度", "value": 20, "itemStyle": {"color": "#722ed1"}}, {"name": "第四季度", "value": 30, "itemStyle": {"color": "#fa8c16"}}]}]}}, {"id": "chart_003", "title": "中国军用飞机产量结构", "subtitle": "2023年各机型产量占比（%）", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}: {c}%"}, "legend": {"bottom": "2%", "itemWidth": 10, "itemHeight": 10, "textStyle": {"color": "#666"}}, "series": [{"type": "pie", "radius": ["42%", "66%"], "center": ["50%", "46%"], "itemStyle": {"borderColor": "#fff", "borderWidth": 2}, "label": {"show": true, "formatter": "{b}\n{c}%", "color": "#666", "fontSize": 12}, "labelLine": {"length": 10, "length2": 8}, "data": [{"name": "战斗机", "value": 50, "itemStyle": {"color": "#1677ff"}}, {"name": "运输机", "value": 25, "itemStyle": {"color": "#52c41a"}}, {"name": "直升机", "value": 20, "itemStyle": {"color": "#722ed1"}}, {"name": "其他机型", "value": 5, "itemStyle": {"color": "#d9d9d9"}}]}]}}, {"id": "chart_004", "title": "中国国防支出预算", "subtitle": "2024—2025年（亿元）｜排产计划的宏观支撑", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "6%", "bottom": "3%", "top": "18%", "containLabel": true}, "tooltip": {"trigger": "axis"}, "xAxis": {"type": "category", "data": ["2024", "2025"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "亿元", "nameTextStyle": {"color": "#999"}, "min": 16000, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"name": "国防支出预算", "type": "line", "data": [17000, 17846.65], "smooth": true, "symbol": "circle", "symbolSize": 9, "itemStyle": {"color": "#722ed1"}, "lineStyle": {"width": 3}, "label": {"show": true, "position": "top", "color": "#722ed1", "formatter": "{c}"}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(114,46,209,0.20)"}, {"offset": 1, "color": "rgba(114,46,209,0)"}]}}}]}}, {"id": "chart_005", "title": "中国军工市场规模及预测", "subtitle": "2024年实际 vs 2027年预测（亿元）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "6%", "bottom": "3%", "top": "18%", "containLabel": true}, "tooltip": {"trigger": "axis"}, "xAxis": {"type": "category", "data": ["2024年", "2027年（预测）"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisTick": {"show": false}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "亿元", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "bar", "barWidth": 46, "data": [{"value": 15000, "itemStyle": {"color": "#1677ff"}}, {"value": 22000, "itemStyle": {"color": "#52c41a"}}], "itemStyle": {"borderRadius": [4, 4, 0, 0]}, "label": {"show": true, "position": "top", "color": "#666", "formatter": "{c}"}}]}}]}}

