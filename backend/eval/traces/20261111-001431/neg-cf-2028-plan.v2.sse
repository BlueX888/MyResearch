data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:45:23.590428", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'指标': ['厂区占地', '科研骨干人数', '翼龙-3沙特合同金额', '翼龙-3航程', '翼龙-3最大起飞重量', '翼龙-3挂载能力', '中国军机市场规模', '军机产量', '战斗机产量', '中国军机行业市场规模'], '数值': [500, 5000, 60, 10000, 6, 2, 1500, 600, 300, 1200], '单位': ['公顷', '人', '亿元人民币', '公里', '吨', '吨', '亿元人民币', '架', '架', '亿元人民币']}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = range(len(df))\ny = df['数值'].values\nplt.plot(x, y, marker='o', markersize=8, linewidth=2.5, color='#6366f1')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + max(y)*0.02, str(v), ha='center', fontsize=11)\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('指标', fontsize=14)\nplt.ylabel('数值', fontsize=14)\nplt.xticks(x, df['指标'], rotation=45, ha='right', fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

