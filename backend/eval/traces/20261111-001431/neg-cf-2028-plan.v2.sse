data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T00:50:09.244451", "content": {"results": [{"id": "fact_20fe4c8c", "title": "当地时间2022年3月11日，巴基斯坦空军在卡姆拉举行首批6架歼-10CE战斗机接装仪式，巴基斯坦总理伊姆兰·汗出席。", "source": "北晚在线", "url": "", "snippet": "当地时间2022年3月11日，巴基斯坦空军在卡姆拉举行首批6架歼-10CE战斗机接装仪式，巴基斯坦总理伊姆兰·汗出席。", "date": "", "isSupplementary": true}, {"id": "fact_460085df", "title": "首批歼-10CE正式列装巴基斯坦空军，标志中国新一代航空主战装备实现成体系、成建制出口，是中国航空高新装备出口的重要里程碑。", "source": "看看新闻网", "url": "", "snippet": "首批歼-10CE正式列装巴基斯坦空军，标志中国新一代航空主战装备实现成体系、成建制出口，是中国航空高新装备出口的重要里程碑。", "date": "", "isSupplementary": true}, {"id": "fact_c2ae8812", "title": "歼-10CE战斗机由航空工业自主研制，为全天候、单发、单座、多用途三代+战斗机，具备体系协同作战、强电磁对抗环境下超视距多目标攻击和多模式对地精确打击等能力。", "source": "中国新闻网", "url": "", "snippet": "歼-10CE战斗机由航空工业自主研制，为全天候、单发、单座、多用途三代+战斗机，具备体系协同作战、强电磁对抗环境下超视距多目标攻击和多模式对地精确打击等能力。", "date": "", "isSupplementary": true}, {"id": "fact_242d57f4", "title": "歼-10CE于2019年第六届迪拜航展首次公开亮相，随后在2021年第十三届中国航展上再次公开展示。", "source": "新浪财经", "url": "", "snippet": "歼-10CE于2019年第六届迪拜航展首次公开亮相，随后在2021年第十三届中国航展上再次公开展示。", "date": "", "isSupplementary": true}, {"id": "fact_acbf681b", "title": "此次歼-10CE出口巴基斯坦被表述为正常军贸行为，符合联合国宪章及联合国安理会有关决议、中国政府防扩散等国际承诺与国际义务，以及中国出口管制和军品出口法律法规规...", "source": "看看新闻网", "url": "", "snippet": "此次歼-10CE出口巴基斯坦被表述为正常军贸行为，符合联合国宪章及联合国安理会有关决议、中国政府防扩散等国际承诺与国际义务，以及中国出口管制和军品出口法律法规规定。", "date": "", "isSupplementary": true}, {"id": "fact_7baa6b37", "title": "巴基斯坦是中国航空军贸产品的传统客户与重要合作方，曾装备歼-6、歼-7、强-5等中国战机，并与中国联合研制K8、FC-1“枭龙”战机；歼-10CE交付是继K8、...", "source": "新浪财经", "url": "", "snippet": "巴基斯坦是中国航空军贸产品的传统客户与重要合作方，曾装备歼-6、歼-7、强-5等中国战机，并与中国联合研制K8、FC-1“枭龙”战机；歼-10CE交付是继K8、FC-1“枭龙”后中巴航空防务合作的新进展。", "date": "", "isSupplementary": true}, {"id": "fact_bc6627e3", "title": "2022年中国国防支出预算为14504.5亿元人民币，同比增长7.1%。", "source": "小牛行研", "url": "", "snippet": "2022年中国国防支出预算为14504.5亿元人民币，同比增长7.1%。", "date": "", "isSupplementary": true}, {"id": "fact_7076025f", "title": "2023年中国国防预算为15537亿元，占当年GDP比重为1.23%；2024年中国国防预算为16655.4亿元，按5%左右GDP增长目标测算，占GDP比重约1...", "source": "三个皮匠报告", "url": "", "snippet": "2023年中国国防预算为15537亿元，占当年GDP比重为1.23%；2024年中国国防预算为16655.4亿元，按5%左右GDP增长目标测算，占GDP比重约1.26%。", "date": "", "isSupplementary": true}, {"id": "fact_da73b407", "title": "2017—2023年中国国防预算占GDP比重分别为1.23%、1.20%、1.21%、1.25%、1.19%、1.20%和1.23%，2022年起国防费占GDP...", "source": "三个皮匠报告", "url": "", "snippet": "2017—2023年中国国防预算占GDP比重分别为1.23%、1.20%、1.21%、1.25%、1.19%、1.20%和1.23%，2022年起国防费占GDP比重持续提升，但仍低于欧美军事强国。", "date": "", "isSupplementary": true}, {"id": "fact_2784dacd", "title": "2016—2020年中国国防开支占GDP比重稳定在1.7%至1.8%之间，俄罗斯约4%，美国3%以上，印度2%以上，日本1%以下。该口径与预算口径存在差异，需注...", "source": "小牛行研", "url": "", "snippet": "2016—2020年中国国防开支占GDP比重稳定在1.7%至1.8%之间，俄罗斯约4%，美国3%以上，印度2%以上，日本1%以下。该口径与预算口径存在差异，需注意数据冲突。", "date": "", "isSupplementary": true}, {"id": "fact_9fca3071", "title": "根据《新时代的中国国防》白皮书，2012—2017年中国国防费占GDP平均比重约1.3%，占财政支出平均比重约5.3%，在联合国安理会常任理事国中最低。", "source": "悟空智库/民生证券研究院", "url": "", "snippet": "根据《新时代的中国国防》白皮书，2012—2017年中国国防费占GDP平均比重约1.3%，占财政支出平均比重约5.3%，在联合国安理会常任理事国中最低。", "date": "", "isSupplementary": true}, {"id": "fact_2647102a", "title": "2022年中国国防预算1.45万亿元，同比增长7.1%，按2021年平均汇率折合约2248亿美元；有分析按当年GDP测算其占GDP约1.12%，该测算口径与官方...", "source": "聚汇数据", "url": "", "snippet": "2022年中国国防预算1.45万亿元，同比增长7.1%，按2021年平均汇率折合约2248亿美元；有分析按当年GDP测算其占GDP约1.12%，该测算口径与官方预算占比口径不同。", "date": "", "isSupplementary": true}, {"id": "fact_d904bccf", "title": "过去两三年成飞加快飞机生产厂房建设，目前总面积已达12万平方米；按国际一般飞机脉动生产线规模估算，这些厂房大概能装下10条生产线，且大概率用于歼-20生产线。", "source": "网易订阅", "url": "", "snippet": "过去两三年成飞加快飞机生产厂房建设，目前总面积已达12万平方米；按国际一般飞机脉动生产线规模估算，这些厂房大概能装下10条生产线，且大概率用于歼-20生产线。", "date": "", "isSupplementary": true}, {"id": "fact_3dc1486d", "title": "加拿大《汉和防务评论》称，成飞2014—2015年启动新生产设施建设，2015年底竣工，歼-20小批量试生产最可能2016年开始；高峰时歼-10年产量约14—1...", "source": "新浪军事（转《汉和防务评论》）", "url": "", "snippet": "加拿大《汉和防务评论》称，成飞2014—2015年启动新生产设施建设，2015年底竣工，歼-20小批量试生产最可能2016年开始；高峰时歼-10年产量约14—18架，据此估算歼-20稳定生产阶段年产量不低于歼-10，并推测可能建立两条生产线。", "date": "", "isSupplementary": true}, {"id": "fact_ea27deba", "title": "港媒南华早报称，成飞新建厂房总面积预估12万平方米，按国际一般脉动式生产线规划，每年至少能新增60架歼-20产能；加上原先成飞48架的年生产线，歼-20年度产能...", "source": "腾讯网（转南华早报）", "url": "", "snippet": "港媒南华早报称，成飞新建厂房总面积预估12万平方米，按国际一般脉动式生产线规划，每年至少能新增60架歼-20产能；加上原先成飞48架的年生产线，歼-20年度产能可突破100架；并称2025年中国空军歼-20规模将拥有500架。", "date": "", "isSupplementary": true}, {"id": "fact_0b1f1507", "title": "香港《明报》报道称，成飞12万平方米厂房理论上可配置10条脉动生产线，其中一个大型恒温恒湿厂房面积超过5万平方米，可安装5条脉动生产线；成飞成立5支一对一接装团...", "source": "腾讯网（转香港《明报》）", "url": "", "snippet": "香港《明报》报道称，成飞12万平方米厂房理论上可配置10条脉动生产线，其中一个大型恒温恒湿厂房面积超过5万平方米，可安装5条脉动生产线；成飞成立5支一对一接装团队，被猜测对应5条歼-20脉动生产线；按每条线每月生产1架计算，5条线年产60架，10条线全部生产歼-20则年产120架；考虑1—2条线可能用于歼-10CE，歼-20年产量可能在64—108架之间，约满足2—3个航空旅装备需求；目前歼-20", "date": "", "isSupplementary": true}, {"id": "fact_f9f1a3e4", "title": "新浪看点标题称，成飞明年将开通第四条脉动生产线，生产涡扇-15版歼-20战机；正文未提供更多排产或产能细节。", "source": "新浪看点", "url": "", "snippet": "新浪看点标题称，成飞明年将开通第四条脉动生产线，生产涡扇-15版歼-20战机；正文未提供更多排产或产能细节。", "date": "", "isSupplementary": true}, {"id": "fact_2d3f68b3", "title": "《科技日报》报道称，成飞“黑灯工厂”入选国家首批领航级智能工厂，AI赋能率超50%，支撑先进战机高效批产；2026年5月国企开放日探访成飞无人车间，歼-20等战...", "source": "网易（转《科技日报》）", "url": "", "snippet": "《科技日报》报道称，成飞“黑灯工厂”入选国家首批领航级智能工厂，AI赋能率超50%，支撑先进战机高效批产；2026年5月国企开放日探访成飞无人车间，歼-20等战机结构件实现24小时无人化量产，效率提升1.5倍、人力降低80%以上，夜班仅2人巡检。", "date": "", "isSupplementary": true}, {"id": "fact_5fcd9500", "title": "报道称成飞已实现24小时不停顿量产歼-20系战斗机结构件线；作为对比，美国洛马沃斯堡总装厂F-35生产节奏为48小时/架，可24小时连续运转但需约8000名直接...", "source": "网易", "url": "", "snippet": "报道称成飞已实现24小时不停顿量产歼-20系战斗机结构件线；作为对比，美国洛马沃斯堡总装厂F-35生产节奏为48小时/架，可24小时连续运转但需约8000名直接生产人员三班倒、有人值守，不能实现“关灯无人”。", "date": "", "isSupplementary": true}, {"id": "fact_215b2740", "title": "新浪看点标题称“歼20工厂传来好消息，脉动生产线开工，有望赶超187架F22”；正文未提供成飞2028年各型号排产计划的具体数据。", "source": "新浪看点", "url": "", "snippet": "新浪看点标题称“歼20工厂传来好消息，脉动生产线开工，有望赶超187架F22”；正文未提供成飞2028年各型号排产计划的具体数据。", "date": "", "isSupplementary": true}]}}

