data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:45:36.041830", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'指标': ['翼龙-3挂载能力', '翼龙-3最大起飞重量', '翼龙-3沙特合同金额', '战斗机产量', '厂区占地', '军机产量', '中国军机行业市场规模', '中国军机市场规模', '科研骨干人数', '翼龙-3航程'], '数值': [2, 6, 60, 300, 500, 600, 1200, 1500, 5000, 10000], '单位': ['吨', '吨', '亿元', '架', '公顷', '架', '亿元', '亿元', '人', '公里']}\ndf = pd.DataFrame(data)\ndf = df.sort_values('数值').reset_index(drop=True)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['数值'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgecolor='#6366f1', markeredgewidth=2.5, label='指标数值')\nplt.fill_between(x, y, y.min() * 0.5, color='#6366f1', alpha=0.15)\nfor i, v in enumerate(y):\n    plt.text(i, v * 1.45, str(v) + df['单位'][i], ha='center', fontsize=11, fontweight='bold', color='#312e81')\nplt.yscale('log')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('核心指标', fontsize=14)\nplt.ylabel('指标数值（对数刻度）', fontsize=14)\nplt.xticks(x, df['指标'], rotation=25, ha='right', fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

