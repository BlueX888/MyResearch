data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T00:36:32.500304", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述国防预算、空军装备升级、军机市场规模与军贸出口增速，聚焦公开数据和合法来源。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中国国防预算 航空装备 军机市场规模 军贸出口 2028 预测"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述成飞、沈飞、西飞、洪都及无人机企业的主要型号分工、产能与公开交付信号。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 沈飞 西飞 军机型号 分工 产能 公开信息"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述隐身战机批产、脉动生产线、智能制造、无人机协同和外贸型改进等核心技术趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 脉动生产线 歼-20 产能 智能制造 无人机 公开报道"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、军贸出口管制、国企改革和供应链自主化等相关政策及其影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 军贸出口管制 航空工业 国企改革 政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述产能瓶颈、供应链约束、保密限制、外贸机会和无人机需求等挑战与机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 产能扩建 供应链 军贸 挑战 机遇"]}, {"id": "sec_6", "title": "未来展望", "description": "基于公开信号推断2028年型号组合与排产节奏，强调信息边界和不确定性。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 2028 排产 型号 产能 公开信息 预测"]}], "research_questions": ["在公开信息边界内，哪些信号可用于推断成飞2028年各型号排产节奏？", "成飞2028年排产的主要驱动因素是国防订单、军贸出口还是产能扩建？", "如何区分公开可验证信息与涉密/不可得信息，并形成合规研究结论？"]}}

