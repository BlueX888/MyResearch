data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T14:52:27.251553", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "公司经营与盈利概况", "description": "梳理中航成飞2025年度营业收入、净利润、扣非净利润、经营现金流、未分配利润等关键财务指标，判断利润分配的资金基础。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025年 营业收入 净利润 经营现金流 未分配利润"]}, {"id": "sec_2", "title": "历史分红与同业比较", "description": "分析中航成飞上市以来历年利润分配方案、现金分红比例、股息率，并与军工航空整机及国企上市公司分红水平比较。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 历年 利润分配 现金分红 分红比例 股息率"]}, {"id": "sec_3", "title": "2025年度利润分配预案内容", "description": "查找并核实中航成飞2025年度利润分配预案的具体内容，包括每10股派息金额、现金分红总额、分红比例、是否送转股及决策程序。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025年度 利润分配预案 每10股 派息 分红总额"]}, {"id": "sec_4", "title": "分红政策与监管环境", "description": "分析证监会、交易所关于上市公司现金分红的监管要求，以及国资监管和航空工业集团对上市公司分红考核的政策导向。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["上市公司 现金分红 监管政策 国企 分红考核 航空工业集团"]}, {"id": "sec_5", "title": "分红能力与挑战机遇", "description": "评估中航成飞2025年度利润分配预案的合理性，分析盈利增长、资本开支、研发投入、订单交付等对分红能力的支撑与约束。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 分红能力 资本开支 研发投入 订单 交付 现金流"]}, {"id": "sec_6", "title": "利润分配预案展望与影响", "description": "结合公司发展战略、股东回报规划和行业趋势，展望2025年度利润分配预案的可能方向及其对投资者预期和公司价值的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 股东回报规划 2025 利润分配 展望 投资者关系"]}], "research_questions": ["中航成飞2025年度利润分配预案的具体内容是什么，包括每10股派息金额、现金分红总额和分红比例？", "该预案与公司历史分红水平、公司章程及国企分红监管要求是否一致？", "支撑该利润分配预案的2025年度盈利、现金流和未分配利润基础如何？"]}}

