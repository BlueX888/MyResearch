data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:04:06.423882", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'年份': ['2024年', '2025年'], '营业收入': [650.54, 753.59], '归母净利润': [32.24, 34.32], '加权平均ROE': [30.34, 26.76]}\ndf = pd.DataFrame(data)\ndf['营收指数'] = df['营业收入'] / df['营业收入'].iloc[0] * 100\ndf['净利指数'] = df['归母净利润'] / df['归母净利润'].iloc[0] * 100\ndf['ROE指数'] = df['加权平均ROE'] / df['加权平均ROE'].iloc[0] * 100\nx = np.arange(len(df))\nfig, ax = plt.subplots(figsize=(12,7), dpi=200)\nax.plot(x, df['营收指数'], marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='营业收入指数')\nax.fill_between(x, df['营收指数'], 100, alpha=0.15, color='#6366f1')\nax.plot(x, df['净利指数'], marker='s', markersize=8, linewidth=2.5, color='#10b981', label='归母净利润指数')\nax.fill_between(x, df['净利指数'], 100, alpha=0.15, color='#10b981')\nax.plot(x, df['ROE指数'], marker='^', markersize=8, linewidth=2.5, color='#f59e0b', label='加权平均ROE指数')\nax.fill_between(x, df['ROE指数'], 100, alpha=0.15, color='#f59e0b')\nax.axhline(100, color='#94a3b8', linestyle='--', linewidth=1.2, alpha=0.8)\nrev = df['营业收入'].tolist()\nnpr = df['归母净利润'].tolist()\nroe = df['加权平均ROE'].tolist()\nax.text(x[1], df['营收指数'].iloc[1]+2.5, f'{rev[1]:.2f}亿元', ha='center', fontsize=11, color='#6366f1', fontweight='bold')\nax.text(x[1], df['净利指数'].iloc[1]-4.5, f'{npr[1]:.2f}亿元', ha='center', fontsize=11, color='#10b981', fontweight='bold')\nax.text(x[1], df['ROE指数'].iloc[1]-4.5, f'{roe[1]:.2f}%', ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nax.text(x[0], 102.0, '基准年', ha='center', fontsize=10, color='#64748b')\nax.text(0.02, 0.96, '注：2024年数据由2025年数值及同比增速推算；2025年每10股派现3.86元（含税）', transform=ax.transAxes, fontsize=10, color='#64748b', va='top')\nax.set_xticks(x)\nax.set_xticklabels(df['年份'], fontsize=12)\nax.set_xlim(-0.35, 1.35)\nax.set_ylim(80, 125)\nax.set_xlabel('报告期', fontsize=14)\nax.set_ylabel('指数（2024年=100）', fontsize=14)\nax.set_title('公司经营与盈利概况分析', fontsize=18, fontweight='bold', pad=20)\nax.legend(fontsize=12, loc='upper left', frameon=True)\nax.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 公司经营与盈利概况"}}

