data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:03:22.132329", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'], 'NetProfit': [1.565, 7.563, 12.563, 12.632]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Quarter':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nbars = axes[0].bar(df['Quarter'], df['NetProfit'], color='#6366f1', width=0.6)\nfor b, v in zip(bars, df['NetProfit']):\n    axes[0].text(b.get_x() + b.get_width() / 2, v + 0.25, f'{v:.2f}', ha='center', fontsize=12, fontweight='bold')\naxes[0].set_title('2025年分季度归母净利润', fontsize=16, fontweight='bold', pad=15)\naxes[0].set_xlabel('季度', fontsize=14)\naxes[0].set_ylabel('归母净利润（亿元）', fontsize=14)\naxes[0].tick_params(labelsize=12)\naxes[0].grid(True, linestyle='--', alpha=0.3)\nsns.despine(ax=axes[0])\ndiv = {'Item': ['现金分红', '留存收益'], 'Amount': [10.31, 34.32 - 10.31]}\ndf2 = pd.DataFrame(div)\nfor col in df2.columns:\n    if col != 'Item':\n        df2[col] = pd.to_numeric(df2[col], errors='coerce')\ndf2 = df2.dropna()\nbars2 = axes[1].bar(df2['Item'], df2['Amount'], color=['#10b981', '#06b6d4'], width=0.55)\nfor b, v in zip(bars2, df2['Amount']):\n    axes[1].text(b.get_x() + b.get_width() / 2, v + 0.4, f'{v:.2f}亿元', ha='center', fontsize=12, fontweight='bold')\naxes[1].set_title('2025年度利润分配结构（分红比例30.05%）', fontsize=16, fontweight='bold', pad=15)\naxes[1].set_ylabel('金额（亿元）', fontsize=14)\naxes[1].tick_params(labelsize=12)\naxes[1].grid(True, linestyle='--', alpha=0.3)\nsns.despine(ax=axes[1])\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦2025年度利润分配预案核心信息：每10股派现3.86元（含税）、不送股不转增、分红总额约10.31亿元、分红比例约30.05%。结合分季度归母净利润展示盈利节奏，并用利润分配结构图直观呈现现金分红与留存收益的占比，突出高分红回报特征。"}}

