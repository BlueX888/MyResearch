data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:04:17.550799", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'指标': ['营业收入同比增速', '净利润同比增速', '加权平均ROE', '分红支付率(测算)'], '数值': [15.84, 6.47, 26.76, 30.05]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['数值'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, markeredgecolor='#6366f1', label='2025年度')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 1.2, f'{v:.2f}%', ha='center', fontsize=12, fontweight='bold', color='#4338ca')\nplt.xticks(x, df['指标'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 36)\nplt.title('历史分红与同业比较分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('关键指标', fontsize=14)\nplt.ylabel('数值（%）', fontsize=14)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.legend(fontsize=12, loc='upper left')\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 历史分红与同业比较"}}

