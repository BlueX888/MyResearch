data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T15:05:16.793422", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述航空装备市场规模、增速及中航成飞业务结构，明确军机、民机配套等收入来源对季度分布的影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 季度 营业收入 航空装备 市场规模 增速"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述主要航空装备企业及中航成飞竞争地位，对比中航沈飞、中航西飞等季度收入节奏。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 季报 营业收入 中航沈飞 中航西飞 对比"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述军机批产、民机配套、数字化制造等核心技术趋势及其对交付和收入确认节奏的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 歼-20 批产 民机 C919 配套 收入确认 季度"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、航空装备采购政策及收入确认会计政策对季度营业收入分布的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["2025 国防预算 航空装备 采购 收入确认 季度 政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述交付节奏、供应链稳定性、订单获取等挑战与新型号放量、民机配套等机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 交付 节奏 供应链 风险 订单 机会"]}, {"id": "sec_6", "title": "未来展望", "description": "描述中航成飞季度收入分布趋势，判断哪个季度可能最高及后续年度节奏变化。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 年报 季度 收入 分布 预测 趋势"]}], "research_questions": ["中航成飞2025年各季度营业收入具体数值及占比如何？哪个季度营业收入最高及主要原因是什么？收入确认季节性、交付节奏和政策因素如何影响季度收入分布？"]}}

