data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T20:06:47.287193", "content": {"results": [{"id": "fact_e5dad0c6", "title": "2025年分季度营业收入数据：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.4...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年分季度营业收入数据：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度27,072,785,205.73元。", "date": "", "isSupplementary": true}, {"id": "fact_03d117bc", "title": "2025年全年营业收入为75,358,958,001.86元；2024年调整后营业收入为65,054,925,106.17元；2023年调整后营业收入为77,9...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年全年营业收入为75,358,958,001.86元；2024年调整后营业收入为65,054,925,106.17元；2023年调整后营业收入为77,967,211,871.95元。但搜索结果中未提供2024年及更早年份的分季度营业收入数据。", "date": "", "isSupplementary": true}, {"id": "fact_68f82f4d", "title": "搜索结果中仅包含2025年分季度主要会计数据，未包含2024年及更早年份的分季度营业收入数据，因此无法验证“前低后高、三季见顶”是否为历年稳定季节性规律。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "搜索结果中仅包含2025年分季度主要会计数据，未包含2024年及更早年份的分季度营业收入数据，因此无法验证“前低后高、三季见顶”是否为历年稳定季节性规律。", "date": "", "isSupplementary": true}, {"id": "fact_fc21cd31", "title": "中航成飞2025年分季度营业收入分布为：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年分季度营业收入分布为：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度27,072,785,205.73元。第三季度营业收入最高，第四季度略低于第三季度，第一季度最低。", "date": "", "isSupplementary": true}, {"id": "fact_f9b09e91", "title": "本次检索到的年度报告摘要内容中，未出现合同负债、存货、在手订单等前瞻性指标的具体数值或相关讨论。报告仅披露了分季度营业收入、净利润、扣非净利润和经营活动现金流量...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "本次检索到的年度报告摘要内容中，未出现合同负债、存货、在手订单等前瞻性指标的具体数值或相关讨论。报告仅披露了分季度营业收入、净利润、扣非净利润和经营活动现金流量净额等已实现财务数据，未就上述前瞻性指标对季度收入分布（尤其第三、四季度收入集中）的解释力进行任何分析。这印证了审核发现的问题：报告未实际展开前瞻性指标对季度分布解释力的讨论。", "date": "", "isSupplementary": true}, {"id": "fact_dacd2f93", "title": "年度整体数据显示，2025年归属于上市公司股东的净利润为3,305,093,771.39元，经营活动产生的现金流量净额为-2,542,177,536.87元，加...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "年度整体数据显示，2025年归属于上市公司股东的净利润为3,305,093,771.39元，经营活动产生的现金流量净额为-2,542,177,536.87元，加权平均净资产收益率26.76%，基本每股收益1.2845元。全年经营现金流为负，与分季度数据中第二季度大额流出相呼应，但报告未结合合同负债、存货等指标解释季度间现金流与收入错配的原因。", "date": "", "isSupplementary": true}, {"id": "fact_544f200e", "title": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）在深圳证券交易所上市，2025年年度报告摘要公告编号为2026-009，由大信会计师事务所出具...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）在深圳证券交易所上市，2025年年度报告摘要公告编号为2026-009，由大信会计师事务所出具标准无保留意见审计报告。", "date": "", "isSupplementary": true}, {"id": "fact_f0ac2430", "title": "公司2025年财务数据因“同一控制下企业合并”而进行了追溯调整或重述，这印证了成飞集团通过重大资产重组注入上市公司、实现整体上市的背景；2024年末总资产由调整...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "公司2025年财务数据因“同一控制下企业合并”而进行了追溯调整或重述，这印证了成飞集团通过重大资产重组注入上市公司、实现整体上市的背景；2024年末总资产由调整前的4,240,904,107.27元大幅调整为107,905,965,442.13元，2023年末由调整前的3,974,910,728.94元调整为127,681,276,927元量级，说明合并范围发生了根本性变化。", "date": "", "isSupplementary": true}, {"id": "fact_318bfde2", "title": "2025年末公司总资产为114,547,703,019.42元，较2024年末调整后的107,905,965,442.13元增长6.16%，表明2025年是重组...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "2025年末公司总资产为114,547,703,019.42元，较2024年末调整后的107,905,965,442.13元增长6.16%，表明2025年是重组完成后首个完整会计年度，资产规模已按合并后口径稳定运行。", "date": "", "isSupplementary": true}, {"id": "fact_0242f6af", "title": "报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，与成飞集团整体上市后的业务定位一致。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，与成飞集团整体上市后的业务定位一致。", "date": "", "isSupplementary": true}, {"id": "fact_e61d4ce6", "title": "股权结构显示，中国航空工业集团有限公司持股78.66%（2,101,738,612股），汉中汉航机电有限公司持股5.75%（153,597,730股），汉中航空...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "股权结构显示，中国航空工业集团有限公司持股78.66%（2,101,738,612股），汉中汉航机电有限公司持股5.75%（153,597,730股），汉中航空工业（集团）有限公司持股5.29%（141,442,953股），中国航空科技工业股份有限公司持股0.26%（7,043,584股），实际控制人均为中国航空工业集团有限公司。", "date": "", "isSupplementary": true}, {"id": "fact_178308ec", "title": "公司2025年度利润分配预案为：以总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股，以资本公积金转增0股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "公司2025年度利润分配预案为：以总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股，以资本公积金转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_30daf07c", "title": "中航成飞2025年分季度营业收入呈现明显的季节性结算节奏：第一季度仅33.09亿元，第二季度跃升至173.93亿元，第三季度达到全年最高的275.84亿元，第四...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年分季度营业收入呈现明显的季节性结算节奏：第一季度仅33.09亿元，第二季度跃升至173.93亿元，第三季度达到全年最高的275.84亿元，第四季度为270.73亿元。第三、四季度合计占全年营业收入约72.5%，第一季度占比不足4.4%，反映出装备采购与收入确认高度集中于下半年、尤其是年末结算的特征。", "date": "", "isSupplementary": true}, {"id": "fact_77f9251f", "title": "分季度归母净利润同样呈前低后高走势：第一季度1.56亿元、第二季度7.56亿元、第三季度12.56亿元、第四季度12.63亿元，与营业收入结算节奏基本同步，进一...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "分季度归母净利润同样呈前低后高走势：第一季度1.56亿元、第二季度7.56亿元、第三季度12.56亿元、第四季度12.63亿元，与营业收入结算节奏基本同步，进一步印证收入确认集中于下半年。", "date": "", "isSupplementary": true}, {"id": "fact_cbfdab4d", "title": "分季度经营活动现金流量净额波动剧烈：第一季度20.93亿元、第二季度-97.57亿元、第三季度36.32亿元、第四季度14.89亿元，第二季度大额净流出与后续季...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "分季度经营活动现金流量净额波动剧烈：第一季度20.93亿元、第二季度-97.57亿元、第三季度36.32亿元、第四季度14.89亿元，第二季度大额净流出与后续季度回款，体现军品装备采购中预付款、交付验收与货款结算的周期性错配。", "date": "", "isSupplementary": true}, {"id": "fact_724cab33", "title": "公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，属于典型军品装备采购体系内企业，其收入确认节奏受装...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，属于典型军品装备采购体系内企业，其收入确认节奏受装备采购与结算安排直接影响。", "date": "", "isSupplementary": true}, {"id": "fact_bcbaffae", "title": "中航成飞（证券代码302132，深交所上市）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，属...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞（证券代码302132，深交所上市）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，属于航空整机制造类上市平台。", "date": "", "isSupplementary": true}, {"id": "fact_6a6622b6", "title": "中国航空工业集团有限公司持有中航成飞78.66%股份，为控股股东；汉中汉航机电有限公司持股5.75%、汉中航空工业（集团）有限公司持股5.29%、中国航空科技工...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中国航空工业集团有限公司持有中航成飞78.66%股份，为控股股东；汉中汉航机电有限公司持股5.75%、汉中航空工业（集团）有限公司持股5.29%、中国航空科技工业股份有限公司持股0.26%，上述股东实际控制人均为中国航空工业集团有限公司，显示中航成飞是航空工业集团高度集中控股的整机上市平台。", "date": "", "isSupplementary": true}, {"id": "fact_9867dbb5", "title": "中航成飞2025年末总资产为114,547,703,019.42元，较2024年末调整后107,905,965,442.13元增长6.16%（因同一控制下企业合...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年末总资产为114,547,703,019.42元，较2024年末调整后107,905,965,442.13元增长6.16%（因同一控制下企业合并追溯调整）。", "date": "", "isSupplementary": true}, {"id": "fact_820f2cad", "title": "中航成飞总股本为267,209.14万股，2025年度利润分配预案为每10股派发现金红利3.86元（含税），不送红股、不转增。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞总股本为267,209.14万股，2025年度利润分配预案为每10股派发现金红利3.86元（含税），不送红股、不转增。", "date": "", "isSupplementary": true}]}}

