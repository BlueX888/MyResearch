data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:57:44.351059", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述中航成飞2025年营业收入总规模、各季度营业收入及占比、同比与环比变化，识别营业收入最高的季度。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 一季度 营业收入;中航成飞 2025 半年报 营业收入;中航成飞 2025 三季报 营业收入;中航成飞 2025 年报 分季度 营业收入"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述航空整机主要企业及中航成飞在军机整机领域的竞争地位，分析订单与交付节奏对季度营收分布的影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 军机 整机 竞争格局;成飞 歼击机 交付 节奏;中航沈飞 季度 营业收入 对比"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述重点型号研制批产、产能爬坡和交付技术状态对中航成飞季度收入确认的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 重点型号 批产 交付;成飞 产能 爬坡;航空装备 收入确认 节点"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、军品采购定价机制、国企改革和会计准则对中航成飞季度营收确认的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 2025 执行 节奏;军品 定价 机制 收入确认;中航成飞 政策 影响"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述交付集中度、供应链产能、军品定价调整等挑战，以及新机型批产和外贸出口带来的机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 交付 挑战 供应链;成飞 外贸 出口 机会;军品 收入 季节性"]}, {"id": "sec_6", "title": "未来展望", "description": "描述2026年及后续季度营收分布趋势，判断第四季度集中确认是否延续及季度分布平滑化的可能。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2026 营收 展望;军工 季度 收入 季节性;成飞 交付 计划"]}], "research_questions": ["中航成飞2025年各季度营业收入分别是多少，哪个季度最高？", "季度营收分布是否符合军工行业下半年尤其第四季度集中确认的规律？", "影响各季度营收分布的主要因素（交付节点、采购计划、产品结构、会计确认）是什么？"]}}

