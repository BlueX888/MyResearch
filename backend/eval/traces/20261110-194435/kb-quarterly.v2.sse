data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T20:02:48.634308", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Arial Unicode MS', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'季度': ['第一季度', '第二季度', '第三季度', '第四季度'], '营业收入': [3308640285.35, 17393488964.30, 27584043546.48, 27072785205.73]}\ndf = pd.DataFrame(data)\ndf['营业收入_亿元'] = df['营业收入'] / 1e8\nplt.figure(figsize=(12, 7), dpi=200)\nx = df['季度']\ny = df['营业收入_亿元']\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, label='营业收入')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 0.8, f'{v:.2f}亿元', ha='center', va='bottom', fontsize=11, fontweight='bold', color='#1e293b')\nmax_idx = y.idxmax()\nplt.annotate('最高季度', xy=(max_idx, y[max_idx]), xytext=(max_idx, y[max_idx] + 3), arrowprops=dict(arrowstyle='->', color='#ef4444'), fontsize=12, color='#ef4444', ha='center')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.legend(fontsize=12, loc='upper left')\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

