data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:44:42.974555", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "梳理中航成飞2025年度经营与盈利概况，包括营收、净利润、未分配利润、经营性现金流及航空装备市场需求，判断利润分配的资金来源和分红基础。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025年度 营业收入 净利润 经营性现金流 未分配利润 利润分配预案"]}, {"id": "sec_2", "title": "竞争格局", "description": "分析航空装备主机厂竞争格局、中航成飞行业地位、订单交付与盈利能力，比较同业分红水平，评估其分红能力和可能的分配力度。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 行业地位 航空装备 主机厂 同业分红 现金分红比例 2025"]}, {"id": "sec_3", "title": "技术趋势", "description": "分析航空装备研发投入、技术升级和产能建设对资本开支与现金流的影响，判断技术发展节奏对2025年度利润分配预案的约束或支撑。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 研发投入 资本开支 产能建设 航空装备 技术升级 分红影响"]}, {"id": "sec_4", "title": "政策环境", "description": "梳理上市公司现金分红监管要求、国企改革股东回报导向、军工行业政策及公司章程分红条款，分析政策对2025年度利润分配预案的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["上市公司 现金分红 监管政策 国企改革 股东回报 军工 中航成飞 利润分配"]}, {"id": "sec_5", "title": "挑战机遇", "description": "识别军品定价、回款周期、研发投入、产能扩张与股东回报之间的平衡问题，分析提高分红或维持稳定分红面临的挑战与机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 军品定价 回款 研发投入 分红 挑战 机遇 2025"]}, {"id": "sec_6", "title": "未来展望", "description": "展望中航成飞2025年度利润分配预案的披露时间、可能形式（现金分红、送转等）、分红连续性和股东回报规划，形成对预案内容的合理预判。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025年度 利润分配预案 公告 分红方案 股东回报规划"]}], "research_questions": ["中航成飞2025年度利润分配预案的具体内容是什么？中航成飞历史分红情况、公司章程分红条款及股东回报规划如何影响2025年度预案？中航成飞2025年度盈利、现金流、资本开支及国企分红政策如何影响利润分配预案？"]}}

