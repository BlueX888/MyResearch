data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:56:02.633843", "content": {"results": [{"id": "fact_4ca704b8", "title": "2025年末归属于上市公司股东的净资产为21,208,525,338.75元（上年末调整后19,430,635,961.57元，增长9.15%）；2025年末总...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "2025年末归属于上市公司股东的净资产为21,208,525,338.75元（上年末调整后19,430,635,961.57元，增长9.15%）；2025年末总资产为114,547,703,019.42元。净资产规模可作为分红合规性（分红后留存收益、净资产约束）的辅助参考。", "date": "", "isSupplementary": true}, {"id": "fact_3e239331", "title": "2025年基本每股收益与稀释每股收益均为1.2845元/股，加权平均净资产收益率为26.76%。结合归母净利润可推算期末总股本约26.72亿股，据此估算本次现金...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "2025年基本每股收益与稀释每股收益均为1.2845元/股，加权平均净资产收益率为26.76%。结合归母净利润可推算期末总股本约26.72亿股，据此估算本次现金分红总额约10.3亿元（约26.72亿股×0.386元/股），低于当年归母净利润34.32亿元，但该推算未经原文确认，仅供合规性初判参考。", "date": "", "isSupplementary": true}, {"id": "fact_6a267fe4", "title": "本次搜索结果中未检索到母公司报表及合并报表的“期末未分配利润”具体金额，也未检索到利润分配预案中“母公司可供分配利润/合并可供分配利润”的披露段落，因此无法直接...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "本次搜索结果中未检索到母公司报表及合并报表的“期末未分配利润”具体金额，也未检索到利润分配预案中“母公司可供分配利润/合并可供分配利润”的披露段落，因此无法直接以原文数据验证“分红不得超过可供分配利润”的合规性。", "date": "", "isSupplementary": true}, {"id": "fact_845f3bd1", "title": "中航成飞2025年年度报告摘要的公告编号为2026-009，证券代码302132，证券简称中航成飞。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要的公告编号为2026-009，证券代码302132，证券简称中航成飞。", "date": "", "isSupplementary": true}, {"id": "fact_d1f31104", "title": "公司经本次董事会审议通过的2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "公司经本次董事会审议通过的2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_94c0f44f", "title": "该利润分配预案由董事会审议通过；所有董事均已出席了审议本报告的董事会会议。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "该利润分配预案由董事会审议通过；所有董事均已出席了审议本报告的董事会会议。", "date": "", "isSupplementary": true}, {"id": "fact_9b45e09d", "title": "董事会决议通过的本报告期优先股利润分配预案为不适用。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "董事会决议通过的本报告期优先股利润分配预案为不适用。", "date": "", "isSupplementary": true}, {"id": "fact_594a020d", "title": "中航成飞股份有限公司2025年年度报告摘要（公告编号：2026-009）披露，公司经本次董事会审议通过的2025年度利润分配预案为：以公司总股本267,209....", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞股份有限公司2025年年度报告摘要（公告编号：2026-009）披露，公司经本次董事会审议通过的2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_92dedaf7", "title": "中航成飞2025年年度报告摘要显示，董事会决议通过的本报告期优先股利润分配预案为不适用；公司报告期无优先股股东持股情况。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，董事会决议通过的本报告期优先股利润分配预案为不适用；公司报告期无优先股股东持股情况。", "date": "", "isSupplementary": true}, {"id": "fact_a3ecde0d", "title": "中航成飞2025年度利润分配预案：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年度利润分配预案：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。该预案经董事会审议通过。", "date": "", "isSupplementary": true}, {"id": "fact_a84e77a3", "title": "2025年公司实现营业收入75,358,958,001.86元，较上年调整后数据增长15.84%。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年公司实现营业收入75,358,958,001.86元，较上年调整后数据增长15.84%。", "date": "", "isSupplementary": true}, {"id": "fact_9f5607f5", "title": "2025年归属于上市公司股东的净利润为3,432,289,851.96元，较上年调整后数据增长6.47%，增速明显低于营业收入15.84%的增速，反映盈利空间受...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年归属于上市公司股东的净利润为3,432,289,851.96元，较上年调整后数据增长6.47%，增速明显低于营业收入15.84%的增速，反映盈利空间受到挤压。", "date": "", "isSupplementary": true}, {"id": "fact_df2c8274", "title": "2025年末公司总资产为114,547,703,019.42元，较上年末调整后增长6.16%；归属于上市公司股东的净资产为21,208,525,338.75元，...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年末公司总资产为114,547,703,019.42元，较上年末调整后增长6.16%；归属于上市公司股东的净资产为21,208,525,338.75元，较上年末调整后增长9.15%。", "date": "", "isSupplementary": true}, {"id": "fact_471e1449", "title": "大信会计师事务所（特殊普通合伙）对公司2025年度财务报告出具了标准无保留意见的审计报告；公司报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对公司2025年度财务报告出具了标准无保留意见的审计报告；公司报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": true}, {"id": "fact_86ea3606", "title": "中航成飞董事会审议通过的2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf，公告编号2026-009）", "url": "", "snippet": "中航成飞董事会审议通过的2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_fbca3dc3", "title": "本报告期优先股利润分配预案为“不适用”，即公司无优先股利润分配安排。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "本报告期优先股利润分配预案为“不适用”，即公司无优先股利润分配安排。", "date": "", "isSupplementary": true}, {"id": "fact_a01eb3c0", "title": "报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": true}, {"id": "fact_5f1e791c", "title": "2025年末公司总资产为114,547,703,019.42元，较上年末（同一控制下企业合并追溯调整后）增长6.16%；2024年末调整后总资产为107,905...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "2025年末公司总资产为114,547,703,019.42元，较上年末（同一控制下企业合并追溯调整后）增长6.16%；2024年末调整后总资产为107,905,965,442.13元。", "date": "", "isSupplementary": true}, {"id": "fact_051f5f33", "title": "公司控股股东为中国航空工业集团有限公司（国有法人），持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司（5.75%）、汉中航空工业...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "公司控股股东为中国航空工业集团有限公司（国有法人），持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司（5.75%）、汉中航空工业（集团）有限公司（5.29%）与中国航空科技工业股份有限公司（0.26%）的实际控制人同为中国航空工业集团有限公司。", "date": "", "isSupplementary": true}, {"id": "fact_edba8cd5", "title": "公司在年度报告批准报出日无存续债券；重要事项部分披露为“无”。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "公司在年度报告批准报出日无存续债券；重要事项部分披露为“无”。", "date": "", "isSupplementary": true}]}}

