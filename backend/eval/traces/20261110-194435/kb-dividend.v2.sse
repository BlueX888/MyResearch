data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:51:02.644184", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Item': ['现金分红总额', '留存收益'],\n    'Amount': [10.31, 24.01]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Item':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nq = {\n    'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'],\n    'Revenue': [33.09, 173.93, 275.84, 270.73],\n    'CFO': [20.93, -97.57, 36.32, 14.89]\n}\ndq = pd.DataFrame(q)\nfor col in dq.columns:\n    if col != 'Quarter':\n        dq[col] = pd.to_numeric(dq[col], errors='coerce')\ndq = dq.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nbars = axes[0].bar(df['Item'], df['Amount'], color=['#6366f1', '#06b6d4'], width=0.5)\nfor b, v in zip(bars, df['Amount']):\n    axes[0].text(b.get_x() + b.get_width() / 2, v + 0.6, f'{v:.2f}亿元', ha='center', fontsize=12, fontweight='bold')\naxes[0].set_title('2025年利润分配结构（分红率30.05%）', fontsize=15, fontweight='bold', pad=15)\naxes[0].set_ylabel('金额（亿元）', fontsize=13)\naxes[0].tick_params(labelsize=12)\naxes[0].grid(True, linestyle='--', alpha=0.3)\naxes[1].bar(dq['Quarter'], dq['Revenue'], color='#10b981', width=0.5, label='营业收入')\naxes[1].plot(dq['Quarter'], dq['CFO'], color='#f59e0b', linewidth=2.5, marker='o', markersize=8, label='经营现金流净额')\naxes[1].axhline(0, color='gray', linewidth=1, linestyle='--')\naxes[1].set_title('2025年分季度营收与经营现金流', fontsize=15, fontweight='bold', pad=15)\naxes[1].set_ylabel('金额（亿元）', fontsize=13)\naxes[1].tick_params(labelsize=12)\naxes[1].legend(fontsize=11)\naxes[1].grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦中航成飞2025年度利润分配预案核心要素：每10股派现3.86元（含税）、不送红股、不转增，按总股本267,209.14万股测算现金分红约10.31亿元，占归母净利润34.32亿元的30.05%。代码将关键数据精简为两组：①利润分配结构（现金分红 vs 留存收益），用于展示派息力度；②分季度营业收入与经营活动现金流，用于说明分红背后的现金流节奏（Q2大幅流出、全年经营现金流为负）。通过双子图柱状图+折线图组合，专业呈现分配方案与经营质量。"}}

