data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:51:24.062264", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2024, 2025], 'Revenue': [650.54, 753.59], 'NetProfit': [32.23, 34.32]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nax1 = plt.gca()\nax2 = ax1.twinx()\nax1.plot(df['Year'], df['Revenue'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='营业收入（亿元）')\nax1.fill_between(df['Year'], df['Revenue'], color='#6366f1', alpha=0.15)\nax2.plot(df['Year'], df['NetProfit'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='归母净利润（亿元）')\nax2.fill_between(df['Year'], df['NetProfit'], color='#f59e0b', alpha=0.15)\nfor x, y in zip(df['Year'], df['Revenue']):\n    ax1.text(x, y + 18, f'{y:.2f}', ha='center', fontsize=11, color='#6366f1', fontweight='bold')\nfor x, y in zip(df['Year'], df['NetProfit']):\n    ax2.text(x, y + 1.2, f'{y:.2f}', ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nax1.set_ylim(0, 900)\nax2.set_ylim(0, 45)\nax1.set_xlim(2023.7, 2025.3)\nax1.set_xticks(df['Year'])\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('营业收入（亿元）', fontsize=14, color='#6366f1')\nax2.set_ylabel('归母净利润（亿元）', fontsize=14, color='#f59e0b')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nax1.tick_params(axis='both', labelsize=12)\nax2.tick_params(axis='y', labelsize=12)\nax1.grid(True, linestyle='--', alpha=0.3)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12, frameon=True)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

