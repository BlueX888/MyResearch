"fontWeight": "bold"}}]}}, {"id": "chart_003", "title": "股东持股结构", "subtitle": "2025年末主要股东持股比例", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "valueFormatter": "{value}%"}, "legend": {"orient": "vertical", "right": "2%", "top": "middle", "itemWidth": 10, "itemHeight": 10, "textStyle": {"color": "#666", "fontSize": 12}}, "series": [{"type": "pie", "radius": ["42%", "68%"], "center": ["38%", "55%"], "avoidLabelOverlap": true, "itemStyle": {"borderColor": "#fff", "borderWidth": 2}, "label": {"show": false}, "labelLine": {"show": false}, "data": [{"name": "中国航空工业集团", "value": 78.66, "itemStyle": {"color": "#1677ff"}}, {"name": "汉中汉航机电", "value": 5.75, "itemStyle": {"color": "#52c41a"}}, {"name": "汉中航空工业集团", "value": 5.29, "itemStyle": {"color": "#722ed1"}}, {"name": "中国航空科技工业", "value": 0.26, "itemStyle": {"color": "#fa8c16"}}, {"name": "其他股东", "value": 10.04, "itemStyle": {"color": "#d9d9d9"}}]}]}}, {"id": "chart_004", "title": "营业收入与归母净利润趋势", "subtitle": "2024-2025年（亿元）", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "top": "20%", "bottom": "3%", "containLabel": true}, "tooltip": {"trigger": "axis"}, "legend": {"top": "2%", "itemWidth": 12, "itemHeight": 8, "textStyle": {"color": "#666"}}, "xAxis": {"type": "category", "data": ["2024", "2025"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisTick": {"show": false}, "axisLabel": {"color": "#666"}}, "yAxis": [{"type": "value", "name": "营业收入(亿元)", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, {"type": "value", "name": "归母净利润(亿元)", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"show": false}}], "series": [{"name": "营业收入", "type": "line", "yAxisIndex": 0, "data": [650.55, 753.59], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "label": {"show": true, "position": "top", "color": "#1677ff", "fontSize": 12}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}}, {"name": "归母净利润", "type": "line", "yAxisIndex": 1, "data": [32.24, 34.32], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#52c41a"}, "lineStyle": {"width": 3}, "label": {"show": true, "position": "bottom", "color": "#52c41a", "fontSize": 12}}]}}]}}

