data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:51:13.207649", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'指标': ['营业收入', '归母净利润', '现金分红总额'], '金额': [753.59, 34.32, 10.31], '比率': [15.84, 6.47, 30.0]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nax1 = plt.gca()\nx = np.arange(len(df))\nax1.plot(x, df['金额'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='金额（亿元）')\nax1.fill_between(x, df['金额'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['金额']):\n    ax1.text(i, v + 18, str(v) + '亿元', ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nax1.set_xticks(x)\nax1.set_xticklabels(df['指标'], fontsize=12)\nax1.set_xlabel('核心指标', fontsize=14)\nax1.set_ylabel('金额（亿元）', fontsize=14)\nax1.tick_params(labelsize=12)\nax1.set_ylim(0, 900)\nax2 = ax1.twinx()\nax2.plot(x, df['比率'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, linestyle='--', label='比率（%）')\nfor i, v in enumerate(df['比率']):\n    ax2.text(i, v + 1.8, str(v) + '%', ha='center', fontsize=11, fontweight='bold', color='#b45309')\nax2.set_ylabel('比率（%）', fontsize=14)\nax2.tick_params(labelsize=12)\nax2.set_ylim(0, 40)\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper right', fontsize=12, frameon=True)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

