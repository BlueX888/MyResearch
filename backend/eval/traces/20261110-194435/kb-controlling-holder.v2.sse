data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T20:00:53.387569", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Holder': ['中国航空工业集团', '汉中汉航机电', '汉中航空工业(集团)', '方威', '中国航空科技工业'], 'Ratio': [78.66, 5.75, 5.29, 0.38, 0.26]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Holder':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\ndf = df.sort_values('Ratio', ascending=True)\ntop3 = df['Ratio'].nlargest(3).sum()\nprint('前三大股东合计持股比例: %.2f%%' % top3)\nprint('第一大股东持股比例: %.2f%%' % df['Ratio'].max())\nplt.figure(figsize=(12, 7), dpi=200)\ncolors = ['#cbd5e1', '#cbd5e1', '#cbd5e1', '#06b6d4', '#6366f1']\nbars = plt.barh(df['Holder'], df['Ratio'], color=colors, edgecolor='white')\nfor bar, val in zip(bars, df['Ratio']):\n    plt.text(bar.get_width() + 1.2, bar.get_y() + bar.get_height() / 2, '%.2f%%' % val, va='center', fontsize=12, fontweight='bold', color='#334155')\nplt.title('中航成飞前五大股东持股比例（2025年）', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('持股比例（%）', fontsize=14)\nplt.ylabel('股东名称', fontsize=14)\nplt.xlim(0, 92)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3, axis='x')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "提取中航成飞2025年前五大股东持股比例（航空工业集团78.66%、汉中汉航机电5.75%、汉中航空工业集团5.29%、方威0.38%、航空科技工业0.26%），构建DataFrame并做类型清洗，计算前三大股东合计持股比例与股权集中度指标，绘制横向柱状图直观展示第一大股东的绝对控股地位，并标注数值标签。"}}

