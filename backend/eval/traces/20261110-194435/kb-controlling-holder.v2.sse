data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T20:00:49.275997", "content": {"charts": [{"id": "chart_001", "title": "中航成飞第一大股东持股比例", "subtitle": "2025年：中国航空工业集团有限公司持股78.66%（2,101,738,612股）", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}<br/>持股比例：{c}%<br/>占比：{d}%"}, "legend": {"bottom": 0, "textStyle": {"color": "#666"}, "itemWidth": 10, "itemHeight": 10}, "series": [{"type": "pie", "radius": ["45%", "70%"], "center": ["50%", "45%"], "avoidLabelOverlap": true, "minShowLabelAngle": 5, "itemStyle": {"borderColor": "#fff", "borderWidth": 2}, "label": {"show": true, "formatter": "{b}\n{c}%", "color": "#333"}, "labelLine": {"length": 10, "length2": 8}, "data": [{"name": "中国航空工业集团有限公司", "value": 78.66, "itemStyle": {"color": "#1677ff"}}, {"name": "汉中汉航机电有限公司", "value": 5.75, "itemStyle": {"color": "#52c41a"}}, {"name": "汉中航空工业（集团）有限公司", "value": 5.29, "itemStyle": {"color": "#722ed1"}}, {"name": "方威", "value": 0.38, "itemStyle": {"color": "#fa8c16"}}, {"name": "中国航空科技工业股份有限公司", "value": 0.26, "itemStyle": {"color": "#eb2f96"}}, {"name": "华夏沪深300ETF", "value": 0.1, "itemStyle": {"color": "#13c2c2"}}, {"name": "其他股东", "value": 9.56, "itemStyle": {"color": "#d9d9d9"}}]}]}}, {"id": "chart_002", "title": "前十大股东持股比例排名", "subtitle": "2025年，中国航空工业集团以78.66%位居第一", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "3%", "right": "12%", "top": "8%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "value", "max": 100, "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#666", "formatter": "{value}%"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "yAxis": {"type": "category", "data": ["华夏沪深300ETF", "中国航空科技工业股份有限公司", "方威", "汉中航空工业（集团）有限公司", "汉中汉航机电有限公司", "中国航空工业集团有限公司"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 12}}, "series": [{"type": "bar", "barWidth": 14, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#666"}, "data": [{"value": 0.1, "itemStyle": {"color": "#d9d9d9"}}, {"value": 0.26, "itemStyle": {"color": "#eb2f96"}}, {"value": 0.38, "itemStyle": {"color": "#fa8c16"}}, {"value": 5.29, "itemStyle": {"color": "#722ed1"}}, {"value": 5.75, "itemStyle": {"color": "#52c41a"}}, {"value": 78.66, "itemStyle": {"color": "#1677ff"}}]}]}}]}}

