data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:56:06.756232", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述中航成飞主营业务、航空装备市场规模与增速，以及公司在军工航空产业链中的业务定位。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 公司概况 主营业务 航空装备 市场规模 增速"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述航空整机主要企业竞争格局，并重点梳理中航成飞的股权结构、第一大股东及持股比例。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 第一大股东 持股比例 股权结构 实际控制人"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述中航成飞核心航空制造技术、歼击机整机研制能力及航空制造技术发展趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 技术 产品 歼击机 航空制造 研发能力"]}, {"id": "sec_4", "title": "政策环境", "description": "描述军工资产证券化、国企改革和国防装备相关政策，分析其对中航成飞股权结构的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军工资产证券化 国企改革 中航成飞 重组 政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述中航成飞面临的股权集中、关联交易、军品定价等挑战，以及资产注入和航空装备升级带来的机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 风险 关联交易 股权集中 资产注入 机会"]}, {"id": "sec_6", "title": "未来展望", "description": "描述中航成飞股权结构稳定性、控股股东和实际控制人未来演变趋势及潜在资本运作方向。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 控股股东 实际控制人 未来 股权变化 资本运作"]}], "research_questions": ["中航成飞第一大股东的具体名称是什么", "其持股比例是多少", "实际控制人及一致行动人情况如何", "重组后股权结构是否发生变化"]}}

