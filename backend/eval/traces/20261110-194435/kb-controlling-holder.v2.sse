data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T20:01:11.556441", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Arial Unicode MS', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'股东': ['中国航空工业集团', '汉中汉航机电', '汉中航空工业(集团)', '方威', '中国航空科技工业', '华夏沪深300ETF'], '持股比例': [78.66, 5.75, 5.29, 0.38, 0.26, 0.10]}\ndf = pd.DataFrame(data)\ndf = df.sort_values('持股比例', ascending=False).reset_index(drop=True)\nplt.figure(figsize=(12, 7), dpi=200)\nx = range(len(df))\ny = df['持股比例'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='单一股东持股比例')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nplt.axhline(y=89.96, color='#ef4444', linestyle='--', linewidth=2, label='航空工业集团系合计持股 89.96%')\nfor i, v in enumerate(y):\n    plt.text(i, v + 2.5, str(v) + '%', ha='center', fontsize=11, fontweight='bold', color='#1e293b')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('主要股东', fontsize=14)\nplt.ylabel('持股比例 (%)', fontsize=14)\nplt.xticks(list(x), df['股东'], fontsize=12, rotation=20, ha='right')\nplt.yticks(fontsize=12)\nplt.ylim(0, 100)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper right')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

