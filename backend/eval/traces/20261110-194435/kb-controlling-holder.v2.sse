data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T20:01:06.033822", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'股东': ['航空工业集团系合计(估算)', '中国航空工业集团', '汉中汉航机电', '汉中航空工业(集团)', '方威', '中国航空科技工业', '华夏沪深300ETF'], '持股比例': [89.96, 78.66, 5.75, 5.29, 0.38, 0.26, 0.10]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\nplt.plot(x, df['持股比例'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='#6366f1', markeredgecolor='white', markeredgewidth=2, label='持股比例')\nplt.fill_between(x, df['持股比例'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['持股比例']):\n    plt.text(i, v + 3, f'{v}%', ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('股东名称', fontsize=14)\nplt.ylabel('持股比例 (%)', fontsize=14)\nplt.xticks(x, df['股东'], fontsize=12, rotation=20, ha='right')\nplt.yticks(fontsize=12)\nplt.ylim(0, 100)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

