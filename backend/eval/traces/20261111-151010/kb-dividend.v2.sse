data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T15:10:29.839459", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "公司概况与盈利基础", "description": "梳理中航成飞主营业务、2025年营业收入、净利润、经营活动现金流、未分配利润等，判断利润分配的可分配利润基础和现金分红能力。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025年年报 营业收入 净利润 经营活动现金流 未分配利润"]}, {"id": "sec_2", "title": "历史分红与股东回报政策", "description": "分析公司章程利润分配条款、近三年现金分红率、股东回报规划、控股股东诉求及历史预案执行情况。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 公司章程 利润分配 现金分红 近三年 分红率 股东回报规划"]}, {"id": "sec_3", "title": "2025年度利润分配预案核心内容", "description": "查找并描述2025年度利润分配预案披露的每10股派息、送转安排、现金分红总额、占净利润比例及董事会和股东大会审议状态。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025年度 利润分配预案 公告 每10股 现金分红"]}, {"id": "sec_4", "title": "现金流与资本开支约束", "description": "分析经营现金流、研发投入、产能建设、有息负债和营运资金需求对2025年度分红空间及预案合理性的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025年 经营现金流 资本开支 研发投入 有息负债"]}, {"id": "sec_5", "title": "监管政策与国企分红导向", "description": "梳理新“国九条”、央企市值管理、上市公司现金分红指引及军工行业特殊性对中航成飞利润分配预案的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["新国九条 分红 央企 市值管理 军工 上市公司 利润分配 政策"]}, {"id": "sec_6", "title": "未来展望与投资影响", "description": "评估2025年度利润分配预案的分红可持续性、股东回报提升空间及其对估值、投资者预期和公司资本配置的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 分红 可持续性 股东回报 估值 影响"]}], "research_questions": ["中航成飞2025年度利润分配预案的具体内容（每10股派息、送转安排、现金分红总额及占净利润比例）是什么？", "该预案与公司章程、近三年分红政策和股东回报规划是否一致？", "公司2025年盈利、现金流和资本开支如何影响分红可持续性及未来股东回报？"]}}

