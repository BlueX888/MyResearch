data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:20:43.794395", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['2025Q1', '2025Q2', '2025Q3', '2025Q4'], 'CashFlow': [20.93, -97.57, 36.32, 14.89]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx_pos = np.arange(len(df))\ny = df['CashFlow']\nplt.plot(x_pos, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='经营活动现金流量净额（亿元）')\nplt.fill_between(x_pos, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.annotate(f'{v:.2f}', (i, v), textcoords='offset points', xytext=(0, 12 if v >= 0 else -18), ha='center', fontsize=11, fontweight='bold')\nplt.axhline(0, color='gray', linewidth=1, linestyle='--', alpha=0.5)\nplt.title('历史分红与股东回报政策分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('经营活动现金流量净额（亿元）', fontsize=14)\nplt.xticks(x_pos, df['Quarter'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.text(0.02, 0.95, '2025年度分红方案：每10股派3.86元（含税），送红股0股，转增0股\\n总股本：267,209.14万股，分红总额约10.31亿元\\n注：Q4数据原文截断，取1,489,340,662元', transform=plt.gca().transAxes, fontsize=11, verticalalignment='top', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 历史分红与股东回报政策"}}

