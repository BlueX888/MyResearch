data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:20:27.704158", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['2025Q1', '2025Q2', '2025Q3', '2025Q4'], 'CashFlow': [20.93, -97.57, 36.32, 14.89]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx_pos = np.arange(len(df))\ny = df['CashFlow'].values\nplt.plot(x_pos, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='经营活动现金流量净额')\nplt.fill_between(x_pos, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    label = f'{v:.2f}'\n    if i == 3:\n        label += '*'\n    offset = 3 if v >= 0 else -6\n    plt.text(i, v + offset, label, ha='center', fontsize=11, fontweight='bold')\nplt.axhline(0, color='gray', linewidth=1, linestyle='--', alpha=0.5)\nplt.ylim(min(y) - 15, max(y) + 15)\nplt.title('公司概况与盈利基础分析\\n2025年分季度经营活动现金流量净额', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('现金流量净额（亿元）', fontsize=14)\nplt.xticks(x_pos, df['Quarter'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.text(0.99, -0.12, '*第四季度数据原文截断，为不完整值', transform=plt.gca().transAxes, ha='right', fontsize=10, color='gray')\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 公司概况与盈利基础"}}

