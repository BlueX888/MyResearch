data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:20:14.314057", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Item': ['现金分红总额', '归母净利润'], 'Amount': [10.31, 34.32]}\ndf = pd.DataFrame(data)\ndf['Amount'] = pd.to_numeric(df['Amount'], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nbars = axes[0].bar(df['Item'], df['Amount'], color=['#6366f1', '#06b6d4'], width=0.55)\nfor b, v in zip(bars, df['Amount']):\n    axes[0].text(b.get_x() + b.get_width() / 2, v + 0.6, f'{v:.2f}亿元', ha='center', fontsize=12, fontweight='bold')\naxes[0].set_title('现金分红总额 vs 归母净利润', fontsize=16, fontweight='bold', pad=15)\naxes[0].set_ylabel('金额（亿元）', fontsize=14)\naxes[0].set_ylim(0, 40)\naxes[0].tick_params(labelsize=12)\naxes[0].grid(True, linestyle='--', alpha=0.3)\naxes[1].pie([10.31, 24.01], labels=['现金分红\\n30.05%', '留存收益\\n69.95%'], colors=['#6366f1', '#e5e7eb'], autopct='%1.1f%%', startangle=90, textprops={'fontsize': 12}, wedgeprops={'edgecolor': 'white', 'linewidth': 2})\naxes[1].set_title('利润分配结构', fontsize=16, fontweight='bold', pad=15)\nplt.suptitle('中航成飞2025年度利润分配预案：每10股派现3.86元（含税）', fontsize=18, fontweight='bold')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦2025年度利润分配预案核心要素：每10股派现3.86元（含税）、送红股0股、资本公积转增0股，以总股本267,209.14万股为基数测算现金分红总额约10.31亿元；结合归母净利润34.32亿元计算分红率约30.05%，并可视化分红与净利润对比及利润分配结构（分红/留存）。"}}

