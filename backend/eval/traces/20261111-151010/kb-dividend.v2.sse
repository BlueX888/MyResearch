data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-11T15:19:59.106891", "content": {"charts": [{"id": "chart_001", "title": "中航成飞2025年度利润分配预案", "subtitle": "每10股分配方案（含税）｜以总股本267,209.14万股为基数", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "32%", "right": "18%", "top": "8%", "bottom": "6%", "containLabel": true}, "xAxis": {"type": "value", "show": false, "max": 5}, "yAxis": {"type": "category", "data": ["每10股派发现金红利（元）", "每10股送红股（股）", "每10股资本公积金转增（股）"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 3.86, "itemStyle": {"color": "#1677ff"}}, {"value": 0, "itemStyle": {"color": "#52c41a"}}, {"value": 0, "itemStyle": {"color": "#722ed1"}}], "barWidth": 16, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}, "label": {"show": true, "position": "right", "formatter": "{c}", "color": "#666", "fontSize": 13}}]}}, {"id": "chart_002", "title": "营业收入与归母净利润趋势", "subtitle": "2023-2025年（亿元）", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "top": "18%", "containLabel": true}, "legend": {"data": ["营业收入", "归母净利润"], "top": 0, "textStyle": {"color": "#666"}}, "tooltip": {"trigger": "axis"}, "xAxis": {"type": "category", "data": ["2023", "2024", "2025"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": [{"type": "value", "name": "营业收入（亿元）", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, {"type": "value", "name": "净利润（亿元）", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"show": false}}], "series": [{"name": "营业收入", "type": "line", "data": [779.67, 650.55, 753.59], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}}, {"name": "归母净利润", "type": "line", "yAxisIndex": 1, "data": [27.26, 32.24, 34.32], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#fa8c16"}, "lineStyle": {"width": 3}}]}}, {"id": "chart_003", "title": "前十大股东持股比例", "subtitle": "2025年末主要股东持股占比（%）", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "22%", "right": "12%", "top": "5%", "bottom": "5%", "containLabel": true}, "xAxis": {"type": "value", "show": false, "max": 90}, "yAxis": {"type": "category", "data": ["中国航空工业集团", "汉中汉航机电", "汉中航空工业（集团）", "方威", "中国航空科技工业"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 12}}, "series": [{"type": "bar", "data": [{"value": 78.66, "itemStyle": {"color": "#1677ff"}}, {"value": 5.75, "itemStyle": {"color": "#722ed1"}}, {"value": 5.29, "itemStyle": {"color": "#52c41a"}}, {"value": 0.38, "itemStyle": {"color": "#fa8c16"}}, {"value": 0.26, "itemStyle": {"color": "#eb2f96"}}], "barWidth": 14, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#666", "fontSize": 12}}]}}, {"id": "chart_004", "title": "2025年分季度经营表现", "subtitle": "营业收入（亿元）与归母净利润（亿元）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "top": "18%", "containLabel": true}, "legend": {"data": ["营业收入", "归母净利润"], "top": 0, "textStyle": {"color": "#666"}}, "tooltip": {"trigger": "axis"}, "xAxis": {"type": "category", "data": ["Q1", "Q2", "Q3", "Q4"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": [{"type": "value", "name": "营业收入（亿元）", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, {"type": "value", "name": "净利润（亿元）", "nameTextStyle": {"color": "#999"}, "axisLine": {"show": false}, "axisLabel": {"color": "#666"}, "splitLine": {"show": false}}], "series": [{"name": "营业收入", "type": "bar", "data": [33.09, 173.93, 275.84, 270.73], "barWidth": 28, "itemStyle": {"color": "#1677ff", "borderRadius": [4, 4, 0, 0]}}, {"name": "归母净利润", "type": "line", "yAxisIndex": 1, "data": [1.56, 7.56, 12.56, 12.63], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#fa8c16"}, "lineStyle": {"width": 3}}]}}]}}

