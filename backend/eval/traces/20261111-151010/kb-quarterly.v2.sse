data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:25:01.509226", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Quarter': ['2025Q1', '2025Q2', '2025Q3', '2025Q4'],\n    'Revenue': [3308640285.35, 17393488964.30, 27584043546.48, 27072785205.73]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Quarter':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\ndf['Revenue_Yi'] = df['Revenue'] / 1e8\ntotal = df['Revenue_Yi'].sum()\ndf['Share'] = df['Revenue_Yi'] / total * 100\nmean_val = df['Revenue_Yi'].mean()\ntop = df.loc[df['Revenue_Yi'].idxmax()]\nplt.figure(figsize=(12, 7), dpi=200)\ncolors = ['#a5b4fc', '#6366f1', '#06b6d4', '#10b981']\nbars = plt.bar(df['Quarter'], df['Revenue_Yi'], color=colors, width=0.6, edgecolor='white')\nfor bar, v, s in zip(bars, df['Revenue_Yi'], df['Share']):\n    plt.text(bar.get_x() + bar.get_width() / 2, v + 5, f'{v:.2f}亿 ({s:.1f}%)', ha='center', fontsize=12, fontweight='bold')\nplt.axhline(mean_val, color='#ef4444', linestyle='--', linewidth=2, label=f'季度均值 {mean_val:.2f} 亿元')\nplt.title('中航成飞2025年各季度营业收入分布', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, df['Revenue_Yi'].max() * 1.18)\nplt.legend(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "1) 提取2025年四个季度的营业收入数据（单位统一换算为亿元）；2) 计算全年合计、季度均值、各季度占比及最高季度；3) 绘制带数值标签、占比标注和均值参考线的专业柱状图，直观展示季度分布与峰值季度。"}}

