data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:25:09.163083", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'季度': ['2025Q1', '2025Q2', '2025Q3', '2025Q4'], '营业收入(亿元)': [33.09, 173.93, 275.84, 270.73]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = list(range(len(df)))\ny = df['营业收入(亿元)'].tolist()\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, markeredgecolor='#6366f1', label='营业收入(亿元)', zorder=3)\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 8, f'{v:,.2f}', ha='center', va='bottom', fontsize=11, fontweight='bold', color='#4338ca')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('报告期', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(x, df['季度'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, max(y) * 1.18)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left', frameon=False)\nplt.text(0.99, -0.13, '数据来源：中航成飞2025年年度报告摘要', transform=plt.gca().transAxes, ha='right', fontsize=10, color='#6b7280')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

