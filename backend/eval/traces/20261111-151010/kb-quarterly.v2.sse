data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:25:19.657161", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'Arial Unicode MS']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'季度': ['2025Q1', '2025Q2', '2025Q3', '2025Q4'], '营业收入(亿元)': [33.09, 173.93, 275.84, 270.73]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx_pos = np.arange(len(df))\ny = df['营业收入(亿元)']\nplt.plot(x_pos, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2)\nplt.fill_between(x_pos, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 6, f'{v:.2f}亿', ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(x_pos, df['季度'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

