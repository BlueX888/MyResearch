data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T15:16:25.040310", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述中航成飞所处航空装备整机市场及公司2025年营业收入规模、季度分布和增速，重点比较Q1-Q4收入占比及最高季度。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 年 一季度 营业收入;中航成飞 2025 半年报 营业收入;中航成飞 2025 三季报 营业收入;中航成飞 2025 年报 分季度 营业收入"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述航空防务整机主要企业及中航成飞竞争地位，分析竞争格局变化是否影响其季度营收分布。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 竞争格局 歼击机 整机;中航沈飞 航发动力 中航成飞 对比;成飞集团 军机 市场份额"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述航空整机研制、批产交付和收入确认相关核心技术及产能节奏，分析技术/交付节点对季度营收的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 批产 交付 节奏;成飞 歼-20 产能;航空装备 收入确认 季度"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、装备采购、军品定价及国企改革相关政策，分析政策节奏对中航成飞季度收入确认的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 2025 装备采购;军品定价 政策 收入确认;中航成飞 政策 影响"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述中航成飞面临的交付节奏、供应链、定价机制等挑战，以及航空装备升级和产能释放带来的机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 交付 挑战 供应链;中航成飞 产能 释放 机会;航空装备 需求 2025"]}, {"id": "sec_6", "title": "未来展望", "description": "描述中航成飞2025年后营收增长和季度分布趋势，判断季度收入集中度是否延续。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 2026 营收 预测;中航成飞 季度 收入 季节性;航空装备 整机 景气度"]}], "research_questions": ["中航成飞2025年Q1-Q4营业收入分别为多少，Q4是否最高？", "季度收入分布是否呈现下半年集中特征，原因是什么？", "国防预算、交付节奏和军品定价如何影响季度收入确认？"]}}

