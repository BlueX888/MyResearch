data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T18:58:48.290765", "content": {"results": [{"id": "fact_8368d95b", "title": "中航成飞2025年末控股股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612.00股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年末控股股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612.00股。", "date": "", "isSupplementary": false}, {"id": "fact_2f49538a", "title": "中航成飞2025年末汉中汉航机电有限公司持股比例为5.75%，汉中航空工业（集团）有限公司持股比例为5.29%。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年末汉中汉航机电有限公司持股比例为5.75%，汉中航空工业（集团）有限公司持股比例为5.29%。", "date": "", "isSupplementary": false}, {"id": "fact_8bb07025", "title": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）已披露《2025年年度报告摘要》（公告编号：2026-009），该摘要来自年度报告全文，并经大...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）已披露《2025年年度报告摘要》（公告编号：2026-009），该摘要来自年度报告全文，并经大信会计师事务所（特殊普通合伙）审计，审计意见为标准的无保留意见。", "date": "", "isSupplementary": true}, {"id": "fact_b7a218b9", "title": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该业务结构说明公司收入主要来自航空防务装...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该业务结构说明公司收入主要来自航空防务装备及相关航空产品的销售与服务保障，与航空装备采购需求直接相关。", "date": "", "isSupplementary": true}, {"id": "fact_054de6b7", "title": "年度报告摘要设有“近三年主要会计数据和财务指标”章节（列示2025年末、2024年末、2023年末数据，并注明因同一控制下企业合并进行追溯调整或重述），但本次检...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "年度报告摘要设有“近三年主要会计数据和财务指标”章节（列示2025年末、2024年末、2023年末数据，并注明因同一控制下企业合并进行追溯调整或重述），但本次检索到的片段仅包含表头，未包含营业收入及同比增速的具体数值。", "date": "", "isSupplementary": true}, {"id": "fact_1adcfc0f", "title": "股权结构显示，中国航空工业集团有限公司为国有法人控股股东，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%，汉中航...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "股权结构显示，中国航空工业集团有限公司为国有法人控股股东，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%，上述股东实际控制人均为中国航空工业集团有限公司。", "date": "", "isSupplementary": true}, {"id": "fact_333a7b99", "title": "董事会决议通过的本报告期利润分配预案为：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股；本报告期无优先股股东持股情况...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "董事会决议通过的本报告期利润分配预案为：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股；本报告期无优先股股东持股情况。", "date": "", "isSupplementary": true}, {"id": "fact_8acd7599", "title": "公司注册办公地址为四川省成都市青羊区黄田坝纬一路88号，股票在深圳证券交易所上市，董事会秘书为肖峰，证券事务代表为解晗，投资者联系邮箱为cac-ir@avic....", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "公司注册办公地址为四川省成都市青羊区黄田坝纬一路88号，股票在深圳证券交易所上市，董事会秘书为肖峰，证券事务代表为解晗，投资者联系邮箱为cac-ir@avic.com。", "date": "", "isSupplementary": true}, {"id": "fact_36836a2f", "title": "本次补充搜索返回的全部结果均为《中航成飞股份有限公司2025年年度报告摘要》（证券代码：302132，公告编号：2026-009）的片段，未包含任何关于中航沈飞...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "本次补充搜索返回的全部结果均为《中航成飞股份有限公司2025年年度报告摘要》（证券代码：302132，公告编号：2026-009）的片段，未包含任何关于中航沈飞、洪都航空2025年营业收入的数据，也未包含中航成飞自身的营业收入具体数值。", "date": "", "isSupplementary": true}, {"id": "fact_a50c6e44", "title": "中航成飞2025年年报摘要中“主要会计数据和财务指标”章节提及近三年数据及同一控制下企业合并追溯调整，但搜索结果片段在表格数据处被截断，未呈现营业收入及同比增减...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年报摘要中“主要会计数据和财务指标”章节提及近三年数据及同一控制下企业合并追溯调整，但搜索结果片段在表格数据处被截断，未呈现营业收入及同比增减的具体数值。", "date": "", "isSupplementary": true}, {"id": "fact_5bfbbc05", "title": "中航成飞控股股东为中国航空工业集团有限公司，持股78.66%（2,101,738,612股）；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞控股股东为中国航空工业集团有限公司，持股78.66%（2,101,738,612股）；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%，三者实际控制人均为中国航空工业集团。该股权信息与中航沈飞、洪都航空同属航空工业集团体系，可作为同业对比的背景信息。", "date": "", "isSupplementary": true}, {"id": "fact_358982ec", "title": "中航成飞（证券代码302132）2025年年度报告摘要披露，报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞股份有限公司2025年年度报告摘要）", "url": "", "snippet": "中航成飞（证券代码302132）2025年年度报告摘要披露，报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品三大类。", "date": "", "isSupplementary": true}, {"id": "fact_c2df8c61", "title": "该年度报告摘要包含“近三年主要会计数据和财务指标”章节，并注明因同一控制下企业合并需追溯调整/重述以前年度会计数据，但本次检索到的摘要片段中未出现分产品/分业务...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞股份有限公司2025年年度报告摘要）", "url": "", "snippet": "该年度报告摘要包含“近三年主要会计数据和财务指标”章节，并注明因同一控制下企业合并需追溯调整/重述以前年度会计数据，但本次检索到的摘要片段中未出现分产品/分业务的营业收入金额及占比数据。", "date": "", "isSupplementary": true}, {"id": "fact_a06f2ba6", "title": "中航成飞2025年年度报告摘要披露，中国航空工业集团有限公司为国有法人股东，持股比例为78.66%，持股数量为2,101,738,612股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，中国航空工业集团有限公司为国有法人股东，持股比例为78.66%，持股数量为2,101,738,612股。", "date": "", "isSupplementary": true}, {"id": "fact_335ee258", "title": "中航成飞2025年年度报告摘要披露，汉中汉航机电有限公司持股比例为5.75%，持股数量为153,597,730股；汉中航空工业（集团）有限公司持股比例为5.29...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，汉中汉航机电有限公司持股比例为5.75%，持股数量为153,597,730股；汉中航空工业（集团）有限公司持股比例为5.29%，持股数量为141,442,953股。", "date": "", "isSupplementary": true}, {"id": "fact_eaf67bec", "title": "中航成飞2025年年度报告摘要披露，汉中汉航机电有限公司、汉中航空工业（集团）有限公司和中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，汉中汉航机电有限公司、汉中航空工业（集团）有限公司和中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司。", "date": "", "isSupplementary": true}, {"id": "fact_d4c28467", "title": "中航成飞2025年年度报告摘要显示，公司股票简称为中航成飞，股票代码为302132，上市交易所为深圳证券交易所，公告编号为2026-009。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，公司股票简称为中航成飞，股票代码为302132，上市交易所为深圳证券交易所，公告编号为2026-009。", "date": "", "isSupplementary": true}, {"id": "fact_be000f7d", "title": "中航成飞（证券代码302132）2025年年度报告摘要披露：2025年营业收入为75,358,958,001.86元（约753.59亿元）；2024年调整后营业...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞（证券代码302132）2025年年度报告摘要披露：2025年营业收入为75,358,958,001.86元（约753.59亿元）；2024年调整后营业收入为65,054,925,10X.XX元（原文表格截断，约650.55亿元）；2024年调整前营业收入为1,779,761,710.30元。按调整后口径测算，同比增长约15.8%。", "date": "", "isSupplementary": true}, {"id": "fact_5d27b438", "title": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该业务结构与中国国防装备采购需求直接相...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该业务结构与中国国防装备采购需求直接相关，但年报摘要未披露国防预算或装备采购政策的具体数据。", "date": "", "isSupplementary": true}, {"id": "fact_abf2a19d", "title": "财务数据追溯调整的原因为“同一控制下企业合并”，公司无需追溯调整或重述以前年度会计数据的选项为“否”；大信会计师事务所（特殊普通合伙）对公司2025年财务报告出...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "财务数据追溯调整的原因为“同一控制下企业合并”，公司无需追溯调整或重述以前年度会计数据的选项为“否”；大信会计师事务所（特殊普通合伙）对公司2025年财务报告出具标准无保留意见。", "date": "", "isSupplementary": true}]}}

