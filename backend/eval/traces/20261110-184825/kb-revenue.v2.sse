data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T18:54:46.230868", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['第一季度', '第二季度', '第三季度', '第四季度'], 'Revenue': [3308640285.35, 17393488964.30, 27584043546.48, 27072785205.73]}\ndf = pd.DataFrame(data)\ndf['Revenue_Billion'] = df['Revenue'] / 1e8\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['Revenue_Billion'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, label='营业收入')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 5, f'{v:.2f}', ha='center', va='bottom', fontsize=11, fontweight='bold', color='#1e293b')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(x, df['Quarter'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.legend(fontsize=12, frameon=False)\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

