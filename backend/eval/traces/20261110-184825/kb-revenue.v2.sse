data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T18:54:27.488343", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'],\n    'Revenue': [33.0864, 173.9349, 275.8404, 270.7279]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Quarter':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nannual_2025 = 753.5896\nannual_2024 = 650.5493\nyoy = (annual_2025 - annual_2024) / annual_2024 * 100\nprint(f'2025年营业收入: {annual_2025:.2f}亿元')\nprint(f'同比增长: {yoy:.2f}%')\nplt.figure(figsize=(12, 7), dpi=200)\nbars = plt.bar(df['Quarter'], df['Revenue'], color=['#6366f1', '#06b6d4', '#10b981', '#f59e0b'], width=0.6)\nfor bar in bars:\n    height = bar.get_height()\n    plt.text(bar.get_x() + bar.get_width()/2, height + 3, f'{height:.2f}亿', ha='center', va='bottom', fontsize=12, fontweight='bold')\nplt.title('中航成飞2025年季度营业收入及全年同比', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, max(df['Revenue']) * 1.18)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.text(0.02, 0.95, f'2025全年营收: {annual_2025:.2f}亿元', transform=plt.gca().transAxes, fontsize=13, verticalalignment='top', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\nplt.text(0.02, 0.88, f'同比增长: {yoy:.2f}%', transform=plt.gca().transAxes, fontsize=13, verticalalignment='top', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "提取2025年四个季度营业收入及全年营收，结合2024年调整后营收估算同比增速；绘制季度营收柱状图，并在图中标注2025全年营收和同比增速。"}}

