data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T18:48:33.828625", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "梳理中国航空装备整机市场及军贸市场规模、增速，明确中航成飞2025年营业收入统计口径、合并范围和同比基数。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 年报 营业收入 同比增长 合并口径"]}, {"id": "sec_2", "title": "竞争格局", "description": "分析国内歼击机整机及航空防务主要企业竞争格局，识别中航成飞主力机型、订单来源和市场份额变化。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 竞争格局 歼击机 整机 主要企业 市场份额"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述航空整机研制、先进战机、数字化制造和供应链核心技术趋势，评估其对交付节奏和营收增长的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 核心技术 先进战机 数字化制造 产能"]}, {"id": "sec_4", "title": "政策环境", "description": "梳理国防预算、装备采购、军工央企重组和军贸政策，分析政策及并表口径对2025年营收同比的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 装备采购 政策 中航成飞 重组 并表 2025"]}, {"id": "sec_5", "title": "挑战机遇", "description": "识别交付节奏、供应链产能、军品定价和军贸不确定性等挑战，以及批产放量、新机型列装和军贸拓展带来的机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 交付 产能 供应链 军贸 风险 机遇"]}, {"id": "sec_6", "title": "未来展望", "description": "展望中航成飞营收增长驱动、产能释放节奏和产品谱系拓展，判断2025年同比增速的可持续性。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 营收 预测 未来 增长 产能 订单"]}], "research_questions": ["中航成飞2025年营业收入的具体金额和同比增长率是多少？", "2025年营收增长主要由哪些机型交付、军贸订单或并表口径变化驱动？", "国防预算、装备采购政策及重组并表对2025年营收同比增速的影响有多大？"]}}

