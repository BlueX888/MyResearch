data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T18:54:39.568773", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'Arial Unicode MS']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'季度': ['第一季度', '第二季度', '第三季度', '第四季度'], '营业收入(亿元)': [33.09, 173.93, 275.84, 270.73]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['营业收入(亿元)'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, label='季度营业收入')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 8, f'{v:.2f}', ha='center', va='bottom', fontsize=11, fontweight='bold', color='#1e293b')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(x, df['季度'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, max(y) * 1.15)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.text(0.99, 0.95, '全年营业收入：753.59亿元', transform=plt.gca().transAxes, ha='right', va='top', fontsize=12, bbox=dict(boxstyle='round,pad=0.4', facecolor='#eef2ff', edgecolor='#c7d2fe', alpha=0.9))\nplt.legend(loc='upper left', fontsize=12, frameon=False)\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

