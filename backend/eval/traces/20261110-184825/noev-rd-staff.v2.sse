data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T18:48:36.773967", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述航空装备市场规模、国防预算增速及军机列装需求，聚焦中航成飞2025年研发投入与研发人员规模的行业背景。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 研发投入 研发人员 航空装备 市场规模 国防预算"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述中航沈飞、中航西飞、洪都航空等主机厂竞争地位，并对比研发人员数量与研发投入金额。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 中航沈飞 中航西飞 研发人员 研发投入 对比"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述隐身战机、无人机、数字化研制、复合材料等核心技术趋势及其对研发人员和研发投入的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 隐身战机 无人机 数字化研制 研发投入 研发人员"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、科技创新、国企改革、军品定价与信息披露政策对研发投入统计口径的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 科技创新 国企改革 军品 信息披露 中航成飞"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述保密披露限制、研发资本化口径、人才竞争、供应链等挑战，以及型号放量带来的研发投入机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 研发投入 资本化 研发人员 人才 供应链 挑战"]}, {"id": "sec_6", "title": "未来展望", "description": "描述2025至2027年中航成飞研发投入强度、研发人员规模及数据披露趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 研发投入 研发人员 预测 年报"]}], "research_questions": ["中航成飞2025年研发人员数量是多少，统计口径是什么", "中航成飞2025年研发投入金额是多少，是否包含资本化研发投入", "2025年数据是否已披露，若未披露如何基于2024年报、重组报告书和行业可比公司进行合理测算"]}}

