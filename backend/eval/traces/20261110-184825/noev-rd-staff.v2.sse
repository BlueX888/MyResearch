data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T18:56:47.142455", "content": {"results": [{"id": "fact_6dbde576", "title": "当前搜索结果中的2025年年度报告摘要片段未出现“研发人员数量”或“研发投入金额”数据，无法直接验证研究问题。", "source": "中航成飞股份有限公司2025年年度报告摘要（本地知识库）", "url": "", "snippet": "当前搜索结果中的2025年年度报告摘要片段未出现“研发人员数量”或“研发投入金额”数据，无法直接验证研究问题。", "date": "", "isSupplementary": false}, {"id": "fact_0676027a", "title": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布了2025年年度报告摘要，公告编号2026-009，大信会计师事务所对其2025年度财务报...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布了2025年年度报告摘要，公告编号2026-009，大信会计师事务所对其2025年度财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": true}, {"id": "fact_738116a8", "title": "2025年公司实现营业收入75,358,958,001.86元（约753.59亿元），2024年调整后营业收入为65,054,925,10X元（数据被截断）。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年公司实现营业收入75,358,958,001.86元（约753.59亿元），2024年调整后营业收入为65,054,925,10X元（数据被截断）。", "date": "", "isSupplementary": true}, {"id": "fact_c862a400", "title": "2025年末公司总资产为127,681,276,927.61元（约1276.81亿元）。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年末公司总资产为127,681,276,927.61元（约1276.81亿元）。", "date": "", "isSupplementary": true}, {"id": "fact_18d3603f", "title": "控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612.00股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612.00股。", "date": "", "isSupplementary": true}, {"id": "fact_be22ab7f", "title": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）2025年年度报告摘要显示，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）2025年年度报告摘要显示，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": true}, {"id": "fact_404d394d", "title": "中航成飞控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%（153,597,73...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%（153,597,730股），汉中航空工业（集团）有限公司持股5.29%（141,442,953股），三者实际控制人均为中国航空工业集团有限公司。", "date": "", "isSupplementary": true}, {"id": "fact_31c00b43", "title": "中航成飞2025年年报摘要由大信会计师事务所（特殊普通合伙）审计，审计意见为标准的无保留意见；公司董事会秘书为肖峰，证券事务代表为解晗，办公地址为四川省成都市青...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年报摘要由大信会计师事务所（特殊普通合伙）审计，审计意见为标准的无保留意见；公司董事会秘书为肖峰，证券事务代表为解晗，办公地址为四川省成都市青羊区黄田坝纬一路88号，电子信箱为cac-ir@avic.com。", "date": "", "isSupplementary": true}, {"id": "fact_47a192aa", "title": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）的搜索结果片段中，未出现利润表“研发费用”科目的具体金额数据，无法据此提取...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）的搜索结果片段中，未出现利润表“研发费用”科目的具体金额数据，无法据此提取研发投入的部分答案或下界参考。", "date": "", "isSupplementary": true}, {"id": "fact_164b9a35", "title": "年度报告摘要披露2025年营业收入为75,358,958,001.86元，但搜索结果片段中未包含研发费用、研发人员数量等与研发投入直接相关的信息。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "年度报告摘要披露2025年营业收入为75,358,958,001.86元，但搜索结果片段中未包含研发费用、研发人员数量等与研发投入直接相关的信息。", "date": "", "isSupplementary": true}, {"id": "fact_358f0319", "title": "该文件为年度报告摘要，明确提示“本年度报告摘要来自年度报告全文”，研发费用等利润表明细科目需查阅年度报告全文，摘要片段中未予披露。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "该文件为年度报告摘要，明确提示“本年度报告摘要来自年度报告全文”，研发费用等利润表明细科目需查阅年度报告全文，摘要片段中未予披露。", "date": "", "isSupplementary": true}, {"id": "fact_ce8021d1", "title": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布了2025年年度报告摘要，公告编号2026-009，摘要明确说明其来自年度报告全文，投资者...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布了2025年年度报告摘要，公告编号2026-009，摘要明确说明其来自年度报告全文，投资者应到证监会指定媒体阅读全文。", "date": "", "isSupplementary": true}, {"id": "fact_43f499f2", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告；所有董事均出席了审议本报告的董事会会议。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告；所有董事均出席了审议本报告的董事会会议。", "date": "", "isSupplementary": true}, {"id": "fact_4d61d2b5", "title": "报告期内，中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "报告期内，中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": true}, {"id": "fact_7c36086d", "title": "2025年度利润分配预案为：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股；报告期内无优先股利润分配预案。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "2025年度利润分配预案为：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股；报告期内无优先股利润分配预案。", "date": "", "isSupplementary": true}, {"id": "fact_d4f5afef", "title": "控股股东为中国航空工业集团有限公司（国有法人），持股比例78.66%，持股数量2,101,738,612.00股；其他主要股东包括汉中汉航机电有限公司（5.75...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "控股股东为中国航空工业集团有限公司（国有法人），持股比例78.66%，持股数量2,101,738,612.00股；其他主要股东包括汉中汉航机电有限公司（5.75%）、汉中航空工业（集团）有限公司（5.29%）。", "date": "", "isSupplementary": true}, {"id": "fact_a6048a05", "title": "本次检索到的文件为年度报告摘要，其中未包含“研发人员数量”和“研发投入金额”的具体数据；摘要中仅提示相关详细数据需查阅年度报告全文（巨潮资讯网等证监会指定媒体披...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "本次检索到的文件为年度报告摘要，其中未包含“研发人员数量”和“研发投入金额”的具体数据；摘要中仅提示相关详细数据需查阅年度报告全文（巨潮资讯网等证监会指定媒体披露的全文）。", "date": "", "isSupplementary": true}, {"id": "fact_c799cdfa", "title": "中航成飞股份有限公司（证券代码：302132，深交所上市）发布了2025年年度报告摘要，审计意见为标准无保留意见；报告期内主营业务为航空产品研发、制造、销售、维...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞股份有限公司（证券代码：302132，深交所上市）发布了2025年年度报告摘要，审计意见为标准无保留意见；报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": true}, {"id": "fact_45aff822", "title": "搜索结果中未出现任何关于军品定价议价规则、目标价格法、国资委研发投入强度考核或中央企业研发考核指标的具体条款、数值或表述。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "搜索结果中未出现任何关于军品定价议价规则、目标价格法、国资委研发投入强度考核或中央企业研发考核指标的具体条款、数值或表述。", "date": "", "isSupplementary": true}, {"id": "fact_5da60783", "title": "搜索结果中未包含中航成飞2025年研发人员数量及研发投入金额的具体数据；摘要片段仅涉及公司简介、主要会计数据与财务指标、股本及股东情况、利润分配预案等内容。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "搜索结果中未包含中航成飞2025年研发人员数量及研发投入金额的具体数据；摘要片段仅涉及公司简介、主要会计数据与财务指标、股本及股东情况、利润分配预案等内容。", "date": "", "isSupplementary": true}]}}

