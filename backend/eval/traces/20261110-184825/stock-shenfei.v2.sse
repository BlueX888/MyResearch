data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T18:57:30.374286", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Arial Unicode MS', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\nyears_zh = [2015, 2022, 2024]\nprice_zh = [71.5, 9.6, 83.95]\nyears_hd = [2015, 2022]\nprice_hd = [51.5, 22.23]\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(years_zh, price_zh, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='中航电测股价')\nplt.fill_between(years_zh, price_zh, alpha=0.15, color='#6366f1')\nplt.plot(years_hd, price_hd, color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='洪都航空股价')\nplt.fill_between(years_hd, price_hd, alpha=0.15, color='#f59e0b')\nfor x, y in zip(years_zh, price_zh):\n    plt.text(x, y + 3, f'{y}', ha='center', fontsize=11, color='#6366f1', fontweight='bold')\nfor x, y in zip(years_hd, price_hd):\n    plt.text(x, y + 3, f'{y}', ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nplt.title('竞争格局与可比公司分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('股价（元/股）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局与可比公司"}}

