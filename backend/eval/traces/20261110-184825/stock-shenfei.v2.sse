data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T18:52:25.330109", "content": {"agent": "DeepScout", "tool": "deep_search_follow_up", "queries": ["中航沈飞 600760 市盈率 TTM 市净率 2026年11月", "中航沈飞 2026年第三季度报告 官方公告 营业收入 归母净利润"], "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T18:52:25.579611", "content": {"results": [{"id": "sr_100cf6", "title": "中航沈飞三季度利润大增137% 军贸第二曲线打开估值空间- CFi.CN 中财网", "source": "中财网股票频道", "url": "https://stock.cfi.cn/p20261102000245.html", "snippet": "中航沈飞三季度利润大增137%\n军贸第二曲线打开估值空间\n时间:2026年11月02日\n09:36:39\n中财网\nCFi.CN讯:数据显示,中航沈飞2026年前三季度营收135.62亿元,同比下降34.19%;但单三季度营收73.71亿元,同比大增23.29%,环比激增105.91%;归母净利润5.34亿元,同比增137.41%,环比增73.44%。存货达170.21亿元,较年初增长50.02%,经营现金流净额同比多增31.96亿元。\n近期机构研报指出,业绩短期承压主因产品结构调整与交付节奏阶段性偏移,但降幅逐季收窄,Q3已现强劲反转。利润弹性显著高于收入,源于主业放量叠加资产处置收益,反映订单执行进入加速期。\n研报认为,高企存货印证排产饱满,费用大幅优化(研发费降61%、销售费降64%)凸显管理提效;“一机三型”军贸布局正从规划走向落地,有望打开第二成长曲线。当前65倍PE估值锚定的是龙头稀缺性与军贸增量预期,而非单纯看静态业绩。\n中财网", "date": "2026-11-02T09:36:39+08:00"}, {"id": "sr_5f2032", "title": "中航沈飞Q3净利暴增137% 产能修复+军贸放量双驱动- CFi.CN 中财网", "source": "中财网股票频道", "url": "https://stock.cfi.cn/p20261110000364.html", "snippet": "中航沈飞Q3净利暴增137%\n产能修复+军贸放量双驱动\n时间:2026年11月10日\n11:26:56\n中财网\nCFi.CN讯:数据显示,中航沈飞2026年前三季度营收135.6亿元,同比下滑34.2%;但单看2026年第三季度,营收73.7亿元,同比增长23.3%,归母净利润5.3亿元,同比大增137.4%,环比增长73.4%。应收账款较年初下降24.5%,经营性现金流由负转正至10.3亿元,显示回款改善与运营效率提升。\n近期机构研报指出,业绩逐季改善并非偶然,而是新老厂区双线产能加速释放、交付节奏回归正常的结果。研报认为,Q3毛利率虽微降,但净利率升至7.2%,期间费用率同比下降0.57个百分点,反映公司成本管控能力增强。\n研报指出,军贸业务被列为集团核心主业,公司作为“歼击机摇篮”,正深度参与构建军贸双循环格局;维修业务纵向延伸全寿命周期服务,打开第二增长曲线。叠加2026年全年任务冲刺在即,后续季度业绩有望持续兑现。\n中财网", "date": "2026-11-10T11:26:56+08:00"}, {"id": "sr_e83d10", "title": "中航沈飞三季报降幅收窄 回款提速全年稳增可期- CFi.CN 中财网", "source": "中国财经信息网", "url": "https://cfi.cn/p20261106002170.html", "snippet": "中航沈飞三季报降幅收窄\n回款提速全年稳增可期\n时间:2026年11月06日\n20:37:06\n中财网\nCFi.CN讯:数据显示,中航沈飞2026年前三季度营收135.62亿元,同比下降34.19%;归母净利润10.07亿元,下降26%;扣非净利7.22亿元,下滑44.5%。但第三季度单季归母净利润同比大增137.41%,降幅显著收窄,呈现逐季改善趋势。\n近期机构研报指出,合同负债三季度末达43.95亿元,环比激增47.99%,反映新订单预付款已到账;合同资产持续下降、应收账款基本持平,说明产品加速交付但验收与回款略有滞后。研报认为,积压已验收项目有望在四季度集中回款,叠加销售增速或转正,全年业绩稳增确定性高。\n研报指出,歼-16作为对地对海主力机型需求明确,歼-15舰载机随航母编队扩容持续放量,FC-31改型有望成为首型四代舰载机,整机平台长期成长空间打开。盈利预测维持买入评级,2026—2028年归母净利润复合增速超15%,估值已回落至34倍PE,具备配置价值。\n中财网", "date": "2026-11-06T20:37:06+08:00"}, {"id": "sr_57b125", "title": "【异动提醒】中航沈飞(600760)11月3日10点3分创60日新高_股票频道_证券之星", "source": "证券之星股票频道", "url": "https://stock.stockstar.com/RB2026110300015453.shtml", "snippet": "证券之星11月3日盘中消息,中航沈飞(600760)10点3分股价创60日新高。当前股价为49.01元,涨1.37%。前10个交易日资金流向情况:主力资金累计净流出3.89亿元,股价累计上涨1.47%;融资余额累计减少1.38亿元,融券余量累计减少1.28万股。", "date": "2026-11-03T10:05:13+08:00"}, {"id": "sr_dd16a0", "title": "*ST航图(688066)2026年三季报简析:净利润同比下降25.85%,三费占比上升明显_腾讯新闻", "source": "腾讯网", "url": "https://news.qq.com/rain/a/20261101A02XAL00", "snippet": "据证券之星公开数据整理,近期*ST航图(688066)发布2026年三季报。截至本报告期末,公司营业总收入7688.04万元,同比下降80.9%,归母净利润-4.61亿元,同比下降25.85%。按单季度数据看,第三季度营业总收入2605.16万元,同比下降76.92%,第三季度归母净利润-1.11亿元,同比上升6.96%。本报告期*ST航图三费占比上升明显,财务费用、销售费用和管理费用总和占总营收同比增幅达548.24%。本次财报公布的各项数据指标表现不尽如人意。其中,毛利率20.2%,同比减16.12%,净利率-604.96%,同比减561.02%,销售费用、管理费用、财务费用总计3.23亿元,三费占营收比420.39%,同比增548.24%,每股净资产-3.81元,同比减337.49%,每股经营性现金流-0.04元,同比增92.13%,每股收益-1.76元,同比减25.71%证券之星价投圈财报分析工具显示:业务评价:去年的净利率为-416.23%,算上全部成本后,公司产品或服务的附加值不高。从历史年报数据统计来看,公司上市以来中位数ROIC为9.56%,投资回报也较好,其中最惨年份2025年的ROIC为-89.42%,投资回报极差。公司历史上的财报相对一般(注:公司上市时间不满10年,上市时间越长财务均分参考意义越大。),公司上市来已有年报7份,亏损年份3次,显示生意模式比较脆弱。融资分红:公司上市7年以来,累计融资总额14.16亿元,累计分红总额6335.23万元,分红融资比为0.04。商业模式:公司业绩主要依靠研发及营销驱动。需要仔细研究这类驱动力背后的实际情况。生意拆解:公司过去三年(2023/2024/2025)净经营资产收益率分别为--/--/1379.6%,净经营利润分别为-3.76亿/-13.94亿/-18.64亿元,净经营资产分别为35.23亿/24.2", "date": "2026-11-01T06:28:14+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T18:52:46.563525", "content": {"results": [{"id": "sr_c3055e", "title": "中航沈飞(600760.SH)发布前三季度业绩,归母净利润10.07亿元,同比下降26%", "source": "智通财经网", "url": "https://www.zhitongcaijing.com/content/detail/1515646.html", "snippet": "智通财经APP讯,中航沈飞(600760.SH)披露2026年第三季度报告,前三季度公司实现营业收入135.62亿元,同比下降34.19%;归母净利润10.07亿元,同比下降26%;扣非净利润7.22亿元,同比下降44.50%;基本每股收益0.36元。", "date": "2026-10-29T23:45:10+08:00"}, {"id": "sr_7efe3f", "title": "中航沈飞:2026年第三季度归属于上市公司股东的净利润同比增长137.41%-证券日报网", "source": "www.zqrb.cn", "url": "http://www.zqrb.cn/gscy/ggkx/2026-10-29/A1793269606788.html", "snippet": "证券日报网讯\n10月29日,中航沈飞发布2026年第三季度报告称,公司2026年第三季度实现营业收入7,370,576,868.74元,同比增长23.29%;实现归属于上市公司股东的净利润534,381,594.00元,同比增长137.41%。(编辑\n赵思卓)", "date": "2026-10-29T21:44:00+08:00"}, {"id": "sr_2082b1", "title": "[三季报]中航沈飞(600760):中航沈飞股份有限公司2026年第三季度报告- CFi.CN 中财网", "source": "中财网股票频道", "url": "https://stock.cfi.cn/p20261029005853.html", "snippet": "[三季报]中航沈飞(600760):中航沈飞股份有限公司2026年第三季度报告\n时间:2026年10月29日\n22:34:32\n中财网\n原标题:中航沈飞:中航沈飞股份有限公司2026年第三季度报告\n证券代码:600760\n证券简称:中航沈飞\n中航沈飞股份有限公司\n2026年第三季度报告\n本公司董事会及全体董事保证本公告内容不存在任何虚假记载、误导性陈述或者重\n大遗漏,并对其内容的真实性、准确性和完整性承担法律责任。重要内容提示:\n公司董事会及董事、高级管理人员保证季度报告内容的真实、准确、完整,不存在虚假记载、误导性陈述或重大遗漏,并承担个别和连带的法律责任。\n公司负责人、主管会计工作负责人及会计机构负责人(会计主管人员)保证季度报告中财务信息的真实、准确、完整。\n第三季度财务报表是否经审计\n□是√否\n审计师发表非标意见的事项\n□适用√不适用\n一、主要财务数据\n(一)主要会计数据和财务指标\n单位:元币种:人民币\n项目本报告期本报告期比\n上年同期增\n减变动幅度\n(%)年初至报告期末年初至报告期\n末比上年同期\n增减变动幅度\n(%)营业收入7,370,576,868.7423.2913,561,684,086.10-34.19利润总额631,907,466.93132.221,197,301,391.74-25.41归属于上市公司股东的\n净利润534,381,594.00137.411,007,447,457.24-26.00归属于上市公司股东的319,704,800.1740.81721,842,219.18-44.50扣除非经常性损益的净\n利润\n经营活动产生的现金流\n量净额不适用不适用1,025,781,933.37不适用基本每股收益(元/股)0.19111.110.36-28.00稀释每股收益(元/股)0.19111.110.36-28.00加权平均净资产收益率\n(%)2", "date": "2026-10-29T22:34:32+08:00"}, {"id": "sr_c423ff", "title": "中航沈飞:前三季度净利润10.07亿元,同比下降26%", "source": "证券时报", "url": "https://stcn.com/article/detail/4287260.html", "snippet": "人民财讯10月29日电,中航沈飞(600760)10月29日披露2026年三季报,公司第三季度营业收入73.71亿元,同比增长23.29%;归属于上市公司股东的净利润5.34亿元,同比增长137.41%。2026年前三季度营业收入135.62亿元,同比下降34.19%;归属于上市公司股东的净利润10.07亿元,同比下降26%。前三季度受产品结构调整及部分配套成品交付节奏等因素影响,公司交付呈现阶段性偏差。同上半年相比,营业收入降幅明显收窄,呈逐季改善态势。\n声明:证券时报力求信息真实、准确,文章提及内容仅供参考,不构成实质性投资建议,据此操作风险自担\n下载\"证券时报\"官方APP,或关注官方微信公众号,即可随时了解股市动态,洞察政策信息,把握财富机会。", "date": "2026-10-29T17:33:00+08:00"}, {"id": "sr_7c0557", "title": "中航沈飞:第三季度净利润同比增长137% _ 东方财富网", "source": "东方财富网财经频道", "url": "https://finance.eastmoney.com/a/202610293914301465.html", "snippet": "10月29日,中航沈飞(600760.SH)公告称,第三季度营业收入为73.71亿元,同比增长23.29%;归属于上市公司股东的净利润为5.34亿元,同比增长137.41%。前三季度营业收入为135.62亿元,同比下降34.19%;归属于上市公司股东的净利润为10.07亿元,同比下降26%。业绩变动主要系受产品结构调整及部分配套成品交付节奏等因素影响,交付呈现阶段性偏差。(文章来源:每日经济新闻)", "date": "2026-10-29T00:00:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T18:52:51.306103", "content": {"results": [{"id": "sr_40187d", "title": "中航沈飞", "source": "新浪财经", "url": "http://money.finance.sina.com.cn/corp/go.php/vFD_ProfitStatement/stockid/600760/ctrl/2014/displaytype/4.phtml", "snippet": "昨收盘: 47.95  今开盘: 47.65  最高价: 48.35  最低价: 47.44\n市值: 1321.08 亿元 流通: 1315.83  成交: 169085 手 换手: 0.62%\n财务报表: 财务摘要 资产负债表 利润表 现金流量表\n 历年数据:  2024 2023 2022 2021 2020 2019 2018 2017 2016 2015", "date": "2025-02-07T23:00:00+08:00"}, {"id": "sr_be00c8", "title": "中航沈飞(600760)_股票行情,行情首页_中财网", "source": "中财网", "url": "http://quote.cfi.cn/quote_600760.html", "snippet": "代码表 47.45↑ 0.86 1.85% 今 开 : 46.55 最 高 : 47.50 振 幅 :2.96% 换手率:0.26% 昨 收 :46.59 最 低 : 46.12 成交量:71156手 成交额:33336.72万元 市盈率:53.14倍 扣除后市盈率:54.54倍计算公式说明市净率:7.51倍 2024-09-30 每股收益:0.89元 所属行业: 铁路、船舶、航空航天和..", "date": "2025-02-06T11:00:41+08:00"}, {"id": "sr_637bc2", "title": "中航沈飞(600760)_股票行情,行情首页_中财网", "source": "中财网", "url": "https://quote.cfi.cn/quote_600760.html", "snippet": "代码表 47.95↑ 1.36 2.92% 今 开 : 46.55 最 高 : 48.48 振 幅 :5.07% 换手率:0.68% 昨 收 :46.59 最 低 : 46.12 成交量:187986手 成交额:88947.09万元 市盈率:53.70倍 扣除后市盈率:55.11倍计算公式说明市净率:7.59倍 2024-09-30 每股收益:0.89元 所属行业: 铁路、船舶、航空航天和..", "date": "2025-02-06T15:00:02+08:00"}, {"id": "sr_5541b8", "title": "中航沈飞 54.52 0.01(0.02%)股票价格_行情_走势图-东方财富网", "source": "东方财富网", "url": "https://quote.eastmoney.com/sh600760.html?date=2025-12-18", "snippet": "当前价格:\n54.52涨跌:\n0.01\n(0.01)今开:53.85最高:54.96涨停:59.96换手:0.56%成交量:15.36万市盈(动)·动态市盈率:85.15总市值除以全年预估净利润,例如当前一季度净利润1000万,则预估全年净利润4000万·静态市盈率:45.54总市值除以上一年度净利润·滚动市盈率:52.62最新价除以最近4个季度的每股收益:85.15总市值:1546亿昨收:54.51最低:53.76跌停:49.06量比:0.63成交额:8.359亿市净:7.08流通市值:1498亿", "date": "2025-12-18T00:00:00+08:00"}, {"id": "sr_b7bc2c", "title": "中航沈飞 61.20 3.30(5.70%)股票价格_行情_走势图-东方财富网", "source": "东方财富网", "url": "https://quote.eastmoney.com/sh600760.html?date=2025-11-24", "snippet": "当前价格:\n61.20涨跌:\n3.30\n(3.30)今开:58.22最高:61.38涨停:63.69换手:1.20%成交量:32.99万市盈(动)·动态市盈率:95.58总市值除以全年预估净利润,例如当前一季度净利润1000万,则预估全年净利润4000万·静态市盈率:51.12总市值除以上一年度净利润·滚动市盈率:59.06最新价除以最近4个季度的每股收益:95.58总市值:1735亿昨收:57.90最低:58.18跌停:52.11量比:1.28成交额:19.86亿市净:7.95流通市值:1682亿", "date": "2025-11-24T00:00:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T18:53:08.854495", "content": {"results": [{"id": "sr_3d24e3", "title": "中航沈飞(600760.SH):2024年年报净利润为33.94亿元、同比较去年同期上涨12.86%", "source": "腾讯网", "url": "https://new.qq.com/rain/a/20250401A01HAJ00", "snippet": "2025年4月1日,中航沈飞(600760.SH)发布2024年年报。      公司营业总收入为428.37亿元。归母净利润为33.94亿元,较去年同报告期归母净利润增加3.87亿元,实现5年连续上涨,同比较去年同期上涨12.86%。经营活动现金净流入为-37.42亿元,较去年同报告期经营活动现金净流入增加6.51亿元。      公司最新资产负债率为69.07%,较去年同期资产负债率减少1.62个百分点。      公司较去年同期毛利率增加1.52个百分点,实现5年连续上涨。最新ROE为19.88%。      公司摊薄每股收益为1.23元,较去年同报告期摊薄每股收益增加0.14元,实现3年连续上涨,同比较去年同期上涨12.84%。      公司最新总资产周转率为0.73次。", "date": "2025-04-01T07:03:15+08:00"}, {"id": "sr_2d99ac", "title": "中航沈飞(600760.sh):2024年年报净利润为33.94亿元、同比较去年同期上涨12.86%", "source": "腾讯网", "url": "https://view.inews.qq.com/a/20250401A01HAJ00?scene=qqsearch", "snippet": "2025年4月1日,中航沈飞(600760.SH)发布2024年年报。      公司营业总收入为428.37亿元。归母净利润为33.94亿元,较去年同报告期归母净利润增加3.87亿元,实现5年连续上涨,同比较去年同期上涨12.86%。经营活动现金净流入为-37.42亿元,较去年同报告期经营活动现金净流入增加6.51亿元。      公司最新资产负债率为69.07%,较去年同期资产负债率减少1.62个百分点。      公司较去年同期毛利率增加1.52个百分点,实现5年连续上涨。最新ROE为19.88%。      公司摊薄每股收益为1.23元,较去年同报告期摊薄每股收益增加0.14元,实现3年连续上涨,同比较去年同期上涨12.84%。      公司最新总资产周转率为0.73次。最新存货周转率为2.97次", "date": "2025-04-01T07:03:15+08:00"}, {"id": "sr_b2644e", "title": "中航沈飞(600760.sh)发布2024年度业绩,归母净利润33.94亿元,同比增长12.86%", "source": "腾讯网", "url": "https://view.inews.qq.com/a/20250331A08QL900?scene=qqsearch", "snippet": "智通财经APP讯,中航沈飞(600760.SH)发布2024年年度报告,公司2024年年度营业收入428.37亿元,同比下降7.37%;归属于上市公司股东的净利润33.94亿元,同比增长12.86%;归属于上市公司股东的扣除非经常性损益的净利润33.73亿元,同比增长15.88%;基本每股收益1.23元/股。拟向全体股东每10股派发现金红利2.6元(含税)。", "date": "2025-03-31T19:41:08+08:00"}, {"id": "sr_3f53af", "title": "中航沈飞(600760.SH)发布2024年度业绩,归母净利润33.94亿元,同比增长12.86%_公司_年年_进度", "source": "搜狐", "url": "https://www.sohu.com/a/877888778_323087", "snippet": "智通财经APP讯,中航沈飞(600760.SH)发布2024年年度报告,公司2024年年度营业收入428.37亿元,同比下降7.37%;归属于上市公司股东的净利润33.94亿元,同比增长12.86%;归属于上市公司股东的扣除非经常性损益的净利润33.73亿元,同比增长15.88%;基本每股收益1.23元/股。拟向全体股东每10股派发现金红利2.6元(含税)。 报告期内,公司积极克服合同签订进度、配套供应进度等外部因素影响,通过内部挖潜、聚力攻坚,保障了科研生产经营质效提升。", "date": "2025-03-31T19:42:00+08:00"}, {"id": "sr_48cb46", "title": "中航沈飞(600760.SH)发布2024年度业绩,归母净利润33.94亿元,同比增长12.86%", "source": "腾讯网", "url": "https://new.qq.com/rain/a/20250331A08QL900", "snippet": "智通财经APP讯,中航沈飞(600760.SH)发布2024年年度报告,公司2024年年度营业收入428.37亿元,同比下降7.37%;归属于上市公司股东的净利润33.94亿元,同比增长12.86%;归属于上市公司股东的扣除非经常性损益的净利润33.73亿元,同比增长15.88%;基本每股收益1.23元/股。拟向全体股东每10股派发现金红利2.6元(含税)。      报告期内,公司积极克服合同签订进度、配套供应进度等外部因素影响,通过内部挖潜、聚力攻坚,保障了科研生产经营质效提升。", "date": "2025-03-31T19:41:08+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

