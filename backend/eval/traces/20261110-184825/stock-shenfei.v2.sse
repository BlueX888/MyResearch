data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:04:06.264080", "content": {"results": [{"id": "fact_56b4b9ca", "title": "国防军工行业报告将2025年我国国防预算同比增长7.2%列为投资要点。", "source": "报告网", "url": "", "snippet": "国防军工行业报告将2025年我国国防预算同比增长7.2%列为投资要点。", "date": "", "isSupplementary": true}, {"id": "fact_89783cc1", "title": "中航沈飞2024年年报显示，公司实现扣非净利润33.73亿元，同比增长15.88%；加权平均净资产收益率为20.20%；基本每股收益为1.23元。", "source": "新浪财经（中原军工2024年报点评）", "url": "", "snippet": "中航沈飞2024年年报显示，公司实现扣非净利润33.73亿元，同比增长15.88%；加权平均净资产收益率为20.20%；基本每股收益为1.23元。", "date": "", "isSupplementary": true}, {"id": "fact_20e92b2b", "title": "中航沈飞2024年毛利率较去年同期增加1.52个百分点，实现5年连续上涨；最新ROE为19.88%；资产负债率为69.07%，较去年同期减少1.62个百分点。", "source": "腾讯网", "url": "", "snippet": "中航沈飞2024年毛利率较去年同期增加1.52个百分点，实现5年连续上涨；最新ROE为19.88%；资产负债率为69.07%，较去年同期减少1.62个百分点。", "date": "", "isSupplementary": true}, {"id": "fact_e5a2a0a2", "title": "中航沈飞2024年实现营业总收入428.37亿元，同比下降7.37%；归母净利润33.94亿元，同比增长12.86%；扣非归母净利润33.73亿元，同比增长15...", "source": "上海申银万国证券研究所（新浪财经转载）", "url": "", "snippet": "中航沈飞2024年实现营业总收入428.37亿元，同比下降7.37%；归母净利润33.94亿元，同比增长12.86%；扣非归母净利润33.73亿元，同比增长15.88%。2024年单Q4实现营收175.40亿元，同比增长50.99%；归母净利润15.76亿元，同比增长145.19%；扣非归母净利润15.87亿元，同比增长159.39%。", "date": "", "isSupplementary": true}, {"id": "fact_b8c59f88", "title": "以2025年3月31日收盘价计算，中航沈飞市盈率（TTM）约为47.35倍，市净率（LF）约为7.30倍，市销率（TTM）约为3.16倍。", "source": "搜狐", "url": "", "snippet": "以2025年3月31日收盘价计算，中航沈飞市盈率（TTM）约为47.35倍，市净率（LF）约为7.30倍，市销率（TTM）约为3.16倍。", "date": "", "isSupplementary": true}, {"id": "fact_63f9bf80", "title": "深交所于7月11日披露，中航电测发行股份购买航空工业成飞100%股权事项符合重组条件和信息披露要求。以2023年1月31日为评估基准日，航空工业成飞净资产评估值...", "source": "界面新闻", "url": "", "snippet": "深交所于7月11日披露，中航电测发行股份购买航空工业成飞100%股权事项符合重组条件和信息披露要求。以2023年1月31日为评估基准日，航空工业成飞净资产评估值为2,402,382.98万元；其中国有独享资本公积658,468.69万元未纳入交易作价，扣减后成飞100%股权交易作价为1,743,914.29万元。", "date": "", "isSupplementary": true}, {"id": "fact_dbe7513d", "title": "中航电测收购航空工业成飞100%股权的交易作价为174.39亿元，发行股份数量为20.86亿股，发行价格为8.36元/股。交易完成后，航空工业集团在中航电测的持...", "source": "财富号_东方财富网", "url": "", "snippet": "中航电测收购航空工业成飞100%股权的交易作价为174.39亿元，发行股份数量为20.86亿股，发行价格为8.36元/股。交易完成后，航空工业集团在中航电测的持股比例将从0.62%上升至78.07%，实际控制人未变，因此构成重大资产重组但不构成借壳上市。", "date": "", "isSupplementary": true}, {"id": "fact_bb8164bd", "title": "中航电测收购成飞的重组是注册制以来交易金额最高、规模最大的深市重组项目，也是资本市场精准支持科技创新领域资产并购的案例。", "source": "财富号_东方财富网", "url": "", "snippet": "中航电测收购成飞的重组是注册制以来交易金额最高、规模最大的深市重组项目，也是资本市场精准支持科技创新领域资产并购的案例。", "date": "", "isSupplementary": true}, {"id": "fact_e78b2d4c", "title": "中航电测行情数据显示，最新价为70.11元，涨跌幅为0.36%，换手率为2.59%，成交金额为10.69亿元。", "source": "东方财富", "url": "", "snippet": "中航电测行情数据显示，最新价为70.11元，涨跌幅为0.36%，换手率为2.59%，成交金额为10.69亿元。", "date": "", "isSupplementary": true}, {"id": "fact_2f03f27b", "title": "股吧信息称，重组初期市场预期成飞利润为40亿元，后续公布约为22亿元，每股约0.81元；若按沈飞当时47倍市盈率估算，成飞对应估价约38元。该信息为市场个人观点...", "source": "东方财富网股吧", "url": "", "snippet": "股吧信息称，重组初期市场预期成飞利润为40亿元，后续公布约为22亿元，每股约0.81元；若按沈飞当时47倍市盈率估算，成飞对应估价约38元。该信息为市场个人观点，可信度较低。", "date": "", "isSupplementary": true}, {"id": "fact_5a2ea984", "title": "新浪财经股吧有用户称，中航电测重组成功后将更名为中航成飞，并认为市值将超过中航沈飞。该内容属于个人市场观点，不构成事实或投资建议。", "source": "新浪财经股吧", "url": "", "snippet": "新浪财经股吧有用户称，中航电测重组成功后将更名为中航成飞，并认为市值将超过中航沈飞。该内容属于个人市场观点，不构成事实或投资建议。", "date": "", "isSupplementary": true}, {"id": "fact_e39a5499", "title": "民生证券国防军工行业周报标题显示，中航沈飞发布股权激励计划，军工改革稳步推进。", "source": "外唐智库（民生证券周报）", "url": "", "snippet": "民生证券国防军工行业周报标题显示，中航沈飞发布股权激励计划，军工改革稳步推进。", "date": "", "isSupplementary": true}, {"id": "fact_fe665510", "title": "天风证券2021年7月26日研报认为，军品定价机制改革或落地，中航沈飞作为歼击机龙头起航，Pipeline提升业绩望进一步释放。", "source": "价值目录（天风证券研报）", "url": "", "snippet": "天风证券2021年7月26日研报认为，军品定价机制改革或落地，中航沈飞作为歼击机龙头起航，Pipeline提升业绩望进一步释放。", "date": "", "isSupplementary": true}, {"id": "fact_78f2b052", "title": "军品价格工作改革目标为建立4个机制：目标价格生成机制、过程成本监控机制、激励约束机制及分类定价机制；实现4个转变：由单一定价模式向多种定价模式转变、由事后定价向...", "source": "中国知网《航天工业管理》2019年08期", "url": "", "snippet": "军品价格工作改革目标为建立4个机制：目标价格生成机制、过程成本监控机制、激励约束机制及分类定价机制；实现4个转变：由单一定价模式向多种定价模式转变、由事后定价向全程控制转变、由个别成本计价向社会平均成本计价转变、由经验型向科学型转变。", "date": "", "isSupplementary": true}, {"id": "fact_0460b271", "title": "行行查资料称，军品定价机制改革中总装单位或受益最大。", "source": "行行查", "url": "", "snippet": "行行查资料称，军品定价机制改革中总装单位或受益最大。", "date": "", "isSupplementary": true}, {"id": "fact_6958cd04", "title": "东方财富博客/股吧存在标题称“军品定价机制改革推进未来发展潜力惊人”“军品定价机制改革对中航沈飞构成实质性利好”，但正文仅为网站免责声明，未给出具体数据或论证。", "source": "东方财富博客/股吧", "url": "", "snippet": "东方财富博客/股吧存在标题称“军品定价机制改革推进未来发展潜力惊人”“军品定价机制改革对中航沈飞构成实质性利好”，但正文仅为网站免责声明，未给出具体数据或论证。", "date": "", "isSupplementary": true}, {"id": "fact_9971ec0d", "title": "中航沈飞2024年年报显示，公司实现营业总收入428.37亿元，同比下降7.37%；归母净利润33.94亿元，同比增长12.86%；扣非净利润33.73亿元，同...", "source": "新浪财经（中原军工2024年报点评）", "url": "", "snippet": "中航沈飞2024年年报显示，公司实现营业总收入428.37亿元，同比下降7.37%；归母净利润33.94亿元，同比增长12.86%；扣非净利润33.73亿元，同比增长15.88%；基本每股收益1.23元，加权平均净资产收益率20.20%；经营活动现金流量净额-37.42亿元，上年同期为-43.93亿元；2024年度分配预案为每10股派现2.6元（含税）。", "date": "", "isSupplementary": true}, {"id": "fact_06324b48", "title": "中航沈飞2024年年报显示，公司营业总收入为428.37亿元；归母净利润为33.94亿元，较上年同期增加3.87亿元，实现5年连续上涨，同比增长12.86%；经...", "source": "腾讯网/界面新闻", "url": "", "snippet": "中航沈飞2024年年报显示，公司营业总收入为428.37亿元；归母净利润为33.94亿元，较上年同期增加3.87亿元，实现5年连续上涨，同比增长12.86%；经营活动现金净流入为-37.42亿元；最新资产负债率为69.07%，较上年同期减少1.62个百分点；毛利率较上年同期增加1.52个百分点，实现5年连续上涨；最新ROE为19.88%；摊薄每股收益为1.23元，同比增长约12.84%。", "date": "", "isSupplementary": true}, {"id": "fact_f3ebd58c", "title": "中航沈飞2024年年报主营地区财务数据显示，国内营业收入为42,590,654,078.55元（约425.91亿元），营业成本为37,264,181,317.2...", "source": "前瞻眼上市企业库", "url": "", "snippet": "中航沈飞2024年年报主营地区财务数据显示，国内营业收入为42,590,654,078.55元（约425.91亿元），营业成本为37,264,181,317.21元（约372.64亿元），毛利为5,326,472,761.34元（约53.26亿元），毛利率为12.51%，收入构成中国内占比100%。", "date": "", "isSupplementary": true}, {"id": "fact_e57af5d5", "title": "根据中航沈飞2024年年报数据计算，归母净利率约为7.92%（归母净利润33.94亿元÷营业总收入428.37亿元），搜索结果未直接披露净利率指标。", "source": "基于腾讯网/新浪财经数据计算", "url": "", "snippet": "根据中航沈飞2024年年报数据计算，归母净利率约为7.92%（归母净利润33.94亿元÷营业总收入428.37亿元），搜索结果未直接披露净利率指标。", "date": "", "isSupplementary": true}]}}

