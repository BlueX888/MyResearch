data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T18:49:30.986521", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["中航电测 发行股份购买成飞集团100%股权 公告 总股本 市值", "中航沈飞 2024年年度报告 上海证券交易所 公告"], "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T18:49:31.196079", "content": {"results": [{"id": "sr_853888", "title": "中航电测:发行股份购买成飞集团100%股权资产注册申请..._网易订阅", "source": "网易", "url": "https://www.163.com/dy/article/J8U3D2CR0534A4SC.html", "snippet": "中航电测8月6日公告,公司近日收到中国证监会批复,同意公司向中国航空工业集团有限公司发行20.86亿股股份购买其持有的成都飞机工业(集团)有限责任公司100%股权的注册申请。", "date": "2024-08-06T17:06:11+08:00"}, {"id": "sr_f2384d", "title": "中航电测拟购买成飞集团100%股权 明日复牌-今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7195194208422986240/", "snippet": "中证网讯(记者 何昱璞)2月1日晚间,中航电测发布公告称,公司拟通过发行股份方式购买航空工业集团持有的航空工业成飞100%股权,本次交易不涉及募", "date": "2023-02-01T22:28:00+08:00"}, {"id": "sr_178946", "title": "中航电测:发行股份购买航空工业成飞100%股权,评估值为2,402,382.98万元_金融界_生产_业务", "source": "搜狐", "url": "https://www.sohu.com/a/751489894_114984", "snippet": "金融界1月12日消息,中航电测公告称,发行股份购买航空工业成飞100%股权,以2023年1月31日为基准日,航空工业成飞的评估值为2,402,382.98万元,增值率为88.47%。在扣除国有独享资本公积后,本次交易作价为1,743,914.29万元。公司实际控制人为中国航空工业集团有限公司,其注册资本为6,400,000万元人民币。资产购买完成后,中航电测将新增航空装备整机及部附件研制生产业务。 来源:金融界AI电报 返回搜狐,查看更多", "date": "2024-01-12T19:29:00+08:00"}, {"id": "sr_4077aa", "title": "中航电测:发行股份购买成飞集团100%股权资产注册申请获证监会同意批复", "source": "钛媒体官方网站", "url": "https://www.tmtpost.com/nictation/7198849.html", "snippet": "8月6日消息, 中航电测 公告,公司近日收到中国证监会批复,同意公司向中国航空工业集团有限公司发行20.86亿股股份购买其持有的成都飞机工业(集团)有限责任公司100%股权的注册申请。", "date": "2024-08-06T17:06:00+08:00"}, {"id": "sr_e4c14d", "title": "中航电测: 上市公告书（摘要）内容摘要", "source": "证券之星股票频道", "url": "http://stock.stockstar.com/AN2025011800003035.shtml", "snippet": "(原标题:上市公告书(摘要))\n中航电测仪器股份有限公司发布发行股份购买资产暨关联交易实施情况暨新增股份上市公告书(摘要)。公司向航空工业集团发行股份购买其持有的航空工业成飞100%股权,不涉及募集配套资金。发行股份种类为A股,每股面值1.00元,发行价格8.36元/股,新增股份数量2,086,021,877股,均为有限售条件流通股,上市日期为2025年1月22日。航空工业成飞已成为公司全资子公司,公司总股本增至2,676,782,376股。新增股份上市首日股价不除权,股票交易设涨跌幅限制。交易完成后,公司主营业务拓展至航空装备整机及部附件研制生产,增强抗风险能力和核心竞争力。航空工业集团成为公司控股股东和实际控制人,持股比例78.07%。公司提醒投资者注意风险,理性投资。投资者可查阅巨潮资讯网了解更多详情。", "date": "2025-01-18T09:24:23+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 1}}

