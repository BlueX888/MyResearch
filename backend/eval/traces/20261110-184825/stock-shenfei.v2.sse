data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T18:56:58.701108", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Year': ['2024', '2025', '2026'],\n    'Price': [40.15, 47.95, 54.98],\n    'Revenue': [428.37, 206.07, 135.62],\n    'Profit': [33.94, 13.62, 10.07]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(14, 6), dpi=200)\naxes[0].plot(df['Year'], df['Price'], linewidth=2.5, marker='o', markersize=8, color='#6366f1')\naxes[0].fill_between(df['Year'], df['Price'], alpha=0.15, color='#6366f1')\nfor x, y in zip(df['Year'], df['Price']):\n    axes[0].annotate(f'{y:.2f}', (x, y), textcoords='offset points', xytext=(0, 12), ha='center', fontsize=11, fontweight='bold')\naxes[0].set_title('中航沈飞股价走势（元）', fontsize=16, fontweight='bold', pad=15)\naxes[0].set_xlabel('时点', fontsize=13)\naxes[0].set_ylabel('股价（元）', fontsize=13)\naxes[0].set_ylim(30, 62)\naxes[0].grid(True, linestyle='--', alpha=0.3)\nx = np.arange(len(df))\nw = 0.36\naxes[1].bar(x - w/2, df['Revenue'], w, label='营业总收入', color='#06b6d4')\naxes[1].bar(x + w/2, df['Profit'], w, label='归母净利润', color='#10b981')\nfor i, v in enumerate(df['Revenue']):\n    axes[1].text(i - w/2, v + 8, f'{v:.0f}', ha='center', fontsize=10)\nfor i, v in enumerate(df['Profit']):\n    axes[1].text(i + w/2, v + 8, f'{v:.1f}', ha='center', fontsize=10)\naxes[1].set_xticks(x)\naxes[1].set_xticklabels(['2024全年', '2025前三季', '2026前三季'])\naxes[1].set_title('营收与归母净利润对比（亿元）', fontsize=16, fontweight='bold', pad=15)\naxes[1].set_ylabel('金额（亿元）', fontsize=13)\naxes[1].set_ylim(0, 500)\naxes[1].legend(fontsize=11)\naxes[1].grid(True, linestyle='--', alpha=0.3, axis='y')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "选取中航沈飞(600760)三个关键时点的股价、营收、净利润数据，构建精简DataFrame并做类型清洗；左图展示股价走势（含面积填充与数值标注），右图对比营业总收入与归母净利润（注明2025/2026为前三季度口径），直观反映股价上行与业绩阶段性承压的背离，辅助判断当前53倍左右PE的估值水平。"}}

