data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T18:57:16.217926", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nyears = [2015, 2022, 2024]\nzhonghang = [71.5, 9.6, 83.95]\nhongdu_years = [2015, 2022]\nhongdu = [51.5, 22.23]\nplt.figure(figsize=(12,7), dpi=200)\nplt.plot(years, zhonghang, marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='中航电测股价')\nplt.fill_between(years, zhonghang, alpha=0.15, color='#6366f1')\nplt.plot(hongdu_years, hongdu, marker='s', markersize=8, linewidth=2.5, color='#f59e0b', label='洪都航空股价')\nplt.fill_between(hongdu_years, hongdu, alpha=0.15, color='#f59e0b')\nfor x,y in zip(years, zhonghang):\n    plt.text(x, y+3, f'{y}', ha='center', fontsize=11, color='#6366f1', fontweight='bold')\nfor x,y in zip(hongdu_years, hongdu):\n    plt.text(x, y+3, f'{y}', ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nplt.axvline(2013, color='gray', linestyle=':', alpha=0.7)\nplt.text(2013.2, 80, '歼-15批产启动', fontsize=10, color='gray')\nplt.title('市场概况与股价表现分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('股价（元/股）', fontsize=14)\nplt.xticks([2013, 2015, 2022, 2024], fontsize=12)\nplt.yticks(fontsize=12)\nplt.xlim(2012, 2025)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.legend(fontsize=12, loc='upper left')\ntextstr = '2024年市值（亿元）：\\n中航直升机 359\\n中航无人机 348\\n洪都航空 280\\n成飞与沈飞市值差 564'\nplt.text(0.98, 0.98, textstr, transform=plt.gca().transAxes, fontsize=11, verticalalignment='top', horizontalalignment='right', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况与股价表现"}}

