data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T18:49:06.347936", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况与股价表现", "description": "描述军工航空整机市场规模、国防预算与装备列装需求，梳理中航沈飞股价区间、市值、成交活跃度、阶段涨跌幅及PE/PB/PS历史分位。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航沈飞 600760 股价 市值 市盈率 市净率 估值分位 国防预算 航空装备 市场空间"]}, {"id": "sec_2", "title": "竞争格局与可比公司", "description": "描述航空整机及军工主机厂竞争格局，比较中航沈飞与中航成飞、中航西飞、洪都航空、航发动力等企业在业务定位、订单、盈利和估值上的差异。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航沈飞 竞争格局 中航成飞 中航西飞 洪都航空 航发动力 可比公司 估值 对比 整机 稀缺性"]}, {"id": "sec_3", "title": "技术趋势与批产能力", "description": "描述歼击机、舰载机、隐身战机、无人协同等核心技术趋势，分析中航沈飞五代机批产、智能制造、产能利用和交付能力对业绩与估值的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航沈飞 歼-15 歼-16 歼-35 舰载机 五代机 批产 产能 智能制造 交付 技术趋势"]}, {"id": "sec_4", "title": "政策环境与外部因素", "description": "描述国防预算、军品定价机制、国企改革、股权激励、军贸政策、增值税及供应链等政策与外部因素，分析其对中航沈飞盈利和估值的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 军品定价机制 国企改革 股权激励 军贸 增值税 中航沈飞 政策 影响"]}, {"id": "sec_5", "title": "挑战机遇与估值风险", "description": "描述订单节奏、毛利率波动、应收账款、产能瓶颈、估值溢价和资产注入预期等挑战与机会，评估当前估值水平与业绩增长的匹配度。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航沈飞 毛利率 应收账款 合同负债 订单 产能 估值溢价 资产注入 风险 机会"]}, {"id": "sec_6", "title": "未来展望与估值判断", "description": "描述十五五装备升级、军贸拓展、批产放量和估值消化趋势，结合盈利预测与可比估值判断中航沈飞当前股价的合理性和潜在空间。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航沈飞 盈利预测 目标价 估值 十五五 装备升级 军贸 批产 放量 未来展望"]}], "research_questions": ["中航沈飞当前股价处于历史什么位置，PE/PB等估值指标相对自身历史和军工主机厂可比公司是否合理？", "国防预算、装备列装和五代机批产能否支撑中航沈飞未来营收与利润增长，业绩增速能否消化当前估值？", "军品定价机制、国企改革、军贸政策和订单交付节奏将如何影响中航沈飞的利润率、估值溢价和股价表现？"]}}

