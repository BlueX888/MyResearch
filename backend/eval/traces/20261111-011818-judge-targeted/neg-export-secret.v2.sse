e": "FC-31", "relation": "2012年首飞", "discovered_at": "2026-11-10T23:37:37.347446"}, {"source": "FC-31", "relation": "初始定位为出口型隐身战机", "discovered_at": "2026-11-10T23:37:37.347448"}, {"source": "沈阳飞机工业集团（沈飞）/ 中国航空工业集团（AVIC）", "relation": "歼-35研制生产方", "discovered_at": "2026-11-10T23:37:37.347454"}, {"source": "沈阳飞机工业集团（沈飞）/ 中国航空工业集团（AVIC）", "relation": "车间出现五架歼-35同框", "discovered_at": "2026-11-10T23:37:37.347456"}, {"source": "涡扇-19（WS-19）", "relation": "歼-35动力方案", "discovered_at": "2026-11-10T23:37:37.347462"}, {"source": "涡扇-19（WS-19）", "relation": "自媒体称推力18吨", "discovered_at": "2026-11-10T23:37:37.347464"}, {"source": "涡扇-19（WS-19）", "relation": "成熟度影响交付节奏", "discovered_at": "2026-11-10T23:37:37.347466"}, {"source": "巴基斯坦空军", "relation": "潜在首个出口客户", "discovered_at": "2026-11-10T23:37:37.347473"}, {"source": "巴基斯坦空军", "relation": "现役中国装备含枭龙、歼-10CE", "discovered_at": "2026-11-10T23:37:37.347476"}, {"source": "霹雳-15（PL-15）", "relation": "歼-35主战超视距武器", "discovered_at": "2026-11-10T23:37:37.347482"}, {"source": "霹雳-15（PL-15）", "relation": "射程被称200公里", "discovered_at": "2026-11-10T23:37:37.347484"}, {"source": "霹雳-15（PL-15）", "relation": "与巴现役歼-10CE弹药通用", "discovered_at": "2026-11-10T23:37:37.347487"}, {"source": "歼-10CE", "relation": "巴空军现役中国战机", "discovered_at": "2026-11-10T23:37:37.347492"}, {"source": "歼-10CE", "relation": "与歼-35形成体系衔接", "discovered_at": "2026-11-10T23:37:37.347495"}, {"source": "土耳其KAAN", "relation": "巴基斯坦五代机备选方案", "discovered_at": "2026-11-10T23:37:37.347500"}, {"source": "土耳其KAAN", "relation": "被称2030年才达完全技术状态", "discovered_at": "2026-11-10T23:37:37.347503"}, {"source": "土耳其KAAN", "relation": "与歼-35构成竞争", "discovered_at": "2026-11-10T23:37:37.347505"}, {"source": "傅前哨", "relation": "军事评论员", "discovered_at": "2026-11-10T23:37:37.347511"}, {"source": "傅前哨", "relation": "解读0001编号为出口专供序列", "discovered_at": "2026-11-10T23:37:37.347514"}, {"source": "歼-35A / 歼-35AE（出口型）", "relation": "巴基斯坦空军潜在首个海外用户", "discovered_at": "2026-11-10T23:37:39.645232"}, {"source": "歼-35A / 歼-35AE（出口型）", "relation": "2024珠海航展首次公开", "discovered_at": "2026-11-10T23:37:39.645235"}, {"source": "歼-35A / 歼-35AE（出口型）", "relation": "央视公开编号0001实机", "discovered_at": "2026-11-10T23:37:39.645237"}, {"source": "空警-500", "relation": "与歼-35打包采购", "discovered_at": "2026-11-10T23:37:39.645244"}, {"source": "空警-500", "relation": "6架规模", "discovered_at": "2026-11-10T23:37:39.645246"}, {"source": "红旗-19", "relation": "一揽子协议组成部分", "discovered_at": "2026-11-10T23:37:39.645252"}, {"source": "红旗-19", "relation": "远程防空反导", "discovered_at": "2026-11-10T23:37:39.645254"}, {"source": "WS-19发动机", "relation": "报道称随交易技术转让", "discovered_at": "2026-11-10T23:37:39.645259"}, {"source": "WS-19发动机", "relation": "影响出口审批与交付节奏", "discovered_at": "2026-11-10T23:37:39.645262"}, {"source": "巴基斯坦国防部（防长阿西夫）", "relation": "2025年6月公开否认已签合同", "discovered_at": "2026-11-10T23:37:39.645269"}, {"source": "卡拉姆航空联合体（PAC Kamra）", "relation": "后续批次本地组装", "discovered_at": "2026-11-10T23:37:39.645275"}, {"source": "卡拉姆航空联合体（PAC Kamra）", "relation": "技术转让落地载体", "discovered_at": "2026-11-10T23:37:39.645277"}, {"source": "伊斯兰堡时报", "relation": "120亿美元协议消息原始出处", "discovered_at": "2026-11-10T23:37:39.645283"}, {"source": "格隆汇", "relation": "转引伊斯兰堡时报报道", "discovered_at": "2026-11-10T23:37:39.645289"}, {"source": "沙特阿拉伯", "relation": "潜在资金支持方", "discovered_at": "2026-11-10T23:37:39.645295"}, {"source": "沙特阿拉伯", "relation": "缓解巴方财政压力", "discovered_at": "2026-11-10T23:37:39.645298"}, {"source": "阿塞拜疆JF-17合同（46亿美元/40架）", "relation": "同期军贸可比案例", "discovered_at": "2026-11-10T23:37:39.645306"}, {"source": "阿塞拜疆JF-17合同（46亿美元/40架）", "relation": "枭龙出口定价参照", "discovered_at": "2026-11-10T23:37:39.645309"}, {"source": "歼-35/歼-35A/FC-31", "relation": "中国航空工业集团研制", "discovered_at": "2026-11-10T23:37:39.957993"}, {"source": "歼-35/歼-35A/FC-31", "relation": "巴基斯坦潜在采购对象", "discovered_at": "2026-11-10T23:37:39.957998"}, {"source": "歼-35/歼-35A/FC-31", "relation": "与F-35可比", "discovered_at": "2026-11-10T23:37:39.958001"}, {"source": "土耳其KAAN“可汗”", "relation": "巴基斯坦替代选项", "discovered_at": "2026-11-10T23:37:39.958012"}, {"source": "土耳其KAAN“可汗”", "relation": "发动机依赖美国", "discovered_at": "2026-11-10T23:37:39.958016"}, {"source": "土耳其KAAN“可汗”", "relation": "2028年首批交付本国", "discovered_at": "2026-11-10T23:37:39.958020"}, {"source": "土耳其航空航天工业公司(TAI/TUSAŞ)", "relation": "KAAN研制方", "discovered_at": "2026-11-10T23:37:39.958028"}, {"source": "苏-57", "relation": "印度紧急采购140架", "discovered_at": "2026-11-10T23:37:39.958034"}, {"source": "苏-57", "relation": "俄罗斯向印度全面转让技术", "discovered_at": "2026-11-10T23:37:39.958037"}, {"source": "印度斯坦航空公司(HAL)纳西克工厂", "relation": "苏-57印度本土生产", "discovered_at": "2026-11-10T23:37:39.958043"}, {"source": "AMCA", "relation": "印度国产五代机", "discovered_at": "2026-11-10T23:37:39.958049"}, {"source": "AMCA", "relation": "预计2035年服役", "discovered_at": "2026-11-10T23:37:39.958051"}, {"source": "空警-500/KJ-500", "relation": "与歼-35打包采购", "discovered_at": "2026-11-10T23:37:39.958057"}, {"source": "红旗-19/HQ-19", "relation": "与歼-35打包采购", "discovered_at": "2026-11-10T23:37:39.958063"}, {"source": "JF-17“枭龙”", "relation": "巴基斯坦出口阿塞拜疆40架/46亿美元", "discovered_at": "2026-11-10T23:37:39.958069"}, {"source": "JF-17“枭龙”", "relation": "可比军售案例", "discovered_at": "2026-11-10T23:37:39.958072"}, {"source": "谢里夫", "relation": "巴基斯坦总理", "discovered_at": "2026-11-10T23:37:39.958078"}, {"source": "谢里夫", "relation": "2025年6月发布采购确认内容", "discovered_at": "2026-11-10T23:37:39.958080"}, {"source": "西迪胡", "relation": "巴基斯坦空军参谋长", "discovered_at": "2026-11-10T23:37:39.958086"}, {"source": "西迪胡", "relation": "2024年1月称采购基础已奠定", "discovered_at": "2026-11-10T23:37:39.958088"}, {"source": "福建舰", "relation": "歼-35舰载型需求方", "discovered_at": "2026-11-10T23:37:39.958094"}, {"source": "福建舰", "relation": "影响产能分配", "discovered_at": "2026-11-10T23:37:39.958096"}]}, "stats": {"entitiesCount": 31, "relationsCount": 64}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:37:39.958390", "content": {"agent": "DeepScout", "section": "竞争格局", "facts_count": 11, "duplicates_removed": 0, "data_points_count": 24, "insights": ["所有来源均未给出歼-35对巴出口的合同金额，仅有“40架”这一数量传闻，且该数量在2024年12月至2026年7月的多篇报道中反复出现但源头单一，缺乏官方背书——金额只能通过可比案例（如40架JF-17/46亿美元）与巴国防预算倒推，且五代机单价远高于枭龙，外推风险大。", "交付时间表存在根本性分歧：一派称2026年即可接收首架（隐含签约后1年内交付），另一派强调歼-35A仅小批量入役、舰载型优先、年产能否上百架是瓶颈。分歧根源在于“签约时点”本身未被证实——巴方2025年6月的“官宣”未获中方确认，可能只是政治表态而非生效合同。", "巴基斯坦的替代方案实际可用性很低：土耳其KAAN最早2030年后才能交付巴方且发动机受制于美国；印度AMCA要2035年；欧洲无成熟出口型五代机；美国F-35对巴基本不可得。这构成歼-35在巴方选项中的准垄断地位，反而削弱了中方在价格与交付节奏上的让步动机。"], "source_quality": "整体来源质量偏低，不足以支撑定量结论。10篇结果中无任何官方来源（中国政府、巴基斯坦政府、中航工业、巴空军）或学术/智库来源；中华网军事（2篇）与腾讯网属一般新闻门户的军事频道，可信度约0.45-0.5；网易、搜狐、今日头条、西陆网均为自媒体或聚合平台转述，可信度0.2-0.35，其中西陆网一篇文末明确标注“AI辅助创作”，其“2026年接收首架”“印度140架苏-57”等关键数字可靠性存疑。所有涉及金额、时间表的核心事实均为二手转述且相互引用，存在明显的同源放大效应（“40架”说法在2024年12月两篇今日头条文章中措辞高度相似）。此外，多篇结果日期为2025年12月至2026年7月，属未来时点，需警惕内容农场生成的推测性文章。建议后续优先检索简氏防务、SIPRI军贸数据库、巴基斯坦财政部预算文件、中国国防部例行记者会实录等一手来源，并交叉验证“40架”与“2026年交付”两个核心数字的原始出处。", "hypothesis_updates": 3, "search_results": [{"title": "俄罗斯同意全面转让五代机技术,印度会买苏57吗? 印度空军急需补强_新闻频道_中华网", "url": "https://news.china.com/socialgd/10000169/20251209/49059973_1.html", "source": "中华网新闻频道", "snippet": "巴基斯坦可以应对印度的苏-57威胁,通过与中国合作采购歼-35战斗机。歼-35具备更强的隐身性能和信息化水平,并且注重体系作战。中国与巴基斯坦的军工合作一直务实,技术交底和生产线建设经验丰富。因此,巴基斯坦可以通过采购歼-35来保持空中优势。", "date": "2025-12-09T17:05:26+08:00"}, {"title": "&quot;40架歼-35震撼出口,中巴联手,印度面临十年军事差距!&quot; - 今日头条", "url": "https://www.toutiao.com/video/7451952621969080884/", "source": "今日头条", "snippet": "巴基斯坦空军拟订购40架中国的歼-35隐形战斗机,一旦交易达成,这将标志着中国首次将第五代战斗机推向国际市场。 话说巴基斯坦空军计划采购 40 架中国歼-35 隐身战斗机,这消息一出来,南亚可就热闹了。因为这可能会打破地区军事平衡。 歼-35 那可是厉害角色,刚在珠海航展上首秀,就展现出强大的实力。 双发动机设计、隐身性能、高机动性和先进航电系统,作战性能据说能和美国 F-35 一较高下。", "date": "2024-12-24T20:22:00+08:00"}, {"title": "巴基斯坦会马上购买我国五代机歼-35吗?", "url": "https://new.qq.com/rain/a/20250521A07L5U00", "source": "腾讯网", "snippet": "此次印巴冲突,我国出口到巴基斯坦的四代机歼-10CE战果突出,大出风头。那么,巴基斯坦军方会趁着这股风头提出购买我国五代机歼-35吗?      歼-35战机肯定是可以外销的,不像歼-20战机是非卖品。只要巴方提出来,我们应该可以满足“巴铁”的需求。      这几天,巴基斯坦外长达尔正在我国访问。据相关媒体报道,双方只谈到了中巴经济走廊等问题,并不涉及到军火购买等话题。      也许有人说,这么敏感的问题,肯定不会公开报道。这固然是一个原因,但从现阶段来看,巴基斯坦方面并不会急于购买我军的五代机歼-35。为何这样说呢?      一是,巴基斯坦国力有限,而五代机歼-35价格肯定不会便宜,巴方要成规模地买,其虚弱的国力恐怕承受不起;      二是,购买五代机歼-35与巴基斯坦的军事战略不符,当前巴方奉行的是守势战略,所以其购买的武器装备就是防守型的,比如歼-10CE战机就属于这种类型;而歼-35战机,还有歼-16战", "date": "2025-05-21T17:21:01+08:00"}, {"title": "能耐不?土耳其也造出了五代机!歼35出口巴基斯坦遇对手?|f-35|五代机|土耳其|巴基斯坦|战机|枭龙_手机网易网", "url": "https://m.163.com/dy/article/L2VQ641G0556CER8.html", "source": "网易", "snippet": "最近,巴基斯坦五代机采购的棋局突然变得复杂起来。原本外界普遍认为,巴基斯坦空军引进中国歼-35AE隐身战斗机只是时间问题,甚至可能年内就能接收首批。但如今,巴基斯坦的“购物车”里,似乎又多了一个选项——土耳其的KAAN“可汗”五代机。就在2026年7月24日,KAAN的P1原型机刚刚完成低速滑行测试,距离首飞仅一步之遥。\n打开网易新闻\n查看精彩图片\n2026年7月24日,土耳其航空航天工业公司(TAI)的KAAN第五代战斗机P1原型机,在安卡拉附近的TUSAŞ跑道上完成了低速滑行测试。这是该机距离首飞最近的一次关键里程碑。TAI首席执行官表示,P1有望在“几个月内”首飞,P2也将在2026年底前升空。土耳其计划共制造6架原型机以支持飞行试验,2028年开始向本国空军交付首批20架,目标年产24架,总产量预计可达250-300架。\n打开网易新闻\n查看精彩图片\nKAAN的纸面数据相当漂亮。它属于标准的重型双发隐身战斗机,目标直指美、俄、中之外的“第四极”。机长超20米,最大起飞重量约34.7吨,与美国的F-22和中国的歼-20属于同一级别。最大速度约1.8马赫,具备超音速巡航能力。采用低可探测性设计和内部武器舱来保证隐身,配备有源相控阵雷达,据称探测距离超250公里,能同时跟踪64个目标。但KAAN最大的软肋和它诞生的初衷正好是一回事:发动机还捏在美国手里。土耳其之所以搞KAAN,本身就是被美国踢出F-35项目后逼出来的“争气机”。但讽刺的是,早期型号的心脏——两台通用电气F110-GE-129发动机——依然是美国造。土耳其计划未来换装国产TF35000发动机,设计推力35,000磅级别,但要到2032年后的Block\n30/40批次才能使用。在此之前,KAAN的出口和交付都得看美国的脸色。\n打开网易新闻\n查看精彩图片\n这个困境在出口市场上已经显现。2025年6月,印尼签署了", "date": "2026-07-29T04:14:01+08:00"}, {"title": "中巴给印度上强度,歼-35一口气出口40架,一张订单拉开10年差距 - 今日头条", "url": "https://www.toutiao.com/article/7451809906040029733/", "source": "今日头条", "snippet": "巴基斯坦空军计划采购40架中国歼-35隐身战斗机,如果订单敲定,这将是中国首次向海外出口第五代战机。消息传出后立即在南亚引发轩然大波,印度军事专家纷纷发声,认为这一采购将打破地区军事平衡。虽然中巴双方尚未正式确认这一消息,但巴基斯坦空军司令西迪胡今年1月已经表示\"购买歼-31(歼-35前身)的基础已经奠定\",这一表态为消息的可信度增添了砝码。", "date": "2024-12-24T11:13:00+08:00"}, {"title": "能耐不?土耳其也造出了五代机!歼35出口巴基斯坦遇对手?", "url": "https://c.m.163.com/news/a/L2VQ641G0556CER8.html", "source": "网易新闻客户端", "snippet": "最近,巴基斯坦五代机采购的棋局突然变得复杂起来。原本外界普遍认为,巴基斯坦空军引进中国歼-35AE隐身战斗机只是时间问题,甚至可能年内就能接收首批。但如今,巴基斯坦的“购物车”里,似乎又多了一个选项——土耳其的KAAN“可汗”五代机。就在2026年7月24日,KAAN的P1原型机刚刚完成低速滑行测试,距离首飞仅一步之遥。\n2026年7月24日,土耳其航空航天工业公司(TAI)的KAAN第五代战斗机P1原型机,在安卡拉附近的TUSAŞ跑道上完成了低速滑行测试。这是该机距离首飞最近的一次关键里程碑。TAI首席执行官表示,P1有望在“几个月内”首飞,P2也将在2026年底前升空。土耳其计划共制造6架原型机以支持飞行试验,2028年开始向本国空军交付首批20架,目标年产24架,总产量预计可达250-300架。\nKAAN的纸面数据相当漂亮。它属于标准的重型双发隐身战斗机,目标直指美、俄、中之外的“第四极”。机长超20米,最大起飞重量约34.7吨,与美国的F-22和中国的歼-20属于同一级别。最大速度约1.8马赫,具备超音速巡航能力。采用低可探测性设计和内部武器舱来保证隐身,配备有源相控阵雷达,据称探测距离超250公里,能同时跟踪64个目标。但KAAN最大的软肋和它诞生的初衷正好是一回事:发动机还捏在美国手里。土耳其之所以搞KAAN,本身就是被美国踢出F-35项目后逼出来的“争气机”。但讽刺的是,早期型号的心脏——两台通用电气F110-GE-129发动机——依然是美国造。土耳其计划未来换装国产TF35000发动机,设计推力35,000磅级别,但要到2032年后的Block\n30/40批次才能使用。在此之前,KAAN的出口和交付都得看美国的脸色。\n这个困境在出口市场上已经显现。2025年6月,印尼签署了采购48架KAAN的协议,总值约100亿美元。但有消息称,印尼要求交付的是配备国产发动", "date": "2026-07-29T04:14:00+08:00"}, {"title": "巴基斯坦有望成为首个引进歼-35国家,飞行员培训等都在计划中_采购_战机_第五代", "url": "https://m.sohu.com/a/1034424718_121410513?scm=10001.849_13-101000-0_8000.0-0.0-1-0-0-0.0_6155", "source": "手机搜狐网", "snippet": "近日,《航空新闻》一份报告详细介绍了巴基斯坦有望成为首个引进中国歼-35战机的情况。\n报告称,巴基斯坦已就采购多达40架中国第五代隐形战斗机歼-35签署初步协议,即将成为首个购买中国第五代歼-35隐形战斗机的国际买家。\n作为配套计划的一部分,还将计划采购KJ-500预警机和HQ-19防空系统。\n众所周知,之前巴基斯坦已经采购过中国产歼-10C战斗机,并且在实战中取得了良好的战绩,所以现在采购第五代歼-35隐形战斗机是顺理成章的事情,毕竟这样可以形成一个相互兼容的作战体系。若再去购买别国武器系统,那就很难实现互联互通互操作了。\n据介绍,五代机歼-35的飞行员培训、基地升级以及更广泛的现代化计划正在进行中。\n预计该采购项目将成为巴基斯坦2025-26财年国防采购优先事项之一。若最终敲定,第五代隐形战机与预警机及先进防空系统的列装,将标志着巴基斯坦空中作战能力的重大转变,并重塑地区军事力量格局。\n可以想象,此举一定会刺激印度,使其加速采购五代机。\n歼-35是一款双发隐形战斗机,具备内置武器舱和低可探测性设计特点,常被与美国F-35“闪电”II战机相比较。\n据悉,其技术参数包括长约17.3米、翼展11.5米、最大起飞重量约28,000公斤,以及接近1.8马赫的最高速度。\n该战机设计用于携带多种内置弹药,包括空对空导弹、对地攻击导弹和反辐射导弹。", "date": "2026-06-09T22:37:00+08:00"}, {"title": "巴基斯坦“官宣”采购歼35 疑似成真引发关注_军事频道_中华网", "url": "https://military.china.com/news/13004177/20250609/48440457_all.html", "source": "中华网军事", "snippet": "巴基斯坦“官宣”采购歼35\n疑似成真引发关注。巴基斯坦政府官方账号于6月6日发布消息称,在总理谢里夫的领导下,巴基斯坦取得多项重大外交成就。其中包括从中国购买40架歼-35隐形五代机、空警-500预警机和红旗-19反导系统,以及延期偿还37亿美元债务等。此外,巴基斯坦还与阿塞拜疆签署了价值46亿美元的合同,包括40架JF-17“枭龙”战斗机。去年1月份,巴基斯坦空军参谋长表示已经做好准备迎接中国制造的歼-31,这并非无中生有。中巴在军事合作方面一向关系密切且高效,可以认为双方在此之前已经进行了协调和洽谈。现在选择公开,只是因为项目进展顺利。对于巴基斯坦来说,刚取得空战胜利又得到隐形五代机,士气必将大幅提升,压力直接转移到印度。歼-35采用一机多型设计,除了空军型和海军舰载型外,还有专门定位出口外贸型。该机型在市场上已推出多年,编号包括FC-31和歼-31,虽然性能可能略低于自用型号,但隐形五代机的吸引力依然很大。鉴于中巴军事互动频繁,巴基斯坦采购歼-35显然没有问题。特别是在歼-10CE表现出色的情况下,一次购买40架并不算多。歼-35A空军型去年在珠海航展上首次对外官宣,目前仅小批量装备入役,产能需先满足国内需求。海军舰载型随着福建舰即将交付,至少需要制造50-60架以上。因此,能否实现类似歼-20的脉动生产线,年产百架以满足自用和外贸需求是关键。由于歼-10CE在印巴空战中的出色表现,许多潜在客户已准备入手,这些客户不乏经济实力雄厚者。他们不仅会购买歼-10CE单机,还可能成套购入打造中式体系。全球市场上,能够现货正常出售且无附加条件的隐形五代机,除歼-35外别无他选。巴基斯坦作为传统老用户,优先保质保量供应或许能加速外贸装备出口。空警-500配套出售合理,现代空战离不开预警机支持。然而,红旗-19属于战略反导系统,巴基斯坦似乎并无急迫需求,其购买原因尚不明确。尽管巴", "date": "2025-06-09T09:08:00+08:00"}, {"title": "央视公开歼35战机关键数据:隐身性能全球领先|中国军队_西陆wap站", "url": "https://m.xilu.com/mi/1000010001252597_6.html", "source": "西陆wap站", "snippet": "05\n区域平衡的变革者:歼-35引发南亚军备竞赛\n歼-35的出现,正在改变南亚地区的军事平衡。面对巴基斯坦可能引进歼-35的前景,印度空军已经感到“慌了”。\n印度国防部祭出大招:紧急订购140架俄罗斯苏-57第五代战斗机,计划装备七个中队。\n印度计划先从俄罗斯“现货”提走两个中队的苏-57(约40架),然后在印度斯坦航空公司纳西克工厂再生产五个中队(约100架)。\n巴基斯坦已经在2024年通过官方社交媒体宣布,巴基斯坦空军已经决定购买中国歼-35战斗机。\n巴基斯坦最快可以在2026年接收第一架歼-35战斗机。与此同时,巴基斯坦还在与土耳其联合开发第五代战机KAAN,形成双重保险。\n土耳其方面则试图向巴基斯坦推销自己的KAAN战斗机,称其更像中国的歼-20,而不是歼-35,航程远、武器装备的多。\n但分析指出,KAAN战斗机在2024年才首飞,整个试飞计划将会在2026年完成,2029年之前交付第一批预先生产型。\n巴基斯坦最快也要在2030年之后才能拿到第1架KAAN战斗机,这还是试飞顺利情况下。\n面对这一局势,印度也启动了国产第五代隐身战机项目(AMCA),但该项目预计要到2035年才会服役,首飞时间已经从2025年推迟到了2028年。\n(本文由AI辅助创作)", "date": "2025-09-28T00:00:00+08:00"}, {"title": "巴若获40架歼35对南亚局势有何影响 空军代差优势重塑平衡_军事频道_中华网", "url": "https://military.china.com/news/13004177/20250607/48435839_all.html", "source": "中华网军事", "snippet": "关于巴基斯坦可能会引进歼-35战斗机的消息一度引发广泛关注,不少军迷对此展开了热烈讨论。然而,这一消息一直未得到官方证实。最近,巴基斯坦终于在官方层面上宣布了引进歼-35的计划。巴方官方账号在社交媒体上确认,中国已同意向巴基斯坦出售40架歼-35隐身战斗机,同时还包括空警-500预警机和红旗-19反导系统。巴基斯坦总理谢里夫也发布了确认内容,并宣布阿塞拜疆与巴基斯坦签署了一项价值20亿美元的投资和46亿美元的国防合同,阿塞拜疆将购买40架巴基斯坦制造的JF-17\nblock\n“枭龙”战斗机。尽管巴方发布的消息尚未得到中方的确认,但有理由相信,巴基斯坦选择歼-35作为下一代战机的可能性很大。对于巴基斯坦来说,引进歼-35将使其空军进入“五代机时代”,整体作战能力将显著增强。对歼-35而言,如果这笔大单最终落实,它将成为继美国F-35和俄罗斯苏-57之后第三款成功出口的五代机,这无疑对其外销是一个巨大助力。相比美国的F-35战斗机,歼-35具有明显优势。专家认为,歼-35是全球隐身能力最强的五代机之一。其设计理念先进,采用复合材料制造,并使用了可以吸纳雷达波的隐身涂料,整体隐身性能非常出色。歼-35还配备了大功率机载有源相控阵雷达,航电性能优于F-35。此外,歼-35搭载的PL系列空空导弹赋予其强大的超视距打击能力。歼-35的整体战力和性能在全球范围内处于顶尖水平,一旦巴基斯坦空军引进歼-35,整个印巴形势乃至南亚局势都将发生重大变化。巴基斯坦空军引进歼-35后,可以利用质量优势抵消印度空军的数量优势。印度空军规模远大于巴基斯坦,装备有约30余架法国阵风战机、200多架俄制苏-30系列战机以及大量其他型号的战斗机。然而,印度空军目前的五代机计划进展缓慢,从美国采购F-35或从俄罗斯采购苏-57都存在各种问题,自研五代机计划虽已批准,但实现仍需时日。因此,一旦巴基斯坦装备歼-3", "date": "2025-06-07T15:39:00+08:00"}], "extracted_facts": [{"content": "巴基斯坦政府官方社交媒体账号于2025年6月6日发布消息，称在总理谢里夫领导下取得的外交成就包括从中国购买40架歼-35隐身五代机、空警-500预警机和红旗-19反导系统，以及延期偿还37亿美元债务；但该消息未获中方确认。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20250609/48440457_all.html", "credibility": 0.5}, {"content": "巴基斯坦官方账号确认中国同意出售40架歼-35，同时包括空警-500预警机和红旗-19反导系统；同一批消息中还提到阿塞拜疆与巴基斯坦签署20亿美元投资和46亿美元国防合同，购买40架巴基斯坦制造的JF-17“枭龙”战斗机。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20250607/48435839_all.html", "credibility": 0.5}, {"content": "《航空新闻》报告称，巴基斯坦已就采购多达40架中国歼-35签署初步协议，将成为首个购买歼-35的国际买家；配套计划还包括采购KJ-500预警机和HQ-19防空系统，飞行员培训、基地升级正在进行，预计该项目将成为巴基斯坦2025-26财年国防采购优先事项之一。", "source_name": "手机搜狐网（转述《航空新闻》报告）", "source_url": "", "credibility": 0.35}, {"content": "巴基斯坦空军参谋长（空军司令西迪胡）于2024年1月表示“购买歼-31（歼-35前身）的基础已经奠定”，为采购传闻增添可信度；但中巴双方尚未正式确认40架订单。", "source_name": "今日头条", "source_url": "https://www.toutiao.com/article/7451809906040029733/", "credibility": 0.25}, {"content": "歼-35A空军型2024年在珠海航展首次官宣，目前仅小批量装备入役，产能需优先满足国内需求；海军舰载型随福建舰交付至少需要50-60架以上，能否建成类似歼-20的脉动生产线、实现年产百架以满足自用与外贸需求是关键变量。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20250609/48440457_all.html", "credibility": 0.5}, {"content": "有报道称巴基斯坦最快可在2026年接收第一架歼-35战斗机；同时巴基斯坦与土耳其联合开发KAAN作为“双重保险”，但巴方最快也要在2030年之后才能拿到首架KAAN（前提是试飞顺利）。", "source_name": "西陆wap站（文末标注AI辅助创作）", "source_url": "https://m.xilu.com/mi/1000010001252597_6.html", "credibility": 0.2}, {"content": "土耳其KAAN第五代战斗机P1原型机于2026年7月24日完成低速滑行测试，有望“几个月内”首飞，P2将于2026年底前升空；土耳其计划制造6架原型机，2028年开始向本国空军交付首批20架，目标年产24架，总产量预计250-300架；其最大软肋是发动机依赖美国。", "source_name": "网易", "source_url": "https://m.163.com/dy/article/L2VQ641G0556CER8.html", "credibility": 0.35}, {"content": "印度国防部紧急订购140架俄罗斯苏-57，计划装备七个中队：先从俄罗斯“现货”提走两个中队（约40架），再在印度斯坦航空公司纳西克工厂生产五个中队（约100架）；印度国产AMCA预计2035年服役，首飞从2025年推迟至2028年。", "source_name": "西陆wap站（文末标注AI辅助创作）", "source_url": "https://m.xilu.com/mi/1000010001252597_6.html", "credibility": 0.2}], "data_points": [{"name": "歼-35采购数量", "value": "40", "unit": "架", "year": 2025, "source": "中华网军事"}, {"name": "配套采购", "value": "空警-500+红旗-19", "unit": "项", "year": 2025, "source": "中华网军事"}, {"name": "延期偿还债务", "value": "37", "unit": "亿美元", "year": 2025, "source": "中华网军事"}, {"name": "JF-17出口合同金额", "value": "46", "unit": "亿美元", "year": 2025, "source": "中华网军事"}, {"name": "JF-17出口数量", "value": "40", "unit": "架", "year": 2025, "source": "中华网军事"}, {"name": "阿塞拜疆对巴投资", "value": "20", "unit": "亿美元", "year": 2025, "source": "中华网军事"}, {"name": "初步协议采购数量", "value": "40", "unit": "架", "year": 2026, "source": "手机搜狐网（转述《航空新闻》报告）"}, {"name": "巴国防采购财年", "value": "2025-26", "unit": "财年", "year": 2025, "source": "手机搜狐网（转述《航空新闻》报告）"}, {"name": "巴空军高层表态时间", "value": "2024-01", "unit": "年月", "year": 2024, "source": "今日头条"}, {"name": "舰载型最低需求", "value": "50-60", "unit": "架", "year": 2025, "source": "中华网军事"}]}}

