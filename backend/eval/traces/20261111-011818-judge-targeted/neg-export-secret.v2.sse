data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T23:37:02.082954", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述中巴军贸规模、巴基斯坦空军现代化需求、五代机出口市场空间及潜在合同金额区间。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中巴军贸 歼-35 巴基斯坦 合同金额 交付时间 五代机出口市场"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述全球隐身战机出口主要供应方及巴基斯坦可选替代方案，包括美国、俄罗斯、欧洲、土耳其和韩国等。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["巴基斯坦 五代机 采购 竞争 歼-35 F-35 苏-57 KAAN 出口"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述歼-35出口型技术配置、隐身性能、发动机方案、武器系统集成及与巴方现役体系兼容性。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["歼-35 出口型 技术参数 发动机 隐身 巴基斯坦 空军 兼容性"]}, {"id": "sec_4", "title": "政策环境", "description": "描述中国军品出口管制政策、巴基斯坦国防采购政策、国际制裁与地区安全政策对合同和交付的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中国 军品出口 管制 巴基斯坦 国防采购 政策 制裁 歼-35"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述合同金额不确定性、巴方财政约束、技术保密、产能交付风险，以及深化中巴防务合作带来的机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["巴基斯坦 国防预算 财政 歼-35 采购 风险 交付 产能 中巴防务合作"]}, {"id": "sec_6", "title": "未来展望", "description": "描述合同披露可能性、金额估算区间、交付时间表关键节点及后续批次采购趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["歼-35 巴基斯坦 交付 时间表 合同 披露 后续批次 预测"]}], "research_questions": ["歼-35向巴基斯坦出口的合同金额是否已有官方披露或可靠估算区间？", "首批交付和形成战斗力的关键时间节点可能是什么？", "影响合同金额和交付时间表的主要技术、财政和政策因素有哪些？"]}}

