data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:38:49.190578", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["Times of Islamabad 2026年4月关于巴基斯坦中国120亿美元防务协议原文", "The News International 2026年4月10日巴基斯坦采购空警-500、歼-35A、红旗-19谈判报道原文"], "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:38:50.005239", "content": {"results": [{"id": "sr_788e3e", "title": "《伊斯兰堡时报》2026年4月13日爆料:中巴要签120亿美元防务协议", "source": "网易新闻客户端", "url": "https://c.m.163.com/news/a/KQIRGVBE05566O41.html", "snippet": "文/资深国际政治军事观察员时间:2026年4月15日这两天,我的推特(X)和微信朋友圈几乎被同一条消息炸屏了。不是关于美国大选的新瓜,也不是关于俄乌前线的拉锯,而是一条来自巴基斯坦《伊斯兰堡时报》的爆炸性新闻——中巴即将签署一份价值120亿美元的“世纪防务协议”。如果这只是个小数目,哪怕是10亿、20亿,大家可能也就当个茶余饭后的谈资。但120亿美元,而且涉及的是歼-35A隐身战机、空警-500预警机,甚至是红旗-19战略反导系统。这不仅仅是军售,这是在南亚次大陆的头顶上,准备换一片天。今天是2026年4月15日,距离那篇引发全球地震的报道已经过去了两天。这48小时里,新德里的灯光恐怕彻夜未熄,华盛顿的五角大楼官员们大概率在疯狂拨打热线,而北京和伊斯兰堡的国防部大楼里,或许正如往常般平静,但这种平静之下,暗流早已汹涌成海。作为一名长期关注中国军工与地缘政治的观察者,我不想仅仅复述那些冰冷的参数和数字。我想带大家走进这团迷雾的中心,去看看这120亿美元背后,究竟藏着怎样的战略算计、情感纠葛和大国博弈。一、\n账本背后的“不可能三角”让我们先把那张让全世界军迷垂涎欲滴的“购物清单”摊开在桌面上。《伊斯兰堡时报》披露的细节简直精确到了令人发指的程度:40架歼-35A,单价8000万美元,总计32亿;6架空警-500,每架3亿,总计18亿;4个团的红旗-19反导系统,45亿;再加上弹药、培训、基地升级等杂费25亿。这一连串数字砸下来,第一反应是什么?是“爽”,第二反应是“晕”。爽的是,如果成真,这是中国高端军工成体系走出去的里程碑。晕的是,巴基斯坦哪来的钱?咱们得算账。根据国际货币基金组织和各大智库的数据,巴基斯坦2025-2026财年的国防预算满打满算也就90亿美元出头。这120亿,相当于巴铁不吃不喝攒一年半的军费,或者是四年的装备采购费。这就引出了第一个核心疑问:钱从哪来?我在之", "date": "2026-04-15T17:21:00+08:00"}, {"id": "sr_230c92", "title": "《伊斯兰堡时报》2026年4月13日爆料:中巴要签120亿美元防务协议|反导系统|巴基斯坦|隐身战机_网易订阅", "source": "网易", "url": "https://www.163.com/dy/article/KQIRGVBE05566O41.html", "snippet": "文/资深国际政治军事观察员时间:2026年4月15日这两天,我的推特(X)和微信朋友圈几乎被同一条消息炸屏了。不是关于美国大选的新瓜,也不是关于俄乌前线的拉锯,而是一条来自巴基斯坦《伊斯兰堡时报》的爆炸性新闻——中巴即将签署一份价值120亿美元的“世纪防务协议”。如果这只是个小数目,哪怕是10亿、20亿,大家可能也就当个茶余饭后的谈资。但120亿美元,而且涉及的是歼-35A隐身战机、空警-500预警机,甚至是红旗-19战略反导系统。这不仅仅是军售,这是在南亚次大陆的头顶上,准备换一片天。今天是2026年4月15日,距离那篇引发全球地震的报道已经过去了两天。这48小时里,新德里的灯光恐怕彻夜未熄,华盛顿的五角大楼官员们大概率在疯狂拨打热线,而北京和伊斯兰堡的国防部大楼里,或许正如往常般平静,但这种平静之下,暗流早已汹涌成海。作为一名长期关注中国军工与地缘政治的观察者,我不想仅仅复述那些冰冷的参数和数字。我想带大家走进这团迷雾的中心,去看看这120亿美元背后,究竟藏着怎样的战略算计、情感纠葛和大国博弈。一、\n账本背后的“不可能三角”让我们先把那张让全世界军迷垂涎欲滴的“购物清单”摊开在桌面上。《伊斯兰堡时报》披露的细节简直精确到了令人发指的程度:40架歼-35A,单价8000万美元,总计32亿;6架空警-500,每架3亿,总计18亿;4个团的红旗-19反导系统,45亿;再加上弹药、培训、基地升级等杂费25亿。这一连串数字砸下来,第一反应是什么?是“爽”,第二反应是“晕”。爽的是,如果成真,这是中国高端军工成体系走出去的里程碑。晕的是,巴基斯坦哪来的钱?咱们得算账。根据国际货币基金组织和各大智库的数据,巴基斯坦2025-2026财年的国防预算满打满算也就90亿美元出头。这120亿,相当于巴铁不吃不喝攒一年半的军费,或者是四年的装备采购费。这就引出了第一个核心疑问:钱从哪来?我在", "date": "2026-04-15T17:21:43+08:00"}, {"id": "sr_cce55e", "title": "《伊斯兰堡时报》2026年4月13日爆料:中巴要签120亿美元防务协议|中巴|反导系统|巴基斯坦|防务协议|隐身战机_手机网易网", "source": "网易", "url": "https://m.163.com/dy/article/KQIRGVBE05566O41.html", "snippet": "文/资深国际政治军事观察员时间:2026年4月15日这两天,我的推特(X)和微信朋友圈几乎被同一条消息炸屏了。不是关于美国大选的新瓜,也不是关于俄乌前线的拉锯,而是一条来自巴基斯坦《伊斯兰堡时报》的爆炸性新闻——中巴即将签署一份价值120亿美元的“世纪防务协议”。如果这只是个小数目,哪怕是10亿、20亿,大家可能也就当个茶余饭后的谈资。但120亿美元,而且涉及的是歼-35A隐身战机、空警-500预警机,甚至是红旗-19战略反导系统。这不仅仅是军售,这是在南亚次大陆的头顶上,准备换一片天。今天是2026年4月15日,距离那篇引发全球地震的报道已经过去了两天。这48小时里,新德里的灯光恐怕彻夜未熄,华盛顿的五角大楼官员们大概率在疯狂拨打热线,而北京和伊斯兰堡的国防部大楼里,或许正如往常般平静,但这种平静之下,暗流早已汹涌成海。作为一名长期关注中国军工与地缘政治的观察者,我不想仅仅复述那些冰冷的参数和数字。我想带大家走进这团迷雾的中心,去看看这120亿美元背后,究竟藏着怎样的战略算计、情感纠葛和大国博弈。一、\n账本背后的“不可能三角”让我们先把那张让全世界军迷垂涎欲滴的“购物清单”摊开在桌面上。《伊斯兰堡时报》披露的细节简直精确到了令人发指的程度:40架歼-35A,单价8000万美元,总计32亿;6架空警-500,每架3亿,总计18亿;4个团的红旗-19反导系统,45亿;再加上弹药、培训、基地升级等杂费25亿。这一连串数字砸下来,第一反应是什么?是“爽”,第二反应是“晕”。爽的是,如果成真,这是中国高端军工成体系走出去的里程碑。晕的是,巴基斯坦哪来的钱?咱们得算账。根据国际货币基金组织和各大智库的数据,巴基斯坦2025-2026财年的国防预算满打满算也就90亿美元出头。这120亿,相当于巴铁不吃不喝攒一年半的军费,或者是四年的装备采购费。这就引出了第一个核心疑问:钱从哪来?我在", "date": "2026-04-15T17:21:43+08:00"}, {"id": "sr_cfa537", "title": "据报巴基斯坦与中国拟签署价值120亿美元防务协议-格隆汇", "source": "格隆汇", "url": "https://www.gelonghui.com/live/2398063", "snippet": "首页\n>\n快讯\n>\n快讯详情\n据报巴基斯坦与中国拟签署价值120亿美元防务协议\n2026-04-13\n格隆汇4月13日|据Times\nof\nIslamabad,巴基斯坦和中国很可能达成一项具有里程碑意义的120亿美元防务协议,旨在通过引进40架J-35A第五代隐形战斗机、6架KJ-500空中预警机和多套HQ-19战略导弹防御系统,实现对印度的空战质量优势。", "date": "2026-04-13T00:00:00+08:00"}, {"id": "sr_4b32e7", "title": "4月14日 | 巴媒:中巴敲定百亿美元防务协议,巴大幅提升对印空中优势", "source": "网易新闻客户端", "url": "https://c.m.163.com/news/a/KQJGHVKB05569D8L.html", "snippet": "2026年4月14日\n总第1245期值日编辑:余佳轩\n张咪咪\n何佳蔚审核:毛雅欣\n饶金山\n王若桐执行主编:陈卓*阅读今日日报,请关注“南亚问题研究小组”微信公众号\n图源:《伊斯兰堡时报》《伊斯兰堡时报》(Times\nof\nIslamabad)4月13日报道,巴基斯坦拟与中国签署一项价值120亿美元($12\nBillion)的国防协议,巴方称此举将助巴在对抗印度中获得决定性优势。据悉,此次合作涉及采购40架歼-35A第五代隐形战斗机、6架空警-500预警机及多套HQ-19战略导弹防御系统。此外,协议还涵盖精确制导武器、飞行员培训及技术转让等内容。首批歼-35A预计将于2026年中期交付,届时巴将成为首个引进中国隐形战斗机的国家。分析认为,该协议下武器装备构成一套网络化空中作战体系,为巴构建网络化空中力量架构以填补其在监视、打击能力和战略防御方面的缺口,这或将重塑南亚空中力量格局。五代机方面,印目前尚未装备同类战机,其自研项目仍处于早期测试阶段,最早到2035年后才能列装。而巴此次获得战机,或将在超视距交战中对印“阵风”战机和老旧的苏-30MKI战机形成压制,从而造成印在未来至少十年内难以弥合的能力差距。预警机方面,印仅有三架“费尔康”(Phalcon)和两套“涅特拉”(Netra)系统,巴此次将获得探测范围远达470至550公里的预警探测与指挥控制覆盖能力,并在一定程度上提升隐蔽作战能力。导弹防御方面,巴获得的HQ-19系统具备大气层外拦截能力,可抵御弹道及巡航导弹威胁,性能超越印五个S-400导弹团,印在现有系统上难以复制这一能力。专家指出,该综合系统在全面部署后的36个月内,可将巴在网络化作战中的整体作战效能提升45%-55%,而当前印国防现代化仍受交付延误、成本超支以及在出口限制下对西方依赖等因素掣肘。NEWS\n图源:半岛电视台《印刷报》半岛电视台4月13日报道,因薪", "date": "2026-04-15T23:29:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:38:57.158989", "content": {"results": [{"id": "sr_01a146", "title": "巴基斯坦总理谢里夫:双方同意推进双边合作。_外汇动态报道", "source": "汇通财经", "url": "https://www.fx678.com/C/20260711/202607110146018819.html", "snippet": "2026-07-11\n01:46:02\n汇通财经APP讯——巴基斯坦总理谢里夫:双方同意推进双边合作。", "date": "2026-07-11T01:46:02+08:00"}, {"id": "sr_a42028", "title": "外交部介绍巴基斯坦总理夏巴兹访华成果:谱写中巴关系的新篇章", "source": "搜狐", "url": "https://www.sohu.com/a/1027960890_115376?scm=10004.476600_15-300008.0.0-0-0-0-0.1101.topic:476600:110063.0.9.a2_3X1534", "snippet": "外交部介绍巴基斯坦总理夏巴兹访华成果:谱写中巴关系的新篇章\n发布于:北京市\n2026.05.26\n19:12", "date": "2026-05-26T19:12:00+08:00"}, {"id": "sr_e8a6c7", "title": "巴基斯坦总理将访华 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7642272347059421732/", "snippet": "外交部发言人宣布:\n应国务院总理李强邀请,巴基斯坦伊斯兰共和国总理夏巴兹·谢里夫将于5月23日至26日对中国进行正式访问。\n来源:外交部网站\n编辑:李明阳", "date": "2026-05-21T17:20:00+08:00"}, {"id": "sr_4447e9", "title": "外交部宣布:巴基斯坦总理夏巴兹将访华 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7642241959221936640/", "snippet": "外交部发言人宣布:应国务院总理李强邀请,巴基斯坦伊斯兰共和国总理夏巴兹·谢里夫将于5月23日至26日对中国进行正式访问。(外交部网站)", "date": "2026-05-21T17:22:00+08:00"}, {"id": "sr_f11b3f", "title": "外交部宣布:巴基斯坦总理夏巴兹将访华__财经头条__新浪财经", "source": "财经头条", "url": "https://cj.sina.com.cn/articles/view/6115560351/m16c840b9f033018opo?finpagefr=p_104_a", "snippet": "【外交部宣布:#巴基斯坦总理夏巴兹将访华#】外交部发言人宣布:应国务院总理李强邀请,巴基斯坦伊斯兰共和国总理夏巴兹·谢里夫将于5月23日至26日对中国进行正式访问。(外交部网站)", "date": "2026-05-21T15:15:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

