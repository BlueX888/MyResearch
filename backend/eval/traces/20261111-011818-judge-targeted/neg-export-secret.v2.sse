data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:45:08.836093", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'year': [2012, 2024, 2025, 2025, 2025, 2025, 2026, 2026, 2026, 2026],\n    'value': [2012, 0.001, 40, 18, 4, 2025, 1, 40, 2026, 120],\n    'name': ['FC-31首飞年份', '歼-35A RCS', '传闻交付数量', 'WS-19单台推力', '霹雳-15挂载量', '歼-35批量生产年份', '出口型原型机编号', '歼-35A采购数量', '巴基斯坦最早接收年份', '一揽子防务协议总额'],\n    'unit': ['年', '平方米', '架', '吨', '枚', '年', '架', '架', '年', '亿美元'],\n    'conf': [0.35, 0.25, 0.25, 0.25, 0.25, 0.3, 0.35, 0.5, 0.3, 0.5]\n}\ndf = pd.DataFrame(data)\ngroups = {\n    '数量类（架）': ['传闻交付数量', '出口型原型机编号', '歼-35A采购数量'],\n    '性能类（吨/枚/㎡）': ['歼-35A RCS', 'WS-19单台推力', '霹雳-15挂载量'],\n    '时间节点（年）': ['FC-31首飞年份', '歼-35批量生产年份', '巴基斯坦最早接收年份'],\n    '金额类（亿美元）': ['一揽子防务协议总额']\n}\ncolors = ['#6366f1', '#f59e0b', '#10b981', '#ef4444']\nplt.figure(figsize=(12, 7), dpi=200)\nfor (gname, names), c in zip(groups.items(), colors):\n    sub = df[df['name'].isin(names)].sort_values('year')\n    plt.plot(sub['year'], sub['value'], marker='o', markersize=8, linewidth=2.5, color=c, label=gname)\n    plt.fill_between(sub['year'], sub['value'], 5e-4, alpha=0.15, color=c)\n    for x, y in zip(sub['year'], sub['value']):\n        plt.annotate(str(y), (x, y), textcoords='offset points', xytext=(0, 11), ha='center', fontsize=10, color=c, fontweight='bold')\nplt.yscale('log')\nplt.ylim(5e-4, 1e4)\nplt.xticks(range(2012, 2027, 2), fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('指标数值（对数刻度）', fontsize=14)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=11, loc='upper left', frameon=True)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

