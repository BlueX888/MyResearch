data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:42:20.267964", "content": {"results": [{"id": "fact_edffff46", "title": "国防部例行记者会就巴基斯坦空军歼-10CE战机接装仪式答问，发言人吴谦确认中国驻巴使馆已发布消息，并表示中巴两军在高层互访、联演联训、抗疫合作、装备技术等领域合...", "source": "中华人民共和国国防部/中国军网", "url": "", "snippet": "国防部例行记者会就巴基斯坦空军歼-10CE战机接装仪式答问，发言人吴谦确认中国驻巴使馆已发布消息，并表示中巴两军在高层互访、联演联训、抗疫合作、装备技术等领域合作成果丰硕。", "date": "", "isSupplementary": false}, {"id": "fact_db3d5f9b", "title": "巴总理称中国制造的飞机将在纠正地区“安全失衡”中发挥重要作用；3月23日，歼-10CE亮相巴基斯坦国庆日阅兵。", "source": "中华人民共和国国防部/中国军网", "url": "", "snippet": "巴总理称中国制造的飞机将在纠正地区“安全失衡”中发挥重要作用；3月23日，歼-10CE亮相巴基斯坦国庆日阅兵。", "date": "", "isSupplementary": false}, {"id": "fact_c097c422", "title": "歼-35A是我国自主研制的中型隐身多用途战斗机，具有低可探测性和良好的飞行性能，综合作战效能优异。", "source": "中华人民共和国国防部/中国军网（转新华社）", "url": "", "snippet": "歼-35A是我国自主研制的中型隐身多用途战斗机，具有低可探测性和良好的飞行性能，综合作战效能优异。", "date": "", "isSupplementary": false}, {"id": "fact_ec140afd", "title": "空军正积极推进歼-35A等新型战机科研试飞，加快新机换装速度；试飞部队按计划完成发动机空中启动、大迎角试飞等一系列高难度高风险课目。", "source": "中华人民共和国国防部/中国军网（转新华社）", "url": "", "snippet": "空军正积极推进歼-35A等新型战机科研试飞，加快新机换装速度；试飞部队按计划完成发动机空中启动、大迎角试飞等一系列高难度高风险课目。", "date": "", "isSupplementary": false}, {"id": "fact_ca3338c9", "title": "中巴空军“雄鹰-VII”联合训练于11月30日至12月23日在巴基斯坦空军伯拉利基地举行，中国空军歼-10C、歼-11B和空警-500预警机参训。", "source": "中华人民共和国国防部/中国军网", "url": "", "snippet": "中巴空军“雄鹰-VII”联合训练于11月30日至12月23日在巴基斯坦空军伯拉利基地举行，中国空军歼-10C、歼-11B和空警-500预警机参训。", "date": "", "isSupplementary": false}, {"id": "fact_227f0e79", "title": "在本次 site:mod.gov.cn 搜索结果中，未出现歼-35AE或歼-35向巴基斯坦出口的合同金额、签署时间或交付时间表信息。", "source": "本次搜索结果汇总（国防部/中国军网）", "url": "", "snippet": "在本次 site:mod.gov.cn 搜索结果中，未出现歼-35AE或歼-35向巴基斯坦出口的合同金额、签署时间或交付时间表信息。", "date": "", "isSupplementary": false}, {"id": "fact_a1d338fb", "title": "格隆汇2026年4月13日快讯称，据Times of Islamabad，巴基斯坦和中国很可能达成一项120亿美元防务协议，内容包括40架J-35A第五代隐形战...", "source": "格隆汇", "url": "", "snippet": "格隆汇2026年4月13日快讯称，据Times of Islamabad，巴基斯坦和中国很可能达成一项120亿美元防务协议，内容包括40架J-35A第五代隐形战斗机、6架KJ-500空中预警机和多套HQ-19战略导弹防御系统。", "date": "", "isSupplementary": false}, {"id": "fact_9973ef8f", "title": "中华网转引观察者网报道称，巴基斯坦《伊斯兰堡时报》2026年4月13日爆料，巴基斯坦拟与中国签署价值120亿美元的国防采购协议，涉及40架歼-35A、6架空警-...", "source": "中华网", "url": "", "snippet": "中华网转引观察者网报道称，巴基斯坦《伊斯兰堡时报》2026年4月13日爆料，巴基斯坦拟与中国签署价值120亿美元的国防采购协议，涉及40架歼-35A、6架空警-500以及拟用于4个团建制的多套红旗-19；该消息尚未得到官方证实。", "date": "", "isSupplementary": false}, {"id": "fact_15b542eb", "title": "报道称该协议还涵盖精确制导武器、飞行员培训、备件储备、模拟训练设施、基地基础设施升级和长期技术转让等全流程配套内容。", "source": "中华网", "url": "", "snippet": "报道称该协议还涵盖精确制导武器、飞行员培训、备件储备、模拟训练设施、基地基础设施升级和长期技术转让等全流程配套内容。", "date": "", "isSupplementary": false}, {"id": "fact_1baa158a", "title": "报道称相关协议谈判自2025年年中初步报价后加速推进，预计将于2026年初最终敲定。", "source": "中华网", "url": "", "snippet": "报道称相关协议谈判自2025年年中初步报价后加速推进，预计将于2026年初最终敲定。", "date": "", "isSupplementary": false}, {"id": "fact_0def29f9", "title": "报道称首批J-35A或将于2026年中期交付，较原定时间表提前数月，届时巴基斯坦将成为首个引进中国隐形战斗机的国家。", "source": "中华网", "url": "", "snippet": "报道称首批J-35A或将于2026年中期交付，较原定时间表提前数月，届时巴基斯坦将成为首个引进中国隐形战斗机的国家。", "date": "", "isSupplementary": false}, {"id": "fact_f7873061", "title": "晨枫文章提到，2025年6月28日巴基斯坦国防部长哈瓦贾·阿西夫表示，关于巴基斯坦国防部已经签约订购中国歼-35战斗机合同的多篇报道并不属实，这些报道“只是媒体...", "source": "中华网新闻频道（晨枫文章）", "url": "", "snippet": "晨枫文章提到，2025年6月28日巴基斯坦国防部长哈瓦贾·阿西夫表示，关于巴基斯坦国防部已经签约订购中国歼-35战斗机合同的多篇报道并不属实，这些报道“只是媒体上的说法”。", "date": "", "isSupplementary": false}, {"id": "fact_8d5699c9", "title": "晨枫文章提到，2023年12月巴基斯坦空军参谋长扎希尔·西杜曾宣布“订购歼-31隐身战斗机的基础已经奠定”；2024年12月巴基斯坦媒体曾报道政府已经批准歼-3...", "source": "中华网新闻频道（晨枫文章）", "url": "", "snippet": "晨枫文章提到，2023年12月巴基斯坦空军参谋长扎希尔·西杜曾宣布“订购歼-31隐身战斗机的基础已经奠定”；2024年12月巴基斯坦媒体曾报道政府已经批准歼-35的订购。", "date": "", "isSupplementary": false}, {"id": "fact_f7a1701f", "title": "晨枫文章指出，中国对中巴军售一向低调，尽管巴基斯坦多次宣称订购歼-10，但直到歼-10C交付，中国都没有正式确认过。", "source": "中华网新闻频道（晨枫文章）", "url": "", "snippet": "晨枫文章指出，中国对中巴军售一向低调，尽管巴基斯坦多次宣称订购歼-10，但直到歼-10C交付，中国都没有正式确认过。", "date": "", "isSupplementary": false}, {"id": "fact_c2f84afa", "title": "从报道内容看，120亿美元为拟议一揽子防务协议总额，涵盖J-35A、KJ-500、HQ-19及配套内容；报道未披露歼-35A单项合同金额。", "source": "格隆汇/中华网综合", "url": "", "snippet": "从报道内容看，120亿美元为拟议一揽子防务协议总额，涵盖J-35A、KJ-500、HQ-19及配套内容；报道未披露歼-35A单项合同金额。", "date": "", "isSupplementary": false}, {"id": "fact_435f245a", "title": "航空工业集团官网“客户”页面将“鹘鹰战斗机”列为航空产品，描述为针对国际市场需求研发的第四代中型多用途战斗机，具有自主知识产权，采用单座、双发、外倾双垂尾、全动...", "source": "中国航空工业集团有限公司官网—客户/航空产品", "url": "", "snippet": "航空工业集团官网“客户”页面将“鹘鹰战斗机”列为航空产品，描述为针对国际市场需求研发的第四代中型多用途战斗机，具有自主知识产权，采用单座、双发、外倾双垂尾、全动平尾布局。", "date": "", "isSupplementary": false}, {"id": "fact_518c961a", "title": "上述航空工业官网“鹘鹰战斗机”产品简介未出现“歼-35AE”“巴基斯坦采购”“合同金额”或“交付时间表”等表述，无法据此确认歼-35向巴基斯坦出口的合同金额和交...", "source": "中国航空工业集团有限公司官网—客户/航空产品", "url": "", "snippet": "上述航空工业官网“鹘鹰战斗机”产品简介未出现“歼-35AE”“巴基斯坦采购”“合同金额”或“交付时间表”等表述，无法据此确认歼-35向巴基斯坦出口的合同金额和交付安排。", "date": "", "isSupplementary": false}, {"id": "fact_9721cb58", "title": "航空工业官网“合作伙伴”页面介绍枭龙/FC-1飞机由中国航空工业集团公司组织成都所、成飞公司和中航技总公司等主要参研单位，并提及中巴共同投资研制枭龙飞机。该信息...", "source": "中国航空工业集团有限公司官网—合作伙伴/外贸产品", "url": "", "snippet": "航空工业官网“合作伙伴”页面介绍枭龙/FC-1飞机由中国航空工业集团公司组织成都所、成飞公司和中航技总公司等主要参研单位，并提及中巴共同投资研制枭龙飞机。该信息说明中巴存在军机合作研制模式，但不涉及歼-35出口合同。", "date": "", "isSupplementary": false}, {"id": "fact_efde37e4", "title": "航空工业官网新闻《“军队-2021”“航空飞镖”项目闭幕 中国空军获得两项第一》仅报道中国空军参赛机型及比赛结果，未涉及歼-35、巴基斯坦采购或军贸合同。", "source": "中国航空工业集团有限公司官网—所属企业动态", "url": "", "snippet": "航空工业官网新闻《“军队-2021”“航空飞镖”项目闭幕 中国空军获得两项第一》仅报道中国空军参赛机型及比赛结果，未涉及歼-35、巴基斯坦采购或军贸合同。", "date": "", "isSupplementary": false}, {"id": "fact_1cc4b461", "title": "航空工业成都飞机工业（集团）官网产品页介绍歼-10、歼-7等军用航空产品，但未出现歼-35AE、巴基斯坦采购合同金额或交付时间表信息。", "source": "航空工业成都飞机工业（集团）有限责任公司官网—军用航空产品", "url": "", "snippet": "航空工业成都飞机工业（集团）官网产品页介绍歼-10、歼-7等军用航空产品，但未出现歼-35AE、巴基斯坦采购合同金额或交付时间表信息。", "date": "", "isSupplementary": false}]}}

