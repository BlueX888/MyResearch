data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:44:29.738904", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Item': ['歼-35A\\n(40架)', '空警-500\\n(6架)', '红旗-19\\n(4个团)', '弹药/培训\\n/备件'], 'Amount': [32, 18, 45, 25]}\ndf = pd.DataFrame(data)\ndf['Amount'] = pd.to_numeric(df['Amount'], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax = axes[0]\nbars = ax.bar(df['Item'], df['Amount'], color=['#6366f1', '#06b6d4', '#10b981', '#f59e0b'], edgecolor='white')\nfor b, v in zip(bars, df['Amount']):\n    ax.text(b.get_x() + b.get_width() / 2, v + 1.2, f'{v:.0f}亿美元', ha='center', fontsize=12, fontweight='bold')\nax.set_title('传闻120亿美元一揽子协议分项构成', fontsize=15, fontweight='bold', pad=15)\nax.set_ylabel('金额（亿美元）', fontsize=13)\nax.set_ylim(0, 52)\nax.tick_params(labelsize=11)\nax.grid(True, linestyle='--', alpha=0.3)\nax2 = axes[1]\nyears = [2023, 2024, 2025, 2026]\npos = [1, 2, 3, 4]\nevents = ['传闻起始', '珠海航展\\n歼-35A亮相', '巴防长否认\\n已签署合同', '传闻首批\\n交付窗口']\nax2.plot(years, pos, linewidth=2.5, marker='o', markersize=10, color='#6366f1')\nax2.fill_between(years, pos, 0.6, alpha=0.12, color='#6366f1')\nfor x, y, t in zip(years, pos, events):\n    ax2.annotate(t, (x, y), textcoords='offset points', xytext=(0, 14), ha='center', fontsize=11)\nax2.set_xticks(years)\nax2.set_yticks([])\nax2.set_ylim(0.6, 5.2)\nax2.set_title('歼-35出口巴基斯坦关键节点（均未获官方确认）', fontsize=15, fontweight='bold', pad=15)\nax2.set_xlabel('年份', fontsize=13)\nax2.tick_params(labelsize=11)\nax2.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "围绕'歼-35出口巴基斯坦的合同金额与交付时间表'这一研究问题，从海量数据中筛选出最具证据价值的关键点：①传闻中的120亿美元一揽子防务协议分项构成（歼-35A 32亿、空警-500 18亿、红旗-19 45亿、配套约25亿）；②关键时间节点（2023年底传闻起始、2024珠海航展歼-35A公开亮相、2025年6月巴防长否认已签约、2026年传闻首批交付/中期交付）。左图用柱状图拆解传闻协议金额构成，右图用时间线呈现'传闻热度'与'官方确认'之间的落差，从而说明：合同金额与交付时间表目前均无可验证的官方披露，所有数字均属媒体推测口径。"}}

