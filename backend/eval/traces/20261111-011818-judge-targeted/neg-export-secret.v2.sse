data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:38:46.711184", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["中华人民共和国和巴基斯坦伊斯兰共和国联合声明 2026年5月26日 全文 新华社", "巴基斯坦总理办公室 2025年6月6日 谢里夫 外交成就 声明 原文"], "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:38:46.937282", "content": {"results": [{"id": "sr_7e3224", "title": "中华人民共和国和巴基斯坦伊斯兰共和国联合声明", "source": "中国经济周刊", "url": "https://paper.people.com.cn/rmrbhwb/pc/content/202605/27/content_30159348.html", "snippet": "中华人民共和国和巴基斯坦伊斯兰共和国联合声明\n《人民日报海外版》(2026年05月27日\n第\n02\n版)", "date": "2026-05-27T00:00:00+08:00"}, {"id": "sr_62aefb", "title": "中华人民共和国和巴基斯坦伊斯兰共和国联合声明-中新经纬", "source": "中新经纬", "url": "https://www.jwview.com/jingwei/html/05-26/672218.shtml", "snippet": "中华人民共和国和巴基斯坦伊斯兰共和国联合声明\n2026-05-26\n14:34:42\n新华社\n中华人民共和国和巴基斯坦伊斯兰共和国联合声明\n新华社北京5月26日电\n中华人民共和国和巴基斯坦伊斯兰共和国联合声明\n(2026年5月26日)\n一、应中华人民共和国国务院总理李强邀请,巴基斯坦伊斯兰共和国总理夏巴兹・谢里夫于2026年5月23日至26日对中国进行正式访问。\n访问期间,中华人民共和国主席习近平会见夏巴兹总理,国务院总理李强同夏巴兹总理举行会谈。双方在亲切友好的气氛中,就深化中巴全天候战略合作伙伴关系及共同关心的国际和地区问题达成新的广泛共识。夏巴兹总理出席了中巴建交75周年纪念活动,并成功访问浙江省杭州市。\n二、双方一致认为,中巴传统友谊由两国老一辈领导人亲手缔造,是两国和两国人民的宝贵财富和战略资产。建交75年来,无论国际和地区形势如何变化,中巴友谊始终坚如磐石,中巴两国始终坚定相互信任、相互尊重、相互支持,患难与共、风雨同舟。百年变局加速演进,中巴全天候战略合作伙伴关系更具战略价值和时代价值。中巴两国将加快构建新时代更加紧密的中巴命运共同体,为构建周边命运共同体作出示范。\n三、双方决心坚定不移维护和发展中巴关系,保持高层交往,落实好《中华人民共和国政府和巴基斯坦伊斯兰共和国政府关于构建新时代更加紧密的中巴命运共同体行动计划(2025-2029年)》,深化互信、务实合作、防务和安全合作,就国际和地区问题保持密切协调,使中巴关系更好造福两国人民,为促进地区和世界和平、稳定与繁荣贡献力量。\n巴方高度重视并支持习近平主席提出的构建人类命运共同体理念以及全球发展倡议、全球安全倡议、全球文明倡议和全球治理倡议。\n四、双方高度评价巴基斯坦总统阿西夫・扎尔达里2026年4月底5月初成功访问中国湖南省、海南省,巴基斯坦国民议会议长萨达尔・萨迪克2026年1月成功访华。双方欢迎202", "date": "2026-05-26T14:34:42+08:00"}, {"id": "sr_90cd37", "title": "中华人民共和国和巴基斯坦伊斯兰共和国联合声明_大众新闻_大众新媒体大平台", "source": "大众日报", "url": "https://dzrb.dzng.com/general/0/NEWS3408421VPUVMKOIEVEXA", "snippet": "新华社北京5月26日电中华人民共和国和巴基斯坦伊斯兰共和国联合声明(2026年5月26日)一、应中华人民共和国国务院总理李强邀请,巴基斯坦伊斯兰共和国总理夏巴兹·谢里夫于2026年5月23日至26日对中国进行正式访问。访问期间,中华人民共和国主席习近平会见夏巴兹总理,国务院总理李强同夏巴兹总理举行会谈。双方在亲切友好的气氛中,就深化中巴全天候战略合作伙伴关系及共同关心的国际和地区问题达成新的广泛共识。夏巴兹总理出席了中巴建交75周年纪念活动,并成功访问浙江省杭州市。二、双方一致认为,中巴传统友谊由两国老一辈领导人亲手缔造,是两国和两国人民的宝贵财富和战略资产。建交75年来,无论国际和地区形势如何变化,中巴友谊始终坚如磐石,中巴两国始终坚定相互信任、相互尊重、相互支持,患难与共、风雨同舟。百年变局加速演进,中巴全天候战略合作伙伴关系更具战略价值和时代价值。中巴两国将加快构建新时代更加紧密的中巴命运共同体,为构建周边命运共同体作出示范。三、双方决心坚定不移维护和发展中巴关系,保持高层交往,落实好《中华人民共和国政府和巴基斯坦伊斯兰共和国政府关于构建新时代更加紧密的中巴命运共同体行动计划(2025-2029年)》,深化互信、务实合作、防务和安全合作,就国际和地区问题保持密切协调,使中巴关系更好造福两国人民,为促进地区和世界和平、稳定与繁荣贡献力量。巴方高度重视并支持习近平主席提出的构建人类命运共同体理念以及全球发展倡议、全球安全倡议、全球文明倡议和全球治理倡议。四、双方高度评价巴基斯坦总统阿西夫·扎尔达里2026年4月底5月初成功访问中国湖南省、海南省,巴基斯坦国民议会议长萨达尔·萨迪克2026年1月成功访华。双方欢迎2026年1月第七次中巴外长战略对话和5月中巴政党论坛暨中巴经济走廊政党共商机制会议成功举行。巴方感谢中国全国人大常委会副委员长蔡达峰于2026年5月率团访巴并出席", "date": "2026-05-26T13:08:49+08:00"}, {"id": "sr_f783ea", "title": "中华人民共和国和巴基斯坦伊斯兰共和国联合声明|中华人民共和国|巴基斯坦|巴方_手机网易网", "source": "网易", "url": "https://m.163.com/dy/article/KTRVLJBF0512D3VJ.html", "snippet": "据新华社北京5月26日电中华人民共和国和巴基斯坦伊斯兰共和国联合声明(2026年5月26日)一、应中华人民共和国国务院总理李强邀请,巴基斯坦伊斯兰共和国总理夏巴兹·谢里夫于2026年5月23日至26日对中国进行正式访问。访问期间,中华人民共和国主席习近平会见夏巴兹总理,国务院总理李强同夏巴兹总理举行会谈。双方在亲切友好的气氛中,就深化中巴全天候战略合作伙伴关系及共同关心的国际和地区问题达成新的广泛共识。夏巴兹总理出席了中巴建交75周年纪念活动,并成功访问浙江省杭州市。二、双方一致认为,中巴传统友谊由两国老一辈领导人亲手缔造,是两国和两国人民的宝贵财富和战略资产。建交75年来,无论国际和地区形势如何变化,中巴友谊始终坚如磐石,中巴两国始终坚定相互信任、相互尊重、相互支持,患难与共、风雨同舟。百年变局加速演进,中巴全天候战略合作伙伴关系更具战略价值和时代价值。中巴两国将加快构建新时代更加紧密的中巴命运共同体,为构建周边命运共同体作出示范。三、双方决心坚定不移维护和发展中巴关系,保持高层交往,落实好《中华人民共和国政府和巴基斯坦伊斯兰共和国政府关于构建新时代更加紧密的中巴命运共同体行动计划(2025-2029年)》,深化互信、务实合作、防务和安全合作,就国际和地区问题保持密切协调,使中巴关系更好造福两国人民,为促进地区和世界和平、稳定与繁荣贡献力量。巴方高度重视并支持习近平主席提出的构建人类命运共同体理念以及全球发展倡议、全球安全倡议、全球文明倡议和全球治理倡议。四、双方高度评价巴基斯坦总统阿西夫·扎尔达里2026年4月底5月初成功访问中国湖南省、海南省,巴基斯坦国民议会议长萨达尔·萨迪克2026年1月成功访华。双方欢迎2026年1月第七次中巴外长战略对话和5月中巴政党论坛暨中巴经济走廊政党共商机制会议成功举行。巴方感谢中国全国人大常委会副委员长蔡达峰于2026年5月率团访巴并", "date": "2026-05-26T13:14:23+08:00"}, {"id": "sr_876613", "title": "中华人民共和国和巴基斯坦伊斯兰共和国联合声明 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7644064461787021858/", "snippet": "来源:新华社\n新华社北京5月26日电\n中华人民共和国和巴基斯坦伊斯兰共和国联合声明(2026年5月26日)一、应中华人民共和国国务院总理李强邀请,巴基斯坦伊斯兰共和国总理夏巴兹·谢里夫于2026年5月23日至26日对中国进行正式访问。访问期间,中华人民共和国主席习近平会见夏巴兹总理,国务院总理李强同夏巴兹总理举行会谈。双方在亲切友好的气氛中,就深化中巴全天候战略合作伙伴关系及共同关心的国际和地区问题达成新的广泛共识。夏巴兹总理出席了中巴建交75周年纪念活动,并成功访问浙江省杭州市。二、双方一致认为,中巴传统友谊由两国老一辈领导人亲手缔造,是两国和两国人民的宝贵财富和战略资产。建交75年来,无论国际和地区形势如何变化,中巴友谊始终坚如磐石,中巴两国始终坚定相互信任、相互尊重、相互支持,患难与共、风雨同舟。百年变局加速演进,中巴全天候战略合作伙伴关系更具战略价值和时代价值。中巴两国将加快构建新时代更加紧密的中巴命运共同体,为构建周边命运共同体作出示范。三、双方决心坚定不移维护和发展中巴关系,保持高层交往,落实好《中华人民共和国政府和巴基斯坦伊斯兰共和国政府关于构建新时代更加紧密的中巴命运共同体行动计划(2025-2029年)》,深化互信、务实合作、防务和安全合作,就国际和地区问题保持密切协调,使中巴关系更好造福两国人民,为促进地区和世界和平、稳定与繁荣贡献力量。巴方高度重视并支持习近平主席提出的构建人类命运共同体理念以及全球发展倡议、全球安全倡议、全球文明倡议和全球治理倡议。四、双方高度评价巴基斯坦总统阿西夫·扎尔达里2026年4月底5月初成功访问中国湖南省、海南省,巴基斯坦国民议会议长萨达尔·萨迪克2026年1月成功访华。双方欢迎2026年1月第七次中巴外长战略对话和5月中巴政党论坛暨中巴经济走廊政党共商机制会议成功举行。巴方感谢中国全国人大常委会副委员长蔡达峰于2026年5", "date": "2026-05-26T13:14:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

