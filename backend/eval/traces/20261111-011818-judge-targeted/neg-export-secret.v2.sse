data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:44:53.121157", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'name': ['出口型原型机编号', '传闻交付数量', '歼-35A RCS', 'WS-19单台推力', '霹雳-15挂载量', '巴基斯坦最早接收年份', '歼-35批量生产年份', 'FC-31首飞年份', '一揽子防务协议总额', '歼-35A采购数量'], 'value': ['0001', '40', '0.001', '18', '4', '2026', '2025', '2012', '120', '40'], 'unit': ['架', '架', '平方米', '吨', '枚', '年', '年', '年', '亿美元', '架'], 'year': [2026, 2025, 2024, 2025, 2025, 2025, 2025, 2012, 2026, 2026]}\ndf = pd.DataFrame(data)\ndf['value_num'] = pd.to_numeric(df['value'], errors='coerce')\ndf = df.dropna(subset=['value_num']).sort_values(['year', 'value_num']).reset_index(drop=True)\nx = np.arange(len(df))\ny = df['value_num'].values\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2, markeredgecolor='#6366f1', label='指标数值')\nplt.fill_between(x, y, y.min() * 0.5, alpha=0.15, color='#6366f1')\nfor i in range(len(df)):\n    plt.text(x[i], y[i] * 1.35, f'{y[i]:g} ' + df['unit'][i], ha='center', fontsize=9, fontweight='bold', color='#334155')\nplt.yscale('log')\nplt.xticks(x, [str(v) for v in df['year']], fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('指标数值（对数刻度，多单位混合）', fontsize=14)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

