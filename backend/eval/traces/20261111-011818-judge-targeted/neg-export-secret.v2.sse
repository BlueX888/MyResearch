data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:37:40.350978", "content": {"results": [{"id": "sr_e2ceb6", "title": "实锤!巴基斯坦采购30架直-10ME的合同细节被逐步披露_凤凰网视频_凤凰网", "source": "凤凰网", "url": "https://v.ifeng.com/c/8xkgZ7MHHb9", "snippet": "实锤!巴基斯坦采购30架直-10ME的合同细节被逐步披露2026-11-04\n06:13:44Updated\n2026年11月04日\n09:16:4903:060来自江西省", "date": "2026-11-04T06:13:44+08:00"}, {"id": "sr_22c34e", "title": "中国民航报电子报", "source": "中国民航报", "url": "http://epaper.caacmedia.cn:81/outline?page=1&ChannelID=22000&randno=26686&templet=&resultid=8716", "snippet": "[中国民航报]2026.10.30第001版\n头版\n[中国民航报]2026.10.30第002版\n民航新闻\n[中国民航报]2026.10.30第003版\n国际民航\n[中国民航报]2026.10.30第004版\n市场聚焦\n[]第版\n[]第版\n[]第版\n[]第版", "date": "2026-10-30T00:00:00+08:00"}, {"id": "sr_79d387", "title": "中国民航报电子报", "source": "中国民航报", "url": "http://epaper.caacmedia.cn:81/outline?page=1&ChannelID=22000&randno=690&templet=&resultid=4366", "snippet": "[中国民航报]2026.10.30第001版\n头版\n[中国民航报]2026.10.30第002版\n民航新闻\n[中国民航报]2026.10.30第003版\n国际民航\n[中国民航报]2026.10.30第004版\n市场聚焦\n[中国民航报]2026.10.29第001版\n头版\n[中国民航报]2026.10.29第002版\n民航新闻\n[中国民航报]2026.10.29第003版\n民航论坛\n[中国民航报]2026.10.29第004版\n空管·保障", "date": "2026-10-30T00:00:00+08:00"}, {"id": "sr_668bc7", "title": "伊朗军方:已购买俄制苏-35战机 将在战后接收 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/video/7703227277647364131/", "snippet": "展开伊朗军方:已购买俄制苏-35战机\n将在战后接收播放\n3.3万发布于\n2026-11-01\n23:36", "date": "2026-11-01T23:36:00+08:00"}, {"id": "sr_f5dbf3", "title": "抬头看!歼-35A、歼-20、歼-10C都来了 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/video/7703174357530526251/", "snippet": "展开抬头看!歼-35A、歼-20、歼-10C都来了播放\n1524发布于\n2026-11-01\n20:11", "date": "2026-11-01T20:11:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 1}}

