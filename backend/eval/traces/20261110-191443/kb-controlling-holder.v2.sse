data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:29:42.960432", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    '股东': ['中国航空工业集团', '汉中汉航机电', '汉中航空工业(集团)', '易方达创业板ETF', '华泰柏瑞沪深300ETF', '华夏沪深300ETF', '其他股东'],\n    '持股比例': [78.66, 5.75, 5.29, 0.20, 0.19, 0.10, 9.81]\n}\ndf = pd.DataFrame(data)\ndf['持股比例'] = pd.to_numeric(df['持股比例'], errors='coerce')\ndf = df.dropna().sort_values('持股比例')\ncolors = ['#cbd5e1', '#cbd5e1', '#cbd5e1', '#10b981', '#06b6d4', '#cbd5e1', '#6366f1']\nplt.figure(figsize=(12, 7), dpi=200)\nbars = plt.barh(df['股东'], df['持股比例'], color=colors, edgecolor='white')\nfor bar, v in zip(bars, df['持股比例']):\n    plt.text(v + 1.2, bar.get_y() + bar.get_height() / 2, f'{v:.2f}%', va='center', fontsize=12, fontweight='bold', color='#1e293b')\nplt.title('中航成飞(302132) 2025年股东持股结构', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('持股比例 (%)', fontsize=14)\nplt.ylabel('股东', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.xlim(0, 92)\nplt.grid(True, linestyle='--', alpha=0.3, axis='x')\nplt.text(0.98, 0.06, '前三大股东合计持股 89.70%', transform=plt.gca().transAxes, ha='right', fontsize=13, fontweight='bold', color='#6366f1', bbox=dict(boxstyle='round', facecolor='#eef2ff', edgecolor='#6366f1'))\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从原始数据中提取中航成飞（302132）2025年股东持股结构的关键数据点：中国航空工业集团78.66%（2,101,738,612股）、汉中汉航机电5.75%、汉中航空工业（集团）5.29%，以及易方达创业板ETF、华泰柏瑞沪深300ETF、华夏沪深300ETF等小额持股，剩余归为其他股东。清洗后按持股比例排序，绘制水平柱状图，突出第一大股东绝对控股地位，并标注前三大股东合计89.70%的航空工业集团体系控股情况。"}}

