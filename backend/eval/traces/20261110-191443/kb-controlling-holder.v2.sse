data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:29:53.894010", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['第一季度', '第二季度', '第三季度', '第四季度'], 'Revenue': [33.09, 173.93, 275.84, 270.73]}\ndf = pd.DataFrame(data)\nx = np.arange(len(df))\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(x, df['Revenue'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, markeredgecolor='#6366f1', label='季度营业收入')\nplt.fill_between(x, df['Revenue'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['Revenue']):\n    plt.text(i, v + 9, f'{v:.2f}亿元', ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(x, df['Quarter'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 320)\nplt.legend(fontsize=12, loc='upper left')\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

