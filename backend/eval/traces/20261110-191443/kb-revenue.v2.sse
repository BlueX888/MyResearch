data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:19:13.003242", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['第一季度', '第二季度', '第三季度', '第四季度'], 'Revenue': [33.09, 173.93, 275.84, 270.73], 'Profit': [1.56, 7.56, 12.56, 12.63]}\ndf = pd.DataFrame(data)\nfig, ax1 = plt.subplots(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\nax1.plot(x, df['Revenue'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='营业收入（亿元）')\nax1.fill_between(x, df['Revenue'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['Revenue']):\n    ax1.text(i, v + 9, f'{v:.2f}', ha='center', fontsize=11, color='#4338ca', fontweight='bold')\nax1.set_ylabel('营业收入（亿元）', fontsize=14)\nax1.set_ylim(0, 330)\nax2 = ax1.twinx()\nax2.plot(x, df['Profit'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='归母净利润（亿元）')\nax2.fill_between(x, df['Profit'], alpha=0.15, color='#f59e0b')\nfor i, v in enumerate(df['Profit']):\n    ax2.text(i, v + 0.65, f'{v:.2f}', ha='center', fontsize=11, color='#b45309', fontweight='bold')\nax2.set_ylabel('归母净利润（亿元）', fontsize=14)\nax2.set_ylim(0, 16)\nax1.set_xticks(x)\nax1.set_xticklabels(df['Quarter'], fontsize=12)\nax1.tick_params(axis='y', labelsize=12)\nax2.tick_params(axis='y', labelsize=12)\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nax1.set_xlabel('季度', fontsize=14)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12, frameon=False)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine(ax=ax1)\nsns.despine(ax=ax2, right=False)\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

