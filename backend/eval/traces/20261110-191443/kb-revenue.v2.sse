data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:23:58.774911", "content": {"results": [{"id": "fact_b524e125", "title": "公司需追溯调整或重述以前年度会计数据，原因为同一控制下企业合并，这可能影响2025年营业收入同比数据的可比性。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "公司需追溯调整或重述以前年度会计数据，原因为同一控制下企业合并，这可能影响2025年营业收入同比数据的可比性。", "date": "", "isSupplementary": false}, {"id": "fact_d405bd38", "title": "控股股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612.00股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "控股股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612.00股。", "date": "", "isSupplementary": false}, {"id": "fact_a2363be9", "title": "中航成飞股票在深圳证券交易所上市。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞股票在深圳证券交易所上市。", "date": "", "isSupplementary": false}, {"id": "fact_80269998", "title": "中航成飞2025年年度报告摘要显示，公司2025年营业收入为75,358,958,001.86元（约753.59亿元）。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，公司2025年营业收入为75,358,958,001.86元（约753.59亿元）。", "date": "", "isSupplementary": true}, {"id": "fact_90bdaf62", "title": "因同一控制下企业合并，2024年营业收入被追溯调整：调整前为1,779,761,710.30元，调整后为65,054,925,10X.XX元（原文数字被截断）。...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "因同一控制下企业合并，2024年营业收入被追溯调整：调整前为1,779,761,710.30元，调整后为65,054,925,10X.XX元（原文数字被截断）。以调整后口径计算，2025年营业收入较2024年增长约15.8%（因2024年调整后数值截断，为近似值）。", "date": "", "isSupplementary": true}, {"id": "fact_56f3495e", "title": "分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度27,072,785,205.73元，四季度合计与全年75,358,958,001.86元一致。", "date": "", "isSupplementary": true}, {"id": "fact_b1c923b1", "title": "公司2025年加权平均净资产收益率为26.76%（2024年调整后为30.34%，同比减少3.58个百分点）；归属于上市公司股东的净资产为21,208,525,...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "公司2025年加权平均净资产收益率为26.76%（2024年调整后为30.34%，同比减少3.58个百分点）；归属于上市公司股东的净资产为21,208,525,338.75元。", "date": "", "isSupplementary": true}, {"id": "fact_b7f0ec7d", "title": "公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；控股股东中国航空工业集团有限公司持股78.66%。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；控股股东中国航空工业集团有限公司持股78.66%。", "date": "", "isSupplementary": true}, {"id": "fact_d29a3b97", "title": "中航成飞（证券代码：302132）2025年年度报告摘要显示，报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞（证券代码：302132）2025年年度报告摘要显示，报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障。", "date": "", "isSupplementary": true}, {"id": "fact_8e2bd12b", "title": "中航成飞主要产品包括航空防务装备、民用航空产品和智能测控产品，其中航空防务装备与军机产业链直接相关。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞主要产品包括航空防务装备、民用航空产品和智能测控产品，其中航空防务装备与军机产业链直接相关。", "date": "", "isSupplementary": true}, {"id": "fact_b796a54b", "title": "中航成飞控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股，体现其作为航空工业集团旗下军机整机研制上市平台的地位。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股，体现其作为航空工业集团旗下军机整机研制上市平台的地位。", "date": "", "isSupplementary": true}, {"id": "fact_94f35b9a", "title": "中航成飞（证券代码302132）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该表述界定了公...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞（证券代码302132）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该表述界定了公司航空制造业务范围，但未披露原材料（钛合金、复合材料）成本构成或价格变动情况。", "date": "", "isSupplementary": true}, {"id": "fact_c27b8cf5", "title": "年报摘要中设有“近三年主要会计数据和财务指标”章节（含2025年末、2024年末、2023年末对比及“本年末比上年末增减”列），但搜索结果中该表格内容被截断，仅...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "年报摘要中设有“近三年主要会计数据和财务指标”章节（含2025年末、2024年末、2023年末对比及“本年末比上年末增减”列），但搜索结果中该表格内容被截断，仅显示表头与单位“元”，未呈现营业收入及同比增长率的具体数值。", "date": "", "isSupplementary": true}, {"id": "fact_aad9fa7a", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具标准无保留意见审计报告；公司2025年度利润分配预案为每10股派发现金红利3.86元（含税），...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具标准无保留意见审计报告；公司2025年度利润分配预案为每10股派发现金红利3.86元（含税），不送红股、不转增。上述信息与原材料成本、军品审价无直接关联。", "date": "", "isSupplementary": true}, {"id": "fact_74b2aef1", "title": "本次搜索结果仅包含中航成飞（证券代码302132）2025年年度报告摘要，未检索到中航沈飞或航发动力2025年加权平均净资产收益率的任何数据。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "本次搜索结果仅包含中航成飞（证券代码302132）2025年年度报告摘要，未检索到中航沈飞或航发动力2025年加权平均净资产收益率的任何数据。", "date": "", "isSupplementary": true}, {"id": "fact_143fcb32", "title": "中航成飞2025年年度报告摘要披露的加权平均净资产收益率为26.76%（同表还列示2024年调整后4.60%、调整前30.34%、本年末比上年末增减-3.58%...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要披露的加权平均净资产收益率为26.76%（同表还列示2024年调整后4.60%、调整前30.34%、本年末比上年末增减-3.58%、2023年调整后4.20%、调整前30.33%）。该数据主体为中航成飞，并非中航沈飞或航发动力。", "date": "", "isSupplementary": true}, {"id": "fact_ebe76360", "title": "中航成飞2025年年度报告摘要显示，公司2025年实现营业收入75,358,958,001.86元（约753.59亿元）。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，公司2025年实现营业收入75,358,958,001.86元（约753.59亿元）。", "date": "", "isSupplementary": true}, {"id": "fact_49c8c271", "title": "同一控制下企业合并追溯调整后，2024年营业收入为65,054,925,10X.XX元（原文数字被截断，仅显示至“65,054,925,10”）；调整前2024...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "同一控制下企业合并追溯调整后，2024年营业收入为65,054,925,10X.XX元（原文数字被截断，仅显示至“65,054,925,10”）；调整前2024年营业收入为1,779,761,710.30元。据此可推算2025年营业收入较调整后2024年同比增长约15.8%（因调整后数值截断，该增速为估算值，需以年报全文为准）。", "date": "", "isSupplementary": true}, {"id": "fact_9b9a8486", "title": "分季度看，中航成飞2025年营业收入分别为：第一季度3,308,640,285.35元、第二季度17,393,488,964.30元、第三季度27,584,04...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "分季度看，中航成飞2025年营业收入分别为：第一季度3,308,640,285.35元、第二季度17,393,488,964.30元、第三季度27,584,043,546.48元、第四季度27,072,785,205.73元，四季度合计与全年营业收入75,358,958,001.86元一致。", "date": "", "isSupplementary": true}, {"id": "fact_715e0118", "title": "中航成飞2025年加权平均净资产收益率为26.76%，较2024年调整后30.34%下降3.58个百分点；归属于上市公司股东的净资产为21,208,525,33...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年加权平均净资产收益率为26.76%，较2024年调整后30.34%下降3.58个百分点；归属于上市公司股东的净资产为21,208,525,338.75元，较上年末调整后增长9.15%。", "date": "", "isSupplementary": true}]}}

