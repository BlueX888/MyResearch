data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:18:53.206496", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'], 'Revenue': [33.09, 173.93, 275.84, 270.73]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Quarter':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\ntotal = df['Revenue'].sum()\ndf['Share'] = df['Revenue'] / total * 100\ngrowth = (753.59 / 650.55 - 1) * 100\nplt.figure(figsize=(12, 7), dpi=200)\ncolors = ['#6366f1', '#06b6d4', '#10b981', '#f59e0b']\nbars = plt.bar(df['Quarter'], df['Revenue'], color=colors, width=0.6)\nfor b, v, s in zip(bars, df['Revenue'], df['Share']):\n    plt.text(b.get_x() + b.get_width() / 2, v + 6, f'{v:.2f}亿元\\n({s:.1f}%)', ha='center', fontsize=12, fontweight='bold')\nplt.title('中航成飞2025年季度营业收入结构（全年753.59亿元，同比+' + f'{growth:.1f}%）', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, df['Revenue'].max() * 1.22)\nplt.grid(True, linestyle='--', alpha=0.3, axis='y')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从数据中提取2025年四个季度营业收入（33.09/173.93/275.84/270.73亿元）及全年营收753.59亿元、2024年调整后营收650.55亿元、同比增速15.8%等关键指标。先做类型转换与去重清洗，再计算季度占比、全年同比增速校验（753.59/650.55-1≈15.8%），最后用专业柱状图展示季度营收结构，标题中标注全年规模与同比增速，突出季节性集中特征（下半年占比超七成）。"}}

