data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:19:03.978745", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nquarters = ['第一季度', '第二季度', '第三季度', '第四季度']\nrevenue = [3308640285.35, 17393488964.30, 27584043546.48, 27072785205.73]\nprofit = [156494308.41, 756329709.24, 1256306602.29, 1263159232.02]\nrevenue_yi = [v / 1e8 for v in revenue]\nprofit_yi = [v / 1e8 for v in profit]\nx = np.arange(len(quarters))\nplt.figure(figsize=(12, 7), dpi=200)\nax1 = plt.gca()\ncolor1 = '#6366f1'\ncolor2 = '#f59e0b'\nax1.plot(x, revenue_yi, color=color1, linewidth=2.5, marker='o', markersize=8, label='营业收入（亿元）')\nax1.fill_between(x, revenue_yi, alpha=0.15, color=color1)\nax1.set_xlabel('季度', fontsize=14)\nax1.set_ylabel('营业收入（亿元）', fontsize=14, color=color1)\nax1.tick_params(axis='y', labelcolor=color1, labelsize=12)\nax1.set_xticks(x)\nax1.set_xticklabels(quarters, fontsize=12)\nax1.grid(True, linestyle='--', alpha=0.3)\nfor i, v in enumerate(revenue_yi):\n    ax1.text(i, v + max(revenue_yi) * 0.02, f'{v:.2f}', ha='center', va='bottom', fontsize=11, color=color1, fontweight='bold')\nax2 = ax1.twinx()\nax2.plot(x, profit_yi, color=color2, linewidth=2.5, marker='s', markersize=8, label='归母净利润（亿元）')\nax2.fill_between(x, profit_yi, alpha=0.15, color=color2)\nax2.set_ylabel('归母净利润（亿元）', fontsize=14, color=color2)\nax2.tick_params(axis='y', labelcolor=color2, labelsize=12)\nfor i, v in enumerate(profit_yi):\n    ax2.text(i, v + max(profit_yi) * 0.02, f'{v:.2f}', ha='center', va='bottom', fontsize=11, color=color2, fontweight='bold')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12, frameon=True)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

