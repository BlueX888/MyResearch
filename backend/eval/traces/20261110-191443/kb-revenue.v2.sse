data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:14:49.913683", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述中国航空装备及军机市场规模、增速和2025年需求景气度，为判断中航成飞收入增长提供行业背景。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中国航空装备市场规模 2025 军机 增速 国防预算"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述航空主机厂竞争格局，重点分析中航成飞在歼击机整机领域的地位、主要竞争者和交付份额。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 竞争格局 歼击机 主机厂 市场份额"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述隐身战机、航空制造和数字化装配等核心技术趋势，分析技术升级对产品价值和收入结构的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 隐身战机 航空制造 技术趋势 产能"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、装备采购、军品定价和国企改革等相关政策，分析其对中航成飞收入确认和增速的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 2025 装备采购 军品定价 中航成飞 政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述中航成飞面临的产能交付、供应链、成本及军品定价挑战，以及新型号放量和航空装备升级带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 营收 交付 产能 供应链 挑战 机遇"]}, {"id": "sec_6", "title": "未来展望", "description": "结合行业需求、公司产能和型号周期，展望中航成飞2025年营业收入规模及同比增速，并区分实际年报数据与市场预测。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025年 营业收入 同比增长 年报 预测"]}], "research_questions": ["中航成飞2025年营业收入的具体数值和同比增长率是多少？", "中航成飞2025年收入增长的主要驱动因素和收入确认节奏是什么？", "国防预算、装备采购政策及主机厂竞争格局如何影响中航成飞2025年营收增速？"]}}

