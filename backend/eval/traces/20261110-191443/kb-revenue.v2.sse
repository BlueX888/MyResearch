yle": {"color": "#69b1ff"}}, {"value": 275.84, "itemStyle": {"color": "#1677ff"}}, {"value": 270.73, "itemStyle": {"color": "#0958d9"}}], "itemStyle": {"borderRadius": [4, 4, 0, 0]}, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#333", "fontSize": 12}}]}}]}}

