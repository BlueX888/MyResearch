data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:42:05.768492", "content": {"results": [{"id": "fact_d551d504", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度公司财务报告出具了标准无保留意见的审计报告。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度公司财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": false}, {"id": "fact_590211fd", "title": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_89040626", "title": "汉中汉航机电有限公司持股比例为5.75%，持股数量为153,597,730股；汉中航空工业（集团）有限公司持股比例为5.29%，持股数量为141,442,953...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "汉中汉航机电有限公司持股比例为5.75%，持股数量为153,597,730股；汉中航空工业（集团）有限公司持股比例为5.29%，持股数量为141,442,953股。", "date": "", "isSupplementary": false}, {"id": "fact_ff81e36f", "title": "公告摘要披露，汉中汉航机电有限公司、汉中航空工业（集团）有限公司和中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "公告摘要披露，汉中汉航机电有限公司、汉中航空工业（集团）有限公司和中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司。", "date": "", "isSupplementary": false}, {"id": "fact_2755b002", "title": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": false}, {"id": "fact_26ca44e5", "title": "本次搜索结果中的2025年年度报告摘要未披露前五大供应商名称、采购金额或前五大供应商采购集中度数据，因此无法据此验证中航成飞2025年前五大供应商的具体名称和采...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "本次搜索结果中的2025年年度报告摘要未披露前五大供应商名称、采购金额或前五大供应商采购集中度数据，因此无法据此验证中航成飞2025年前五大供应商的具体名称和采购金额。", "date": "", "isSupplementary": false}, {"id": "fact_9df8dbaa", "title": "本次补充搜索返回的全部结果均为《中航成飞股份有限公司2025年年度报告摘要》（公告编号：2026-009），未检索到中航工业集团或成飞的债券募集说明书、信用评级...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "本次补充搜索返回的全部结果均为《中航成飞股份有限公司2025年年度报告摘要》（公告编号：2026-009），未检索到中航工业集团或成飞的债券募集说明书、信用评级报告，因此未获得任何供应商集中度（前五大供应商名称及采购金额）数据。", "date": "", "isSupplementary": true}, {"id": "fact_287b5299", "title": "中航成飞控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%（153,597,73...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%（153,597,730股）、汉中航空工业（集团）有限公司持股5.29%（141,442,953股），三者实际控制人均为中国航空工业集团有限公司。该关联关系提示公司采购可能大量来自集团内关联方，但年报摘要未披露具体供应商名单。", "date": "", "isSupplementary": true}, {"id": "fact_aacd24c8", "title": "中航成飞（股票代码302132，深圳证券交易所上市）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞（股票代码302132，深圳证券交易所上市）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；办公地址为四川省成都市青羊区黄田坝纬一路88号。该业务结构说明其供应商应集中于航空材料、机载系统、结构件等航空产业链环节，但摘要未列示供应商明细。", "date": "", "isSupplementary": true}, {"id": "fact_2ef88560", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年财务报告出具标准无保留意见；公司2025年因同一控制下企业合并对以前年度会计数据进行追溯调整，表明报告期内存...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年财务报告出具标准无保留意见；公司2025年因同一控制下企业合并对以前年度会计数据进行追溯调整，表明报告期内存在资产重组整合，可能影响供应商体系与采购集中度的同比可比性。", "date": "", "isSupplementary": true}, {"id": "fact_6a73e3ed", "title": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，资本公积金转增0股；报告期无优先股。该信息与供应商及采购数据无关，仅作为年...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，资本公积金转增0股；报告期无优先股。该信息与供应商及采购数据无关，仅作为年报摘要内容完整性的旁证。", "date": "", "isSupplementary": true}, {"id": "fact_1adc7fbf", "title": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该业务结构意味着其供应商体系集中于航空...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该业务结构意味着其供应商体系集中于航空原材料、机载成品/配套件及工装等领域，但摘要未披露具体供应商名称与采购金额。", "date": "", "isSupplementary": true}, {"id": "fact_c5f1d1e3", "title": "股权结构显示，中国航空工业集团有限公司持股78.66%（2,101,738,612股），为控股股东；汉中汉航机电有限公司持股5.75%（153,597,730股...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "股权结构显示，中国航空工业集团有限公司持股78.66%（2,101,738,612股），为控股股东；汉中汉航机电有限公司持股5.75%（153,597,730股）；汉中航空工业（集团）有限公司持股5.29%（141,442,953股）。上述股东与公司同受中国航空工业集团控制，构成关联方，是日常关联交易（含关联采购）的主要潜在对象，但摘要未给出关联采购预计金额。", "date": "", "isSupplementary": true}, {"id": "fact_a3146f66", "title": "本次检索命中的三组关键词（年度报告全文前五名供应商采购金额、2025年度日常关联交易预计采购、中航工业债券募集说明书供应商集中度）中，仅“年度报告摘要”有实质命...", "source": "本次补充搜索结果整体", "url": "", "snippet": "本次检索命中的三组关键词（年度报告全文前五名供应商采购金额、2025年度日常关联交易预计采购、中航工业债券募集说明书供应商集中度）中，仅“年度报告摘要”有实质命中，且该摘要不含供应商集中度、前五名供应商名称及采购金额、关联采购预计额度等数据；债券募集说明书类文件未在结果中出现。", "date": "", "isSupplementary": true}, {"id": "fact_5c8f5246", "title": "本次补充搜索返回的结果均为《中航成飞股份有限公司2025年年度报告摘要》（CF-2025-ANNUAL-SUMMARY.pdf），内容涵盖主要会计数据、财务指标...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "本次补充搜索返回的结果均为《中航成飞股份有限公司2025年年度报告摘要》（CF-2025-ANNUAL-SUMMARY.pdf），内容涵盖主要会计数据、财务指标、股本及股东情况、主营业务简介等，未包含2025年度日常关联交易预计/执行公告，也未披露采购类关联方金额或前五大供应商名称及采购金额。", "date": "", "isSupplementary": true}, {"id": "fact_f6105ece", "title": "年报摘要披露公司2025年营业收入为75,358,958,001.86元，但该数据为整体营业收入，并非采购类关联交易金额，无法据此推算前五大供应商采购额。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "年报摘要披露公司2025年营业收入为75,358,958,001.86元，但该数据为整体营业收入，并非采购类关联交易金额，无法据此推算前五大供应商采购额。", "date": "", "isSupplementary": true}, {"id": "fact_25fcd476", "title": "本次补充搜索返回的全部结果均来自《中航成飞股份有限公司2025年年度报告摘要》（CF-2025-ANNUAL-SUMMARY.pdf），内容涵盖重要提示、主要业...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "本次补充搜索返回的全部结果均来自《中航成飞股份有限公司2025年年度报告摘要》（CF-2025-ANNUAL-SUMMARY.pdf），内容涵盖重要提示、主要业务、主要会计数据、股本及股东情况等章节，但未出现任何'主要供应商'或'前五名供应商'相关章节及数据。", "date": "", "isSupplementary": true}, {"id": "fact_839387b4", "title": "年报摘要明确说明'本年度报告摘要来自年度报告全文'，并提示投资者到证监会指定媒体阅读年度报告全文，说明供应商明细等细节信息通常仅存在于年报全文而非摘要中。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "年报摘要明确说明'本年度报告摘要来自年度报告全文'，并提示投资者到证监会指定媒体阅读年度报告全文，说明供应商明细等细节信息通常仅存在于年报全文而非摘要中。", "date": "", "isSupplementary": true}, {"id": "fact_3985f5fd", "title": "搜索结果中与经营规模相关的可用数据：2025年分季度营业收入分别为33.09亿元、173.93亿元、275.84亿元、270.73亿元，全年营业收入规模较大，但...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "搜索结果中与经营规模相关的可用数据：2025年分季度营业收入分别为33.09亿元、173.93亿元、275.84亿元、270.73亿元，全年营业收入规模较大，但未披露采购集中度或供应商构成。", "date": "", "isSupplementary": true}, {"id": "fact_8cf55deb", "title": "年报摘要披露公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；该业务描述未附带供应商名单或采购金额信...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "年报摘要披露公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；该业务描述未附带供应商名单或采购金额信息。", "date": "", "isSupplementary": true}]}}

