data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:36:04.253068", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "采购与供应链市场概况", "description": "梳理中航成飞主营业务、2025年采购规模背景、航空制造原材料和零部件采购特点，以及前五大供应商采购金额的披露口径与可得性。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 年报 前五大供应商 采购金额；中航成飞 采购 供应链 航空零部件 原材料"]}, {"id": "sec_2", "title": "供应商竞争格局", "description": "分析中航成飞供应商体系、航空工业集团内配套企业、机载系统与材料供应商竞争格局，识别2025年前五大供应商候选名单及采购金额线索。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 供应商 名单 前五名；成飞 配套 供应商 航空工业 关联交易 采购金额"]}, {"id": "sec_3", "title": "技术趋势与供应结构", "description": "分析航空制造技术趋势对供应商结构的影响，包括复合材料、精密加工、机载系统、数字化供应链等方向及其对前五大供应商采购金额的潜在影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空制造 复合材料 精密加工 机载系统 供应链 成飞 采购；中航成飞 技术 供应商 配套"]}, {"id": "sec_4", "title": "政策环境与信息披露", "description": "梳理军工央企信息披露、保密管理、军品定价、供应链安全和关联交易监管政策，评估其对获取2025年前五大供应商名称和采购金额的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军工央企 供应商 信息披露 关联交易 公告 政策；中航成飞 年报 前五大供应商 披露 要求"]}, {"id": "sec_5", "title": "挑战与机遇", "description": "分析数据可得性、保密限制、供应商名称披露不完整等挑战，以及通过供应商公告、债券文件、行业数据库和产业链调研获取信息的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 供应商 数据 获取 挑战；军工 供应链 调研 供应商 公告 采购金额"]}, {"id": "sec_6", "title": "未来展望", "description": "展望中航成飞2025年及后续采购集中度、供应商结构变化和披露趋势，形成前五大供应商名称与采购金额的研究结论和验证路径。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 采购 趋势 供应商 集中度；成飞 供应链 未来 配套 格局"]}], "research_questions": ["中航成飞2025年前五大供应商分别是谁，各自采购金额是多少；中航成飞2025年前五大供应商采购金额及集中度可从哪些公开或间接渠道验证；中航成飞前五大供应商中航空工业集团内关联方占比及采购金额变化趋势如何"]}}

