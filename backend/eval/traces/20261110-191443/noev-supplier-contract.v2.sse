alue": 78.66, "itemStyle": {"color": "#1677ff"}}]}]}}, {"id": "chart_003", "title": "前五大供应商采购金额", "subtitle": "2025年数据未披露（年报摘要未列示供应商名称及金额）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "top": "18%", "bottom": "8%", "containLabel": true}, "tooltip": {"trigger": "axis", "formatter": "前五大供应商采购金额合计：未披露"}, "xAxis": {"type": "category", "data": ["前五大供应商采购金额合计"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisTick": {"show": false}, "axisLabel": {"color": "#666", "fontSize": 12}}, "yAxis": {"type": "value", "name": "元", "nameTextStyle": {"color": "#999", "fontSize": 11}, "axisLine": {"show": false}, "axisLabel": {"color": "#999"}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "bar", "barWidth": 40, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5", "borderRadius": 4}, "itemStyle": {"color": "#d9d9d9", "borderRadius": 4}, "label": {"show": true, "position": "top", "formatter": "未披露", "color": "#fa8c16", "fontSize": 13, "fontWeight": "bold"}, "data": [null]}], "graphic": [{"type": "text", "left": "center", "top": "middle", "style": {"text": "该指标在2025年年度报告摘要中未披露\n（供应商名称与采购金额均缺失）", "fill": "#999", "fontSize": 12, "lineHeight": 20, "textAlign": "center"}}]}}]}}

