data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:39:16.129983", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'股东名称': ['中国航空工业集团', '汉中汉航机电', '汉中航空工业（集团）'], '持股比例': [78.66, 5.75, 5.29]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df['股东名称']))\ny = df['持股比例'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='#f59e0b', markeredgecolor='#6366f1', markeredgewidth=2, label='持股比例')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 2.5, str(v) + '%', ha='center', fontsize=12, fontweight='bold', color='#1e293b')\nplt.title('采购与供应链市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('主要股东', fontsize=14)\nplt.ylabel('持股比例（%）', fontsize=14)\nplt.xticks(x, df['股东名称'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 95)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper right')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 采购与供应链市场概况"}}

