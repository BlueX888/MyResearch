data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:27:58.274739", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'信息类别': ['审计机构', '审计意见类型', '非标准审计意见提示', '股票代码', '上市交易所', '公告编号'], '平均置信度': [95.0, 95.0, 92.5, 95.0, 95.0, 95.0], '数据点数量': [2, 2, 2, 2, 1, 1]}\ndf = pd.DataFrame(data)\ncounts = df['数据点数量'].tolist()\nx = np.arange(len(df))\ny = df['平均置信度'].tolist()\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, label='平均置信度')\nplt.fill_between(x, y, 88, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 0.7, str(round(v, 1)) + '%', ha='center', fontsize=11, fontweight='bold', color='#4338ca')\n    plt.text(i, 88.5, 'n=' + str(counts[i]), ha='center', fontsize=10, color='#64748b')\nplt.ylim(88, 100)\nplt.xticks(x, df['信息类别'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('公司概况与年报披露分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('披露信息类别', fontsize=14)\nplt.ylabel('平均置信度 (%)', fontsize=14)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='lower right')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 公司概况与年报披露"}}

