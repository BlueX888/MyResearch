data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:27:46.259302", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Item': ['中国航空工业集团', '汉中汉航机电', '汉中航空工业集团'],\n    'Ratio': [78.66, 5.75, 5.29]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Item':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\ncolors = ['#6366f1', '#06b6d4', '#10b981']\nbars = axes[0].bar(df['Item'], df['Ratio'], color=colors, width=0.6)\naxes[0].set_title('主要股东持股比例', fontsize=16, fontweight='bold', pad=15)\naxes[0].set_ylabel('持股比例（%）', fontsize=14)\naxes[0].tick_params(axis='x', rotation=15, labelsize=11)\naxes[0].tick_params(axis='y', labelsize=12)\naxes[0].grid(True, linestyle='--', alpha=0.3)\nfor b in bars:\n    axes[0].text(b.get_x() + b.get_width()/2, b.get_height() + 1.5, f'{b.get_height():.2f}%', ha='center', fontsize=11, fontweight='bold')\ndist = {'每10股派现(元)': 3.86, '送红股(股)': 0, '资本公积转增(股)': 0}\nkeys = list(dist.keys())\nvals = list(dist.values())\nbars2 = axes[1].bar(keys, vals, color=['#f59e0b', '#94a3b8', '#94a3b8'], width=0.6)\naxes[1].set_title('2025年度利润分配方案', fontsize=16, fontweight='bold', pad=15)\naxes[1].set_ylabel('数值', fontsize=14)\naxes[1].tick_params(axis='x', rotation=15, labelsize=11)\naxes[1].tick_params(axis='y', labelsize=12)\naxes[1].grid(True, linestyle='--', alpha=0.3)\nfor b in bars2:\n    axes[1].text(b.get_x() + b.get_width()/2, b.get_height() + 0.05, f'{b.get_height()}', ha='center', fontsize=11, fontweight='bold')\nfig.suptitle('中航成飞(302132) 2025年年报审计与分配概览\\n审计机构：大信会计师事务所（特殊普通合伙） | 审计意见：标准无保留意见', fontsize=14, fontweight='bold')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从原始数据中提取并去重关键信息：审计机构（大信会计师事务所）、审计意见（标准无保留意见）、非标准意见提示（不适用）、主要股东持股比例（78.66%/5.75%/5.29%）以及2025年度利润分配方案（每10股派现3.86元、送红股0股、转增0股）。将定性审计结论以标题注释形式呈现，定量数据构建DataFrame并做类型清洗，最终生成双面板专业图表：左侧展示股东持股结构，右侧展示利润分配方案，直观呈现年报核心审计与分配信息。"}}

