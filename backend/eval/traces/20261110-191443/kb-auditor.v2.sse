data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:28:05.641481", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    '字段': ['审计机构', '审计意见类型', '非标准意见提示', '股票代码', '上市交易所', '审计机构(复核)', '审计意见类型(复核)', '非标准意见提示(复核)', '证券代码', '公告编号'],\n    '置信度': [0.95, 0.95, 0.95, 0.95, 0.95, 0.95, 0.95, 0.90, 0.95, 0.95]\n}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['置信度'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2, markeredgecolor='#6366f1', label='识别置信度')\nplt.fill_between(x, y, 0.85, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 0.004, f'{v:.2f}', ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nplt.xticks(x, df['字段'], rotation=30, ha='right', fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0.85, 1.0)\nplt.title('审计机构识别分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('审计信息字段', fontsize=14)\nplt.ylabel('识别置信度', fontsize=14)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='lower left')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 审计机构识别"}}

