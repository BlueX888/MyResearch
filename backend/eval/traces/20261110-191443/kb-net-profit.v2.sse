data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:14:54.263179", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述航空装备市场规模、国防预算增速、军机列装需求及中航成飞营收驱动因素，为判断2025年净利润增长提供行业背景。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 净利润 同比 航空装备 市场规模 国防预算"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述主要军工主机厂竞争格局，分析中航成飞在歼击机整机、航空防务领域的市场地位、订单份额及与可比公司的盈利差异。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 竞争格局 歼击机 主机厂 中航沈飞 航发动力"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述隐身战机、无人机、航空制造与材料技术趋势，分析产品升级、产能释放对毛利率和净利润的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 技术 隐身战机 无人机 航空制造 毛利率"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、军工采购定价、军品增值税、国企改革等政策，分析政策变化对2025年归母净利润的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 2025 军工 定价 采购 政策 中航成飞"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述订单交付节奏、审价降价、原材料成本、产能瓶颈等挑战，以及外贸出口、无人机和航空维修等机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 业绩 挑战 机遇 订单 交付 审价"]}, {"id": "sec_6", "title": "未来展望", "description": "综合判断2025年归母净利润具体数值及同比变化，关注年报、业绩预告/快报、关联交易和订单公告等验证信息。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 年报 净利润 同比 业绩预告"]}], "research_questions": ["中航成飞2025年归属于上市公司股东的净利润具体数值及同比增速是多少？", "影响2025年归母净利润的主要因素（营收、毛利率、费用、减值、政府补助）分别如何？", "国防预算、军品定价和订单交付节奏如何影响中航成飞2025年业绩？"]}}

