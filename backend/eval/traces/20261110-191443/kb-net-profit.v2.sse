data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:18:30.366682", "content": {"results": [{"id": "fact_d9656ca1", "title": "搜索结果未完整展示“归属于上市公司股东的净利润”行；搜索关键词提及34.32亿元和39.75亿元，但仅凭当前片段不能确认2025年归母净利润及同比变化。", "source": "中航成飞2025年年度报告摘要（本地知识库CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "搜索结果未完整展示“归属于上市公司股东的净利润”行；搜索关键词提及34.32亿元和39.75亿元，但仅凭当前片段不能确认2025年归母净利润及同比变化。", "date": "", "isSupplementary": false}, {"id": "fact_665b6628", "title": "中航成飞股份有限公司2025年年度报告摘要的证券代码为302132，证券简称为中航成飞，公告编号为2026-009。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞股份有限公司2025年年度报告摘要的证券代码为302132，证券简称为中航成飞，公告编号为2026-009。", "date": "", "isSupplementary": false}, {"id": "fact_75ea8acb", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": false}, {"id": "fact_53d78690", "title": "中航成飞2025年年度报告摘要包含“近三年主要会计数据和财务指标”章节，并因同一控制下企业合并对以前年度会计数据进行追溯调整或重述。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要包含“近三年主要会计数据和财务指标”章节，并因同一控制下企业合并对以前年度会计数据进行追溯调整或重述。", "date": "", "isSupplementary": false}, {"id": "fact_0fbee88f", "title": "搜索结果片段仅展示了主要会计数据表格的表头和追溯调整说明，未展示2025年归属于上市公司股东的净利润、营业收入、毛利率、净利率及同比变化的具体数值。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "搜索结果片段仅展示了主要会计数据表格的表头和追溯调整说明，未展示2025年归属于上市公司股东的净利润、营业收入、毛利率、净利率及同比变化的具体数值。", "date": "", "isSupplementary": false}, {"id": "fact_ac300450", "title": "中航成飞2025年主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_93b13d1d", "title": "中国航空工业集团有限公司为中航成飞控股股东，持股比例78.66%，国有法人；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中国航空工业集团有限公司为中航成飞控股股东，持股比例78.66%，国有法人；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%。", "date": "", "isSupplementary": false}, {"id": "fact_bdbc0008", "title": "中航成飞股份有限公司2025年年度报告摘要的证券代码为302132，证券简称为中航成飞，公告编号为2026-009。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞股份有限公司2025年年度报告摘要的证券代码为302132，证券简称为中航成飞，公告编号为2026-009。", "date": "", "isSupplementary": false}, {"id": "fact_3e995dd3", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": false}, {"id": "fact_f3be134c", "title": "中航成飞2025年年度报告摘要披露，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_22a9c88f", "title": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": false}, {"id": "fact_cc3260d9", "title": "截至报告期末，中国航空工业集团有限公司持有中航成飞78.66%股份，汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "截至报告期末，中国航空工业集团有限公司持有中航成飞78.66%股份，汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%。", "date": "", "isSupplementary": false}, {"id": "fact_d187c541", "title": "当前搜索结果中的2025年年度报告摘要片段未包含“归属于上市公司股东的净利润”的具体金额及同比增减数据，因此无法据此确认该指标。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "当前搜索结果中的2025年年度报告摘要片段未包含“归属于上市公司股东的净利润”的具体金额及同比增减数据，因此无法据此确认该指标。", "date": "", "isSupplementary": false}, {"id": "fact_29cb6351", "title": "中航成飞股份有限公司2025年年度报告摘要的证券代码为302132，证券简称为中航成飞，公告编号为2026-009。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞股份有限公司2025年年度报告摘要的证券代码为302132，证券简称为中航成飞，公告编号为2026-009。", "date": "", "isSupplementary": false}, {"id": "fact_f43f65ad", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": false}, {"id": "fact_9f771ee1", "title": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_9f83bfc6", "title": "年报摘要包含“近三年主要会计数据和财务指标”表，表头列示2025年末、2024年末、本年末比上年末增减、2023年末等字段，但搜索结果片段在表头处截断，未显示“...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "年报摘要包含“近三年主要会计数据和财务指标”表，表头列示2025年末、2024年末、本年末比上年末增减、2023年末等字段，但搜索结果片段在表头处截断，未显示“归属于上市公司股东的净利润”的具体数值及同比增减。", "date": "", "isSupplementary": false}, {"id": "fact_1697c3e2", "title": "中国航空工业集团有限公司为中航成飞控股股东，持股比例78.66%，持股数量2,101,738,612股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中国航空工业集团有限公司为中航成飞控股股东，持股比例78.66%，持股数量2,101,738,612股。", "date": "", "isSupplementary": false}, {"id": "fact_8dbdb064", "title": "公司因同一控制下企业合并对以前年度会计数据进行追溯调整或重述，这可能影响2025年同比数据的可比口径。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "公司因同一控制下企业合并对以前年度会计数据进行追溯调整或重述，这可能影响2025年同比数据的可比口径。", "date": "", "isSupplementary": false}, {"id": "fact_9d6cdcc8", "title": "汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%，上述股东与中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%，上述股东与中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司。", "date": "", "isSupplementary": false}]}}

