data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:24:33.317254", "content": {"results": [{"id": "fact_8dbdb064", "title": "公司因同一控制下企业合并对以前年度会计数据进行追溯调整或重述，这可能影响2025年同比数据的可比口径。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "公司因同一控制下企业合并对以前年度会计数据进行追溯调整或重述，这可能影响2025年同比数据的可比口径。", "date": "", "isSupplementary": false}, {"id": "fact_9d6cdcc8", "title": "汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%，上述股东与中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%，上述股东与中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司。", "date": "", "isSupplementary": false}, {"id": "fact_cba13de8", "title": "2025年归属于上市公司股东的净利润为3,974,910,728.94元，2024年调整前为127,681,276.92元，2024年调整后（同一控制下企业合并...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年归属于上市公司股东的净利润为3,974,910,728.94元，2024年调整前为127,681,276.92元，2024年调整后（同一控制下企业合并重述）为2,725,603,147.17元，本年比上年增减6.47%。", "date": "", "isSupplementary": true}, {"id": "fact_62e314b6", "title": "2025年分季度归属于上市公司股东的净利润分别为：第一季度156,494,308.41元，第二季度756,329,709.24元，第三季度1,256,306,6...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年分季度归属于上市公司股东的净利润分别为：第一季度156,494,308.41元，第二季度756,329,709.24元，第三季度1,256,306,602.29元，第四季度1,263,159,232.02元。", "date": "", "isSupplementary": true}, {"id": "fact_fe28f734", "title": "2025年分季度归属于上市公司股东的净利润分别为：第一季度156,494,308.41元、第二季度756,329,709.24元、第三季度1,256,306,6...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年分季度归属于上市公司股东的净利润分别为：第一季度156,494,308.41元、第二季度756,329,709.24元、第三季度1,256,306,602.29元、第四季度1,263,159,232.02元；合计约3,432,289,851.96元（约34.32亿元）。", "date": "", "isSupplementary": true}, {"id": "fact_43710556", "title": "2025年归属于上市公司股东的扣除非经常性损益的净利润为3,305,093,771.39元，2024年（调整前/调整后）为94,665,860.31元，本年比上...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年归属于上市公司股东的扣除非经常性损益的净利润为3,305,093,771.39元，2024年（调整前/调整后）为94,665,860.31元，本年比上年增减3,391.33%，方向为大幅增长。注意该指标为扣非净利润，并非归母净利润。", "date": "", "isSupplementary": true}, {"id": "fact_33920f5e", "title": "2025年加权平均净资产收益率为26.76%，2024年调整后为30.34%，本年比上年增减-3.58个百分点，方向为下降。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年加权平均净资产收益率为26.76%，2024年调整后为30.34%，本年比上年增减-3.58个百分点，方向为下降。", "date": "", "isSupplementary": true}, {"id": "fact_26a29281", "title": "2025年末归属于上市公司股东的净资产为21,208,525,338.75元，2024年末调整后为19,430,635,961.57元，本年末比上年末增减9.1...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年末归属于上市公司股东的净资产为21,208,525,338.75元，2024年末调整后为19,430,635,961.57元，本年末比上年末增减9.15%，方向为增长。", "date": "", "isSupplementary": true}, {"id": "fact_9a30b097", "title": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，说明公司业务覆盖整机制造与维修保障全链...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，说明公司业务覆盖整机制造与维修保障全链条。", "date": "", "isSupplementary": true}, {"id": "fact_1922a12a", "title": "中航成飞2025年年度报告摘要由大信会计师事务所（特殊普通合伙）审计，审计意见为标准的无保留意见，财务数据具备可靠性基础。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要由大信会计师事务所（特殊普通合伙）审计，审计意见为标准的无保留意见，财务数据具备可靠性基础。", "date": "", "isSupplementary": true}, {"id": "fact_78bb5c5c", "title": "公司近三年主要会计数据和财务指标表中列示了2025年末、2024年末（含追溯调整前后）及2023年末数据，并注明因同一控制下企业合并需追溯调整/重述以前年度会计...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "公司近三年主要会计数据和财务指标表中列示了2025年末、2024年末（含追溯调整前后）及2023年末数据，并注明因同一控制下企业合并需追溯调整/重述以前年度会计数据，提示同比对比需以重述后口径为准。", "date": "", "isSupplementary": true}, {"id": "fact_34d66556", "title": "中航成飞（证券代码：302132，深交所上市）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞（证券代码：302132，深交所上市）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": true}, {"id": "fact_c03234f9", "title": "中国航空工业集团有限公司为中航成飞控股股东，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中国航空工业集团有限公司为中航成飞控股股东，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%。", "date": "", "isSupplementary": true}, {"id": "fact_a926e637", "title": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，以资本公积金转增0股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，以资本公积金转增0股。", "date": "", "isSupplementary": true}, {"id": "fact_cc336ee8", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具标准无保留意见审计报告；公司报告期无优先股股东持股情况。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具标准无保留意见审计报告；公司报告期无优先股股东持股情况。", "date": "", "isSupplementary": true}, {"id": "fact_b8162ca4", "title": "中航成飞（证券代码302132）2025年年度报告摘要显示，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞（证券代码302132）2025年年度报告摘要显示，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该表述确认公司业务涵盖军机（航空防务装备）与民机两大板块，但摘要片段未披露军机与民机、内销与军贸出口的收入拆分及各自毛利率。", "date": "", "isSupplementary": true}, {"id": "fact_2493dffc", "title": "年报摘要“近三年主要会计数据和财务指标”章节设有2025年末、2024年末（两列，因同一控制下企业合并追溯调整）、2023年末对比表，并注明追溯调整原因为“同一...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "年报摘要“近三年主要会计数据和财务指标”章节设有2025年末、2024年末（两列，因同一控制下企业合并追溯调整）、2023年末对比表，并注明追溯调整原因为“同一控制下企业合并”。但检索片段在表头处即被截断，未包含归属于上市公司股东的净利润的具体数值及同比增减幅度。", "date": "", "isSupplementary": true}, {"id": "fact_dbb1f75e", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具标准无保留意见审计报告，且公司不存在“上市时未盈利且目前未实现盈利”情形，说明当期盈利为正。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具标准无保留意见审计报告，且公司不存在“上市时未盈利且目前未实现盈利”情形，说明当期盈利为正。", "date": "", "isSupplementary": true}, {"id": "fact_1d4eae8a", "title": "股权结构显示，中国航空工业集团有限公司持股78.66%（2,101,738,612股），汉中汉航机电有限公司持股5.75%（153,597,730股），汉中航空...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "股权结构显示，中国航空工业集团有限公司持股78.66%（2,101,738,612股），汉中汉航机电有限公司持股5.75%（153,597,730股），汉中航空工业（集团）有限公司持股5.29%（141,442,953股）；汉中汉航机电、汉中航空工业（集团）与中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团。该关联关系是“同一控制下企业合并”追溯调整的背景，也意味着公司军机业务与集团内", "date": "", "isSupplementary": true}, {"id": "fact_22fda3a5", "title": "检索结果中未出现任何关于军贸出口收入规模、军机与内销产品毛利率对比、航空材料（如钛合金、碳纤维、高温合金）采购价格或原材料成本变动的具体数据；亦未出现归属于上市...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "检索结果中未出现任何关于军贸出口收入规模、军机与内销产品毛利率对比、航空材料（如钛合金、碳纤维、高温合金）采购价格或原材料成本变动的具体数据；亦未出现归属于上市公司股东的净利润金额及其同比增减比例。补充搜索关键词所指向的信息在本批片段中均未命中。", "date": "", "isSupplementary": true}]}}

