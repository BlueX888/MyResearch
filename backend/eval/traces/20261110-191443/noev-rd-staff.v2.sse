data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:36:22.762054", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2024, 2025], 'Revenue': [65054925100, 75358958001.86]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['Revenue'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='营业收入')\nplt.fill_between(df['Year'], df['Revenue'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['Revenue']):\n    plt.text(df['Year'][i], v + 1e9, f'{v/1e8:.2f}亿', ha='center', fontsize=11, fontweight='bold')\nplt.title('研发投入历史与2025年金额分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('营业收入（元）', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 研发投入历史与2025年金额"}}

