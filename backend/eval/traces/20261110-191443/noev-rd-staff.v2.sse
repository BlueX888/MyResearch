data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:35:35.283673", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'阶段': ['2024年（调整前）', '2024年（调整后）', '2025年'], '营业收入': [17.80, 650.55, 753.59]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['营业收入'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, markeredgecolor='#6366f1', label='营业收入')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 22, f'{v:.2f}亿元', ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nplt.xticks(x, df['阶段'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('公司与业务概况分析——营业收入趋势', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('报告期', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.ylim(0, 880)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left')\nplt.text(0.5, 0.02, '注：2024年调整后数据为重大资产重组追溯调整口径，与调整前不可直接比较', transform=plt.gca().transAxes, ha='center', fontsize=10, color='#6b7280')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 公司与业务概况"}}

