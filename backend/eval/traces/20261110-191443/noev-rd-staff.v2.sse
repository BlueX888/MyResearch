data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:35:29.701101", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Year': [2024, 2025],\n    'Revenue': [650.55, 753.59],\n    'NetAssets': [194.31, 212.09]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nb1 = ax1.bar(df['Year'].astype(str), df['Revenue'], color='#6366f1', width=0.5)\nfor b, v in zip(b1, df['Revenue']):\n    ax1.text(b.get_x() + b.get_width() / 2, v + 10, f'{v:.2f}', ha='center', fontsize=12, fontweight='bold')\nax1.set_title('营业收入（亿元，调整后口径）', fontsize=16, fontweight='bold', pad=15)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('金额（亿元）', fontsize=14)\nax1.tick_params(labelsize=12)\nax1.set_ylim(0, df['Revenue'].max() * 1.18)\nax2 = axes[1]\nb2 = ax2.bar(df['Year'].astype(str), df['NetAssets'], color='#10b981', width=0.5)\nfor b, v in zip(b2, df['NetAssets']):\n    ax2.text(b.get_x() + b.get_width() / 2, v + 3, f'{v:.2f}', ha='center', fontsize=12, fontweight='bold')\nax2.set_title('归母净资产（亿元，调整后口径）', fontsize=16, fontweight='bold', pad=15)\nax2.set_xlabel('年份', fontsize=14)\nax2.set_ylabel('金额（亿元）', fontsize=14)\nax2.tick_params(labelsize=12)\nax2.set_ylim(0, df['NetAssets'].max() * 1.18)\nfig.suptitle('中航成飞核心财务指标对比（研发人员/研发投入：未披露）', fontsize=18, fontweight='bold')\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "研究问题聚焦中航成飞2025年研发人员数量与研发投入金额，但所提供的全部数据片段中，这两项指标均标注为“未披露/未在搜索结果中披露”，因此无法给出具体数值，需在结论中明确说明数据缺口。为提供有价值的分析，改用可获得的2025年核心财务指标（营业收入、归母净资产）构建可比口径（2024年调整后 vs 2025年）的对比可视化，展示公司规模与净资产增长（营收同比约+15.8%，净资产同比+9.15%），并在图表标题中标注研发数据缺失，提示需查阅年报“研发投入”章节补充。"}}

