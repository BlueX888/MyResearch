data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:32:20.457253", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "公司与业务概况", "description": "梳理中航成飞主营业务、航空整机及民机配套结构，明确研发投入和研发人员的统计口径、合并范围及2025年数据披露来源。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 年报 研发投入 研发人员 统计口径"]}, {"id": "sec_2", "title": "研发投入历史与2025年金额", "description": "提取2023-2025年研发费用或研发投入总额、资本化比例、占营业收入比重，核对2025年研发投入金额及同比变化。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 研发投入 金额 研发费用 资本化"]}, {"id": "sec_3", "title": "研发人员数量与结构", "description": "统计2025年研发人员总数、占员工比例、学历年龄专业结构及较上年变化，区分母公司口径与合并口径。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 研发人员 数量 占比 结构"]}, {"id": "sec_4", "title": "行业对标与竞争格局", "description": "对比中航沈飞、航发动力等航空军工企业研发投入强度与研发人员规模，判断中航成飞2025年水平及行业位置。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航沈飞 航发动力 研发人员 研发投入 对比 2025"]}, {"id": "sec_5", "title": "政策环境与外部驱动", "description": "分析国防预算、科技创新政策、军工科研院所改革、大飞机专项等对中航成飞研发投入和研发人员扩张的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["2025 国防预算 航空工业 研发投入 政策 军工改革"]}, {"id": "sec_6", "title": "数据核验与未来展望", "description": "交叉核验年报、ESG报告、重组报告书及权威数据库，形成2025年研发人员数量和研发投入金额结论，并展望后续趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 年报 研发人员 研发投入 核验"]}], "research_questions": ["中航成飞2025年研发人员数量是多少，统计口径是否包含子公司、兼职或外聘研发人员？", "中航成飞2025年研发投入金额是多少，披露的是研发费用还是研发投入总额，是否包含资本化研发支出？", "2025年研发人员数量和研发投入金额较2024年变化及主要驱动因素是什么？"]}}

