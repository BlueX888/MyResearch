data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:39:51.139699", "content": {"results": [{"id": "fact_3d1981f0", "title": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布了2025年年度报告摘要（公告编号：2026-009），大信会计师事务所对其2025年度财...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布了2025年年度报告摘要（公告编号：2026-009），大信会计师事务所对其2025年度财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": true}, {"id": "fact_e0eb6c2a", "title": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该表述确认公司业务包含研发环节，但摘要未...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该表述确认公司业务包含研发环节，但摘要未披露研发体系架构、研发人员编制或在研项目清单。", "date": "", "isSupplementary": true}, {"id": "fact_7c742b39", "title": "年度报告摘要中包含“近三年主要会计数据和财务指标”章节，并注明因同一控制下企业合并需追溯调整或重述以前年度会计数据；但检索片段在财务指标表格处被截断，未显示研发...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "年度报告摘要中包含“近三年主要会计数据和财务指标”章节，并注明因同一控制下企业合并需追溯调整或重述以前年度会计数据；但检索片段在财务指标表格处被截断，未显示研发投入金额等具体数值。", "date": "", "isSupplementary": true}, {"id": "fact_d5da2be5", "title": "利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，以资本公积金转增0股；报告期无优先股股东持股情况。该信息与研发人员数量、研发投入金额无直接关联...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，以资本公积金转增0股；报告期无优先股股东持股情况。该信息与研发人员数量、研发投入金额无直接关联。", "date": "", "isSupplementary": true}, {"id": "fact_e450b8b7", "title": "本次检索命中的文件为《中航成飞股份有限公司2025年年度报告摘要》（证券代码：302132，公告编号：2026-009），并非年度报告全文。摘要开篇明确提示“本...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "本次检索命中的文件为《中航成飞股份有限公司2025年年度报告摘要》（证券代码：302132，公告编号：2026-009），并非年度报告全文。摘要开篇明确提示“本年度报告摘要来自年度报告全文，为全面了解本公司的经营成果、财务状况及未来发展规划，投资者应当到证监会指定媒体仔细阅读年度报告全文”。", "date": "", "isSupplementary": true}, {"id": "fact_1cbc0020", "title": "在检索到的摘要片段中，未出现“研发投入”章节内容，也未出现研发投入费用化金额、资本化金额、研发投入总额或研发投入占营业收入比例等任何相关数据。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "在检索到的摘要片段中，未出现“研发投入”章节内容，也未出现研发投入费用化金额、资本化金额、研发投入总额或研发投入占营业收入比例等任何相关数据。", "date": "", "isSupplementary": true}, {"id": "fact_e0065519", "title": "在检索到的摘要片段中，未出现“员工情况”章节内容，未披露研发人员数量、研发人员占员工总数比例、员工总数等数据，因此无法据此回答研发人员数量问题。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "在检索到的摘要片段中，未出现“员工情况”章节内容，未披露研发人员数量、研发人员占员工总数比例、员工总数等数据，因此无法据此回答研发人员数量问题。", "date": "", "isSupplementary": true}, {"id": "fact_b3aef052", "title": "摘要披露的主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；该表述仅为业务概述，未量化研发投入或研发人员...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "摘要披露的主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；该表述仅为业务概述，未量化研发投入或研发人员规模。", "date": "", "isSupplementary": true}, {"id": "fact_67932166", "title": "摘要中可获取的2025年度主要财务数据（可作为研发投入占比等衍生指标的分母参考）：营业收入75,358,958,001.86元；归属于上市公司股东的净资产21,...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "摘要中可获取的2025年度主要财务数据（可作为研发投入占比等衍生指标的分母参考）：营业收入75,358,958,001.86元；归属于上市公司股东的净资产21,208,525,338.75元；加权平均净资产收益率26.76%；经营活动产生的现金流量净额-2,542,177,536.87元；报告期末普通股股东总数73,050户。", "date": "", "isSupplementary": true}, {"id": "fact_7d876d9b", "title": "摘要按季度披露了营业收入：第一季度3,308,640,285.35元、第二季度17,393,488,964.30元、第三季度27,584,043,546.48元...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "摘要按季度披露了营业收入：第一季度3,308,640,285.35元、第二季度17,393,488,964.30元、第三季度27,584,043,546.48元、第四季度27,072,785,205.73元；但未按季度或年度披露研发投入数据。", "date": "", "isSupplementary": true}, {"id": "fact_f1447629", "title": "本次补充搜索返回的全部结果均来自《CF-2025-ANNUAL-SUMMARY.pdf》（中航成飞2025年年度报告摘要），内容集中在优先股股东情况、产权及控制...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "本次补充搜索返回的全部结果均来自《CF-2025-ANNUAL-SUMMARY.pdf》（中航成飞2025年年度报告摘要），内容集中在优先股股东情况、产权及控制关系方框图、主要会计数据和财务指标、股本及股东情况、分季度主要会计数据等章节，未出现任何关于研发人员学历结构、年龄结构、科技人才占比等ESG/社会责任报告类结构数据。", "date": "", "isSupplementary": true}, {"id": "fact_8f87cf27", "title": "年报摘要中的主要会计数据显示：2025年营业收入75,358,958,001.86元；归属于上市公司股东的扣除非经常性损益的净利润3,305,093,771.3...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "年报摘要中的主要会计数据显示：2025年营业收入75,358,958,001.86元；归属于上市公司股东的扣除非经常性损益的净利润3,305,093,771.39元；归属于上市公司股东的净资产21,208,525,338.75元；加权平均净资产收益率26.76%。这些数据与研发人员结构无关，仅可作为公司整体经营规模的背景参考。", "date": "", "isSupplementary": true}, {"id": "fact_7c516a6f", "title": "年报摘要披露报告期末普通股股东总数73,050户，年度报告披露日前一个月末普通股股东总数71,457户，表决权恢复的优先股股东总数为0，持有特别表决权股份的股东...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "年报摘要披露报告期末普通股股东总数73,050户，年度报告披露日前一个月末普通股股东总数71,457户，表决权恢复的优先股股东总数为0，持有特别表决权股份的股东总数为0；报告期无优先股股东持股情况。该部分为股本结构信息，与研发人员结构无关。", "date": "", "isSupplementary": true}, {"id": "fact_bfe575d9", "title": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布了2025年年度报告摘要（公告编号：2026-009），但该文件为摘要版本，未包含研发人员...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布了2025年年度报告摘要（公告编号：2026-009），但该文件为摘要版本，未包含研发人员数量、研发投入金额及员工构成等明细数据。", "date": "", "isSupplementary": true}, {"id": "fact_71f59445", "title": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该表述仅定性说明研发属于主营业务环节，未...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该表述仅定性说明研发属于主营业务环节，未给出研发投入金额或研发人员数量。", "date": "", "isSupplementary": true}, {"id": "fact_00d81a2e", "title": "公司2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，以资本公积金转增0股；该信息与研发投入/研发人员问题无直接关联。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "公司2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股，以资本公积金转增0股；该信息与研发投入/研发人员问题无直接关联。", "date": "", "isSupplementary": true}, {"id": "fact_eb5241d5", "title": "控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股；该股权结构信息与研发数据无关，仅用于确认报告主体身份。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股；该股权结构信息与研发数据无关，仅用于确认报告主体身份。", "date": "", "isSupplementary": true}, {"id": "fact_e0c4badb", "title": "中航成飞（证券代码：302132，深交所上市）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞（证券代码：302132，深交所上市）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": true}, {"id": "fact_995c7b9f", "title": "公司实际控制人为中国航空工业集团有限公司，控股股东中国航空工业集团有限公司持股78.66%（2,101,738,612股）；汉中汉航机电有限公司持股5.75%，...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "公司实际控制人为中国航空工业集团有限公司，控股股东中国航空工业集团有限公司持股78.66%（2,101,738,612股）；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%。", "date": "", "isSupplementary": true}, {"id": "fact_f38af1df", "title": "公司2025年度利润分配预案为每10股派发现金红利3.86元（含税），不送红股、不以资本公积金转增股本；大信会计师事务所对公司2025年财务报告出具标准无保留意...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "公司2025年度利润分配预案为每10股派发现金红利3.86元（含税），不送红股、不以资本公积金转增股本；大信会计师事务所对公司2025年财务报告出具标准无保留意见。", "date": "", "isSupplementary": true}]}}

