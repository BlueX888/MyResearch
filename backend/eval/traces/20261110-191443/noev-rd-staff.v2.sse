}}, {"value": 753.59, "itemStyle": {"color": "#1677ff"}}], "barWidth": 56, "label": {"show": true, "position": "top", "formatter": "{c} 亿元", "color": "#666"}}]}}, {"id": "chart_003", "title": "主要股东持股结构", "subtitle": "2025年末持股比例（%）", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}: {c}%"}, "legend": {"orient": "vertical", "right": "5%", "top": "middle", "textStyle": {"color": "#666"}}, "series": [{"type": "pie", "radius": ["45%", "70%"], "center": ["38%", "55%"], "avoidLabelOverlap": true, "itemStyle": {"borderColor": "#fff", "borderWidth": 2}, "label": {"show": true, "formatter": "{b}\n{c}%", "color": "#666"}, "data": [{"name": "中国航空工业集团", "value": 78.66, "itemStyle": {"color": "#1677ff"}}, {"name": "汉中汉航机电", "value": 5.75, "itemStyle": {"color": "#722ed1"}}, {"name": "汉中航空工业（集团）", "value": 5.29, "itemStyle": {"color": "#52c41a"}}, {"name": "其他股东", "value": 10.3, "itemStyle": {"color": "#fa8c16"}}]}]}}, {"id": "chart_004", "title": "2025年主要增长指标", "subtitle": "同比增速（%）", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "25%", "right": "15%", "top": "5%", "bottom": "5%", "containLabel": true}, "xAxis": {"type": "value", "show": false, "max": 20}, "yAxis": {"type": "category", "data": ["总资产同比", "归母净资产同比", "营业收入同比"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 6.16, "itemStyle": {"color": "#52c41a"}}, {"value": 9.15, "itemStyle": {"color": "#722ed1"}}, {"value": 15.8, "itemStyle": {"color": "#1677ff"}}], "barWidth": 14, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#666"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}]}}

