data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:20:39.026582", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'quarter': ['第一季度', '第二季度', '第三季度', '第四季度'], 'revenue': [33.09, 173.93, 275.84, 270.73], 'profit': [1.56, 7.56, 12.56, None]}\ndf = pd.DataFrame(data)\nx = np.arange(len(df['quarter']))\nfig, ax1 = plt.subplots(figsize=(12, 7), dpi=200)\nax1.plot(x, df['revenue'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='营业收入（亿元）')\nax1.fill_between(x, df['revenue'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['revenue']):\n    ax1.text(i, v + 9, f'{v:.2f}', ha='center', fontsize=11, color='#4338ca', fontweight='bold')\nax1.set_ylabel('营业收入（亿元）', fontsize=14, color='#4338ca')\nax1.tick_params(axis='y', labelcolor='#4338ca', labelsize=12)\nax1.set_ylim(0, 330)\nax2 = ax1.twinx()\npx = x[:3]\npv = df['profit'][:3]\nax2.plot(px, pv, color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='归母净利润（亿元）')\nax2.fill_between(px, pv, alpha=0.15, color='#f59e0b')\nfor i, v in enumerate(pv):\n    ax2.text(i, v + 0.7, f'{v:.2f}', ha='center', fontsize=11, color='#b45309', fontweight='bold')\nax2.set_ylabel('归母净利润（亿元）', fontsize=14, color='#b45309')\nax2.tick_params(axis='y', labelcolor='#b45309', labelsize=12)\nax2.set_ylim(0, 16)\nax1.set_xticks(x)\nax1.set_xticklabels(df['quarter'], fontsize=12)\nax1.set_xlabel('季度', fontsize=14)\nplt.title('公司概况与利润分配背景分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12, frameon=True)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 公司概况与利润分配背景"}}

