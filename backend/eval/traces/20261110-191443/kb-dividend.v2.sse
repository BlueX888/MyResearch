data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:20:30.158314", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'],\n    'Revenue': [33.09, 173.93, 275.84, 270.73],\n    'NetProfit': [1.56, 7.56, 12.56, 12.63]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Quarter':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nfig = plt.figure(figsize=(12, 7), dpi=200)\nax1 = fig.add_subplot(111)\nbars = ax1.bar(df['Quarter'], df['Revenue'], color='#6366f1', alpha=0.85, width=0.55, label='营业收入（亿元）')\nfor b, v in zip(bars, df['Revenue']):\n    ax1.text(b.get_x() + b.get_width() / 2, v + 5, f'{v:.1f}', ha='center', fontsize=12, fontweight='bold', color='#4338ca')\nax1.set_xlabel('2025年季度', fontsize=14)\nax1.set_ylabel('营业收入（亿元）', fontsize=14, color='#4338ca')\nax1.tick_params(labelsize=12)\nax2 = ax1.twinx()\nax2.plot(df['Quarter'], df['NetProfit'], color='#10b981', linewidth=2.5, marker='o', markersize=8, label='归母净利润（亿元）')\nax2.fill_between(df['Quarter'], df['NetProfit'], alpha=0.12, color='#10b981')\nfor x, y in zip(df['Quarter'], df['NetProfit']):\n    ax2.text(x, y + 0.6, f'{y:.2f}', ha='center', fontsize=12, fontweight='bold', color='#047857')\nax2.set_ylabel('归母净利润（亿元）', fontsize=14, color='#047857')\nax2.tick_params(labelsize=12)\nplt.title('中航成飞2025年经营表现与利润分配预案', fontsize=18, fontweight='bold', pad=20)\ntxt = '利润分配预案：每10股派现3.86元（含税）\\n送红股 0 股 ｜ 资本公积转增 0 股\\n预计派现总额约10.3亿元，分红率约30%'\nax1.text(0.02, 0.97, txt, transform=ax1.transAxes, fontsize=12, va='top', bbox=dict(boxstyle='round,pad=0.5', facecolor='#f0f9ff', edgecolor='#06b6d4'))\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦中航成飞2025年度利润分配预案：以季度营业收入与归母净利润展示全年经营基础，并在图中标注每10股派现3.86元（含税）、送红股0股、资本公积转增0股、预计派现约10.3亿元、分红率约30%的核心预案信息，形成经营—分配一体的专业图表。"}}

