data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:24:24.160403", "content": {"results": [{"id": "fact_26df86df", "title": "中航成飞股东汉中汉航机电有限公司持股比例为5.75%，汉中航空工业（集团）有限公司持股比例为5.29%。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞股东汉中汉航机电有限公司持股比例为5.75%，汉中航空工业（集团）有限公司持股比例为5.29%。", "date": "", "isSupplementary": false}, {"id": "fact_6b570f03", "title": "中航成飞2025年年度报告摘要注明，本摘要来自年度报告全文，投资者应到证监会指定媒体仔细阅读年度报告全文。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞2025年年度报告摘要注明，本摘要来自年度报告全文，投资者应到证监会指定媒体仔细阅读年度报告全文。", "date": "", "isSupplementary": false}, {"id": "fact_64e93083", "title": "中航成飞2025年年度报告摘要的公告编号为2026-009，证券代码302132，证券简称中航成飞。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要的公告编号为2026-009，证券代码302132，证券简称中航成飞。", "date": "", "isSupplementary": false}, {"id": "fact_e3abb8fb", "title": "中航成飞2025年度利润分配预案片段显示：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。原文片段未完整显示现金红利...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年度利润分配预案片段显示：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。原文片段未完整显示现金红利对应的每10股基数，需核对年报全文确认是否为“每10股派3.86元（含税）”。", "date": "", "isSupplementary": false}, {"id": "fact_6571e144", "title": "中航成飞2025年年度报告摘要显示，董事会决议通过的本报告期优先股利润分配预案为不适用。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，董事会决议通过的本报告期优先股利润分配预案为不适用。", "date": "", "isSupplementary": false}, {"id": "fact_52e703f5", "title": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_30d1120c", "title": "中航成飞前10名股东中，中国航空工业集团有限公司为国有法人，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%，持股...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞前10名股东中，中国航空工业集团有限公司为国有法人，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%，持股数量153,597,730股；汉中航空工业（集团）有限公司持股5.29%，持股数量141,442,953股。", "date": "", "isSupplementary": false}, {"id": "fact_a0f461be", "title": "中航成飞2025年年度报告摘要显示，董事会决议通过的本报告期优先股利润分配预案为“不适用”，即公司无优先股股东持股情况，不存在优先股利润分配安排。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞股份有限公司2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，董事会决议通过的本报告期优先股利润分配预案为“不适用”，即公司无优先股股东持股情况，不存在优先股利润分配安排。", "date": "", "isSupplementary": true}, {"id": "fact_60df9799", "title": "中航成飞2025年年度报告摘要披露的审计意见为大信会计师事务所（特殊普通合伙）出具的 standard 无保留意见，且公司上市时已盈利（“公司上市时未盈利且目前...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞股份有限公司2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要披露的审计意见为大信会计师事务所（特殊普通合伙）出具的 standard 无保留意见，且公司上市时已盈利（“公司上市时未盈利且目前未实现盈利”项为不适用），利润分配具备财务基础。", "date": "", "isSupplementary": true}, {"id": "fact_0196100c", "title": "中航成飞股权结构高度集中：中国航空工业集团有限公司持股78.66%（2,101,738,612股），汉中汉航机电有限公司持股5.75%（153,597,730股...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞股份有限公司2025年年度报告摘要）", "url": "", "snippet": "中航成飞股权结构高度集中：中国航空工业集团有限公司持股78.66%（2,101,738,612股），汉中汉航机电有限公司持股5.75%（153,597,730股），汉中航空工业（集团）有限公司持股5.29%（141,442,953股），三者实际控制人同为中国航空工业集团有限公司。该股权结构意味着现金分红的主要受益方为控股股东。", "date": "", "isSupplementary": true}, {"id": "fact_658eb16d", "title": "2025年年度报告摘要的主要会计数据表中出现数值-9,757,045,919.65元，结合上下文疑似为2025年经营活动产生的现金流量净额；该数值为负，表明经营...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "2025年年度报告摘要的主要会计数据表中出现数值-9,757,045,919.65元，结合上下文疑似为2025年经营活动产生的现金流量净额；该数值为负，表明经营活动现金流净流出。", "date": "", "isSupplementary": true}, {"id": "fact_f1d86800", "title": "搜索结果中未出现中航成飞2025年度利润分配预案的具体内容（如每10股派息金额、分红总额等），无法直接验证分红方案。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "搜索结果中未出现中航成飞2025年度利润分配预案的具体内容（如每10股派息金额、分红总额等），无法直接验证分红方案。", "date": "", "isSupplementary": true}, {"id": "fact_2a9f98a8", "title": "中航成飞2025年年度报告摘要披露，公司2025年度利润分配预案为：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股；...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，公司2025年度利润分配预案为：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股；董事会决议通过的本报告期优先股利润分配预案为不适用。", "date": "", "isSupplementary": true}, {"id": "fact_b70fd158", "title": "中航成飞2025年年度报告摘要披露，2025年末归属于上市公司股东的净资产为21,208,525,338.75元；2024年末调整前为2,501,160,950...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，2025年末归属于上市公司股东的净资产为21,208,525,338.75元；2024年末调整前为2,501,160,950.97元，调整后为19,430,635,961.57元；本年末比上年末（调整后）增减为9.15%。", "date": "", "isSupplementary": true}, {"id": "fact_53356fba", "title": "中航成飞2025年年度报告摘要显示，公司需追溯调整或重述以前年度会计数据，追溯调整或重述原因为同一控制下企业合并。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，公司需追溯调整或重述以前年度会计数据，追溯调整或重述原因为同一控制下企业合并。", "date": "", "isSupplementary": true}, {"id": "fact_49382c2b", "title": "中航成飞2025年度利润分配预案（董事会决议通过）：每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。公司报告...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞股份有限公司2025年年度报告摘要，公告编号2026-009）", "url": "", "snippet": "中航成飞2025年度利润分配预案（董事会决议通过）：每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。公司报告期无优先股股东，优先股利润分配预案不适用。", "date": "", "isSupplementary": true}, {"id": "fact_a939970f", "title": "中航成飞股票代码为302132，上市交易所为深圳证券交易所（302开头属创业板代码段），这一板块归属直接决定其适用的现金分红比例监管要求（主板与创业板/科创板规...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（公司简介表）", "url": "", "snippet": "中航成飞股票代码为302132，上市交易所为深圳证券交易所（302开头属创业板代码段），这一板块归属直接决定其适用的现金分红比例监管要求（主板与创业板/科创板规则不同）。", "date": "", "isSupplementary": true}, {"id": "fact_d982760c", "title": "中航成飞2025年度盈利与净资产规模：营业收入75,358,958,001.86元，归属于上市公司股东的净利润约33.05亿元（扣非净利润3,305,093,7...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（主要会计数据）", "url": "", "snippet": "中航成飞2025年度盈利与净资产规模：营业收入75,358,958,001.86元，归属于上市公司股东的净利润约33.05亿元（扣非净利润3,305,093,771.39元），归属于上市公司股东的净资产21,208,525,338.75元，加权平均净资产收益率26.76%。这些指标是测算分红比例（现金分红/净利润、股息率）的基数。", "date": "", "isSupplementary": true}, {"id": "fact_4dd4f323", "title": "本次补充搜索未检索到任何关于“新国九条（2024年新‘国九条’）现金分红监管要求”“主板分红比例要求”“国资委市值管理”“中央企业负责人经营业绩考核”的政策文本...", "source": "搜索结果整体评估（CF-2025-ANNUAL-SUMMARY.pdf 全部片段）", "url": "", "snippet": "本次补充搜索未检索到任何关于“新国九条（2024年新‘国九条’）现金分红监管要求”“主板分红比例要求”“国资委市值管理”“中央企业负责人经营业绩考核”的政策文本、监管口径或考核指标数据；搜索结果全部来自中航成飞2025年年度报告摘要，属公司披露文件，不含政策类内容。", "date": "", "isSupplementary": true}, {"id": "fact_af975870", "title": "中航成飞2025年年度报告摘要中，在“近三年主要会计数据和财务指标”部分列示了“公司是否需追溯调整或重述以前年度会计数据”选项，并注明追溯调整或重述原因为“同一...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要中，在“近三年主要会计数据和财务指标”部分列示了“公司是否需追溯调整或重述以前年度会计数据”选项，并注明追溯调整或重述原因为“同一控制下企业合并”；搜索结果片段未给出追溯调整的具体会计数据数值。", "date": "", "isSupplementary": true}]}}

