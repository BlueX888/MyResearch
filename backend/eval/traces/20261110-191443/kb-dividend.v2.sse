data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:14:54.926700", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "公司概况与利润分配背景", "description": "梳理中航成飞主营业务、控股股东、上市平台定位及2025年度利润分配预案披露背景。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025年度 利润分配预案 公告"]}, {"id": "sec_2", "title": "2025年度经营与盈利基础", "description": "分析2025年度营业收入、净利润、未分配利润、经营性现金流等对分红能力的支撑。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025年年报 净利润 未分配利润 经营现金流"]}, {"id": "sec_3", "title": "历史分红与同行业比较", "description": "对比公司历年现金分红比例、分红连续性及军工主机厂或航空装备同行利润分配情况。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 历年 分红 现金分红比例 军工主机厂 分红"]}, {"id": "sec_4", "title": "监管政策与公司治理", "description": "分析现金分红监管要求、国企市值管理考核及公司治理对2025年度利润分配预案的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["上市公司 现金分红 监管政策 国企 市值管理 中航成飞"]}, {"id": "sec_5", "title": "预案内容与市场影响", "description": "核验2025年度利润分配预案的具体分配方式、每股派息、分红总额、占净利润比例及市场反应。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025年度 利润分配 每10股 派息 分红总额"]}, {"id": "sec_6", "title": "未来分红趋势展望", "description": "结合订单、产能、资本开支和股东回报规划，判断公司未来分红政策的连续性与提升空间。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 股东回报规划 分红政策 未来 资本开支"]}], "research_questions": ["中航成飞2025年度利润分配预案的具体内容是什么？", "该预案的现金分红比例、分红总额及占净利润比例如何？", "支撑该预案的2025年度盈利、现金流和未分配利润基础是什么？"]}}

