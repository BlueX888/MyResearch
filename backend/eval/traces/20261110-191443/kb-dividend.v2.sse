data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:19:16.490701", "content": {"results": [{"id": "fact_d3df521a", "title": "中航成飞2025年年度报告摘要披露，汉中汉航机电有限公司、汉中航空工业（集团）有限公司和中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司；未...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，汉中汉航机电有限公司、汉中航空工业（集团）有限公司和中国航空科技工业股份有限公司的实际控制人同为中国航空工业集团有限公司；未知其他股东之间是否存在关联关系或属于一致行动人。", "date": "", "isSupplementary": false}, {"id": "fact_3bdba61c", "title": "中航成飞2025年年度报告摘要（公告编号2026-009，证券代码302132）披露的利润分配预案片段显示：派发现金红利3.86元（含税），送红股0股（含税），...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞2025年年度报告摘要（公告编号2026-009，证券代码302132）披露的利润分配预案片段显示：派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股；片段未完整显示现金红利对应的‘每10股’前缀，需以年报全文核对。", "date": "", "isSupplementary": false}, {"id": "fact_3d514ff5", "title": "年报摘要显示，董事会决议通过的本报告期优先股利润分配预案为‘不适用’。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "年报摘要显示，董事会决议通过的本报告期优先股利润分配预案为‘不适用’。", "date": "", "isSupplementary": false}, {"id": "fact_6678aa50", "title": "中国航空工业集团有限公司为国有法人股东，持有中航成飞78.66%股份，对应2,101,738,612股。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中国航空工业集团有限公司为国有法人股东，持有中航成飞78.66%股份，对应2,101,738,612股。", "date": "", "isSupplementary": false}, {"id": "fact_7162da54", "title": "本次搜索结果片段未出现中航成飞2025年度‘经营活动产生的现金流量净额’的具体数值，无法据此验证经营性现金流对分红能力的支撑。", "source": "本次搜索结果（本地知识库片段）", "url": "", "snippet": "本次搜索结果片段未出现中航成飞2025年度‘经营活动产生的现金流量净额’的具体数值，无法据此验证经营性现金流对分红能力的支撑。", "date": "", "isSupplementary": false}, {"id": "fact_75b238f5", "title": "中航成飞2025年年度报告摘要披露，2025年度利润分配预案为：每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，2025年度利润分配预案为：每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": false}, {"id": "fact_5d704715", "title": "搜索结果片段未披露中航成飞总股本和现金分红总额，因此无法直接验证按每10股派3.86元计算的2025年度现金分红总额。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "搜索结果片段未披露中航成飞总股本和现金分红总额，因此无法直接验证按每10股派3.86元计算的2025年度现金分红总额。", "date": "", "isSupplementary": false}, {"id": "fact_4741d1f6", "title": "中航成飞控股股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612股。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞控股股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612股。", "date": "", "isSupplementary": false}, {"id": "fact_4533e6f2", "title": "中航成飞股票代码为302132，股票简称为中航成飞，上市交易所为深圳证券交易所；2025年年度报告摘要公告编号为2026-009。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞股票代码为302132，股票简称为中航成飞，上市交易所为深圳证券交易所；2025年年度报告摘要公告编号为2026-009。", "date": "", "isSupplementary": false}, {"id": "fact_65853339", "title": "中航成飞2025年年度报告摘要显示，公司证券代码为302132，证券简称为中航成飞，公告编号为2026-009。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，公司证券代码为302132，证券简称为中航成飞，公告编号为2026-009。", "date": "", "isSupplementary": false}, {"id": "fact_7f45d0ac", "title": "中航成飞董事会决议通过的本报告期优先股利润分配预案为不适用。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞董事会决议通过的本报告期优先股利润分配预案为不适用。", "date": "", "isSupplementary": false}, {"id": "fact_3710eece", "title": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_639c2020", "title": "中航成飞股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612.00股。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612.00股。", "date": "", "isSupplementary": false}, {"id": "fact_26df86df", "title": "中航成飞股东汉中汉航机电有限公司持股比例为5.75%，汉中航空工业（集团）有限公司持股比例为5.29%。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞股东汉中汉航机电有限公司持股比例为5.75%，汉中航空工业（集团）有限公司持股比例