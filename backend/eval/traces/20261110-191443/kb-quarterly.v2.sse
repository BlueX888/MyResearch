data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:33:53.204873", "content": {"results": [{"id": "fact_66f0da29", "title": "中航成飞2025年年度报告摘要公告编号为2026-009，报告期为2025年年度。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要公告编号为2026-009，报告期为2025年年度。", "date": "", "isSupplementary": false}, {"id": "fact_074ad602", "title": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_64105cbb", "title": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年度利润分配预案为每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": false}, {"id": "fact_7827ff2a", "title": "截至2025年末，中国航空工业集团有限公司持有中航成飞78.66%股份，为国有法人控股股东。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "截至2025年末，中国航空工业集团有限公司持有中航成飞78.66%股份，为国有法人控股股东。", "date": "", "isSupplementary": false}, {"id": "fact_6613e287", "title": "截至2025年末，汉中汉航机电有限公司持有中航成飞5.75%股份，汉中航空工业（集团）有限公司持有5.29%股份。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "截至2025年末，汉中汉航机电有限公司持有中航成飞5.75%股份，汉中航空工业（集团）有限公司持有5.29%股份。", "date": "", "isSupplementary": false}, {"id": "fact_37c214f4", "title": "本次搜索结果中的年度报告摘要片段未包含2025年分季度营业收入数据，无法据此判断2025年各季度营业收入分布及最高季度。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "本次搜索结果中的年度报告摘要片段未包含2025年分季度营业收入数据，无法据此判断2025年各季度营业收入分布及最高季度。", "date": "", "isSupplementary": false}, {"id": "fact_e52e6d8c", "title": "中航成飞2025年年度报告摘要披露，公司主营业务为航空产品研发、制造、销售、维修与服务保障。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，公司主营业务为航空产品研发、制造、销售、维修与服务保障。", "date": "", "isSupplementary": true}, {"id": "fact_b9082504", "title": "中航成飞2025年年度报告摘要披露，公司主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，公司主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": true}, {"id": "fact_8347b30e", "title": "中航成飞2025年年报“分季度主要会计数据”披露：第一季度营业收入3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年报“分季度主要会计数据”披露：第一季度营业收入3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度27,072,785,205.73元。第三季度营业收入最高。", "date": "", "isSupplementary": true}, {"id": "fact_6003abcc", "title": "中航成飞2025年年报“分季度主要会计数据”同时披露：第一季度归属于上市公司股东的净利润156,494,308.41元，第二季度756,329,709.24元，...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年年报“分季度主要会计数据”同时披露：第一季度归属于上市公司股东的净利润156,494,308.41元，第二季度756,329,709.24元，第三季度1,256,306,602.29元，第四季度1,263,159,232.02元。", "date": "", "isSupplementary": true}, {"id": "fact_e5152906", "title": "年报披露2025年全年营业收入为75,358,958,001.86元。将分季度营业收入加总：3,308,640,285.35 + 17,393,488,964....", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "年报披露2025年全年营业收入为75,358,958,001.86元。将分季度营业收入加总：3,308,640,285.35 + 17,393,488,964.30 + 27,584,043,546.48 + 27,072,785,205.73 = 75,358,958,001.86元，与全年营业收入完全一致，可确认分季度数据来源可靠。", "date": "", "isSupplementary": true}, {"id": "fact_9fa02252", "title": "中航成飞股份有限公司2025年年度报告摘要显示，公司股票简称为中航成飞，股票代码302132，在深圳证券交易所上市；董事会秘书为肖峰，证券事务代表为解晗，办公地...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞股份有限公司2025年年度报告摘要显示，公司股票简称为中航成飞，股票代码302132，在深圳证券交易所上市；董事会秘书为肖峰，证券事务代表为解晗，办公地址为四川省成都市青羊区黄田坝纬一路88号，电子信箱为cac-ir@avic.com。", "date": "", "isSupplementary": true}, {"id": "fact_f699ee22", "title": "大信会计师事务所（特殊普通合伙）对公司2025年度财务报告出具了标准无保留意见的审计报告；公司因同一控制下企业合并对以前年度会计数据进行了追溯调整或重述。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对公司2025年度财务报告出具了标准无保留意见的审计报告；公司因同一控制下企业合并对以前年度会计数据进行了追溯调整或重述。", "date": "", "isSupplementary": true}, {"id": "fact_dac597a4", "title": "公司控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%（153,597,730股...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "公司控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%（153,597,730股），汉中航空工业（集团）有限公司持股5.29%（141,442,953股），上述股东实际控制人均为中国航空工业集团有限公司。", "date": "", "isSupplementary": true}, {"id": "fact_c63f3c82", "title": "CF-2025-ANNUAL-SUMMARY.pdf披露2025年分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,96...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "CF-2025-ANNUAL-SUMMARY.pdf披露2025年分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度27,072,785,205.73元。该数据呈现明显的“前低后高”且第三季度见顶的特征，但属于2025年数据，并非2023/2024年重述后分季度数据。", "date": "", "isSupplementary": true}, {"id": "fact_d0ce0aeb", "title": "CF-2025-ANNUAL-SUMMARY.pdf披露2024年调整后营业收入约为65,054,925,10X.XX元（原文截断），调整前营业收入为1,779...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "CF-2025-ANNUAL-SUMMARY.pdf披露2024年调整后营业收入约为65,054,925,10X.XX元（原文截断），调整前营业收入为1,779,761,710.30元；但未提供2024年分季度营业收入数据，无法据此验证2024年各季度分布。", "date": "", "isSupplementary": true}, {"id": "fact_1bf82081", "title": "本次搜索结果中未找到2023年、2024年分季度营业收入数据（重述后口径），仅有2025年分季度数据及2024年年度调整后营业收入（部分截断），因此无法直接验证...", "source": "搜索结果汇总", "url": "", "snippet": "本次搜索结果中未找到2023年、2024年分季度营业收入数据（重述后口径），仅有2025年分季度数据及2024年年度调整后营业收入（部分截断），因此无法直接验证“前低后高”季节性是否为2023/2024年常态，也无法判断2025年“Q3见顶”是否异常。", "date": "", "isSupplementary": true}, {"id": "fact_540c7f88", "title": "中航成飞2025年年度报告摘要披露了2025年分季度主要会计数据，其中营业收入分别为：第一季度3,308,640,285.35元，第二季度17,393,488,...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要披露了2025年分季度主要会计数据，其中营业收入分别为：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度27,072,785,205.73元；第三季度营业收入最高。", "date": "", "isSupplementary": true}, {"id": "fact_45860a97", "title": "中航成飞2025年年度报告摘要中提及追溯调整或重述以前年度会计数据，追溯调整或重述原因为同一控制下企业合并。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要中提及追溯调整或重述以前年度会计数据，追溯调整或重述原因为同一控制下企业合并。", "date": "", "isSupplementary": true}, {"id": "fact_5e3ae0b4", "title": "本次搜索结果仅提供了中航成飞2025年分季度营业收入数据，未提供2024年、2023年分季度营业收入的重述后数据。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "本次搜索结果仅提供了中航成飞2025年分季度营业收入数据，未提供2024年、2023年分季度营业收入的重述后数据。", "date": "", "isSupplementary": true}]}}

