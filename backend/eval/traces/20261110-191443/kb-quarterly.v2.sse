data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:25:34.206414", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述航空装备制造行业市场规模、增速及军机主机厂营收季节性特征，重点梳理中航成飞2025年各季度营业收入规模、占比和同比变化。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 一季度 营业收入;中航成飞 2025 半年报 营业收入;中航成飞 2025 三季报 营业收入;中航成飞 2025 年报 分季度 营收"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述军机主机厂竞争格局、主要企业和中航成飞在歼击机等航空装备领域的地位，分析订单份额与交付节奏对季度营收分布的影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 军机 主机厂 竞争格局;成飞 歼-20 产能 交付;航空工业 主机厂 营收 对比;中航成飞 订单 交付 节奏"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述航空装备智能制造、数字化装配、脉动生产线等核心技术趋势，分析技术升级和产能建设如何影响中航成飞产品交付与季度收入确认。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空装备 智能制造 脉动生产线;成飞 数字化 装配 技术;军机 批产 交付 节奏;中航成飞 产能 建设 2025"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、装备采购政策、军品定价机制和税收政策等外部因素，分析其对中航成飞2025年收入确认时点和季度分布的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["2025 国防预算 装备采购;军工 定价机制 增值税 政策;航空工业 政策 2025;军品 收入 确认 政策"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述中航成飞在交付节奏、供应链配套、产能利用和收入确认方面的挑战与机遇，判断哪些因素可能导致季度营收前低后高或Q4集中。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 交付 节奏 供应链;成飞 产能 瓶颈 机遇;军工 季度 收入 确认 季节性;中航成飞 2025 营收 波动 原因"]}, {"id": "sec_6", "title": "未来展望", "description": "描述中航成飞2025年全年营收趋势及季度分布判断，综合财报数据、交付节奏和政策环境，给出哪个季度营业收入最高的结论及依据。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 全年 营收 预测;成飞 2025 季度 营收 分布;军机 主机厂 季度 收入 趋势;中航成飞 2025 Q4 营收"]}], "research_questions": ["中航成飞2025年各季度营业收入分别是多少，各季度占比如何？", "中航成飞2025年营业收入最高的季度是哪个季度，主要原因是什么？", "交付节奏、收入确认政策、国防预算和供应链因素如何影响中航成飞2025年季度营收分布？"]}}

