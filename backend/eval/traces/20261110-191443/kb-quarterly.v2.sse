data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:29:41.184423", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'], 'Revenue': [33.09, 173.93, 275.84, 270.73]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Quarter':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\ndf['Share'] = df['Revenue'] / df['Revenue'].sum() * 100\ntop = df.loc[df['Revenue'].idxmax()]\nprint(df)\nprint('全年合计(亿元):', round(df['Revenue'].sum(), 2))\nprint('最高季度:', top['Quarter'], round(top['Revenue'], 2), '亿元, 占比', round(top['Share'], 2), '%')\nprint('下半年占比:', round(df['Share'].iloc[2:].sum(), 2), '%')\ncolors = ['#c7d2fe', '#818cf8', '#10b981', '#06b6d4']\nplt.figure(figsize=(12, 7), dpi=200)\nbars = plt.bar(df['Quarter'], df['Revenue'], color=colors, width=0.6, edgecolor='white')\nfor b, v, s in zip(bars, df['Revenue'], df['Share']):\n    plt.text(b.get_x() + b.get_width() / 2, v + 5, f'{v:.2f}亿元\\n{s:.2f}%', ha='center', fontsize=12, fontweight='bold', color='#1f2937')\nplt.title('中航成飞2025年各季度营业收入分布', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 320)\nplt.grid(True, axis='y', linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "提取2025年四个季度的营业收入（单位统一为亿元），计算各季度占比与全年合计，识别营收最高的季度，并用柱状图直观展示季度分布，突出最高季度（Q3）。"}}

