data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:29:50.962503", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'quarter': ['第一季度', '第二季度', '第三季度'], 'revenue': [3308640285.35, 17393488964.30, 27584043546.48]}\ndf = pd.DataFrame(data)\ndf['revenue_yi'] = df['revenue'] / 100000000\nplt.figure(figsize=(12, 7), dpi=200)\nx = df['quarter']\ny = df['revenue_yi']\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='#ffffff', markeredgewidth=2.5, markeredgecolor='#6366f1', label='单季营业收入')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 8, f'{v:.2f}亿元', ha='center', va='bottom', fontsize=12, fontweight='bold', color='#4338ca')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, max(y) * 1.18)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left', frameon=False)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

