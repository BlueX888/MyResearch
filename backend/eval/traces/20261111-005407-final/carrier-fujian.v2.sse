data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T22:45:36.741944", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "梳理中国舰载战斗机需求规模、增速及航母编队建设节奏，分析福建舰进度与沈飞舰载机采购、交付节奏之间的关联，估算舰载机市场空间与需求释放窗口。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["福建舰 海试 服役 进度 舰载机 需求 沈飞 歼-15 歼-35 市场规模"]}, {"id": "sec_2", "title": "竞争格局", "description": "分析舰载战斗机总装、核心配套及系统供应商格局，重点说明沈飞在舰载机总装领域的地位，以及与成飞、洪都等企业在型号、配套和技术路线上的竞争协作关系。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["沈飞 舰载机 歼-15 歼-35 福建舰 竞争格局 总装 配套 企业"]}, {"id": "sec_3", "title": "技术趋势", "description": "分析福建舰电磁弹射对舰载机结构、起落架、飞控和着舰系统提出的新要求，跟踪弹射型舰载机、隐身舰载机、折叠翼及有人无人协同等核心技术趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["福建舰 电磁弹射 舰载机 歼-35 歼-15T 技术 弹射起飞 隐身 着舰"]}, {"id": "sec_4", "title": "政策环境", "description": "梳理国防预算、海军装备建设规划、航母建设与军工采购相关政策，分析政策节奏和预算投入对福建舰进度及沈飞舰载机需求释放的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 海军装备 航母 舰载机 采购 政策 十四五 福建舰"]}, {"id": "sec_5", "title": "挑战机遇", "description": "识别福建舰进度不确定性、型号定型、产能爬坡和供应链约束等挑战，同时分析航母编队扩编、弹射型舰载机换装和新型号上舰带来的需求机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["福建舰 进度 风险 舰载机 产能 供应链 沈飞 机遇 换装"]}, {"id": "sec_6", "title": "未来展望", "description": "展望福建舰服役后形成战斗力的节奏，判断舰载机需求从陆基训练向舰载部署、从歼-15系列向歼-35等新型号演进的方向，并分析多航母编队建设对沈飞舰载机长期需求的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["福建舰 服役 形成战斗力 舰载机 需求 预测 歼-35 上舰 多航母"]}], "research_questions": ["福建舰海试、服役和形成战斗力节点如何量化影响沈飞舰载机订单与交付节奏？", "福建舰电磁弹射适配是否会使沈飞产品结构向歼-35等新型号倾斜，其产能和供应链准备是否匹配？", "国防预算与海军装备政策变化如何调节福建舰进度对沈飞舰载机需求的传导效应？"]}}

