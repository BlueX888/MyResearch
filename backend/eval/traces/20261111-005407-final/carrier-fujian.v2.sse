data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:54:29.689050", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'机型': ['歼-15T', '歼-35', '歼-15D'], '搭载量': [24, 24, 3]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['搭载量'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='搭载量（架）')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 0.9, str(v) + ' 架', ha='center', fontsize=11, fontweight='bold', color='#312e81')\nplt.xticks(x, df['机型'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('舰载机机型', fontsize=14)\nplt.ylabel('搭载量（架）', fontsize=14)\nplt.ylim(0, max(y) * 1.25)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper right')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

