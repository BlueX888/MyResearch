data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T22:47:32.721666", "content": {"results": [{"id": "sr_74793c", "title": "福建舰正式入列,整只编队集体交付_网易视频", "source": "网易", "url": "https://m.163.com/v/video/VRD3EL2BF.html", "snippet": "福建舰正式入列,整只编队集体交付\n福建舰正式入列,整只编队集体交付\n声明:个人原创,仅供参考\n打开网易新闻\n体验效果更佳", "date": "2025-11-10T18:10:44+08:00"}, {"id": "sr_6a2dee", "title": "中国人民海军福建舰正式入列_网易视频", "source": "网易", "url": "https://m.163.com/v/video/VRCRK7OO5.html", "snippet": "中国人民海军福建舰正式入列\n中国人民海军福建舰正式入列\n声明:个人原创,仅供参考\n打开网易新闻\n体验效果更佳", "date": "2025-11-07T17:14:25+08:00"}, {"id": "sr_71102e", "title": "福建 舰官宣正式入 列,来自苑举正教授和晓娇的观察 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/video/7569863759439741491/", "snippet": "展开福建\n舰官宣正式入\n列,来自苑举正教授和晓娇的观察。播放\n44发布于\n2025-11-07\n14:17", "date": "2025-11-07T14:17:00+08:00"}, {"id": "sr_8fa0c5", "title": "官宣!福建舰入列 ---安徽全民国防教育网", "source": "安徽新闻网", "url": "https://gfjy.ahnews.com.cn/rdtp/con/2025-11/07/3617_1597314.html", "snippet": "官宣!福建舰入列\n来源:\n央视军事\n2025-11-07\n17:30:38\n责编:\n吕中石\n我国第一艘电磁弹射型航空母舰福建舰入列,授旗仪式5日在海南三亚某军港举行。航母福建舰入列!激动人心,骄傲转发!点赞人民海军,祝福伟大祖国!监制丨刘一鸣主编丨徐蕾莹视觉设计丨游佳编辑丨陶露", "date": "2025-11-07T17:30:38+08:00"}, {"id": "sr_57de94", "title": "福建舰今日正式交接入列 #福建舰 #福建舰入列 #祖国强大 #航母 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/video/7569923135639470643/", "snippet": "展开福建舰今日正式交接入列\n#福建舰\n#福建舰入列\n#祖国强大\n#航母播放\n727发布于\n2025-11-07\n18:08", "date": "2025-11-07T18:08:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

