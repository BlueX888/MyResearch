data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T22:47:41.131955", "content": {"results": [{"id": "sr_94f6c4", "title": "福建舰,入列!舷号为“18”", "source": "新闻中心", "url": "https://news.hangzhou.com.cn/shxw/content/2025-11/07/content_9119427.htm", "snippet": "福建舰,入列!舷号为“18”\n杭州网\n发布时间:2025-11-07\n16:26\n(原标题:福建舰,入列!舷号为“18”)\nhttps://wan-hzwcm.hzyun.com.cn/\n9119427\n2", "date": "2025-11-07T00:00:00+08:00"}, {"id": "sr_4fcaf1", "title": "骄傲转发!今天福建舰下水4周年 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7652161953711800878/", "snippet": "2022年6月17日,我国第三艘航空母舰下水,命名为“中国人民解放军海军福建舰”,舷号为“18”。今天是福建舰下水4周年,转发!祝福!来源:解放军报微博", "date": "2026-06-17T08:56:00+08:00"}, {"id": "sr_5f2e11", "title": "福建舰正式入列,舷号为“18” - 八一视频·中国军网", "source": "八一电视", "url": "http://tv.81.cn/bysp/16420356.html", "snippet": "福建舰正式入列,舷号为“18”\n来源:中国军网八一视频\n作者:刘福生\n编辑:刘福生\n责编:刘福生\n发布:2025-11-07\n14:32:13", "date": "2025-11-07T00:00:00+08:00"}, {"id": "sr_aa3935", "title": "俯拍视角看福建舰下水_@所有人_澎湃新闻-The Paper", "source": "澎湃新闻", "url": "https://www.thepaper.cn/newsDetail_forward_18617734", "snippet": "据人民海军,我国第三艘航空母舰下水命名仪式在中国船舶集团有限公司江南造船厂举行。我国第三艘航空母舰命名为“中国人民解放军海军福建舰”,舷号为“18”。 澎湃新闻编辑 高嘉莹 素材来源 人民海军 责任编辑: 李蕊 校对: 张亮亮 收藏", "date": "2022-06-17T14:51:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

