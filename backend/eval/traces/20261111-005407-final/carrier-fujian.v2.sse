data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T22:54:05.472506", "content": {"charts": [{"id": "chart_001", "title": "福建舰舰载机搭载构成（估计）", "subtitle": "总数约73架，沈飞机型占比约70%", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}: {c}架 ({d}%)"}, "legend": {"orient": "vertical", "left": "left", "top": "middle", "textStyle": {"color": "#666"}}, "series": [{"type": "pie", "radius": ["40%", "70%"], "center": ["60%", "50%"], "avoidLabelOverlap": true, "itemStyle": {"borderRadius": 4, "borderColor": "#fff", "borderWidth": 2}, "label": {"show": true, "formatter": "{b}\n{c}架 ({d}%)", "color": "#333"}, "data": [{"value": 24, "name": "歼-15T", "itemStyle": {"color": "#1677ff"}}, {"value": 24, "name": "歼-35", "itemStyle": {"color": "#722ed1"}}, {"value": 3, "name": "歼-15D", "itemStyle": {"color": "#fa8c16"}}, {"value": 22, "name": "其他机型", "itemStyle": {"color": "#d9d9d9"}}]}]}}, {"id": "chart_002", "title": "沈飞舰载机在福建舰的需求分布", "subtitle": "基于自媒体估计，沈飞机型合计51架", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "20%", "right": "15%", "top": "10%", "bottom": "10%"}, "xAxis": {"type": "value", "show": false, "max": 30}, "yAxis": {"type": "category", "data": ["歼-15T", "歼-35", "歼-15D", "其他机型"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 24, "itemStyle": {"color": "#1677ff"}}, {"value": 24, "itemStyle": {"color": "#722ed1"}}, {"value": 3, "itemStyle": {"color": "#fa8c16"}}, {"value": 22, "itemStyle": {"color": "#d9d9d9"}}], "barWidth": 16, "label": {"show": true, "position": "right", "formatter": "{c}架", "color": "#666"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}, {"id": "chart_003", "title": "福建舰舰载机弹射进度", "subtitle": "2025年9月22日完成3型舰载机弹射/着舰", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2022", "2025"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "name": "完成弹射型号数（型）", "min": 0, "max": 4, "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "line", "data": [0, 3], "smooth": true, "symbol": "circle", "symbolSize": 10, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}, "label": {"show": true, "position": "top", "formatter": "{c}型", "color": "#1677ff"}, "markPoint": {"data": [{"type": "max", "name": "首次弹射", "value": "2025-09-22"}]}}]}}]}}

