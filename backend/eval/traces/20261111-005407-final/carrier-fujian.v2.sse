data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:54:23.262452", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata1 = {'型号': ['歼-15T', '歼-35', '歼-15D', '其他'], '数量': [24, 24, 3, 22]}\ndf1 = pd.DataFrame(data1)\ndf1['数量'] = pd.to_numeric(df1['数量'], errors='coerce')\ndf1 = df1.dropna()\ndata2 = {'年份': [2025, 2026, 2027], '产能': [15, 60, 100]}\ndf2 = pd.DataFrame(data2)\ndf2['产能'] = pd.to_numeric(df2['产能'], errors='coerce')\ndf2 = df2.dropna()\nratio = 24 / 73 * 100\ncoverage = 100 / 24\nprint(f'歼-35占福建舰舰载机比例: {ratio:.1f}%')\nprint(f'2027年产能可覆盖福建舰歼-35配置的倍数: {coverage:.2f}倍')\nplt.figure(figsize=(12, 7), dpi=200)\nax1 = plt.subplot(1, 2, 1)\nbars = ax1.bar(df1['型号'], df1['数量'], color=['#6366f1', '#06b6d4', '#10b981', '#f59e0b'])\nax1.set_title('福建舰舰载机需求构成（73架）', fontsize=14, fontweight='bold')\nax1.set_ylabel('数量（架）', fontsize=12)\nfor b in bars:\n    ax1.text(b.get_x() + b.get_width() / 2, b.get_height() + 0.5, int(b.get_height()), ha='center', fontsize=11)\nax2 = plt.subplot(1, 2, 2)\nax2.plot(df2['年份'], df2['产能'], linewidth=2.5, marker='o', markersize=8, color='#6366f1')\nax2.fill_between(df2['年份'], df2['产能'], alpha=0.15, color='#6366f1')\nax2.set_title('歼-35产能爬坡（架）', fontsize=14, fontweight='bold')\nax2.set_xlabel('年份', fontsize=12)\nax2.set_ylabel('数量（架）', fontsize=12)\nfor x, y in zip(df2['年份'], df2['产能']):\n    ax2.text(x, y + 3, f'{y}', ha='center', fontsize=11)\nplt.suptitle('福建舰进度驱动沈飞舰载机需求与产能', fontsize=18, fontweight='bold', y=1.02)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "选取福建舰舰载机需求构成（歼-15T、歼-35、歼-15D、其他）与歼-35产能爬坡关键节点（2025双位数取15架、2026累计>60架、2027年产能100架/年），计算歼-35占福建舰舰载机比例及2027年产能对单舰歼-35需求的覆盖倍数，生成双面板组合图展示需求结构与产能爬坡趋势。"}}

