data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T22:45:37.032237", "content": {"results": [{"id": "sr_f9b858", "title": "福建舰搭载歼-35等多型舰载机,电磁弹射技术实现重大突破", "source": "网易新闻客户端", "url": "https://c.m.163.com/news/v/VX98F9CDF.html", "snippet": "福建舰搭载歼-35等多型舰载机,电磁弹射技术实现重大突破声明:个人原创,仅供参考\n福建舰实现电磁弹射有何重大意义", "date": "2025-09-25T03:11:00+08:00", "isLocal": false}, {"id": "sr_95d961", "title": "福建舰电磁弹射现场(视频+高清大图)", "source": "网易新闻客户端", "url": "https://c.m.163.com/news/a/KA3770BU0530M570.html?spss=sps_sem", "snippet": "歼-15T、歼-35、空警-600三型舰载机在福建舰首次成功阻拦着舰和弹射起飞,标志着福建舰具备了电磁弹射和回收能力,这是我国航母发展历程中取得的又一次突破,对推进海军转型建设具有里程碑意义。请跟随记者的镜头,一睹福建舰弹射舰载机的壮观场景——利剑出击!多角度看歼-35弹射起飞海军三型舰载机成功在福建舰起降,训练细节曝光海军三型舰载机如何弹射起飞?沉浸式感受福建舰上的“弹,弹,弹”\n来源:新华社、央视新闻、人民海军", "date": "2025-09-22T19:26:00+08:00", "isLocal": false}, {"id": "sr_345799", "title": "歼-35等完成在福建舰上弹射起飞-网易新闻", "source": "网易", "url": "https://m.163.com/touch/cm/news/search?spsc=sps&spss=sps_sem&redirect=1&keyword=%E6%AD%BC-35%E7%AD%89%E5%AE%8C%E6%88%90%E5%9C%A8%E7%A6%8F%E5%BB%BA%E8%88%B0%E4%B8%8A%E5%BC%B9%E5%B0%84%E8%B5%B7%E9%A3%9E", "snippet": "重大突破!歼-15T、歼-35和空警-600三型舰载机,在福建舰完成起降训练,福建舰具备电磁弹射和回收能力\n新京报政事儿14小时前32跟贴", "date": "2025-09-23T08:36:05+08:00", "isLocal": false}, {"id": "sr_c3b838", "title": "一起感受舰载机弹射起飞“首秀”震撼瞬间_军事频道_中华网", "source": "中华网军事", "url": "https://military.china.com/photo/13004178/20250923/48848597.html", "snippet": "歼-15T、歼-35、空警-600三型舰载机在福建舰首次成功阻拦着舰和弹射起飞,标志着福建舰具备了电磁弹射和回收能力,这是我国航母发展历程中取得的又一次突破,对推进海军转型建设具有里程碑意义。请跟随记者的镜头,一睹福建舰弹射舰载机的壮观场景——福建舰官兵在转运歼-35舰载战斗机。李唐摄歼-15T舰载战斗机在海军福建舰电磁弹射起飞。这是起飞助理做出放飞手势。李唐摄歼-15T舰载战斗机在海军福建舰电磁弹射起飞。这是战机离舰瞬间。李唐摄", "date": "2025-09-23T10:12:08+08:00", "isLocal": false}, {"id": "sr_7ff0f3", "title": "福建舰电磁弹射藏着啥物理知识?_军事频道_中华网", "source": "中华网军事", "url": "https://military.china.com/news/13004177/20251029/48947015_1.html", "snippet": "歼-35舰载战斗机在福建舰上电磁弹射起飞前,重量板操作员向飞行员核对弹射重量。歼-15T舰载战斗机在福建舰阻拦着舰。歼-35舰载战斗机在福建舰上开展触舰复飞训练。", "date": "2025-10-29T11:32:15+08:00", "isLocal": false}], "isIncremental": true, "searchType": "web"}}

