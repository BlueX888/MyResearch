data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T22:45:59.659470", "content": {"graph": {"nodes": [{"id": "node_0", "name": "福建舰（003型航空母舰）", "type": "technology", "discovered_at": "2026-11-10T22:45:59.659297"}, {"id": "node_1", "name": "歼-35", "type": "technology", "discovered_at": "2026-11-10T22:45:59.659336"}, {"id": "node_2", "name": "歼-15T", "type": "technology", "discovered_at": "2026-11-10T22:45:59.659346"}, {"id": "node_3", "name": "空警-600", "type": "technology", "discovered_at": "2026-11-10T22:45:59.659355"}, {"id": "node_4", "name": "沈飞（沈阳飞机工业集团/中航沈飞）", "type": "company", "discovered_at": "2026-11-10T22:45:59.659361"}, {"id": "node_5", "name": "人民海军", "type": "policy", "discovered_at": "2026-11-10T22:45:59.659369"}, {"id": "node_6", "name": "电磁弹射系统（EMALS）", "type": "technology", "discovered_at": "2026-11-10T22:45:59.659376"}], "edges": [{"source": "福建舰（003型航空母舰）", "relation": "电磁弹射与回收能力已验证", "discovered_at": "2026-11-10T22:45:59.659301"}, {"source": "福建舰（003型航空母舰）", "relation": "搭载歼-15T/歼-35/空警-600", "discovered_at": "2026-11-10T22:45:59.659331"}, {"source": "福建舰（003型航空母舰）", "relation": "与沈飞舰载机需求相关", "discovered_at": "2026-11-10T22:45:59.659333"}, {"source": "歼-35", "relation": "隐身舰载战斗机", "discovered_at": "2026-11-10T22:45:59.659339"}, {"source": "歼-35", "relation": "在福建舰完成电磁弹射起飞", "discovered_at": "2026-11-10T22:45:59.659341"}, {"source": "歼-35", "relation": "沈飞研制（需核实公开表述）", "discovered_at": "2026-11-10T22:45:59.659343"}, {"source": "歼-15T", "relation": "弹射型舰载战斗机", "discovered_at": "2026-11-10T22:45:59.659348"}, {"source": "歼-15T", "relation": "在福建舰完成电磁弹射起飞", "discovered_at": "2026-11-10T22:45:59.659350"}, {"source": "歼-15T", "relation": "歼-15系列衍生型号", "discovered_at": "2026-11-10T22:45:59.659352"}, {"source": "空警-600", "relation": "固定翼舰载预警机", "discovered_at": "2026-11-10T22:45:59.659357"}, {"source": "空警-600", "relation": "在福建舰完成弹射起降", "discovered_at": "2026-11-10T22:45:59.659358"}, {"source": "沈飞（沈阳飞机工业集团/中航沈飞）", "relation": "歼-15系列与歼-35研制生产方（需核实）", "discovered_at": "2026-11-10T22:45:59.659364"}, {"source": "沈飞（沈阳飞机工业集团/中航沈飞）", "relation": "舰载机需求承接主体", "discovered_at": "2026-11-10T22:45:59.659366"}, {"source": "人民海军", "relation": "福建舰列装使用方", "discovered_at": "2026-11-10T22:45:59.659372"}, {"source": "人民海军", "relation": "航母转型建设主体", "discovered_at": "2026-11-10T22:45:59.659374"}, {"source": "电磁弹射系统（EMALS）", "relation": "对舰载机结构、起落架、飞控提出新要求", "discovered_at": "2026-11-10T22:45:59.659379"}, {"source": "电磁弹射系统（EMALS）", "relation": "福建舰核心能力", "discovered_at": "2026-11-10T22:45:59.659381"}]}, "stats": {"entitiesCount": 7, "relationsCount": 17}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T22:45:59.659582", "content": {"agent": "DeepScout", "section": "技术趋势", "facts_count": 7, "duplicates_removed": 0, "data_points_count": 6, "insights": ["搜索结果高度同质化：10条结果中至少7条为同一份新华社/央视/人民海军通稿的多平台转载，事件本身（2025-09-22三型机首次弹射起降）真实性高，但信息增量极低。", "技术趋势层面证据充分：福建舰已同时验证“弹射化”（歼-15T）与“隐身化”（歼-35）两条舰载机升级路径，并纳入固定翼预警机空警-600，构成完整弹射型舰载机体系，直接支撑本章节“技术趋势”论述。", "传导链条的关键缺口在于“航母进度→沈飞订单”的中间环节：现有证据只覆盖航母端（能力验证完成），完全缺失装备端（定型、批产、采购、交付）数据，h_1 的因果强度无法量化。"], "source_quality": "整体来源质量中等偏上但结构失衡。事件核心事实由新华网、央视新闻、人民海军等央媒首发（可信度0.85-0.9），经中华网、凤凰网、网易等平台转载（0.7-0.75），事实可信度高；但10条结果中约7条为同一通稿的重复转载，信息冗余严重，缺乏独立信源与深度分析。两条自媒体来源（网易个人原创0.3、新浪自媒体0.35、B站0.4）仅可作线索，不可作为论据。最关键的问题是：全部结果均为军事事件报道，完全没有产业侧（券商研报、公司公告、采购公告）与政策侧（预算文件、装备规划）来源，导致研究假设 h_1、h_3 所需的订单、交付、预算类证据完全缺位，本章节若要论证“福建舰进度→沈飞需求”的传导机制，必须补充产业与财务数据源。", "hypothesis_updates": 3, "search_results": [{"title": "福建舰搭载歼-35等多型舰载机,电磁弹射技术实现重大突破", "url": "https://c.m.163.com/news/v/VX98F9CDF.html", "source": "网易新闻客户端", "snippet": "福建舰搭载歼-35等多型舰载机,电磁弹射技术实现重大突破声明:个人原创,仅供参考\n福建舰实现电磁弹射有何重大意义", "date": "2025-09-25T03:11:00+08:00"}, {"title": "福建舰电磁弹射现场(视频+高清大图)", "url": "https://c.m.163.com/news/a/KA3770BU0530M570.html?spss=sps_sem", "source": "网易新闻客户端", "snippet": "歼-15T、歼-35、空警-600三型舰载机在福建舰首次成功阻拦着舰和弹射起飞,标志着福建舰具备了电磁弹射和回收能力,这是我国航母发展历程中取得的又一次突破,对推进海军转型建设具有里程碑意义。请跟随记者的镜头,一睹福建舰弹射舰载机的壮观场景——利剑出击!多角度看歼-35弹射起飞海军三型舰载机成功在福建舰起降,训练细节曝光海军三型舰载机如何弹射起飞?沉浸式感受福建舰上的“弹,弹,弹”\n来源:新华社、央视新闻、人民海军", "date": "2025-09-22T19:26:00+08:00"}, {"title": "歼-35等完成在福建舰上弹射起飞-网易新闻", "url": "https://m.163.com/touch/cm/news/search?spsc=sps&spss=sps_sem&redirect=1&keyword=%E6%AD%BC-35%E7%AD%89%E5%AE%8C%E6%88%90%E5%9C%A8%E7%A6%8F%E5%BB%BA%E8%88%B0%E4%B8%8A%E5%BC%B9%E5%B0%84%E8%B5%B7%E9%A3%9E", "source": "网易", "snippet": "重大突破!歼-15T、歼-35和空警-600三型舰载机,在福建舰完成起降训练,福建舰具备电磁弹射和回收能力\n新京报政事儿14小时前32跟贴", "date": "2025-09-23T08:36:05+08:00"}, {"title": "一起感受舰载机弹射起飞“首秀”震撼瞬间_军事频道_中华网", "url": "https://military.china.com/photo/13004178/20250923/48848597.html", "source": "中华网军事", "snippet": "歼-15T、歼-35、空警-600三型舰载机在福建舰首次成功阻拦着舰和弹射起飞,标志着福建舰具备了电磁弹射和回收能力,这是我国航母发展历程中取得的又一次突破,对推进海军转型建设具有里程碑意义。请跟随记者的镜头,一睹福建舰弹射舰载机的壮观场景——福建舰官兵在转运歼-35舰载战斗机。李唐摄歼-15T舰载战斗机在海军福建舰电磁弹射起飞。这是起飞助理做出放飞手势。李唐摄歼-15T舰载战斗机在海军福建舰电磁弹射起飞。这是战机离舰瞬间。李唐摄", "date": "2025-09-23T10:12:08+08:00"}, {"title": "福建舰电磁弹射藏着啥物理知识?_军事频道_中华网", "url": "https://military.china.com/news/13004177/20251029/48947015_1.html", "source": "中华网军事", "snippet": "歼-35舰载战斗机在福建舰上电磁弹射起飞前,重量板操作员向飞行员核对弹射重量。歼-15T舰载战斗机在福建舰阻拦着舰。歼-35舰载战斗机在福建舰上开展触舰复飞训练。", "date": "2025-10-29T11:32:15+08:00"}, {"title": "航母style练起来!歼-35的那种→_哔哩哔哩_bilibili", "url": "https://www.bilibili.com/video/BV1ehnwzaEXf/?spm_id_from=333.40138.feed-card.all.click", "source": "哔哩哔哩", "snippet": "近日,三型舰载机在福建舰成功起降,标志着福建舰具备电磁弹射和回收能力。看我国新一代隐身战斗机歼-35在福建舰上弹射起飞!(记者孙晨旭\n程嘉豪\n李一叶\n洪俊卿\n李欣桐\n姬翔\n李达\n张翔楠景\n李明熹\n视频编辑:伊凯新)", "date": "2025-09-22T18:46:02+08:00"}, {"title": "舰载机弹射起飞“首秀”高清大图 福建舰里程碑式突破_新闻频道_中华网", "url": "https://news.china.com/socialgd/10000169/20250922/48847070.html", "source": "中华网新闻频道", "snippet": "歼-15T、歼-35和空警-600三型舰载机在福建舰上首次成功完成了阻拦着舰和弹射起飞,这标志着福建舰具备了电磁弹射和回收能力。这一成就在我国航母发展史上具有重要意义,对推进海军转型建设起到了关键作用。通过镜头,人们可以见证福建舰弹射舰载机的壮观景象。", "date": "2025-09-22T18:27:01+08:00"}, {"title": "一起感受舰载机弹射起飞“首秀”震撼瞬间_凤凰网", "url": "https://mil.ifeng.com/c/8msRdgoFOM3", "source": "凤凰网", "snippet": "歼-15T、歼-35、空警-600三型舰载机在福建舰首次成功阻拦着舰和弹射起飞,标志着福建舰具备了电磁弹射和回收能力,这是我国航母发展历程中取得的又一次突破,对推进海军转型建设具有里程碑意义。", "date": "2025-09-23T10:46:00+08:00"}, {"title": "福建舰弹射高清大图-新华网", "url": "https://www.news.cn/milpro/20250922/f739da1d35b54ea793b9b15681f48a13/c.html", "source": "新华网", "snippet": "歼-15T、歼-35、空警-600三型舰载机在福建舰首次成功阻拦着舰和弹射起飞,标志着福建舰具备了电磁弹射和回收能力,这是我国航母发展历程中取得的又一次突破,对推进海军转型建设具有里程碑意义。请跟随记者的镜头,一睹福建舰弹射舰载机的壮观场景——福建舰弹射画面公开。蔡年迟\n张懋瑄\n王力飞\n|\n编辑:马宁\n石爽\n|\n校对:杜玉洁)", "date": "2025-09-22T00:00:00+08:00"}, {"title": "歼15T电子战战机在福建舰上电磁弹射起飞|福建省|电子战_新浪新闻", "url": "https://k.sina.com.cn/article_3769804445_me0b2a69d03301fh1u.html?from=mil", "source": "新浪网", "snippet": "歼15T电子战战机在福建舰上电磁弹射起飞\n歼15T电子战战机在福建舰上电磁弹射起飞\n特别声明:以上文章内容仅代表作者本人观点,不代表新浪网观点或立场。如有关于作品内容、版权或其它问题请于作品发表后的30日内与新浪网联系。", "date": "2025-06-28T08:00:00+08:00"}], "extracted_facts": [{"content": "2025年9月22日，歼-15T、歼-35、空警-600三型舰载机在福建舰首次成功完成阻拦着舰和弹射起飞，标志福建舰已具备电磁弹射和回收能力，被称为中国航母发展历程中的又一次突破，对推进海军转型建设具有里程碑意义。", "source_name": "新华网（军事频道）", "source_url": "https://www.news.cn/milpro/20250922/f739da1d35b54ea793b9b15681f48a13/c.html", "credibility": 0.9}, {"content": "歼-35隐身舰载战斗机在福建舰上完成电磁弹射起飞，并进行了触舰复飞训练；弹射前重量板操作员与飞行员核对弹射重量，显示弹射流程已进入实操验证阶段。", "source_name": "中华网军事（转载新华社/央视画面）", "source_url": "https://military.china.com/news/13004177/20251029/48947015_1.html", "credibility": 0.75}, {"content": "歼-15T弹射型舰载战斗机在福建舰完成电磁弹射起飞与阻拦着舰，起飞助理做出放飞手势，战机离舰瞬间画面公开，表明歼-15系列已衍生出适配电磁弹射的弹射型（歼-15T）。", "source_name": "中华网军事", "source_url": "https://military.china.com/photo/13004178/20250923/48848597.html", "credibility": 0.75}, {"content": "空警-600固定翼舰载预警机在福建舰完成首次阻拦着舰和弹射起飞，与歼-15T、歼-35共同构成福建舰首批完成起降验证的舰载机体系（含预警机、隐身战斗机、多用途战斗机）。", "source_name": "凤凰网军事（转载新华社）", "source_url": "https://mil.ifeng.com/c/8msRdgoFOM3", "credibility": 0.7}, {"content": "网易新闻客户端于2025年9月25日发布标题为《福建舰搭载歼-35等多型舰载机，电磁弹射技术实现重大突破》的文章，但文内标注为“个人原创，仅供参考”，无独立信源与数据支撑。", "source_name": "网易新闻客户端", "source_url": "https://c.m.163.com/news/v/VX98F9CDF.html", "credibility": 0.3}, {"content": "新浪网2025年6月28日刊文称“歼15T电子战战机在福建舰上电磁弹射起飞”，并附免责声明“仅代表作者本人观点”，属自媒体性质，早于9月官方通稿，具体型号（歼-15D/歼-15T电子战型）与时间节点需核实。", "source_name": "新浪网（自媒体号）", "source_url": "https://k.sina.com.cn/article_3769804445_me0b2a69d03301fh1u.html?from=mil", "credibility": 0.35}, {"content": "B站视频报道称“三型舰载机在福建舰成功起降，标志福建舰具备电磁弹射和回收能力”，记者署名包含孙晨旭、程嘉豪等，属对官方通稿的视频化转述。", "source_name": "哔哩哔哩", "source_url": "https://www.bilibili.com/video/BV1ehnwzaEXf/?spm_id_from=333.40138.feed-card.all.click", "credibility": 0.4}], "data_points": [{"name": "完成弹射/着舰的舰载机型号数", "value": "3", "unit": "型", "year": 2025, "source": "新华网（军事频道）"}, {"name": "福建舰首次舰载机弹射起降日期", "value": "2025-09-22", "unit": "日期", "year": 2025, "source": "新华网（军事频道）"}, {"name": "歼-35在福建舰完成弹射起飞", "value": "是", "unit": "布尔", "year": 2025, "source": "中华网军事（转载新华社/央视画面）"}, {"name": "歼-15T完成电磁弹射起飞", "value": "是", "unit": "布尔", "year": 2025, "source": "中华网军事"}, {"name": "福建舰完成起降的机型构成", "value": "歼-15T/歼-35/空警-600", "unit": "型号", "year": 2025, "source": "凤凰网军事（转载新华社）"}, {"name": "歼-15T电子战型在福建舰弹射起飞（待核实）", "value": "2025-06-28", "unit": "日期", "year": 2025, "source": "新浪网（自媒体号）"}]}}

