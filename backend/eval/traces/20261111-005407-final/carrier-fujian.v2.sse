data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T22:48:15.233660", "content": {"results": [{"id": "sr_e42a1d", "title": "重磅!福建舰今天海试_肖勇利_人民海军_试验", "source": "搜狐", "url": "https://www.sohu.com/a/775563876_121107000", "snippet": "人民海军快讯: 中国海军福建舰今天上午出海开展首次航行试验。 记者:王祉陈运鹏 主管:海军政治工作部 主办:海政宣传文化中心报社 监制:张庆宝 编审 : 肖勇利 编辑:高泽明", "date": "2024-05-01T08:09:00+08:00"}, {"id": "sr_c2ce8d", "title": "重磅!福建舰今天海试_腾讯新闻", "source": "腾讯网", "url": "https://new.qq.com/rain/a/20240501A018RE00", "snippet": "人民海军快讯: 中国海军福建舰今天上午出海开展首次航行试验。 记者:王祉 陈运鹏 主管:海军政治工作部 主办:海政宣传文化中心报社 监制:张庆宝 编审 : 肖勇利 编辑:高泽明", "date": "2024-05-01T08:09:00+08:00"}, {"id": "sr_3b3285", "title": "重磅消息!福建舰终于服役了!_网易视频", "source": "网易", "url": "https://m.163.com/v/video/VZCREMCP5.html", "snippet": "重磅消息!福建舰终于服役了!\n重磅消息!福建舰终于服役了!\n声明:个人原创,仅供参考\n打开网易新闻\n体验效果更佳", "date": "2025-11-07T15:37:32+08:00"}, {"id": "sr_adf2a9", "title": "福建舰正式服役,这哥们讲的太有意思了 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/video/7571315478196290111/", "snippet": "展开福建舰正式服役,这哥们讲的太有意思了。播放\n266发布于\n2025-11-11\n12:11内容来源于站外视频", "date": "2025-11-11T12:11:00+08:00"}, {"id": "sr_9c77bf", "title": "快讯:航母福建舰海试_澎湃号·媒体_澎湃新闻-The Paper", "source": "澎湃新闻", "url": "https://www.thepaper.cn/newsDetail_forward_27238675", "snippet": "中国海军福建舰今天上午出海开展首次航行试验。 新华社报道截图 来源 | 新华社 原标题:《快讯:航母福建舰海试》 特别声明", "date": "2024-05-01T08:02:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

