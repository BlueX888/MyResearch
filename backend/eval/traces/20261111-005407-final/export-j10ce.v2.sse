data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:34:29.314284", "content": {"results": [{"id": "fact_66e7ab7b", "title": "美国政府确认埃及将获得全额13亿美元军事援助，这是美国政府首次不扣留任何部分地提供这笔援助。", "source": "网易", "url": "", "snippet": "美国政府确认埃及将获得全额13亿美元军事援助，这是美国政府首次不扣留任何部分地提供这笔援助。", "date": "", "isSupplementary": true}, {"id": "fact_99b0af01", "title": "SIPRI数据显示，2015—2019年全球武器贸易比2010—2014年增长5.5%；中国占全球武器出口总量的5.8%，排名第4位。", "source": "今日头条", "url": "", "snippet": "SIPRI数据显示，2015—2019年全球武器贸易比2010—2014年增长5.5%；中国占全球武器出口总量的5.8%，排名第4位。", "date": "", "isSupplementary": true}, {"id": "fact_6c123f7d", "title": "SIPRI报告称，2016—2020年中国武器出口额较2011—2015年下降7.8%，占世界武器出口总额的5.2%，为全球第五大武器出口国。", "source": "环球时报", "url": "", "snippet": "SIPRI报告称，2016—2020年中国武器出口额较2011—2015年下降7.8%，占世界武器出口总额的5.2%，为全球第五大武器出口国。", "date": "", "isSupplementary": true}, {"id": "fact_f0069a3f", "title": "SIPRI报告指出，2015—2019年全球武器贸易规模比2010—2014年增长5.5%；美国第一、俄罗斯第二、法国第三，德国和中国分列第四和第五。", "source": "网易", "url": "", "snippet": "SIPRI报告指出，2015—2019年全球武器贸易规模比2010—2014年增长5.5%；美国第一、俄罗斯第二、法国第三，德国和中国分列第四和第五。", "date": "", "isSupplementary": true}, {"id": "fact_15a6f1c5", "title": "有报道称SIPRI报告显示，2019年中国武器出口额占世界军售总额的16%；该口径可能与SIPRI企业销售收入份额混淆，并非武器出口TIV份额。", "source": "今日头条", "url": "", "snippet": "有报道称SIPRI报告显示，2019年中国武器出口额占世界军售总额的16%；该口径可能与SIPRI企业销售收入份额混淆，并非武器出口TIV份额。", "date": "", "isSupplementary": true}, {"id": "fact_e01ad510", "title": "SIPRI报告称，2018—2019年中国公司武器出售收入增长4.8%；2019年中国企业销售收入占全球总销售额的16%，4家中国企业进入世界TOP-25武器销...", "source": "DailyEconomic", "url": "", "snippet": "SIPRI报告称，2018—2019年中国公司武器出售收入增长4.8%；2019年中国企业销售收入占全球总销售额的16%，4家中国企业进入世界TOP-25武器销售公司。", "date": "", "isSupplementary": true}, {"id": "fact_15c0ec02", "title": "SIPRI报告称，2014—2018年中国武器出口较5年前仅增加2.7%；2009—2013年中国武器购买国为41个，最近5年增至53个。", "source": "搜狐", "url": "", "snippet": "SIPRI报告称，2014—2018年中国武器出口较5年前仅增加2.7%；2009—2013年中国武器购买国为41个，最近5年增至53个。", "date": "", "isSupplementary": true}, {"id": "fact_218ed6ef", "title": "SIPRI数据显示，2013—2017年中国武器销售额5年内增长38%，占全球武器出口市场的5.7%。", "source": "凤凰网", "url": "", "snippet": "SIPRI数据显示，2013—2017年中国武器销售额5年内增长38%，占全球武器出口市场的5.7%。", "date": "", "isSupplementary": true}, {"id": "fact_8af41146", "title": "SIPRI报告称，2014—2018年国际军贸主要常规武器交易规模比2009—2013年增长7.8%，交易规模以SIPRI趋势指标TIV衡量。", "source": "行行查", "url": "", "snippet": "SIPRI报告称，2014—2018年国际军贸主要常规武器交易规模比2009—2013年增长7.8%，交易规模以SIPRI趋势指标TIV衡量。", "date": "", "isSupplementary": true}, {"id": "fact_b743c165", "title": "《中华人民共和国出口管制法》由第十三届全国人民代表大会常务委员会第二十二次会议于2020年10月17日通过，以中华人民共和国主席令第五十八号公布，自2020年1...", "source": "中国人大网", "url": "", "snippet": "《中华人民共和国出口管制法》由第十三届全国人民代表大会常务委员会第二十二次会议于2020年10月17日通过，以中华人民共和国主席令第五十八号公布，自2020年12月1日起施行。", "date": "", "isSupplementary": true}, {"id": "fact_a516247e", "title": "出口管制法适用于国家对两用物项、军品、核以及其他与维护国家安全和利益、履行防扩散等国际义务相关的货物、技术、服务等物项（统称管制物项）的出口管制；管制物项包括相...", "source": "贵州省市场监督管理局", "url": "https://amr.guizhou.gov.cn/zwgk/xxgkml/jcxxgk/zcfg/fl/202101/t20210112_66126132.html", "snippet": "出口管制法适用于国家对两用物项、军品、核以及其他与维护国家安全和利益、履行防扩散等国际义务相关的货物、技术、服务等物项（统称管制物项）的出口管制；管制物项包括相关技术资料等数据。", "date": "", "isSupplementary": true}, {"id": "fact_ba9bcfcb", "title": "该法界定“两用物项”为既有民事用途、又有军事用途或有助于提升军事潜力的货物、技术和服务，特别是可用于设计、开发、生产或使用大规模杀伤性武器及其运载工具的物项；“...", "source": "中国人大网", "url": "", "snippet": "该法界定“两用物项”为既有民事用途、又有军事用途或有助于提升军事潜力的货物、技术和服务，特别是可用于设计、开发、生产或使用大规模杀伤性武器及其运载工具的物项；“军品”指用于军事目的的装备、专用生产设备及其他相关货物、技术和服务。", "date": "", "isSupplementary": true}, {"id": "fact_25e218b7", "title": "出口管制法结构为五章：总则；管制政策、管制清单和管制措施（含一般规定、两用物项出口管理、军品出口管理三节）；监督管理；法律责任；附则。军品出口管理与两用物项出口...", "source": "四川省人民政府网站（四川省商务厅政策法规）", "url": "", "snippet": "出口管制法结构为五章：总则；管制政策、管制清单和管制措施（含一般规定、两用物项出口管理、军品出口管理三节）；监督管理；法律责任；附则。军品出口管理与两用物项出口管理分节设置，构成军贸出口（如歼-10CE类装备出口）的国内法律框架基础。", "date": "", "isSupplementary": true}, {"id": "fact_c06f5f95", "title": "该法确立国家实行统一的出口管制制度，通过制定管制清单、名录或目录并实施出口许可等方式进行管理；出口管制工作坚持总体国家安全观，统筹安全和发展。", "source": "人民网", "url": "", "snippet": "该法确立国家实行统一的出口管制制度，通过制定管制清单、名录或目录并实施出口许可等方式进行管理；出口管制工作坚持总体国家安全观，统筹安全和发展。", "date": "", "isSupplementary": true}, {"id": "fact_8c5acbbd", "title": "该法立法目的为维护国家安全和利益、履行防扩散等国际义务、加强和规范出口管制；出口管制指国家对从中国境内向境外转移管制物项，以及中国公民、法人和非法人组织向外国组...", "source": "道客巴巴（转载法律全文）", "url": "https://www.doc88.com/p-90659425487936.html", "snippet": "该法立法目的为维护国家安全和利益、履行防扩散等国际义务、加强和规范出口管制；出口管制指国家对从中国境内向境外转移管制物项，以及中国公民、法人和非法人组织向外国组织和个人提供管制物项，采取禁止或限制性措施。", "date": "", "isSupplementary": true}, {"id": "fact_225b82d9", "title": "据Fortune Business Insights，全球军用飞机（Military Aircraft）市场规模2018年为402.2亿美元，预计到2032年达...", "source": "Fortune Business Insights", "url": "https://www.fortunebusinessinsights.com/military-aircraft-market-102771", "snippet": "据Fortune Business Insights，全球军用飞机（Military Aircraft）市场规模2018年为402.2亿美元，预计到2032年达到857.9亿美元，主要驱动因素为威胁演变与地缘政治不稳定加剧。该口径为军用飞机整体（含固定翼、旋翼、运输、加油、海上巡逻等），并非单指战斗机。", "date": "", "isSupplementary": true}, {"id": "fact_50659e17", "title": "据QYR（恒州博智）统计与预测，2024年全球军用飞机市场销售额为594.8亿美元，预计2031年达到668.1亿美元，2025—2031年复合增长率（CAGR...", "source": "格隆汇（引用QYR恒州博智）", "url": "", "snippet": "据QYR（恒州博智）统计与预测，2024年全球军用飞机市场销售额为594.8亿美元，预计2031年达到668.1亿美元，2025—2031年复合增长率（CAGR）仅为1.7%，显著低于补充搜索关键词中假设的6.8%。", "date": "", "isSupplementary": true}, {"id": "fact_3596c333", "title": "QYR报告显示，全球军用飞机市场区域结构中北美为最大市场，约占22%份额，中国约占20%；主要生产商包括Lockheed Martin、AVIC（中航工业）、B...", "source": "格隆汇（引用QYR恒州博智）", "url": "", "snippet": "QYR报告显示，全球军用飞机市场区域结构中北美为最大市场，约占22%份额，中国约占20%；主要生产商包括Lockheed Martin、AVIC（中航工业）、Boeing、Airbus、United Aircraft Corporation、Mitsubishi Heavy Industries、Leonardo、Embraer、Kawasaki、Korea Aerospace Industrie", "date": "", "isSupplementary": true}, {"id": "fact_f5aca256", "title": "贝哲斯咨询数据涉及的是全球空中消防市场（2025年55.70亿美元，2025—2030年CAGR 4.08%），与战斗机/军用飞机市场口径无关，不能用于支撑战斗...", "source": "贝哲斯咨询", "url": "", "snippet": "贝哲斯咨询数据涉及的是全球空中消防市场（2025年55.70亿美元，2025—2030年CAGR 4.08%），与战斗机/军用飞机市场口径无关，不能用于支撑战斗机市场规模或增速判断。", "date": "", "isSupplementary": true}, {"id": "fact_4294a669", "title": "观研报告网《中国飞机行业现状深度调研与发展战略研究报告(2025-2032年)》指出全球飞机行业市场规模2020—2024年保持稳定增长、亚洲占比持续提升，但报...", "source": "观研报告网（行业数据网）", "url": "https://www.chinabaogao.com/baogao/202509/764768.html", "snippet": "观研报告网《中国飞机行业现状深度调研与发展战略研究报告(2025-2032年)》指出全球飞机行业市场规模2020—2024年保持稳定增长、亚洲占比持续提升，但报告正文关键数值以“**亿美元”“**%”占位符呈现，未披露可引用的具体规模与增速数据。", "date": "", "isSupplementary": true}]}}

