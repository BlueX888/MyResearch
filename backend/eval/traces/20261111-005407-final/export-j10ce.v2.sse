data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:20:16.516208", "content": {"results": [{"id": "sr_3dd949", "title": "6. International arms transfers  SIPRI", "source": "www.sipri.org", "url": "https://www.sipri.org/yearbook/2024/06", "snippet": "Contents Overview, Siemon T. Wezeman I. Global trends in arms transfers, 2019–23, Siemon T. Wezeman, Katarina Djokic, Mathew George, Zain Hussain and Pieter D. Wezeman II. Developments among the suppliers of major arms, 2019–23, Siemon T. Wezeman, Katarina Djokic, Mathew George, Zain Hussain and Pieter D. Wezeman III. Developments among the recipients of major arms, 2019–23, Siemon T. Wezeman, Katarina Djokic, Mathew George, Zain Hussain and Pieter D. Wezeman Click here Click here", "date": "2019-12-11T00:00:00+08:00"}, {"id": "sr_6dc143", "title": "SIPRI-案全观察-中国当前的核军控 - 道客巴巴", "source": "道客巴巴", "url": "https://www.doc88.com/p-4059176097896.html", "snippet": "下载积分: 50 内容提示: CHINA AND NUCLEAR ARMS CONTROL: CURRENT POSITIONS AND FUTURE POLICIESbates gill*SUMMARYw As the global nuclear arms control and non-proliferation agenda reaches a critical turning point, expectations will rise for China to take on a more proactive and constructive role. As an emerging global power, it will be more difficult for China to lay low or merely repeat long-standing declarations of principle. Moreover, the advent of more advanced conventional weapons, including missile defences and space-based wea... 文档格式:PDF | 页数:20 | 浏览次数:1 | CHINA AND NUCLEAR ARMS CONTROL: CURRENT POSITIONS AND FUTURE POLICIESbates gill*SUMMARYw As the global nuclear arms control and non-proliferation agenda reaches a critical turning point, expectations will rise for China to take on a more proa", "date": "2019-04-27T20:34:56+08:00"}, {"id": "sr_dfc7fe", "title": " 美国国防部-2019中国 军力报告(军事)(英文) - 道客巴巴 ", "source": "道客巴巴", "url": "https://www.doc88.com/p-3778460147230.html", "snippet": "Developments Involving the People’s Republic of China ANNUAL REPORT TO CONGRESS Military and Security Developments Involving the People’s Republic of China 2019 ...", "date": "2019-05-11T08:40:21+08:00"}, {"id": "sr_f343ba", "title": "Unlocking nuclear arms control in the time of the coronavirus disease 2019 (COVI", "source": "www.sipri.org", "url": "https://www.sipri.org/events/2020/SSC20-unlocking-nuclear-arms-control-coronavirus", "snippet": "The independent resource on global security SHARE SECTIONS", "date": "2019-01-01T00:00:00+08:00"}, {"id": "sr_6ce345", "title": "2020年_白皮书_中华人民共和国国务院新闻办公室", "source": "中国政府网", "url": "http://www.scio.gov.cn/zfbps/ndhf/2020n/", "snippet": "Full Text: China's Armed Forces: 30 Years of UN Peacekeeping Operations", "date": "2020-12-22T10:05:31+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:20:33.584039", "content": {"results": [{"id": "sr_0929a9", "title": "U.S. arms exports, by country 2023  Statista", "source": "Statista", "url": "https://www.statista.com/statistics/248552/us-arms-exports-by-country/", "snippet": "The statistic shows the U.S. total arms exports in 2023 expressed in TIV, by country. The TIV is based on the known unit production costs of a core set of weapons and is intended to represent the", "date": "2024-08-27T17:06:11+08:00"}, {"id": "sr_d9c6ce", "title": "韩国武器销售额_历年数据_聚汇数据", "source": "聚汇数据", "url": "https://www.gotohui.com/ndata/show-1453223", "snippet": "+ 添加到对比 折线图 条形图 保存图片 拖动时间范围: 1972 - 2023 韩国武器销售额 数据如下: 下载数据 未来预测数据 注:TIV是SIPRI用于衡量国际武器交易的价值,TIV代表 \"Trend-Indicator Value\"。 序号 时间(年) 数据(单位:百万TIV) 1 2023 2 2022 3 2021 4 2020 5 2019 6 2018 7 2017 702.", "date": "2023-12-11T00:00:00+08:00"}, {"id": "sr_c9e18b", "title": "Australia: arms exports 2022  Statista", "source": "Statista", "url": "https://www.statista.com/statistics/652577/australia-arms-exports/", "snippet": "In 2022, the trend-indicator-value of Australian arms exports totaled 33 million. The TIV is based on the known unit production costs of a core set of weapons and is intended to represent the transfer of military resources rather than the fe is only an indicator and does not correspond to the actual financial value of the transfers. Arms exports from Australia from 2011 to 2022 (in TIV expressed in millions) Loading statistic... Download for free More information To access this feature you need a Statista Account Already have an account? You need one of our Business Solutions to use this function Immediate access to statistics, forecasts & reports Usage and publication rights Download in various formats Already have an account?of major arms imports by the largest importers 2019-2023 Basic", "date": "2024-04-03T13:53:09+08:00"}, {"id": "sr_5d86e0", "title": "Trends in International Arms Transfers, 2023  SIPRI", "source": "Home Page", "url": "https://doi.org/10.55163/PBRP4239", "snippet": "We use cookies on this site to enhance your user experience By clicking any link on this page you are giving your consent for us to set cookies. No, give me more info The independent resource on global security March 2024 Stockholm SIPRI DOWNLOAD FULL PUBLICATION ABOUT THE AUTHOR(S)/EDITORS", "date": "2024-03-11T15:36:56+08:00"}, {"id": "sr_bb377a", "title": "美国武器销售额_历年数据_聚汇数据", "source": "聚汇数据", "url": "https://www.gotohui.com/ndata/show-1455171", "snippet": "+ 添加到对比 折线图 条形图 保存图片 拖动时间范围: 1950 - 2023 美国武器销售额 数据如下: 下载数据 未来预测数据 注:TIV是SIPRI用于衡量国际武器交易的价值,TIV代表 \"Trend-Indicator Value\"。 序号 时间(年) 数据(单位:亿TIV) 1 2023 2 2022 3 2021 4 2020 5 2019 6 2018 7 2017 114.00 8 2016 94.60 9 2015 98.70 10 2014 94.90 11 2013 76.90 12 2012 89.60 13 2011 90.20 14 2010 83.90 15 2009 71.90 16 2008 71.50 17 2007 79.60 18 2006 75.30 19 2005 67.40 20 2004 68.40 21 2003 56.40 22 2002 48.80 23 2001 56.00 24 2000 76.60 25 1999 115.00 26 1998 157.00 27 1997 145.00 28 1996 108.00 29 1995 112.00 30 1994 115.00 31 1993 138.00 32 1992 141.00 33 1991 125.00 34 1990 107.00 35 1989 113.00 36 1988 119.00 37 1987 122.00 38 1986 116.00 39 1985 108.00 40 1984 119.00 41 1983 139.00 42 1982 140.00 43 1981 136.00 44 1980 108.00 45 1979 99.10 46 1978 139.00 47 1977 146.00 48 1976 159.00 49 19", "date": "2024-08-09T07:46:11+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

