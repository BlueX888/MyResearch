data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:28:10.055255", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata1 = {'Year': [2024, 2025, 2029], 'Market': [975.2, 1057.1, 1377.5]}\ndf1 = pd.DataFrame(data1)\nfor col in df1.columns:\n    if col != 'Year':\n        df1[col] = pd.to_numeric(df1[col], errors='coerce')\ndf1 = df1.dropna()\ndata2 = {'Country': ['巴基斯坦', '埃及', '沙特', '印尼', '孟加拉国'], 'Orders': [36, 40, 40, 24, 20]}\ndf2 = pd.DataFrame(data2)\ndf2['Orders'] = pd.to_numeric(df2['Orders'], errors='coerce')\ndf2 = df2.dropna().sort_values('Orders')\ncagr = (df1['Market'].iloc[-1] / df1['Market'].iloc[0]) ** (1 / 5) - 1\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nax1.bar(df1['Year'].astype(str), df1['Market'], color='#6366f1', width=0.5)\nfor x, y in zip(df1['Year'].astype(str), df1['Market']):\n    ax1.text(x, y + 15, f'{y:.0f}', ha='center', fontsize=12, fontweight='bold')\nax1.set_title('全球战斗机市场规模趋势', fontsize=16, fontweight='bold', pad=15)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('市场规模（亿美元）', fontsize=14)\nax1.tick_params(labelsize=12)\nax1.grid(True, linestyle='--', alpha=0.3, axis='y')\nax2 = axes[1]\nax2.barh(df2['Country'], df2['Orders'], color='#06b6d4')\nfor y, x in zip(df2['Country'], df2['Orders']):\n    ax2.text(x + 0.8, y, f'{x}架', va='center', fontsize=12, fontweight='bold')\nax2.set_title('歼-10CE 主要潜在/已确认订单规模', fontsize=16, fontweight='bold', pad=15)\nax2.set_xlabel('订单数量（架）', fontsize=14)\nax2.tick_params(labelsize=12)\nax2.grid(True, linestyle='--', alpha=0.3, axis='x')\nplt.suptitle(f'歼-10CE 出口机遇：市场CAGR {cagr:.1%}，潜在订单超160架', fontsize=18, fontweight='bold', y=1.02)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦歼-10CE出口进展与成飞意义：①用全球战斗机市场规模（2024/2025/2029）刻画需求景气度并计算CAGR；②用主要潜在/已确认订单国规模（巴基斯坦36架、埃及40架、沙特40架、印尼24架、孟加拉国20架）展示出口天花板。双面板图：左柱状图+数值标签呈现市场扩容，右横向条形图呈现订单梯队，突出成飞在千亿美元级战机市场中的份额提升空间。"}}

