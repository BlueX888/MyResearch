, "name": "苏霍伊（苏-35/苏-57）", "type": "company", "discovered_at": "2026-11-10T23:19:57.314545"}, {"id": "node_18", "name": "韩国航空宇宙产业（KAI，FA-50）", "type": "company", "discovered_at": "2026-11-10T23:19:57.314556"}, {"id": "node_19", "name": "斯德哥尔摩国际和平研究所（SIPRI）", "type": "policy", "discovered_at": "2026-11-10T23:19:57.314570"}, {"id": "node_20", "name": "有源相控阵雷达（AESA）", "type": "technology", "discovered_at": "2026-11-10T23:19:57.314580"}, {"id": "node_21", "name": "一带一路倡议", "type": "policy", "discovered_at": "2026-11-10T23:19:57.314596"}], "edges": [{"source": "歼-10CE", "relation": "成飞研制", "discovered_at": "2026-11-10T23:19:56.709405"}, {"source": "歼-10CE", "relation": "出口型", "discovered_at": "2026-11-10T23:19:56.709407"}, {"source": "歼-10CE", "relation": "装备巴基斯坦空军", "discovered_at": "2026-11-10T23:19:56.709409"}, {"source": "歼-10CE", "relation": "配装AESA雷达与PL-15E", "discovered_at": "2026-11-10T23:19:56.709410"}, {"source": "成飞（成都飞机工业集团）", "relation": "歼-10CE研制方", "discovered_at": "2026-11-10T23:19:56.709414"}, {"source": "成飞（成都飞机工业集团）", "relation": "军贸出口主体（经中航技）", "discovered_at": "2026-11-10T23:19:56.709416"}, {"source": "中国航空技术进出口公司（中航技/CATIC）", "relation": "歼-10CE出口合同与交付执行方", "discovered_at": "2026-11-10T23:19:56.709420"}, {"source": "巴基斯坦空军", "relation": "歼-10CE首个海外用户", "discovered_at": "2026-11-10T23:19:56.709424"}, {"source": "巴基斯坦空军", "relation": "2025年印巴空战使用方", "discovered_at": "2026-11-10T23:19:56.709427"}, {"source": "PL-15E", "relation": "歼-10CE配套远程空空导弹", "discovered_at": "2026-11-10T23:19:56.709431"}, {"source": "PL-15E", "relation": "双脉冲发动机", "discovered_at": "2026-11-10T23:19:56.709433"}, {"source": "PL-15E", "relation": "数据链中段修正", "discovered_at": "2026-11-10T23:19:56.709435"}, {"source": "KLJ-10", "relation": "歼-10CE机载AESA雷达（自媒体称）", "discovered_at": "2026-11-10T23:19:56.709440"}, {"source": "Link-17数据链", "relation": "巴基斯坦空军体系", "discovered_at": "2026-11-10T23:19:56.709444"}, {"source": "Link-17数据链", "relation": "预警机-战斗机协同", "discovered_at": "2026-11-10T23:19:56.709446"}, {"source": "阵风（Rafale）", "relation": "印度空军装备", "discovered_at": "2026-11-10T23:19:56.709451"}, {"source": "阵风（Rafale）", "relation": "被指为歼-10CE/PL-15E交战对象", "discovered_at": "2026-11-10T23:19:56.709453"}, {"source": "阵风（Rafale）", "relation": "竞争机型", "discovered_at": "2026-11-10T23:19:56.709455"}, {"source": "F-16 Block 52 / F-16V", "relation": "竞争机型", "discovered_at": "2026-11-10T23:19:56.709460"}, {"source": "F-16 Block 52 / F-16V", "relation": "雷达性能对比基准", "discovered_at": "2026-11-10T23:19:56.709462"}, {"source": "《空军月刊》（AirForces Monthly）", "relation": "印巴空战细节披露来源", "discovered_at": "2026-11-10T23:19:56.709466"}, {"source": "央视（中国中央电视台）", "relation": "歼-10CE保障技术人员采访来源", "discovered_at": "2026-11-10T23:19:56.709471"}, {"source": "成都飞机工业（成飞）", "relation": "被贝哲斯报告列为全球战机主流企业", "discovered_at": "2026-11-10T23:19:57.314481"}, {"source": "成都飞机工业（成飞）", "relation": "歼-10CE研制生产方（待补充验证）", "discovered_at": "2026-11-10T23:19:57.314486"}, {"source": "巴基斯坦", "relation": "中国军贸最大客户", "discovered_at": "2026-11-10T23:19:57.314495"}, {"source": "巴基斯坦", "relation": "歼-10CE潜在/首个海外用户（待验证）", "discovered_at": "2026-11-10T23:19:57.314499"}, {"source": "达索航空（阵风）", "relation": "多用途战机主要竞争对手", "discovered_at": "2026-11-10T23:19:57.314508"}, {"source": "萨博（JAS-39鹰狮）", "relation": "中轻型战机直接竞争对手", "discovered_at": "2026-11-10T23:19:57.314517"}, {"source": "洛克希德·马丁（F-16/F-35）", "relation": "全球战机市场份额领先者", "discovered_at": "2026-11-10T23:19:57.314527"}, {"source": "洛克希德·马丁（F-16/F-35）", "relation": "F-16V为歼-10CE主要竞品", "discovered_at": "2026-11-10T23:19:57.314530"}, {"source": "欧洲战斗机公司（台风）", "relation": "多用途战机竞争对手", "discovered_at": "2026-11-10T23:19:57.314539"}, {"source": "苏霍伊（苏-35/苏-57）", "relation": "俄罗斯出口机型竞争对手", "discovered_at": "2026-11-10T23:19:57.314550"}, {"source": "韩国航空宇宙产业（KAI，FA-50）", "relation": "轻型战机出口竞争对手（搜索结果未直接提及，需补充）", "discovered_at": "2026-11-10T23:19:57.314564"}, {"source": "斯德哥尔摩国际和平研究所（SIPRI）", "relation": "全球军贸TIV数据权威来源", "discovered_at": "2026-11-10T23:19:57.314575"}, {"source": "有源相控阵雷达（AESA）", "relation": "战斗机技术迭代方向", "discovered_at": "2026-11-10T23:19:57.314585"}, {"source": "有源相控阵雷达（AESA）", "relation": "歼-10CE竞争力要素（待验证）", "discovered_at": "2026-11-10T23:19:57.314590"}, {"source": "一带一路倡议", "relation": "中国军贸客户拓展框架", "discovered_at": "2026-11-10T23:19:57.314601"}]}, "stats": {"entitiesCount": 22, "relationsCount": 37}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:19:57.314953", "content": {"agent": "DeepScout", "section": "市场概况", "facts_count": 8, "duplicates_removed": 0, "data_points_count": 19, "insights": ["全球战斗机市场处于中高速增长期（2025—2034年CAGR 6.8%），但增速主要由五代机（F-35、苏-57）与升级改装驱动，中轻型四代半战机（歼-10CE所处细分）的份额与增速需单独测算，现有结果未作拆分。", "军贸需求地理重心明显向亚非转移（前十大进口国八席为亚非国家，占37%），与中国军贸现有客户结构（巴基斯坦、泰国、阿尔及利亚、柬埔寨、刚果）高度重叠，为歼-10CE提供'存量客户升级+邻近市场扩散'的路径。", "中国军贸全球份额8.4%（2023年，24.32亿TIV），与美国39%差距显著，且被定位为'快速放量阶段'，意味着歼-10CE的边际贡献更可能体现在份额提升斜率而非绝对规模。"], "source_quality": "整体来源质量偏低至中等。仅未来智库《2024年军贸行业分析》（credibility 0.75）具备可追溯的权威数据基础（引用SIPRI TIV口径），可作为军贸规模与客户结构的主证据；安徽新闻网转引'外媒'的战斗机市场规模数据（0.6）缺乏原始出处，需回溯原始研究机构；贝哲斯、中智信投数据经搜狐、网易自媒体二次转引且关键数值被删减（0.3—0.4），仅可作参考；book118、豆丁网等文档为模板化行业报告（0.25—0.35），信息密度低、无实证数据；中国知网条目为2000年旧文，时效性失效；中商情报网无人机数据（0.6）与本议题仅弱相关。全部8条结果中无一条涉及歼-10CE机型本身，本章节证据链在'目标市场容量→歼-10CE可及市场'的转换环节存在明显断点，建议补充SIPRI原始数据库、券商深度报告（如中航证券、国盛军工）及成飞/中航技官方披露。", "hypothesis_updates": 3, "search_results": [{"title": "全球战斗机市场格局稳中有变 ---安徽全民国防教育网", "url": "https://gfjy.ahnews.com.cn/gfsp/con/2025-07/03/3613_1486722.html", "source": "安徽新闻网", "snippet": "法国“阵风”战斗机。土耳其“安卡”-3无人战斗机。印度“光辉”战斗机。瑞典JAS-39“鹰狮”战斗机。俄罗斯苏-57战斗机。在现代战争中,战斗机既是空中作战的核心平台,也是对地面目标实施突击的主要装备。其军事应用场景广泛,是各国国防力量建设的重点领域。近日,外媒对全球战斗机市场总体规模、技术发展方向、区域发展态势和企业竞争格局等情况进行分析。外媒预测,未来几年,全球战斗机市场规模将持续增长。规模持续增长外媒称,2024年,全球战斗机市场规模约975.2亿美元,2025年预计增长到1057.1亿美元,复合增长率达8.4%。预计2025年至2034年,全球战斗机市场规模将以6.8%的年均复合增长率持续扩张,2029年达到1377.5亿美元。外媒分析认为,全球战斗机市场规模增长主要由两大因素推动。军事技术迭代更新。未来几年,战斗机设计与机载系统技术革新将明显加速,更先进的雷达、隐身技术及电子战系统将被广泛应用。以F-35、苏-57为代表的第五代战斗机销量预计进一步增长。同时,人工智能与自主系统在战斗机领域的广泛应用,也将成为市场发展的新动力。国防投入持续增加。在地缘格局不断变化的背景下,美国、印度和部分欧洲国家持续增加国防开支,并升级现役作战平台。局部地区军事对抗和边境冲突,进一步凸显空军力量的战略价值。相关国家在新型战斗机采购、现役战斗机升级和维护上的投入将持续增加。市场空间广阔外媒分析认为,不同类型战斗机均有各自的市场空间。轻型战斗机凭借较好的机动性能与多元化功能特性,对国防预算相对有限或急需快速构建空战能力的国家具有较强吸引力。以F-16、JAS-39“鹰狮”为代表的轻型战斗机,以价格优势作为核心竞争策略,聚焦中小型国家市场,持续维系市场份额的稳定性。中型战斗机在敏捷性、作战半径及载荷能力等方面的综合效费比优势突出,成为国防预算中等、具有多场景作战需求国家的选择。这类战斗", "date": "2025-07-03T15:12:57+08:00"}, {"title": "未来10年世界战斗机市场分析与预测-《国际航空》2000年06期-中国知网", "url": "https://mall.cnki.net/magazine/Article/GJHK200006002.htm", "source": "中国知网", "snippet": "AnalysisandforscastofFighterMarketin10years未来10年,世界战斗机市场共将销售约2000架战斗机。市场份额有向欧洲偏斜的趋势。亚洲战斗机市场将成为世界战斗机制造商重要的竞争领域,其中当以已迅速从亚洲经济危机中复苏的东亚、东南亚地区,以及战火连年的阿拉伯地区为主据 (共4页)", "date": "2025-02-06T19:56:38+08:00"}, {"title": "2020-2025年中国轻型战机行业市场运行态势与投资战略咨询报告.docx-原创力文档", "url": "https://max.book118.com/html/2025/0120/8103112011007024.shtm", "source": "原创力文档", "snippet": "研究报告 PAGE 1- 2020-2025年中国轻型战机行业市场运行态势与投资战略咨询报告 一、市场概述 1.市场背景 (1)近年来,随着全球军事战略格局的调整,我国轻型战机市场迎来了快速发展的新机遇。国防现代化建设的推进和国家安全需求的增长,使得轻型战机在军事装备体系中的地位日益凸显。与此同时,我国国防工业的持续投入和技术创新,为轻型战机市场提供了强大的技术支撑。 (2)在国际市场上,我国轻型战机凭借其性能优良、价格合理等优势,逐渐赢得了国际客户的认可。尤其是在“一带一路”倡议的推动下,我国轻型战机出口业务取得了显著成果。此外,随着国内航空工业的快速发展,民用轻型战机市场需求也在不断增长,为市场注入了新的活力。 (3)在市场背景方面,我国轻型战机行业的发展还受到政策、经济、技术等多方面因素的影响。国家对于国防工业的重视,以及军民融合发展战略的提出,为轻型战机行业提供了良好的政策环境。同时,全球经济一体化的加深,也为我国轻型战机企业带来了更广阔的市场空间。在这一背景下,我国轻型战机行业有望实现持续、稳定的发展。 2.市场规模与增长趋势 (1)根据市场调研数据,近年来我国轻型战机市场规模呈现出稳定增长的趋势。随着国防现代化建设的加速推进,军队对轻型战机的需求不断上升,为市场提供了强有力的支撑。同时,民用航空市场的扩大,也为轻型战机市场带来了新的增长点。 (2)在市场规模方面,预计未来几年,我国轻型战机市场规模将继续保持高速增长。一方面,随着新型轻型战机的研发和投产,市场供应能力将进一步增强;另一方面,国际市场的拓展也将为我国轻型战机市场带来新的增长动力。此外,国家政策的扶持和产业结构的优化,也将促进市场规模的增长。 (3)在增长趋势方面,我国轻型战机市场有望实现年均复合增长率超过10%。随着技术的不断创新和产业升级,轻型战机的性能将得到进一步提升,市场竞争力将不断增强。同时", "date": "2025-01-21T09:04:46+08:00"}, {"title": "2021-2026年中国轻型战机行业市场全景调研及投资规划建议报告.docx-原创力文档", "url": "https://max.book118.com/html/2025/0119/8022062075007023.shtm", "source": "原创力文档", "snippet": "研究报告 PAGE 1- 2021-2026年中国轻型战机行业市场全景调研及投资规划建议报告 一、市场概述 1.市场背景分析 (1)中国轻型战机行业在近年来得到了快速的发展,这主要得益于国家军事现代化进程的加速以及国防需求的不断增长。随着国际形势的复杂多变,我国对国防力量的需求日益迫切,轻型战机作为空中作战力量的重要组成部分,其市场前景广阔。同时,随着我国经济的持续增长,国防预算的逐年增加,为轻型战机行业的发展提供了有力的资金保障。 (2)在市场背景方面,我国轻型战机行业的发展还受到国内外多方面因素的影响。国内方面,随着军事战略调整和现代化建设的推进,我国军队对轻型战机的需求不断上升,促使相关企业加大研发投入,提升产品性能。国际方面,全球轻型战机市场竞争激烈,我国企业通过引进国外先进技术,消化吸收再创新,逐步提升了自主创新能力,增强了在国际市场的竞争力。 (3)此外,国家政策的支持也是推动轻型战机行业发展的重要因素。近年来,我国政府出台了一系列政策,旨在促进国防科技工业的发展,为轻型战机行业提供了良好的政策环境。例如,《中国制造2025》明确提出要加快航空装备制造业的发展,提高国产航空装备的市场份额。这些政策的实施,为轻型战机行业的发展提供了有力保障,同时也为企业创造了巨大的市场机遇。 2.市场规模与增长趋势 (1)中国轻型战机市场规模在过去几年中呈现出稳步增长的趋势。根据市场调研数据显示,2016年至2020年间,我国轻型战机市场规模以年均复合增长率(CAGR)约8%的速度增长。随着国防预算的持续增加和军事现代化建设的深入,预计未来几年市场规模将继续扩大。 (2)从细分市场来看,军用轻型战机市场占据主导地位,其市场规模较大且增长稳定。随着我国军队对现代化装备需求的提升,军用轻型战机市场需求将持续增长。此外,民用轻型战机市场也展现出良好的增长潜力,随着通用航空市场的快速发展", "date": "2025-01-20T07:15:07+08:00"}, {"title": "全球与中国多用途战机市场价值分析及重点企业调研报告2024-2030飞机旋翼机spa固定翼电子战_网易订阅", "url": "https://www.163.com/dy/article/J43PJ1BT055671UV.html", "source": "网易", "snippet": "【内容部分有删减·详细可参中智信投研究网出版完整信息!】 全球与中国多用途战机市场价值分析及重点企业调研报告2024-2030年 2023年全球多用途战机市场规模大约为 百万美元,预计未来六年年复合增长率CAGR为%,到2030年达到 百万美元。 本文从全球视角下看多用途战机行业的整体发展现状及趋势。重点调研全球范围内多用途战机主要厂商及份额、主要市场(地区)及份额、产品主要分类及份额、以及主要下游应用及份额等。 本文包含的核心数据如下: 全球市场多用途战机总体收入,2019-2024,2025-2030(百万美元) 全球市场多用途战机总体销量,2019-2024,2025-2030(架) 全球市场多用途战机前五大厂商市场份额(2023年,按销量和按收入) 美国市场多用途战机规模为 百万美元(2023年),同期中国为 百万美元 全球市场多用途战机主要分类,其中固定翼飞机预计2030年达到 百万美元,未来六年CAGR为% 全球市场多用途战机主要应用,其中空中侦察预计2030年达到 百万美元,未来六年CAGR为% 全球市场多用途战机主要厂商有Dassault Aviation、Saab AB、Eurofighter Jagdflugzeug GmbH、The Boeing Company和Lockheed Martin Co入计,2023年前五大厂商共占有全球大约 的市场份额。 本文主要调研对象包括多用途战机生产商、行业专家、上游厂商、下游厂商及中间分销商等,调研信息涉及到多用途战机的销量(产量、出货量)、收入(产值)、需求、价格变动、产品规格型号、最新动态及未来规划、行业驱动因素、挑战、阻碍因素及风险等。 本文从如下各个角度进行细分,全面展示行业的整体及局部信息: 全球市场多用途战机主要分类,2019-2024,2025-2030(百万美元)&(架) 全球市场多用途战机主要分", "date": "2024-06-07T18:51:55+08:00"}, {"title": "中国轻型战机行业市场现状及未来发展趋势研究报告市场调研在线 - 豆丁网", "url": "https://www.docin.com/p-4714963037.html", "source": "豆丁网", "snippet": "1阅读 文档大小:425.83K 17页 北京博研传媒.. 上传于2024-08-28 格式:PDF 中国轻型战机行业市场现状及未来发展趋势研究报告 博研咨询&市场调研在线网北京博研智尚信息咨询有限公司中国轻型战机行业市场现状及未来发展趋势研究报告 中国轻型战机行业市场现状及未来发展趋势研究报告 正文目录 第一章、轻型战机行业定义3第二章、中国轻型战机行业综述4第三章、中国轻型战机行业产业链分析5第四章、中国轻型战机行业发展现状7第五章、中国轻型战机行业重点企业分析8第六章、中国轻型战机行业替代风险分析10第七章、中国轻型战机行业发展趋势分析11第八章、中国轻型战机行业发展建议13第九章、结论14 北京博研智尚信息咨询有限公司中国轻型战机行业市场现状及未来发展趋势研究报告 第一章、轻型战机行业定义 1.1行业概述 轻型战机是指设计用于执行多种空中任务,包括空对空作战、侦察、对地攻击等,且重量较轻、成本相对较低的一类战斗机。这类飞机通常具有较高的机动性和灵活性,能够在复杂的战场环境中执行多样化任务。 1.2技术特点 最大起飞重量,轻型战机的最大起飞重量一般在6,000至15,000千克之间。 飞行速度,最大飞行速度通常超过2马赫,约2,400公里/小时,。 航程,作战半径可达800至1,500公里。 武器装备,配备有空对空导弹、空对地导弹、炸弹等多种武器系统。 1.3市场规模与发展现状 全球市场规模,截至2022年底,全球轻型战机市场总价值约为350亿美元。 增长率,预计未来五年内,该市场的年复合增长率将达到4.5%。 主要生产国,美国、俄罗斯、中国、瑞典和法国是全球最主要的轻型战机生产和出口国。 需求分析,随着地区冲突频发及各国国防预算的增长,轻型战机的需求量持续上升。特别是在亚洲、中东和非洲地区,由于这些地区的国家倾向于采购性价比高的装备,因此轻型", "date": "2024-08-28T03:09:52+08:00"}, {"title": "2025年全球军用及民用无人机市场规模预测分析(图)-中商情报网", "url": "https://www.askci.com/news/chanye/20251121/092116276368807548835626.shtml", "source": "中商情报网", "snippet": "中商情报网讯:21世纪以来,无人机作战逐步成为现代战争、局部冲突的新作战方式和主要力量,军用无人机装备在世界范围内迅速扩散,已成为武器装备重点采购方向。中商产业研究院发布的《2025-2030年中国无人机行业市场调查及投资建议报告》显示,2024年全球军用无人机市场规模达到约122.03亿美元,较上年增长0.65%。中商产业研究院分析师预测,2025年全球军用无人机市场规模将达到135.43亿美元。\n数据来源:蒂尔集团、中商产业研究院整理\n民用无人机指非军事用途、由遥控或自主程序控制的不载人飞行器,分为消费级和工业级两大类。全球民用无人机市场正处于高速增长期,市场规模不断扩大。中商产业研究院发布的《2025-2030年中国无人机行业市场调查及投资建议报告》显示,全球民用无人机市场规模从2020年的961.20亿元增长至2024年的1938.33亿元,年均复合增长率达19.17%。中商产业研究院分析师预测,2025年全球民用无人机市场规模将达到2202.04亿元。\n数据来源:中商产业研究院整理\n更多资料请参考中商产业研究院发布的《2025-2030年中国无人机行业市场调查及投资建议报告》,同时中商产业研究院还提供产业大数据、产业情报、行业研究报告、行业白皮书、行业地位证明、可行性研究报告、产业规划、产业链招商图谱、产业招商指引、产业链招商考察&推介会、“十五五”规划等咨询服务。", "date": "2025-11-21T09:21:00+08:00"}, {"title": "2024年军贸行业分析：内外双驱开创军贸新格局，需求牵引带动三大装备加速放量", "url": "https://m.vzkoo.com/read/202502084df3149a21caf0a499dd168d.html", "source": "未来智库", "snippet": "2024年,全球军贸市场在国际局势变化和各国国力增强的双重驱动下,呈现出新的发展格局。本文将深入分析军贸行业的现状、市场规模、未来趋势和竞争格局,探讨先进装备、无人装备和消耗类装备在现代战争中的重要性及其市场前景。\n一:全球军贸市场现状及规模\n全球军贸市场在过去二十年中经历了显著的增长。根据斯德哥尔摩国际和平研究所的数据,2023年全球军贸市场规模达到291.04亿TIV(以生产单价为基础的武器交易规模指标),2000年至2023年期间,全球军贸市场规模的复合年增长率为1.70%。其中,美国稳居全球军贸出口第一大国,2023年美国军贸出口额占全球总军贸市场的39%。美国的主要客户包括乌克兰、日本、沙特阿拉伯、卡塔尔和波兰。\n从进口端来看,乌克兰在2023年成为全球最大的军贸进口国,占全球军贸市场的14%。亚非国家的军贸进口需求也非常旺盛,2023年全球前十大军贸进口国中,亚非国家占据了八个席位,进口额合计占全球总军贸市场的37%。乌克兰的军贸进口额在2021年至2023年间快速增长,2023年达到40.12亿TIV。\n中国的军贸市场也在快速发展。自上世纪90年代以来,中国军贸经历了四个阶段的发展,目前处于军贸装备快速放量阶段。2023年,中国的军贸出口额为24.32亿TIV,占全球军贸市场的8.4%。主要出口客户包括巴基斯坦、泰国、阿尔及利亚、柬埔寨和刚果等“一带一路”沿线国家。随着“一带一路”战略的推进,中国在中东、北非等地区的影响力逐步提升,未来有望进一步开发沙特、卡塔尔等潜在客户。\n二:国际局势变化和国力增强对军贸市场的影响\n国际局势的变化和各国国力的增强是推动全球军贸市场发展的两大重要因素。中东地区的局部冲突和高人均军费支出维持了军贸市场的活跃度。根据斯德哥尔摩国际和平研究所的数据,2023年全球军费占GDP比重前五的国家分别为乌克兰(36.65%)、黎巴嫩(8.9", "date": "2025-02-08T08:00:00+08:00"}, {"title": "战机市场报告（含行业规模、复合增长率及份额分析）", "url": "https://m.sohu.com/a/771000306_121825688/?pvid=000115_3w_a", "source": "手机搜狐网", "snippet": "据贝哲斯战机市场研究报告显示:全球战机市场规模2023年达4123.11亿元(人民币),2023年中国战机市场规模达x.x亿元。预计到 2029年全球战机市场规模将达到5221.28亿元,预测期间年均复合增长率为3.71%。\n按产品种类分类,战机行业可细分为固定翼, 旋转翼。 按终端应用分类,战机广泛应用于旋转翼, 旋转翼, 旋转翼, 旋转翼等领域。报告包括全球和中国各细分市场规模、供需情况、价格走势等关键数据,并结合当下热点,分析出最有发展潜力的细分市场。\n战机行业内的主流企业包含Airbus Defence and Space, Boeing, Chengdu Aircraft Industry, Dassault Aviation, HAL, KAI, Lockheed Martin, Russian Aircraft Corporation MiG, Saab, Shenyang Aircraft, Sukhoi。报告提供战机行业主要企业产品特点、主要经营数据指标及企业竞争力,并给出了2023年全球和中国排行前三企业市场份额占比。\n目录\n第一章 全球和中国战机行业概述\n1.1 战机行业简介\n1.1.1 战机行业定义及涵盖领域\n1.1.2 战机行业发展历史及经验\n1.1.3 战机行业发展标准\n1.2 战机行业发展生命周期\n1.2.1 战机行业所处生命周期\n1.2.2 战机行业成熟度分析\n1.3 全球和中国战机行业市场总体分析\n1.3.1 战机行业市场研发投入分析\n1.3.2 全球战机行业市场规模分析\n1.3.3 中国战机行业市场规模分析\n1.4 战机行业产品结构及主要产品类型介绍\n1.5 战机行业产业链分析\n1.5.1 上游供给对战机行业的影响\n1.5.2 下游需求对战机行业的影响\n1.5.3 战机行业下游客户分析\n第二章 国外及国内战机行业发展环境分析\n2.1 国外", "date": "2024-04-12T15:17:00+08:00"}], "extracted_facts": [{"content": "外媒分析称，2024年全球战斗机市场规模约975.2亿美元，2025年预计增至1057.1亿美元，复合增长率8.4%；2025—2034年将以6.8%的年均复合增长率扩张，2029年达到1377.5亿美元。增长动力来自军事技术迭代（先进雷达、隐身、电子战、AI与自主系统）和国防投入持续增加（美国、印度、部分欧洲国家增支并升级现役平台）。", "source_name": "安徽全民国防教育网（安徽新闻网）", "source_url": "https://gfjy.ahnews.com.cn/gfsp/con/2025-07/03/3613_1486722.html", "credibility": 0.6}, {"content": "据斯德哥尔摩国际和平研究所（SIPRI）数据，2023年全球军贸市场规模达291.04亿TIV，2000—2023年复合年增长率1.70%；美国占全球军贸出口39%，主要客户为乌克兰、日本、沙特、卡塔尔、波兰；2023年中国军贸出口额24.32亿TIV，占全球8.4%，主要客户为巴基斯坦、泰国、阿尔及利亚、柬埔寨、刚果等'一带一路'沿线国家。中国军贸目前处于'装备快速放量阶段'。", "source_name": "未来智库《2024年军贸行业分析》", "source_url": "https://m.vzkoo.com/read/202502084df3149a21caf0a499dd168d.html", "credibility": 0.75}, {"content": "2023年全球前十大军贸进口国中，亚非国家占八席，进口额合计占全球总军贸市场的37%；乌克兰2023年成为全球最大军贸进口国，占全球14%（40.12亿TIV）。表明军贸需求重心向亚洲、非洲及冲突地区集中。", "source_name": "未来智库《2024年军贸行业分析》", "source_url": "https://m.vzkoo.com/read/202502084df3149a21caf0a499dd168d.html", "credibility": 0.75}, {"content": "贝哲斯咨询报告称，2023年全球战机市场规模达4123.11亿元人民币，预计2029年达5221.28亿元，预测期年均复合增长率3.71%；报告将成都飞机工业（Chengdu Aircraft Industry）列为全球战机行业主流企业之一，与波音、洛马、达索、萨博、苏霍伊、沈飞等并列。", "source_name": "手机搜狐网（转引贝哲斯战机市场研究报告）", "source_url": "https://m.sohu.com/a/771000306_121825688/?pvid=000115_3w_a", "credibility": 0.4}, {"content": "行业报告对轻型战机的定义：最大起飞重量约6000—15000千克，最大飞行速度超过2马赫（约2400公里/小时），作战半径800—1500公里，可执行空对空作战、侦察、对地攻击等多任务，成本相对较低、机动灵活。该定义可作为界定歼-10CE所处细分市场（中轻型多用途战斗机）的参考。", "source_name": "豆丁网《中国轻型战机行业市场现状及未来发展趋势研究报告》", "source_url": "https://www.docin.com/p-4714963037.html", "credibility": 0.35}, {"content": "多用途战机全球主要厂商包括达索（阵风）、萨博（鹰狮）、欧洲战斗机公司（台风）、波音、洛马等，2023年前五大厂商占据全球约较大份额（原文份额数据被删减，未披露具体数值）。", "source_name": "网易订阅（转引中智信投《全球与中国多用途战机市场价值分析及重点企业调研报告2024-2030》）", "source_url": "https://www.163.com/dy/article/J43PJ1BT055671UV.html", "credibility": 0.3}, {"content": "中国轻型战机行业报告称，中国轻型战机凭借'性能优良、价格合理'优势逐步获得国际客户认可，在'一带一路'倡议推动下出口取得成果；但该类报告多为模板化市场研究，未提供具体机型、订单量或金额数据。", "source_name": "原创力文档《2020-2025年中国轻型战机行业市场运行态势与投资战略咨询报告》", "source_url": "https://max.book118.com/html/2025/0120/8103112011007024.shtm", "credibility": 0.25}, {"content": "2024年全球军用无人机市场规模约122.03亿美元，2025年预计135.43亿美元。该数据与战斗机市场无直接关系，但反映军贸装备结构向无人化倾斜，可能对有人战斗机（含中轻型战机）需求形成部分替代。", "source_name": "中商情报网", "source_url": "https://www.askci.com/news/chanye/20251121/092116276368807548835626.shtml", "credibility": 0.6}], "data_points": [{"name": "全球战斗机市场规模", "value": "975.2", "unit": "亿美元", "year": 2024, "source": "安徽全民国防教育网（安徽新闻网）"}, {"name": "全球战斗机市场规模", "value": "1057.1", "unit": "亿美元", "year": 2025, "source": "安徽全民国防教育网（安徽新闻网）"}, {"name": "全球战斗机市场规模预测", "value": "1377.5", "unit": "亿美元", "year": 2029, "source": "安徽全民国防教育网（安徽新闻网）"}, {"name": "2025-2034年均复合增长率", "value": "6.8", "unit": "%", "year": 2025, "source": "安徽全民国防教育网（安徽新闻网）"}, {"name": "全球军贸市场规模", "value": "291.04", "unit": "亿TIV", "year": 2023, "source": "未来智库《2024年军贸行业分析》"}, {"name": "全球军贸2000-2023复合增长率", "value": "1.70", "unit": "%", "year": 2023, "source": "未来智库《2024年军贸行业分析》"}, {"name": "美国军贸出口全球份额", "value": "39", "unit": "%", "year": 2023, "source": "未来智库《2024年军贸行业分析》"}, {"name": "中国军贸出口额", "value": "24.32", "unit": "亿TIV", "year": 2023, "source": "未来智库《2024年军贸行业分析》"}, {"name": "中国军贸全球份额", "value": "8.4", "unit": "%", "year": 2023, "source": "未来智库《2024年军贸行业分析》"}, {"name": "亚非国家在前十大进口国中进口额占比", "value": "37", "unit": "%", "year": 2023, "source": "未来智库《2024年军贸行业分析》"}]}}

data: {"type": "thought", "agent": "DeepScout", "timestamp": "2026-11-10T23:19:57.315039", "content": {"agent": "DeepScout", "content": "追溯原始数据源: SIPRI Arms Transfers Database 2023 TIV 中国 军贸 出口, 斯德哥尔摩国际和平研究所 2023 全球军贸 291.04 亿TIV"}}

data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:19:57.315115", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["SIPRI Arms Transfers Database 2023 TIV 中国 军贸 出口", "斯德哥尔摩国际和平研究所 2023 全球军贸 291.04 亿TIV"], "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:19:57.790887", "content": {"results": [{"id": "sr_b54fee", "title": "U.S. arms exports, by country 2023  Statista", "source": "Statista", "url": "https://www.statista.com/statistics/248552/us-arms-exports-by-country/", "snippet": "The statistic shows the U.S. total arms exports in 2023 expressed in TIV, by country. The TIV is based on the known unit production costs of a core set of weapons and is intended to represent the", "date": "2024-08-27T17:06:11+08:00"}, {"id": "sr_e08f89", "title": "2001一2022全球华贸规模自1871亿T1V增至335 - 行业研究数据 - 小牛行研", "source": "小牛行研", "url": "https://www.hangyan.co/charts/3433659109390419378", "snippet": "中国军贸出口规模逐步扩大,在全球军贸价值量中的占比逐步提升:1)规模整体增长:据SIPRI 数据,2014-2023 年,中国军贸价值量合计 166.87 亿TIV,较2004-2013 十年合计值 101.34TIV 增长 64.7%。2)近年来中国军贸出口规模增长明显:据SIPRI 数据,2020-2023 年中国军贸价值量自 7 亿TIV 增至 24.32TIV,CAGR 为51.5%。3)中国军贸出口规模占全球比例逐步提升:据SIPRI 数据,2001-2023 年,中国军贸出口规模占全球比例自 2.8%提升至 8.4%(+5.6pct)。", "date": "2024-08-13T17:44:43+08:00"}, {"id": "sr_94bf13", "title": "2019-2023年中国军贸出口前十大客户-行业数据-三个皮匠报告", "source": "三个皮匠报告", "url": "https://www.sgpjbg.com/hyshuju/7cbeba2c68aea7462bc4430e859e9778.html", "snippet": "疫情消退,中国军贸出口恢复。疫情对中国军贸出口造成了较大的影响,20 年出口较 19 年同比下降 56.1%,疫情消退后,军贸出口逐渐回暖,23 年出口达 24.3亿TIV,占全球军贸出口 8.4%,接近近 10 年最高点 16 年的 24.5 亿TIV。19-23年,累计出口 81.2 亿TIV,占全球军贸出口 5.8%,居军贸出口榜榜四位置。中国军贸客户较为集中。19-23 年,巴基斯坦为中国军贸出口最大客户,出口 49.6亿TIV(占中国军贸出口的 61%),再是孟加拉国(11%)和泰国(6%),三者合计占 78%。巴基斯坦与中国关系密切,在中国的采购占进口份额不断增加,由09-13 年的 51%增加到 14-18 年的 69%,再增加到 19-23 年的 82%。", "date": "2023-08-24T13:29:00+08:00"}, {"id": "sr_e01ff1", "title": "2001-2022年全球军费开支及全球武器进出口TIV-行业数据-三个皮匠报告", "source": "三个皮匠报告", "url": "https://www.sgpjbg.com/hyshuju/94385345d80a999b05586d293dedc54a.html", "snippet": "为统一不同时期、不同种类以及不同使用年限的武器装备的价值,斯德哥尔摩和平研究所 (SIPRI) 设置了 TIV(Trend-Indicator Value)作为计量 指标,来衡量全球军贸市场武器装备的价值量。根据 SIPRI 数据库,近年来全球军贸指标总体增幅较大,2020-2022 年全球军贸指数分别为 240.00 亿TIV、267.92 亿TIV 和319.83 亿TIV。", "date": "2023-08-24T13:29:00+08:00"}, {"id": "sr_1f1cc7", "title": "韩国武器销售额_历年数据_聚汇数据", "source": "聚汇数据", "url": "https://www.gotohui.com/ndata/show-1453223", "snippet": "+ 添加到对比 折线图 条形图 保存图片 拖动时间范围: 1972 - 2023 韩国武器销售额 数据如下: 下载数据 未来预测数据 注:TIV是SIPRI用于衡量国际武器交易的价值,TIV代表 \"Trend-Indicator Value\"。 序号 时间(年) 数据(单位:百万TIV) 1 2023 2 2022 3 2021 4 2020 5 2019 6 2018 7 2017 702.", "date": "2023-12-11T00:00:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 1}}

