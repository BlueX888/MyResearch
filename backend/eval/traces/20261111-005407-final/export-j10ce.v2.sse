data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:28:16.534431", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2024, 2025, 2029], 'Market_Size': [975.2, 1057.1, 1377.5]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['Market_Size'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='全球战斗机市场规模')\nplt.fill_between(df['Year'], df['Market_Size'], alpha=0.15, color='#6366f1')\nfor x, y in zip(df['Year'], df['Market_Size']):\n    plt.text(x, y + 20, f'{y:.1f}', ha='center', fontsize=11, fontweight='bold', color='#1e293b')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿美元）', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12)\nplt.annotate('2025-2034年CAGR 6.8%', xy=(2026.5, 1200), fontsize=12, color='#64748b')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

