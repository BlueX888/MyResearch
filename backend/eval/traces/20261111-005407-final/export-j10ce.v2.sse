data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T23:28:01.814655", "content": {"charts": [{"id": "chart_001", "title": "全球战斗机市场规模趋势", "subtitle": "2024-2029年市场规模（亿美元）", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2024", "2025", "2029"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "line", "data": [975.2, 1057.1, 1377.5], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}}]}}, {"id": "chart_002", "title": "全球军贸出口份额对比", "subtitle": "2023年主要国家占比（%）", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "20%", "right": "15%", "top": "10%", "bottom": "10%"}, "xAxis": {"type": "value", "show": false, "max": 50}, "yAxis": {"type": "category", "data": ["美国", "中国"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "data": [{"value": 39, "itemStyle": {"color": "#1677ff"}}, {"value": 8.4, "itemStyle": {"color": "#52c41a"}}], "barWidth": 20, "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#666"}, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}}]}}, {"id": "chart_003", "title": "歼-10CE关键性能指标", "subtitle": "公开数据汇总（归一化展示）", "type": "radar", "echarts_option": {"radar": {"indicator": [{"name": "雷达探测距离优势(公里)", "max": 100}, {"name": "同时跟踪目标(个)", "max": 20}, {"name": "同时打击目标(个)", "max": 10}, {"name": "武器外挂点(个)", "max": 15}, {"name": "PL-15E击杀距离(公里)", "max": 250}], "center": ["50%", "50%"], "radius": "65%", "axisName": {"color": "#666", "fontSize": 11}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "splitArea": {"show": false}}, "series": [{"type": "radar", "data": [{"value": [50, 12, 6, 11, 200], "name": "歼-10CE", "itemStyle": {"color": "#1677ff"}, "areaStyle": {"color": "rgba(22,119,255,0.2)"}, "lineStyle": {"width": 2}}]}]}}, {"id": "chart_004", "title": "全球军贸市场增长率对比", "subtitle": "复合年增长率（%）", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["战斗机市场\nCAGR", "战斗机市场\n年均", "军贸市场\nCAGR", "战机市场\n年均"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "fontSize": 11}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}, "axisLabel": {"formatter": "{value}%"}}, "series": [{"type": "bar", "data": [8.4, 6.8, 1.7, 3.71], "barWidth": 30, "itemStyle": {"color": "#1677ff"}, "label": {"show": true, "position": "top", "formatter": "{c}%", "color": "#666"}}]}}, {"id": "chart_005", "title": "中国在全球军贸中的份额", "subtitle": "2023年出口额（亿TIV）", "type": "pie", "echarts_option": {"series": [{"type": "pie", "radius": ["40%", "70%"], "center": ["50%", "50%"], "data": [{"name": "中国", "value": 24.32, "itemStyle": {"color": "#1677ff"}}, {"name": "其他", "value": 266.72, "itemStyle": {"color": "#e8e8e8"}}], "label": {"show": true, "formatter": "{b}: {d}%", "color": "#666"}, "emphasis": {"itemStyle": {"shadowBlur": 10, "shadowColor": "rgba(0,0,0,0.2)"}}}]}}]}}

