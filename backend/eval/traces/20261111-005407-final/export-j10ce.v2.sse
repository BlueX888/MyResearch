data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T23:19:25.499689", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述全球战斗机军贸市场规模、增速、中轻型多用途战斗机需求、主要出口国和进口地区，以及歼-10CE目标市场容量和增长空间。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["全球战斗机军贸市场规模 增速 中轻型多用途战斗机 出口 2024 2025"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述主要竞争机型F-16V、阵风、台风、鹰狮、苏-35、FA-50等的市场地位，中国航空工业及成飞在军贸格局中的位置，以及巴基斯坦等现有客户的示范效应。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["歼-10CE F-16V 阵风 鹰狮 苏-35 军贸 竞争 订单"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述有源相控阵雷达、PL-15E远程空空导弹、数据链、电子战、发动机和后勤保障等核心技术趋势，以及歼-10CE技术迭代和体系化作战能力。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["歼-10CE 有源相控阵雷达 PL-15E 数据链 电子战 技术参数"]}, {"id": "sec_4", "title": "政策环境", "description": "描述中国军品出口政策、出口管制、买方国家外交与财政约束、美国CAATSA制裁及地区安全合作对歼-10CE军贸出口的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中国军品出口政策 战斗机出口 管制 CAATSA 制裁 军贸"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述歼-10CE出口面临的竞争激烈、买方融资、政治压力、售后体系和产能约束等挑战，以及巴基斯坦示范、中东东南亚非洲换装、体系化出口和成飞品牌提升等机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["歼-10CE 出口 挑战 机遇 巴基斯坦 埃及 孟加拉 印尼 订单"]}, {"id": "sec_6", "title": "未来展望", "description": "描述潜在客户转化、订单交付节奏、成飞军贸收入占比、技术升级和产业链影响等未来发展趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["歼-10CE 未来出口 潜在客户 成飞 军贸收入 交付"]}], "research_questions": ["歼-10CE已公开的出口订单、交付和潜在客户进展如何？", "与主要竞争机型相比，歼-10CE的竞争力和约束条件是什么？", "军贸出口对成飞的收入、产能、技术迭代和国际合作意义如何？"]}}

