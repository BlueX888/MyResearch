data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:26:34.538277", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'指标': ['净利润（2024年）', '市值（2025年）'], '中航沈飞': [30, 1200], '中航西飞': [10, 700]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df['指标']))\nplt.plot(x, df['中航沈飞'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='中航沈飞')\nplt.fill_between(x, df['中航沈飞'], alpha=0.15, color='#6366f1')\nplt.plot(x, df['中航西飞'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='中航西飞')\nplt.fill_between(x, df['中航西飞'], alpha=0.15, color='#f59e0b')\nfor i, v in enumerate(df['中航沈飞']):\n    plt.text(i, v + 35, str(v) + '亿元', ha='center', fontsize=11, color='#6366f1', fontweight='bold')\nfor i, v in enumerate(df['中航西飞']):\n    plt.text(i, v + 35, str(v) + '亿元', ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nplt.xticks(x, df['指标'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.xlabel('指标维度', fontsize=14)\nplt.ylabel('金额（亿元）', fontsize=14)\nplt.title('航空装备与军工资本化市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.legend(fontsize=12, loc='upper left', frameon=True)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.figtext(0.99, 0.01, '注：数据为投资者估算值（置信度约0.25），仅供参考', ha='right', fontsize=9, color='#888888')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 航空装备与军工资本化市场概况"}}

