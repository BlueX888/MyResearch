data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:27:54.056317", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Company': ['中航沈飞', '中航西飞'], 'NetProfit': [30, 10], 'MarketCap': [1200, 700]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Company'], df['NetProfit'], marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='净利润（亿元）')\nplt.fill_between(df['Company'], df['NetProfit'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['NetProfit']):\n    plt.text(i, v + 1, str(v), ha='center', fontsize=11, fontweight='bold')\nplt.plot(df['Company'], df['MarketCap'], marker='s', markersize=8, linewidth=2.5, color='#f59e0b', label='市值（亿元）')\nplt.fill_between(df['Company'], df['MarketCap'], alpha=0.15, color='#f59e0b')\nfor i, v in enumerate(df['MarketCap']):\n    plt.text(i, v + 20, str(v), ha='center', fontsize=11, fontweight='bold')\nplt.title('成飞与沈飞上市平台及竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('公司', fontsize=14)\nplt.ylabel('数值（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.legend(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 成飞与沈飞上市平台及竞争格局"}}

