data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T00:26:22.786533", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    '指标': ['交易作价(亿元)', '发行股份(亿股)', '重组后总股本(亿股)', '股本扩张倍数'],\n    '成飞': [174.42, 20.86, 26.77, 4.53],\n    '沈飞': [79.80, 9.93, 13.37, 3.88]\n}\ndf = pd.DataFrame(data)\nfor c in ['成飞', '沈飞']:\n    df[c] = pd.to_numeric(df[c], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nvals1 = df.loc[df['指标'] == '交易作价(亿元)', ['成飞', '沈飞']].values[0]\nb1 = axes[0].bar(['成飞\\n借壳中航电测', '沈飞\\n借壳中航黑豹'], vals1, width=0.5, color=['#6366f1', '#06b6d4'])\nfor b, v in zip(b1, vals1):\n    axes[0].text(b.get_x() + b.get_width() / 2, v + 4, f'{v:.2f}', ha='center', fontsize=13, fontweight='bold')\naxes[0].set_title('标的资产交易作价对比', fontsize=15, fontweight='bold', pad=15)\naxes[0].set_ylabel('交易作价（亿元）', fontsize=13)\naxes[0].tick_params(labelsize=11)\naxes[0].grid(True, linestyle='--', alpha=0.3)\nvals2 = df.loc[df['指标'] == '重组后总股本(亿股)', ['成飞', '沈飞']].values[0]\nb2 = axes[1].bar(['成飞\\n创业板 302132', '沈飞\\n主板 600760'], vals2, width=0.5, color=['#10b981', '#f59e0b'])\nfor b, v in zip(b2, vals2):\n    axes[1].text(b.get_x() + b.get_width() / 2, v + 0.6, f'{v:.2f}', ha='center', fontsize=13, fontweight='bold')\naxes[1].set_title('重组后总股本对比', fontsize=15, fontweight='bold', pad=15)\naxes[1].set_ylabel('总股本（亿股）', fontsize=13)\naxes[1].tick_params(labelsize=11)\naxes[1].grid(True, linestyle='--', alpha=0.3)\nfig.suptitle('成飞 vs 沈飞：资本化路径与上市平台对比', fontsize=18, fontweight='bold')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦成飞与沈飞两条资本化路径的核心可比指标：标的资产交易作价、发行股份数量、重组后总股本、股本扩张倍数。成飞通过借壳创业板公司中航电测（300114→302132）实现整体上市，交易作价174.42亿元、发行20.86亿股、总股本由5.91亿股扩张至26.77亿股（约4.53倍）；沈飞则于2017年借壳上交所主板中航黑豹（600760），交易对价79.8亿元、发行9.93亿股、总股本13.37亿股（约3.88倍）。用双子图柱状图对比交易作价与重组后总股本，直观呈现'成飞体量更大、平台在创业板；沈飞体量较小、平台在主板'的差异。"}}

