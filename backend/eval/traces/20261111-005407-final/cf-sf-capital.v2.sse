data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T00:14:45.153827", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "航空装备与军工资本化市场概况", "description": "梳理航空装备市场规模、增速及军工核心资产证券化趋势，重点比较成飞、沈飞上市平台的市值、营收、融资与资产注入背景。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["航空装备市场规模 增速 军工资产证券化 中航成飞 中航沈飞 市值 营收"]}, {"id": "sec_2", "title": "成飞与沈飞上市平台及竞争格局", "description": "比较成飞借壳中航电测登陆创业板与沈飞重组中航黑豹登陆主板的平台差异，分析航空工业集团内整机企业资本平台布局和竞争关系。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 中航电测 重组上市 创业板 中航沈飞 中航黑豹 主板 资本化路径"]}, {"id": "sec_3", "title": "军机研制技术与资本化支撑", "description": "分析隐身战机、数字化研制、批产能力等技术趋势如何影响企业融资需求、资产注入节奏和上市平台功能定位。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 军机研制 隐身战机 数字化 批产 融资需求 资产注入"]}, {"id": "sec_4", "title": "国企改革与军工资产证券化政策环境", "description": "梳理国企改革深化提升行动、军工资产证券化、并购重组和注册制相关政策，分析其对成飞、沈飞资本化路径和上市平台选择的约束与激励。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国企改革 军工资产证券化 并购重组 注册制 重组上市 政策 中航成飞 中航沈飞"]}, {"id": "sec_5", "title": "资本化路径差异带来的挑战与机遇", "description": "分析保密与信息披露、关联交易、估值定价、产能扩张和市值管理等挑战，以及融资便利、股权激励、资产整合和市场化机制等机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军工上市公司 信息披露 关联交易 估值 股权激励 市值管理 中航成飞 中航沈飞"]}, {"id": "sec_6", "title": "未来资本运作与平台发展展望", "description": "展望成飞、沈飞后续资产注入、再融资、股权激励和市值管理趋势，判断创业板与主板平台差异对长期资本运作的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 未来 资产注入 再融资 股权激励 中航沈飞 资本运作 展望"]}], "research_questions": ["成飞与沈飞分别通过何种重组方式和上市平台实现核心整机资产上市，路径差异体现在哪些关键环节？", "创业板与主板平台差异如何影响两家企业的估值、融资、股权激励和后续资本运作？", "国企改革、军工资产证券化及并购重组政策如何塑造成飞与沈飞资本化路径的选择和未来走向？"]}}

