data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T00:22:13.360429", "content": {"results": [{"id": "fact_6b722038", "title": "中航成飞2024年度会计师事务所由大华会计师事务所（特殊普通合伙）变更为大信会计师事务所（特殊普通合伙）。", "source": "证券日报网（chinext.zqrb.cn）", "url": "", "snippet": "中航成飞2024年度会计师事务所由大华会计师事务所（特殊普通合伙）变更为大信会计师事务所（特殊普通合伙）。", "date": "", "isSupplementary": false}, {"id": "fact_548aafc9", "title": "中航成飞2024年度利润分配方案以公司发行股份后最新股本总额2,676,782,376股为基数，并剔除回购专户持有股份；搜索结果中回购专户股份具体尾数被截断。", "source": "证券日报网（chinext.zqrb.cn）", "url": "", "snippet": "中航成飞2024年度利润分配方案以公司发行股份后最新股本总额2,676,782,376股为基数，并剔除回购专户持有股份；搜索结果中回购专户股份具体尾数被截断。", "date": "", "isSupplementary": false}, {"id": "fact_614c5b4c", "title": "同一证券代码302132在2024年半年度报告、2024年一季度报告和2023年年度报告中披露的简称为“中航电测”，而2024年年度报告及摘要披露的简称为“中航...", "source": "前瞻眼上市企业库", "url": "", "snippet": "同一证券代码302132在2024年半年度报告、2024年一季度报告和2023年年度报告中披露的简称为“中航电测”，而2024年年度报告及摘要披露的简称为“中航成飞”。", "date": "", "isSupplementary": false}, {"id": "fact_dbbae396", "title": "中航成飞2025年半年度报告及摘要于2025年8月28日发布，2025年一季度报告于2025年4月29日发布。", "source": "前瞻眼上市企业库", "url": "", "snippet": "中航成飞2025年半年度报告及摘要于2025年8月28日发布，2025年一季度报告于2025年4月29日发布。", "date": "", "isSupplementary": false}, {"id": "fact_ed076bf2", "title": "中航成飞2024年年度报告摘要显示，证券代码为302132，证券简称为“中航成飞”，公告编号为2025—030。当前搜索关键词中的“300114”未在本次搜索结...", "source": "中航成飞股份有限公司2024年年度报告摘要（chinext.zqrb.cn转载）", "url": "", "snippet": "中航成飞2024年年度报告摘要显示，证券代码为302132，证券简称为“中航成飞”，公告编号为2025—030。当前搜索关键词中的“300114”未在本次搜索结果中出现，实际检索结果指向302132。", "date": "", "isSupplementary": false}, {"id": "fact_1ddd28f2", "title": "2025年1月6日，公司向中国航空工业集团有限公司发行股份购买成都飞机工业（集团）有限责任公司100%股权的重大资产重组完成资产交割。", "source": "中航成飞股份有限公司2024年年度报告摘要（chinext.zqrb.cn转载）", "url": "", "snippet": "2025年1月6日，公司向中国航空工业集团有限公司发行股份购买成都飞机工业（集团）有限责任公司100%股权的重大资产重组完成资产交割。", "date": "", "isSupplementary": false}, {"id": "fact_8fc050f1", "title": "截至2024年12月31日，成都飞机工业（集团）有限责任公司尚未纳入中航成飞合并报表范围，2024年年度报告事项未包括成飞集团及下属子公司有关情况。", "source": "中航成飞股份有限公司2024年年度报告摘要（chinext.zqrb.cn转载）", "url": "", "snippet": "截至2024年12月31日，成都飞机工业（集团）有限责任公司尚未纳入中航成飞合并报表范围，2024年年度报告事项未包括成飞集团及下属子公司有关情况。", "date": "", "isSupplementary": false}, {"id": "fact_4c87c7dd", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2024年度财务报告出具标准无保留意见；本年度会计师事务所由大华会计师事务所（特殊普通合伙）变更为大信会计师事务所（特...", "source": "中航成飞股份有限公司2024年年度报告摘要（chinext.zqrb.cn转载）", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2024年度财务报告出具标准无保留意见；本年度会计师事务所由大华会计师事务所（特殊普通合伙）变更为大信会计师事务所（特殊普通合伙）。", "date": "", "isSupplementary": false}, {"id": "fact_ee65d877", "title": "中航成飞2024年度利润分配方案拟以发行股份后最新股本总额2,676,782,376股剔除回购专户持有股份后的股本为基数，但搜索结果中回购专户持股数被截断，无法...", "source": "中航成飞股份有限公司2024年年度报告摘要（chinext.zqrb.cn转载）", "url": "", "snippet": "中航成飞2024年度利润分配方案拟以发行股份后最新股本总额2,676,782,376股剔除回购专户持有股份后的股本为基数，但搜索结果中回购专户持股数被截断，无法完整核验。", "date": "", "isSupplementary": false}, {"id": "fact_94debca4", "title": "前瞻眼上市企业库将中航成飞列为302132.SZ，并列出其2024年年度报告发布于2025-03-28、2025年半年度报告发布于2025-08-28；同一列表...", "source": "前瞻眼上市企业库", "url": "", "snippet": "前瞻眼上市企业库将中航成飞列为302132.SZ，并列出其2024年年度报告发布于2025-03-28、2025年半年度报告发布于2025-08-28；同一列表还包含“中航电测”2023年年度报告、2024年半年度报告等历史文件，显示同一上市平台存在名称/代码沿革。", "date": "", "isSupplementary": false}, {"id": "fact_2375c149", "title": "同花顺F10显示，2家机构预测中航成飞2024年每股收益0.23元，较上年同比增长35.29%；预测2024年净利润1.31亿元，较上年同比增长33.45%。该...", "source": "同花顺金融服务网", "url": "", "snippet": "同花顺F10显示，2家机构预测中航成飞2024年每股收益0.23元，较上年同比增长35.29%；预测2024年净利润1.31亿元，较上年同比增长33.45%。该预测口径可能未反映成飞集团整体注入后的合并报表，需以年报原文核验。", "date": "", "isSupplementary": false}, {"id": "fact_41784ff4", "title": "雪球用户于2025-03-27转发“中航成飞:2024年年度报告摘要”链接，属于社交平台公告转发，未提供原始公告全文。", "source": "雪球", "url": "", "snippet": "雪球用户于2025-03-27转发“中航成飞:2024年年度报告摘要”链接，属于社交平台公告转发，未提供原始公告全文。", "date": "", "isSupplementary": false}, {"id": "fact_22654582", "title": "中航成飞股份有限公司股票代码为302132，股票上市交易所为深圳证券交易所，变更前的股票简称为“中航电测”，公司办公地址为四川省成都市青羊区黄田坝纬一路88号。", "source": "中财网（转载中航成飞2026年半年度报告摘要）", "url": "", "snippet": "中航成飞股份有限公司股票代码为302132，股票上市交易所为深圳证券交易所，变更前的股票简称为“中航电测”，公司办公地址为四川省成都市青羊区黄田坝纬一路88号。", "date": "", "isSupplementary": false}, {"id": "fact_c8cbdc94", "title": "中航成飞2026年第三季度报告（公告编号2026-037）显示：本报告期营业收入8,270,389,817.94元，比上年同期减少70.02%；年初至报告期末营...", "source": "中财网（转载中航成飞2026年三季度报告）", "url": "", "snippet": "中航成飞2026年第三季度报告（公告编号2026-037）显示：本报告期营业收入8,270,389,817.94元，比上年同期减少70.02%；年初至报告期末营业收入23,437,603,376.98元，比上年同期减少51.46%。", "date": "", "isSupplementary": false}, {"id": "fact_b0e3559e", "title": "中航成飞2026年第三季度报告显示：本报告期归属于上市公司股东的净利润165,456,849.17元，比上年同期减少86.83%；年初至报告期末归属于上市公司股...", "source": "中财网（转载中航成飞2026年三季度报告）", "url": "", "snippet": "中航成飞2026年第三季度报告显示：本报告期归属于上市公司股东的净利润165,456,849.17元，比上年同期减少86.83%；年初至报告期末归属于上市公司股东的净利润874,527,554.05元，比上年同期减少59.68%；年初至报告期末扣非净利润795,507,000元（原文截断）。", "date": "", "isSupplementary": false}, {"id": "fact_9583adcf", "title": "中航成飞于2026年5月20日15:00-17:00通过全景网“投资者关系互动平台”以网络远程方式召开2025年度业绩说明会暨2026年投资者集体接待日，接待人...", "source": "中财网（转载中航成飞投资者关系活动记录表2026-003）", "url": "", "snippet": "中航成飞于2026年5月20日15:00-17:00通过全景网“投资者关系互动平台”以网络远程方式召开2025年度业绩说明会暨2026年投资者集体接待日，接待人员包括董事长隋少春、总经理蒋敏、董事会秘书兼副总经理肖峰、副总经理田刚。", "date": "", "isSupplementary": false}, {"id": "fact_10f6bb0e", "title": "中航成飞在2025年度业绩说明会中披露：2026年一季报合同负债60.45亿元，创阶段性新高；公司表示国防支出预算连续多年保持增长，国防现代化建设目标清晰、政策...", "source": "中财网（转载中航成飞投资者关系活动记录表2026-003）", "url": "", "snippet": "中航成飞在2025年度业绩说明会中披露：2026年一季报合同负债60.45亿元，创阶段性新高；公司表示国防支出预算连续多年保持增长，国防现代化建设目标清晰、政策支撑明确。", "date": "", "isSupplementary": false}, {"id": "fact_5a90680d", "title": "中航成飞2026年半年度报告摘要（公告编号2026-029）显示：公司计划不派发现金红利，不送红股，不以公积金转增股本；报告期无非标准审计意见。", "source": "中财网（转载中航成飞2026年半年度报告摘要）", "url": "", "snippet": "中航成飞2026年半年度报告摘要（公告编号2026-029）显示：公司计划不派发现金红利，不送红股，不以公积金转增股本；报告期无非标准审计意见。", "date": "", "isSupplementary": false}, {"id": "fact_d22048e0", "title": "证券时报电子报2026年8月24日B014版刊登中航成飞[302132]2026-029号公告，即2026年半年度报告摘要。", "source": "证券时报电子报", "url": "", "snippet": "证券时报电子报2026年8月24日B014版刊登中航成飞[302132]2026-029号公告，即2026年半年度报告摘要。", "date": "", "isSupplementary": false}, {"id": "fact_c9a170d6", "title": "有第三方报告库收录题为《中航成飞(302132)产品谱系持续扩容，军贸拓展空间远大》的研究报告，但该页面仅为检索索引，未提供报告原始出处与全文，可靠性有限。", "source": "远瞻慧库（baogaobox.com）", "url": "https://www.baogaobox.com/reports/260916000119160.html", "snippet": "有第三方报告库收录题为《中航成飞(302132)产品谱系持续扩容，军贸拓展空间远大》的研究报告，但该页面仅为检索索引，未提供报告原始出处与全文，可靠性有限。", "date": "", "isSupplementary": false}]}}

