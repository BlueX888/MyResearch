data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:26:23.875073", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["site:defense.gov F-35 contract 127 aircraft 7.8 billion December 30", "site:lockheedmartin.com F-35 contract 127 aircraft 2024"], "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:26:24.869143", "content": {"results": [{"id": "sr_db2cd4", "title": "F-35 Lightning II Training", "source": "www.lockheedmartin.com", "url": "https://www.lockheedmartin.com/en-us/products/f-35-lightning-ii-training-systems.html", "snippet": "The F-35 Training System prepares pilots and maintainers from nations across the globe to fly, fight and sustain the most advanced fighter jet available today. This system combines state-of-the-art technology, robust curriculums and mission readiness criteria to create a total training solution for the F-35 Lightning II program.\n By the Numbers ___ \n2,685\nPilots\n17,260\nMaintainers\n12\nNations & Militaries Currently Training\n F-35 PILOT TRAINING ___ \n Simulated training is a cost-effective and safe way for pilots to build their skills and prepare for their next missions. With no stress on an airframe and increasingly reduced footprint, pilots are conducting roughly 50 percent of their initial qualifying flights in the Full Mission Simulator. From learning to operate the jet for the first tim", "date": "2025-03-14T13:22:34+08:00"}, {"id": "sr_828686", "title": "Media - Lockheed Martin - Releases", "source": "news.lockheedmartin.com", "url": "https://news.lockheedmartin.com/2020-01-21-U-S-Army-and-Air-Force-Team-up-for-Multi-Domain-Operations", "snippet": "Sustainability Performance Report U.S. Army and Air Force Team up for Multi-Domain Operations F-35 acts as an elevated sensor for Army Integrated Air and Missile Defense Flight Test White Sands Missile Range, Jan. 21, 2020 – Two U.S. Air Force F-35s were integrated with the U.S. Army Integrated Air and Missile Defense Battle Command System (IBCS), providing an airborne sensor capability to successfully detect, track and intercept near simultaneous air-breathing threats in a test at White Sands Missile Range, New Mexico. The December 2019 test marked the first time F-35s were used as sensors during an IBCS live fire test against multiple airborne targets. Linking F-35s to IBCS via the Multifunction Advanced Data Link (MADL) provided enhanced situational awareness and weapons-quality track d", "date": "2025-02-04T03:16:56+08:00"}, {"id": "sr_3f0dfd", "title": "Lockheed Martin F-35 Production Adds Jobs in Johnstown - Mar 23, 2017", "source": "news.lockheedmartin.com", "url": "https://news.lockheedmartin.com/2017-03-23-Lockheed-Martin-F-35-Production-Adds-Jobs-in-Johnstown", "snippet": "back Search Sustainability Performance Report back JOHNSTOWN, Pa. , March 23, 2017 / PRNewswire / -- Lockheed Martin (NYSE: LMT) will expand production for components of the F-35 Lightning II with a new facility in Johnstown , including more than 40 new jobs by the end of 2018. \"The F-35 Lightning II is beginning the transition to full-rate production, and the manufacturing expertise we have here has a growing role in delivering this incredible aircraft to the men and women who defend our nation,\" said Gilda Jackson , general manager of Lockheed Martin AeroParts. Lockheed Martin is in the process of finalizing plans to lease and equip an additional facility to accommodate this new work, and begin producing a subset of parts for the program beginning in the fourth quarter this year. The new", "date": "2024-03-11T14:18:41+08:00"}, {"id": "sr_51d99f", "title": "Sikorsky Receives Second Contract to Build Presidential Helicopters - Feb 20, 20", "source": "news.lockheedmartin.com", "url": "https://news.lockheedmartin.com/2020-02-20-Sikorsky-Receives-Second-Contract-to-Build-Presidential-Helicopters", "snippet": "Sustainability Performance Report VH-92A® test helicopters flying and validating mission capabilities Lockheed Martin Corporation Presidential Helicopter STRATFORD, Conn. , Feb. 20, 2020 / PRNewswire / -- Sikorsky, a Lockheed Martin company (NYSE: LMT), will build six production VH-92A® Presidential Helicopters under a contract from the U.S Navy . These helicopters are part of the 23 aircraft program of record for the U.S. Marine Corps. Under the terms of the contract, known as Low Rate Initial Production (LRIP) Lot II, Sikorsky will begin deliveries of six VH-92A helicopters in 2022. The remaining production aircraft will be delivered in 2022 and 2023. \"The program continues to progress on budget and within our planned acquisition timeline,\" said Col. Eric Ropella , PMA-274 presidential h", "date": "2025-01-17T00:45:13+08:00"}, {"id": "sr_85b56a", "title": "Lockheed Martin Israel", "source": "www.lockheedmartin.com", "url": "https://www.lockheedmartin.com/en-il/index.html", "snippet": "Lockheed Martin is proud of the significant role it has fulfilled in the security of the State of Israel.\nOur C-130 and F-16 aircraft have been faithfully serving the Israel Air Force since the 1970s and 1980s, and when a Letter of Agreement was signed in October 2010, Israel became the first country to select the F-35 through the United States government's Foreign Military Sales process.\nWe also believe in strengthening the industries and individuals that will fuel future growth for Israel. By  delivering on industrial commitments  with Israeli companies, we bolster advanced technology and local research and development. Our  stewardship of STEM,  in collaboration with key government Ministries, inspires the scientists and technology professionals of tomorrow. \nMore about our partnership", "date": "2025-03-12T09:19:53+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

