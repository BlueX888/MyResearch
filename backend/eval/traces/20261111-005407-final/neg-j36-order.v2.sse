data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T23:25:38.069093", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "梳理歼-36相关公开信息现状，包括型号确认程度、试飞进展、潜在采购需求规模、订单传闻来源及可信度，明确可验证的数据边界。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["歼-36 订单 数量 合同价格 官方 披露;歼-36 试飞 采购 计划 传闻;中国 六代机 订单 预算"]}, {"id": "sec_2", "title": "竞争格局", "description": "分析全球六代机及五代半战机竞争格局，包括主要研制国家、机型、采购计划，以及歼-36在其中的定位和对订单/价格判断的参考意义。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["六代机 竞争 格局 F-47 NGAD 歼-36;全球 战斗机 采购 订单 价格 对比;中国 歼-20 歼-35 采购 价格"]}, {"id": "sec_3", "title": "技术趋势", "description": "梳理隐身、变循环发动机、无人协同、定向能、航电架构等六代机关键技术趋势，分析技术成熟度对采购价格和订单节奏的可能影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["六代机 关键技术 变循环发动机 无人协同;歼-36 技术 特征 隐身 航电;战斗机 研发 成本 采购 价格 影响因素"]}, {"id": "sec_4", "title": "政策环境", "description": "分析国防预算、装备采购制度、保密政策、军贸出口管制及官方信息发布机制对歼-36订单和价格信息透明度的约束。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中国 国防预算 装备采购 政策;军贸 出口管制 战斗机 政策;武器装备 保密 信息 公开 规定"]}, {"id": "sec_5", "title": "挑战机遇", "description": "识别订单与价格研究中的主要挑战，如信息不透明、传闻干扰、数据不可核验；同时梳理权威信息发布、预算公开和航展披露带来的验证机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["歼-36 订单 价格 信息 不透明 验证;中国 航展 战斗机 合同 披露;国防 预算 采购 公开 数据"]}, {"id": "sec_6", "title": "未来展望", "description": "展望歼-36订单和价格信息的可能披露路径与时间窗口，判断短期、中期内可获得的权威数据类型及研究结论的置信度。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["歼-36 未来 采购 订单 预测;中国 六代机 服役 时间 价格 预测;战斗机 采购 合同 公告 披露 趋势"]}], "research_questions": ["歼-36是否已被官方正式确认型号并进入采购阶段？", "目前是否存在可核验的歼-36订单数量和单机合同价格公开数据？", "如何通过官方预算、采购公告、航展信息和类比机型交叉验证相关传闻？"]}}

