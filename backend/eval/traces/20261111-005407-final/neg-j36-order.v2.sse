data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:30:47.414999", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'机型': ['F-22', 'F-35A', 'NGAD（六代机）'], '单价': [1.4, 0.779, 3.0]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['单价'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, markeredgecolor='#6366f1', zorder=3)\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    label = f'{v:.3f}'.rstrip('0').rstrip('.') + ' 亿美元/架'\n    plt.text(i, v + 0.10, label, ha='center', fontsize=11, fontweight='bold', color='#312e81')\nplt.xticks(x, df['机型'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('市场概况分析：主力战机单价对比', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('机型', fontsize=14)\nplt.ylabel('单价（亿美元/架）', fontsize=14)\nplt.ylim(0, 3.6)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

