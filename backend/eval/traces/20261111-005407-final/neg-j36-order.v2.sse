data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:30:40.436151", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Model': ['歼-35(传闻)', 'F-35A(飞离价)', '歼-36(传闻飞离价)', '歼-20(预估)', '歼-36(声称)', 'F-22', 'F-47(预估)', 'NGAD/F-47'],\n    'Unit_Price': [0.56, 0.78, 0.80, 1.10, 1.20, 1.40, 2.30, 3.00],\n    'Status': ['传闻', '已确认', '传闻', '预估', '传闻', '已确认', '预估', '预估']\n}\ndf = pd.DataFrame(data)\ndf['Unit_Price'] = pd.to_numeric(df['Unit_Price'], errors='coerce')\ndf = df.dropna().reset_index(drop=True)\ncmap = {'已确认': '#10b981', '传闻': '#f59e0b', '预估': '#6366f1'}\ncolors = df['Status'].map(cmap)\nplt.figure(figsize=(12, 7), dpi=200)\nbars = plt.barh(df['Model'], df['Unit_Price'], color=colors, edgecolor='white', height=0.65)\nfor i, v in enumerate(df['Unit_Price']):\n    plt.text(v + 0.05, i, f'{v:.2f}', va='center', fontsize=12, fontweight='bold', color='#334155')\nplt.title('单机价格谱系对比：歼-36订单量与合同价均无公开数据', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('单机价格（亿美元/架）', fontsize=14)\nplt.ylabel('机型', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.xlim(0, 3.5)\nplt.grid(True, linestyle='--', alpha=0.3, axis='x')\nplt.text(0.99, 0.03, '公开可查歼-36订单记录：0 条  |  官方确认项：0 项', transform=plt.gca().transAxes, ha='right', fontsize=12, color='#dc2626', fontweight='bold')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "核心结论：在全部可用数据中，歼-36的订单数量与单机合同价格均为“0条公开记录/未披露”，官方未确认型号存在。因此分析重点从“给出数字”转为“量化数据缺口”，并用可比的五代机/六代机单价区间作为参照系，展示歼-36传闻价格（0.8亿、1.2亿美元）在行业价格谱系中的位置，从而说明任何具体订单/合同价数字目前都不可采信。"}}

