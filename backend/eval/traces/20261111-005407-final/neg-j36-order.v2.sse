data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T23:31:01.663957", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'机型': ['F-22', 'F-35A', 'NGAD（六代机）'], '单价': [1.4, 0.779, 3.0], '数量': [180, 2456, np.nan]}\ndf = pd.DataFrame(data)\nx = np.arange(len(df))\nfig, ax1 = plt.subplots(figsize=(12, 7), dpi=200)\nax1.plot(x, df['单价'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='单价（亿美元/架）', zorder=3)\nax1.fill_between(x, df['单价'], alpha=0.15, color='#6366f1')\nprice = df['单价'].values\nfor i, v in enumerate(price):\n    ax1.annotate(f'{v:.2f} 亿美元', (x[i], v), textcoords='offset points', xytext=(0, 14), ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nax1.set_ylabel('单价（亿美元/架）', fontsize=14, color='#4338ca')\nax1.set_ylim(0, 3.9)\nax1.tick_params(axis='y', labelcolor='#4338ca', labelsize=12)\nax2 = ax1.twinx()\nqty = df['数量'].values\nax2.plot(x[:2], qty[:2], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, linestyle='--', label='装备/采购数量（架）', zorder=3)\nfor i in range(2):\n    ax2.annotate(f'{int(qty[i])} 架', (x[i], qty[i]), textcoords='offset points', xytext=(0, -22), ha='center', fontsize=11, fontweight='bold', color='#b45309')\nax2.set_ylabel('装备/采购数量（架）', fontsize=14, color='#b45309')\nax2.set_ylim(0, 3000)\nax2.tick_params(axis='y', labelcolor='#b45309', labelsize=12)\nax1.set_xticks(x)\nax1.set_xticklabels(df['机型'], fontsize=12)\nax1.set_xlabel('机型 / 项目', fontsize=14)\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine(ax=ax1)\nsns.despine(ax=ax2, right=False)\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

