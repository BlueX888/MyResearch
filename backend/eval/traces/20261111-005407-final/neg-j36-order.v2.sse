data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:36:00.106087", "content": {"results": [{"id": "fact_5c37ff78", "title": "DefenceTalk指出，五角大楼内部早期曾流传每单位3500万美元的“总项目单位成本”承诺；2001年SAR首次同时引用RDT&E、采购成本和数量数据；20...", "source": "DefenceTalk", "url": "", "snippet": "DefenceTalk指出，五角大楼内部早期曾流传每单位3500万美元的“总项目单位成本”承诺；2001年SAR首次同时引用RDT&E、采购成本和数量数据；2002年SAR下调单位成本估计，预测2866架飞机、1610亿美元（2002年美元）。", "date": "", "isSupplementary": true}, {"id": "fact_fc3be9f1", "title": "歼-20于2011年1月11日12时50分在成都首飞，历时18分钟。", "source": "中国网", "url": "", "snippet": "歼-20于2011年1月11日12时50分在成都首飞，历时18分钟。", "date": "", "isSupplementary": true}, {"id": "fact_c7fa443f", "title": "歼-20于2016年11月在第十一届珠海航展上首次对外正式公开；2017年7月参加庆祝中国人民解放军建军90周年阅兵，首次以战斗姿态对外展示。", "source": "歼-20-快懂百科", "url": "", "snippet": "歼-20于2016年11月在第十一届珠海航展上首次对外正式公开；2017年7月参加庆祝中国人民解放军建军90周年阅兵，首次以战斗姿态对外展示。", "date": "", "isSupplementary": true}, {"id": "fact_a320a7be", "title": "中国空军发言人于2018年2月9日证实，歼-20开始正式列装空军作战部队；2019年10月13日列装空军王牌部队；2021年6月18日列装人民空军多支英雄部队。", "source": "歼-20-快懂百科", "url": "", "snippet": "中国空军发言人于2018年2月9日证实，歼-20开始正式列装空军作战部队；2019年10月13日列装空军王牌部队；2021年6月18日列装人民空军多支英雄部队。", "date": "", "isSupplementary": true}, {"id": "fact_b44071cb", "title": "美媒《华尔街日报》报道猜测歼-20战机单价可能为1.1亿美元。", "source": "中国数字科技馆", "url": "", "snippet": "美媒《华尔街日报》报道猜测歼-20战机单价可能为1.1亿美元。", "date": "", "isSupplementary": true}, {"id": "fact_e4d15e5a", "title": "俄媒称成飞集团共组装了4架J-20原型机，其中2001和2002两架正在试飞；中国2011年采购了150台俄制AL-31F和AL-31FN发动机。", "source": "CNTV", "url": "", "snippet": "俄媒称成飞集团共组装了4架J-20原型机，其中2001和2002两架正在试飞；中国2011年采购了150台俄制AL-31F和AL-31FN发动机。", "date": "", "isSupplementary": true}, {"id": "fact_923b0a7f", "title": "观察者网称有西方媒体猜测歼-20可能在2015-2017年小批量装备部队。", "source": "观察者网", "url": "", "snippet": "观察者网称有西方媒体猜测歼-20可能在2015-2017年小批量装备部队。", "date": "", "isSupplementary": true}, {"id": "fact_04dcb909", "title": "2021年歼-20在庆祝中国共产党成立100周年大会上首次进行大规模展示，15架歼-20分成三个5机楔队飞越天安门上空；2021年9月在第十三届珠海航展上，换装...", "source": "歼-20-快懂百科", "url": "", "snippet": "2021年歼-20在庆祝中国共产党成立100周年大会上首次进行大规模展示，15架歼-20分成三个5机楔队飞越天安门上空；2021年9月在第十三届珠海航展上，换装国产发动机后的歼-20首次对外公开展示。", "date": "", "isSupplementary": true}, {"id": "fact_0c100f31", "title": "道客巴巴文档称歼-20预期将在2017到2019年间投入使用，2020年后逐步形成强大战斗力。", "source": "道客巴巴", "url": "", "snippet": "道客巴巴文档称歼-20预期将在2017到2019年间投入使用，2020年后逐步形成强大战斗力。", "date": "", "isSupplementary": true}, {"id": "fact_203ffb61", "title": "文档下载网详述歼-20首飞过程：原定2011年1月7日试飞，因天气改于2011年1月11日12时50分由歼-10S型战机陪同下开始首次飞行，13时05分顺利结束...", "source": "文档下载网", "url": "", "snippet": "文档下载网详述歼-20首飞过程：原定2011年1月7日试飞，因天气改于2011年1月11日12时50分由歼-10S型战机陪同下开始首次飞行，13时05分顺利结束。", "date": "", "isSupplementary": true}, {"id": "fact_6aaeb021", "title": "军事订货是国防经济中体现商品经济和期货特点的一种军品交换方式，与其他民品订货一样具有先成交后生产的特点，一般适用于大批量或价值量高的军品；采取订货方式有利于加强...", "source": "华律网", "url": "", "snippet": "军事订货是国防经济中体现商品经济和期货特点的一种军品交换方式，与其他民品订货一样具有先成交后生产的特点，一般适用于大批量或价值量高的军品；采取订货方式有利于加强军品生产、流通和军工企业经营的市场性、经济性和计划性。", "date": "", "isSupplementary": true}, {"id": "fact_afbc007d", "title": "军事订货是事先通过签订合同或协议达成的交易，合同或协议内容一般包括军品数量、质量、完成时限、交货与付款方式、价格等，具有约束买卖双方权利和义务的法律效力。", "source": "华律网", "url": "", "snippet": "军事订货是事先通过签订合同或协议达成的交易，合同或协议内容一般包括军品数量、质量、完成时限、交货与付款方式、价格等，具有约束买卖双方权利和义务的法律效力。", "date": "", "isSupplementary": true}, {"id": "fact_9b562b68", "title": "军事采购法规由中央军事委员会另行制定；军事采购不纳入《政府采购法》调整范围；军事机关采购军事装备和军用物资涉及国家安全和机密，采购过程不可完全遵循公开透明原则。", "source": "抖音百科", "url": "", "snippet": "军事采购法规由中央军事委员会另行制定；军事采购不纳入《政府采购法》调整范围；军事机关采购军事装备和军用物资涉及国家安全和机密，采购过程不可完全遵循公开透明原则。", "date": "", "isSupplementary": true}, {"id": "fact_ee2005f6", "title": "军事采购范围包含装备采购和军队采购：装备采购指总装备部及其他装备部门对武器装备和军选民用产品的采购；军队采购指总后勤部及其他后勤部门对军队物资、工程、服务的采购...", "source": "豆丁网", "url": "", "snippet": "军事采购范围包含装备采购和军队采购：装备采购指总装备部及其他装备部门对武器装备和军选民用产品的采购；军队采购指总后勤部及其他后勤部门对军队物资、工程、服务的采购。", "date": "", "isSupplementary": true}, {"id": "fact_9bf85118", "title": "订单一般指订购货物的合同、单据，也指企业采购部门向供应商发出的订货凭据。", "source": "汉典", "url": "", "snippet": "订单一般指订购货物的合同、单据，也指企业采购部门向供应商发出的订货凭据。", "date": "", "isSupplementary": true}, {"id": "fact_d760f0d9", "title": "耐用品订单统计包括国防部门用品及运输部门用品，这两个部门数据变化对整体数据影响较大，市场较注重扣除国防部门用品及运输部门用品后的数据变化。", "source": "搜狗问答", "url": "", "snippet": "耐用品订单统计包括国防部门用品及运输部门用品，这两个部门数据变化对整体数据影响较大，市场较注重扣除国防部门用品及运输部门用品后的数据变化。", "date": "", "isSupplementary": true}, {"id": "fact_44ed3f23", "title": "本次补充搜索的全部结果均为上市公司（协创数据、巨轮智能、周黑鸭等）的订单、业绩预告、做空回应等财经信息，没有任何一条涉及歼-36战斗机、军用航空器订单或单机合同...", "source": "搜索结果整体", "url": "", "snippet": "本次补充搜索的全部结果均为上市公司（协创数据、巨轮智能、周黑鸭等）的订单、业绩预告、做空回应等财经信息，没有任何一条涉及歼-36战斗机、军用航空器订单或单机合同价格。", "date": "", "isSupplementary": true}, {"id": "fact_6d992588", "title": "有投资者提问'在手订单3.8亿具体如何理解'，公司回复称截止一季度末在手订单约3.8亿未计入一季报报表，订单持续滚动获取——该数据属于某上市公司（非航空军工），...", "source": "新浪财经", "url": "", "snippet": "有投资者提问'在手订单3.8亿具体如何理解'，公司回复称截止一季度末在手订单约3.8亿未计入一季报报表，订单持续滚动获取——该数据属于某上市公司（非航空军工），与歼-36无关。", "date": "", "isSupplementary": true}, {"id": "fact_355730ed", "title": "有分析指出机构研报中'签订框架协议'不等于确定收入，很多框架单无保底采购量、随时可取消，订单与扩产数据存在文字游戏——这提示订单类数据需区分意向订单与确认合同，...", "source": "东方财富网财富号", "url": "", "snippet": "有分析指出机构研报中'签订框架协议'不等于确定收入，很多框架单无保底采购量、随时可取消，订单与扩产数据存在文字游戏——这提示订单类数据需区分意向订单与确认合同，但该讨论不涉及歼-36。", "date": "", "isSupplementary": true}, {"id": "fact_6de4dbb2", "title": "巨轮智能回应称新签订液压式硫化机合同累计金额占最近一年经审计主营业务收入50%以上，订单销售将在2024-2025年度体现业绩——属上市公司订单披露，与歼-36...", "source": "东方财富网股吧（上证e互动）", "url": "", "snippet": "巨轮智能回应称新签订液压式硫化机合同累计金额占最近一年经审计主营业务收入50%以上，订单销售将在2024-2025年度体现业绩——属上市公司订单披露，与歼-36无关。", "date": "", "isSupplementary": true}]}}

