data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:26:06.561066", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["五角大楼 F-35 采购 2456架 总金额 2700亿美元 原始来源", "美国空军 NGAD 单价 3亿美元 出处 官方证词"], "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:26:06.865544", "content": {"results": [{"id": "sr_3f9812", "title": "美军宣布采购32架F-35战机 造价料40亿美元", "source": "环球时报", "url": "https://world.huanqiu.com/article/9CaKrnJxZ2O", "snippet": "经过近一年的拉锯谈判,五角大楼30日宣布初步敲定采购第五批F-35战机的合同。据五角大楼当日通报,此次敲定的第五批F-35战机包括22架供空军使用的F-35A常规起降型战机,...", "date": "2012-12-01T00:00:00+08:00"}, {"id": "sr_2356c4", "title": "F35多少钱", "source": "搜狗问答", "url": "http://wenwen.sogou.com/z/q19542460.htm", "snippet": "美国国防部没有控制住F-35的采购费用。初期预测是,每架成本为3500万美元,但五角大楼现在预计,2458架F-35的研发和生产费用为2990亿美元。每架F-35将花费1.22亿美元......另外,根据现在这种飞机的不成熟状况,费用以后可能还会上涨,但目前的估计还不包括这些", "date": "2007-11-24T13:30:57+08:00"}, {"id": "sr_c3da37", "title": "五角大楼签署采购78亿美元F-35战机的合同 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7183153219357377024/", "snippet": "【五角大楼签署采购78亿美元F-35战机的合同】财联社12月31日电,美国国防部新闻局当地时间12月30日发布消息称,五角大楼与洛克希德·马丁公司签署了采购127架第五代战机F-35的合同。", "date": "2022-12-31T11:43:00+08:00"}, {"id": "sr_9f10bd", "title": "美国五角大楼官员称,五角大楼将寻求1700亿美元用于采购,1450亿美元用于研发,预计总额将超过8350亿美元,高于目前的8160亿美元,他们还将寻求...", "source": "和讯股票", "url": "https://stock.hexun.com/2023-03-08/207909638.html", "snippet": "美国五角大楼官员称,五角大楼将寻求1700亿美元用于采购,1450亿美元用于研发,预计总额将超过8350亿美元,高于目前的8160亿美元,他们还将寻求135亿美元用于购买洛克希德的F-35战斗机。 快讯正文 美国五角大楼官员称,五角大楼将寻求1700亿美元用于采购,1450亿美元用于研发,预计总额将超过8350亿美元,高于目前的8160亿美元,他们还将寻求135亿美元用于购买洛克希德的F-35战斗机。", "date": "2023-03-08T06:52:25+08:00"}, {"id": "sr_24d726", "title": "F35 美军自己能装备多少架 - 搜狗问问", "source": "搜狗问答", "url": "http://wenwen.sogou.com/z/q806572892.htm", "snippet": "总共7000多万亿军费,基础开支、海外用兵,其他军事采购等用去大半。F35一亿多,川普喊贵,最多装备50架。 美国空军的f35a到手的都已经100多架了,连英国人都拿到了f35b。", "date": "2017-10-07T13:35:07+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 1}}

