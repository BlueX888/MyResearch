"id": "node_18", "name": "中国航空工业集团（AVIC）", "type": "company", "discovered_at": "2026-11-10T23:26:09.574919"}, {"id": "node_19", "name": "变循环发动机（三涵道）", "type": "technology", "discovered_at": "2026-11-10T23:26:09.574929"}, {"id": "node_20", "name": "无人忠诚僚机/蜂群协同", "type": "technology", "discovered_at": "2026-11-10T23:26:09.574941"}, {"id": "node_21", "name": "定向能武器", "type": "technology", "discovered_at": "2026-11-10T23:26:09.574953"}, {"id": "node_22", "name": "霹雳-17", "type": "technology", "discovered_at": "2026-11-10T23:26:09.574962"}, {"id": "node_23", "name": "涡扇-15", "type": "technology", "discovered_at": "2026-11-10T23:26:09.574970"}, {"id": "node_24", "name": "国防保密与军贸出口管制制度", "type": "policy", "discovered_at": "2026-11-10T23:26:09.574979"}, {"id": "node_25", "name": "中航成飞（SZ302132）", "type": "company", "discovered_at": "2026-11-10T23:26:10.579456"}, {"id": "node_26", "name": "中国航空研究院", "type": "organization", "discovered_at": "2026-11-10T23:26:10.579467"}, {"id": "node_27", "name": "中国空军装备部", "type": "policy", "discovered_at": "2026-11-10T23:26:10.579473"}, {"id": "node_28", "name": "Andrew P. Hunter", "type": "person", "discovered_at": "2026-11-10T23:26:10.579479"}, {"id": "node_29", "name": "F-47（波音）", "type": "technology", "discovered_at": "2026-11-10T23:26:10.579486"}, {"id": "node_30", "name": "脉动生产线", "type": "technology", "discovered_at": "2026-11-10T23:26:10.579495"}, {"id": "node_31", "name": "歼-50（沈飞）", "type": "technology", "discovered_at": "2026-11-10T23:26:10.579502"}], "edges": [{"source": "歼-36", "relation": "中国第六代战斗机（媒体称谓，未获官方确认）", "discovered_at": "2026-11-10T23:26:06.560617"}, {"source": "歼-36", "relation": "2024年12月首飞", "discovered_at": "2026-11-10T23:26:06.560621"}, {"source": "歼-36", "relation": "2025年12月双机编队试飞", "discovered_at": "2026-11-10T23:26:06.560625"}, {"source": "歼-36", "relation": "与歼-50并行研制", "discovered_at": "2026-11-10T23:26:06.560628"}, {"source": "歼-50", "relation": "中国另一款六代机", "discovered_at": "2026-11-10T23:26:06.560637"}, {"source": "歼-50", "relation": "研发进度落后歼-36约6个月", "discovered_at": "2026-11-10T23:26:06.560641"}, {"source": "轰-20", "relation": "中国隐身战略轰炸机", "discovered_at": "2026-11-10T23:26:06.560650"}, {"source": "轰-20", "relation": "与歼-36同期被讨论", "discovered_at": "2026-11-10T23:26:06.560653"}, {"source": "F-47", "relation": "美国第六代战斗机", "discovered_at": "2026-11-10T23:26:06.560662"}, {"source": "F-47", "relation": "2025年3月21日由特朗普命名", "discovered_at": "2026-11-10T23:26:06.560666"}, {"source": "NGAD", "relation": "美国空军下一代空中优势计划", "discovered_at": "2026-11-10T23:26:06.560676"}, {"source": "NGAD", "relation": "单价据称3亿美元", "discovered_at": "2026-11-10T23:26:06.560680"}, {"source": "NGAD", "relation": "项目面临成本审查与推迟", "discovered_at": "2026-11-10T23:26:06.560685"}, {"source": "F/A-XX", "relation": "美国海军六代舰载机计划", "discovered_at": "2026-11-10T23:26:06.560695"}, {"source": "F-35", "relation": "美军计划采购2456架", "discovered_at": "2026-11-10T23:26:06.560706"}, {"source": "F-35", "relation": "F-35A单价7790万美元", "discovered_at": "2026-11-10T23:26:06.560709"}, {"source": "F-35", "relation": "面临六代机挤压采购空间", "discovered_at": "2026-11-10T23:26:06.560714"}, {"source": "F-22", "relation": "单价1.4亿美元", "discovered_at": "2026-11-10T23:26:06.560723"}, {"source": "F-22", "relation": "仅装备180余架", "discovered_at": "2026-11-10T23:26:06.560727"}, {"source": "歼-20", "relation": "中国五代机", "discovered_at": "2026-11-10T23:26:06.560736"}, {"source": "歼-20", "relation": "已有三个版本（AL-31F型、歼-20A、歼-20S）", "discovered_at": "2026-11-10T23:26:06.560740"}, {"source": "歼-35/歼-35A", "relation": "2024年珠海航展亮相", "discovered_at": "2026-11-10T23:26:06.560749"}, {"source": "歼-35/歼-35A", "relation": "出口前景受关注", "discovered_at": "2026-11-10T23:26:06.560754"}, {"source": "霹雳-21", "relation": "超远程空空导弹", "discovered_at": "2026-11-10T23:26:06.560763"}, {"source": "霹雳-21", "relation": "被认为可由歼-36弹舱挂载", "discovered_at": "2026-11-10T23:26:06.560767"}, {"source": "成飞", "relation": "六代机研制单位之一（媒体说法）", "discovered_at": "2026-11-10T23:26:06.560777"}, {"source": "沈飞", "relation": "六代机研制单位之一（媒体说法）", "discovered_at": "2026-11-10T23:26:06.560787"}, {"source": "五角大楼", "relation": "F-35采购计划制定方", "discovered_at": "2026-11-10T23:26:06.560793"}, {"source": "五角大楼", "relation": "NGAD项目主管", "discovered_at": "2026-11-10T23:26:06.560795"}, {"source": "珠海航展", "relation": "中国装备公开展示的权威窗口", "discovered_at": "2026-11-10T23:26:06.560800"}, {"source": "成都飞机工业集团（成飞）", "relation": "歼-36研制方（传闻）", "discovered_at": "2026-11-10T23:26:09.574899"}, {"source": "成都飞机工业集团（成飞）", "relation": "歼-20研制方", "discovered_at": "2026-11-10T23:26:09.574902"}, {"source": "沈阳飞机工业集团（沈飞）", "relation": "歼-50研制方（传闻）", "discovered_at": "2026-11-10T23:26:09.574908"}, {"source": "沈阳飞机工业集团（沈飞）", "relation": "歼-35研制方", "discovered_at": "2026-11-10T23:26:09.574911"}, {"source": "西安飞机工业集团（西飞）", "relation": "被推测为第三款六代机（无人机）研制方", "discovered_at": "2026-11-10T23:26:09.574916"}, {"source": "中国航空工业集团（AVIC）", "relation": "歼-36母公司层级", "discovered_at": "2026-11-10T23:26:09.574923"}, {"source": "中国航空工业集团（AVIC）", "relation": "未发布任何官方型号公告", "discovered_at": "2026-11-10T23:26:09.574926"}, {"source": "变循环发动机（三涵道）", "relation": "六代机核心动力", "discovered_at": "2026-11-10T23:26:09.574932"}, {"source": "变循环发动机（三涵道）", "relation": "影响航程与超音速巡航", "discovered_at": "2026-11-10T23:26:09.574935"}, {"source": "变循环发动机（三涵道）", "relation": "影响采购成本", "discovered_at": "2026-11-10T23:26:09.574938"}, {"source": "无人忠诚僚机/蜂群协同", "relation": "六代机体系核心", "discovered_at": "2026-11-10T23:26:09.574944"}, {"source": "无人忠诚僚机/蜂群协同", "relation": "单机可指挥数十架无人机", "discovered_at": "2026-11-10T23:26:09.574947"}, {"source": "无人忠诚僚机/蜂群协同", "relation": "影响单机与体系采购结构", "discovered_at": "2026-11-10T23:26:09.574950"}, {"source": "定向能武器", "relation": "六代机候选技术", "discovered_at": "2026-11-10T23:26:09.574955"}, {"source": "定向能武器", "relation": "影响功率与散热设计成本", "discovered_at": "2026-11-10T23:26:09.574958"}, {"source": "霹雳-17", "relation": "歼-36内置弹舱挂载（传闻）", "discovered_at": "2026-11-10T23:26:09.574965"}, {"source": "霹雳-17", "relation": "射程500公里（传闻）", "discovered_at": "2026-11-10T23:26:09.574967"}, {"source": "涡扇-15", "relation": "歼-36动力组成（传闻）", "discovered_at": "2026-11-10T23:26:09.574974"}, {"source": "涡扇-15", "relation": "歼-20现役发动机", "discovered_at": "2026-11-10T23:26:09.574976"}, {"source": "国防保密与军贸出口管制制度", "relation": "限制订单与价格信息公开", "discovered_at": "2026-11-10T23:26:09.574982"}, {"source": "国防保密与军贸出口管制制度", "relation": "影响型号官方确认节奏", "discovered_at": "2026-11-10T23:26:09.574985"}, {"source": "中航成飞（SZ302132）", "relation": "歼-36研制生产方（外界推定）", "discovered_at": "2026-11-10T23:26:10.579460"}, {"source": "中航成飞（SZ302132）", "relation": "投资者关系平台对J36问题未作实质披露", "discovered_at": "2026-11-10T23:26:10.579463"}, {"source": "中国航空研究院", "relation": "被引述发布《第六代战斗机技术标准白皮书》（未证实）", "discovered_at": "2026-11-10T23:26:10.579470"}, {"source": "中国空军装备部", "relation": "被称透露首批24名飞行员受训（未证实）", "discovered_at": "2026-11-10T23:26:10.579476"}, {"source": "Andrew P. Hunter", "relation": "美国空军采购主管", "discovered_at": "2026-11-10T23:26:10.579482"}, {"source": "Andrew P. Hunter", "relation": "2026年1月31日国会听证会评价歼-36进度", "discovered_at": "2026-11-10T23:26:10.579484"}, {"source": "F-47（波音）", "relation": "美国六代机对照机型", "discovered_at": "2026-11-10T23:26:10.579490"}, {"source": "F-47（波音）", "relation": "预计单价2.3亿美元（媒体口径）", "discovered_at": "2026-11-10T23:26:10.579492"}, {"source": "脉动生产线", "relation": "被称用于歼-36量产，年产能50架（未证实）", "discovered_at": "2026-11-10T23:26:10.579499"}, {"source": "歼-50（沈飞）", "relation": "同日曝光的另一款六代验证机", "discovered_at": "2026-11-10T23:26:10.579504"}]}, "stats": {"entitiesCount": 32, "relationsCount": 61}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T23:26:10.579739", "content": {"agent": "DeepScout", "section": "市场概况", "facts_count": 11, "duplicates_removed": 0, "data_points_count": 21, "insights": ["关于“订单数量”与“单机合同价格”这两个核心问题，现有搜索结果中不存在任何可验证的权威数据：既无官方公告，也无国防预算科目、采购批次公告或航展签约信息。", "唯一出现的价格数字（1.2亿美元/架）来自自媒体转述所谓“中航工业2025年12月财务报告”，属二手且不可追溯，且与“显著高于现役五代机”的假设方向不符，只能作为待证伪的传闻处理。", "所有“订单/产能”数字（月产2架、年产50架、2027年24—48架、2030年360架）性质不同：前者为基于卫星图像的境外推断，后者为自媒体线性外推，均非合同订单。"], "source_quality": "整体来源质量偏低。11条结果中，无一条为政府/军方公告、预算文件或企业正式披露文件；唯一具官方属性的是中航成飞在投资者互动平台的答复（credibility 0.85），但其内容为不予披露，仅能作为“信息不可得”的证据。其余为中华网军事、腾讯网、搜狐、网易、今日头条等门户或自媒体的二次加工内容（credibility 0.15—0.4），普遍存在无原始出处、数据嫁接、以推测冒充结论的问题，其中“200亿美元研发投资”“1.2亿美元单价”“年产50架”等关键数字均不可追溯。建议后续优先检索：国防部/空军新闻发布会实录、中国航空工业集团年度报告、美国国防部《中国军力报告》、USCC报告及权威智库（如CSIS、IISS）分析，以替换现有低可信度信源。", "hypothesis_updates": 3, "search_results": [{"title": "中国大幅领先!歼-36已启动量产 月产2架 美六代机被远远甩开|战机|空战|战斗机|无人机|波音公司_网易订阅", "url": "https://www.163.com/dy/article/KBODLO510515972E.html", "source": "网易", "snippet": "在首飞仅仅九个月后,据美国《对外政策》杂志披露,歼-36这款引发全球关注的战机已经进入小批量试产阶段,标志着中国在第六代战斗机研发领域取得领先优势。该机将成为全球首款服役的第六代战斗机,而美国F-47项目因技术滞后与成本失控被远远甩在身后,中国在六代机竞赛中占据先机,空战规则正由东方重新书写。全球瞩目的歼-36第六代战机,于2024年12月完成首飞后,在2025年进入密集试飞阶段。\n有报道说,歼-36成功验证空中巡航飞行、三发动机加速与转向对飞行的影响、空中加油、复杂机动等实战科目。最重要的是,歼-36首次验证了通过数据链指挥多架“忠诚僚机”无人机,形成蜂群突防能力。在模拟演练中,其与无侦-10协同作战,作战效能提升数倍,可构建“超视距杀伤链”,实现战场信息快速共享与精准打击。在模拟演练中,歼-36曾成功指挥无人机群瘫痪敌方防空网络,展示了有人机与无人机协同作战的崭新空战概念。最新消息是,2025年9月,歼-36已启动小批量试产,标志着中国成为全球首个将六代机推进至量产阶段的国家。做出这一判断的依据来自国外的侦查卫星图片,这些图片证实成飞专门修建的生产车间附近,有密集的人员和车辆活动。\n仔细分析后,专家得出结论,歼-36已开始量产,但是预计规模不会很大,也就是每月2架的水平。随着歼-36进入小批量生产,全球空中力量平衡正在重新洗牌。此举也说明,中国通过歼-36展示了完整的工业体系和快速迭代能力,在第六代战斗机竞赛中已经占据先机。与此同时,美国虽选定波音公司主导生产并命名为F-47,但目前仍处于技术验证机阶段,量产时间可能落后中国5年以上。而打造F/A-XX是美国海军造舰计划以外最受瞩目的合同之一,自从空军3月选定波音为F-47第6代战机的主要承包商后,这项竞赛便成为白宫、五角大楼与国会争论的焦点。尽管波音公司极力加快F-47的研发进度,但是似乎存在欲速则不达的严重问题。", "date": "2025-10-13T11:24:18+08:00"}, {"title": "歼-36列装时间待定,六代机进展受关注 - 今日头条", "url": "https://www.toutiao.com/video/7688622512233611810/", "source": "今日头条", "snippet": "展开歼-36列装时间待定,六代机进展受关注。播放\n9发布于\n2026-09-23\n15:02暂无更多评论网站地图", "date": "2026-09-23T15:02:00+08:00"}, {"title": "歼36疑似4号机首飞传递什么信号 定义六代机新标准_军事频道_中华网", "url": "https://military.china.com/news/13004177/20260202/49218229_1.html", "source": "中华网军事", "snippet": "2026年1月31日,美国空军采购主管Andrew\nP.\nHunter在国会听证会上表示,歼-36可能比F-47更早形成初始作战能力。这话分量不轻。F-47目前只有三张渲染图和一堆PPT方案,波音拿下合同后定的目标是“2028年某个时候首飞”,措辞含糊得像天气预报。更讽刺的是,这个时间点是为了给特朗普献礼。军工项目的时间表跟着政治日程走,本身就说明问题。中国航空工业集团2025年12月的财务报告透露,歼-36研发投资超过200亿美元。乍一看挺吓人,但拆开算账就明白了。歼-36采用脉动生产线设计,年产能可达50架,单价控制在1.2亿美元。对比一下,F-47预计单价2.3亿美元,几乎是歼-36的两倍。美国那套军工体系,成本越来越高,效率越来越低,根子上是整个产业链在吃老本。波音、洛马这些巨头,研发新机型的动力远不如炒冷饭挣钱来得实在。乌克兰国家科学院航空研究所的分析说,歼-36可以携带6枚霹雳-17超远程空对空导弹。这还只是空对空配置,如果换成对地对海武器,载弹量更可观。中国航空研究院发布的《第六代战斗机技术标准白皮书》里明确提到,六代机需要具备全频段隐身、高超音速巡航、有人无人协同能力。歼-36的2800公里作战半径,意味着从东南沿海起飞,整个西太平洋都在打击范围内。中国空军装备部在1月31日透露,首批24名飞行员已经在沧州飞行训练基地接受六代机理论培训。这个动作的意义在于,装备还没定型,人员培养已经提前启动。从理论学习到模拟训练,再到实装飞行,整个周期至少需要两三年。提前布局意味着一旦歼-36正式列装,马上就能形成战斗力。法国《航空航天》杂志1月31日的报道用了“令人震惊”这个词。他们说歼-36第四架原型机的技术成熟度超出预期,中国六代机研发已经领先欧洲FCAS项目3到4年。欧洲那个未来空战系统,法德西三国扯皮扯了好几年,到现在连基本设计方案都没敲定。技术路线争论、预算分", "date": "2026-02-02T16:20:22+08:00"}, {"title": "官方已经实锤“六代机”,中国空军体系全面换代 - 今日头条", "url": "https://www.toutiao.com/video/7657155881288647218/", "source": "今日头条", "snippet": "现在飞机的研发,试飞,生产,交付已经不是原来那套思路和惯性了。\n随着基础科学数学、物理、化学、材料学的快速发展,\n各类天赋、高阶人才和创新思路的出现,\n供应链大规模升级和完备,\n智能制造,数控设备,机器人生产,智能辅助装备、AI检测设备的大规模运用,\n设计,材料,工艺,系统,发动机,风动,计算机模拟,芯片,通信,计算机,AI,算法,算力,试飞等等,\n中国高阶战斗机生产已经全面进入自由王国。\n而且也完全摆脱飞机等发动机的尴尬。\n现在战斗机迭代越来越快,\n不是过去的一款产品需要十多二十年,现在只需要几年就完成所有流程。\n就像汽车一样,当积累达到零界点,就是科技大爆炸。\n所以,为了2030这个时间节点。\n歼36预计2026完成早期定型(预留升级冗余),2027年小批量生产服役(数量24—48),2028中等规模服役(4—120),2029大批量服役(240)。\n到2030,服役规模达到360。", "date": "2026-06-30T19:55:00+08:00"}, {"title": "中航成飞:关于J36六代机情况的官方信息及试飞视频真实性_手机新浪网", "url": "https://finance.sina.cn/stock/relnews/dongmiqa/2025-03-27/detail-inerayne4955136.d.html", "source": "新浪财经", "snippet": "投资者提问: 尊敬的董秘您好,关于成飞公司六代机J36的情况有官方信息可以披露吗?网上热传的J36密集试飞的视频是否真实?是否说明六代机研发工作进展顺利,定型量产及列装空军都指日可待?谢谢! 董秘回答(中航成飞SZ302132): 您好,感谢您对公司的关注。", "date": "2025-03-27T17:53:40+08:00"}, {"title": "中国歼16战机单价曝光:约6亿人民币 歼20的价格出乎预期", "url": "http://k.sina.cn/article_6419428688_17ea0b5500010028hs.html?kfrome=mil&local=&subch=0&vt=4", "source": "新浪看点", "snippet": "全球军事热论 2017.12.26 16:32 关注 目前,F-35实际订单数量已达400架,实际交付数量已近300架;计划订单数量约为4000多架,其中美军为2400多架。与网络上一些自我欺骗的调侃不同,美军正用实际装备数量大踏步的迈向全隐身空军。 所谓长江后浪推前浪,歼-16的出现让飞豹B计划夭折,但在面对正在走来的隐身浪潮时,又显得“不那么够用”;规模性的歼-16编队足以对周边一般国家造成强大的威慑能力,但是在面对未来以隐身战机为主体的美军时,生存能力就比较令人担忧;即使是在面对购买了美军标准-6型防空导弹(最大射程近400公里)的日本自卫队时,也显得有些尴尬。于是,歼-20服役后,继续装备一款具备强大对地/海打击能力的隐身多用途战机就成了我军下一步需要努力的目标。 从现实角度考虑,歼20或者歼31的加强对地攻击型会是不错的选择。虽然歼31一开始就宣传能够上舰或者具有优秀的多用途能力,但是就目前出现的两架验证机来看,既不能上舰,内弹仓挂载能力也不怎么好(F-35因为强化对地功能,为了增大弹仓挂载能力,腹部显得凸凹不平);所以,两者都需要进一步的改进。 所谓改进一般是对挂架、机体承重结构进行加强,并加强航电系统的对地探测能力、目标成像能力、地形跟踪能力等。由于歼-20已经展示了挂载4个2400升大油箱(每个满油约1.9吨)的能力,所以目前其已经具备了强大的挂载能力(加内弹仓总近10吨),而歼31目前尚无证明;歼-20装备有类似F-35的EODAS系统,目前还难以确定其机头雷达罩下部的IRST/EOTS系统是否具备F-35那样强大的对地探测、跟踪能力,但歼31则目前暂时没有此系统(留有接口)。整体来看,在对地攻击方面,歼20目前进度比歼31走的更远。 很多人倾向于歼31是因为其所宣传的廉价,这基于一个观点和一个宣传。这个观点是“航电系统在战机价格中所占的比例越", "date": "2017-12-26T16:32:00+08:00"}, {"title": "媒体:歼-36首次完成双机编队试飞 六代机研发领先全球_军事频道_中华网", "url": "https://military.china.com/news/13004177/20251222/49095446_all.html", "source": "中华网军事", "snippet": "媒体:歼-36首次完成双机编队试飞\n六代机研发领先全球!近日,在成都的上空,有网友拍到两架歼-36同时飞行,组成了一个战斗编队。这一场景引发了不少讨论。这表明歼-36的试飞进入了新阶段。战斗机的试飞通常分为基础飞行测试和战斗性能测试两个主要阶段。基础飞行测试包括飞行稳定性、机动性、加速性能以及在极端天气条件下的可靠性等,歼-36已经全部完成。例如,歼-36曾进行过大仰角起飞、高空小半径转弯和高空抛油等测试,充分验证了其飞行的可靠性。接下来进入的是战斗性能测试,包括武器系统、电子对抗系统、通信系统等,通常需要两架或更多的战机一起进行协同测试。双机编队试飞的成功,意味着这些测试已进入关键阶段。完成后,歼-36还将进行实弹射击和远程攻击测试等更高强度的对抗测试。研发进展非常顺利,甚至有可能提前在2027年服役,而不是等到原计划的2028年。这一事件还揭示了中国在六代机研发领域的领先优势。20年前,中国还在使用歼-8战斗机,与美军的F-22相比,技术上落后整整两代。但如今,中国不仅赶上了,还超越了美国和俄罗斯的战机。在六代机的研发方面,中国已经取得了绝对的领先地位。美军的F-47目前仍处于概念阶段,俄罗斯的苏-57甚至尚未实现量产,六代机的研发进度更加滞后。与此相比,欧洲国家在这方面更是远远落后,中国的歼-36在全球范围内独占鳌头。法国的阵风战斗机甚至无法与中国的歼-10C抗衡,根本没有能力与歼-36对抗。中国军工的崛起,标志着自鸦片战争以来的最大成就,已经成为航空工业的领军者。歼-35和歼-20的出口前景也变得更加清晰。以前,人们普遍认为歼-20像美军的F-22一样是非卖品。但美军不愿出售F-22的原因在于F-35的性能不足,它虽然成本低,但航程短、载弹量小,且没有反隐身雷达,主要优点在于适合大规模采购和出口。相反,俄罗斯的苏-57已经开始向外销售,阿尔及利亚成为了第一个客户,", "date": "2025-12-22T07:26:02+08:00"}, {"title": "歼-36五天三飞!洛马终于看不下去了,美国六代机或将陷入内斗?", "url": "https://new.qq.com/rain/a/20250401A04SED00", "source": "腾讯网", "snippet": "2025-04-01 12:28:53 【军武次位面】作者:天狼 中国的第六代战斗机——歼-36正在以惊人的速度推进试飞进程。2025年3月26日,歼-36完成第五次试飞,距离首飞仅90天。 歼-36\"五天三飞\" 从2024年12月26日的首次试飞,到2025年3月17日的第二次试飞,再到3月25日和26日的连续第三、第四、第五次试飞,这款战机\"五天三飞\"的密集测试进度,创造了中国新型战机研发史的新纪录。歼-36的密集试飞不仅展现了中国航空工业的自信,也让美军和西方防务界感到压力倍增。尤其是作为美国传统战斗机巨头的洛克希德·马丁公司(洛马),在波音拿下F-47六代机订单后,终于坐不住了,紧急推出了一个新的六代机宣传视频。 歼-36的快速试飞,预示着中国在第六代战机竞赛中的强劲势头。相比之下,美军的下一代战机项目(NGAD)进展缓慢,内部竞争激烈。波音的F-47方案虽然获得了美军订单,但并未获得压倒性优势。而洛马在F-22A和F-35项目上的成功经验,使其不甘心失去主导权。因此,歼-36的高节奏试飞不仅向外界展示了中国航空工业的实力,也对洛马造成了不小的心理冲击。 网传视频显示,歼-36第五次试飞时进行了三发放油测试 从试飞模式来看,歼-36并未像传统战斗机那样先进行验证机测试,而是很可能直接以原型机进行首飞。这意味着歼-36已经跳过了漫长的技术验证阶段,直接进入工程研制阶段。类似的做法曾在歼-20项目上应用,2011号歼-20原型机直接进行首飞,而技术验证阶段可能在更早之前的秘密测试中完成。 此外,歼-36在试飞过程中表现出的成熟度也令人瞩目。例如,从第三次试飞开始,它已经不再需要歼-20S的伴飞,这说明它的基本飞控系统和安全性已经达到了较高的可靠性。第五次试飞时,歼-36甚至已经收起起落架,并进行放油测试,标志着飞机的气动布局、燃油系统和基本飞行性能测试进入更高级阶段", "date": "2025-04-01T12:28:53+08:00"}, {"title": "美媒又盯上歼-36了!越看越慌:刚摸清一架,下一架又飞了!_成本_中国_战斗机", "url": "https://www.sohu.com/a/1080775091_122074357?scm=10001.279_13-101000-0_922.0-0.0-0-0-0-0.a2_5X162X1532", "source": "搜狐", "snippet": "全球军事科技竞争日益激烈的今天,中国的歼-36六代战斗机似乎成为了许多国家,尤其是美国关注的焦点。根据美国《战区》网站的分析,自2024年12月首飞以来,这款战机的多次试飞和不断迭代让人瞩目。从公开信息来看,至少有四到五架不同原型机正在进行飞行测试,而这些原型机的每一次亮相都引发了对其设计特征的热议。\n这里我们要揭示的不仅是技术层面的细节,更是背后潜藏的深刻战略意义。中国在航空工业领域的研发速度和效率已经向外界展示出一种新的模式。这种模式不仅挑战了传统的战斗机研发周期,更以其快速迭代的节奏,让竞争对手始终处于被动跟随的状态。\n我们必须了解,传统战斗机的研发周期往往缓慢且复杂,通常需要十年以上的时间来完成从原型机到最终定型的整个过程。例如,美国的F-35战斗机从首飞到服役历时近15年,而F-22则用掉了8年,欧洲的“台风”战机也耗费了近十年的时间。然而,歼-36的开发节奏却截然不同。\n数据显示,歼-36在不到两年的时间内实现了数架原型机的飞行,而每一架原型机的设计甚至都有显著变化,这种节奏甚至让美方情报人员感到吃力,因为他们发现,自己刚刚摸清楚一个原型的特征,下一架就已经升空,且可能完全不同。\n这代表着中国航空工业进入了一个工业化的研发阶段,能够通过优化设计-制造-测试-改进的每个环节,实现快速迭代。这种快速响应能力不仅在技术层面上表现突出,也意味着中国在军事准备和应对突发事件中的灵活性大大增强。\n除了技术上的领先,成本也是影响竞争的重要因素。根据美国国会的估算,其新一代战斗机F-47的单机造价可能高达3亿美元,这一数字让很多政策制定者惊讶不已。考虑到美国计划采购185至200架F-47,仅仅采购成本就需要约600亿美元。而在综合研发、维护及升级等费用之后,整个项目的生命周期成本甚至可能超越1万亿美元。\n与之相比,中国的歼-36在单机成本上可能会低得多。虽然中国官方并未公布", "date": "2026-09-25T12:01:00+08:00"}, {"title": "彻底改口!华尔街日报承认歼-36是六代机,领先美国近10年|原型机|战斗机|战机|歼-36|美国|验证机_手机网易网", "url": "https://m.163.com/dy/article/KST119Q305567C05.html", "source": "网易", "snippet": "之前一直对中国军工冷嘲热讽的西方老牌媒体,突然改口说了句大实话。曾经被西方硬塞进“战斗轰炸机”框框里的歼-36,这回被亲口认成了正牌六代机。这事可不只是改个叫法那么简单,直接打破了西方主流舆论捂了一年多的统一口径,也扯下了美国“空中绝对优势”的遮羞布。\n打开网易新闻\n查看精彩图片\n2024年12月26日,成飞在成都公开试飞了一架全新的隐身原型机,这架飞机就是被外界暂定型号为歼-36的六代验证机。有意思的是,同一天沈飞的另一款被称作歼-50的隐身机也露了面,咱们直接成了全球唯一一个同一天放飞两款六代机验证机的国家。那时候美方嘴硬不肯松口,但五角大楼内部的评估早就悄悄转了方向,2025年底的美国国防部报告,就偷偷认下了咱们试飞六代原型机的事实。歼-36首飞是2024年12月底,到2026年1月底,第四架原型机就已经顺利上天了。算下来13个月出四架,平均不到四个月就能攒出一架新原型机,放到国际同类项目里,半年能出一架都算速度顶流,咱们这个进度说一句开了挂都不为过。第二架原型机2025年10月开始飞行测试,和首架比改动不小,尾喷口换成了棱角分明的新设计,不光优化隐身,还能提供推力矢量控制,懂行的都知道这个细节分量有多重。\n打开网易新闻\n查看精彩图片\n2025年12月底,成飞直接安排两架歼-36原型机编队飞行,这个姿态明摆着把“六代机已经成型”摆到了所有观察者面前。今年年初,新华社、央视这些权威平台罕见点名提到了歼-36,还有特约评论员直接给出“2026年期待亮相”的表述。从之前的“少说多做”到主动释放节奏信号,本身就说明研发已经到了可以公开的阶段,咱们军工对节点把握相当有底气。反观美国的六代机项目,2025年3月特朗普才把超过200亿美元的F-47合同批给波音,按美方自己的估计,F-47的首飞最早都得推到2028年。这个项目预算一年年往上涨,采购规模反而砍了又砍,原本计划采购两百", "date": "2026-05-14T12:41:57+08:00"}], "extracted_facts": [{"content": "投资者在互动平台向中航成飞（SZ302132）提问：是否有关于六代机J36的官方信息可以披露、网传密集试飞视频是否真实、定型量产及列装是否指日可待；公司董秘仅回复“感谢您对公司的关注”，未确认型号、进展、订单或价格等任何实质信息。", "source_name": "新浪财经（中航成飞投资者关系问答）", "source_url": "https://finance.sina.cn/stock/relnews/dongmiqa/2025-03-27/detail-inerayne4955136.d.html", "credibility": 0.85}, {"content": "自媒体称，据美国《对外政策》杂志披露，歼-36在2024年12月首飞后仅九个月（2025年9月）已进入小批量试产阶段，依据是国外侦察卫星拍到成飞生产车间附近人员车辆密集活动，推测月产约2架。文中未给出任何订单数量或合同价格。", "source_name": "网易订阅（自媒体号）", "source_url": "https://www.163.com/dy/article/KBODLO510515972E.html", "credibility": 0.25}, {"content": "中华网军事文章称：中国航空工业集团2025年12月财务报告透露歼-36研发投资超过200亿美元；歼-36采用脉动生产线，年产能可达50架，单价控制在1.2亿美元；对比F-47预计单价2.3亿美元。同文还称中国空军装备部1月31日透露首批24名飞行员已在沧州基地接受六代机理论培训。上述数据均无原始文件链接或可核查出处。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20260202/49218229_1.html", "credibility": 0.3}, {"content": "中华网军事援引2026年1月31日美国空军采购主管Andrew P. Hunter在国会听证会的表态，称歼-36可能比F-47更早形成初始作战能力；并称F-47目前仅有渲染图与方案，目标为2028年某个时候首飞。此为美方官员对进度而非订单/价格的判断。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20260202/49218229_1.html", "credibility": 0.35}, {"content": "今日头条自媒体给出歼-36服役规模推演：2026年完成早期定型（预留升级冗余），2027年小批量生产服役24—48架，2028年中等规模服役（原文写作“4—120”，疑为40—120之误），2029年大批量服役240架，2030年服役规模达360架。属纯预测性推演，无采购合同或预算依据。", "source_name": "今日头条（自媒体视频）", "source_url": "https://www.toutiao.com/video/7657155881288647218/", "credibility": 0.2}, {"content": "中华网军事报道称，2025年12月成都上空出现两架歼-36原型机编队飞行，标志试飞由基础飞行测试转入战斗性能（武器、电子对抗、通信）协同测试阶段；文章推测服役时间可能提前至2027年（原计划2028年）。未涉及订单或价格。", "source_name": "中华网军事", "source_url": "https://military.china.com/news/13004177/20251222/49095446_all.html", "credibility": 0.4}, {"content": "腾讯网（军武次位面）报道：歼-36于2024年12月26日首飞，2025年3月26日完成第五次试飞，90天内五次试飞（“五天三飞”），并推测其可能跳过技术验证机阶段直接以原型机首飞、直接进入工程研制阶段。", "source_name": "腾讯网（军武次位面）", "source_url": "https://new.qq.com/rain/a/20250401A04SED00", "credibility": 0.35}, {"content": "搜狐转载美媒《战区》分析称，自2024年12月首飞以来至少有4—5架不同原型机在进行飞行测试，且各架设计存在显著变化，体现快速迭代研发模式。未提及订单数量或合同价格。", "source_name": "搜狐（转载）", "source_url": "", "credibility": 0.3}], "data_points": [{"name": "官方对歼-36型号/订单/价格的确认", "value": "0", "unit": "项", "year": 2025, "source": "新浪财经（中航成飞投资者关系问答）"}, {"name": "推测月产能", "value": "2", "unit": "架/月", "year": 2025, "source": "网易订阅（自媒体号）"}, {"name": "首飞时间", "value": "2024-12", "unit": "年月", "year": 2024, "source": "网易订阅（自媒体号）"}, {"name": "歼-36研发投资（声称）", "value": "200", "unit": "亿美元", "year": 2025, "source": "中华网军事"}, {"name": "歼-36年产能（声称）", "value": "50", "unit": "架/年", "year": 2026, "source": "中华网军事"}, {"name": "歼-36单价（声称）", "value": "1.2", "unit": "亿美元/架", "year": 2026, "source": "中华网军事"}, {"name": "F-47预计单价（对比）", "value": "2.3", "unit": "亿美元/架", "year": 2026, "source": "中华网军事"}, {"name": "首批受训飞行员", "value": "24", "unit": "人", "year": 2026, "source": "中华网军事"}, {"name": "F-47计划首飞时间", "value": "2028", "unit": "年", "year": 2026, "source": "中华网军事"}, {"name": "2027年预计服役数量", "value": "24-48", "unit": "架", "year": 2027, "source": "今日头条（自媒体视频）"}]}}

