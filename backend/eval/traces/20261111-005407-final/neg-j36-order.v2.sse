data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:29:00.779534", "content": {"results": [{"id": "sr_20ccb8", "title": "2026年自治区本级部门整体支出预算绩效目标表_退役军人事务厅", "source": "宁夏", "url": "https://tyjrt.nx.gov.cn/xxgk/zfxxgkml/czzj/czyjsjsgjf/202603/t20260318_5196421.html", "snippet": "2026年自治区本级部门整体支出预算绩效目标表\n发布时间:\n2026-03-18\n来源:\n自治区退役军人事务厅", "date": "2026-03-18T11:22:00+08:00"}, {"id": "sr_907cfa", "title": "2026年中央本级基本支出预算表", "source": "预算司", "url": "http://yss.mof.gov.cn/2026zyczys/202603/t20260324_3986016.htm", "snippet": "注:2026年预算大力压减中央部门会议、培训、委托课题等支出,从严从紧安排“三公”经费。本表中的“三公”经费、会议费、培训费等科目,反映的是行政单位和参公事业单位基本支出安排的情况,2026年预算增幅较高,主要是压减项目支出后,确需安排的相关经费由基本支出统筹安排。", "date": "2026-03-24T17:35:00+08:00"}, {"id": "sr_87a792", "title": "2026年部门综合预算政府采购(资产配置、购买服务)预算表--市发展和改革委员会", "source": "fgw.yanan.gov.cn", "url": "https://fgw.yanan.gov.cn/zfxxgk/fdzdgknr/zfcg/2044586564404752385.html", "snippet": "索引号\n11610600016074338E/2026-000085\n发布时间\n2026-03-20\n09:13", "date": "2026-03-20T09:13:00+08:00"}, {"id": "sr_52f240", "title": "2026年度支出预算表", "source": "华东师范大学", "url": "https://xxgk.ecnu.edu.cn/8f/92/c11923a757650/page.htm", "snippet": "2026年度支出预算表\n索取号:090909-2026-0017发布时间:2026-04-23浏览次数:10", "date": "2026-04-23T00:00:00+08:00"}, {"id": "sr_84be1c", "title": "2026年支出预算总表-信息公开网", "source": "信息公开网", "url": "https://xxgk.wust.edu.cn/info/2161/69742.htm", "snippet": "2026年支出预算总表\n发布时间:2026-02-23\n发布者:\n浏览次数:\n下一条:2025年支出预算总表\n【关闭】", "date": "2026-02-23T00:00:00+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:29:05.002585", "content": {"results": [{"id": "sr_86f2ae", "title": "政府采购合同书", "source": "苏州市财政局", "url": "https://czju.suzhou.gov.cn/zfcg/informations/rules/downFile.action?filePath=8aa07cab7b2f55a7017b85821ede2b53", "snippet": "牌、规格 单位 数量 单价(元) 总价(元) 1 无人机 大疆 Matrice300RTK 台357590.00 172770.00 2 无人机智能飞行电池 大疆Matrice300 TB60 组612000.00 72000.00 3 搭载镜头 大疆 禅思 H20T 个368150.00 204450.00 4 智能电池箱 大疆 BS60 件38715.00 26145.00 5 双云台组件 大疆 Matrice 300双云台组件 个31316.00 3948.00 6 夜间照明灯 大疆 GL60 台215229.00 30458.00 7 喊话器 大疆 MP130 台115229.00 15229.00 总报价(人民币大写):伍拾贰万伍仟元整 ¥: 525000.00 三、价格与支付 1、本合同(含税)总金额为人民币(大写):伍拾贰万伍仟元整(¥:525000.00),该金额包含本合同所采购全部货物及其包装、仓储、运输、各种税费、利润、质保、服务及与本合同有关的一切费用。", "date": "2025-02-28T19:15:05+08:00"}, {"id": "sr_41e4e7", "title": "二零二四年度航空航天设备采购合同范本6篇.docx-原创力文档", "source": "原创力文档", "url": "https://max.book118.com/html/2025/0120/5233142021012040.shtm", "snippet": "第三条合同价格 3.1设备单价 设备单价为人民币元/套。 3.2设备总价 设备总价为人民币万元整。 3.3付款方式及期限 甲方应在设备交付后个工作日内支付设备总价。 3.4付款条件 甲方支付设备总价前,需提供发数分配合同。 第十三条其他约定 13.1不可抗力 如遇不可抗力事件,导致合同无法履行或履行困难,双方应协商解决,并可根据不可抗力的影响程度部分或全部免除责任。 13.2合同保密", "date": "2025-01-21T18:50:47+08:00"}, {"id": "sr_9973c5", "title": "F-35单价9000万美元,歼-10C单价4亿,歼-16单价6亿,歼--今日头条", "source": "今日头条", "url": "https://www.toutiao.com/w/1597362302749725/", "snippet": "F-35单价9000万美元,歼-10C单价4亿,歼-16单价6亿,歼-20单价不详!//@乐活148638940:f35快两亿美元的价钱四周国家能装备多少架?中国需要1千到2千架三代机,如果全是歼20算过多少钱吗?又有什么用?//@009vc1:人家在加班生产的是f35.比你这领先一代呢 原内容已删除", "date": "2018-04-10T20:30:00+08:00"}, {"id": "sr_18ba8e", "title": "无人机产品购销合同公告-合同公示-机电设备采购平台", "source": "机电设备网", "url": "https://www.chinamae.com/purchases/dbc4e17be647d401f5c69d4b4942677e", "snippet": "基本信息 信息类型: 其他公告 区域: 山西 招标文件下载 我要报名 一、合同编号 : 11N ****** 020221 二、合同名称 : 无人机产品购销合同 三、项目编号 : ****** 100Y ****** 9 四、项目名称 : 办公信息化维护及完善经费 五、合同主体 采购人(甲方): ****** 建设局 地址: 旱西关街41号 联系方式: ****** 供应商(乙方): ****** 有限公司 地址: / 联系方式: ****** 六、合同主体信息 1.主要标的信息: 主要标的名称: 大疆无人机 数量: 1.00 单价(元): 24495.00 规格型号(或服务要求): MAVIC3 2.合同金额(元): 24495.00 3.履约期限、地点等简要信息: / 4.采购方式: 其他-其他 七、合同签订日期 : 九、其他补充事宜 : / 附件信息: 无人机产品购销合同.pdf 无人机验收单.pdf 查看项目详细信息 免登录浏览次数已用完,正文中****为隐藏内容,微信扫码登录后免费查看完整商机。 登录/注册", "date": "2022-11-09T19:34:56+08:00"}, {"id": "sr_0e9f75", "title": "歼16飞机模型采购项目比价成交公告-采招网", "source": "中国采招网", "url": "https://www.bidcenter.com.cn/news-318243873-4.html", "snippet": "歼16飞机模型采购项目比价成交公告 发布时间 2024-10-30 项目编号 点击查看 中标金额 15.8万元 采购规模走势 采购规模走势 通过数据统计分析,按月度提供全国近一年的 采购中标金额 的变化趋势分布情况。您可以通过分析结果合理的安排自己的投标活动。 立即试用 点击查看 招标单位 点击查看 联系人: 查看 企业联系人/联系方式 提供招标/代理/中标单位的 联系方式 ,可自主联系沟通。 立即试用 相关项目: 查看 累计招标金额: 查看 代理单位 点击查看 联系人: 查看 企业联系人/联系方式 提供招标/代理/中标单位的 联系方式 ,可自主联系沟通。 立即试用 相关项目: 查看 合作业主数量: 查看 中标单位 点击查看 联系人: 查看 企业联系人/联系方式 提供招标/代理/中标单位的 联系方式 ,可自主联系沟通。 立即试用 相关项目: 查看 累计中标金额: 查看 招标进展 招标正文 序号 成交供应商名称 成交供应商地址 成交金额(元) 1 辽宁 (略) (略) (略) 德太街 # 序号 名称 单位 数量 合计 备注 1 歼16飞机模型 项 1 #元 总计(元) #", "date": "2024-10-30T21:03:34+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:29:09.934982", "content": {"results": [{"id": "sr_609946", "title": "军工行业报告:面向2025,国防科技新质发展(38页)-并购家", "source": "并购家行业报告网", "url": "https://ipoipo.cn/post/23351.html", "snippet": "2024年全国财政安排国防支出预算16655.4亿元,增幅7.2%。我们认为,在当今世界“百年未有之大变局”背景下,面对复\n杂和严峻的国际安全形势,“加强练兵备战、统筹推进军事斗争准备,抓好实战化军事训练”成为主旋律,装备消耗及维修\n替换频率有望加快,全军国防开支或向装备采办费进一步倾斜,军工行业修复动能充足,看好“十四五”后期及“十五五”\n行业步入新发展阶段。\n我国国防支出占GDP的比重有望持续提升,目前依然远低于国际水平。从军费占GDP的比重角度看,我国国防支出占GDP的比\n例近年来进入小幅上升轨道,但仍显著小于2%的国际平均水平,2022年仅为1.20%,2023年仅1.22%,2024年按照草案预算提\n高至1.32%。我们认为,随着世界进入新的动荡变革期、我国安全形势不稳定不确定性增大,长期来看我国国防支出占GDP的\n比重预计将与国际水平看齐,有望维持持续快速增长态势,对武器装备的采购需求也将持续增加。\n文件下载\n资源名称:军工行业报告:面向2025,国防科技新质发展(38页)\n解压密码:", "date": "2026-05-26T12:53:17+08:00"}, {"id": "sr_7a6307", "title": "2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。", "source": "搜狐", "url": "https://www.sohu.com/a/992783010_162522?scm=10001.2024_13-101000-0_922.0-0.0-0-0-0-0.a2_5X151X618", "snippet": "2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。\n发布于:北京市\n2026.03.05\n12:45\n2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。#2026全国两会", "date": "2026-03-05T12:45:00+08:00"}, {"id": "sr_476854", "title": "国信证券-2026年军工行业军费变化点评:2026年国防预算同比+7%,连续11年稳健增长-行业分析-慧博投研资讯", "source": "慧博投研资讯", "url": "http://www.hibor.com.cn/data/1443141e952b4de81add20f5cf0f8953.html", "snippet": "事件:\n2026年3月5日,在第十四届全国人民代表大会第四次会议上提交的预算草案显示,2026年全国财政安排国防支出预算为19095.61亿元人民币,同比增长7%,连续11年保持个位数增长\n评论:\n2026年国防支出预算发布,同比增长7%,连续11年保持个位数增长\n根据新华社3月5日报道,在第十四届全国人民代表大会第四次会议上提交的预算草案显示,2026年全国财政安排国防支出预算为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。http://www.hibor.com.cn【慧博投研资讯】这是中国国防预算连续11年维持个位数增长。http://www.hibor.com.cn(慧博投研资讯)从2021年迄今的六年时间中,中国国防预算增幅始终维持在7%左右,保持了稳健的增长态势,中国国防费用的增速一贯强调“适度”原则,根据国防安全需要和国民经济发展保持协调增长,追求经济建设和国防建设均衡发展。面对美国军费突破万亿美元、欧洲及日本加速重整军备的国际形势,以及周边安全环境的新变化,中国军费增长正从过去的“补偿性增长”向“被动性增长”转变,进一步加快建设能够匹配战略态势、战场环境和军事技术变化的防御和威慑能力。\n打好建军一百年奋斗目标攻坚战,军工行业需求确定性强\n2026年是实现建军一百年奋斗目标的关键之年。根据两会精神,新的一年要继续深入贯彻强军思想,坚持党对人民军队的绝对领导,全面深入贯彻军委主席负责制。尽管国防预算增幅略有放缓,但在“打好实现建军一百年奋斗目标攻坚战”的刚性要求下,对于确保国防和军队现代化任务完成,特别是抓好军队建设“十四五”规划执行,加快实施国防发展重大工程,军工行业的需求依然明确且紧迫。与西方国家军费占GDP比重动辄超过2%甚至3%相比,我国国防支出占GDP比重长期保持在约1.5%以下,仍具有合理增长空间。预计随着“十四五”规", "date": "2026-03-10T08:58:08+08:00"}, {"id": "sr_3102e8", "title": "2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。..._网易视频", "source": "网易", "url": "https://m.163.com/v/video/VAMAVKS41.html", "snippet": "2026年我国国防支出为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。...", "date": "2026-03-05T12:43:41+08:00"}, {"id": "sr_b130ae", "title": "国信证券-2026年军工行业军费变化点评:2026年国防预算同比+7%,连续11年稳健增长-行业分析-慧博研究报告资讯", "source": "慧博研究报告资讯", "url": "https://wap.hibor.com.cn/data/1443141e952b4de81add20f5cf0f8953.html", "snippet": "事件:\n2026年3月5日,在第十四届全国人民代表大会第四次会议上提交的预算草案显示,2026年全国财政安排国防支出预算为19095.61亿元人民币,同比增长7%,连续11年保持个位数增长\n评论:\n2026年国防支出预算发布,同比增长7%,连续11年保持个位数增长\n根据新华社3月5日报道,在第十四届全国人民代表大会第四次会议上提交的预算草案显示,2026年全国财政安排国防支出预算为19095.61亿元人民币,同比增长7%,相较2025年的7.2%小幅下调。https://www.hibor.com.cn【慧博投研资讯】这是中国国防预算连续11年维持个位数增长。https://www.hibor.com.cn(慧博投研资讯)从2021年迄今的六年时间中,中国国防预算增幅始终维持在7%左右,保持了稳健的增长态势,中国国防费用的增速一贯强调“适度”原则,根据国防安全需要和国民经济发展保持协调增长,追求经济建设和国防建设均衡发展。面对美国军费突破万亿美元、欧洲及日本加速重整军备的国际形势,以及周边安全环境的新变化,中国军费增长正从过去的“补偿性增长”向“被动性增长”转变,进一步加快建设能够匹配战略态势、战场环境和军事技术变化的防御和威慑能力。\n打好建军一百年奋斗目标攻坚战,军工行业需求确定性强\n2026年是实现建军一百年奋斗目标的关键之年。根据两会精神,新的一年要继续深入贯彻强军思想,坚持党对人民军队的绝对领导,全面深入贯彻军委主席负责制。尽管国防预算增幅略有放缓,但在“打好实现建军一百年奋斗目标攻坚战”的刚性要求下,对于确保国防和军队现代化任务完成,特别是抓好军队建设“十四五”规划执行,加快实施国防发展重大工程,军工行业的需求依然明确且紧迫。与西方国家军费占GDP比重动辄超过2%甚至3%相比,我国国防支出占GDP比重长期保持在约1.5%以下,仍具有合理增长空间。预计随着“十四五", "date": "2026-03-10T08:58:08+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "thought", "agent": "DeepScout", "timestamp": "2026-11-10T23:29:12.667314", "content": {"agent": "DeepScout", "content": "发现更深层线索 (深度2): 歼-36 国防部 新闻发布会 回应 六代机, 歼-36 中国航空工业集团 官方 确认 首飞"}}

data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T23:29:12.667406", "content": {"agent": "DeepScout", "tool": "deep_search_follow_up", "queries": ["歼-36 国防部 新闻发布会 回应 六代机", "歼-36 中国航空工业集团 官方 确认 首飞"], "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:29:13.018996", "content": {"results": [{"id": "sr_992c1f", "title": "法广新闻昨晚(10月11日晚)写道:“【外媒:中国第六代战斗机很可能抢占先机、领先于美国】中国正力图在首款第六代战斗机的设计和部署方面超越美国:其庞大而令人印象", "source": "今日头条", "url": "https://www.toutiao.com/w/1878804889466052/", "snippet": "法广新闻昨晚(10月11日晚)写道:“【外媒:中国第六代战斗机很可能抢占先机、领先于美国】中国正力图在首款第六代战斗机的设计和部署方面超越美国:其庞大而令人印象深刻的歼作品声明:个人观点,仅供参考法广新闻昨晚(10月11日晚)写道:“【外媒:中国第六代战斗机很可能抢占先机、领先于美国】中国正力图在首款第六代战斗机的设计和部署方面超越美国:其庞大而令人印象深刻的歼-36原型机再次被发现飞行,似乎正在取得重大进展。”评几句:法广把“歼-36又飞了”写成“中国很可能抢跑六代机”,听着像夸咱们,其实是西方军媒的老套路。先惊呼中国领先,再反衬美国焦虑,接着倒逼北约加码军费。歼-36频繁试飞,说明成飞在隐身、无垂尾、大航程、有人/无人协同上确实走到工程验证阶段。但是我们还是保持理性,稳扎稳打,六代机比的不是谁先上天,而是谁先把作战体系跑通、成本压住、产业链不掉链子。", "date": "2026-10-12T09:19:00+08:00"}, {"id": "sr_bfe849", "title": "废寝忘食两个月后,五角大楼对歼36做出2个结论,坦率得出人意料|五角大楼|战斗机|战斗轰炸机|战机|歼36_手机网易网", "source": "网易", "url": "https://m.163.com/dy/article/L9JL3I78055670AK.html", "snippet": "自中国的歼-36六代机横空出世以来,就立马引起了世界各国的的关注。其中以美国为代表,五角大楼直接废寝忘食的加班两个月,对歼-36进行加急研究。两个月后,美国空军司令部得出两个结论,还公开发表在了社交平台上。结论之一是歼-36确实是毫不掺假的六代机,二则是歼-36是不折不扣的空优战机。此话一出,西方各国有些发懵,没想到美国竟然坦率得出人意料。\n打开网易新闻\n查看精彩图片\n歼-36的亮相并不是突如其来,早在24年12月26日的时候,这架新型的战斗机就已经在成都上空首次试飞亮相。当时外界普遍认为这是中国的第六代战斗机之一,机身上还有的数字编号让大家纷纷猜测它就是未来的歼-36。在这架战机一经亮相,就立刻引起了世界各国的一片热议。只不过碍于中国方面没有给出官方信息的原因,他们只能保持着这样的好奇心而无法得知真相。一直到25年3月17日的时候,这架歼-36战机再次在成都上空亮相。这一次这架战机显得格外豪横,上午和下午各自飞行了一次。相比较第一次亮相时,这次歼-36是独立完成飞行任务。旁边没有歼-20伴飞,它的起落架收起,三个发动机同时开启。根据当时亲眼目睹的一些军事爱好者看来,歼-36已经进入最高航速和极限机动能力的测试阶段。它的威力比起当年的歼-20来说简直是有过之而无不及啊!\n打开网易新闻\n查看精彩图片\n于中国而言,歼-36的问世无疑是中国国防工业迭代升级的重要里程碑,标志着中国综合国力实现了新一轮的实质性突破。而对长期对华保持战略警惕的美国而言,这一进展显然并非利好信号。究其根源,美国自身在第六代战机研发领域已陷入长期的技术僵持状态,始终未能取得突破性进展。正因如此,当疑似中国第六代战机的飞行器现身成都空域后,旋即引发美国空军高层的高度关注。美方第一时间归集相关情报资料,由(五角大楼)牵头组建专项团队,针对该型被外界指称为歼-36的全新战机开展专项研判。在随后的两个月周期内,", "date": "2026-10-19T10:44:15+08:00"}, {"id": "sr_f51a63", "title": "接受不了现实,俄罗斯曾一口咬定:中国新飞机根本不是六代机 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/article/7697343061080195603/", "snippet": "2026年9月中旬,成都飞机工业集团把一款大尺寸无尾飞行器的结构样机摆到了公众面前,三发布局、菱形主翼、巨大的机内弹舱,一下子把两年前那场圣诞节试飞留下的所有悬念给坐实了。这件事的重量,不在样机本身,而在它出现的时间点。就在两个月前,7月下旬流出的新一批图像里,这款被外界叫作歼-36的东方飞机已经迭代到第五架原型,无附面层隔道的超音速进气道、二元矢量喷口、机头和起落架都做了结构性修改。换句话说,当华盛顿还在为F-47的2028年首飞倒计时、伦敦还在为GCAP的资金桥接续命时,中国这边一年之内在跑道上甩出去五架构型不一样的真机。回头再看2024年年底俄罗斯媒体那句铁口直断——中国新飞机根本不是六代机——这话今天听着不像判断,倒更像是一个老江湖面对后生意外出手时下意识的辩解。两年前,俄罗斯卫星通讯社、俄罗斯军事观察网这类官方背景浓厚的媒体,几乎是同一个口径地给成都、沈阳同天首飞的两款机型贴了一个“五代加强版”的标签。他们罗列的理由在圈内不新鲜:没有达到4马赫以上的高速巡航、没有展现太空作战能力、无尾布局机动性存疑、气动更像前线轰炸机。这套话术翻译成人话就是——这玩意儿顶多算个加了隐身皮的苏-34,离真六代差着代差。我看到这些评价时第一反应不是生气,是觉得眼熟。冷战那会儿,苏联对美国F-117也是这么个评法,先说飞不动,再说只能挨揍,最后承认是武器平台的时候,自家的米格-1.44项目已经进了博物馆。老办法用在新对手身上,总是能骗一时骗不住一世。俄罗斯这口咬得死死的,根子不在中国飞机身上,而在他们自家那个PAK-DP项目上。这个被叫作米格-41的所谓六代截击机,2013年立项,2017年俄国家塔斯社喊出过要上太空、能打卫星、极速4马赫以上、带激光武器、用人工智能的全套豪华菜单,2021年俄罗斯国家技术集团公开说进入了研发阶段。听着多振奋人心,然而翻遍俄方公开资料,截至2026年9月", "date": "2026-10-17T11:08:00+08:00"}, {"id": "sr_b71cde", "title": "外媒:“歼-36”不只是第六代战斗机,空中指挥能力才是关键看点", "source": "网易新闻客户端", "url": "https://c.m.163.com/news/a/L92PSRE20535EZPK.html", "snippet": "中国正在试飞的“歼-36”隐身战机,正引发外界对下一代空中力量格局的更多关注。“歼-36”采用大型无尾布局,拥有宽大的机翼、三台发动机和充裕的内部空间,表明研发方向可能不局限于传统空战,而是兼顾远程作战、较大的内置载荷以及空中协同等任务。\n本文是马来西亚《亚洲国防安全》网站发布的一篇文章,由本人翻译并分享给大家。翻译此文章只是为了转述外国人员表达的一些看法,并非本人观点,希望大家能够理解。\n与美国F-47等下一代战斗机的竞争相比,真正值得关注的并不只是中国能否率先装备第六代战斗机,更在于新型作战平台能否融入现有作战体系,在复杂对抗环境下持续执行任务、协调支援力量并维持整体作战效能。一份展览资料将“歼-36”描述为重型多用途战斗机和空中指挥中心,展现了颇具雄心的设计构想:将目标指示与协同功能部署到更接近对抗激烈的空域。不过,“歼-36”的通信架构以及无人机控制能力,目前仍未得到公开证实。\n需要注意的是,“歼-36”目前仍处于研发试验阶段,外界流传的部分性能数据尚未得到独立验证。航空领域专家安德烈亚斯·鲁普雷希特曾将相关性能说法形容为“胡说八道”,这也提醒外界,应当区分真实存在的飞机研发项目与缺乏依据的宣传信息,避免据此夸大或误判地区空中力量的变化。\n“歼-36”这一名称目前并非官方正式命名,而是源自首架公开亮相的机体上显示的编号。外界普遍认为,“歼-36”项目与成都飞机工业集团有关,属于中国现有航空工业体系推进第六代战斗机研发的一部分。\n2024年12月26日,“歼-36”首次被公开观察到在成都上空飞行,当时一架双座型歼-20也出现在附近。此后,“歼-36”又以不同构型亮相,表明研发团队仍在探索气动外形、发动机安装方式和机体结构等设计。\n从外形和布局来看,“歼-36”的三发动机设计、宽大无尾机翼以及较大的内部容积,均与重型远程作战平台的定位相符。不过,这些特征只能反映其可能的", "date": "2026-10-12T22:42:00+08:00"}, {"id": "sr_59e9a7", "title": "外媒:“歼-36”不只是第六代战斗机,空中指挥能力才是关键看点_腾讯新闻", "source": "腾讯网", "url": "https://news.qq.com/rain/a/20261012A0BKLA00", "snippet": "中国正在试飞的“歼-36”隐身战机,正引发外界对下一代空中力量格局的更多关注。“歼-36”采用大型无尾布局,拥有宽大的机翼、三台发动机和充裕的内部空间,表明研发方向可能不局限于传统空战,而是兼顾远程作战、较大的内置载荷以及空中协同等任务。本文是马来西亚《亚洲国防安全》网站发布的一篇文章,由本人翻译并分享给大家。翻译此文章只是为了转述外国人员表达的一些看法,并非本人观点,希望大家能够理解。与美国F-47等下一代战斗机的竞争相比,真正值得关注的并不只是中国能否率先装备第六代战斗机,更在于新型作战平台能否融入现有作战体系,在复杂对抗环境下持续执行任务、协调支援力量并维持整体作战效能。一份展览资料将“歼-36”描述为重型多用途战斗机和空中指挥中心,展现了颇具雄心的设计构想:将目标指示与协同功能部署到更接近对抗激烈的空域。不过,“歼-36”的通信架构以及无人机控制能力,目前仍未得到公开证实。需要注意的是,“歼-36”目前仍处于研发试验阶段,外界流传的部分性能数据尚未得到独立验证。航空领域专家安德烈亚斯·鲁普雷希特曾将相关性能说法形容为“胡说八道”,这也提醒外界,应当区分真实存在的飞机研发项目与缺乏依据的宣传信息,避免据此夸大或误判地区空中力量的变化。“歼-36”这一名称目前并非官方正式命名,而是源自首架公开亮相的机体上显示的编号。外界普遍认为,“歼-36”项目与成都飞机工业集团有关,属于中国现有航空工业体系推进第六代战斗机研发的一部分。2024年12月26日,“歼-36”首次被公开观察到在成都上空飞行,当时一架双座型歼-20也出现在附近。此后,“歼-36”又以不同构型亮相,表明研发团队仍在探索气动外形、发动机安装方式和机体结构等设计。从外形和布局来看,“歼-36”的三发动机设计、宽大无尾机翼以及较大的内部容积,均与重型远程作战平台的定位相符。不过,这些特征只能反映其可能的设计方向,并", "date": "2026-10-12T21:42:43+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:29:23.173781", "content": {"results": [{"id": "sr_3cdaee", "title": "歼-36首飞成功！", "source": "今日头条", "url": "https://m.toutiao.com/w/1819941345564684/", "snippet": "歼-36首飞成功!\n2024年12月26日,中国成都飞机工业公司研制的第六代隐形战斗机歼-36成功首飞。就在几天前,12月22日,沈阳飞机工业集团也试飞了另一款六代机。这次歼-36首飞,由歼-20S伴飞,采用无尾三角翼布局,配备三个进气口,疑似三发动机设计。M国军方对此高度关注,26日紧急在五角大楼召开会议。西方媒体集体沉默,而国外军事网站和网友们却炸开了锅。\n这一系列动作,信息量巨大。中国航空技术发展迅猛,\"服役一代、研制一代、预研一代、探索一代\"的规律从未停止。歼-36的成功首飞,无疑是中国航空史上的又一里程碑。\n这背后究竟意味着什么?中国在下一盘很大的棋?", "date": "2024-12-31T23:48:00+08:00"}, {"id": "sr_99bf95", "title": "10月25日凌晨2:00,中国歼-35双座版成功首飞_网易视频", "source": "网易", "url": "https://m.163.com/v/video/VABTNPA45.html", "snippet": "10月25日凌晨2:00,中国歼-35双座版成功首飞\n10月25日凌晨2:00,中国歼-35双座版成功首飞\n声明:个人原创,仅供参考\n打开网易新闻\n体验效果更佳", "date": "2025-10-27T02:39:12+08:00"}, {"id": "sr_d9d390", "title": "中国六代机歼36四号原型机已完成首飞_网易视频", "source": "网易", "url": "https://m.163.com/v/video/VELN0VA2E.html", "snippet": "中国六代机歼36四号原型机已完成首飞\n中国六代机歼36四号原型机已完成首飞\n声明:取材网络、谨慎鉴别\n打开网易新闻\n体验效果更佳", "date": "2026-02-25T18:42:03+08:00"}, {"id": "sr_4db837", "title": "歼-36首飞震撼全球!西媒集体“失声”,缘何惧怕中国强大? - 天眼查", "source": "天眼查企业头条", "url": "https://news.tianyancha.com/ll_tu9aefdcqd.html", "snippet": "2024年12月24日,中国航空工业再次迎来了一个历史性的时刻——第六代战斗机歼-36在四川成都成功完成了其首次飞行测试。此次试飞不仅标志着中国航空科技取得了重大突破,也预示着中国在全球航空领域的地位得到了显著提升。然而,与国内的热烈反响不同,西方主流媒体对歼-36的首飞却选择了集体沉默,这一现象引发了广泛关注和讨论。歼-36的首飞测试于12月24日在成都飞机工业公司顺利进行,一架歼-20S战斗...查看全文成都飞机 点击查看更多信息 天眼风险 预警提醒 6 股权结构 股东持股与对外投资 情报动态", "date": "2024-05-07T14:40:08+08:00"}, {"id": "sr_9f6d0f", "title": "中国第六代战机歼36首飞成功", "source": "简书", "url": "https://www.jianshu.com/p/5a88e4f337e5", "snippet": "2024年底,歼-36的首飞成功寓意着中国已经拥有了第六代战机的作战体系。\n歼36仰视图\n歼-36是中国新一代隐形战斗机,采用了三台发动机设计,设计飞行速度约为3马赫,具备高后掠角和无尾布局,这些特性体现了其隐身设计的理念。其最大起飞重量约为50吨,可能是一款兼具战斗和轰炸能力的歼击轰炸机。若这么说的话,那么歼-36很明显是沿用了中国二代战斗机歼-7的作战设计。\n歼-36的设计强调隐身性能和远程能力,它采用无尾翼设计和翼身融合技术,以减少雷达特征。它的机体尺寸较大,机身长度约23米,翼展和机翼面积较大,提供了充足的内部空间和载重能力。此外,歼-36还具备高航程和大载弹量,内置武器舱可以容纳大型精确制导弹药,并且没有外挂,可见其高超的全向探测和侦察能力。\n歼-36的外观图\n在性能方面,歼-36具备极高的隐身性、适应性和技术集成,包括定向能武器(和种利用某种方式在物体表面产生极高的能量密度,从而使敌方的人员和电子设备、武器等受到伤害,产生强大杀伤力的武器)和嵌入传感器的“智能蒙皮”等,以实现无与伦比的态势感知。其设计理念被认为借鉴了美国的NGAD项目,但中国的发展方向可能与西方定义有所不同,反映了其独特的要求。\n歼-36有着多任务执行能力,具备超音速巡航能力,能够在不被敌方雷达发现的情况下,快速接近目标并实施精确打击。此外,歼-36的大型主武器舱可容纳大量空对地导弹,若包含8枚PL-17与6枚PL-15空空导弹,将会极具威慑力,即便是主弹仓仅挂载4枚PL-17导弹,两个副弹仓各挂载4枚PL-15空空导弹,也足以震慑亚洲范围内的国家。全新的作战体系、更为先进的弹药,而且弹药体积的进一步缩减能让弹仓能更高效地容纳更多导弹,使其不仅能够对空中目标构成威胁,还能有效打击地面和海上目标,真正实现了“一机多用”。是名副其实的“航空巡洋舰”\n另外,这次曝光的歼-36编号是“36011”,暗示", "date": "2025-01-10T03:38:36+08:00"}], "isIncremental": true, "searchType": "线索追踪", "depth": 2}}

data: {"type": "research_step", "agent": "DeepScout", "timestamp": "2026-11-10T23:29:45.602404", "content": {"step_type": "searching", "title": "信息检索", "subtitle": "全网深度搜索", "status": "completed", "stats": {"results_count": 264, "sources_count": 28}}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T23:29:45.602522", "content": {"results": [{"id": "fact_7dffaf97", "title": "2024年12月26日，一架编号含“36011”的无尾构型战机在成都上空首次试飞亮相，被外界普遍猜测为第六代战斗机“歼-36”。", "source": "网易（手机网易网）", "url": "", "snippet": "2024年12月26日，一架编号含“36011”的无尾构型战机在成都上空首次试飞亮相，被外界普遍猜测为第六代战斗机“歼-36”。", "date": "", "isSupplementary": false}, {"id": "fact_e5c4c4ab", "title": "2025年3月17日该机再次在成都上空试飞，起落架收起、三台发动机同时开启，据军事爱好者观察已进入高速与极限机动测试阶段。", "source": "网易（手机网易网）", "url": "", "snippet": "2025年3月17日该机再次在成都上空试飞，起落架收起、三台发动机同时开启，据军事爱好者观察已进入高速与极限机动测试阶段。", "date": "", "isSupplementary": false}, {"id": "fact_969dc338", "title": "有自媒体称2026年6月解放军官方账号“中国军号”在纪念运-20服役十周年视频中短暂出现菱形无尾翼战机并提及“小六”代号，被解读为官方间接确认；但该说法未获可核...", "source": "网易新闻客户端", "url": "", "snippet": "有自媒体称2026年6月解放军官方账号“中国军号”在纪念运-20服役十周年视频中短暂出现菱形无尾翼战机并提及“小六”代号，被解读为官方间接确认；但该说法未获可核实的官方原文佐证。", "date": "", "isSupplementary": false}, {"id": "fact_d8d61678", "title": "自媒体称截至2026年7月已出现第五架构型不同的歼-36原型机，9月展出结构样机，但均为非官方渠道信息，缺乏权威确认。", "source": "今日头条", "url": "", "snippet": "自媒体称截至2026年7月已出现第五架构型不同的歼-36原型机，9月展出结构样机，但均为非官方渠道信息，缺乏权威确认。", "date": "", "isSupplementary": false}, {"id": "fact_a67ecbf4", "title": "作为类比参考：美国NGAD项目（F-47）合同金额超过200亿美元，计划采购185架，单价约为F-35的三倍，首飞计划2028年、形成战斗力预计2030年代中期...", "source": "网易新闻客户端", "url": "", "snippet": "作为类比参考：美国NGAD项目（F-47）合同金额超过200亿美元，计划采购185架，单价约为F-35的三倍，首飞计划2028年、形成战斗力预计2030年代中期。此为美国六代机数据，非歼-36数据。", "date": "", "isSupplementary": false}, {"id": "fact_c1bb0de6", "title": "全部搜索结果中均未出现任何关于歼-36订单数量或单机合同价格的官方或权威数据，相关信息仅涉及原型机试飞、性能猜测与战略评论。", "source": "综合本次搜索结果", "url": "", "snippet": "全部搜索结果中均未出现任何关于歼-36订单数量或单机合同价格的官方或权威数据，相关信息仅涉及原型机试飞、性能猜测与战略评论。", "date": "", "isSupplementary": false}, {"id": "fact_96afe86e", "title": "2026年3月5日，第十四届全国人民代表大会第四次会议提交的预算草案显示，2026年全国财政安排国防支出预算为19095.61亿元人民币，同比增长7%，相较20...", "source": "慧博投研资讯（转引新华社/预算草案）", "url": "http://www.hibor.com.cn/data/1443141e952b4de81add20f5cf0f8953.html", "snippet": "2026年3月5日，第十四届全国人民代表大会第四次会议提交的预算草案显示，2026年全国财政安排国防支出预算为19095.61亿元人民币，同比增长7%，相较2025年的7.2%小幅下调。", "date": "", "isSupplementary": false}, {"id": "fact_dacde2a6", "title": "2026年中国国防预算连续11年维持个位数增长；2021年迄今六年国防预算增幅始终维持在7%左右。", "source": "国信证券-2026年军工行业军费变化点评（慧博投研资讯）", "url": "http://www.hibor.com.cn/data/1443141e952b4de81add20f5cf0f8953.html", "snippet": "2026年中国国防预算连续11年维持个位数增长；2021年迄今六年国防预算增幅始终维持在7%左右。", "date": "", "isSupplementary": false}, {"id": "fact_15aee56c", "title": "2026年3月10日，十四届全国人大四次会议解放军和武警部队代表团新闻发言人张晓刚介绍，2026年全国一般公共预算安排国防支出1.94万亿元，比上年执行数增长6...", "source": "中国财经信息网（转引张晓刚采访）", "url": "", "snippet": "2026年3月10日，十四届全国人大四次会议解放军和武警部队代表团新闻发言人张晓刚介绍，2026年全国一般公共预算安排国防支出1.94万亿元，比上年执行数增长6.9%，其中中央本级支出1.91万亿元，比上年执行数增长7%。", "date": "", "isSupplementary": false}, {"id": "fact_0e530901", "title": "官方披露2026年增加的国防支出主要用于推进机械化信息化智能化融合发展、提高捍卫国家主权安全发展利益战略能力等方向，但搜索结果未列出装备费比例、具体装备型号采购...", "source": "中国财经信息网（转引张晓刚采访）", "url": "", "snippet": "官方披露2026年增加的国防支出主要用于推进机械化信息化智能化融合发展、提高捍卫国家主权安全发展利益战略能力等方向，但搜索结果未列出装备费比例、具体装备型号采购合同或单机价格。", "date": "", "isSupplementary": false}, {"id": "fact_3f578797", "title": "2024年全国财政安排国防支出预算16655.4亿元，增幅7.2%。", "source": "并购家行业报告网《军工行业报告：面向2025，国防科技新质发展》", "url": "", "snippet": "2024年全国财政安排国防支出预算16655.4亿元，增幅7.2%。", "date": "", "isSupplementary": false}, {"id": "fact_f63aba7f", "title": "中国国防支出占GDP比例2022年为1.20%，2023年为1.22%，2024年按草案预算提高至1.32%，仍显著低于2%的国际平均水平。", "source": "并购家行业报告网《军工行业报告：面向2025，国防科技新质发展》", "url": "", "snippet": "中国国防支出占GDP比例2022年为1.20%，2023年为1.22%，2024年按草案预算提高至1.32%，仍显著低于2%的国际平均水平。", "date": "", "isSupplementary": false}, {"id": "fact_33231622", "title": "2025年中国国防支出预算增幅为7.2%。", "source": "搜狐（转引2026年全国两会报道）", "url": "", "snippet": "2025年中国国防支出预算增幅为7.2%。", "date": "", "isSupplementary": false}, {"id": "fact_615feb23", "title": "今日头条文章称，歼-36于2024年12月26日成功首飞，由成都飞机工业公司研制，由歼-20S伴飞，采用无尾三角翼布局、三个进气口，疑似三发动机设计。", "source": "今日头条", "url": "", "snippet": "今日头条文章称，歼-36于2024年12月26日成功首飞，由成都飞机工业公司研制，由歼-20S伴飞，采用无尾三角翼布局、三个进气口，疑似三发动机设计。", "date": "", "isSupplementary": false}, {"id": "fact_d2f4a003", "title": "天眼查企业头条文章称，歼-36于2024年12月24日在四川成都完成首次飞行测试，由成都飞机工业公司进行，一架歼-20S战斗机伴飞。", "source": "天眼查企业头条", "url": "", "snippet": "天眼查企业头条文章称，歼-36于2024年12月24日在四川成都完成首次飞行测试，由成都飞机工业公司进行，一架歼-20S战斗机伴飞。", "date": "", "isSupplementary": false}, {"id": "fact_fd13d1c9", "title": "简书文章称，歼-36于2024年底首飞成功，采用三台发动机设计，设计飞行速度约3马赫，最大起飞重量约50吨，机身长度约23米，采用无尾翼和翼身融合技术。", "source": "简书", "url": "", "snippet": "简书文章称，歼-36于2024年底首飞成功，采用三台发动机设计，设计飞行速度约3马赫，最大起飞重量约50吨，机身长度约23米，采用无尾翼和翼身融合技术。", "date": "", "isSupplementary": false}, {"id": "fact_84d4e3c5", "title": "网易视频称“中国六代机歼36四号原型机已完成首飞”，但该视频标注“取材网络、谨慎鉴别”，未提供官方来源。", "source": "网易视频", "url": "", "snippet": "网易视频称“中国六代机歼36四号原型机已完成首飞”，但该视频标注“取材网络、谨慎鉴别”，未提供官方来源。", "date": "", "isSupplementary": false}, {"id": "fact_ab6a32bf", "title": "今日头条视频标题称“官宣亮相!中国歼-36战机携AI战术系统,航程直逼8000公里”，但内容标注为自行拍摄，未提供中国航空工业集团、国防部等官方公告链接。", "source": "今日头条", "url": "", "snippet": "今日头条视频标题称“官宣亮相!中国歼-36战机携AI战术系统,航程直逼8000公里”，但内容标注为自行拍摄，未提供中国航空工业集团、国防部等官方公告链接。", "date": "", "isSupplementary": false}, {"id": "fact_1e7cc46f", "title": "本次搜索结果未包含中国航空工业集团、国防部、新华社等官方渠道对歼-36型号、订单数量或单机合同价格的确认或披露。", "source": "搜索结果综合", "url": "", "snippet": "本次搜索结果未包含中国航空工业集团、国防部、新华社等官方渠道对歼-36型号、订单数量或单机合同价格的确认或披露。", "date": "", "isSupplementary": false}, {"id": "fact_79ade658", "title": "本次搜索结果中未发现国防预算文件、采购批次、航展签约或采购合同等可验证歼-36订单数量与单机合同价格的权威线索。", "source": "搜索结果综合", "url": "", "snippet": "本次搜索结果中未发现国防预算文件、采购批次、航展签约或采购合同等可验证歼-36订单数量与单机合同价格的权威线索。", "date": "", "isSupplementary": false}]}}

