data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T21:06:08.829599", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "梳理全球及中国航空装备市场规模、增速与结构，重点分析军机、民机、通航、无人机和低空经济在十五五期间的需求空间与增长节奏。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["航空工业集团 十五五 市场空间 军机 民机 低空经济 市场规模 增速"]}, {"id": "sec_2", "title": "竞争格局", "description": "分析航空工业集团在军机整机、民机配套、通航和无人机领域的市场地位，梳理商飞、航天科工、民营航空企业及国际航空巨头的竞争合作关系。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["航空工业集团 竞争格局 军机整机 商飞 民机 通航 无人机 主要企业"]}, {"id": "sec_3", "title": "技术趋势", "description": "研究隐身、无人化、智能化、绿色航空、数字孪生、先进材料、航空发动机和机载系统等核心技术趋势，判断集团技术攻关与自主可控重点。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业 技术趋势 隐身 无人化 智能化 航空发动机 自主可控 数字孪生"]}, {"id": "sec_4", "title": "政策环境", "description": "梳理国防预算、低空经济、大飞机专项、国企改革深化提升行动、供应链安全和科技创新等政策，分析其对集团十五五战略主线的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 低空经济 大飞机专项 国企改革 航空工业 政策 十五五"]}, {"id": "sec_5", "title": "挑战机遇", "description": "识别军品需求波动、民机产业化风险、供应链卡脖子、国际适航与出口限制等挑战，同时把握低空经济、军贸出口、国产替代和深化改革带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业 挑战 机遇 供应链 卡脖子 低空经济 军贸 国产替代"]}, {"id": "sec_6", "title": "未来展望", "description": "展望十五五至2030年航空工业集团战略主线演进，判断以兴装强军为根本、以科技创新和自主可控为核心、以民机通航低空经济为增长极、以深化改革和国际化协同推进的发展趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业集团 2030 展望 十五五 战略主线 高质量发展 智能化 国际化"]}], "research_questions": ["航空工业集团十五五规划战略主线的核心表述、优先次序和量化目标是什么", "军机、民机、通航、无人机和低空经济等业务板块如何协同支撑战略主线", "科技创新、自主可控、深化改革、军贸国际化等关键举措如何落地并建立可验证的评估指标"]}}

