data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:13:26.808784", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'year': [2021, 2022, 2025, 2035], 'listed': [23, 25, np.nan, np.nan], 'staff': [45, 40, np.nan, np.nan], 'market': [np.nan, np.nan, 1.5, 3.5]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nax1 = plt.gca()\nax1.plot(df['year'], df['listed'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='上市公司数量（家）')\nax1.fill_between(df['year'], df['listed'], alpha=0.15, color='#6366f1')\nax1.plot(df['year'], df['staff'], color='#10b981', linewidth=2.5, marker='s', markersize=8, label='员工人数（万人）')\nax1.fill_between(df['year'], df['staff'], alpha=0.15, color='#10b981')\nfor x, y in zip(df['year'], df['listed']):\n    if not np.isnan(y):\n        ax1.annotate(str(int(y)), (x, y), textcoords='offset points', xytext=(0, 12), ha='center', fontsize=11, color='#6366f1', fontweight='bold')\nfor x, y in zip(df['year'], df['staff']):\n    if not np.isnan(y):\n        ax1.annotate(str(int(y)), (x, y), textcoords='offset points', xytext=(0, -18), ha='center', fontsize=11, color='#10b981', fontweight='bold')\nax2 = ax1.twinx()\nax2.plot(df['year'], df['market'], color='#f59e0b', linewidth=2.5, marker='^', markersize=8, label='低空经济市场规模（万亿元）')\nax2.fill_between(df['year'], df['market'], alpha=0.15, color='#f59e0b')\nfor x, y in zip(df['year'], df['market']):\n    if not np.isnan(y):\n        ax2.annotate(str(y), (x, y), textcoords='offset points', xytext=(0, 12), ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('企业指标（家 / 万人）', fontsize=14)\nax2.set_ylabel('低空经济市场规模（万亿元）', fontsize=14)\nplt.xticks([2021, 2022, 2025, 2035], fontsize=12)\nplt.yticks(fontsize=12)\nax2.tick_params(labelsize=12)\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=11, frameon=True)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

