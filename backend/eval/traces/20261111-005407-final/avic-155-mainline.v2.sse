discovered_at": "2026-11-10T21:06:33.601735"}, {"id": "node_18", "name": "中国民航局", "type": "policy", "discovered_at": "2026-11-10T21:06:33.601743"}, {"id": "node_19", "name": "C919", "type": "technology", "discovered_at": "2026-11-10T21:06:33.601753"}, {"id": "node_20", "name": "低空经济", "type": "policy", "discovered_at": "2026-11-10T21:06:33.601764"}, {"id": "node_21", "name": "共研产业咨询", "type": "company", "discovered_at": "2026-11-10T21:06:33.601775"}, {"id": "node_22", "name": "头豹研究院", "type": "company", "discovered_at": "2026-11-10T21:06:33.601781"}], "edges": [{"source": "数字孪生", "relation": "与航空发动机制造工艺相关", "discovered_at": "2026-11-10T21:06:30.333431"}, {"source": "数字孪生", "relation": "与智能生产线相关", "discovered_at": "2026-11-10T21:06:30.333442"}, {"source": "数字孪生", "relation": "与装配界面分析相关", "discovered_at": "2026-11-10T21:06:30.333444"}, {"source": "数字孪生", "relation": "与预测性维护相关", "discovered_at": "2026-11-10T21:06:30.333445"}, {"source": "航空发动机", "relation": "与智能制造相关", "discovered_at": "2026-11-10T21:06:30.333449"}, {"source": "航空发动机", "relation": "与AI设计优化相关", "discovered_at": "2026-11-10T21:06:30.333450"}, {"source": "航空发动机", "relation": "与可持续燃料/减排相关", "discovered_at": "2026-11-10T21:06:30.333452"}, {"source": "人工智能/机器学习", "relation": "与发动机结构模拟、性能预测、设计优化相关", "discovered_at": "2026-11-10T21:06:30.333456"}, {"source": "无人机/无人化", "relation": "被列为航空业未来技术趋势之一", "discovered_at": "2026-11-10T21:06:30.333467"}, {"source": "绿色航空/可持续航空燃料", "relation": "与减排、能源效率、电动化相关", "discovered_at": "2026-11-10T21:06:30.333471"}, {"source": "机载自动化系统", "relation": "与远程监控、数据分析、网络防御相关", "discovered_at": "2026-11-10T21:06:30.333474"}, {"source": "北京航空航天大学", "relation": "《航空学报》主办单位", "discovered_at": "2026-11-10T21:06:30.333478"}, {"source": "北京航空航天大学", "relation": "航空发动机与数字孪生研究机构", "discovered_at": "2026-11-10T21:06:30.333480"}, {"source": "中国知网/万方数据", "relation": "学术文献数据平台", "discovered_at": "2026-11-10T21:06:30.333483"}, {"source": "中国航空工业集团有限公司（AVIC）", "relation": "军机整机总体单位", "discovered_at": "2026-11-10T21:06:30.696248"}, {"source": "中国航空工业集团有限公司（AVIC）", "relation": "下辖100余家成员单位、25家上市公司", "discovered_at": "2026-11-10T21:06:30.696250"}, {"source": "中国航空工业集团有限公司（AVIC）", "relation": "业务含通用航空与无人机", "discovered_at": "2026-11-10T21:06:30.696251"}, {"source": "中国航空发动机集团有限公司", "relation": "航空装备产业格局主导者之一", "discovered_at": "2026-11-10T21:06:30.696254"}, {"source": "中国航空发动机集团有限公司", "relation": "与航空工业集团存在发动机配套/分立关系", "discovered_at": "2026-11-10T21:06:30.696255"}, {"source": "中国商用飞机有限责任公司（中国商飞）", "relation": "民机双核心之一", "discovered_at": "2026-11-10T21:06:30.696258"}, {"source": "中国商用飞机有限责任公司（中国商飞）", "relation": "与航空工业集团在民机整机与配套上形成竞合", "discovered_at": "2026-11-10T21:06:30.696259"}, {"source": "中国航天科工集团有限公司", "relation": "十大军工集团之一", "discovered_at": "2026-11-10T21:06:30.696262"}, {"source": "中国航天科工集团有限公司", "relation": "在无人机、导弹等领域与航空工业存在潜在竞争", "discovered_at": "2026-11-10T21:06:30.696263"}, {"source": "中外合资航空企业", "relation": "航空装备产业格局组成部分", "discovered_at": "2026-11-10T21:06:30.696267"}, {"source": "中外合资航空企业", "relation": "国际航空巨头在华合作载体", "discovered_at": "2026-11-10T21:06:30.696268"}, {"source": "通用航空", "relation": "集团产业板块之一", "discovered_at": "2026-11-10T21:06:30.696271"}, {"source": "通用航空", "relation": "低空经济载体", "discovered_at": "2026-11-10T21:06:30.696272"}, {"source": "无人机", "relation": "集团全谱系产品之一", "discovered_at": "2026-11-10T21:06:30.696275"}, {"source": "无人机", "relation": "有人到无人跨越的技术主线", "discovered_at": "2026-11-10T21:06:30.696277"}, {"source": "机载系统", "relation": "集团核心板块", "discovered_at": "2026-11-10T21:06:30.696280"}, {"source": "机载系统", "relation": "与关键材料/器件自主可控相关", "discovered_at": "2026-11-10T21:06:30.696281"}, {"source": "中国航空工业集团", "relation": "研究主体", "discovered_at": "2026-11-10T21:06:33.601727"}, {"source": "中国航空工业集团", "relation": "军机整机主导者（待验证）", "discovered_at": "2026-11-10T21:06:33.601730"}, {"source": "中国航空工业集团", "relation": "民机产业链参与者", "discovered_at": "2026-11-10T21:06:33.601732"}, {"source": "中国商飞", "relation": "C919主制造商", "discovered_at": "2026-11-10T21:06:33.601738"}, {"source": "中国商飞", "relation": "与航空工业在民机领域存在竞合（待验证）", "discovered_at": "2026-11-10T21:06:33.601740"}, {"source": "中国民航局", "relation": "低空经济市场规模预测发布方", "discovered_at": "2026-11-10T21:06:33.601747"}, {"source": "中国民航局", "relation": "空域与运行监管主体", "discovered_at": "2026-11-10T21:06:33.601750"}, {"source": "C919", "relation": "国产大飞机", "discovered_at": "2026-11-10T21:06:33.601755"}, {"source": "C919", "relation": "订单近1500架", "discovered_at": "2026-11-10T21:06:33.601758"}, {"source": "C919", "relation": "国产化率提升带动产业链", "discovered_at": "2026-11-10T21:06:33.601760"}, {"source": "低空经济", "relation": "十五五新增量", "discovered_at": "2026-11-10T21:06:33.601767"}, {"source": "低空经济", "relation": "2025年1.5万亿元预测", "discovered_at": "2026-11-10T21:06:33.601769"}, {"source": "低空经济", "relation": "空域开放与基础设施标准", "discovered_at": "2026-11-10T21:06:33.601772"}, {"source": "共研产业咨询", "relation": "航空市场规模数据来源", "discovered_at": "2026-11-10T21:06:33.601778"}, {"source": "头豹研究院", "relation": "商业航天市场规模数据来源", "discovered_at": "2026-11-10T21:06:33.601783"}]}, "stats": {"entitiesCount": 23, "relationsCount": 46}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T21:06:33.601968", "content": {"agent": "DeepScout", "section": "市场概况", "facts_count": 9, "duplicates_removed": 0, "data_points_count": 20, "insights": ["现有证据对“民机+低空经济为新增量”形成较强共识，但对“军机刚性需求托底”完全缺乏量化支撑，市场概况章节需补充军机采购/交付规模数据。", "低空经济规模预测存在严重口径冲突：民航局口径2025年1.5万亿元 vs 某产业链报告口径2025年3000亿元，相差5倍，说明该指标定义（是否含通用航空、无人机整机与运营、基础设施投资）尚未统一，引用时必须标注口径。", "航空装备制造口径（2022年1275亿元）与航空市场总口径（2022年6328.9亿元）差异巨大，说明“市场规模”在不同报告中含义不同（制造产值 vs 含运营服务），章节写作需明确区分制造端与服务端。"], "source_quality": "整体来源质量偏低（加权可信度约0.45）。9条结果中4条为同一篇“航空航天行业研究报告”在搜狐/新浪的多平台重复转载，作者为个人署名、原始机构不明，数据（1275亿元、6328.9亿元、C919订单）无法回溯至一手发布方；2条为雪球与东方财富股吧的自媒体/论坛帖，其中1条（东方财富股吧）正文为免责声明，无实质信息；1条为报告目录页，无数据价值。相对可信的是腾讯网转载《人民日报海外版》“国际论道”栏目对民航局低空经济预测的引述（0.75），但仍是转述而非民航局原文。所有关键数字均需通过官方统计公报、集团年报、民航局原始发布进行二次核验，当前不宜直接作为章节定稿数据使用。", "hypothesis_updates": 3, "search_results": [{"title": "低空经济", "url": "https://xueqiu.com/8131287424/320998671", "source": "雪球", "snippet": "低空经济 :\n中国民航局预测 , 到2025年 , 中国低空经济市场规模将达到1.5万亿元 , 到2035年有望达到3.5万亿元 。\n产业发展规划 : 以产业发展规划为引领 , 集聚发力 , 共同推动低空经济发展 。 培育龙头企业 , 推进规模经营 , 打造具有国际竞争力的低空经济产业集群 。\n- 基础设施建设 : 加强对新型起降场地 、 设施设备的研究 , 规范相关行业标准 , 加快健全基础设施保障体系 。 明确不同空域的服务和运行主体 , 增加涉及低空经济的各类航空器可飞空域 。\n- 安全运行监管 : 坚持统筹发展与安全 , 不断强化和落实个人 、 单位等低空经济参与者的主体责任 。 探索 “ 行业+社会 ” 的有效管理模式 , 建立健全跨部门 、 跨领域的低空联合监管机制 。\n:\n? ,", "date": "2025-01-20T07:22:00+08:00"}, {"title": "去年国内低空经济市场规模5千亿,中国民航局预测2025年市场规模将达到1.5万亿_恒天海龙(000677)股吧_东方财富网股吧", "url": "http://gubaf10.eastmoney.com/news,000677,1483279117.html", "source": "东方财富网股吧", "snippet": "郑重声明:用户在财富号/股吧/博客等社区发表的所有信息(包括但不限于文字、视频、音频、数据及图表)仅代表个人观点,与本网站立场无关,不对您构成任何投资建议,据此操作风险自担。 请勿相信代客理财、免费荐股和炒股培训等宣传内容,远离非法证券活动。请勿添加发言用户的手机号码、公众号、微博、微信及QQ等信息,谨防上当受骗!", "date": "2024-11-12T14:23:29+08:00"}, {"title": "航空航天行业研究报告_产业_制造_我国", "url": "https://business.sohu.com/a/785365837_482481", "source": "搜狐", "snippet": "我国在十四五规划中,将航空航天科技定位为“国家战略科技力量”,党的二十大报告也提出,要加快建设航天强国。根据共研产业咨询的数据,2022年我国航空市场规模为6328.9亿元;根据头豹研究院的数据,2021年我国商业航天市场规模达12626亿元。 (一)航空行业概况 1、市场规模及增长驱动因素 中国民用航空工业产值规模从2012年的1526.8亿元,跃升到2021年的 4161.6亿元,年均增速超17%。其中,航空制造行业规模持续增加,2022 年中国航空装备市场规模达1275亿元,近五年年均复合增长率为10.83%。同时,中国民航机队规模从2012年的1941架增长至2022年的4165架,年均复合增长率为7.9%。 未来国内民用航空产业的增长驱动力主要来自于国产大飞机的放量和低空经济的兴起等方面。我国是全球除美国以外最大民用飞机市场,国产民用飞机持续放量,截至2024年5月,C919的订单数量已接近1500架,市场规模预计达到1400亿美元,展现了其在全球民用飞机市场中的重要地位和巨大潜力;随着国产化率的提高,C919有望为产业链企业带来万亿元量级的市场规模。 利用低空资源发展通航产业,催生低空经济,已成为上上下下共同的认识。我国通航细分市场处于萌芽期,美国通用航空飞机的数目为24万架,美国对通航开放的民用机场有5500个,私人机场有12000多个;全美国取得初级飞行驾驶执照的人数超过100万,其中有80%以上的人从事通用航空飞行。相比之下,我国在册通用机场数量为449个,在册航空器总数3186架。 2、产业链及主要企业图谱 航空制造业产业链上游为原材料供应商、辅助材料供应商,中游航空零部件制造环节,下游为航空应用领域。飞机主机厂的内部配套企业是目前国内航空零部件制造业的主要参与者,科研院所与具备生产资质的民营企业形成补充。 根据航空产业网数据,2023年,我国航空产业全", "date": "2024-06-12T14:19:00+08:00"}, {"title": "中国民用航空行业深度分析及“十五五”发展规划指导报告_报告大厅www.chinabgao.com", "url": "https://www.chinabgao.com/report/16270199.html", "source": "报告大厅", "snippet": "第一章\n民用航空行业相关概述\n第一节\n民用航空行业定义及分类\n一、行业定义\n二、行业主要分类\n三、行业特性及在国民经济中的地位\n第二节\n民用航空行业统计标准\n一、统计部门和统计口径\n二、行业主要统计方法介绍\n三、行业涵盖数据种类介绍\n第三节\n“十四五”中国民用航空行业经济指标分析\n一、赢利性\n二、成长速度\n三、附加值的提升空间\n四、进入壁垒/退出机制\n五、风险性\n六、行业周期\n第二章\n民用航空行业“十五五”规划概述\n第一节\n“十四五”民用航空行业发展回顾\n一、“十四五”民用航空行业运行情况\n二、“十四五”民用航空行业发展特点\n三、“十四五”民用航空行业发展成就\n第二节\n民用航空行业“十五五”总体规划\n一、民用航空行业“十五五”规划纲要\n二、民用航空行业“十五五”规划指导思想\n三、民用航空行业“十五五”规划主要目标\n第三节\n“十五五”规划解读\n一、“十五五”规划的总体战略布局\n二、“十五五”规划对经济发展的影响\n三、“十五五”规划的主要精神解读\n第三章\n“十五五”期间经济环境分析\n第一节\n“十五五”期间世界经济发展趋势\n一、“十五五”期间世界经济将逐步恢复增长\n二、“十五五”期间经济全球化曲折发展\n三、“十五五”期间跨国投资再趋活跃\n第二节\n“十五五”期间我国经济面临的形势\n一、“十五五”期间我国经济将长期趋好\n二、“十五五”期间我国工业产业将全面升级\n第三节\n“十五五”期间我国对外经济贸易预测\n一、“十五五”期间我国劳动力结构预测\n二、“十五五”期间我国贸易形式和利用外资方式预测\n三、“十五五”期间我国自主创新结构预测\n四、“十五五”期间我国产业体系预测\n五、“十五五”期间我国产业竞争力预测\n六、“十五五”期间我国经济国家化预测\n第四章\n民用航空行业全球发展分析\n第一节\n全球民用航空市场总体情况分析\n一、全球民用航空行业的发展特点\n二、“十四五”全球民用航空市场结构\n三、", "date": "2024-12-27T06:35:30+08:00"}, {"title": "航空航天行业研究报告", "url": "https://m.sohu.com/a/785365837_482481/?pvid=000115_3w_a", "source": "手机搜狐网", "snippet": "作者:柳玉珍\n一、航空航天行业整体概况\n 我国在十四五规划中,将航空航天科技定位为“国家战略科技力量”,党的二十大报告也提出,要加快建设航天强国。根据共研产业咨询的数据,2022年我国航空市场规模为6328.9亿元;根据头豹研究院的数据,2021年我国商业航天市场规模达12626亿元。\n (一)航空行业概况\n 1、市场规模及增长驱动因素\n 中国民用航空工业产值规模从2012年的1526.8亿元,跃升到2021年的 4161.6亿元,年均增速超17%。其中,航空制造行业规模持续增加,2022 年中国航空装备市场规模达1275亿元,近五年年均复合增长率为10.83%。同时,中国民航机队规模从2012年的1941架增长至2022年的4165架,年均复合增长率为7.9%。\n 未来国内民用航空产业的增长驱动力主要来自于国产大飞机的放量和低空经济的兴起等方面。我国是全球除美国以外最大民用飞机市场,国产民用飞机持续放量,截至2024年5月,C919的订单数量已接近1500架,市场规模预计达到1400亿美元,展现了其在全球民用飞机市场中的重要地位和巨大潜力;随着国产化率的提高,C919有望为产业链企业带来万亿元量级的市场规模。\n 利用低空资源发展通航产业,催生低空经济,已成为上上下下共同的认识。我国通航细分市场处于萌芽期,美国通用航空飞机的数目为24万架,美国对通航开放的民用机场有5500个,私人机场有12000多个;全美国取得初级飞行驾驶执照的人数超过100万,其中有80%以上的人从事通用航空飞行。相比之下,我国在册通用机场数量为449个,在册航空器总数3186架。\n 2、产业链及主要企业图谱\n 航空制造业产业链上游为原材料供应商、辅助材料供应商,中游航空零部件制造环节,下游为航空应用领域。飞机主机厂的内部配套企业是目前国内航空零部件制造业的主要参与者,科研院所与具备生产资质的民营企业形", "date": "2024-06-12T22:19:00+08:00"}, {"title": "“据中国民航局预估，到2025年，“低空经济”市场规模将达1.5万亿元，到203", "url": "http://mguba.eastmoney.com/mguba/article/0/1507854456", "source": "东方财富网股吧", "snippet": "“据中国民航局预估,到2025年,“低空经济”市场规模将达1.5万亿元,到2035年将达3.5万亿元。”", "date": "2025-01-10T20:05:48+08:00"}, {"title": "航空航天行业研究报告", "url": "https://k.sina.cn/article_1256707327_4ae7d4ff00101h552.html?from=mil", "source": "新浪看点", "snippet": "作者:柳玉珍\n一、航空航天行业整体概况\n我国在十四五规划中,将航空航天科技定位为“国家战略科技力量”,党的二十大报告也提出,要加快建设航天强国。根据共研产业咨询的数据,2022年我国航空市场规模为6328.9亿元;根据头豹研究院的数据,2021年我国商业航天市场规模达12626亿元。\n(一)航空行业概况\n1、市场规模及增长驱动因素\n中国民用航空工业产值规模从2012年的1526.8亿元,跃升到2021年的 4161.6亿元,年均增速超17%。其中,航空制造行业规模持续增加,2022 年中国航空装备市场规模达1275亿元,近五年年均复合增长率为10.83%。同时,中国民航机队规模从2012年的1941架增长至2022年的4165架,年均复合增长率为7.9%。\n未来国内民用航空产业的增长驱动力主要来自于国产大飞机的放量和低空经济的兴起等方面。我国是全球除美国以外最大民用飞机市场,国产民用飞机持续放量,截至2024年5月,C919的订单数量已接近1500架,市场规模预计达到1400亿美元,展现了其在全球民用飞机市场中的重要地位和巨大潜力;随着国产化率的提高,C919有望为产业链企业带来万亿元量级的市场规模。\n利用低空资源发展通航产业,催生低空经济,已成为上上下下共同的认识。我国通航细分市场处于萌芽期,美国通用航空飞机的数目为24万架,美国对通航开放的民用机场有5500个,私人机场有12000多个;全美国取得初级飞行驾驶执照的人数超过100万,其中有80%以上的人从事通用航空飞行。相比之下,我国在册通用机场数量为449个,在册航空器总数3186架。\n2、产业链及主要企业图谱\n航空制造业产业链上游为原材料供应商、辅助材料供应商,中游航空零部件制造环节,下游为航空应用领域。飞机主机厂的内部配套企业是目前国内航空零部件制造业的主要参与者,科研院所与具备生产资质的民营企业形成补充。\n根据航", "date": "2024-06-12T22:19:00+08:00"}, {"title": "低空经济产业链发展及投资前景分析报告_市场_规模_全球", "url": "https://www.sohu.com/a/839288479_468661", "source": "搜狐", "snippet": "低空经济是指在地面以上高度低于 3000 米的空域内,涉及航空器的运营、管理、服务及相关产业链的经济活动。 近年来,随着无人机技术的迅速发展、政策支持的不断加强以及市场需求的日益增加,低空经济的发展势头显著。 根据市场研究机构的预测,全球低空经济市场规模将在 2025 年达到 4000亿美元,年均增长率约为15%。 中国作为全球低空经济的重要市场,预计在未来五年内,市场规模将从2020年的 350 亿元人民币增长至 2025 年的 3000 亿元人民币。", "date": "2024-12-19T06:00:00+08:00"}, {"title": "中国“低空经济”如何成为发展“新引擎”(国际论道)", "url": "https://view.inews.qq.com/a/20250224A01LMP00?scene=qqsearch", "source": "腾讯网", "snippet": "据中国民用航空局预估,2025年中国“低空经济”市场规模将达1.5万亿元,到2035年有望达到3.5万亿元。该报道指出,除了“空中出租车”、无人机派送外卖和救援物资等,“低空经济”也可用于高效物流、航拍测绘、农林植保、旅游观光、港口管理、海事巡查、巡护巡检等。此外,现代飞艇也是中国“低空经济”的一部分。", "date": "2025-02-24T08:38:56+08:00"}, {"title": "航空航天行业研究报告", "url": "https://k.sina.cn/article_1256707327_4ae7d4ff00101h552.html?from=news", "source": "新浪看点", "snippet": "关注 \n作者:柳玉珍\n一、航空航天行业整体概况\n我国在十四五规划中,将航空航天科技定位为“国家战略科技力量”,党的二十大报告也提出,要加快建设航天强国。根据共研产业咨询的数据,2022年我国航空市场规模为6328.9亿元;根据头豹研究院的数据,2021年我国商业航天市场规模达12626亿元。\n(一)航空行业概况\n1、市场规模及增长驱动因素\n中国民用航空工业产值规模从2012年的1526.8亿元,跃升到2021年的 4161.6亿元,年均增速超17%。其中,航空制造行业规模持续增加,2022 年中国航空装备市场规模达1275亿元,近五年年均复合增长率为10.83%。同时,中国民航机队规模从2012年的1941架增长至2022年的4165架,年均复合增长率为7.9%。\n未来国内民用航空产业的增长驱动力主要来自于国产大飞机的放量和低空经济的兴起等方面。我国是全球除美国以外最大民用飞机市场,国产民用飞机持续放量,截至2024年5月,C919的订单数量已接近1500架,市场规模预计达到1400亿美元,展现了其在全球民用飞机市场中的重要地位和巨大潜力;随着国产化率的提高,C919有望为产业链企业带来万亿元量级的市场规模。\n利用低空资源发展通航产业,催生低空经济,已成为上上下下共同的认识。我国通航细分市场处于萌芽期,美国通用航空飞机的数目为24万架,美国对通航开放的民用机场有5500个,私人机场有12000多个;全美国取得初级飞行驾驶执照的人数超过100万,其中有80%以上的人从事通用航空飞行。相比之下,我国在册通用机场数量为449个,在册航空器总数3186架。\n2、产业链及主要企业图谱\n航空制造业产业链上游为原材料供应商、辅助材料供应商,中游航空零部件制造环节,下游为航空应用领域。飞机主机厂的内部配套企业是目前国内航空零部件制造业的主要参与者,科研院所与具备生产资质的民营企业形成补充。", "date": "2024-06-12T22:19:00+08:00"}], "extracted_facts": [{"content": "中国民航局预测，中国低空经济市场规模2025年将达到1.5万亿元，2035年有望达到3.5万亿元。", "source_name": "雪球（转述民航局预测）", "source_url": "https://xueqiu.com/8131287424/320998671", "credibility": 0.35}, {"content": "中国民航局预估2025年中国低空经济市场规模达1.5万亿元、2035年达3.5万亿元，应用场景包括空中出租车、无人机配送、物流、航拍测绘、农林植保、旅游观光、港口管理、海事巡查、巡检等。", "source_name": "腾讯网（转载《人民日报海外版》“国际论道”栏目）", "source_url": "https://view.inews.qq.com/a/20250224A01LMP00?scene=qqsearch", "credibility": 0.75}, {"content": "2022年中国航空装备市场规模达1275亿元，近五年年均复合增长率为10.83%；中国民用航空工业产值从2012年1526.8亿元增至2021年4161.6亿元，年均增速超17%。", "source_name": "搜狐财经（转载航空航天行业研究报告，作者柳玉珍）", "source_url": "https://business.sohu.com/a/785365837_482481", "credibility": 0.55}, {"content": "中国民航机队规模从2012年1941架增长至2022年4165架，年均复合增长率7.9%；2022年我国航空市场规模（含航天口径另计）为6328.9亿元（引自共研产业咨询）。", "source_name": "新浪看点（转载航空航天行业研究报告，作者柳玉珍）", "source_url": "https://k.sina.cn/article_1256707327_4ae7d4ff00101h552.html?from=mil", "credibility": 0.55}, {"content": "截至2024年5月，C919订单数量接近1500架，对应市场规模预计约1400亿美元；随着国产化率提升，C919有望为产业链带来万亿元级市场规模。国产大飞机放量与低空经济兴起被列为未来国内民用航空产业的主要增长驱动力。", "source_name": "搜狐财经（转载航空航天行业研究报告）", "source_url": "https://business.sohu.com/a/785365837_482481", "credibility": 0.55}, {"content": "我国通航细分市场处于萌芽期；美国通用航空飞机约24万架，对通航开放的民用机场5500个、私人机场12000多个，中国通航保有量与基础设施差距显著，隐含长期增长空间。", "source_name": "搜狐财经（转载航空航天行业研究报告）", "source_url": "https://business.sohu.com/a/785365837_482481", "credibility": 0.5}, {"content": "全球低空经济市场规模预计2025年达4000亿美元，年均增长率约15%；中国低空经济市场规模预计从2020年350亿元增长至2025年3000亿元。", "source_name": "搜狐（低空经济产业链发展及投资前景分析报告）", "source_url": "https://www.sohu.com/a/839288479_468661", "credibility": 0.45}, {"content": "低空经济发展路径包括：以产业发展规划为引领培育龙头企业和具有国际竞争力的产业集群、加强新型起降场地与设施设备标准建设、明确不同空域服务与运行主体并扩大可飞空域、建立跨部门跨领域低空联合监管机制。", "source_name": "雪球", "source_url": "https://xueqiu.com/8131287424/320998671", "credibility": 0.35}], "data_points": [{"name": "中国低空经济市场规模", "value": "1.5", "unit": "万亿元", "year": 2025, "source": "雪球（转述民航局预测）"}, {"name": "中国低空经济市场规模", "value": "3.5", "unit": "万亿元", "year": 2035, "source": "雪球（转述民航局预测）"}, {"name": "中国低空经济市场规模", "value": "1.5", "unit": "万亿元", "year": 2025, "source": "腾讯网（转载《人民日报海外版》“国际论道”栏目）"}, {"name": "中国低空经济市场规模", "value": "3.5", "unit": "万亿元", "year": 2035, "source": "腾讯网（转载《人民日报海外版》“国际论道”栏目）"}, {"name": "中国航空装备市场规模", "value": "1275", "unit": "亿元", "year": 2022, "source": "搜狐财经（转载航空航天行业研究报告，作者柳玉珍）"}, {"name": "中国航空装备市场近五年CAGR", "value": "10.83", "unit": "%", "year": 2022, "source": "搜狐财经（转载航空航天行业研究报告，作者柳玉珍）"}, {"name": "中国民用航空工业产值", "value": "1526.8", "unit": "亿元", "year": 2012, "source": "搜狐财经（转载航空航天行业研究报告，作者柳玉珍）"}, {"name": "中国民用航空工业产值", "value": "4161.6", "unit": "亿元", "year": 2021, "source": "搜狐财经（转载航空航天行业研究报告，作者柳玉珍）"}, {"name": "中国民航机队规模", "value": "1941", "unit": "架", "year": 2012, "source": "新浪看点（转载航空航天行业研究报告，作者柳玉珍）"}, {"name": "中国民航机队规模", "value": "4165", "unit": "架", "year": 2022, "source": "新浪看点（转载航空航天行业研究报告，作者柳玉珍）"}]}}

