data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:13:10.674681", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2020, 2023, 2025, 2030, 2035], 'Scale': [350, 5059.5, 15000, 20000, 35000]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nplt.figure(figsize=(12, 7), dpi=200)\ncolors = ['#a5b4fc', '#818cf8', '#6366f1', '#06b6d4', '#10b981']\nbars = plt.bar(df['Year'].astype(str), df['Scale'], color=colors, width=0.6, edgecolor='white')\nfor b, v in zip(bars, df['Scale']):\n    plt.text(b.get_x() + b.get_width() / 2, v + 900, f'{v:,.0f}', ha='center', fontsize=12, fontweight='bold', color='#1f2937')\nplt.plot(df['Year'].astype(str), df['Scale'], color='#f59e0b', linewidth=2.5, marker='o', markersize=8, label='市场规模趋势')\nplt.fill_between(range(len(df)), df['Scale'], alpha=0.08, color='#6366f1')\nplt.title('低空经济市场规模：航空工业集团十五五战略主线', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('市场规模（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.legend(fontsize=12, loc='upper left')\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从数据中提炼航空工业集团十五五规划的战略主线：以低空经济为核心增长极（2020年350亿元→2023年5059.5亿元→2025年1.5万亿元→2030年2万亿元→2035年3.5万亿元），叠加民机（C919订单近1500架、对应1400亿美元市场）与军机装备升级（航空装备市场1275亿元、CAGR 10.83%）。代码选取低空经济市场规模这一最具代表性的时间序列，做类型清洗、去重与缺失值处理，并生成柱状+折线复合的专业商业图表，直观呈现战略主线的量级跃迁。"}}

