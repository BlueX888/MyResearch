data: {"type": "action", "agent": "DeepScout", "timestamp": "2026-11-10T21:06:49.497290", "content": {"agent": "DeepScout", "tool": "deep_search_source_tracing", "queries": ["中国民航局官网 低空经济 2025年 1.5万亿元 2035年 3.5万亿元 原始发布", "中国民航局 低空经济 市场规模 预测 1.5万亿 3.5万亿 site:caac.gov.cn"], "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:06:49.704272", "content": {"results": [{"id": "sr_22847c", "title": "“据中国民航局预估，到2025年，“低空经济”市场规模将达1.5万亿元，到203", "source": "东方财富网股吧", "url": "http://mguba.eastmoney.com/mguba/article/0/1507854456", "snippet": "“据中国民航局预估,到2025年,“低空经济”市场规模将达1.5万亿元,到2035年将达3.5万亿元。”", "date": "2025-01-10T20:05:48+08:00"}, {"id": "sr_94e8c7", "title": "低空经济", "source": "雪球", "url": "https://xueqiu.com/8131287424/320998671", "snippet": "低空经济 :\n中国民航局预测 , 到2025年 , 中国低空经济市场规模将达到1.5万亿元 , 到2035年有望达到3.5万亿元 。\n产业发展规划 : 以产业发展规划为引领 , 集聚发力 , 共同推动低空经济发展 。 培育龙头企业 , 推进规模经营 , 打造具有国际竞争力的低空经济产业集群 。\n- 基础设施建设 : 加强对新型起降场地 、 设施设备的研究 , 规范相关行业标准 , 加快健全基础设施保障体系 。 明确不同空域的服务和运行主体 , 增加涉及低空经济的各类航空器可飞空域 。\n- 安全运行监管 : 坚持统筹发展与安全 , 不断强化和落实个人 、 单位等低空经济参与者的主体责任 。 探索 “ 行业+社会 ” 的有效管理模式 , 建立健全跨部门 、 跨领域的低空联合监管机制 。\n:\n? ,", "date": "2025-01-20T07:22:00+08:00"}, {"id": "sr_c64b5e", "title": "中国今年低空经济市场规模预计将达1.5万亿元__财经头条__新浪财经", "source": "财经头条", "url": "https://cj.sina.com.cn/articles/view/5115326071/130e5ae7702002prfm?finpagefr=p_104", "snippet": "格隆汇11月23日|据央视,从正在江西举行的2025中国航空产业大会上获悉,预计2025年我国低空经济市场规模将达到1.5万亿元,2030年有望突破2万亿元,产业发展呈现强劲增长态势。", "date": "2025-11-23T10:51:00+08:00"}, {"id": "sr_6dc656", "title": "委员会客厅聚焦低空经济发展,贺增林、王争光、蓝国庆建言", "source": "腾讯网", "url": "https://new.qq.com/rain/a/20250122A05BH000", "snippet": "瞭望·2025      “低空经济”      中国民航局的预测数据显示,我国低空经济市场规模在2025年将达到1.5万亿元,2035年有望达到3.5万亿元。      作为战略性新兴产业,低空经济正成为推动经济发展的新质生产力和增长新引擎。为抢占低空经济新赛道,各地正在加快布局,我省也不例外,今年省政府工作报告中提出“制定低空经济发展行动方案”。", "date": "2025-01-22T22:00:53+08:00"}, {"id": "sr_af96a9", "title": "我国低空经济市场规模预计今年达1.5万亿元", "source": "yzdsb.hebnews.cn", "url": "https://yzdsb.hebnews.cn/pad/paper/c/202511/24/content_291621.html", "snippet": "低空经济作为国家战略性新兴产业,近年来实现跨越式发展,我国已从低空装备技术追赶阶段,逐步迈向局部引领的关键转变。记者从正在江西举行的2025中国航空产业大会上获悉,预计2025年我国低空经济市场规模将达到1.5万亿元,2030年有望突破2万亿元,产业发展呈现强劲增长态势。(央视新闻)", "date": "2025-11-24T00:00:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:06:58.691302", "content": {"results": [{"id": "sr_5ae95c", "title": "民航局规划:2025年通用航空与低空经济将迎来新机遇_无人机_服务_应用", "source": "搜狐", "url": "https://www.sohu.com/a/847068530_121798711", "snippet": "近日,北京商报报道,民航局在1月9日的全国民航工作会议上透露,计划在2025年大力推进通用航空和低空经济的发展。这一举措不仅将为航空市场带来新的增长点,还将增强低空飞行的安全性和服务保障,开辟更为广泛的应用场景。 努力夯实低空飞行安全管控 2025年民航局的工作计划中,安全始终是核心要素。低空飞行的复杂性和多样性证实了提升安全管控基础的重要性。", "date": "2025-01-09T11:51:00+08:00"}, {"id": "sr_675804", "title": "2025亚洲通用航空展,\"十五五\"规划助力低空经济迎来巨大机遇#海峡新干线 #亚洲通用航空展 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/video/7577714215432617999/", "snippet": "展开2025亚洲通用航空展,\"十五五\"规划助力低空经济迎来巨大机遇#海峡新干线\n#亚洲通用航空展播放\n1004发布于\n2025-11-28\n18:01", "date": "2025-11-28T18:01:00+08:00"}, {"id": "sr_d05325", "title": "2025航空工业大会", "source": "中国制造网展会频道", "url": "https://zhanhui.cn.made-in-china.com/fairs/fairs-detail-OBxQFXNzLmWK/2025%E8%88%AA%E7%A9%BA%E5%B7%A5%E4%B8%9A%E5%A4%A7%E4%BC%9A.html", "snippet": "航空装备制造、民航运输设备、通用航空技术、航空材料与工艺、适航审定技术、航空试验检测设备、人工智能在航空中的应用、低空经济相关产品与服务、航空供应链解决方案等。", "date": "2025-09-04T00:00:00+08:00"}, {"id": "sr_a1033c", "title": "政府工作报告将“低空经济”列入2025年重点工作，要求“加快布局低空经济发展，打", "source": "东方财富网股吧", "url": "http://mguba.eastmoney.com/mguba/article/0/1510709575", "snippet": "点赞 1 评论: 2 收藏\n分享到:\n 政府工作报告将“低空经济”列入2025年重点工作,要求“加快布局低空经济发展,打造低空制造产业高地”。 \n 郑重声明:用户在财富号/股吧/博客等社区发表的所有信息(包括但不限于文字、视频、音频、数据及图表)仅代表个人观点,与本网站立场无关,不对您构成任何投资建议,据此操作风险自担。 请勿相信代客理财、免费荐股和炒股培训等宣传内容,远离非法证券活动。请勿添加发言用户的手机号码、公众号、微博、微信及QQ等信息,谨防上当受骗!", "date": "2025-01-20T22:03:15+08:00"}, {"id": "sr_ed6230", "title": "一图读懂丨《民用航空发展“十五五”规划》-顶端新闻", "source": "www.topnews.cn", "url": "https://www.topnews.cn/news/145ED5EC40BF4D75", "snippet": "来源:中国民航局网站【编辑:蔡星雨】\n免责声明:本文由顶端号作者上传发布,仅代表作者观点,顶端新闻仅提供信息发布平台。如文章内容涉及侵权或其他问题,请30日内与本平台联系,反映情况属实我们将第一时间删除。", "date": "2026-08-07T15:52:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:07:12.632066", "content": {"results": [{"id": "sr_d5c08c", "title": "中国飞机制造行业竞争派系_图表数据库 - 悟空智库", "source": "建设中", "url": "https://www.wkzk.com/chart/131381.html", "snippet": "飞机制造行业具有较高的资金、技术与资质壁垒,因此国内的飞机制造行业的主要市场参与者均为国有集团企业。在国内的飞机制造领域,形成了以中国商飞和中航工业集团为双核心的民用军用飞机制造体系。报告出处点此查看报告原文>>", "date": "2022-07-19T07:50:44+08:00"}, {"id": "sr_23b384", "title": "中国飞机制造及修理行业竞争对手分析报告 - 豆丁网", "source": "豆丁网", "url": "https://www.docin.com/mobile/detail.do?id=421736179", "snippet": "中国飞机制造及修理行业竞争对手分析报告,中国飞机制造及修理行业竞争对手分析报告,涓浗,绔炰簤,鍒嗘瀽,瀵规墜,淇悊", "date": "2012-06-12T09:48:10+08:00"}, {"id": "sr_1c51a3", "title": "2019年中国飞机制造行业分析报告-", "source": "行业数据网", "url": "https://www.chinabaogao.com/pdf/92/24/379224.pdf", "snippet": "2019年中国飞机制造行业分析报告- 市场竞争格局与未来趋势预测 报告大纲 观研报告网 www.chinabaogao.com 一、报告简介 观研报告网发布的《2019年中国飞机制造行业分析报告-市场竞争格局与未来趋势预测》涵 盖行业最新数据,市场热点,政策规划,竞争情报,市场前景预测,投资策略等内容。更辅 以大量直观的图表帮助本行业企业准确把握行业发展态势、市场商机动向、正确制定企业竞", "date": "2019-01-01T00:00:00+08:00"}, {"id": "sr_33d1df", "title": "飞机制造研究报告_2021-2025年中国飞机制造行业竞争分析及发展前景预测报告_中国行业研究网", "source": "中研网", "url": "https://www.chinairn.com/report/20201230/10192332.html", "snippet": "2021-2025年中国飞机制造行业竞争分析及发展前景预测报告 Annual Research and Consultation Report of Panorama survey and Investment strategy on China Industry 报告编号: 1779875 出版日期: 2020年12月 报告页码: 300 页 图表数量: 150 个 寄送方式: Email 发送 或 特快专递 中文版全价: RMB 13000 电子版: RMB 12500 印刷版: RMB 12500 英文版全价: USD 6500 电子版: USD 6000 印刷版: USD 6000 服务热线: 400-856-5388 400-086-5388 订阅热线: 0755- 25425716 25425726 25425736 0755- 25425756 25425776 25425706 订阅传真: 0755- 25429588 电子邮件: report @ chinairn.com 下载目录 关注中研网 当前报告二维码 微信扫一扫 手机快速访问 《2021-2025年中国飞机制造行业竞争分析及发展前景预测报告》由中研普华飞机制造行业分析专家领衔撰写,主要分析了飞机制造行业的市场规模、发展现状与投资前景,同时对飞机制造行业的未来发展做出科学的趋势预测和专业的飞机制造行业数据分析,帮助客户评估飞机制造行业投资价值。 下载目录 下载订阅表", "date": "2020-12-30T00:00:00+08:00"}, {"id": "sr_3d41f2", "title": "中国航空零部件制造行业市场现状与竞争格局分析-行业呈现寡头竞争", "source": "豆丁网", "url": "https://m.docin.com/touch_new/preview_new.do?id=4727577378", "snippet": "中国航空零部件制造行业市场现状与竞争格局分析-行业呈现寡头竞争 分类 专题 大会员 我的 建筑 考研 创业 在家学 课堂 充值 医疗 书城 微案例 日报 下载App 作文 合伙人 客服 立即下载 会员免费下载 下载后高清去水印,轻点 转码版网页 可在线预览 中国航空零部件制造行业市场现状与竞争格局分析-行业呈现寡头竞争 中国航空零部件制造行.争.docx 299.65K 8页 1阅读 31e02b9a9d 2024-09-13 立即下载+合伙人(招募中)举报 加载中. 君,已阅读到文档结尾了~ 立即下载 换一篇 从APP打开该文档,阅读高清版 开通Plus会员,全场文档6折起&gt;&gt; 该文档为侵权文档 该文档含有违规或不良信息 涉未成年人举报 该文档为侵权文档 请留下电话、QQ或邮箱,方便联系您 取消", "date": "2024-09-13T08:00:00+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 1}}

data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:07:17.741752", "content": {"results": [{"id": "sr_644c64", "title": "2030年中国低空经济市场规模有望突破2万亿元,机构分析_凤凰网视频_凤凰网", "source": "凤凰网", "url": "https://v.ifeng.com/c/8qMoWEaGvKy", "snippet": "2030年中国低空经济市场规模有望突破2万亿元,机构分析2026-01-31\n18:00:0000:270来自香港", "date": "2026-01-31T18:00:00+08:00"}, {"id": "sr_e842f2", "title": "中国低空经济白皮书(43页)-并购家", "source": "并购家行业报告网", "url": "https://ipoipo.cn/post/27044.html", "snippet": "我国低空经济正处在快速成长的新阶段,最新统计数据2显示,2023年我国低空经济市场总规模达5059.5亿元,同比增长33.8%,预计到2026年,全国低空经济整体规模有望突破万亿元,2021-2026年复合增长率保持在30%\n左右。另据2025年中国航空产业大会的预测,我国低空经济市场规模在2025年可能达到1.5万亿元,此数据可供业界参考。在政策支持、技术迭代与应用场景拓展的共同推动下,低空经济正成为拉动经济增长、促进产业升级的重要新动能。\n文件下载\n资源名称:中国低空经济白皮书(43页)\n解压密码:", "date": "2026-06-19T07:33:20+08:00"}, {"id": "sr_29876f", "title": "低空经济专题研究报告:空管系统(39页)-并购家", "source": "并购家行业报告网", "url": "https://ipoipo.cn/post/23866.html", "snippet": "引用民航局副局长的数据,2023年我国低空经济规模已经超过5000亿元,2030年有望达2万亿元。从不同省市的产业规模来看,上海、河南等\n均将目标定在了500亿元以上,安徽则力争达到800亿元,北京、湖北力争突破1000亿元,广东计划2026年就要超过3000亿元。照此测算,我们\n认为低空经济产业或将加速迈向2万亿元规模。\n从下游看,当前已经进行商业化探索的应用领域有物流、农业、旅游等,此外,潜在的低空飞行场景还可以按照生产作业类、公共服务类、\n航空消费类三类进行细化产业门类和服务链条的拓展。\n文件下载\n资源名称:低空经济专题研究报告:空管系统(39页)\n解压密码:", "date": "2026-05-13T23:06:14+08:00"}, {"id": "sr_f001c3", "title": "有低空,没经济?万亿赛道的爆发点究竟在哪?医药新闻-ByDrug-一站式医药资源共享中心-医药魔方", "source": "ByDrug掰药", "url": "https://bydrug.pharmcube.com/news/detail/15807e30f60a84f4284a3fcbccea4bf8", "snippet": "而放眼更远的未来,中国民航局预测,到2035年,中国低空经济市场规模有望突破3.5万亿元。\n面对低空经济“万亿规模”的诱人前景,各个地方也开始热火朝天地争相布局:。\n上海立志打造“世界eVTOL之都”,深圳瞄准“全球低空经济第一城”,广东依托其占全球70%的消费级无人机产能巩固制造优势......", "date": "2026-04-03T12:08:00+08:00"}, {"id": "sr_5f4bbe", "title": "Highlights | english.scio.gov.cn", "source": "国务院新闻办公室网站", "url": "http://english.scio.gov.cn/pressroom/node_9007078.htm", "snippet": "The\nsize\nof\nChina's\nlow-altitude\neconomy\nas\nof\nthe\nend\nof\n2023\nis\nestimated\nat\nmore\nthan\n500\nbillion\nyuan\n(about\n70\nbillion\nU.S.\ndollars),\nwith\nits\nscale\nexpected\nto\nrise\nto\n2\ntrillion\nyuan\nby\n2030,\naccording\nto\nthe\nCivil\nAviation\nAdministration\nof\nChina\n(CAAC).\nFebruary\n29,\n2024", "date": "2026-06-27T18:08:29+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

