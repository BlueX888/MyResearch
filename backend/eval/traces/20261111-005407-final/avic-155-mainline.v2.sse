data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T21:06:30.696329", "content": {"graph": {"nodes": [{"id": "node_0", "name": "数字孪生", "type": "technology", "discovered_at": "2026-11-10T21:06:30.333419"}, {"id": "node_1", "name": "航空发动机", "type": "technology", "discovered_at": "2026-11-10T21:06:30.333447"}, {"id": "node_2", "name": "人工智能/机器学习", "type": "technology", "discovered_at": "2026-11-10T21:06:30.333454"}, {"id": "node_3", "name": "无人机/无人化", "type": "technology", "discovered_at": "2026-11-10T21:06:30.333457"}, {"id": "node_4", "name": "绿色航空/可持续航空燃料", "type": "technology", "discovered_at": "2026-11-10T21:06:30.333469"}, {"id": "node_5", "name": "机载自动化系统", "type": "technology", "discovered_at": "2026-11-10T21:06:30.333473"}, {"id": "node_6", "name": "北京航空航天大学", "type": "company", "discovered_at": "2026-11-10T21:06:30.333477"}, {"id": "node_7", "name": "中国知网/万方数据", "type": "company", "discovered_at": "2026-11-10T21:06:30.333481"}, {"id": "node_8", "name": "中国航空工业集团有限公司（AVIC）", "type": "company", "discovered_at": "2026-11-10T21:06:30.696246"}, {"id": "node_9", "name": "中国航空发动机集团有限公司", "type": "company", "discovered_at": "2026-11-10T21:06:30.696252"}, {"id": "node_10", "name": "中国商用飞机有限责任公司（中国商飞）", "type": "company", "discovered_at": "2026-11-10T21:06:30.696257"}, {"id": "node_11", "name": "中国航天科工集团有限公司", "type": "company", "discovered_at": "2026-11-10T21:06:30.696261"}, {"id": "node_12", "name": "中外合资航空企业", "type": "company", "discovered_at": "2026-11-10T21:06:30.696265"}, {"id": "node_13", "name": "通用航空", "type": "technology", "discovered_at": "2026-11-10T21:06:30.696270"}, {"id": "node_14", "name": "无人机", "type": "technology", "discovered_at": "2026-11-10T21:06:30.696274"}, {"id": "node_15", "name": "机载系统", "type": "technology", "discovered_at": "2026-11-10T21:06:30.696278"}], "edges": [{"source": "数字孪生", "relation": "与航空发动机制造工艺相关", "discovered_at": "2026-11-10T21:06:30.333431"}, {"source": "数字孪生", "relation": "与智能生产线相关", "discovered_at": "2026-11-10T21:06:30.333442"}, {"source": "数字孪生", "relation": "与装配界面分析相关", "discovered_at": "2026-11-10T21:06:30.333444"}, {"source": "数字孪生", "relation": "与预测性维护相关", "discovered_at": "2026-11-10T21:06:30.333445"}, {"source": "航空发动机", "relation": "与智能制造相关", "discovered_at": "2026-11-10T21:06:30.333449"}, {"source": "航空发动机", "relation": "与AI设计优化相关", "discovered_at": "2026-11-10T21:06:30.333450"}, {"source": "航空发动机", "relation": "与可持续燃料/减排相关", "discovered_at": "2026-11-10T21:06:30.333452"}, {"source": "人工智能/机器学习", "relation": "与发动机结构模拟、性能预测、设计优化相关", "discovered_at": "2026-11-10T21:06:30.333456"}, {"source": "无人机/无人化", "relation": "被列为航空业未来技术趋势之一", "discovered_at": "2026-11-10T21:06:30.333467"}, {"source": "绿色航空/可持续航空燃料", "relation": "与减排、能源效率、电动化相关", "discovered_at": "2026-11-10T21:06:30.333471"}, {"source": "机载自动化系统", "relation": "与远程监控、数据分析、网络防御相关", "discovered_at": "2026-11-10T21:06:30.333474"}, {"source": "北京航空航天大学", "relation": "《航空学报》主办单位", "discovered_at": "2026-11-10T21:06:30.333478"}, {"source": "北京航空航天大学", "relation": "航空发动机与数字孪生研究机构", "discovered_at": "2026-11-10T21:06:30.333480"}, {"source": "中国知网/万方数据", "relation": "学术文献数据平台", "discovered_at": "2026-11-10T21:06:30.333483"}, {"source": "中国航空工业集团有限公司（AVIC）", "relation": "军机整机总体单位", "discovered_at": "2026-11-10T21:06:30.696248"}, {"source": "中国航空工业集团有限公司（AVIC）", "relation": "下辖100余家成员单位、25家上市公司", "discovered_at": "2026-11-10T21:06:30.696250"}, {"source": "中国航空工业集团有限公司（AVIC）", "relation": "业务含通用航空与无人机", "discovered_at": "2026-11-10T21:06:30.696251"}, {"source": "中国航空发动机集团有限公司", "relation": "航空装备产业格局主导者之一", "discovered_at": "2026-11-10T21:06:30.696254"}, {"source": "中国航空发动机集团有限公司", "relation": "与航空工业集团存在发动机配套/分立关系", "discovered_at": "2026-11-10T21:06:30.696255"}, {"source": "中国商用飞机有限责任公司（中国商飞）", "relation": "民机双核心之一", "discovered_at": "2026-11-10T21:06:30.696258"}, {"source": "中国商用飞机有限责任公司（中国商飞）", "relation": "与航空工业集团在民机整机与配套上形成竞合", "discovered_at": "2026-11-10T21:06:30.696259"}, {"source": "中国航天科工集团有限公司", "relation": "十大军工集团之一", "discovered_at": "2026-11-10T21:06:30.696262"}, {"source": "中国航天科工集团有限公司", "relation": "在无人机、导弹等领域与航空工业存在潜在竞争", "discovered_at": "2026-11-10T21:06:30.696263"}, {"source": "中外合资航空企业", "relation": "航空装备产业格局组成部分", "discovered_at": "2026-11-10T21:06:30.696267"}, {"source": "中外合资航空企业", "relation": "国际航空巨头在华合作载体", "discovered_at": "2026-11-10T21:06:30.696268"}, {"source": "通用航空", "relation": "集团产业板块之一", "discovered_at": "2026-11-10T21:06:30.696271"}, {"source": "通用航空", "relation": "低空经济载体", "discovered_at": "2026-11-10T21:06:30.696272"}, {"source": "无人机", "relation": "集团全谱系产品之一", "discovered_at": "2026-11-10T21:06:30.696275"}, {"source": "无人机", "relation": "有人到无人跨越的技术主线", "discovered_at": "2026-11-10T21:06:30.696277"}, {"source": "机载系统", "relation": "集团核心板块", "discovered_at": "2026-11-10T21:06:30.696280"}, {"source": "机载系统", "relation": "与关键材料/器件自主可控相关", "discovered_at": "2026-11-10T21:06:30.696281"}]}, "stats": {"entitiesCount": 16, "relationsCount": 31}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T21:06:30.696407", "content": {"agent": "DeepScout", "section": "竞争格局", "facts_count": 7, "duplicates_removed": 0, "data_points_count": 6, "insights": ["本轮搜索结果整体时效性差（多为2009—2022年内容），且以企业简介、自媒体科普和图表库占位页为主，没有任何一条直接涉及“十五五规划”文本或战略主线表述，无法支撑对研究问题的直接回答。", "可确认的结构性事实是：航空工业集团在军机整机（歼击机、轰炸机、运输机、直升机、无人机、机载武器）领域处于总体主导地位，产业格局为“航空工业集团+中国航发+中国商飞+中外合资企业”主导、配套供应商为辅，民机领域呈“商飞—中航工业”双核心，支持h_2的竞争格局判断。", "官方简介中“从有人到无人”“从第三代到第四代”“从亦步亦趋到自主创新”的表述，是集团技术主线（无人化、跨代化、自主创新）的官方口径证据，可作为h_2技术主线的弱证据，但隐身化、绿色化、数字孪生等具体方向仍需另行取证。"], "source_quality": "整体质量偏低。7条结果中仅1条为官方来源（avic.com集团简介，可信度0.9），但内容为通用企业介绍，与十五五规划无直接关联；2条为行业报告图表库摘录（悟空智库，0.6），页面标注“建设中”，仅有结论性描述而无数据与出处；1条为南方网转载的集团简介（0.65）；其余为自媒体与投资者问答（0.4—0.5），且存在数据口径冲突（上市公司23家/25家、员工45万/40万）。时效性方面，多数内容为2019—2022年，最早至2009年，无法反映十五五（2026—2030）规划期的战略取向。结论：本轮搜索结果不足以支撑对研究问题的实质回答，需补充集团官网规划类文件、年度报告、集团工作会议报道、权威财经媒体深度报道及券商军工行业研究报告。", "hypothesis_updates": 3, "search_results": [{"title": "航空工业公司介绍,地址", "url": "https://51sole1472009.51sole.com/companyabout.htm", "source": "搜了网", "snippet": "航空工业公司是一家专注于航空领域的综合性企业,致力于打造全球领先的航空产品与服务供应商。我们以创新驱动发展,凭借深厚的技术积累和卓越的研发能力,为航空事业的发展贡献力量。我们主营各类航空飞行器、航空发动机、航空零部件等产品。企业优势显著,拥有一支高素质、经验丰富的专业团队,具备先进的生产设备和严格的质量管控体系。产品优势突出,具有高性能、高可靠性、低能耗等特点,能够满足不同客户的需求。我们的产品广泛应用于民用航空、军事航空、通用航空等领域。无论是商业航班的安全飞行,还是军事任务的高效执行,亦或是通用航空的个性化需求,我们的产品都能发挥重要作用,为航空事业的发展提供坚实保障。", "date": "2009-03-04T00:00:00+08:00"}, {"title": "中航通用飞机有限责任公司_南方网", "url": "https://economy.southcn.com/node_b6d814f262/643ebab920.shtml", "source": "南方网", "snippet": "中国航空工业集团有限公司(简称“航空工业集团”)是由中央管理的国有特大型企业,经营范围涵盖航空武器装备、军用运输类飞机、直升机、机载系统、通用航空、航空研究、飞行试验、航空供应链与军贸、专用装备、汽车零部件、资产管理、金融、工程建设等产业。", "date": "2025-12-19T00:00:00+08:00"}, {"title": "中国航空工业集团和中国兵器工业集团发展历程对比-今日头条", "url": "https://www.toutiao.com/article/6665599264749519373/", "source": "今日头条", "snippet": "设有防务、飞机、发动机、直升机、机载设备与系统、通用飞机、航空研究、飞行试验、贸易物流、资产管理、工程规划建设、汽车等产业板块。", "date": "2019-03-07T18:49:00+08:00"}, {"title": "投资者提问:请问贵公司军工产品和其他国企相比,有何竞争优势?无人机等军工产...军工_新浪财经_新浪网", "url": "https://finance.sina.com.cn/stock/relnews/dongmiqa/2023-04-07/doc-imypqcxx1717033.shtml", "source": "新浪财经", "snippet": "您好!公司具有从核心部件到“器件+组件+系统+解决方案”的全系列产品架构的完整产业布局,在抗干扰、多机编队、飞控以及任务载荷方面具有较强的竞争优势。感谢您对公司的关注!", "date": "2023-04-07T17:22:00+08:00"}, {"title": "中国航空装备企业竞争格局_图表数据库 - 悟空智库", "url": "https://www.wkzk.com/chart/124394.html", "source": "建设中", "snippet": "依托于航空装备制造行业的自然垄断行业特质,我国航空装备产业主要由航空领域的国有大型企业集团主导,历经数次战略性和专业化重组,形成中国航空工业集团、中国航发、中国商飞以及中外合资企业为主,众多原材料和零部件配套供应商为辅的企业格局。报告出处点此查看报告原文>>", "date": "2022-06-19T23:32:18+08:00"}, {"title": "十大军工集团：中国航空工业集团有限公司", "url": "https://m.163.com/dy/article/G7F3SEJR0514HGHU.html", "source": "网易", "snippet": "手机: 13161131912 固话: 010-88430281\n微信: lhcjh6666 邮箱: lhjmrh@126.com\n中国十大军工集团\n中国航空工业集团有限公司\n中国航空发动机集团有限公司\n中国航天科技集团有限公司\n中国航天科工集团有限公司\n中国船舶集团有限公司\n中国核工业集团有限公司\n中国兵器工业集团有限公司\n中国兵器装备集团有限公司\n中国电子科技集团有限公司\n中国电子信息产业集团有限公司\n中国航空工业集团有限公司 (简称“ 航空 工业”)\nThe Aviation Industry Corporation of China, Ltd.(AVIC)\n航空工业是由中央管理的国有特大型企业,是国家授权的投资机构,于2008年11月6日由原中国航空工业第一、第二集团公司重组整合而成立。集团公司设有航空武器装备、军用运输类飞机、直升机、机载系统、通用航空、航空研究、飞行试验、航空供应链与军贸、专用装备、汽车零部件、资产管理、金融、工程建设等产业,下辖100余家成员单位、23家上市公司,员工逾45万人。\n1、军用航空\n为国防安全提供先进航空武器装备\n航空工业系列发展歼击机、歼击轰炸机、轰炸机、运输机、教练机、侦察机、直升机、强击机、通用飞机、无人机等飞行器,全面研发空空、空面、地空导弹,强力塑造运-20“鲲鹏”大型运输机、“鹘鹰”战斗机、“飞鲨”舰载战斗机、歼10系列飞机、歼11系列飞机、“霹雳火”直-10武装直升机、“黑旋风”直19武装直升机、轰-6系列轰炸机、空警200和空警2000等系列预警机、“飞豹”歼击轰炸机、“枭龙”飞机、“翼龙”系列无人机、“猎鹰”和“山鹰”高级教练机、“霹雳”系列和“闪电”系列导弹等品牌,为用户提供先进航空武器装备。\n战斗机\n左右滑动浏览图片\n军用直升机\n左右滑动浏览图片\n无人机\n左右滑动浏览图片\n军用运输机\n左右滑动浏览图片\n2、民用", "date": "2021-04-13T18:03:00+08:00"}, {"title": "中国飞机制造行业竞争派系_图表数据库 - 悟空智库", "url": "https://www.wkzk.com/chart/131381.html", "source": "建设中", "snippet": "飞机制造行业具有较高的资金、技术与资质壁垒,因此国内的飞机制造行业的主要市场参与者均为国有集团企业。在国内的飞机制造领域,形成了以中国商飞和中航工业集团为双核心的民用军用飞机制造体系。报告出处点此查看报告原文>>", "date": "2022-07-19T07:50:44+08:00"}, {"title": "公司简介", "url": "https://www.acc.avic.com/c/2022-02-24/548116.shtml", "source": "www.acc.avic.com", "snippet": "公司简介\n中国航空工业集团有限公司(简称 “中国航空工业集团”)是由中央管理的国有特大型企业,经营范围涵盖航空武器装备、军用运输类飞机、直升机、机载系统、通用航空、航空研究、飞行试验、航空供应链与军贸、专用装备、汽车零部件、资产管理、金融、工程建设等产业,下辖100余家成员单位、25家上市公司,员工逾40万人。\n航空工业被誉为 “现代工业之花、制造业的皇冠”,是一个国家科技、经济、国防实力和工业化水平的重要标志。70余年来,中国航空工业从无到有、从小到大、从弱到强,形成了专业门类齐全,科研、试验、生产相配套,具备研制生产当代先进航空装备能力的高科技工业体系,实现了航空装备从第三代到第四代、从机械化到信息化、从陆基到海基、从中小型到大中型、从有人到无人的跨越,实现了对世界强者从望尘莫及到同台竞技的跨越,实现了我国民机产业从蹒跚起步到振翅欲飞的跨越,实现了航空科技研发从亦步亦趋到自主创新的跨越。\n党的十八大以来,习近平总书记数十次对中国航空事业发展作出重要指示批示,赞扬一代代航空人许党报国的远大志向,发出建设航空强国的伟大号召。新征程上,中国航空工业集团全线,深刻领悟 “两个确立”的决定性意义,增强“四个意识”、坚定“四个自信”、做到“两个维护”,牢记总书记嘱托,大力弘扬“忠诚奉献、自力更生、艰苦奋斗、勇攀高峰”的新时代航空报国精神,坚守作为国家安全守护者、高质量发展引领者、可持续发展价值创造者的定位,秉承“赤心向党、为国担当、强基固本、守正创新、开放协同、对标一流”的行为准则,坚持“平台共享、集团产品、法人经营、一体管控”理念,胸怀“国之大者”,担当强国强军使命,更好发挥“科技创新、产业控制、安全支撑”作用,为建设现代航空工业体系,加快建设航空强国而不懈奋斗!\n2010年6月,由中国航空工业集团、北京市共同出资,战略整合航材院和制造院复合材料科研生产能力,对相关业务和资源进行", "date": "2022-02-24T08:00:00+08:00"}, {"title": "【2017年整理】航空工业.doc", "url": "https://max.book118.com/html/2017/0207/89058705.shtm", "source": "原创力文档", "snippet": "航空工业百科名片 HYPERLINK /image/b853d6fcf70742c3fd037f2c \\o 查看图片 \\t _blank 航空工业航空工业是研制、生产和修理航空器的工业。是军民结合型工业。通常包括航空飞行器、动力装置、机载设备、机载武器等多种产品制造和修理行业,以及独立的或隶属于企业的研究设计单位、试验基地和管理机构等。主要产品有:固定翼飞机、旋转翼飞机、偏转翼飞机、地面效应飞行器、飞艇、气球、飞机发动机、机载设备、机载武器、地面保障设备等。l 2#2 基本特征 HYPERLINK /view/268246.htm \\l 3#3 中国航空业面临前所未有的发展前景 HYPERLINK /view/268246.htm \\l 4#4 航空工业概念 HYPERLINK /view/268246.htm \\l 5#5 航空产品介绍及分类 HYPERLINK /view/268246.htm \\l 6#6 世界航空产业格局 HYPERLINK /view/268246.htm \\l 7#7 中国航空工业概况 HYPERLINK /view/268246.htm \\l 8#8 中国航空工业第一集团公司 HYPERLINK /view/268246.htm \\l 1 活动范围 HYPERLINK /view/268246.htm \\l 2 基本特征 HYPERLINK /view/268246.htm \\l 3 中国航空业面临前所未有的发展前景 HYPERLINK /view/268246.htm \\l 4 航空工业概念 HYPERLINK /view/268246.htm \\l 5 航空产品介绍及分类 HYPERLINK /view/268246.htm \\l 6 世界航空产业格局 HYPERLINK /view/268246.htm \\l 7 中国航空工业概况 HYP", "date": "2017-02-07T08:59:44+08:00"}, {"title": "民用航空工业企事业概览 - 道客巴巴", "url": "https://www.doc88.com/p-9079012246946.html", "source": "道客巴巴", "snippet": "下载积分: 1000 内容提示: 民用航空工业企事业概览 【 发布时间: 2009-3-31 】 目录工业(集团) 有限责任公司 工业(集团) 有限责任公司 飞机制造厂 机工业集团有限责任公司 航空工业集团有限责任公司 工业(集团) 有限公司... 文档格式:DOC | 页数:50 | 浏览次数:4 | 民用航空工业企事业概览 【 发布时间: 2009-3-31 】 目录工业(集团) 有限责任公司 工业(集团) 有限责任公司 飞机制造厂 机工业集团有限责任公司 航空工业集团有限责任公司 工业(集团) 有限公司...制造厂...工业(集团) 有限公司...机工业有限责任公司...工业(集团) 有限责任公司...飞机有限公司...飞机制造厂...博威飞机工业有限公司...轻型飞机实业有限公司...飞机股份有限公司...斯基飞机有限公司...工业股份有限公司...机(集团) 有限公司...航空发动机公司...安发动机(集团) 有限公司...航空发动机(集团) 有限责任公司...", "date": "2013-12-08T21:36:23+08:00"}], "extracted_facts": [{"content": "中国航空工业集团有限公司是由中央管理的国有特大型企业，经营范围涵盖航空武器装备、军用运输类飞机、直升机、机载系统、通用航空、航空研究、飞行试验、航空供应链与军贸、专用装备、汽车零部件、资产管理、金融、工程建设等产业。", "source_name": "南方网（转载集团简介）", "source_url": "https://economy.southcn.com/node_b6d814f262/643ebab920.shtml", "credibility": 0.65}, {"content": "航空工业集团于2008年11月6日由原中国航空工业第一、第二集团公司重组整合成立，下辖100余家成员单位、23家上市公司，员工逾45万人；业务覆盖歼击机、歼击轰炸机、轰炸机、运输机、教练机、侦察机、直升机、强击机、通用飞机、无人机等全谱系飞行器，并研发空空、空面、地空导弹。", "source_name": "网易（自媒体转载）", "source_url": "https://m.163.com/dy/article/G7F3SEJR0514HGHU.html", "credibility": 0.4}, {"content": "航空工业集团官网简介称：集团下辖100余家成员单位、25家上市公司，员工逾40万人；已实现航空装备从第三代到第四代、从机械化到信息化、从陆基到海基、从中小型到大中型、从有人到无人的跨越，并实现航空科技研发从亦步亦趋到自主创新的跨越。", "source_name": "中国航空工业集团（acc.avic.com）公司简介", "source_url": "https://www.acc.avic.com/c/2022-02-24/548116.shtml", "credibility": 0.9}, {"content": "我国航空装备产业主要由航空领域国有大型企业集团主导，历经数次战略性和专业化重组，形成以中国航空工业集团、中国航发、中国商飞以及中外合资企业为主，众多原材料和零部件配套供应商为辅的企业格局。", "source_name": "悟空智库（行业研究报告图表库）", "source_url": "https://www.wkzk.com/chart/124394.html", "credibility": 0.6}, {"content": "国内飞机制造行业具有较高资金、技术与资质壁垒，主要参与者均为国有集团企业，形成以中国商飞和中航工业集团为双核心的民用与军用飞机制造体系。", "source_name": "悟空智库（行业研究报告图表库）", "source_url": "https://www.wkzk.com/chart/131381.html", "credibility": 0.6}, {"content": "某军工上市公司在投资者互动中表示，其具有从核心部件到“器件+组件+系统+解决方案”的全系列产品架构的完整产业布局，在抗干扰、多机编队、飞控以及任务载荷方面具有较强竞争优势（涉及无人机等军工产品）。", "source_name": "新浪财经投资者问答", "source_url": "https://finance.sina.com.cn/stock/relnews/dongmiqa/2023-04-07/doc-imypqcxx1717033.shtml", "credibility": 0.5}, {"content": "航空工业集团被列为中国十大军工集团之一，与航空发动机集团、航天科技、航天科工、船舶、兵器等集团并列，体现其在军工体系中的整机总体地位。", "source_name": "网易（自媒体转载）", "source_url": "https://m.163.com/dy/article/G7F3SEJR0514HGHU.html", "credibility": 0.4}], "data_points": [{"name": "成员单位数量", "value": "100+", "unit": "家", "year": 2021, "source": "网易（自媒体转载）"}, {"name": "上市公司数量", "value": "23", "unit": "家", "year": 2021, "source": "网易（自媒体转载）"}, {"name": "员工人数", "value": "45", "unit": "万人", "year": 2021, "source": "网易（自媒体转载）"}, {"name": "成员单位数量", "value": "100+", "unit": "家", "year": 2022, "source": "中国航空工业集团（acc.avic.com）公司简介"}, {"name": "上市公司数量", "value": "25", "unit": "家", "year": 2022, "source": "中国航空工业集团（acc.avic.com）公司简介"}, {"name": "员工人数", "value": "40", "unit": "万人", "year": 2022, "source": "中国航空工业集团（acc.avic.com）公司简介"}]}}

