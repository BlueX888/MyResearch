data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:13:55.054924", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    '指标': ['成员单位数量', '成员单位数量', '上市公司数量', '上市公司数量', '员工人数', '员工人数', '低空经济市场规模', '低空经济市场规模'],\n    '年份': [2021, 2022, 2021, 2022, 2021, 2022, 2025, 2035],\n    '数值': [100, 100, 23, 25, 45, 40, 1.5, 3.5],\n    '单位': ['家', '家', '家', '家', '万人', '万人', '万亿元', '万亿元']\n}\ndf = pd.DataFrame(data)\ndf['指数'] = df.groupby('指标')['数值'].transform(lambda x: x / x.iloc[0] * 100)\nplt.figure(figsize=(12, 7), dpi=200)\ncolors = {'成员单位数量': '#6366f1', '上市公司数量': '#f59e0b', '员工人数': '#10b981', '低空经济市场规模': '#ef4444'}\nfor name, group in df.groupby('指标'):\n    group = group.sort_values('年份')\n    plt.plot(group['年份'], group['指数'], marker='o', markersize=8, linewidth=2.5, label=name, color=colors[name])\n    plt.fill_between(group['年份'], group['指数'], alpha=0.15, color=colors[name])\n    for x, y, v, u in zip(group['年份'], group['指数'], group['数值'], group['单位']):\n        plt.text(x, y + 3, f'{v}{u}', ha='center', fontsize=10)\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('指数（起始年=100）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=11, loc='upper left')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

