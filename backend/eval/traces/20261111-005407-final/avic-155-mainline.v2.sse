data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:11:25.089422", "content": {"results": [{"id": "fact_d96c0a4f", "title": "2024年12月5日至6日，中国航空工业集团在京召开2025年经营工作和“十五五”发展规划务虚会，研讨2025年重点工作任务、“十五五”及中长期发展规划思路。", "source": "中国航空工业集团2025年经营工作和“十五五”发展规划务虚会在京召开", "url": "", "snippet": "2024年12月5日至6日，中国航空工业集团在京召开2025年经营工作和“十五五”发展规划务虚会，研讨2025年重点工作任务、“十五五”及中长期发展规划思路。", "date": "", "isSupplementary": false}, {"id": "fact_0132cb00", "title": "会议提出深刻理解中国航空工业集团“国家安全守护者”“高质量发展引领者”使命，着眼长远，规划一个五年，思考两个五年。", "source": "中国航空工业集团2025年经营工作和“十五五”发展规划务虚会在京召开", "url": "", "snippet": "会议提出深刻理解中国航空工业集团“国家安全守护者”“高质量发展引领者”使命，着眼长远，规划一个五年，思考两个五年。", "date": "", "isSupplementary": false}, {"id": "fact_6ac7e045", "title": "务虚会报告内容涵盖2025年总体经营目标与重点工作任务、深化改革重点任务、高质量发展考核激励体系、科技创新重点工作安排、巡视和审计问题整改重点工作安排、信息化一...", "source": "中国航空工业集团2025年经营工作和“十五五”发展规划务虚会在京召开", "url": "", "snippet": "务虚会报告内容涵盖2025年总体经营目标与重点工作任务、深化改革重点任务、高质量发展考核激励体系、科技创新重点工作安排、巡视和审计问题整改重点工作安排、信息化一体管控平台建设思路，以及集团“十五五”总体规划思路和各重点业务域“十四五”规划执行情况、“十五五”发展形势需求及发展思路。", "date": "", "isSupplementary": false}, {"id": "fact_592c783b", "title": "航空工业曾提出航空强国“两步走”战略目标和“一心、两融、三力、五化”新时代集团战略，并强调“强军首责”。", "source": "中国航空工业集团有限公司2020年度工作会 我们在行动", "url": "", "snippet": "航空工业曾提出航空强国“两步走”战略目标和“一心、两融、三力、五化”新时代集团战略，并强调“强军首责”。", "date": "", "isSupplementary": false}, {"id": "fact_c1ab1e55", "title": "航空工业强调聚焦主业、做强实业、瘦身健体、提质增效，作为落实高质量发展要求、推动企业“做强、做优、做大”的根本途径。", "source": "中国航空工业集团有限公司2020年度工作会 我们在行动", "url": "", "snippet": "航空工业强调聚焦主业、做强实业、瘦身健体、提质增效，作为落实高质量发展要求、推动企业“做强、做优、做大”的根本途径。", "date": "", "isSupplementary": false}, {"id": "fact_1a7755da", "title": "2019年，航空工业以655.34亿美元营收位列《财富》世界500强第151位，连续第11年入榜。", "source": "中国航空工业集团有限公司2020年度工作会 我们在行动", "url": "", "snippet": "2019年，航空工业以655.34亿美元营收位列《财富》世界500强第151位，连续第11年入榜。", "date": "", "isSupplementary": false}, {"id": "fact_255ffda3", "title": "2019年上半年，航空工业营业收入、利润总额、EVA等指标全面优于上年同期；在国务院国资委公布的2018年和2016—2018年任期经营业绩考核中双获A级，并被...", "source": "中国航空工业集团有限公司2020年度工作会 我们在行动", "url": "", "snippet": "2019年上半年，航空工业营业收入、利润总额、EVA等指标全面优于上年同期；在国务院国资委公布的2018年和2016—2018年任期经营业绩考核中双获A级，并被授予“业绩优秀企业”“科技创新突出贡献企业”称号。", "date": "", "isSupplementary": false}, {"id": "fact_66c3bac8", "title": "规划总院全面承接集团公司战略，以规划纲要为统领，制定重点工作专项规划；聚焦主责主业、立足使命任务、紧扣民机发展、发挥技术优势，稳步推进国产大飞机批产研保项目及多...", "source": "规划总院：凝聚磅礴伟力 谱写使命担当 为加快建设现代航空工业体系贡献力量", "url": "", "snippet": "规划总院全面承接集团公司战略，以规划纲要为统领，制定重点工作专项规划；聚焦主责主业、立足使命任务、紧扣民机发展、发挥技术优势，稳步推进国产大飞机批产研保项目及多领域能力建设项目。", "date": "", "isSupplementary": false}, {"id": "fact_e40fc400", "title": "2024年计划财务工作会提出“以创新蓄发展动能 以奋斗铸世界一流”，回顾总结2023年计划财务工作并部署2024年计划财务重点工作。", "source": "中国航空工业集团召开2024年计划财务工作会", "url": "", "snippet": "2024年计划财务工作会提出“以创新蓄发展动能 以奋斗铸世界一流”，回顾总结2023年计划财务工作并部署2024年计划财务重点工作。", "date": "", "isSupplementary": false}, {"id": "fact_dff79c7e", "title": "中国航空工业集团官网“发展战略”页面载明，集团坚持“五化”：集约化经营、精准化管理、市场化改革、体系化发展、国际化共赢的发展路径和原则。", "source": "中国航空工业集团有限公司官网（发展战略页面）", "url": "", "snippet": "中国航空工业集团官网“发展战略”页面载明，集团坚持“五化”：集约化经营、精准化管理、市场化改革、体系化发展、国际化共赢的发展路径和原则。", "date": "", "isSupplementary": false}, {"id": "fact_1c9fde84", "title": "会议指出，2025年是“十四五”规划收官之年，是“十五五”规划论证之年；要求高位对正国家战略，系统回顾“十四五”规划完成情况，认清形势方位，准确识别风险和问题，...", "source": "国复咨询转载集团新闻", "url": "https://www.iicnet.cn/article/3575", "snippet": "会议指出，2025年是“十四五”规划收官之年，是“十五五”规划论证之年；要求高位对正国家战略，系统回顾“十四五”规划完成情况，认清形势方位，准确识别风险和问题，对标世界一流，抓住主要矛盾和矛盾的主要方面，深刻理解“国家安全守护者”“高质量发展引领者”使命，着眼长远，规划一个五年、思考两个五年。", "date": "", "isSupplementary": false}, {"id": "fact_45052313", "title": "会上集团相关部门和单位围绕2025年总体经营目标与重点工作任务、深化改革重点任务、高质量发展考核激励体系、科技创新重点工作安排、巡视和审计问题整改重点工作安排、...", "source": "国复咨询转载集团新闻", "url": "https://www.iicnet.cn/article/3575", "snippet": "会上集团相关部门和单位围绕2025年总体经营目标与重点工作任务、深化改革重点任务、高质量发展考核激励体系、科技创新重点工作安排、巡视和审计问题整改重点工作安排、信息化一体管控平台建设思路，以及集团公司“十五五”总体规划思路和各重点业务域“十四五”规划执行情况、“十五五”发展形势需求及发展思路作了报告。", "date": "", "isSupplementary": false}, {"id": "fact_5496b7ae", "title": "公开搜索结果未披露中国航空工业集团“十五五”总体规划全文或“战略主线”的明确官方表述；现有信息表明相关规划仍处于论证、研讨和思路形成阶段。", "source": "本次搜索结果综合", "url": "", "snippet": "公开搜索结果未披露中国航空工业集团“十五五”总体规划全文或“战略主线”的明确官方表述；现有信息表明相关规划仍处于论证、研讨和思路形成阶段。", "date": "", "isSupplementary": false}, {"id": "fact_ce0b05df", "title": "2025年国防科技工业工作会议于1月5日在京召开，会议总结2024年工作、分析问题差距、把握新形势新要求、明确发展方向思路并部署2025年重点任务。", "source": "中国航空工业集团有限公司（国资动态，据国家国防科技工业局网站报道）", "url": "", "snippet": "2025年国防科技工业工作会议于1月5日在京召开，会议总结2024年工作、分析问题差距、把握新形势新要求、明确发展方向思路并部署2025年重点任务。", "date": "", "isSupplementary": false}, {"id": "fact_249a2c57", "title": "2025年国防科技工业工作会议指出，2024年国防科技工业全系统武器装备研制生产能力显著增强，国防科技自主创新成果丰硕，开放融合发展格局持续深化，国际合作交流服...", "source": "中国航空工业集团有限公司（国资动态，据国家国防科技工业局网站报道）", "url": "", "snippet": "2025年国防科技工业工作会议指出，2024年国防科技工业全系统武器装备研制生产能力显著增强，国防科技自主创新成果丰硕，开放融合发展格局持续深化，国际合作交流服务国家大局，行业治理体系能力有效提升，安全发展基础不断夯实巩固。", "date": "", "isSupplementary": false}, {"id": "fact_82f0f1eb", "title": "中国航空工业集团要闻列表显示，中航工业于2025年2月21日召开AG600项目2025年度工作会。", "source": "中国航空工业集团有限公司移动版集团要闻", "url": "", "snippet": "中国航空工业集团要闻列表显示，中航工业于2025年2月21日召开AG600项目2025年度工作会。", "date": "", "isSupplementary": false}, {"id": "fact_18975e24", "title": "中国航空工业集团要闻列表显示，中航成飞于2025年2月18日正式登陆资本市场。", "source": "中国航空工业集团有限公司移动版集团要闻", "url": "", "snippet": "中国航空工业集团要闻列表显示，中航成飞于2025年2月18日正式登陆资本市场。", "date": "", "isSupplementary": false}, {"id": "fact_9481aa18", "title": "中国航空工业集团要闻列表显示，魏应彪于2025年3月21日会见空客公司首席执行官傅里一行。", "source": "中国航空工业集团有限公司移动版集团要闻", "url": "", "snippet": "中国航空工业集团要闻列表显示，魏应彪于2025年3月21日会见空客公司首席执行官傅里一行。", "date": "", "isSupplementary": false}, {"id": "fact_8bd571be", "title": "航空工业航展相关旧闻提到，向“空天一体、攻防兼备”的战略目标迈进，对维护国家领土完整、安全及各种利益具有重要意义。", "source": "中国航空工业集团有限公司航展消息", "url": "", "snippet": "航空工业航展相关旧闻提到，向“空天一体、攻防兼备”的战略目标迈进，对维护国家领土完整、安全及各种利益具有重要意义。", "date": "", "isSupplementary": false}, {"id": "fact_2ad8488f", "title": "航空工业2022年工作会相关页面显示，中航技2022年工作会于1月18日在京召开，航空工业党组成员、副总经理郝照平出席并讲话；同期页面还显示航空工业召开民机质量...", "source": "中国航空工业集团有限公司2022年工作会专题", "url": "", "snippet": "航空工业2022年工作会相关页面显示，中航技2022年工作会于1月18日在京召开，航空工业党组成员、副总经理郝照平出席并讲话；同期页面还显示航空工业召开民机质量年度工作会。", "date": "", "isSupplementary": false}]}}

