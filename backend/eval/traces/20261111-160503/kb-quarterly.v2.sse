data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T16:13:33.624118", "content": {"results": [{"id": "fact_ae68b6bc", "title": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": false}, {"id": "fact_4b6de886", "title": "中航成飞控股股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612.00股。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞控股股东中国航空工业集团有限公司持股比例为78.66%，持股数量为2,101,738,612.00股。", "date": "", "isSupplementary": false}, {"id": "fact_2b4710f7", "title": "本次搜索结果中的中航成飞2025年年度报告摘要片段未包含2025年分季度营业收入数据，无法据此判断各季度营业收入分布或最高季度。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "本次搜索结果中的中航成飞2025年年度报告摘要片段未包含2025年分季度营业收入数据，无法据此判断各季度营业收入分布或最高季度。", "date": "", "isSupplementary": false}, {"id": "fact_5a9eebf4", "title": "中航成飞2025年年度报告摘要的公告编号为2026-009，证券代码为302132。", "source": "中航成飞2025年年度报告摘要", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年年度报告摘要的公告编号为2026-009，证券代码为302132。", "date": "", "isSupplementary": false}, {"id": "fact_9fcad8a8", "title": "大信会计师事务所对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "source": "中航成飞2025年年度报告摘要", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "大信会计师事务所对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": false}, {"id": "fact_2072d284", "title": "中航成飞2025年主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "中航成飞2025年年度报告摘要", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_01058215", "title": "中航成飞2025年末总资产为114,547,703,019.42元，较2024年末调整后总资产107,905,965,442.13元增长6.16%。", "source": "中航成飞2025年年度报告摘要", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年末总资产为114,547,703,019.42元，较2024年末调整后总资产107,905,965,442.13元增长6.16%。", "date": "", "isSupplementary": false}, {"id": "fact_91fbe902", "title": "中航成飞2025年度利润分配预案为以总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），不送红股，不转增股本。", "source": "中航成飞2025年年度报告摘要", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度利润分配预案为以总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），不送红股，不转增股本。", "date": "", "isSupplementary": false}, {"id": "fact_a5c211a7", "title": "本次检索到的2025年年度报告摘要片段未包含分季度营业收入数据，无法据此验证2025年各季度营业收入分布及最高季度。", "source": "中航成飞2025年年度报告摘要", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "本次检索到的2025年年度报告摘要片段未包含分季度营业收入数据，无法据此验证2025年各季度营业收入分布及最高季度。", "date": "", "isSupplementary": false}, {"id": "fact_e546a261", "title": "中航成飞2025年分季度营业收入：第一季度33.09亿元，第二季度173.93亿元，第三季度275.84亿元，第四季度270.73亿元；第三季度为全年最高，第四...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年分季度营业收入：第一季度33.09亿元，第二季度173.93亿元，第三季度275.84亿元，第四季度270.73亿元；第三季度为全年最高，第四季度次之，第一季度显著偏低，呈现明显的下半年集中交付特征。", "date": "", "isSupplementary": true}, {"id": "fact_24227ad6", "title": "分季度归母净利润与营收节奏同步：第一季度1.56亿元、第二季度7.56亿元、第三季度12.56亿元、第四季度12.63亿元，第四季度净利润略高于第三季度，而第三...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "分季度归母净利润与营收节奏同步：第一季度1.56亿元、第二季度7.56亿元、第三季度12.56亿元、第四季度12.63亿元，第四季度净利润略高于第三季度，而第三季度营收最高，说明第四季度利润率或产品结构更优。", "date": "", "isSupplementary": true}, {"id": "fact_1865684c", "title": "分季度扣非归母净利润：第一季度1.29亿元、第二季度7.25亿元、第三季度12.55亿元、第四季度11.95亿元，与净利润趋势一致，第四季度扣非略低于第三季度，...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "分季度扣非归母净利润：第一季度1.29亿元、第二季度7.25亿元、第三季度12.55亿元、第四季度11.95亿元，与净利润趋势一致，第四季度扣非略低于第三季度，非经常性损益在第四季度贡献相对明显。", "date": "", "isSupplementary": true}, {"id": "fact_92a57231", "title": "分季度经营活动现金流量净额：第一季度20.93亿元、第二季度-97.57亿元、第三季度36.32亿元、第四季度14.89亿元。第二季度出现大额经营性现金净流出，...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "分季度经营活动现金流量净额：第一季度20.93亿元、第二季度-97.57亿元、第三季度36.32亿元、第四季度14.89亿元。第二季度出现大额经营性现金净流出，与备货、预付款及交付前投入相关，第三季度回款集中转正，印证军品交付与结算的季节性错配。", "date": "", "isSupplementary": true}, {"id": "fact_c16b076c", "title": "公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，航空防务装备是营收主体，其采购与交付节奏受军品政策...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，航空防务装备是营收主体，其采购与交付节奏受军品政策与装备采购计划影响。", "date": "", "isSupplementary": true}, {"id": "fact_dd8cdb99", "title": "公司确认上述分季度财务指标与已披露季度报告、半年度报告相关财务指标不存在重大差异，分季度数据可作为营收节奏分析的可靠基础。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司确认上述分季度财务指标与已披露季度报告、半年度报告相关财务指标不存在重大差异，分季度数据可作为营收节奏分析的可靠基础。", "date": "", "isSupplementary": true}, {"id": "fact_1b02bcdb", "title": "中航成飞（证券代码302132）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，属于航空主机厂...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞（证券代码302132）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品，属于航空主机厂/防务装备整机研制企业。", "date": "", "isSupplementary": true}, {"id": "fact_cf3392d1", "title": "公司控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股，表明中航成飞为航空工业集团控股的国有防务装备主机厂，军品定价...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612股，表明中航成飞为航空工业集团控股的国有防务装备主机厂，军品定价与采购政策受集团及国防采购体系影响。", "date": "", "isSupplementary": true}, {"id": "fact_75456ecc", "title": "公司2025年度利润分配预案为以总股本267,209.14万股为基数，每10股派发现金红利3.86元（含税），不送红股、不转增，反映2025年整体盈利与现金分红...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司2025年度利润分配预案为以总股本267,209.14万股为基数，每10股派发现金红利3.86元（含税），不送红股、不转增，反映2025年整体盈利与现金分红能力。", "date": "", "isSupplementary": true}, {"id": "fact_c81627d5", "title": "2025年分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "2025年分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度27,072,785,205.73元；第三季度最高。", "date": "", "isSupplementary": true}, {"id": "fact_af388a0a", "title": "2024年调整后全年营业收入为65,054,925,106.17元，2023年调整后全年营业收入为77,967,211,871.95元；搜索结果未提供2023、...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "2024年调整后全年营业收入为65,054,925,106.17元，2023年调整后全年营业收入为77,967,211,871.95元；搜索结果未提供2023、2024年分季度营业收入数据。", "date": "", "isSupplementary": true}]}}

