data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T16:07:48.982463", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Arial Unicode MS', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'], 'Revenue': [33.09, 173.93, 275.84, 270.73]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx_pos = np.arange(len(df['Quarter']))\ny = df['Revenue']\nplt.plot(x_pos, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2, markeredgecolor='#6366f1', label='季度营业收入')\nplt.fill_between(x_pos, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 8, f'{v:.2f}亿元', ha='center', fontsize=11, fontweight='bold', color='#1e293b')\nplt.title('中航成飞2025年营收季度分布与市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(x_pos, df['Quarter'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 320)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\ntextstr = '年度总营收：753.59亿元\\n同比增长：15.84%\\n归母净利润：34.32亿元\\n净资产：212.09亿元'\nprops = dict(boxstyle='round,pad=0.5', facecolor='#f8fafc', edgecolor='#cbd5e1', alpha=0.9)\nplt.text(0.98, 0.98, textstr, transform=plt.gca().transAxes, fontsize=11, verticalalignment='top', horizontalalignment='right', bbox=props)\nplt.legend(loc='lower right', fontsize=12, frameon=True, facecolor='white', edgecolor='#e2e8f0')\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 中航成飞2025年营收季度分布与市场概况"}}

