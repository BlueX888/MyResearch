data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T16:07:58.227397", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['2025Q1', '2025Q2', '2025Q3', '2025Q4'], 'Revenue': [33.09, 173.93, 275.84, 270.73]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['Revenue'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='#ffffff', markeredgewidth=2.5, markeredgecolor='#6366f1', label='中航成飞单季度营业收入')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 9, str(round(v, 2)) + '亿元', ha='center', fontsize=11, fontweight='bold', color='#312e81')\nplt.xticks(x, df['Quarter'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('航空主机厂竞争格局与季度营收对比分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.ylim(0, 320)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.legend(fontsize=12, loc='upper left', frameon=True)\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 航空主机厂竞争格局与季度营收对比"}}

