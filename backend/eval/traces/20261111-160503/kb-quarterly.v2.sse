data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T16:05:25.126490", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "中航成飞2025年营收季度分布与市场概况", "description": "描述中航成飞2025年营业收入规模、各季度分布、同比环比增速及航空装备市场背景，重点识别Q4是否集中确认。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 一季报 半年报 三季报 营业收入 分季度;中航成飞 2025 季度营收 分布;中航成飞 2025 年报 分季度 收入"]}, {"id": "sec_2", "title": "航空主机厂竞争格局与季度营收对比", "description": "描述中航成飞在歼击机整机领域的市场地位，并与中航沈飞、洪都航空等航空主机厂对比2025年季度营收分布和交付节奏。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 中航沈飞 2025 营业收入 季度 对比;航空主机厂 2025 季度营收 交付节奏;中航成飞 整机 竞争格局"]}, {"id": "sec_3", "title": "型号批产、制造技术与收入确认节奏", "description": "描述中航成飞核心技术及重点型号批产进展，分析航空制造技术、产能释放、产品结构升级对季度收入确认的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 型号 批产 交付;中航成飞 航空制造 技术 产能;中航成飞 2025 合同负债 存货 交付"]}, {"id": "sec_4", "title": "国防装备采购与军品政策环境", "description": "描述国防预算、装备采购计划、军品定价机制、增值税及国企改革等政策，分析其对中航成飞季度收入确认和订单节奏的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["2025 国防预算 装备采购;军品定价机制 增值税 政策 2025;中航成飞 政策 影响 收入确认"]}, {"id": "sec_5", "title": "交付季节性、供应链挑战与型号放量机遇", "description": "描述中航成飞面临的交付确认季节性、供应链瓶颈和军品定价成本压力，以及重点型号放量、外贸和民机配套、产能释放带来的机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 交付 挑战 供应链;中航成飞 2025 产能 释放 订单;军工主机厂 季度收入 确认 季节性"]}, {"id": "sec_6", "title": "中航成飞2025年及后续营收节奏展望", "description": "描述中航成飞2025年全年营收结构、Q4及后续季度收入节奏、订单能见度和航空装备发展趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 全年 营收 预测 季度;中航成飞 2026 订单 能见度;军工主机厂 季度营收 季节性 趋势"]}], "research_questions": ["中航成飞2025年各季度营业收入分别为多少，Q4是否最高？", "季度收入波动主要由交付节奏、产品结构还是政策/订单因素驱动？", "与中航沈飞等主机厂相比，中航成飞2025年季度营收分布是否具有行业共性？"]}}

