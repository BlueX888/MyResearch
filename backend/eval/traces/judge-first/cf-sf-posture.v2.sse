data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T18:30:51.178344", "content": {"charts": [{"id": "chart_001", "title": "中国国防支出趋势", "subtitle": "2020-2024年国防支出（亿元）", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2020", "2024"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "line", "data": [12900, 17000], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}, "label": {"show": true, "position": "top", "color": "#1677ff", "formatter": "{c}"}}]}}, {"id": "chart_002", "title": "十四五军机新增市场空间结构", "subtitle": "按机型划分（亿元）", "type": "pie", "echarts_option": {"tooltip": {"trigger": "item", "formatter": "{b}: {c}亿元 ({d}%)"}, "legend": {"orient": "vertical", "left": "left", "top": "center", "textStyle": {"color": "#666"}}, "series": [{"type": "pie", "radius": ["40%", "70%"], "center": ["55%", "50%"], "avoidLabelOverlap": false, "itemStyle": {"borderRadius": 4, "borderColor": "#fff", "borderWidth": 2}, "label": {"show": true, "formatter": "{b}\n{d}%", "color": "#333"}, "data": [{"name": "战斗机", "value": 5800, "itemStyle": {"color": "#1677ff"}}, {"name": "其他机型", "value": 1700, "itemStyle": {"color": "#52c41a"}}]}]}}, {"id": "chart_003", "title": "成飞与沈飞关键机型进展对比", "subtitle": "阶段评分（5=接近达峰，3=小批量生产，2=首飞）", "type": "horizontal_bar", "echarts_option": {"grid": {"left": "20%", "right": "20%", "top": "10%", "bottom": "10%"}, "xAxis": {"type": "value", "max": 5, "show": false}, "yAxis": {"type": "category", "data": ["成飞-歼20", "沈飞-歼35", "沈飞-六代机"], "inverse": true, "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "barWidth": 16, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}, "label": {"show": true, "position": "right", "color": "#666"}, "data": [{"value": 5, "itemStyle": {"color": "#1677ff"}, "label": {"formatter": "接近达峰"}}, {"value": 3, "itemStyle": {"color": "#52c41a"}, "label": {"formatter": "小批量生产"}}, {"value": 2, "itemStyle": {"color": "#fa8c16"}, "label": {"formatter": "首飞"}}]}]}}]}}

