data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T18:35:45.954892", "content": {"results": [{"id": "fact_627ae395", "title": "媒体解读称，成飞连续6年达成“2323”均衡生产高级目标意味着歼-20年产量或再度超过100架；该表述为媒体推测，并非官方确认数据。", "source": "IT之家", "url": "", "snippet": "媒体解读称，成飞连续6年达成“2323”均衡生产高级目标意味着歼-20年产量或再度超过100架；该表述为媒体推测，并非官方确认数据。", "date": "", "isSupplementary": false}, {"id": "fact_fa9b9c32", "title": "中航工业集团表示，中航西飞年度工作安排的最后一架飞机于12月26日交付，全年批生产任务正式收官，并连续4年实现“2323”高质量均衡交付目标。", "source": "IT之家", "url": "", "snippet": "中航工业集团表示，中航西飞年度工作安排的最后一架飞机于12月26日交付，全年批生产任务正式收官，并连续4年实现“2323”高质量均衡交付目标。", "date": "", "isSupplementary": false}, {"id": "fact_8cca973f", "title": "2024年成飞贯彻落实党的二十届三中全会精神，强化“首责主责主业”意识，全力支撑现代航空工业体系建设，压茬落实“倒计时推进”要求，狠抓全要素风险管理和技术状态管...", "source": "澎湃新闻（澎湃号·政务）", "url": "", "snippet": "2024年成飞贯彻落实党的二十届三中全会精神，强化“首责主责主业”意识，全力支撑现代航空工业体系建设，压茬落实“倒计时推进”要求，狠抓全要素风险管理和技术状态管控，确保科研生产任务圆满收官。", "date": "", "isSupplementary": false}, {"id": "fact_479fba87", "title": "成飞一批国家级、省部级创新平台和重点实验室高质量建设并投入运行，面向新系统、新技术、新产品加大投入，推进核心能力优势加速构建。", "source": "澎湃新闻（澎湃号·政务）", "url": "", "snippet": "成飞一批国家级、省部级创新平台和重点实验室高质量建设并投入运行，面向新系统、新技术、新产品加大投入，推进核心能力优势加速构建。", "date": "", "isSupplementary": false}, {"id": "fact_fc8ce61b", "title": "成飞六代机采用无尾三角翼布局，与边条翼几乎融合，形成双三角翼设计，外形更流线型。", "source": "今日头条", "url": "", "snippet": "成飞六代机采用无尾三角翼布局，与边条翼几乎融合，形成双三角翼设计，外形更流线型。", "date": "", "isSupplementary": true}, {"id": "fact_c7e4866f", "title": "有网络观点认为沈飞六代机可能是无人僚机（无明显座舱），成飞六代机是有人歼轰；该说法属于网友推测，未获官方确认。", "source": "今日头条", "url": "", "snippet": "有网络观点认为沈飞六代机可能是无人僚机（无明显座舱），成飞六代机是有人歼轰；该说法属于网友推测，未获官方确认。", "date": "", "isSupplementary": true}, {"id": "fact_1546fccf", "title": "分析观点认为成飞、沈飞两款六代机可能不是竞争关系而是互补：成飞版以后可能作为空军主力战机，沈飞版可能上舰。", "source": "风闻", "url": "", "snippet": "分析观点认为成飞、沈飞两款六代机可能不是竞争关系而是互补：成飞版以后可能作为空军主力战机，沈飞版可能上舰。", "date": "", "isSupplementary": true}, {"id": "fact_b7a512a5", "title": "两款六代机都没有垂尾，无尾布局被视为六代机的外在标志之一；二者可看作飞翼布局但更近似升力体，全机升力更大、更省油、飞得更远。", "source": "风闻", "url": "", "snippet": "两款六代机都没有垂尾，无尾布局被视为六代机的外在标志之一；二者可看作飞翼布局但更近似升力体，全机升力更大、更省油、飞得更远。", "date": "", "isSupplementary": true}, {"id": "fact_3695503f", "title": "成飞版六代机的垂尾功能由主翼后缘外侧四个减速板实现，近似B-2的裂开式减速板；视频显示其似乎还可垂直偏转，以加大偏航效率、有利机动性。", "source": "风闻", "url": "", "snippet": "成飞版六代机的垂尾功能由主翼后缘外侧四个减速板实现，近似B-2的裂开式减速板；视频显示其似乎还可垂直偏转，以加大偏航效率、有利机动性。", "date": "", "isSupplementary": true}, {"id": "fact_9662606c", "title": "有军事分析称沈飞六代机更像“第六代格斗机”，设计注重隐身与空中格斗；成飞型则偏重多用途打击平台，甚至被美国前F-16飞行员比作轰炸机。", "source": "中华网军事", "url": "", "snippet": "有军事分析称沈飞六代机更像“第六代格斗机”，设计注重隐身与空中格斗；成飞型则偏重多用途打击平台，甚至被美国前F-16飞行员比作轰炸机。", "date": "", "isSupplementary": true}, {"id": "fact_4aebef7c", "title": "六代机除取消尾翼外，还增加有人/无人驾驶、人工智能辅助或主导，以及格斗、电子战、轰炸、指挥忠诚僚机等多任务功能，体型会显著增大。", "source": "风闻", "url": "", "snippet": "六代机除取消尾翼外，还增加有人/无人驾驶、人工智能辅助或主导，以及格斗、电子战、轰炸、指挥忠诚僚机等多任务功能，体型会显著增大。", "date": "", "isSupplementary": true}, {"id": "fact_6e123671", "title": "南北两款六代机均采用无尾布局，具有雷达反射截面积小、气动效率高、减少载机自重等特点；取消垂尾与平尾后隐身性能大幅提升。", "source": "中华网军事", "url": "", "snippet": "南北两款六代机均采用无尾布局，具有雷达反射截面积小、气动效率高、减少载机自重等特点；取消垂尾与平尾后隐身性能大幅提升。", "date": "", "isSupplementary": true}, {"id": "fact_63301d06", "title": "无尾布局带来横航向稳定性和操纵控制问题，南北六代机分别采用开裂式方向舵与全动翼尖方向舵解决。", "source": "中华网军事", "url": "", "snippet": "无尾布局带来横航向稳定性和操纵控制问题，南北六代机分别采用开裂式方向舵与全动翼尖方向舵解决。", "date": "", "isSupplementary": true}, {"id": "fact_fed371b1", "title": "南北六代机在推力矢量技术方面均采用二元喷管，外罩形状有所不同；成飞六代机具体为二元喷管（原文后文截断）。", "source": "中华网军事", "url": "", "snippet": "南北六代机在推力矢量技术方面均采用二元喷管，外罩形状有所不同；成飞六代机具体为二元喷管（原文后文截断）。", "date": "", "isSupplementary": true}, {"id": "fact_dddabb75", "title": "按政府工作报告设定的5%增长目标测算，2023年中国军费占GDP的比重为1.2%，远低于世界其他主要大国；改革开放以来国防费占GDP比重从最高5.43%下降到2...", "source": "网易", "url": "", "snippet": "按政府工作报告设定的5%增长目标测算，2023年中国军费占GDP的比重为1.2%，远低于世界其他主要大国；改革开放以来国防费占GDP比重从最高5.43%下降到2023年的1.2%，30多年来一直保持在2%以内。", "date": "", "isSupplementary": true}, {"id": "fact_c6ba4eee", "title": "中国军费支出占GDP比例为1.6%，低于对比国家平均水平2.8%；对比国家中印度2.4%、俄罗斯4.1%、沙特7.4%、英国2.2%、德国1.4%。", "source": "三个皮匠报告", "url": "", "snippet": "中国军费支出占GDP比例为1.6%，低于对比国家平均水平2.8%；对比国家中印度2.4%、俄罗斯4.1%、沙特7.4%、英国2.2%、德国1.4%。", "date": "", "isSupplementary": true}, {"id": "fact_63ecaa4e", "title": "2023年中国军费预算约为15537亿元，同比增长7.2%，自2020年开始增速连续上升；自2018年以来军费占GDP比重呈波动上升态势，2024年军费占GDP...", "source": "小牛行研", "url": "", "snippet": "2023年中国军费预算约为15537亿元，同比增长7.2%，自2020年开始增速连续上升；自2018年以来军费占GDP比重呈波动上升态势，2024年军费占GDP比重有望提升。", "date": "", "isSupplementary": true}, {"id": "fact_bdd608a8", "title": "据SIPRI数据库统计，2021年美国军费开支约7678亿美元，同年中国军费为2700亿美元，约为美国军费的35%；2021年美国、印度、俄罗斯军费占GDP比重...", "source": "小牛行研（引用SIPRI）", "url": "", "snippet": "据SIPRI数据库统计，2021年美国军费开支约7678亿美元，同年中国军费为2700亿美元，约为美国军费的35%；2021年美国、印度、俄罗斯军费占GDP比重分别约为3.5%、2.7%、4.1%，而中国仅为1.7%。", "date": "", "isSupplementary": true}, {"id": "fact_69f322e2", "title": "根据SIPRI统计，2022年世界军费实际增长3.7%，达到创纪录的21819亿美元（以2022年美元价格和汇率计算为22400亿美元）；2013—2022年期...", "source": "手机搜狐网", "url": "", "snippet": "根据SIPRI统计，2022年世界军费实际增长3.7%，达到创纪录的21819亿美元（以2022年美元价格和汇率计算为22400亿美元）；2013—2022年期间全球军费支出增长了18.66%，自2015年以来全球军费支出每年都在增长。", "date": "", "isSupplementary": true}, {"id": "fact_caeb751f", "title": "2023年中国军费预算为15537亿元，同比增长7.2%，军费增速连续三年保持增长；全球或将进入新一轮国防投入高增长期，我国军费有望保持高增长。", "source": "立鼎产业研究网", "url": "", "snippet": "2023年中国军费预算为15537亿元，同比增长7.2%，军费增速连续三年保持增长；全球或将进入新一轮国防投入高增长期，我国军费有望保持高增长。", "date": "", "isSupplementary": true}]}}

