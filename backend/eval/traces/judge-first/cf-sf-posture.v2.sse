data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T18:31:01.993432", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Year': [2020, 2023, 2024, 2025, 2026],\n    'Defense_Budget': [12900, 15537, 16655.4, 17846.65, 19095.61]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\ncomp = {\n    'Company': ['成飞', '沈飞'],\n    'Revenue': [750.0, 428.37],\n    'NetProfit': [24.0, 33.94]\n}\ndc = pd.DataFrame(comp)\nfor col in dc.columns:\n    if col != 'Company':\n        dc[col] = pd.to_numeric(dc[col], errors='coerce')\ndc = dc.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nax1.bar(df['Year'].astype(str), df['Defense_Budget'], color='#6366f1', alpha=0.85, width=0.55)\nfor x, y in zip(df['Year'].astype(str), df['Defense_Budget']):\n    ax1.text(x, y + 350, f'{y:,.0f}', ha='center', fontsize=10, fontweight='bold')\nax1.set_title('国防支出预算：十五五需求底座', fontsize=15, fontweight='bold', pad=15)\nax1.set_xlabel('年份', fontsize=13)\nax1.set_ylabel('国防支出预算（亿元）', fontsize=13)\nax1.tick_params(labelsize=11)\nax1.grid(True, linestyle='--', alpha=0.3)\nax2 = axes[1]\nx = np.arange(len(dc['Company']))\nw = 0.35\nax2.bar(x - w/2, dc['Revenue'], w, label='营业总收入（亿元）', color='#06b6d4')\nax2.bar(x + w/2, dc['NetProfit'], w, label='归母净利润（亿元）', color='#10b981')\nfor i, v in enumerate(dc['Revenue']):\n    ax2.text(i - w/2, v + 15, f'{v:.0f}', ha='center', fontsize=10, fontweight='bold')\nfor i, v in enumerate(dc['NetProfit']):\n    ax2.text(i + w/2, v + 15, f'{v:.1f}', ha='center', fontsize=10, fontweight='bold')\nax2.set_xticks(x)\nax2.set_xticklabels(dc['Company'], fontsize=12)\nax2.set_title('成飞 vs 沈飞：规模与盈利结构', fontsize=15, fontweight='bold', pad=15)\nax2.set_ylabel('金额（亿元）', fontsize=13)\nax2.legend(fontsize=11)\nax2.tick_params(labelsize=11)\nax2.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "选取国防支出预算（2020-2026）作为十五五战略投入背景，并以成飞与沈飞2024年营业总收入、归母净利润及主力机型年产能（歼-20约100架/年 vs 歼-35新厂2026年目标>100架/年）作为战略定位差异的量化锚点。左图展示国防预算持续7%左右增长为两家主机厂提供的共同需求底座；右图对比两家的规模-盈利结构，揭示成飞'成熟机型放量、规模领先但净利率偏低'与沈飞'新机型爬坡、产能扩张弹性大、盈利质量更优'的差异化定位。"}}

