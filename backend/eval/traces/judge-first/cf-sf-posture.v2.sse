data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T18:23:11.913217", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述十五五期间军用航空装备市场规模、国防预算增速、空军海军航空兵换装需求、军贸出口及无人机市场空间，并区分成飞与沈飞可覆盖的细分市场。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["十五五 军用航空装备 市场规模 国防预算 军机采购 成飞 沈飞"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述成飞、沈飞及西飞等主机厂在战斗机、舰载机、无人机和外贸军机领域的竞争关系，分析两厂型号谱系、产能布局、订单结构和客户定位差异。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 沈飞 竞争格局 歼-20 歼-35 歼-15 歼-16 军机主机厂 产能"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述隐身技术、无人化、智能化、舰载适配、六代机预研、数字孪生和批产制造等核心技术趋势，分析成飞与沈飞技术路线和研发重点差异。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["隐身战机 舰载机 无人僚机 六代机 数字孪生 成飞 沈飞 技术路线"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、装备采购制度改革、国企改革、军民融合、军贸出口管制和航空产业链自主可控等政策，分析其对两厂战略定位的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["十五五 国防预算 装备采购 国企改革 军贸政策 航空工业 成飞 沈飞"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述两厂面临的产能瓶颈、供应链安全、技术迭代、军贸竞争和成本控制挑战，以及舰载航空、无人机、外贸市场和民机配套带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 产能 供应链 军贸 无人机 舰载机 挑战 机遇"]}, {"id": "sec_6", "title": "未来展望", "description": "展望十五五期间成飞与沈飞战略定位演化：成飞强化隐身制空、无人机和军贸优势，沈飞强化舰载航空、多用途战机和北方产业基地，形成互补分工。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["十五五 成飞 沈飞 战略定位 未来 发展 分工 舰载 隐身 无人机"]}], "research_questions": ["成飞与沈飞在十五五期间的核心型号谱系和订单结构将如何分化？", "两厂在隐身制空、舰载航空、无人机和军贸领域的战略定位差异由哪些政策和市场因素驱动？", "十五五期间两厂是趋向专业化分工还是同质化竞争，关键验证指标是什么？"]}}

