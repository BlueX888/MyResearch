data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T18:31:50.025215", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'Year': [2020, 2024], 'DefenseBudget': [1.29, 1.7]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['DefenseBudget'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='国防支出预算')\nplt.fill_between(df['Year'], df['DefenseBudget'], alpha=0.15, color='#6366f1')\nfor x, y in zip(df['Year'], df['DefenseBudget']):\n    plt.text(x, y + 0.03, f'{y:.2f}万亿元', ha='center', fontsize=11, fontweight='bold')\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('国防支出预算（万亿元）', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(1.2, 1.85)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\ninfo_text = '竞争格局要点：\\n歼-20接近达峰；歼-35小批量生产\\n沈飞搬迁2024-2025；六代机首飞2024-12\\n十四五军机市场空间7500亿元；战斗机5800亿元'\nplt.text(2020.1, 1.82, info_text, fontsize=10, verticalalignment='top', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8, edgecolor='#6366f1'))\nplt.legend(fontsize=12)\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

