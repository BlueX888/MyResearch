data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T18:23:39.800164", "content": {"graph": {"nodes": [{"id": "node_0", "name": "成都飞机工业集团（成飞）", "type": "company", "discovered_at": "2026-11-10T18:23:39.800041"}, {"id": "node_1", "name": "沈阳飞机工业集团（沈飞/中航沈飞）", "type": "company", "discovered_at": "2026-11-10T18:23:39.800055"}, {"id": "node_2", "name": "西安飞机工业集团（西飞）", "type": "company", "discovered_at": "2026-11-10T18:23:39.800064"}, {"id": "node_3", "name": "贵州航空工业（贵飞）", "type": "company", "discovered_at": "2026-11-10T18:23:39.800069"}, {"id": "node_4", "name": "歼-20", "type": "technology", "discovered_at": "2026-11-10T18:23:39.800074"}, {"id": "node_5", "name": "歼-35/FC-31", "type": "technology", "discovered_at": "2026-11-10T18:23:39.800082"}, {"id": "node_6", "name": "歼-15", "type": "technology", "discovered_at": "2026-11-10T18:23:39.800092"}, {"id": "node_7", "name": "歼-16", "type": "technology", "discovered_at": "2026-11-10T18:23:39.800098"}, {"id": "node_8", "name": "歼-10", "type": "technology", "discovered_at": "2026-11-10T18:23:39.800103"}, {"id": "node_9", "name": "军品设计回报机制", "type": "policy", "discovered_at": "2026-11-10T18:23:39.800109"}], "edges": [{"source": "成都飞机工业集团（成飞）", "relation": "歼-20制造商", "discovered_at": "2026-11-10T18:23:39.800047"}, {"source": "成都飞机工业集团（成飞）", "relation": "歼-10制造商", "discovered_at": "2026-11-10T18:23:39.800049"}, {"source": "成都飞机工业集团（成飞）", "relation": "已注入中航电测", "discovered_at": "2026-11-10T18:23:39.800051"}, {"source": "成都飞机工业集团（成飞）", "relation": "与沈飞构成制空/舰载分工", "discovered_at": "2026-11-10T18:23:39.800052"}, {"source": "沈阳飞机工业集团（沈飞/中航沈飞）", "relation": "歼-15舰载机制造商", "discovered_at": "2026-11-10T18:23:39.800057"}, {"source": "沈阳飞机工业集团（沈飞/中航沈飞）", "relation": "歼-35/FC-31研制方", "discovered_at": "2026-11-10T18:23:39.800058"}, {"source": "沈阳飞机工业集团（沈飞/中航沈飞）", "relation": "歼-11/歼-16制造商", "discovered_at": "2026-11-10T18:23:39.800060"}, {"source": "沈阳飞机工业集团（沈飞/中航沈飞）", "relation": "厂区搬迁扩产", "discovered_at": "2026-11-10T18:23:39.800061"}, {"source": "西安飞机工业集团（西飞）", "relation": "轰-6、运-20、歼轰-7制造商", "discovered_at": "2026-11-10T18:23:39.800065"}, {"source": "西安飞机工业集团（西飞）", "relation": "与成飞沈飞在轰炸机/运输机领域互补", "discovered_at": "2026-11-10T18:23:39.800067"}, {"source": "贵州航空工业（贵飞）", "relation": "承接成飞歼-10生产线转移", "discovered_at": "2026-11-10T18:23:39.800071"}, {"source": "贵州航空工业（贵飞）", "relation": "教练机/外贸机型", "discovered_at": "2026-11-10T18:23:39.800072"}, {"source": "歼-20", "relation": "成飞", "discovered_at": "2026-11-10T18:23:39.800076"}, {"source": "歼-20", "relation": "隐身制空", "discovered_at": "2026-11-10T18:23:39.800077"}, {"source": "歼-20", "relation": "产量接近达峰", "discovered_at": "2026-11-10T18:23:39.800079"}, {"source": "歼-20", "relation": "短期不可出口", "discovered_at": "2026-11-10T18:23:39.800080"}, {"source": "歼-35/FC-31", "relation": "沈飞", "discovered_at": "2026-11-10T18:23:39.800084"}, {"source": "歼-35/FC-31", "relation": "舰载隐身", "discovered_at": "2026-11-10T18:23:39.800085"}, {"source": "歼-35/FC-31", "relation": "小批量生产", "discovered_at": "2026-11-10T18:23:39.800087"}, {"source": "歼-35/FC-31", "relation": "具备出口潜力", "discovered_at": "2026-11-10T18:23:39.800088"}, {"source": "歼-15", "relation": "沈飞", "discovered_at": "2026-11-10T18:23:39.800094"}, {"source": "歼-15", "relation": "舰载机", "discovered_at": "2026-11-10T18:23:39.800096"}, {"source": "歼-16", "relation": "沈飞", "discovered_at": "2026-11-10T18:23:39.800099"}, {"source": "歼-16", "relation": "多用途战机", "discovered_at": "2026-11-10T18:23:39.800101"}, {"source": "歼-10", "relation": "成飞研制", "discovered_at": "2026-11-10T18:23:39.800104"}, {"source": "歼-10", "relation": "生产线已转移至贵飞", "discovered_at": "2026-11-10T18:23:39.800106"}, {"source": "歼-10", "relation": "外贸机型", "discovered_at": "2026-11-10T18:23:39.800107"}, {"source": "军品设计回报机制", "relation": "装备采购制度改革", "discovered_at": "2026-11-10T18:23:39.800111"}, {"source": "军品设计回报机制", "relation": "影响自筹研发模式的沈飞", "discovered_at": "2026-11-10T18:23:39.800112"}]}, "stats": {"entitiesCount": 10, "relationsCount": 29}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T18:23:39.800249", "content": {"agent": "DeepScout", "section": "竞争格局", "facts_count": 9, "duplicates_removed": 0, "data_points_count": 3, "insights": ["现有搜索结果几乎全部为自媒体/股吧/门户转载（ credibility 0.25-0.45），无一份官方文件、上市公司年报或券商深度报告，证据强度不足以支撑十五五战略定位结论。", "型号谱系分工是唯一被多源交叉印证的结论：成飞=歼-10/歼-20（自主创新、制空隐身），沈飞=歼-11/歼-15/歼-16/FC-31（侧卫改进、舰载与多用途），西飞=轰炸机/运输机，贵飞承接成飞歼-10产能。", "产能布局出现动态调整信号：沈飞2024—2025搬迁扩产（短期产量承压、中期舰载机批产能力提升），成飞将歼-10转产贵飞以腾出产能聚焦歼-20，符合“成飞向高代次隐身机集中、沈飞向舰载机扩产”的分工逻辑。"], "source_quality": "整体来源质量低（加权平均可信度约0.31）。9条结果中8条为自媒体（东方财富财富号、股吧、雪球、天眼查企业头条、搜狐），1条为门户军事频道转载，无任何官方（国防部、国资委、航空工业集团、上市公司公告）、学术或券商研报来源。多数内容为股民观点性表述（如“成飞吊打沈飞”“市值3000亿”），带有明显投资情绪，且存在事实性错误风险（如将歼-31列为在产型号）。时间跨度2015—2024年，部分信息已过时。结论：本轮搜索结果仅可用于生成待验证线索与后续检索方向，不能作为研究章节的事实依据，必须补充官方公告、年报、券商深度报告与政策原文。", "hypothesis_updates": 3, "search_results": [{"title": "中国都有哪些飞机制造企业?都有哪些产品?-搜狐", "url": "https://mt.sohu.com/20170529/n494879051.shtml", "source": "搜狐网", "snippet": "沈飞 主要生产战斗机,产品有有:歼-8F、歼-11B、歼-15、歼-31。 成飞 主要生产战斗机,产品有:歼-5甲、歼7、歼10、歼20。 西飞 主要生产轰炸机、运输机,产品有:歼轰-7、轰-6、运-6、新舟60、运-20。 贵飞 主要生产教练机,产品有歼教-7、歼教-9。 昌飞 主要生产直升机,产品有直-8、武直-10、直-20。 哈飞", "date": "2017-05-29T00:22:00+08:00"}, {"title": "沈飞成飞未来的利润增长因素对比_财富号_东方财富网", "url": "https://caifuhao.eastmoney.com/news/20240724175123130131630", "source": "财富号", "snippet": "1,歼20产量接近或已经达峰,歼35刚刚小批量生产。 2,歼35/31可以出口,歼20近几年还不能出口。 3,沈飞今年明年搬迁,产量受影响。歼10从成飞迁贵飞已经完成。 4,歼20是买方出资设计的,歼35的原型FC31是沈飞出资研发的(不确定出了全部还是部分)。采购制度改革,建立军品设计回报机制,对沈飞有利。见下图: 综上:今年成飞增长好于沈飞,明年不确定,后年开始沈飞好于成飞。 郑重声明:", "date": "2024-07-24T17:51:00+08:00"}, {"title": "就是成飞比沈飞厉害,因为现在的空军主力歼20由成飞生产,未来最少500架订单市值多少。不要说歼20可以外包给沈飞的话,即... - 雪球", "url": "https://xueqiu.com/2901729886/242947667", "source": "雪球", "snippet": "就是成飞比沈飞厉害,因为现在的空军主力歼20由成飞生产,未来最少500架订单市值多少。不要说歼20可以外包给沈飞的话,即使外包给沈飞,沈飞也不可能拿大头,因此成飞未来的市值在3000亿以上", "date": "2023-02-25T13:48:00+08:00"}, {"title": "沈飞集团产能攀升,歼-35批产数量有望超越歼-20?_财富号_东方财富网", "url": "https://caifuhao.eastmoney.com/news/20230612175059958870910", "source": "财富号", "snippet": "沈飞集团军用飞机产能攀升,歼-35批产或超越歼-20? 中国航空工业沈飞公司最近在一场业绩说明会上放出了一段引人注目的宣传片,展示了其新建的总装厂房和大批量生产新型战斗机的能力。这引发了外界对沈飞集团承担歼-35型舰载机批产任务的猜测。作为中国第二款五代机,歼-35战斗机的批产数量有可能超过歼-20战斗机。那么,对于这一说法,我们该如何评价呢? 从第三代战斗机时代开始,沈飞和成飞之间的产能竞争一直备受军迷们的关注。沈飞在制造难度和批产数量上一度遥遥领先成飞。在本世纪初,沈飞成功批产了一系列战斗机,如歼-11型战斗机、歼-8F/FR和歼-8H型战斗机,彰显了其在第三代战斗机制造方面的实力。与此同时,成飞当时还在批产歼-7E/G,与沈飞的产能相比显得相对滞后。 然而,随着时间的推移,成飞逐渐迎头赶上。成飞在第四代战斗机的研制和生产方面取得了重大突破,特别是歼-10战斗机的成功批产,为成飞树立了崭新的形象。成飞的产能和技术水平也得到了提升,使其在国内军用飞机制造领域崭露头角。 然而,沈飞集团最近的业绩说明会显示出其军用飞机产能的攀升趋势。新建的总装厂房以及大量生产新型战斗机的能力展示了沈飞在技术和产能方面的巨大潜力。考虑到沈飞在过去的经验和技术基础上进行扩展,承担歼-35战斗机的批产任务并不是不可能的。 如果沈飞确实能够超越歼-20战斗机的批产数量,将承担歼-35战斗机的大规模生产任务,这将是沈飞集团的重大突破和进步。歼-35作为中国的第二款五代机,具备先进的隐身能力和多用途作战能力,对于中国空军的现代化建设具有重要意义。歼-35战斗机的批产数量的增加将为中国空军提供更多的现代化装备,增强其作战能力和综合实力。 然而,我们也要客观看待这一说法所蕴含的猜测性质。尽管沈飞集团展示了强大的军用飞机产能,但歼-35战斗机的批产数量是否会超过歼-20战斗机还需要进一步的证实和权威消息的发布", "date": "2023-06-12T17:50:00+08:00"}, {"title": "中国沈飞及成飞等4大军机工厂曝光_网易军事", "url": "https://war.163.com/photoview/4T8E0001/83702.html", "source": "网易军事", "snippet": "沈飞、成飞、西飞、贵飞等公司是中国最重要的几个战机生产基地,这些工厂的生产制造水平,关系着中国空军的实力。歼11、歼15、歼10、歼7、歼轰7、轰6等的装配生产线,相比较可能洞悉出哪家是中国制造能力最强的飞机工厂。", "date": "2015-01-29T07:28:00+08:00"}, {"title": "对比起来,成飞集团吊打中航沈飞中航沈飞:军用飞机业务布局及运营现状——军用飞机业_中航电测(300114)股吧_东方财富网股吧", "url": "http://gubaf10.eastmoney.com/news,300114,1279794853.html", "source": "东方财富网股吧", "snippet": "最近访问: 对比起来,成飞集团吊打中航沈飞中航沈飞 :军用飞机业务布局及运营现状 ——军用飞机业务布局:以三代至四代战斗机为主中航沈飞自创立以来先后成功研制了歼5、歼6、歼7、歼8等我国大部分主力服役歼击机。目前,中航沈飞在营的主要产品以三代和三代半战机为主,包括了主力战机歼11、歼15舰载机等。 郑重声明:用户在财富号/股吧/博客等社区发表的所有信息(包括但不限于文字、视频、音频、数据及图表)仅代表个人观点,与本网站立场无关,不对您构成任何投资建议,据此操作风险自担。 请勿相信代客理财、免费荐股和炒股培训等宣传内容,远离非法证券活动。请勿添加发言用户的手机号码、公众号、微博、微信及QQ等信息,谨防上当受骗! 作者:您目前是匿名发表 郑重声明:用户在社区发表的所有资料、言论等仅代表个人观点,与本网站立场无关,不对您构成任何投资建议。用户应基于自己的独立判断,自行决定证券投资并承担相应风险。 《东方财富社区管理规定》", "date": "2023-02-22T17:27:43+08:00"}, {"title": "成飞、沈飞、西飞、贵飞谁才是中国航空顶梁柱? - 天眼查", "url": "https://news.tianyancha.com/ll_4qh6x1wyd5.html", "source": "天眼查企业头条", "snippet": "近年来,我国的科技水平迅速飞速提升,军工企业也迎来了迅猛发展。随着运20、歼20、歼15等先进战斗机陆续进入现役,我国人民空军正朝着建设战略空军的目标稳步前进。那么,作为我国各型主力战机的主要供应商,中航工业\"\nclass=\"candidate-entity-word\nentity-word\"\ndata-gid=\"5171753514595372018\"\nmention-index=\"0\"\nqi...查看全文", "date": "2023-11-05T00:00:00+08:00"}, {"title": "沈飞2021放大招!魔改升级和五代机同步进行,一年完成3个大项目 - 天眼查", "url": "https://news.tianyancha.com/ll_mtti4m0ybh.html", "source": "天眼查企业头条", "snippet": "2736090196707328\n中国空军在现今世界舞台上具有重要地位,其发展离不开两大支柱企业,即中国航空工业集团公司(简称成飞)和中国航空工业沈阳飞机设计研究所(简称沈飞)。成飞以其招牌产品歼-20和歼-10战机而著名,为广大军事爱好者所熟知。与此不同的是,沈飞以对俄罗斯侧卫系列战斗机的仿制而声名远扬。沈飞旗下的国产战机包括歼-11、歼-15和歼-16。然而,相较于成飞的“自主创新”并推出歼...查看全文", "date": "2023-10-26T00:00:00+08:00"}, {"title": "沈飞2021放大招!魔改升级和五代机同步进行,一年完成3个大项目 - 天眼查", "url": "https://mnews.tianyancha.com/ll_mtti4m0ybh.html", "source": "天眼查企业头条", "snippet": "2736090196707328\n中国空军在现今世界舞台上具有重要地位,其发展离不开两大支柱企业,即中国航空工业集团公司(简称成飞)和中国航空工业沈阳飞机设计研究所(简称沈飞)。成飞以其招牌产品歼-20和歼-10战机而著名,为广大军事爱好者所熟知。与此不同的是,沈飞以对俄罗斯侧卫系列战斗机的仿制而声名远扬。沈飞旗下的国产战机包括歼-11、歼-15和歼-16。然而,相较于成飞的“自主创新”并推出歼...查看全文相关企业信息注册资本:6400000万人民币成立时间:2008-11-06公司类型:有限责任公司(国有独资)经营状态:存续统一社会信用代码:91110000710935732K", "date": "2008-11-06T00:00:00+08:00"}], "extracted_facts": [{"content": "沈飞主要生产战斗机，产品谱系包括歼-8F、歼-11B、歼-15、歼-31（FC-31）；成飞主要生产战斗机，产品包括歼-5甲、歼-7、歼-10、歼-20；西飞主要生产轰炸机和运输机，产品包括歼轰-7、轰-6、运-20、新舟60。", "source_name": "搜狐网", "source_url": "https://mt.sohu.com/20170529/n494879051.shtml", "credibility": 0.35}, {"content": "歼-20产量接近或已经达峰，歼-35刚刚进入小批量生产阶段；歼-35/FC-31具备出口潜力，而歼-20近几年还不能出口。", "source_name": "东方财富网·财富号", "source_url": "https://caifuhao.eastmoney.com/news/20240724175123130131630", "credibility": 0.3}, {"content": "沈飞于2024—2025年进行厂区搬迁，期间产量受到影响；歼-10生产线从成飞向贵飞转移已经完成。", "source_name": "东方财富网·财富号", "source_url": "https://caifuhao.eastmoney.com/news/20240724175123130131630", "credibility": 0.3}, {"content": "歼-20为买方（军方）出资设计，歼-35原型FC-31由沈飞自筹资金研发；采购制度改革建立军品设计回报机制，该机制对自筹研发的沈飞更为有利。", "source_name": "东方财富网·财富号", "source_url": "https://caifuhao.eastmoney.com/news/20240724175123130131630", "credibility": 0.3}, {"content": "沈飞新建总装厂房并展示大批量生产新型战斗机的能力，外界猜测其承担歼-35舰载机批产任务，歼-35批产数量有可能超过歼-20。", "source_name": "东方财富网·财富号", "source_url": "https://caifuhao.eastmoney.com/news/20230612175059958870910", "credibility": 0.3}, {"content": "自第三代战斗机时代起，沈飞与成飞存在产能竞争；沈飞曾成功批产歼-11、歼-8F/FR、歼-8H等机型，在制造难度和批产数量上一度领先成飞。", "source_name": "东方财富网·财富号", "source_url": "https://caifuhao.eastmoney.com/news/20230612175059958870910", "credibility": 0.3}, {"content": "中航沈飞现有主要产品以三代和三代半战机为主，包括主力战机歼-11和歼-15舰载机；成飞以歼-20、歼-10为招牌产品，沈飞产品线则源于对俄制侧卫系列（苏-27）的引进仿制与改进（歼-11、歼-15、歼-16）。", "source_name": "东方财富网股吧/天眼查企业头条", "source_url": "http://gubaf10.eastmoney.com/news,300114,1279794853.html", "credibility": 0.25}, {"content": "成飞以自主创新路线推出歼-20、歼-10，沈飞以侧卫系列改进改型（歼-11、歼-15、歼-16）为主，两家技术路线存在明显差异。", "source_name": "天眼查企业头条", "source_url": "https://news.tianyancha.com/ll_mtti4m0ybh.html", "credibility": 0.3}], "data_points": [{"name": "歼-20产量状态", "value": "接近达峰", "unit": "定性", "year": 2024, "source": "东方财富网·财富号"}, {"name": "歼-35产量状态", "value": "小批量生产", "unit": "定性", "year": 2024, "source": "东方财富网·财富号"}, {"name": "沈飞搬迁时间窗口", "value": "2024-2025", "unit": "年", "year": 2024, "source": "东方财富网·财富号"}]}}

