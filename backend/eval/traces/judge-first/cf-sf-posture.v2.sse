data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T18:31:16.568977", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'年份': [2020, 2024], '国防支出预算（万亿元）': [1.29, 1.70]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['年份'], df['国防支出预算（万亿元）'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='国防支出预算')\nplt.fill_between(df['年份'], df['国防支出预算（万亿元）'], alpha=0.15, color='#6366f1')\nfor x, y in zip(df['年份'], df['国防支出预算（万亿元）']):\n    plt.text(x, y + 0.03, f'{y:.2f}万亿', ha='center', fontsize=11, fontweight='bold')\nplt.text(2024, 1.70 - 0.08, '同比+7.2%', ha='center', fontsize=11, color='#ef4444')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('国防支出预算（万亿元）', fontsize=14)\nplt.xticks(df['年份'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

