data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:49:45.528739", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'年份': [2024, 2025], '总资产': [1079.06, 1145.48], '净利润': [32.24, 34.32]}\ndf = pd.DataFrame(data)\nfig, ax1 = plt.subplots(figsize=(12, 7), dpi=200)\nax1.plot(df['年份'], df['总资产'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='总资产（亿元）')\nax1.fill_between(df['年份'], df['总资产'], 1000, color='#6366f1', alpha=0.15)\nfor x, y in zip(df['年份'], df['总资产']):\n    ax1.text(x, y + 9, f'{y:.2f}', ha='center', fontsize=11, color='#4338ca', fontweight='bold')\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('总资产（亿元）', fontsize=14, color='#4338ca')\nax1.set_ylim(1000, 1210)\nax1.set_xticks(df['年份'])\nax1.tick_params(labelsize=12)\nax2 = ax1.twinx()\nax2.plot(df['年份'], df['净利润'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='归母净利润（亿元）')\nax2.fill_between(df['年份'], df['净利润'], 30, color='#f59e0b', alpha=0.15)\nfor x, y in zip(df['年份'], df['净利润']):\n    ax2.text(x, y + 0.35, f'{y:.2f}', ha='center', fontsize=11, color='#b45309', fontweight='bold')\nax2.set_ylabel('归母净利润（亿元）', fontsize=14, color='#b45309')\nax2.set_ylim(30, 36.5)\nax2.tick_params(labelsize=12)\nplt.title('竞争格局分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12, frameon=True)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

