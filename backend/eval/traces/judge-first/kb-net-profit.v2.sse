data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:44:45.448748", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述航空装备市场规模、增速及军机列装、军贸需求等驱动因素，分析2025年行业景气度对中航成飞收入与利润的影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 归母净利润 同比；航空装备 市场规模 2025 军机 列装 军贸"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述航空整机及零部件主要企业竞争格局，分析中航成飞在歼击机整机、航空零部件领域的市场地位、订单份额和盈利能力对比。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 竞争格局 歼击机 整机 航空零部件 市场份额"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述隐身化、无人化、智能制造和数字化装配等核心技术趋势，分析技术升级对产品结构、生产效率和利润率的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空制造 隐身 无人机 智能制造 数字化装配 技术趋势 中航成飞"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、军品定价机制、国企改革和军工资产证券化等相关政策，分析政策变化对2025年利润的传导机制。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 2025 军品定价机制 国企改革 军工 政策 中航成飞"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述供应链稳定性、交付节奏、成本控制、军贸拓展和产能释放等挑战与机会，分析其对2025年归母净利润及同比变化的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 供应链 交付 成本 军贸 产能 挑战 机遇 2025"]}, {"id": "sec_6", "title": "未来展望", "description": "描述“十五五”规划、航空装备升级、军贸出口和智能制造等发展趋势，展望中航成飞2025年后利润增长的可持续性。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 业绩 展望 十五五 航空装备 军贸 增长"]}], "research_questions": ["中航成飞2025年归属于上市公司股东的净利润具体数值及同比增速是多少？", "驱动2025年归母净利润变化的核心因素有哪些，包括交付节奏、产品结构、毛利率、费用、政府补助等？", "2025年业绩表现与航空装备行业景气、政策环境及竞争格局的关系如何，未来是否可持续？"]}}

