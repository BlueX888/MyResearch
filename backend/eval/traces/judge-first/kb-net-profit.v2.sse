data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:49:34.980778", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'DejaVu Sans']\nplt.rcParams['axes.unicode_minus'] = False\ndata = {'年份': ['2024（调整后）', '2025'], '总资产': [1079.06, 1145.48], '归母净利润': [32.24, 34.32]}\ndf = pd.DataFrame(data)\nx = np.arange(len(df['年份']))\nplt.figure(figsize=(12, 7), dpi=200)\nax1 = plt.gca()\nax2 = ax1.twinx()\nax1.plot(x, df['总资产'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='总资产（亿元）', zorder=3)\nax1.fill_between(x, df['总资产'], 1000, alpha=0.15, color='#6366f1')\nax2.plot(x, df['归母净利润'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='归母净利润（亿元）', zorder=3)\nax2.fill_between(x, df['归母净利润'], 28, alpha=0.15, color='#f59e0b')\nfor i, v in enumerate(df['总资产']):\n    ax1.text(i, v + 8, f'{v:.2f}', ha='center', fontsize=11, fontweight='bold', color='#4338ca')\nfor i, v in enumerate(df['归母净利润']):\n    ax2.text(i, v + 0.55, f'{v:.2f}', ha='center', fontsize=11, fontweight='bold', color='#b45309')\nax1.set_ylim(1000, 1200)\nax2.set_ylim(28, 38)\nax1.set_xticks(x)\nax1.set_xticklabels(df['年份'], fontsize=12)\nax1.set_xlim(-0.35, len(x) - 0.65)\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nax1.set_xlabel('报告期', fontsize=14)\nax1.set_ylabel('总资产（亿元）', fontsize=14, color='#4338ca')\nax2.set_ylabel('归母净利润（亿元）', fontsize=14, color='#b45309')\nax1.tick_params(axis='y', labelsize=12, colors='#4338ca')\nax2.tick_params(axis='y', labelsize=12, colors='#b45309')\nax1.tick_params(axis='x', labelsize=12)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12, frameon=True, framealpha=0.9)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine(ax=ax1, top=True, right=True)\nsns.despine(ax=ax2, top=True, left=True)\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

