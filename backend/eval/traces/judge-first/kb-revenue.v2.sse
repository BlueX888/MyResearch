data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:44:44.229183", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述全球及中国航空制造市场规模、增速、军机列装需求和航空零部件配套需求，为判断中航成飞2025年营业收入及同比增速提供行业背景。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 营业收入 同比增长 航空制造 市场规模 军机 交付"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述国内军机整机及航空零部件主要企业、成飞竞争地位、重点型号订单份额和交付节奏，分析其对2025年营收的影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 竞争格局 歼击机 整机 航空零部件 主要企业 市场份额 订单"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述隐身战机、无人机、数字化制造和产能建设等技术趋势对中航成飞产品交付、收入确认和成本结构的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 技术 隐身战机 无人机 数字化制造 产能 交付"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、军品定价机制、装备采购政策、国企改革等政策环境及其对中航成飞2025年营收确认和增速的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 2025 军品定价 国企改革 航空装备 采购 政策 中航成飞"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述交付节奏、供应链稳定性、军品定价机制等挑战，以及军贸出口、民机配套和产能释放等机会对2025年营收的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 交付节奏 供应链 军贸 民机配套 风险 机遇 2025 营收"]}, {"id": "sec_6", "title": "未来展望", "description": "描述中航成飞2025年营业收入预测方法、同比增速区间及关键假设，结合订单、产能、政策和行业需求给出验证路径。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 营收 预测 同比 增速 研报 订单 产能"]}], "research_questions": ["中航成飞2025年营业收入的具体数值及同比增速是多少？", "公司2025年营收增长的主要驱动因素和订单交付节奏如何？", "国防预算、军品定价和国企改革等政策如何影响2025年营收确认？"]}}

