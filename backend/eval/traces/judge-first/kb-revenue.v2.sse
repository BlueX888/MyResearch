data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:49:34.115711", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2024, 2025], 'Revenue': [650.55, 753.59]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nqdata = {'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'], 'Revenue': [33.09, 173.93, 275.84, 270.73]}\nqdf = pd.DataFrame(qdata)\nqdf['Revenue'] = pd.to_numeric(qdf['Revenue'], errors='coerce')\nqdf = qdf.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nbars = axes[0].bar(df['Year'].astype(str), df['Revenue'], color=['#06b6d4', '#6366f1'], width=0.5)\nfor b, v in zip(bars, df['Revenue']):\n    axes[0].text(b.get_x() + b.get_width() / 2, v + 12, f'{v:.2f}亿元', ha='center', fontsize=13, fontweight='bold')\naxes[0].set_title('营业收入年度对比（调整后口径）', fontsize=16, fontweight='bold', pad=15)\naxes[0].set_xlabel('年份', fontsize=14)\naxes[0].set_ylabel('营业收入（亿元）', fontsize=14)\naxes[0].tick_params(labelsize=12)\naxes[0].set_ylim(0, 900)\naxes[0].text(0.5, 0.92, '同比增长 +15.84%', transform=axes[0].transAxes, ha='center', fontsize=14, color='#10b981', fontweight='bold')\naxes[1].plot(qdf['Quarter'], qdf['Revenue'], linewidth=2.5, marker='o', markersize=8, color='#10b981')\naxes[1].fill_between(qdf['Quarter'], qdf['Revenue'], alpha=0.15, color='#10b981')\nfor x, y in zip(qdf['Quarter'], qdf['Revenue']):\n    axes[1].annotate(f'{y:.1f}', (x, y), textcoords='offset points', xytext=(0, 12), ha='center', fontsize=12, fontweight='bold')\naxes[1].set_title('2025年分季度营业收入', fontsize=16, fontweight='bold', pad=15)\naxes[1].set_xlabel('季度', fontsize=14)\naxes[1].set_ylabel('营业收入（亿元）', fontsize=14)\naxes[1].tick_params(labelsize=12)\naxes[1].set_ylim(0, 330)\nfor ax in axes:\n    ax.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从给定数据中提取中航成飞2025年营业收入（753.59亿元）与2024年调整后营业收入（650.55亿元），计算同比增长率15.84%；同时提取2025年四个季度营业收入，展示季度节奏（下半年占比72.5%）。用左右两个子图：左侧柱状图对比2024与2025年营收并标注同比增速，右侧折线+面积图展示2025年季度营收走势，突出Q3、Q4放量特征。"}}

