data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:49:42.480282", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['第一季度', '第二季度', '第三季度', '第四季度'], 'Revenue': [33.09, 173.93, 275.84, 270.73], 'Profit': [1.56, 7.56, 12.56, np.nan]}\ndf = pd.DataFrame(data)\nx = np.arange(len(df))\nfig, ax1 = plt.subplots(figsize=(12, 7), dpi=200)\nax1.plot(x, df['Revenue'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='营业收入（亿元）', zorder=3)\nax1.fill_between(x, df['Revenue'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['Revenue']):\n    ax1.text(i, v + 9, f'{v:.2f}', ha='center', fontsize=11, color='#4338ca', fontweight='bold')\nax1.set_xlabel('季度', fontsize=14)\nax1.set_ylabel('营业收入（亿元）', fontsize=14)\nax1.set_xticks(x)\nax1.set_xticklabels(df['Quarter'], fontsize=12)\nax1.set_yticks(ax1.get_yticks())\nax1.tick_params(axis='y', labelsize=12)\nax1.set_ylim(0, 320)\nax2 = ax1.twinx()\nax2.plot(x[:3], df['Profit'][:3], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='归母净利润（亿元）', zorder=3)\nfor i, v in enumerate(df['Profit'][:3]):\n    ax2.text(i, v + 0.7, f'{v:.2f}', ha='center', fontsize=11, color='#b45309', fontweight='bold')\nax2.set_ylabel('归母净利润（亿元）', fontsize=14)\nax2.tick_params(axis='y', labelsize=12)\nax2.set_ylim(0, 16)\nax2.grid(False)\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12, frameon=False)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

