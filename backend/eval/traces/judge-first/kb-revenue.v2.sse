color": "#f0f0f0"}}}, "yAxis": {"type": "category", "data": ["营业收入", "归母净利润", "总资产", "归母净资产"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 13}}, "series": [{"type": "bar", "barWidth": 14, "showBackground": true, "backgroundStyle": {"color": "#f5f5f5"}, "data": [{"value": 15.84, "itemStyle": {"color": "#1677ff"}}, {"value": 6.47, "itemStyle": {"color": "#52c41a"}}, {"value": 6.16, "itemStyle": {"color": "#722ed1"}}, {"value": 9.15, "itemStyle": {"color": "#fa8c16"}}], "label": {"show": true, "position": "right", "formatter": "{c}%", "color": "#666"}}]}}]}}

