data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:53:54.110310", "content": {"results": [{"id": "fact_65d8ad82", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "source": "中航成飞2025年年度报告摘要（本地知识库CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": false}, {"id": "fact_27b29aa3", "title": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股，以资本公积金向全体...", "source": "中航成飞2025年年度报告摘要（本地知识库CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股，以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": false}, {"id": "fact_07aea0d0", "title": "报告期内，中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "中航成飞2025年年度报告摘要（本地知识库CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "报告期内，中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_cf844a7f", "title": "中航成飞2025年末总资产为114,547,703,019.42元，2024年末调整后总资产为107,905,965,442.13元，本年末比上年末调整后增减幅...", "source": "中航成飞2025年年度报告摘要（本地知识库CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞2025年末总资产为114,547,703,019.42元，2024年末调整后总资产为107,905,965,442.13元，本年末比上年末调整后增减幅度为6.16%。", "date": "", "isSupplementary": false}, {"id": "fact_1324a643", "title": "中航成飞2025年年度报告摘要中近三年主要会计数据存在追溯调整或重述，追溯调整原因为同一控制下企业合并。", "source": "中航成飞2025年年度报告摘要（本地知识库CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞2025年年度报告摘要中近三年主要会计数据存在追溯调整或重述，追溯调整原因为同一控制下企业合并。", "date": "", "isSupplementary": false}, {"id": "fact_a20752b5", "title": "中航成飞控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612.00股。", "source": "中航成飞2025年年度报告摘要（本地知识库CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞控股股东为中国航空工业集团有限公司，持股比例78.66%，持股数量2,101,738,612.00股。", "date": "", "isSupplementary": false}, {"id": "fact_16250fa1", "title": "中航成飞（证券代码302132）2025年年度报告摘要披露：2025年实现营业收入75,358,958,001.86元；2024年调整后营业收入为65,054,...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞（证券代码302132）2025年年度报告摘要披露：2025年实现营业收入75,358,958,001.86元；2024年调整后营业收入为65,054,925,106.17元（调整前为1,779,761,710.30元，因同一控制下企业合并追溯调整），本年比上年增减为15.84%。", "date": "", "isSupplementary": true}, {"id": "fact_ea195dbf", "title": "中航成飞2025年末总资产为114,547,703,019.42元，2024年末调整后为107,905,965,442.13元，本年末比上年末增长6.16%。公...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞2025年末总资产为114,547,703,019.42元，2024年末调整后为107,905,965,442.13元，本年末比上年末增长6.16%。公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": true}, {"id": "fact_86586e24", "title": "本次补充搜索未检索到中航沈飞、中航西飞、航发动力的2025年营业收入及增速数据，搜索结果全部为中航成飞2025年年度报告摘要内容，无法完成军工整机同业增速的横向...", "source": "本次搜索结果整体（本地知识库）", "url": "", "snippet": "本次补充搜索未检索到中航沈飞、中航西飞、航发动力的2025年营业收入及增速数据，搜索结果全部为中航成飞2025年年度报告摘要内容，无法完成军工整机同业增速的横向对比。", "date": "", "isSupplementary": true}, {"id": "fact_4c81c9ad", "title": "中航成飞（302132）2025年年度报告摘要披露了分季度营业收入：第一季度33.09亿元、第二季度173.93亿元、第三季度275.84亿元、第四季度270....", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞（302132）2025年年度报告摘要披露了分季度营业收入：第一季度33.09亿元、第二季度173.93亿元、第三季度275.84亿元、第四季度270.73亿元。据此计算，全年营业收入合计约753.59亿元，其中下半年（第三、四季度）合计约546.57亿元，占全年比重约72.53%，上半年占比约27.47%，收入呈现显著的下半年集中确认特征。", "date": "", "isSupplementary": true}, {"id": "fact_855890c7", "title": "中航成飞2025年分季度归母净利润：第一季度1.56亿元、第二季度7.56亿元、第三季度12.56亿元、第四季度12.63亿元；分季度扣非归母净利润分别为1.2...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞2025年分季度归母净利润：第一季度1.56亿元、第二季度7.56亿元、第三季度12.56亿元、第四季度12.63亿元；分季度扣非归母净利润分别为1.29亿元、7.25亿元、12.55亿元、11.95亿元，利润同样集中在下半年释放。", "date": "", "isSupplementary": true}, {"id": "fact_f61e3ac7", "title": "中航成飞2025年末总资产为1,145.48亿元，较2024年末调整后（1,079.06亿元）增长6.16%；2025年加权平均净资产收益率为26.76%，较2...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞2025年末总资产为1,145.48亿元，较2024年末调整后（1,079.06亿元）增长6.16%；2025年加权平均净资产收益率为26.76%，较2024年调整后的30.34%下降3.58个百分点。", "date": "", "isSupplementary": true}, {"id": "fact_0ae3561b", "title": "本次补充搜索未检索到中航沈飞、中航西飞2025年分季度营业收入数据；返回结果全部为中航成飞（302132）2025年年度报告摘要内容，无法据此对沈飞、西飞的下半...", "source": "搜索结果整体评估", "url": "", "snippet": "本次补充搜索未检索到中航沈飞、中航西飞2025年分季度营业收入数据；返回结果全部为中航成飞（302132）2025年年度报告摘要内容，无法据此对沈飞、西飞的下半年收入占比进行横向对比。", "date": "", "isSupplementary": true}, {"id": "fact_dd3d6e0d", "title": "中航成飞2025年年度报告摘要披露，报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；但搜索...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；但搜索结果未给出上述产品的分产品收入金额，也未给出在建工程具体数据。", "date": "", "isSupplementary": true}, {"id": "fact_4c2d245f", "title": "中航成飞2025年末总资产为114,547,703,019.42元，本年末比上年末（调整后107,905,965,442.13元）增减6.16%；加权平均净资产...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年末总资产为114,547,703,019.42元，本年末比上年末（调整后107,905,965,442.13元）增减6.16%；加权平均净资产收益率相关表格显示为26.76%（另有4.60%、30.34%、-3.58%、4.20%、30.33%等对比列，因表格截断无法完全确认对应口径）。", "date": "", "isSupplementary": true}, {"id": "fact_bab72d47", "title": "本次搜索结果（均为中航成飞2025年年度报告摘要片段）中未出现关于军品定价机制、目标价格管理、成本加成、军品价格管理办法、整机毛利率的任何直接表述或数据，无法据...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "本次搜索结果（均为中航成飞2025年年度报告摘要片段）中未出现关于军品定价机制、目标价格管理、成本加成、军品价格管理办法、整机毛利率的任何直接表述或数据，无法据此提取相关事实。", "date": "", "isSupplementary": true}, {"id": "fact_02b12c3e", "title": "中航成飞2025年营业收入为75,358,958,001.86元，2024年调整后为65,054,925,106.17元，本年比上年增长15.84%。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "中航成飞2025年营业收入为75,358,958,001.86元，2024年调整后为65,054,925,106.17元，本年比上年增长15.84%。", "date": "", "isSupplementary": true}, {"id": "fact_4db76558", "title": "分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度27,072,785,205.73元；收入高度集中于下半年，但报告未提供分季度毛利率数据。", "date": "", "isSupplementary": true}, {"id": "fact_31177a2c", "title": "报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；该产品结构信息可用于定性判断业务构成，但缺...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；该产品结构信息可用于定性判断业务构成，但缺少各产品线毛利率，无法量化产品结构变化对毛利率的影响。", "date": "", "isSupplementary": true}, {"id": "fact_e59cb366", "title": "本次检索到的年报摘要内容中未出现“毛利率”字样或任何毛利率数值，也未披露营业成本、分产品/分行业毛利构成，因此无法从现有材料中提取毛利率及同比变动数据。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（本地知识库）", "url": "", "snippet": "本次检索到的年报摘要内容中未出现“毛利率”字样或任何毛利率数值，也未披露营业成本、分产品/分行业毛利构成，因此无法从现有材料中提取毛利率及同比变动数据。", "date": "", "isSupplementary": true}]}}

