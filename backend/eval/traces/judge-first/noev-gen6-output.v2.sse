data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:38:27.267050", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Quarter': ['Q1', 'Q2', 'Q3', 'Q4'], 'Revenue': [3308640285.35/1e8, 17393488964.30/1e8, 27584043546.48/1e8, 27072785205.73/1e8]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['Revenue']\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2)\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 0.5, f'{v:.2f}亿', ha='center', fontsize=11, fontweight='bold')\nplt.title('竞争格局分析：2025年季度营业收入趋势', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('季度', fontsize=14)\nplt.ylabel('营业收入（亿元）', fontsize=14)\nplt.xticks(x, df['Quarter'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.text(0.02, 0.95, '控股股东：航空工业集团 78.66%', transform=plt.gca().transAxes, fontsize=12, verticalalignment='top', bbox=dict(boxstyle='round', facecolor='#eef2ff', alpha=0.8))\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局"}}

