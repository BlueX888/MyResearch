data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T19:34:32.833318", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "描述全球及中国六代机研发阶段、潜在装备需求、军工航空市场规模与增速，重点说明公开信息中成飞六代机项目进展及2027年产量信息的可得性。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 六代机 2027 产量 公开信息;中国第六代战斗机 研发进展 2027;全球六代机 市场 研发 计划"]}, {"id": "sec_2", "title": "竞争格局", "description": "描述成飞、沈飞等中国主机厂及国际六代机主要参与者的竞争协作格局，分析成飞在六代机项目中的可能定位、产能基础与项目分工。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 沈飞 六代机 分工 竞争;中国航空工业 主机厂 六代机 项目;成飞 产能 脉动生产线 军机"]}, {"id": "sec_3", "title": "技术趋势", "description": "描述六代机核心技术方向，包括隐身、变循环发动机、人工智能辅助、无人僚机协同、先进航电与定向能等，分析技术成熟度对2027年产量规划的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["六代机 核心技术 变循环发动机 人工智能 无人僚机;中国六代机 试飞 原型机 技术验证;成飞 六代机 技术 路线"]}, {"id": "sec_4", "title": "政策环境", "description": "描述国防预算、装备现代化政策、军工保密制度及“十四五”后续装备采购方向，分析政策对六代机研发节奏和产量公开披露的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 装备采购 2027 军工;十四五 装备现代化 六代机 政策;军工保密 六代机 公开信息 限制"]}, {"id": "sec_5", "title": "挑战机遇", "description": "描述成飞六代机项目面临的技术定型、发动机配套、产能爬坡、保密约束等挑战，以及航空工业升级、无人机协同作战需求带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 六代机 挑战 产能 技术定型;六代机 发动机 配套 风险;军工航空 产能 扩产 机遇"]}, {"id": "sec_6", "title": "未来展望", "description": "描述2027年前后中国六代机可能所处的研发/试飞/小批量阶段，分析成飞产量规划的可能区间判断方法，并强调需以官方公开信息为准。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中国六代机 2027 量产 时间表;成飞 六代机 计划 产量 官方;六代机 小批量 试飞 定型 展望"]}], "research_questions": ["成飞六代机项目截至目前的公开进展和官方披露信息有哪些？", "2027年成飞六代机计划产量是否有权威公开来源，若无应如何通过产能、预算和技术成熟度间接评估？", "影响成飞六代机2027年产量规划的关键因素包括哪些，技术、政策与保密约束如何影响研究结论？"]}}

