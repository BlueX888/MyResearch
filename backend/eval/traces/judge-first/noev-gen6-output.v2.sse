data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:42:05.365079", "content": {"results": [{"id": "fact_1e2235e2", "title": "控股股东中国航空工业集团有限公司为国有法人，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "控股股东中国航空工业集团有限公司为国有法人，持股比例78.66%，持股数量2,101,738,612股；汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%。", "date": "", "isSupplementary": false}, {"id": "fact_f8d90f7a", "title": "本次检索到的年度报告摘要未包含任何关于六代机项目、2027年产量计划、航空防务装备具体产能的数据，说明此类军品型号计划未在上市公司定期报告摘要中公开披露。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "本次检索到的年度报告摘要未包含任何关于六代机项目、2027年产量计划、航空防务装备具体产能的数据，说明此类军品型号计划未在上市公司定期报告摘要中公开披露。", "date": "", "isSupplementary": false}, {"id": "fact_dc03cc0a", "title": "中航成飞股份有限公司证券代码为302132，证券简称为中航成飞，公告编号为2026-009，文件为2025年年度报告摘要。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞股份有限公司证券代码为302132，证券简称为中航成飞，公告编号为2026-009，文件为2025年年度报告摘要。", "date": "", "isSupplementary": false}, {"id": "fact_6e39fc1e", "title": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_91de4d04", "title": "中国航空工业集团有限公司为中航成飞国有法人股东，持股比例为78.66%，持股数量为2,101,738,612.00股。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中国航空工业集团有限公司为中航成飞国有法人股东，持股比例为78.66%，持股数量为2,101,738,612.00股。", "date": "", "isSupplementary": false}, {"id": "fact_613bef23", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度公司财务报告出具了标准无保留意见的审计报告。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度公司财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": false}, {"id": "fact_cb423a29", "title": "本次搜索结果未提供成飞2027年六代机计划产量数据，也未提供2026年投资者关系活动记录表的具体内容。", "source": "本次搜索结果整体", "url": "", "snippet": "本次搜索结果未提供成飞2027年六代机计划产量数据，也未提供2026年投资者关系活动记录表的具体内容。", "date": "", "isSupplementary": false}, {"id": "fact_defd4ffc", "title": "检索到的唯一相关文档为《中航成飞股份有限公司2025年年度报告摘要》（公告编号：2026-009，证券代码302132，证券简称中航成飞），该摘要内容涵盖公司简...", "source": "中航成飞股份有限公司2025年年度报告摘要（本地知识库）", "url": "", "snippet": "检索到的唯一相关文档为《中航成飞股份有限公司2025年年度报告摘要》（公告编号：2026-009，证券代码302132，证券简称中航成飞），该摘要内容涵盖公司简介、主营业务、主要会计数据与财务指标、股东持股情况、利润分配预案等，全文未出现“六代机”“2027年产量”“计划产量”等任何相关表述。", "date": "", "isSupplementary": true}, {"id": "fact_c794b9bd", "title": "年报摘要披露的主营业务为“航空产品研发、制造、销售、维修与服务保障”，主要产品包括航空防务装备、民用航空产品和智能测控产品，但未披露任何具体机型（含六代机）的型...", "source": "中航成飞股份有限公司2025年年度报告摘要（本地知识库）", "url": "", "snippet": "年报摘要披露的主营业务为“航空产品研发、制造、销售、维修与服务保障”，主要产品包括航空防务装备、民用航空产品和智能测控产品，但未披露任何具体机型（含六代机）的型号名称、研制进度或产量计划。", "date": "", "isSupplementary": true}, {"id": "fact_eab9da0b", "title": "年报摘要显示控股股东中国航空工业集团有限公司持股78.66%（2,101,738,612股），汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持...", "source": "中航成飞股份有限公司2025年年度报告摘要（本地知识库）", "url": "", "snippet": "年报摘要显示控股股东中国航空工业集团有限公司持股78.66%（2,101,738,612股），汉中汉航机电有限公司持股5.75%，汉中航空工业（集团）有限公司持股5.29%；未涉及任何产能或产量规划信息。", "date": "", "isSupplementary": true}, {"id": "fact_03d7cf49", "title": "本次补充搜索未检索到任何媒体、研报或官方文件对“成飞2027年六代机产量XX架”这一说法的原始出处（发布机构、发布时间、原文表述），该说法在现有检索结果中缺乏可...", "source": "本次搜索结果整体（本地知识库）", "url": "", "snippet": "本次补充搜索未检索到任何媒体、研报或官方文件对“成飞2027年六代机产量XX架”这一说法的原始出处（发布机构、发布时间、原文表述），该说法在现有检索结果中缺乏可追溯来源。", "date": "", "isSupplementary": true}, {"id": "fact_7c821f7f", "title": "本次补充搜索返回的全部结果均来自本地知识库中的《中航成飞股份有限公司2025年年度报告摘要》（公告编号：2026-009），内容涉及公司经营、财务数据、股东结构...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "本次补充搜索返回的全部结果均来自本地知识库中的《中航成飞股份有限公司2025年年度报告摘要》（公告编号：2026-009），内容涉及公司经营、财务数据、股东结构等，未包含任何关于中国国防费预算、2025年装备费占比、财政部预算报告或十四五规划国防和军队现代化的信息。", "date": "", "isSupplementary": true}, {"id": "fact_0ce3f595", "title": "中航成飞2025年营业收入为75,358,958,001.86元（约753.59亿元），2024年调整后营业收入为65,054,925,10X.XX元；归属于上...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年营业收入为75,358,958,001.86元（约753.59亿元），2024年调整后营业收入为65,054,925,10X.XX元；归属于上市公司股东的净资产为21,208,525,338.75元。该数据为公司经营财务数据，并非国防费预算或装备费数据。", "date": "", "isSupplementary": true}, {"id": "fact_d9854817", "title": "中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；控股股东为中国航空工业集团有限公司，持股78....", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品；控股股东为中国航空工业集团有限公司，持股78.66%。该信息与成飞（航空防务装备研制单位）主体相关，但不涉及六代机产量或国防预算数据。", "date": "", "isSupplementary": true}, {"id": "fact_78da9050", "title": "中航成飞股份有限公司（证券代码302132）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "", "snippet": "中航成飞股份有限公司（证券代码302132）报告期内主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该表述未涉及任何具体机型（含六代机）的型号名称、研制进度或产量计划。", "date": "", "isSupplementary": true}, {"id": "fact_e931caca", "title": "本次补充搜索返回的全部结果均来自本地知识库中的《CF-2025-ANNUAL-SUMMARY.pdf》（中航成飞股份有限公司2025年年度报告摘要，证券代码30...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "本次补充搜索返回的全部结果均来自本地知识库中的《CF-2025-ANNUAL-SUMMARY.pdf》（中航成飞股份有限公司2025年年度报告摘要，证券代码302132，公告编号2026-009），内容涵盖公司重要提示、主营业务简介、近三年主要会计数据和财务指标、股本及股东情况、优先股股东情况、公司与实际控制人产权控制关系等，未出现任何关于'2027年建军一百年奋斗目标'、国防和军队现代化'三步走", "date": "", "isSupplementary": true}, {"id": "fact_a700c7c7", "title": "搜索结果中可确认的与'2027'时间点相关的政策信息为零：材料仅涉及中航成飞2025年度财务与治理披露（含2023—2025年会计数据、前10名股东持股、实际控...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "搜索结果中可确认的与'2027'时间点相关的政策信息为零：材料仅涉及中航成飞2025年度财务与治理披露（含2023—2025年会计数据、前10名股东持股、实际控制人为中国航空工业集团有限公司等），未涉及解放军国防和军队现代化'三步走'战略安排或2027年建军一百年奋斗目标这一政策坐标。", "date": "", "isSupplementary": true}, {"id": "fact_d9fc0acd", "title": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布《2025年年度报告摘要》（公告编号：2026-009），报告期内公司主营业务为航空产品研...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞股份有限公司（证券代码：302132，证券简称：中航成飞）发布《2025年年度报告摘要》（公告编号：2026-009），报告期内公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。该表述仅界定公司业务范围，未涉及'十五五'规划、2027年或六代机产量信息。", "date": "", "isSupplementary": true}, {"id": "fact_79e80a8f", "title": "中航成飞的实际控制人为中国航空工业集团有限公司（与持股5%以上股东的实际控制人相同），表明公司隶属航空工业集团体系，装备采购节奏受集团与国家规划安排约束；但该文...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞的实际控制人为中国航空工业集团有限公司（与持股5%以上股东的实际控制人相同），表明公司隶属航空工业集团体系，装备采购节奏受集团与国家规划安排约束；但该文件未披露任何规划周期或采购节奏的具体安排。", "date": "", "isSupplementary": true}, {"id": "fact_19950319", "title": "该年度报告摘要的披露时点为2026年（公告编号2026-009），即'十五五'规划期（2026—2030年）开局之年，可作为判断公司信息披露所处规划周期的时点参...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "该年度报告摘要的披露时点为2026年（公告编号2026-009），即'十五五'规划期（2026—2030年）开局之年，可作为判断公司信息披露所处规划周期的时点参照；但文件本身未出现'十五五''规划''2027年''六代机''产量'等表述。", "date": "", "isSupplementary": true}]}}

