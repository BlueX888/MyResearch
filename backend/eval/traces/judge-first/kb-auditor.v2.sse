data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:59:17.719634", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'口径': ['2024年末\\n(调整前)', '2024年末\\n(调整后)', '2025年末'], '总资产': [424.09, 1079.06, 1145.48]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['总资产'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='总资产（亿元）', zorder=3)\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 28, f'{v:.2f}', ha='center', fontsize=12, fontweight='bold', color='#312e81')\nplt.title('年报披露与审计概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('报告期口径', fontsize=14)\nplt.ylabel('总资产（亿元）', fontsize=14)\nplt.xticks(x, df['口径'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 1350)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.annotate('审计意见：标准无保留意见\\n审计机构：大信会计师事务所（特殊普通合伙）', xy=(0.02, 0.94), xycoords='axes fraction', fontsize=11, va='top', bbox=dict(boxstyle='round,pad=0.5', facecolor='#eef2ff', edgecolor='#6366f1', alpha=0.85))\nplt.legend(fontsize=12, loc='center right')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 年报披露与审计概况"}}

