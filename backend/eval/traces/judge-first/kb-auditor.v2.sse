data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:59:27.242229", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'阶段': ['2024年末（调整前）', '2024年末（调整后）', '2025年末'], '总资产': [424.09, 1079.06, 1145.48]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\ny = df['总资产'].values\nplt.plot(x, y, color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, markeredgecolor='#6366f1', label='总资产（亿元）')\nplt.fill_between(x, y, alpha=0.15, color='#6366f1')\nfor i, v in enumerate(y):\n    plt.text(i, v + 25, f'{v:.2f}', ha='center', fontsize=12, fontweight='bold', color='#1e293b')\nplt.xticks(x, df['阶段'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.xlabel('报告期', fontsize=14)\nplt.ylabel('总资产（亿元）', fontsize=14)\nplt.title('审计机构识别分析', fontsize=18, fontweight='bold', pad=20)\nplt.ylim(0, 1300)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.text(0.02, 0.95, '审计机构：大信会计师事务所（特殊普通合伙）', transform=plt.gca().transAxes, fontsize=12, verticalalignment='top', bbox=dict(boxstyle='round,pad=0.5', facecolor='#f1f5f9', edgecolor='#cbd5e1', alpha=0.9))\nplt.text(0.02, 0.87, '审计意见：标准无保留意见', transform=plt.gca().transAxes, fontsize=12, verticalalignment='top', bbox=dict(boxstyle='round,pad=0.5', facecolor='#f1f5f9', edgecolor='#cbd5e1', alpha=0.9))\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 审计机构识别"}}

