data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T19:58:37.954075", "content": {"results": [{"id": "fact_d0d0918a", "title": "中航成飞2025年年度报告摘要披露，公司因同一控制下企业合并对2024年财务数据进行了追溯调整。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf，本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，公司因同一控制下企业合并对2024年财务数据进行了追溯调整。", "date": "", "isSupplementary": false}, {"id": "fact_5c3e1c65", "title": "中航成飞2025年年度报告摘要披露的利润分配预案为：以总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税）。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf，本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要披露的利润分配预案为：以总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税）。", "date": "", "isSupplementary": false}, {"id": "fact_c477f537", "title": "中航成飞股份有限公司2025年年度报告摘要（公告编号：2026-009，证券代码：302132）披露，大信会计师事务所（特殊普通合伙）对公司2025年度财务报告...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞股份有限公司2025年年度报告摘要（公告编号：2026-009，证券代码：302132）披露，大信会计师事务所（特殊普通合伙）对公司2025年度财务报告的审计意见为：标准的无保留意见。", "date": "", "isSupplementary": false}, {"id": "fact_070d0475", "title": "中航成飞2025年年度报告摘要中“非标准审计意见提示”为“不适用”，未提示保留意见、强调事项段等非标准审计情形。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要中“非标准审计意见提示”为“不适用”，未提示保留意见、强调事项段等非标准审计情形。", "date": "", "isSupplementary": false}, {"id": "fact_7d58d452", "title": "中航成飞2025年年度报告摘要明确审计机构为大信会计师事务所（特殊普通合伙），可作为2025年年报审计机构名称的直接披露依据。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要明确审计机构为大信会计师事务所（特殊普通合伙），可作为2025年年报审计机构名称的直接披露依据。", "date": "", "isSupplementary": false}, {"id": "fact_70855a9e", "title": "中航成飞2025年年度报告摘要显示，所有董事均已出席了审议本报告的董事会会议。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，所有董事均已出席了审议本报告的董事会会议。", "date": "", "isSupplementary": false}, {"id": "fact_8f7675a0", "title": "中航成飞2025年年度报告摘要披露，公司总股本为267,209.14万股，利润分配预案为每10股派发现金红利3.86元（含税）。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞2025年年度报告摘要披露，公司总股本为267,209.14万股，利润分配预案为每10股派发现金红利3.86元（含税）。", "date": "", "isSupplementary": false}, {"id": "fact_0c32bbd4", "title": "中航成飞2025年末总资产为114,547,703,019.42元，较2024年末调整后增长6.16%。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞2025年末总资产为114,547,703,019.42元，较2024年末调整后增长6.16%。", "date": "", "isSupplementary": false}, {"id": "fact_e9cb6b45", "title": "中航成飞控股股东中国航空工业集团有限公司持股比例为78.66%，显示公司实际控制人为中国航空工业集团有限公司。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要，本地知识库）", "url": "", "snippet": "中航成飞控股股东中国航空工业集团有限公司持股比例为78.66%，显示公司实际控制人为中国航空工业集团有限公司。", "date": "", "isSupplementary": false}, {"id": "fact_f55eb8b1", "title": "中航成飞2025年年度报告摘要（公告编号：2026-009，证券代码：302132）披露：大信会计师事务所（特殊普通合伙）对公司2025年度财务报告的审计意见为...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要（公告编号：2026-009，证券代码：302132）披露：大信会计师事务所（特殊普通合伙）对公司2025年度财务报告的审计意见为标准的无保留意见。", "date": "", "isSupplementary": false}, {"id": "fact_5fa2d587", "title": "中航成飞2025年年度报告摘要中“非标准审计意见提示”勾选为“不适用”，即未提示保留意见、无法表示意见、否定意见或带强调事项段等非标准审计意见情形。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要中“非标准审计意见提示”勾选为“不适用”，即未提示保留意见、无法表示意见、否定意见或带强调事项段等非标准审计意见情形。", "date": "", "isSupplementary": false}, {"id": "fact_a1017202", "title": "中航成飞2025年度审计机构名称为“大信会计师事务所（特殊普通合伙）”，该信息来自2025年年度报告摘要的重要提示部分。", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年度审计机构名称为“大信会计师事务所（特殊普通合伙）”，该信息来自2025年年度报告摘要的重要提示部分。", "date": "", "isSupplementary": false}, {"id": "fact_a31facbb", "title": "中航成飞2025年年度报告摘要显示，公司因同一控制下企业合并对以前年度会计数据进行追溯调整，2025年末总资产为114,547,703,019.42元，2024...", "source": "CF-2025-ANNUAL-SUMMARY.pdf（中航成飞2025年年度报告摘要）", "url": "", "snippet": "中航成飞2025年年度报告摘要显示，公司因同一控制下企业合并对以前年度会计数据进行追溯调整，2025年末总资产为114,547,703,019.42元，2024年末调整后总资产为107,905,965,442.13元，本年末比上年末调整后增减6.16%。", "date": "", "isSupplementary": false}, {"id": "fact_08e41287", "title":