data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T19:59:12.428728", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {\n    'Category': ['2024调整前', '2024调整后', '2025'],\n    'Total_Assets': [424.09, 1079.06, 1145.48]\n}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Category':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nplt.figure(figsize=(12, 7), dpi=200)\ncolors = ['#94a3b8', '#06b6d4', '#6366f1']\nbars = plt.bar(df['Category'], df['Total_Assets'], color=colors, width=0.55)\nfor bar, val in zip(bars, df['Total_Assets']):\n    plt.text(bar.get_x() + bar.get_width()/2, val + 15, f'{val:.2f}亿元', ha='center', fontsize=13, fontweight='bold')\nplt.title('中航成飞总资产规模对比（2024-2025）', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('报告期', fontsize=14)\nplt.ylabel('总资产（亿元）', fontsize=14)\nplt.xticks(fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 1350)\nplt.grid(True, linestyle='--', alpha=0.3, axis='y')\nplt.text(0.5, 0.90, '审计机构：大信会计师事务所（特殊普通合伙）\\n审计意见：标准无保留意见', transform=plt.gca().transAxes, ha='center', fontsize=13, bbox=dict(boxstyle='round', facecolor='#f1f5f9', edgecolor='#6366f1'))\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "聚焦研究问题：中航成飞2025年年报审计机构与审计意见。选取关键数据点：审计机构（大信会计师事务所）、审计意见（标准无保留意见）、以及体现公司规模的总资产数据（2024调整前、2024调整后、2025）。通过柱状图对比总资产规模变化，并在图中标注审计机构与审计意见信息，直观回答研究问题。"}}

