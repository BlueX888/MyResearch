data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T21:26:09.361373", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "公开进展概况", "description": "梳理中国六代机预研的公开信息规模、时间线、信息来源与可信度，包括官方表述、航空工业/院所动态、学术论文、专利、招标与航展信号，区分概念研究、关键技术验证和原型机阶段。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中国六代机 预研 公开进展 时间线 官方 报道 专利 论文 招标"]}, {"id": "sec_2", "title": "竞争格局", "description": "对比中美欧日等六代机项目进展与中国航空工业参与主体，分析成飞、沈飞、西飞及院所分工、竞争合作关系和公开信号差异。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["六代机 中美 欧 日 竞争 格局 成飞 沈飞 六代机 项目"]}, {"id": "sec_3", "title": "技术趋势", "description": "识别六代机核心技术方向：全向/宽频隐身、变循环发动机、有人-无人协同、AI辅助决策、传感器融合、开放系统架构、定向能/高功率微波等，评估中国公开技术验证成熟度。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["六代机 关键技术 变循环发动机 无人协同 人工智能 隐身 传感器融合 公开 论文"]}, {"id": "sec_4", "title": "政策环境", "description": "分析国防预算、装备预研政策、军民融合、保密与出口管制、外部技术封锁等政策因素对六代机预研公开进展和信息披露的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["国防预算 装备预研 政策 军民融合 出口管制 技术封锁 六代机"]}, {"id": "sec_5", "title": "挑战机遇", "description": "评估主要不确定性：技术路线选择、发动机与材料瓶颈、系统集成、成本与进度、公开信息稀缺和外部制裁；同时识别后发集成、无人协同和新型研发组织等潜在机会。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["六代机 挑战 不确定性 技术瓶颈 发动机 材料 供应链 制裁 机会"]}, {"id": "sec_6", "title": "未来展望", "description": "构建时间线与情景分析，判断中国六代机预研可能的能力形成节点、公开披露节奏和关键不确定性指标，形成持续跟踪框架。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["六代机 未来 时间线 2030 2035 情景分析 能力形成 跟踪 指标"]}], "research_questions": ["中国六代机预研目前处于概念研究、关键技术验证还是原型机阶段的公开证据有哪些？", "六代机核心技术路线中哪些方向已有公开验证信号，哪些仍存在重大不确定性？", "国防政策、预算与外部技术封锁将如何影响中国六代机预研节奏和公开信息披露？"]}}

