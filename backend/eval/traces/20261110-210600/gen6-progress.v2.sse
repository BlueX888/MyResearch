data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T21:48:28.680507", "content": {"charts": [{"id": "chart_001", "title": "中国六代机关键里程碑时间轴", "subtitle": "已发生事件与预测节点（点大小表示置信度）", "type": "scatter", "echarts_option": {"grid": {"left": "15%", "right": "10%", "top": "15%", "bottom": "10%", "containLabel": true}, "legend": {"data": ["已确认/已发生", "中国预测", "美国对比"], "top": 0, "textStyle": {"color": "#666"}}, "xAxis": {"type": "time", "min": "2024-01-01", "max": "2031-01-01", "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666", "formatter": "{yyyy}"}, "splitLine": {"show": false}}, "yAxis": {"type": "category", "data": ["首次试飞", "沈飞论文", "F/A-XX承包商", "小批量生产", "美媒预测亮相", "量产部署", "替换完成"], "axisLine": {"show": false}, "axisTick": {"show": false}, "axisLabel": {"color": "#333", "fontSize": 12}}, "series": [{"name": "已确认/已发生", "type": "scatter", "symbolSize": 20, "itemStyle": {"color": "#1677ff"}, "data": [{"value": ["2024-12-26", 0], "symbolSize": 23, "name": "首次试飞"}, {"value": ["2025-08-01", 1], "symbolSize": 18, "name": "沈飞论文"}], "label": {"show": true, "position": "right", "formatter": "{b}", "color": "#666", "fontSize": 11}}, {"name": "中国预测", "type": "scatter", "symbolSize": 16, "itemStyle": {"color": "#fa8c16"}, "data": [{"value": ["2028-01-01", 3], "symbolSize": 16, "name": "小批量生产"}, {"value": ["2028-06-01", 4], "symbolSize": 15, "name": "美媒预测亮相"}, {"value": ["2030-01-01", 5], "symbolSize": 16, "name": "量产部署"}, {"value": ["2030-06-01", 6], "symbolSize": 14, "name": "替换完成"}], "label": {"show": true, "position": "right", "formatter": "{b}", "color": "#666", "fontSize": 11}}, {"name": "美国对比", "type": "scatter", "symbolSize": 18, "itemStyle": {"color": "#722ed1"}, "data": [{"value": ["2026-08-01", 2], "symbolSize": 18, "name": "F/A-XX承包商"}], "label": {"show": true, "position": "right", "formatter": "{b}", "color": "#666", "fontSize": 11}}]}}, {"id": "chart_002", "title": "关键数据点置信度水平", "subtitle": "反映公开信息的不确定性（百分比）", "type": "horizontal_b