data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:30:54.580475", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2024, 2025, 2026], 'Prototypes': [2, 3, 5]}\ndf = pd.DataFrame(data)\nfor col in df.columns:\n    if col != 'Year':\n        df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nax1 = axes[0]\nax1.bar(df['Year'], df['Prototypes'], color='#6366f1', width=0.5, alpha=0.85)\nfor x, y in zip(df['Year'], df['Prototypes']):\n    ax1.text(x, y + 0.1, str(y), ha='center', fontsize=12, fontweight='bold')\nax1.set_title('公开原型机/测试构型数量演进', fontsize=16, fontweight='bold', pad=15)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('数量（架）', fontsize=14)\nax1.set_xticks(df['Year'])\nax1.set_ylim(0, 6)\nax1.tick_params(labelsize=12)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine(ax=ax1)\nax2 = axes[1]\nnames = ['官方/可核验信源', '学术论文/专利', '自媒体/UGC']\nvals = [0, 0, 5]\nax2.barh(names, vals, color=['#10b981', '#06b6d4', '#f59e0b'], height=0.5)\nfor i, v in enumerate(vals):\n    ax2.text(v + 0.1, i, str(v), va='center', fontsize=12, fontweight='bold')\nax2.set_title('信源构成（自媒体可信度仅0.13）', fontsize=16, fontweight='bold', pad=15)\nax2.set_xlabel('条目数', fontsize=14)\nax2.set_xlim(0, 6)\nax2.tick_params(labelsize=12)\nax2.grid(True, linestyle='--', alpha=0.3)\nsns.despine(ax=ax2)\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从数据中提炼两条主线：(1) 公开进展——2024至2026年可观察原型机/测试构型数量由2架增至5架，配合2024-12-26首飞、2028小批量生产、2030量产部署等里程碑；(2) 主要不确定性——本次检索中可核验官方信源0条、直接相关学术文献0篇、自媒体条目5条且平均可信度仅0.13，官方确认状态为“未证实”。采用左右双子图：左侧柱状图呈现原型机数量演进，右侧横向条形图对比信源构成，直观揭示“进展可见但证据链薄弱”的核心结论。"}}

