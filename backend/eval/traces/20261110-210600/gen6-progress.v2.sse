data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:31:17.999657", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2024, 2026, 2028, 2030], 'Stage': [1, 2, 3, 4], 'Event': ['首飞/公开亮相', '原型机5架', '预测亮相/小批量生产', '量产部署']}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['Stage'], color='#6366f1', linewidth=2.5, marker='o', markersize=8)\nplt.fill_between(df['Year'], df['Stage'], 1, alpha=0.15, color='#6366f1')\nfor i, row in df.iterrows():\n    plt.text(row['Year'], row['Stage'] + 0.15, row['Event'], ha='center', fontsize=11, fontweight='bold')\nplt.title('公开进展概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('进展阶段', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks([1, 2, 3, 4], ['首飞', '原型机', '小批量', '量产'], fontsize=12)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 公开进展概况"}}

