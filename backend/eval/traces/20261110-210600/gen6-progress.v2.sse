data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:26:09.570518", "content": {"results": [{"id": "sr_726150", "title": "中国六代机将上舰?美媒称领先至少10年,这次不是吹捧是事实 - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/video/7536166280941650442/", "snippet": "展开中国六代机将上舰?美媒称领先至少10年,这次不是吹捧是事实播放\n14发布于\n2025-08-08\n18:54", "date": "2025-08-08T18:54:00+08:00", "isLocal": false}, {"id": "sr_1614a3", "title": "中国六代机研发步入正轨,美媒预测:或两种型号,最快2028年亮相", "source": "搜狐网", "url": "https://baobao.sohu.com/a/788382726_121434219", "snippet": "中国六代机研发步入正轨,美媒预测:或两种型号,最快2028年亮相 中国六代机研发步入正轨,美媒预测:或两种型号,最快2028年亮相", "date": "2024-06-25T18:22:00+08:00", "isLocal": false}, {"id": "sr_437ee9", "title": "中信科移动在6G关键技术预研方面的最新进展 -- 飞象网", "source": "www.cctime.com", "url": "http://www.cctime.com/html/2023-3-29/1647227.htm", "snippet": "中信科移动在6G关键技术预研方面的最新进展\n2023年3月29日\n09:59\nCCTIME飞象网\n编\n辑:章芳\n声明:刊载本文目的在于传播更多行业信息,本站只提供参考并不构成任何投资及应用建议。如网站内容涉及作品版权和其它问题,请在30日内与本网联系,我们将在第一时间删除内容。本站联系电话为86-010-87765777,邮件后缀为#cctime.com,冒充本站员工以任何其他联系方式,进行的“内容核实”、“商务联系”等行为,均不能代表本站。本站拥有对此声明的最终解释权。", "date": "2023-03-29T09:59:00+08:00", "isLocal": false}, {"id": "sr_d09dcb", "title": "中国六代机将上舰,美媒称领先美国至少十年!这次应该不... - 今日头条", "source": "今日头条", "url": "https://www.toutiao.com/video/7536158575589196342/", "snippet": "展开中国六代机将上舰,美媒称领先美国至少十年!这次应该不...播放\n47发布于\n2025-08-08\n18:24", "date": "2025-08-08T18:24:00+08:00", "isLocal": false}, {"id": "sr_442f31", "title": "中国六代机首次官方曝光!背后藏着什么战略深意?_网易视频", "source": "网易", "url": "https://m.163.com/v/video/VS2JE78ED.html", "snippet": "中国六代机首次官方曝光!背后藏着什么战略深意?\n中国六代机首次官方曝光!背后藏着什么战略深意?\n声明:个人原创,仅供参考\n打开网易新闻\n体验效果更佳", "date": "2026-08-04T22:40:41+08:00", "isLocal": false}], "isIncremental": true, "searchType": "web"}}

