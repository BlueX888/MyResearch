data: {"type": "knowledge_graph", "agent": "DataAnalyst", "timestamp": "2026-11-10T21:48:28.680151", "content": {"graph": {"nodes": [{"id": "cn_6gen", "name": "中国六代机", "type": "core", "importance": 10, "size": 50}, {"id": "six_gen_pre", "name": "六代机预研", "type": "core", "importance": 9, "size": 47}, {"id": "dual_line", "name": "双线推进战略", "type": "core", "importance": 9, "size": 47}, {"id": "internal_comp", "name": "内部竞争", "type": "core", "importance": 8, "size": 44}, {"id": "chengfei", "name": "成都飞机工业集团", "type": "company", "importance": 8, "size": 44}, {"id": "shenfei", "name": "沈阳飞机工业集团", "type": "company", "importance": 8, "size": 44}, {"id": "j36", "name": "歼-36", "type": "product", "importance": 7, "size": 41}, {"id": "j50", "name": "歼-50", "type": "product", "importance": 7, "size": 41}, {"id": "j20", "name": "歼-20", "type": "product", "importance": 5, "size": 35}, {"id": "tailless", "name": "无尾布局", "type": "tech", "importance": 7, "size": 41}, {"id": "vector_thrust", "name": "三发矢量推力", "type": "tech", "importance": 6, "size": 38}, {"id": "quantum_nav", "name": "量子导航", "type": "tech", "importance": 6, "size": 38}, {"id": "autonomous_flight", "name": "自主飞行", "type": "tech", "importance": 6, "size": 38}, {"id": "ngad", "name": "NGAD", "type": "product", "importance": 5, "size": 35}, {"id": "faxx", "name": "F/A-XX", "type": "product", "importance": 5, "size": 35}], "edges": [{"source": "six_gen_pre", "target": "cn_6gen", "relation": "涉及"}, {"source": "dual_line", "target": "cn_6gen", "relation": "推进"}, {"source": "internal_comp", "target": "cn_6gen", "relation": "体现"}, {"source": "chengfei", "target": "cn_6gen", "relation": "主导"}, {"source": "shenfei", "target": "cn_6gen", "relation": "参与"}, {"source": "j36", "target": "chengfei", "relation": "属于"}, {"source": "j50", "target": "shenfei", "relation": "属于"}, {"source": "j20", "target": "j36", "relation": "伴飞"}, {"source": "j36", "target": "j50", "relation": "高低搭配"}, {"source": "chengfei", "target": "shenfei", "relatio