data: {"type": "knowledge_graph", "agent": "DeepScout", "timestamp": "2026-11-10T21:26:34.128673", "content": {"graph": {"nodes": [{"id": "node_0", "name": "成都飞机工业有限责任公司（成飞）", "type": "company", "discovered_at": "2026-11-10T21:26:34.128535"}, {"id": "node_1", "name": "沈阳飞机工业集团（沈飞）", "type": "company", "discovered_at": "2026-11-10T21:26:34.128553"}, {"id": "node_2", "name": "歼-20", "type": "technology", "discovered_at": "2026-11-10T21:26:34.128558"}, {"id": "node_3", "name": "歼-36", "type": "technology", "discovered_at": "2026-11-10T21:26:34.128562"}, {"id": "node_4", "name": "歼-50", "type": "technology", "discovered_at": "2026-11-10T21:26:34.128567"}, {"id": "node_5", "name": "F/A-XX", "type": "technology", "discovered_at": "2026-11-10T21:26:34.128573"}, {"id": "node_6", "name": "美国《航空周刊》", "type": "company", "discovered_at": "2026-11-10T21:26:34.128578"}, {"id": "node_7", "name": "天津大学TICNN", "type": "company", "discovered_at": "2026-11-10T21:26:34.128594"}, {"id": "node_8", "name": "无尾布局/矢量推力", "type": "technology", "discovered_at": "2026-11-10T21:26:34.128598"}], "edges": [{"source": "成都飞机工业有限责任公司（成飞）", "relation": "被指主导六代机试飞", "discovered_at": "2026-11-10T21:26:34.128542"}, {"source": "成都飞机工业有限责任公司（成飞）", "relation": "歼-20研制方", "discovered_at": "2026-11-10T21:26:34.128549"}, {"source": "成都飞机工业有限责任公司（成飞）", "relation": "歼-36（外界称谓）", "discovered_at": "2026-11-10T21:26:34.128551"}, {"source": "沈阳飞机工业集团（沈飞）", "relation": "被指推进歼-50中型六代机", "discovered_at": "2026-11-10T21:26:34.128554"}, {"source": "沈阳飞机工业集团（沈飞）", "relation": "与成飞形成高低搭配", "discovered_at": "2026-11-10T21:26:34.128556"}, {"source": "歼-20", "relation": "被指为六代机首飞伴飞机型", "discovered_at": "2026-11-10T21:26:34.128560"}, {"source": "歼-36", "relation": "外界对成飞重型六代机的称谓", "discovered_at": "2026-11-10T21:26:34.128564"}, {"source": "歼-36", "relation": "三发无尾布局", "discovered_at": "2026-11-10T21:26:34.128565"}, {"source": "歼-50", "relation": "外界对沈飞中型六代机的称谓", "discovered_at": "2026-11-10T21:26:34.128570"}, {"source": "歼-50", "relation": "双发无尾布局", "discovered_at": "2026-11-10T21:26:34.128571"}, {"source": "F/A-XX", "relation": "美国海军六代舰载机项目", "discovered_at": "2026-11-10T21:26:34.128575"}, {"source": "F/A-XX", "relation": "选型公布延期", "discovered_at": "2026-11-10T21:26:34.128577"}, {"source": "美国《航空周刊》", "relation": "被引述报道F/A-XX延期", "discovered_at": "2026-11-10T21:26:34.128592"}, {"source": "天津大学TICNN", "relation": "刊载六代机首飞说法的高校研究机构网站", "discovered_at": "2026-11-10T21:26:34.128596"}, {"source": "无尾布局/矢量推力", "relation": "被指为六代机气动与飞控关键特征", "discovered_at": "2026-11-10T21:26:34.128599"}]}, "stats": {"entitiesCount": 9, "relationsCount": 15}, "isIncremental": true}}

data: {"type": "observation", "agent": "DeepScout", "timestamp": "2026-11-10T21:26:34.128862", "content": {"agent": "DeepScout", "section": "公开进展概况", "facts_count": 8, "duplicates_removed": 0, "data_points_count": 6, "insights": ["本次搜索结果的信息结构严重失衡：8条结果中6条为自媒体视频/转载（今日头条、网易视频、搜狐），0条官方来源、0条专利/招标/学术论文原文，无法满足本章节“区分概念研究、关键技术验证与原型机阶段”的证据要求。", "关于“2024年12月26日首飞”的说法在多个来源中重复出现（高校网站、腾讯新闻），具备一定交叉性，但所有来源均未提供官方通稿、试飞院公告或影像原始出处，属于“高传播度、低可验证度”信息，应标注为待核实。", "自媒体对中美差距的表述自相矛盾（“领先至少10年”vs“领先4年”），且均未给出美媒原文，说明该类数字不可用于研究结论。"], "source_quality": "整体来源质量低。8条结果中：0条官方来源，1条高校研究机构网站（TICNN，但内容为科普/纪录片式介绍，非同行评议研究，可信度约0.55），2条新闻门户（腾讯、飞象网，其中飞象网与主题无关），5条自媒体视频或转载（今日头条、网易视频、搜狐，可信度0.15-0.3）。主要问题包括：标题党与无正文内容、相互矛盾的关键数字（领先10年vs4年）、无原始信源引用、以及部分结果日期标注为2026年（晚于常规检索时点）导致时效性存疑。此外存在关键词污染（6G预研混入）。当前证据不足以支撑本章节对“公开信息规模、时间线、来源可信度、阶段划分”的严谨梳理，必须补充官方、专利、招标、学术与航展类一手信源。", "hypothesis_updates": 3, "search_results": [{"title": "中国六代机将上舰?美媒称领先至少10年,这次不是吹捧是事实 - 今日头条", "url": "https://www.toutiao.com/video/7536166280941650442/", "source": "今日头条", "snippet": "展开中国六代机将上舰?美媒称领先至少10年,这次不是吹捧是事实播放\n14发布于\n2025-08-08\n18:54", "date": "2025-08-08T18:54:00+08:00"}, {"title": "中国六代机研发步入正轨,美媒预测:或两种型号,最快2028年亮相", "url": "https://baobao.sohu.com/a/788382726_121434219", "source": "搜狐网", "snippet": "中国六代机研发步入正轨,美媒预测:或两种型号,最快2028年亮相 中国六代机研发步入正轨,美媒预测:或两种型号,最快2028年亮相", "date": "2024-06-25T18:22:00+08:00"}, {"title": "中信科移动在6G关键技术预研方面的最新进展 -- 飞象网", "url": "http://www.cctime.com/html/2023-3-29/1647227.htm", "source": "www.cctime.com", "snippet": "中信科移动在6G关键技术预研方面的最新进展\n2023年3月29日\n09:59\nCCTIME飞象网\n编\n辑:章芳\n声明:刊载本文目的在于传播更多行业信息,本站只提供参考并不构成任何投资及应用建议。如网站内容涉及作品版权和其它问题,请在30日内与本网联系,我们将在第一时间删除内容。本站联系电话为86-010-87765777,邮件后缀为#cctime.com,冒充本站员工以任何其他联系方式,进行的“内容核实”、“商务联系”等行为,均不能代表本站。本站拥有对此声明的最终解释权。", "date": "2023-03-29T09:59:00+08:00"}, {"title": "中国六代机将上舰,美媒称领先美国至少十年!这次应该不... - 今日头条", "url": "https://www.toutiao.com/video/7536158575589196342/", "source": "今日头条", "snippet": "展开中国六代机将上舰,美媒称领先美国至少十年!这次应该不...播放\n47发布于\n2025-08-08\n18:24", "date": "2025-08-08T18:24:00+08:00"}, {"title": "中国六代机首次官方曝光!背后藏着什么战略深意?_网易视频", "url": "https://m.163.com/v/video/VS2JE78ED.html", "source": "网易", "snippet": "中国六代机首次官方曝光!背后藏着什么战略深意?\n中国六代机首次官方曝光!背后藏着什么战略深意?\n声明:个人原创,仅供参考\n打开网易新闻\n体验效果更佳", "date": "2026-08-04T22:40:41+08:00"}, {"title": "中国六代机计划领先美国4年_网易视频", "url": "https://m.163.com/v/video/VSG66S1AP.html", "source": "网易", "snippet": "中国六代机计划领先美国4年\n中国六代机计划领先美国4年\n声明:个人原创,仅供参考\n打开网易新闻\n体验效果更佳", "date": "2025-12-19T02:39:33+08:00"}, {"title": "Documentary Film|六代机:引领空中作战新风向-TICNN(天津纳米颗粒与纳米系统国际研究中心)", "url": "https://ticnn.tju.edu.cn/info/1061/1717.htm", "source": "ticnn.tju.edu.cn", "snippet": "||2025年\n第8期||\n在2024年12月26日,中国成功进行了六代机的首次试飞,这标志着自六代机概念诞生以来,全球首次实质性的六代机试飞终于在中国实现。此次试飞由成都飞机工业有限责任公司主导,并得到了歼20的伴随飞行,彰显了中国在航空航天领域的卓越实力与领先地位。这一重大进展预示着中国即将引领全球空战技术的新篇章,开启新的军事革命。", "date": "2024-12-26T00:00:00+08:00"}, {"title": "中国六代机进展:双线并行,迭代速度空前_腾讯新闻", "url": "https://news.qq.com/rain/a/20260901A04Q2200", "source": "腾讯网", "snippet": "在全球空中力量迈向六代机时代之际,美国海军航母舰载战斗机的动作明显迟缓。美国《航空周刊》8月29日称,五角大楼此前多次宣称将在8月内公布美国海军第六代舰载战斗机F/A-XX的承包商和选型方案,然而眼看已经8月底,却始终没有消息。在全球第六代战斗机研发竞赛中,各国的进展呈现出显著的分化态势。结合当前(2026年9月)的最新公开信息,以下是中美及全球主要国家六代机项目的最新进展:一、\n中国六代机进展:双线并行,迭代速度空前中国目前在六代机研发上采取了罕见的“双线推进”战略,整体进度处于全球第一梯队,展现出极高的研发效率:成飞“歼-36”重型六代机:自2024年12月26日首架原型机公开亮相以来,研发节奏极快。截至2026年7月,外界已观察到至少5架外观存在明显差异的原型机或测试构型。近期,该机成功完成了高难度高迎角机动,证明了其无尾布局下卓越的飞控能力和三发矢量推力系统的成熟度。\n歼-50战斗机空中飞行图片沈飞“歼-50”中型六代机:同样于2024年12月26日曝光了相关视频。该机采用双发无尾布局,旨在与成飞的型号形成高低搭配,覆盖从前沿制空到纵深打击的不同作战需求。中国六代机正处于“爆发式推进”阶段,通过多构型并行试飞,大量风险在早期被提前发现。外界普遍预测,中国有望在2028年前后开始小批量生产,并在2030年左右实现量产部署。二、\n美国六代机进展:海空军进度不一美国的六代机项目分为空军和海军两条线,目前呈现出不同的状态:美国空军(F-47):进度相对明确。2025年3月,波音公司已正式获得第六代有人战斗机(F-47)的工程与制造开发(EMD)合同。其早期的X验证机在过去5年已累计飞行数百小时,接下来将继续制造少量试验机进行验证。美国海军(F/A-XX):根据有关报道,目前该项目仍被认为处于概念及早期风险降低阶段,尚未出现完整的原型机轮廓。三、\n其他各国六代机情况:跨国合作", "date": "2026-09-01T12:20:00+08:00"}], "extracted_facts": [{"content": "天津大学TICNN中心网站刊文称，2024年12月26日中国成功进行六代机首次试飞，由成都飞机工业有限责任公司主导，并有歼-20伴随飞行，称其为全球首次实质性六代机试飞。", "source_name": "天津大学TICNN（天津纳米颗粒与纳米系统国际研究中心）", "source_url": "https://ticnn.tju.edu.cn/info/1061/1717.htm", "credibility": 0.55}, {"content": "腾讯新闻文章称，中国六代机采取“双线推进”战略：成飞“歼-36”重型六代机自2024年12月26日首架原型机公开亮相，截至2026年7月外界已观察到至少5架外观存在明显差异的原型机或测试构型，并完成高迎角机动试飞，验证无尾布局飞控与三发矢量推力；沈飞“歼-50”中型六代机同日曝光，采用双发无尾布局，与成飞型号形成高低搭配。", "source_name": "腾讯新闻", "source_url": "https://news.qq.com/rain/a/20260901A04Q2200", "credibility": 0.45}, {"content": "腾讯新闻文章援引外界普遍预测：中国六代机有望在2028年前后开始小批量生产，2030年左右实现量产部署；同时提及美国海军F/A-XX六代舰载机选型延期，原定2026年8月公布承包商却未如期公布。", "source_name": "腾讯新闻（引述美国《航空周刊》8月29日报道）", "source_url": "https://news.qq.com/rain/a/20260901A04Q2200", "credibility": 0.5}, {"content": "搜狐网转载文章称，美媒预测中国六代机研发步入正轨，可能有两种型号，最快2028年亮相。", "source_name": "搜狐网", "source_url": "https://baobao.sohu.com/a/788382726_121434219", "credibility": 0.3}, {"content": "今日头条视频标题称“中国六代机将上舰，美媒称领先至少10年”，但正文无实质信息，仅标题式表述，未给出美媒名称、原文或数据。", "source_name": "今日头条", "source_url": "https://www.toutiao.com/video/7536166280941650442/", "credibility": 0.15}, {"content": "网易视频标题称“中国六代机首次官方曝光”，但页面标注“个人原创，仅供参考”，未提供官方发布渠道、时间或原文链接，无法确认“官方曝光”属性。", "source_name": "网易视频", "source_url": "https://m.163.com/v/video/VS2JE78ED.html", "credibility": 0.15}, {"content": "网易视频标题称“中国六代机计划领先美国4年”，与另一来源“领先至少10年”的说法相互矛盾，且均无原始出处，显示自媒体对时间差的表述高度不一致。", "source_name": "网易视频", "source_url": "https://m.163.com/v/video/VSG66S1AP.html", "credibility": 0.15}, {"content": "搜索结果[3]为“中信科移动6G关键技术预研进展”，属于6G通信技术预研，与六代机（航空装备）无关，属于关键词“预研”造成的检索噪音。", "source_name": "飞象网", "source_url": "http://www.cctime.com/html/2023-3-29/1647227.htm", "credibility": 0.5}], "data_points": [{"name": "六代机首次试飞日期", "value": "2024-12-26", "unit": "日期", "year": 2024, "source": "天津大学TICNN（天津纳米颗粒与纳米系统国际研究中心）"}, {"name": "已观察原型机/测试构型数量", "value": "5", "unit": "架", "year": 2026, "source": "腾讯新闻"}, {"name": "首架原型机公开亮相时间", "value": "2024-12-26", "unit": "日期", "year": 2024, "source": "腾讯新闻"}, {"name": "预测小批量生产时间", "value": "2028前后", "unit": "年", "year": 2028, "source": "腾讯新闻（引述美国《航空周刊》8月29日报道）"}, {"name": "预测量产部署时间", "value": "2030左右", "unit": "年", "year": 2030, "source": "腾讯新闻（引述美国《航空周刊》8月29日报道）"}, {"name": "预测亮相时间", "value": "2028", "unit": "年", "year": 2024, "source": "搜狐网"}]}}

