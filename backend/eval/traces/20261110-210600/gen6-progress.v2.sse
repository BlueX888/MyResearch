data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:31:51.342498", "content": {"results": [{"id": "fact_3c6a10ba", "title": "网易视频称“歼-36首飞消息封锁不住，上美国防务热榜，美网民喊话五角大楼”，属二次转述境外社交媒体与媒体热度，未提供原始报道链接、报道机构名称或美国国防部任何表...", "source": "网易视频（自媒体账号）", "url": "", "snippet": "网易视频称“歼-36首飞消息封锁不住，上美国防务热榜，美网民喊话五角大楼”，属二次转述境外社交媒体与媒体热度，未提供原始报道链接、报道机构名称或美国国防部任何表态原文，无法验证。", "date": "", "isSupplementary": false}, {"id": "fact_c2c33e06", "title": "搜狐转载内容标注“来源：央视军事”，称歼-35A完成首秀、试飞成功。歼-35A为已公开亮相的第五代（中型隐身）战机，与“第六代机”属不同代际，不能作为六代机进展...", "source": "搜狐（转载，标注来源央视军事）", "url": "", "snippet": "搜狐转载内容标注“来源：央视军事”，称歼-35A完成首秀、试飞成功。歼-35A为已公开亮相的第五代（中型隐身）战机，与“第六代机”属不同代际，不能作为六代机进展的证据；但该条显示央视军事确为新型号战机的官方发布渠道之一。", "date": "", "isSupplementary": false}, {"id": "fact_0e6db236", "title": "网易视频称“央视放出新年歼-35首飞视频，歼-35全面铺开”，但页面同时标注“取材网络、谨慎鉴别”，属对央视素材的二次剪辑转述，非原始发布页，具体播出栏目与日期...", "source": "网易视频（自媒体账号）", "url": "", "snippet": "网易视频称“央视放出新年歼-35首飞视频，歼-35全面铺开”，但页面同时标注“取材网络、谨慎鉴别”，属对央视素材的二次剪辑转述，非原始发布页，具体播出栏目与日期不可考。", "date": "", "isSupplementary": false}, {"id": "fact_7481872d", "title": "网易视频称“中国歼-36与歼-50加速研发”，同样标注“个人原创，仅供参考”。“歼-36”“歼-50”均为网络与境外媒体使用的非官方编号，中国官方从未确认过上述...", "source": "网易视频（自媒体账号）", "url": "", "snippet": "网易视频称“中国歼-36与歼-50加速研发”，同样标注“个人原创，仅供参考”。“歼-36”“歼-50”均为网络与境外媒体使用的非官方编号，中国官方从未确认过上述型号名称，也未确认存在两个并行六代机项目。", "date": "", "isSupplementary": false}, {"id": "fact_d9d1c26b", "title": "本次搜索结果中未出现任何国防部例行记者会实录、央视军事原发报道、中国航空工业集团公告或官方通稿，对“六代机首飞”作出确认或否认；即“国防部/央视军事回应”这一检...", "source": "本次检索结果整体（负面发现）", "url": "", "snippet": "本次搜索结果中未出现任何国防部例行记者会实录、央视军事原发报道、中国航空工业集团公告或官方通稿，对“六代机首飞”作出确认或否认；即“国防部/央视军事回应”这一检索目标在本次结果中零命中。", "date": "", "isSupplementary": false}, {"id": "fact_3baddd12", "title": "网易订阅文章称，央视军事近日发布题为《......+10+16+20+35+未完持续!》的文章，并将“10、16、20、35”推断为已亮相的解放军战斗机型号，将...", "source": "网易订阅", "url": "", "snippet": "网易订阅文章称，央视军事近日发布题为《......+10+16+20+35+未完持续!》的文章，并将“10、16、20、35”推断为已亮相的解放军战斗机型号，将“未完待续”解读为可能暗示第六代战斗机；文章未给出国防部、空军或航空工业集团的直接确认。", "date": "", "isSupplementary": false}, {"id": "fact_15dbde30", "title": "爱奇艺视频（2017-10-03）标题称“歼20总师证实：中国已研制第六代战斗机”，但简介仅表述按“装备一代、研发一代、预研一代”习惯已开始第六代战机研发工作，...", "source": "爱奇艺", "url": "", "snippet": "爱奇艺视频（2017-10-03）标题称“歼20总师证实：中国已研制第六代战斗机”，但简介仅表述按“装备一代、研发一代、预研一代”习惯已开始第六代战机研发工作，未附总师讲话原文或官方发布链接。", "date": "", "isSupplementary": false}, {"id": "fact_bd9e4044", "title": "爱奇艺视频（2018-03-26）称中国第六代战斗机将在2030年左右部署，目前正在开发激光和人工智能等技术储备，并可能先以升级方式安装在歼-20上；该表述来自...", "source": "爱奇艺", "url": "", "snippet": "爱奇艺视频（2018-03-26）称中国第六代战斗机将在2030年左右部署，目前正在开发激光和人工智能等技术储备，并可能先以升级方式安装在歼-20上；该表述来自视频简介/评论，非官方文件。", "date": "", "isSupplementary": false}, {"id": "fact_285da34f", "title": "网易订阅文章称，网上流传四川成都疑似第六代战斗机试飞视频和照片，旁边伴飞歼-20；文章同时称官方尚未证实。", "source": "网易订阅", "url": "", "snippet": "网易订阅文章称，网上流传四川成都疑似第六代战斗机试飞视频和照片，旁边伴飞歼-20；文章同时称官方尚未证实。", "date": "", "isSupplementary": false}, {"id": "fact_4039ffe6", "title": "网易订阅文章引述俄罗斯军事专家瓦西里·卡申（高等经济学院欧洲与国际综合研究中心主任）称，中国实际上很可能已经试飞了六代战斗机原型机；文章未提供采访原文链接，且强...", "source": "网易订阅", "url": "", "snippet": "网易订阅文章引述俄罗斯军事专家瓦西里·卡申（高等经济学院欧洲与国际综合研究中心主任）称，中国实际上很可能已经试飞了六代战斗机原型机；文章未提供采访原文链接，且强调官方未证实。", "date": "", "isSupplementary": false}, {"id": "fact_fd588c0d", "title": "新浪看点图集称，中国武器装备发展传统为“装备一代、研制一代、预研一代”，在三代机大量装备、四代机部分入役情况下，进行下一代飞机预研非常有必要；并称中国第六代战机...", "source": "新浪看点", "url": "", "snippet": "新浪看点图集称，中国武器装备发展传统为“装备一代、研制一代、预研一代”，在三代机大量装备、四代机部分入役情况下，进行下一代飞机预研非常有必要；并称中国第六代战机处于高度保密研发状态。", "date": "", "isSupplementary": false}, {"id": "fact_f919cb17", "title": "网易订阅文章称，歼-20于2018年2月正式入列中国空军，2016年珠海航展亮相，2011年初首次试飞。", "source": "网易订阅", "url": "", "snippet": "网易订阅文章称，歼-20于2018年2月正式入列中国空军，2016年珠海航展亮相，2011年初首次试飞。", "date": "", "isSupplementary": false}, {"id": "fact_21ad427b", "title": "网易订阅文章评论称，六代机研发投入巨大，将提升多任务能力、战略深度，并帮助摆脱外部技术依赖、刺激国防工业；未来无人机、电子战、网络战普遍，六代机需快速适应。该内...", "source": "网易订阅", "url": "", "snippet": "网易订阅文章评论称，六代机研发投入巨大，将提升多任务能力、战略深度，并帮助摆脱外部技术依赖、刺激国防工业；未来无人机、电子战、网络战普遍，六代机需快速适应。该内容为评论性推断，非官方数据。", "date": "", "isSupplementary": false}, {"id": "fact_f9e7beba", "title": "今日头条文章标题称“中国第六代战机项目被证实 装备一代研发一代预研一代”，但正文主要为视频加载和评论，未提供可核验的官方发布或项目细节。", "source": "今日头条", "url": "", "snippet": "今日头条文章标题称“中国第六代战机项目被证实 装备一代研发一代预研一代”，但正文主要为视频加载和评论，未提供可核验的官方发布或项目细节。", "date": "", "isSupplementary": false}, {"id": "fact_b76e5667", "title": "网易视频标题声称成飞、沈飞、西飞都高调曝光了新机型，但页面内容仅显示网友评论，未提供官方报道、试飞时间、型号或技术参数。", "source": "网易视频", "url": "", "snippet": "网易视频标题声称成飞、沈飞、西飞都高调曝光了新机型，但页面内容仅显示网友评论，未提供官方报道、试飞时间、型号或技术参数。", "date": "", "isSupplementary": false}, {"id": "fact_0f6909f0", "title": "网易视频标题声称成飞飞完沈飞飞，外网看我国试飞两款新型战机，疑是六代机；页面内容未提供可验证的官方来源或具体试飞信息。", "source": "网易视频", "url": "", "snippet": "网易视频标题声称成飞飞完沈飞飞，外网看我国试飞两款新型战机，疑是六代机；页面内容未提供可验证的官方来源或具体试飞信息。", "date": "", "isSupplementary": false}, {"id": "fact_27aa58cf", "title": "新浪图集标题称“航空工业沈飞发布年终攻坚图集 某新型战机亮相”，表明存在对航空工业沈飞官方图集的二手转载，但搜索结果未给出官方原文链接、图集日期和机型信息。", "source": "新浪网", "url": "", "snippet": "新浪图集标题称“航空工业沈飞发布年终攻坚图集 某新型战机亮相”，表明存在对航空工业沈飞官方图集的二手转载，但搜索结果未给出官方原文链接、图集日期和机型信息。", "date": "", "isSupplementary": false}, {"id": "fact_f19f62eb", "title": "东方财富网股吧帖子称“网上传闻近期成飞可能试飞新机型，可能和六代机有关”，并讨论股价影响；该内容明确属于网络传闻和投资讨论，未提供官方证据。", "source": "东方财富网股吧", "url": "", "snippet": "东方财富网股吧帖子称“网上传闻近期成飞可能试飞新机型，可能和六代机有关”，并讨论股价影响；该内容明确属于网络传闻和投资讨论，未提供官方证据。", "date": "", "isSupplementary": false}, {"id": "fact_c468d34a", "title": "今日头条文章称沈飞和成飞两款新型战机同时试飞，并描述沈飞新战机采用传统气动外形并融入可变翼技术、成飞新战机采用三角翼加无尾布局；该文为自媒体叙述，未引用官方来源...", "source": "今日头条", "url": "", "snippet": "今日头条文章称沈飞和成飞两款新型战机同时试飞，并描述沈飞新战机采用传统气动外形并融入可变翼技术、成飞新战机采用三角翼加无尾布局；该文为自媒体叙述，未引用官方来源或可验证技术资料。", "date": "", "isSupplementary": false}, {"id": "fact_b7b8b241", "title": "网易视频标题称“疑似成飞研制的新型战机最新试飞影像”，并标注“个人原创，仅供参考”；该内容未提供官方确认、拍摄时间、地点或机型编号。", "source": "网易视频", "url": "", "snippet": "网易视频标题称“疑似成飞研制的新型战机最新试飞影像”，并标注“个人原创，仅供参考”；该内容未提供官方确认、拍摄时间、地点或机型编号。", "date": "", "isSupplementary": false}]}}

