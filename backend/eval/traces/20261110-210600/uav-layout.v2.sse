data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T21:26:11.528169", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "市场概况", "description": "梳理中国军用无人机和外贸无人机市场规模、增速、主要需求方向及出口格局，重点分析察打一体、隐身作战和协同作战无人机的市场空间。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中国军用无人机市场规模 增速 外贸出口 察打一体 无人机 市场"]}, {"id": "sec_2", "title": "竞争格局", "description": "对比成飞与沈飞在无人机领域的产品谱系、市场定位、客户结构、订单情况和产业化平台，分析两家企业在国内和国际市场的竞争关系。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 沈飞 无人机 布局 翼龙 暗剑 利剑 攻击-11 竞争格局"]}, {"id": "sec_3", "title": "技术趋势", "description": "分析成飞和沈飞在无人机平台设计、隐身飞翼、察打一体、有人/无人协同、飞控与任务系统等方面的技术路线差异及关键技术趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 无人机 技术路线 翼龙 沈飞 隐身无人机 忠诚僚机 有人无人协同"]}, {"id": "sec_4", "title": "政策环境", "description": "梳理航空工业集团专业化整合、军贸出口管理、无人装备发展规划和低空经济政策对成飞、沈飞无人机布局的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["航空工业集团 无人机 专业化整合 军贸出口 政策 低空经济 无人作战装备"]}, {"id": "sec_5", "title": "挑战机遇", "description": "分析成飞和沈飞在无人机领域面临的国际竞争、出口限制、技术迭代、产能与成本挑战，以及隐身化、协同化和体系化作战带来的机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 无人机 挑战 机遇 出口限制 技术迭代 产能 成本"]}, {"id": "sec_6", "title": "未来展望", "description": "研判成飞和沈飞无人机布局的演进方向，包括产品系列化、高端隐身化、有人/无人协同、外贸市场拓展和集团内分工调整趋势。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 无人机 未来 发展趋势 隐身化 协同作战 外贸 体系化"]}], "research_questions": ["成飞和沈飞在无人机领域的产品谱系与市场定位有何差异？", "两家企业在无人机技术路线和研发体系上有何不同？", "政策、军贸出口和集团战略如何塑造成飞与沈飞无人机布局的竞争格局？"]}}

