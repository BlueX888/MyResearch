data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:31:30.463866", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [1961, 2006, 2009, 2012, 2013, 2017, 2018], 'Events': [1, 1, 1, 1, 1, 3, 1]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nplt.plot(df['Year'], df['Events'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, markerfacecolor='white', markeredgewidth=2.5, markeredgecolor='#6366f1', label='关键事件数量')\nplt.fill_between(df['Year'], df['Events'], alpha=0.15, color='#6366f1')\nfor x, y in zip(df['Year'], df['Events']):\n    plt.text(x, y + 0.08, str(y), ha='center', va='bottom', fontsize=11, fontweight='bold', color='#4338ca')\nplt.title('市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('关键事件数量', fontsize=14)\nplt.xticks(df['Year'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, max(df['Events']) + 0.8)\nplt.grid(True, linestyle='--', alpha=0.3)\nplt.legend(fontsize=12, loc='upper left')\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 市场概况"}}

