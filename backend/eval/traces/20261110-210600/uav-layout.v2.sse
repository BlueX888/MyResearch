data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:27:09.205998", "content": {"results": [{"id": "sr_1a9704", "title": "6. International arms transfers  SIPRI", "source": "www.sipri.org", "url": "https://www.sipri.org/yearbook/2024/06", "snippet": "Contents Overview, Siemon T. Wezeman I. Global trends in arms transfers, 2019–23, Siemon T. Wezeman, Katarina Djokic, Mathew George, Zain Hussain and Pieter D. Wezeman II. Developments among the suppliers of major arms, 2019–23, Siemon T. Wezeman, Katarina Djokic, Mathew George, Zain Hussain and Pieter D. Wezeman III. Developments among the recipients of major arms, 2019–23, Siemon T. Wezeman, Katarina Djokic, Mathew George, Zain Hussain and Pieter D. Wezeman Click here Click here", "date": "2019-12-11T00:00:00+08:00"}, {"id": "sr_f20557", "title": "Newsletter: SIPRI Update", "source": "www.sipri.org", "url": "http://www.sipri.org/media/newsletter", "snippet": "SIPRI Update: Global Security and Arms Control  is a monthly newsletter covering SIPRI’s latest work in international security, arms control, non-proliferation and conflict. Each issue of the newsletter contains commentary pieces by SIPRI researchers, details of recent and upcoming events, staff news, and information about the latest SIPRI publications.\nSubscribe  to receive the  SIPRI Update  in your inbox each month.\nNewsletter editions in 2025\nMarch 2025:  New data on international arms transfers, self-reliance in arms procurement, nuclear materials trafficking and more\nFebruary 2025:  Ukraine’s arms industry, trade in cyber surveillance tools, debate on autonomous weapons and more\nJanuary 2025:  Artificial intelligence, emerging security threats, conventional–nuclear boundaries and mor", "date": "2019-01-01T08:00:00+08:00"}, {"id": "sr_108313", "title": "Unlocking nuclear arms control in the time of the coronavirus disease 2019 (COVI", "source": "www.sipri.org", "url": "https://www.sipri.org/events/2020/SSC20-unlocking-nuclear-arms-control-coronavirus", "snippet": "The independent resource on global security SHARE SECTIONS", "date": "2019-01-01T00:00:00+08:00"}, {"id": "sr_29ee58", "title": "Global military expenditure sees largest annual increase in a decade—says SIPRI—", "source": "www.sipri.org", "url": "https://www.sipri.org/media/press-release/2020/global-military-expenditure-sees-largest-annual-increase-decade-says-sipri-reaching-1917-billion", "snippet": "Press release - Catalan Press release - French Press release - Russian Press release - Spanish Press release - Swedish SIPRI Fact Sheet: Trends in World Military Expenditure, 2019 (PDF) Related content", "date": "2020-04-27T05:48:37+08:00"}, {"id": "sr_a45a62", "title": "Artificial intelligence, strategic stability and nuclear risk: Euro-Atlantic per", "source": "www.sipri.org", "url": "https://www.sipri.org/news/2019/artificial-intelligence-strategic-stability-and-nuclear-risk-euro-atlantic-perspectives-new-sipri", "snippet": "Related content Integrating Cybersecurity and Critical Infrastructure: National, Regional and International Approaches Arms and Artificial Intelligence: Weapons and Arms Control Applications of Advanced Computing SIPRI co-hosts workshop in Sri Lanka on impact of emerging technologies on nuclear risk SIPRI co-hosts workshop in Beijing on the impact of emerging technologies on nuclear risk SIPRI film series on the security risks of newly emerged technologies Bio Plus X: Arms Control and the Convergence of Biology and Emerging Technologies SHARE Related Integrating Cybersecurity and Critical Infrastructure: National, Regional and International Approaches March 2018 Arms and Artificial Intelligence: Weapons and Arms Control Applications of Advanced Computing 1987 SIPRI co-hosts workshop in Bei", "date": "2019-03-04T13:59:03+08:00"}], "isIncremental": true, "searchType": "信源追溯", "depth": 2}}

