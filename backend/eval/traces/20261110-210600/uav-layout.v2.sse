data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T22:31:24.221828", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Model': ['翼龙-2(成飞)', '攻击-11(沈飞)'], 'MTOW': [4.2, 10.0], 'Speed100': [3.7, 10.0]}\ndf = pd.DataFrame(data)\nfor col in ['MTOW', 'Speed100']:\n    df[col] = pd.to_numeric(df[col], errors='coerce')\ndf = df.dropna()\nrev = {'Year': [2022, 2023, 2024], 'Revenue': [27.73, 26.64, 6.85]}\ndr = pd.DataFrame(rev)\ndr['Revenue'] = pd.to_numeric(dr['Revenue'], errors='coerce')\nfig, axes = plt.subplots(1, 2, figsize=(12, 7), dpi=200)\nx = np.arange(len(df['Model']))\nw = 0.35\naxes[0].bar(x - w/2, df['MTOW'], w, label='最大起飞重量(吨)', color='#6366f1')\naxes[0].bar(x + w/2, df['Speed100'], w, label='最大速度(百km/h)', color='#06b6d4')\naxes[0].set_xticks(x)\naxes[0].set_xticklabels(df['Model'], fontsize=12)\naxes[0].set_title('代表机型性能对比', fontsize=16, fontweight='bold')\naxes[0].legend(fontsize=11)\naxes[0].grid(True, linestyle='--', alpha=0.3)\nfor i, v in enumerate(df['MTOW']):\n    axes[0].text(i - w/2, v + 0.2, str(v), ha='center', fontsize=10)\nfor i, v in enumerate(df['Speed100']):\n    axes[0].text(i + w/2, v + 0.2, str(v), ha='center', fontsize=10)\naxes[1].plot(dr['Year'], dr['Revenue'], linewidth=2.5, marker='o', markersize=8, color='#10b981')\naxes[1].fill_between(dr['Year'], dr['Revenue'], alpha=0.15, color='#10b981')\naxes[1].set_title('中无人机(成飞系)营收趋势', fontsize=16, fontweight='bold')\naxes[1].set_xlabel('年份', fontsize=14)\naxes[1].set_ylabel('营业收入(亿元)', fontsize=14)\naxes[1].grid(True, linestyle='--', alpha=0.3)\nfor i, v in enumerate(dr['Revenue']):\n    axes[1].text(dr['Year'][i], v + 0.8, str(v), ha='center', fontsize=10)\nplt.tight_layout()\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "从数据中提炼成飞（翼龙/云影/暗剑，中无人机平台）与沈飞（利剑/攻击-11隐身攻击机）两条技术路线的核心差异：1) 代表机型性能对比（最大起飞重量、最大速度），体现成飞走中空长航时察打一体、沈飞走高隐身高速突防；2) 以中无人机营收趋势反映成飞系无人机产业化/商业化程度。用左右双子图呈现，左为分组柱状图，右为带面积填充的折线图。"}}

