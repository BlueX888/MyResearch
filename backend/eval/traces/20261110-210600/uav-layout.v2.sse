data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-10T21:32:44.090886", "content": {"results": [{"id": "fact_0a6b3f62", "title": "分析材料预计2024年全球民用无人机市场规模将增长至4,157.27亿元人民币，其中工业无人机占据重要部分。", "source": "2024年中无人机分析报告：无人机领军企业，持续拓展国内市场（道客巴巴）", "url": "", "snippet": "分析材料预计2024年全球民用无人机市场规模将增长至4,157.27亿元人民币，其中工业无人机占据重要部分。", "date": "", "isSupplementary": false}, {"id": "fact_b5b3e870", "title": "中航沈飞2024年年报显示，国内营业收入为42,590,654,078.55元，营业成本为37,264,181,317.21元，毛利为5,326,472,761...", "source": "前瞻眼上市企业库", "url": "", "snippet": "中航沈飞2024年年报显示，国内营业收入为42,590,654,078.55元，营业成本为37,264,181,317.21元，毛利为5,326,472,761.34元，毛利率为12.51%，收入构成中国内占比100%。", "date": "", "isSupplementary": false}, {"id": "fact_f3093e3a", "title": "中航沈飞2025年中报显示，国内营业收入为14,628,337,068.60元，营业成本为12,835,954,116.83元，毛利为1,792,382,951...", "source": "前瞻眼上市企业库", "url": "", "snippet": "中航沈飞2025年中报显示，国内营业收入为14,628,337,068.60元，营业成本为12,835,954,116.83元，毛利为1,792,382,951.77元，毛利率为12.25%，收入构成中国内占比100%。", "date": "", "isSupplementary": false}, {"id": "fact_2f861022", "title": "中航沈飞2021年航空业务营业收入为336.85亿元，占总营业收入的98.82%；2018年以来航空产品营业收入占比均保持在98%以上，主要营收来源为歼击机产品...", "source": "悟空智库", "url": "", "snippet": "中航沈飞2021年航空业务营业收入为336.85亿元，占总营业收入的98.82%；2018年以来航空产品营业收入占比均保持在98%以上，主要营收来源为歼击机产品，业务集中度较高。", "date": "", "isSupplementary": false}, {"id": "fact_b590c213", "title": "中无人机2024年年报显示，境内营业收入为685,242,333.64元，营业成本为465,643,675.24元，毛利为219,598,658.40元，毛利率...", "source": "前瞻眼上市企业库", "url": "", "snippet": "中无人机2024年年报显示，境内营业收入为685,242,333.64元，营业成本为465,643,675.24元，毛利为219,598,658.40元，毛利率为32.05%，收入构成中境内占比100%。", "date": "", "isSupplementary": false}, {"id": "fact_de073548", "title": "中无人机2024年中报显示，境内营业收入为272,014,074.61元，营业成本为197,378,453.76元，毛利为74,635,620.85元，毛利率为...", "source": "前瞻眼上市企业库", "url": "", "snippet": "中无人机2024年中报显示，境内营业收入为272,014,074.61元，营业成本为197,378,453.76元，毛利为74,635,620.85元，毛利率为27.44%，收入构成中境内占比100%。", "date": "", "isSupplementary": false}, {"id": "fact_1fb93a69", "title": "在本次搜索结果中，中航沈飞财务报表仅披露国内地区收入构成100%，未出现按无人机业务划分的分部收入数据；因此无法据此验证沈飞无人机业务收入规模。", "source": "本次搜索结果综合（前瞻眼、新浪财经、悟空智库等）", "url": "", "snippet": "在本次搜索结果中，中航沈飞财务报表仅披露国内地区收入构成100%，未出现按无人机业务划分的分部收入数据；因此无法据此验证沈飞无人机业务收入规模。", "date": "", "isSupplementary": false}, {"id": "fact_a59af80b", "title": "中航沈飞在2025年半年度财务报告的管理层讨论与分析中披露，公司主营业务为航空产品制造，主要产品包括航空防务装备和民用航空产品，核心产品为航空防务装备。", "source": "证券之星股票频道（转载中航沈飞2025年半年度管理层讨论与分析）", "url": "", "snippet": "中航沈飞在2025年半年度财务报告的管理层讨论与分析中披露，公司主营业务为航空产品制造，主要产品包括航空防务装备和民用航空产品，核心产品为航空防务装备。", "date": "", "isSupplementary": false}, {"id": "fact_17193a61", "title": "上述中航沈飞主营业务描述未单独列出无人机产品或无人机分产品收入，无法据此验证其无人机业务规模及市场定位。", "source": "证券之星股票频道（转载中航沈飞2025年半年度管理层讨论与分析）", "url": "", "snippet": "上述中航沈飞主营业务描述未单独列出无人机产品或无人机分产品收入，无法据此验证其无人机业务规模及市场定位。", "date": "", "isSupplementary": false}, {"id": "fact_2274db22", "title": "中航沈飞在互动平台表示，公司在民用无人机领域处于积极探索阶段。", "source": "腾讯网/东方财富财富号（转载中航沈飞互动平台问答）", "url": "", "snippet": "中航沈飞在互动平台表示，公司在民用无人机领域处于积极探索阶段。", "date": "", "isSupplementary": false}, {"id": "fact_b781adae", "title": "中航沈飞在互动平台回答投资者时称，公司作为航空武器装备建设“国家队”，履行“兴装强军”首责，发挥航空装备产业链“链长”作用，前瞻布局战略性新兴产业。", "source": "同花顺原创中心（转载中航沈飞互动平台问答）", "url": "", "snippet": "中航沈飞在互动平台回答投资者时称，公司作为航空武器装备建设“国家队”，履行“兴装强军”首责，发挥航空装备产业链“链长”作用，前瞻布局战略性新兴产业。", "date": "", "isSupplementary": false}, {"id": "fact_9ab53401", "title": "中航沈飞2025年半年度报告管理层讨论与分析称，中国航空工业集团将军贸作为核心主业，推动构建国内、国际双循环相互促进的军贸发展新格局。", "source": "证券之星股票频道（转载中航沈飞2025年半年度管理层讨论与分析）", "url": "", "snippet": "中航沈飞2025年半年度报告管理层讨论与分析称，中国航空工业集团将军贸作为核心主业，推动构建国内、国际双循环相互促进的军贸发展新格局。", "date": "", "isSupplementary": false}, {"id": "fact_146533a4", "title": "中无人机2024年半年度报告称，公司是专注于大型固定翼长航时无人机系统成体系、多场景、全寿命的整体解决方案提供商。", "source": "报告网（转载中无人机2024年半年度报告）", "url": "", "snippet": "中无人机2024年半年度报告称，公司是专注于大型固定翼长航时无人机系统成体系、多场景、全寿命的整体解决方案提供商。", "date": "", "isSupplementary": false}, {"id": "fact_7d618182", "title": "道客巴巴所载《2024年中航沈飞分析报告》目录包含“无人机未来战场新常态：有人/无人机协同作战”和“军贸需求或迎来新拐点”章节。", "source": "道客巴巴（2024年中航沈飞分析报告）", "url": "", "snippet": "道客巴巴所载《2024年中航沈飞分析报告》目录包含“无人机未来战场新常态：有人/无人机协同作战”和“军贸需求或迎来新拐点”章节。", "date": "", "isSupplementary": false}, {"id": "fact_a6fc64e2", "title": "中航沈飞2025年半年度报告披露其航空防务装备经营模式为：按特定用户基于国防战略需求确定的型号与采购计划，或民用航空市场采购计划，统筹订单与中长期规划制订年度经...", "source": "证券之星股票频道（转载中航沈飞2025年半年度管理层讨论与分析）", "url": "", "snippet": "中航沈飞2025年半年度报告披露其航空防务装备经营模式为：按特定用户基于国防战略需求确定的型号与采购计划，或民用航空市场采购计划，统筹订单与中长期规划制订年度经营计划和三年滚动计划；销售采取直销模式，军品价格按国家军品定价采购规定确定。", "date": "", "isSupplementary": false}, {"id": "fact_ccd87500", "title": "中航沈飞股份有限公司（证券代码600760，上交所上市）以临时公告形式披露重大事项，公告编号示例为2024-023，公告正文以PDF附件形式在上交所网站发布，第...", "source": "新浪财经（中航沈飞公告转载页）", "url": "https://finance.sina.com.cn/jjxw/2024-04-25/doc-inasymwn8098100.shtml", "snippet": "中航沈飞股份有限公司（证券代码600760，上交所上市）以临时公告形式披露重大事项，公告编号示例为2024-023，公告正文以PDF附件形式在上交所网站发布，第三方财经门户仅转载标题与链接。", "date": "", "isSupplementary": false}, {"id": "fact_66e70d16", "title": "搜狐证券重大事项备忘显示，中航沈飞于2024-12-28集中披露三项上交所公告：修订公司章程、第十届董事会第十一次会议决议、2024年度日常关联交易执行情况及2...", "source": "搜狐证券（转引上交所披露）", "url": "", "snippet": "搜狐证券重大事项备忘显示，中航沈飞于2024-12-28集中披露三项上交所公告：修订公司章程、第十届董事会第十一次会议决议、2024年度日常关联交易执行情况及2025年度日常关联交易预计情况，并给出上交所原始PDF链接（static.sse.com.cn/disclosure/listedinfo/announcement/c/new/2024-12-28/600760_20241228_*.pd", "date": "", "isSupplementary": false}, {"id": "fact_be6eb76d", "title": "采招网披露“某型无人机标准件”成交公告（发布时间2024/8/9，场次号XJ024*****0043），招标业主为航天神舟飞行器有限公司，信息源为航天电子采购平...", "source": "中国采招网", "url": "https://www.bidcenter.com.cn/newscontent-302544741-4.html", "snippet": "采招网披露“某型无人机标准件”成交公告（发布时间2024/8/9，场次号XJ024*****0043），招标业主为航天神舟飞行器有限公司，信息源为航天电子采购平台（td.ispacechina.com）。该主体隶属航天系统（航天彩虹/十一院体系），并非航空工业成飞或沈飞，因此不能作为沈飞无人机型号或订单的证据。", "date": "", "isSupplementary": false}, {"id": "fact_80fc8542", "title": "东方财富网数据中心的中航沈飞公告列表页仅提供索引与免责声明，明确不对信息准确性、真实性、完整性作保证，未包含任何无人机型号（暗剑、利剑、忠诚僚机）相关内容。", "source": "东方财富网数据中心", "url": "https://data.eastmoney.com/notices/stock/600760.html", "snippet": "东方财富网数据中心的中航沈飞公告列表页仅提供索引与免责声明，明确不对信息准确性、真实性、完整性作保证，未包含任何无人机型号（暗剑、利剑、忠诚僚机）相关内容。", "date": "", "isSupplementary": false}, {"id": "fact_c9381dda", "title": "富途牛牛与新浪财经行情页显示中航沈飞股价约47.94元、成交额约8.10亿元（页面时间戳01/27 15:00，年份未标注），属二级市场行情数据，与无人机业务布...", "source": "新浪财经行情页 / 富途牛牛", "url": "https://finance.sina.com.cn/jjxw/2024-04-25/doc-inasymwn8098100.shtml", "snippet": "富途牛牛与新浪财经行情页显示中航沈飞股价约47.94元、成交额约8.10亿元（页面时间戳01/27 15:00，年份未标注），属二级市场行情数据，与无人机业务布局无直接关联。", "date": "", "isSupplementary": false}]}}

