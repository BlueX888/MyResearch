data: {"type": "charts", "agent": "DataAnalyst", "timestamp": "2026-11-10T21:28:42.411361", "content": {"charts": [{"id": "chart_001", "title": "2024年三大主机厂市值对比", "subtitle": "单位：亿元", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["中航成飞", "中航沈飞", "中航西飞"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "bar", "data": [{"value": 2500, "itemStyle": {"color": "#1677ff"}}, {"value": 1500, "itemStyle": {"color": "#52c41a"}}, {"value": 700, "itemStyle": {"color": "#fa8c16"}}], "barWidth": 40, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#666"}}]}}, {"id": "chart_002", "title": "中航沈飞市值演变", "subtitle": "单位：亿元", "type": "line", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["2017年重组初期", "2024年历史最高", "2024年当前"], "axisLine": {"lineStyle": {"color": "#e8e8e8"}}, "axisLabel": {"color": "#666"}}, "yAxis": {"type": "value", "axisLine": {"show": false}, "splitLine": {"lineStyle": {"color": "#f0f0f0"}}}, "series": [{"type": "line", "data": [300, 1680, 1500], "smooth": true, "symbol": "circle", "symbolSize": 8, "itemStyle": {"color": "#1677ff"}, "lineStyle": {"width": 3}, "areaStyle": {"color": {"type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1, "colorStops": [{"offset": 0, "color": "rgba(22,119,255,0.2)"}, {"offset": 1, "color": "rgba(22,119,255,0)"}]}}, "label": {"show": true, "position": "top", "formatter": "{c}", "color": "#666"}}]}}, {"id": "chart_003", "title": "2024年净利润对比", "subtitle": "单位：亿元", "type": "bar", "echarts_option": {"grid": {"left": "3%", "right": "4%", "bottom": "3%", "containLabel": true}, "xAxis": {"type": "category", "data": ["中航沈飞", "中航成飞", "中航西飞"], "axisLine": {"lineStyle": {"color": "#