data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:29:07.987939", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\nplt.figure(figsize=(12, 7), dpi=200)\nx_sf = [2017, 2024]\ny_sf = [300, 1680]\nx_cf = [2023, 2025]\ny_cf = [260, 260]\nplt.plot(x_sf, y_sf, color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='中航沈飞市值规模（亿元）')\nplt.fill_between(x_sf, y_sf, alpha=0.15, color='#6366f1')\nplt.plot(x_cf, y_cf, color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='中航成飞资产/发行市值（亿元）')\nplt.fill_between(x_cf, y_cf, alpha=0.15, color='#f59e0b')\nfor x, y in zip(x_sf, y_sf):\n    plt.text(x, y + 45, str(y) + '亿', ha='center', fontsize=11, color='#4338ca', fontweight='bold')\nfor x, y in zip(x_cf, y_cf):\n    plt.text(x, y + 45, str(y) + '亿', ha='center', fontsize=11, color='#b45309', fontweight='bold')\nplt.annotate('沈飞借壳中航黑豹\\n重组上市', xy=(2017, 300), xytext=(2017.3, 620), fontsize=11, color='#4338ca', arrowprops=dict(arrowstyle='->', color='#4338ca', lw=1.2))\nplt.annotate('沈飞历史最高市值', xy=(2024, 1680), xytext=(2021.6, 1500), fontsize=11, color='#4338ca', arrowprops=dict(arrowstyle='->', color='#4338ca', lw=1.2))\nplt.annotate('成飞评估资产260亿\\n发行价8.39元/股', xy=(2023, 260), xytext=(2019.6, 120), fontsize=11, color='#b45309', arrowprops=dict(arrowstyle='->', color='#b45309', lw=1.2))\nplt.annotate('中航成飞(302132)\\n2025-02-17上市', xy=(2025, 260), xytext=(2021.9, 480), fontsize=11, color='#b45309', arrowprops=dict(arrowstyle='->', color='#b45309', lw=1.2))\nplt.title('军工资产证券化与主机厂上市市场概况分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('规模（亿元人民币）', fontsize=14)\nplt.xticks([2017, 2023, 2024, 2025], fontsize=12)\nplt.yticks(fontsize=12)\nplt.ylim(0, 1900)\nplt.legend(fontsize=12, loc='upper left', frameon=True)\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 军工资产证券化与主机厂上市市场概况"}}

