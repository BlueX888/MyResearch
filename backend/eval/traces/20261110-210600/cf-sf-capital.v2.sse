data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-10T21:20:00.415025", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "军工资产证券化与主机厂上市市场概况", "description": "描述航空军工资产证券化规模、主机厂上市平台数量、成飞与沈飞市值、融资规模及增速。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 沈飞 资产证券化 上市平台 市值 融资规模"]}, {"id": "sec_2", "title": "成飞与沈飞竞争格局及上市平台对比", "description": "描述两家主机厂产品谱系、股权结构、上市平台（中航成飞/中航沈飞）、资产注入路径与募资安排。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["成飞 中航成飞 重组上市 沈飞 中航沈飞 IPO 股权结构"]}, {"id": "sec_3", "title": "资本化路径与技术资产特征", "description": "描述军机研制生产技术特点、资产完整性、保密要求对IPO、重组和资产注入路径的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 军机 资产完整性 保密 资本化 路径"]}, {"id": "sec_4", "title": "政策环境与国资监管", "description": "描述国企改革、军工资产证券化、军品定价、国防科工政策对两家资本化路径的约束与支持。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军工资产证券化 政策 国企改革 军品定价 国防科工局 上市"]}, {"id": "sec_5", "title": "挑战与机遇", "description": "描述成飞沈飞资本化中的同业竞争、关联交易、保密合规、融资效率挑战及改革机遇。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["成飞 沈飞 同业竞争 关联交易 保密 合规 融资"]}, {"id": "sec_6", "title": "未来展望", "description": "描述两家上市平台后续资产注入、股权激励、融资和市值管理趋势及路径收敛或分化。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 中航沈飞 资产注入 股权激励 市值管理 未来"]}], "research_questions": ["成飞与沈飞分别采用何种资本化路径和上市平台，关键节点和交易结构有何不同？", "两家公司资本化路径差异的成因是什么（历史改制、资产完整性、保密与政策、融资需求）？", "未来在国企改革和军工资产证券化背景下，两种路径会收敛还是分化，对融资、治理和估值有何影响？"]}}

