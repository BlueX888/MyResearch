data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:28:54.352327", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Stage': ['沈飞\\n2017重组', '沈飞\\n2024峰值', '成飞\\n2023评估', '成飞\\n2024市值'], 'Value': [300, 1680, 240, 2500]}\ndf = pd.DataFrame(data)\ndf['Value'] = pd.to_numeric(df['Value'], errors='coerce')\ndf = df.dropna()\nfig, axes = plt.subplots(1, 2, figsize=(14, 7), dpi=200)\ncolors = ['#06b6d4', '#06b6d4', '#6366f1', '#6366f1']\nbars = axes[0].bar(df['Stage'], df['Value'], color=colors, alpha=0.9, edgecolor='white')\nfor b, v in zip(bars, df['Value']):\n    axes[0].text(b.get_x()+b.get_width()/2, v+40, f'{v:.0f}', ha='center', fontsize=12, fontweight='bold')\naxes[0].set_title('市值演进对比（亿元）', fontsize=16, fontweight='bold', pad=15)\naxes[0].set_ylabel('市值（亿元）', fontsize=13)\naxes[0].tick_params(labelsize=11)\naxes[0].grid(True, linestyle='--', alpha=0.3, axis='y')\ndata2 = {'Company': ['中航沈飞', '中航成飞'], 'Deal': [79.8, 174.39], 'Premium': [129.81, 88.47]}\ndf2 = pd.DataFrame(data2)\nfor c in ['Deal', 'Premium']:\n    df2[c] = pd.to_numeric(df2[c], errors='coerce')\ndf2 = df2.dropna()\nbars2 = axes[1].bar(df2['Company'], df2['Deal'], color=['#10b981', '#f59e0b'], alpha=0.9, edgecolor='white')\nfor b, v, p in zip(bars2, df2['Deal'], df2['Premium']):\n    axes[1].text(b.get_x()+b.get_width()/2, v+4, f'{v:.1f}亿\\n增值{p:.1f}%', ha='center', fontsize=11, fontweight='bold')\naxes[1].set_title('重组交易对价与评估增值率', fontsize=16, fontweight='bold', pad=15)\naxes[1].set_ylabel('交易对价（亿元）', fontsize=13)\naxes[1].tick_params(labelsize=11)\naxes[1].grid(True, linestyle='--', alpha=0.3, axis='y')\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white')", "purpose": "对比成飞与沈飞的资本化路径：沈飞2017年借壳中航黑豹（交易对价79.8亿、评估增值率129.81%），成飞2025年通过中航电测重组上市（交易对价174.39亿、评估增值率88.47%）。选取市值演进（沈飞2017重组初期300亿→2024峰值1680亿；成飞2023评估240亿→2024市值2500亿）与重组交易结构两个维度，生成双子图对比可视化。"}}

