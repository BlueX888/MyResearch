data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-10T21:29:24.356043", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': [2017, 2023, 2024, 2025], 'Shenfei_MarketCap': [300, None, 1680, None], 'Chengfei_Asset': [None, 260, None, 260]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx_sf = [2017, 2024]\ny_sf = [300, 1680]\nx_cf = [2023, 2025]\ny_cf = [260, 260]\nplt.plot(x_sf, y_sf, marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='中航沈飞市值（亿元）')\nplt.fill_between(x_sf, y_sf, alpha=0.15, color='#6366f1')\nplt.plot(x_cf, y_cf, marker='s', markersize=8, linewidth=2.5, color='#f59e0b', label='中航成飞资产规模（亿元）')\nplt.fill_between(x_cf, y_cf, alpha=0.15, color='#f59e0b')\nfor x, y in zip(x_sf, y_sf):\n    plt.text(x, y + 40, f'{y}亿', ha='center', fontsize=11, color='#6366f1', fontweight='bold')\nfor x, y in zip(x_cf, y_cf):\n    plt.text(x, y + 40, f'{y}亿', ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nplt.annotate('成飞2025-02-17上市\\n(代码302132)', xy=(2025, 260), xytext=(2024.2, 500), arrowprops=dict(arrowstyle='->', color='gray'), fontsize=11, color='#333')\nplt.title('成飞与沈飞竞争格局及上市平台对比分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('年份', fontsize=14)\nplt.ylabel('金额（亿元人民币）', fontsize=14)\nplt.xticks([2017, 2023, 2024, 2025], fontsize=12)\nplt.yticks(fontsize=12)\nplt.legend(fontsize=12, loc='upper left')\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 成飞与沈飞竞争格局及上市平台对比"}}

