data: {"type": "outline", "agent": "ChiefArchitect", "timestamp": "2026-11-11T15:32:06.165053", "content": {"understanding": {}, "key_entities": [], "outline": [{"id": "sec_1", "title": "行业与公司收入概况", "description": "描述航空装备市场规模、增速及中航成飞营收构成、季度收入确认特征。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 年报 营业收入 分季度;航空装备 市场规模 2025"]}, {"id": "sec_2", "title": "竞争格局与交付节奏", "description": "描述主要整机厂/配套商竞争格局及军机交付季节性对季度收入的影响。", "section_type": "mixed", "requires_data": true, "requires_chart": true, "search_queries": ["中航成飞 2025 季度报告 营业收入;成飞 军机 交付 节奏 季度"]}, {"id": "sec_3", "title": "技术趋势与产品结构", "description": "描述核心技术、型号研制/批产及民机配套对收入季度分布的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 产品 型号 批产 2025;航空制造 技术趋势"]}, {"id": "sec_4", "title": "政策环境与采购定价", "description": "描述军品采购、定价机制、税收/补贴政策对收入确认的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["军品 定价 采购 政策 2025;中航成飞 政策 影响"]}, {"id": "sec_5", "title": "挑战机遇与季度波动", "description": "描述供应链、交付验收、订单节奏等挑战及机会对季度营收分布的影响。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 交付 验收 季度 波动;航空供应链 挑战"]}, {"id": "sec_6", "title": "未来展望与季度分布判断", "description": "描述2025年各季度收入分布判断及最高季度验证路径。", "section_type": "mixed", "requires_data": false, "requires_chart": false, "search_queries": ["中航成飞 2025 分季度 营业收入 Q4;中航成飞 2026 展望"]}], "research_questions": ["中航成飞2025年各季度营业收入分别是多少？", "2025年哪个季度营业收入最高，是否符合Q4集中确认规律？", "影响季度收入分布的主要因素（交付验收、采购计划、产品结构、政策）有哪些？"]}}

