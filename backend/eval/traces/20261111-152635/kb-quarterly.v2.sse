data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:41:16.921638", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'年份': ['2024年(调整后)', '2025年'], '营业收入': [650.55, 753.59], '总资产': [1079.06, 1145.48]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nx = np.arange(len(df))\nplt.plot(x, df['营业收入'], marker='o', markersize=8, linewidth=2.5, color='#6366f1', label='营业收入（亿元）')\nplt.fill_between(x, df['营业收入'], alpha=0.15, color='#6366f1')\nplt.plot(x, df['总资产'], marker='s', markersize=8, linewidth=2.5, color='#f59e0b', label='总资产（亿元）')\nplt.fill_between(x, df['总资产'], alpha=0.12, color='#f59e0b')\nfor i, v in enumerate(df['营业收入']):\n    plt.text(i, v + 18, f'{v:,.2f}', ha='center', fontsize=11, color='#6366f1', fontweight='bold')\nfor i, v in enumerate(df['总资产']):\n    plt.text(i, v + 18, f'{v:,.2f}', ha='center', fontsize=11, color='#f59e0b', fontweight='bold')\nplt.annotate('同比 +15.84%', xy=(1, 753.59), xytext=(0.45, 840), fontsize=12, color='#6366f1', fontweight='bold', arrowprops=dict(arrowstyle='->', color='#6366f1', alpha=0.6))\nplt.annotate('同比 +6.16%', xy=(1, 1145.48), xytext=(0.45, 1210), fontsize=12, color='#f59e0b', fontweight='bold', arrowprops=dict(arrowstyle='->', color='#f59e0b', alpha=0.6))\nplt.xticks(x, df['年份'], fontsize=12)\nplt.yticks(fontsize=12)\nplt.title('竞争格局与交付节奏分析', fontsize=18, fontweight='bold', pad=20)\nplt.xlabel('报告期', fontsize=14)\nplt.ylabel('金额（亿元）', fontsize=14)\nplt.legend(fontsize=12, loc='upper left')\nplt.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.tight_layout()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 竞争格局与交付节奏"}}

