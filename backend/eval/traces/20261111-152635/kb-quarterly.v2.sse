data: {"type": "search_results", "agent": "DeepScout", "timestamp": "2026-11-11T15:46:06.056305", "content": {"results": [{"id": "fact_9a3e3373", "title": "中国航空工业集团有限公司持有中航成飞78.66%股份，为国有法人股东。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中国航空工业集团有限公司持有中航成飞78.66%股份，为国有法人股东。", "date": "", "isSupplementary": false}, {"id": "fact_cc541201", "title": "中航成飞股票简称为“中航成飞”，股票代码为302132，在深圳证券交易所上市。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞股票简称为“中航成飞”，股票代码为302132，在深圳证券交易所上市。", "date": "", "isSupplementary": false}, {"id": "fact_f85b794b", "title": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "报告期内，公司主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_e60460d3", "title": "公司2025年度利润分配预案为：以总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司2025年度利润分配预案为：以总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": false}, {"id": "fact_052529eb", "title": "中国航空工业集团有限公司持有中航成飞78.66%股份，为国有法人控股股东。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中国航空工业集团有限公司持有中航成飞78.66%股份，为国有法人控股股东。", "date": "", "isSupplementary": false}, {"id": "fact_8fadc074", "title": "中航成飞股票简称为“中航成飞”，股票代码为302132。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞股票简称为“中航成飞”，股票代码为302132。", "date": "", "isSupplementary": false}, {"id": "fact_6aeb8665", "title": "中航成飞在深圳证券交易所上市。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞在深圳证券交易所上市。", "date": "", "isSupplementary": false}, {"id": "fact_9e326e88", "title": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "大信会计师事务所（特殊普通合伙）对中航成飞2025年度财务报告出具了标准无保留意见的审计报告。", "date": "", "isSupplementary": false}, {"id": "fact_2464c712", "title": "中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞主营业务为航空产品研发、制造、销售、维修与服务保障，主要产品包括航空防务装备、民用航空产品和智能测控产品。", "date": "", "isSupplementary": false}, {"id": "fact_fe84b6a8", "title": "2025年末中航成飞总资产为114,547,703,019.42元，2024年末调整后为107,905,965,442.13元，本年末比上年末增减6.16%。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "2025年末中航成飞总资产为114,547,703,019.42元，2024年末调整后为107,905,965,442.13元，本年末比上年末增减6.16%。", "date": "", "isSupplementary": false}, {"id": "fact_62556593", "title": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积...", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年度利润分配预案为：以公司总股本267,209.14万股为基数，向全体股东每10股派发现金红利3.86元（含税），送红股0股（含税），以资本公积金向全体股东每10股转增0股。", "date": "", "isSupplementary": false}, {"id": "fact_280f87cb", "title": "中国航空工业集团有限公司持有中航成飞78.66%股份，持股数量为2,101,738,612.00股。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中国航空工业集团有限公司持有中航成飞78.66%股份，持股数量为2,101,738,612.00股。", "date": "", "isSupplementary": false}, {"id": "fact_3a7a5216", "title": "本次搜索结果中的《2025年年度报告摘要》片段未包含2025年分季度营业收入数据，无法据此判断各季度营业收入分布或最高季度。", "source": "中航成飞股份有限公司2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "本次搜索结果中的《2025年年度报告摘要》片段未包含2025年分季度营业收入数据，无法据此判断各季度营业收入分布或最高季度。", "date": "", "isSupplementary": false}, {"id": "fact_0aa1e70e", "title": "中航成飞2025年分季度归属于上市公司股东的净利润也呈下半年集中态势：第一季度156,494,308.41元、第二季度756,329,709.24元、第三季度1...", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年分季度归属于上市公司股东的净利润也呈下半年集中态势：第一季度156,494,308.41元、第二季度756,329,709.24元、第三季度1,256,306,602.29元、第四季度1,263,159,232.02元。", "date": "", "isSupplementary": true}, {"id": "fact_a89f6ea8", "title": "年报摘要披露的分季度财务指标与公司已披露季度报告、半年度报告相关财务指标不存在重大差异。", "source": "中航成飞2025年年度报告摘要（CF-2025-ANNUAL-SUMMARY.pdf）", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "年报摘要披露的分季度财务指标与公司已披露季度报告、半年度报告相关财务指标不存在重大差异。", "date": "", "isSupplementary": true}, {"id": "fact_c20a28fe", "title": "中航成飞2025年年度报告摘要显示，公司需追溯调整或重述以前年度会计数据，追溯调整或重述原因为“同一控制下企业合并”，该信息与吸收合并成飞后的并表会计处理相关。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年年度报告摘要显示，公司需追溯调整或重述以前年度会计数据，追溯调整或重述原因为“同一控制下企业合并”，该信息与吸收合并成飞后的并表会计处理相关。", "date": "", "isSupplementary": true}, {"id": "fact_2c32c9fa", "title": "中航成飞2025年年度报告摘要披露公司简称为“中航成飞”，股票代码为302132，表明该报告主体已使用中航成飞名称。", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年年度报告摘要披露公司简称为“中航成飞”，股票代码为302132，表明该报告主体已使用中航成飞名称。", "date": "", "isSupplementary": true}, {"id": "fact_a6877206", "title": "中航成飞2025年分季度营业收入分别为：第一季度3,308,640,285.35元、第二季度17,393,488,964.30元、第三季度27,584,043,...", "source": "CF-2025-ANNUAL-SUMMARY.pdf", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年分季度营业收入分别为：第一季度3,308,640,285.35元、第二季度17,393,488,964.30元、第三季度27,584,043,546.48元、第四季度27,072,785,205.73元；第三季度营业收入最高，第四季度略低于第三季度。该数据可直接反映收入确认节奏。", "date": "", "isSupplementary": true}, {"id": "fact_06789d0b", "title": "中航成飞2025年分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546...", "source": "中航成飞2025年年度报告摘要", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "中航成飞2025年分季度营业收入：第一季度3,308,640,285.35元，第二季度17,393,488,964.30元，第三季度27,584,043,546.48元，第四季度27,072,785,205.73元。Q1仅约33.09亿元，显著低于后续季度。", "date": "", "isSupplementary": true}, {"id": "fact_10195af6", "title": "公司因同一控制下企业合并对以前年度会计数据进行追溯调整或重述。2024年末总资产调整前为4,240,904,107.27元，调整后为107,905,965,44...", "source": "中航成飞2025年年度报告摘要", "url": "local://kb/kb_6bf4f0b4/b5655f62427ec0232490e64a1691f27e", "snippet": "公司因同一控制下企业合并对以前年度会计数据进行追溯调整或重述。2024年末总资产调整前为4,240,904,107.27元，调整后为107,905,965,442.13元，合并范围变化巨大。", "date": "", "isSupplementary": true}]}}

