data: {"type": "code", "agent": "CodeWizard", "timestamp": "2026-11-11T15:41:06.074650", "content": {"agent": "CodeWizard", "language": "python", "code": "sns.set_theme(style='whitegrid', palette='husl')\ndata = {'Year': ['2024年(调整后)', '2025年'], '营业收入': [650.55, 753.59], '总资产': [1079.06, 1145.48]}\ndf = pd.DataFrame(data)\nplt.figure(figsize=(12, 7), dpi=200)\nax1 = plt.gca()\nx = np.arange(len(df))\nax1.plot(x, df['营业收入'], color='#6366f1', linewidth=2.5, marker='o', markersize=8, label='营业收入（亿元）')\nax1.fill_between(x, df['营业收入'], alpha=0.15, color='#6366f1')\nfor i, v in enumerate(df['营业收入']):\n    ax1.text(i, v + 15, f'{v:,.2f}', ha='center', fontsize=11, color='#4338ca', fontweight='bold')\nax1.set_xticks(x)\nax1.set_xticklabels(df['Year'], fontsize=12)\nax1.set_xlabel('年份', fontsize=14)\nax1.set_ylabel('营业收入（亿元）', fontsize=14, color='#4338ca')\nax1.tick_params(axis='y', labelsize=12, colors='#4338ca')\nax1.set_ylim(0, 900)\nax2 = ax1.twinx()\nax2.plot(x, df['总资产'], color='#f59e0b', linewidth=2.5, marker='s', markersize=8, label='总资产（亿元）')\nax2.fill_between(x, df['总资产'], alpha=0.15, color='#f59e0b')\nfor i, v in enumerate(df['总资产']):\n    ax2.text(i, v + 25, f'{v:,.2f}', ha='center', fontsize=11, color='#b45309', fontweight='bold')\nax2.set_ylabel('总资产（亿元）', fontsize=14, color='#b45309')\nax2.tick_params(axis='y', labelsize=12, colors='#b45309')\nax2.set_ylim(0, 1400)\nplt.title('行业与公司收入概况分析', fontsize=18, fontweight='bold', pad=20)\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax2.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=12, frameon=True)\nax1.grid(True, linestyle='--', alpha=0.3)\nsns.despine()\nplt.savefig('chart.png', dpi=200, bbox_inches='tight', facecolor='white', edgecolor='none')", "purpose": "生成图表: 行业与公司收入概况"}}

